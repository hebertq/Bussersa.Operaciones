@using BsOperaciones.Component.MenuComponen
@using BsOperaciones.Component.MenuComponen.Rrhh
@using BsOperaciones.Component.MenuComponen.Operaciones
@using BsOperaciones.Services
@using Modelo.Admin
@using Modelo.Entidades
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ModuloNavigationService ModuloNavService
@inject IUserInfo _Iuser
@implements IDisposable

<MudNavMenu Class="mud-width-full">

    @if (moduloActual != null)
    {
        @* Encabezado del Módulo Activo con botón de retorno estilo Odoo *@
        <div class="active-module-card pa-3 mx-2 my-2 rounded-lg" style="background: rgba(var(--mud-palette-primary-rgb), 0.08); border: 1px solid rgba(var(--mud-palette-primary-rgb), 0.2);">
            <div class="d-flex align-center justify-space-between mb-1">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@moduloActual.Icono" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="letter-spacing: 0.5px; color: var(--mud-palette-primary);">
                        @moduloActual.Titulo
                    </MudText>
                </div>
                <MudTooltip Text="Cambiar Módulo (Odoo App Switcher)">
                    <MudIconButton Icon="@Icons.Material.Filled.Apps" 
                                   Size="Size.Small" 
                                   Color="Color.Primary" 
                                   OnClick="IrAModulos" 
                                   Title="Cambiar de Módulo" />
                </MudTooltip>
            </div>
            <MudButton Variant="Variant.Text" 
                       Size="Size.Small" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.ArrowBack" 
                       OnClick="IrAModulos" 
                       Class="px-1 text-lowercase"
                       Style="font-size: 0.72rem; font-weight: 600; text-transform: none;">
                Volver a Módulos
            </MudButton>
        </div>

        <MudDivider Class="my-1" />

        @* Acceso directo al Inicio del Módulo *@
        <MudNavLink Icon="@Icons.Material.Filled.Dashboard" Href="@moduloActual.RutaPrincipal" Match="NavLinkMatch.All" Style="font-weight: 700;">
            Inicio de @moduloActual.Titulo
        </MudNavLink>

        @* Submenús del Módulo Seleccionado ÚNICAMENTE *@
        @if (moduloActual.Clave == "operaciones")
        {
            <MenuOperaciones />
        }
        else if (moduloActual.Clave == "asistencias")
        {
            <MenuAsistencia />
        }
        else if (moduloActual.Clave == "nomina")
        {
            <MenuNomina />
        }
        else if (moduloActual.Clave == "comercial")
        {
            <MenuComercial />
        }
        else if (moduloActual.Clave == "supervision")
        {
            <MudNavGroup Title="Supervisión" Icon="@Icons.Material.Filled.SupervisorAccount" Expanded="true">
                <MenuItem MenuId="62" Name="Áreas del Cliente" Url="/admon/supervision/areas-cliente" IconName="@Icons.Material.Filled.Domain" />
                <MenuItem MenuId="63" Name="Personal por Cliente" Url="/admon/supervision/personal-cliente" IconName="@Icons.Material.Filled.Badge" />
                <MenuItem MenuId="65" Name="Reglas de Viáticos" Url="/admon/supervision/reglas-viaticos" IconName="@Icons.Material.Filled.Payments" />
            </MudNavGroup>
        }
        else if (moduloActual.Clave == "admon")
        {
            <MenuAdministracion />
        }
    }
    else
    {
        @* En Inicio / Lanzador de Apps: Mostrar acceso directo a Módulos Permitidos *@
        <MudNavLink Icon="@Icons.Material.Filled.Apps" Href="/index" Match="NavLinkMatch.All" Style="font-weight: 700; color: var(--mud-palette-primary);">
            Módulos del Sistema
        </MudNavLink>

        <MudDivider Class="my-2" />

        <div class="px-3 py-1">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-size: 0.7rem; font-weight: 700;">
                MÓDULOS ACTIVOS
            </MudText>
        </div>

        @foreach (var mod in modulosPermitidos)
        {
            <MudNavLink Icon="@mod.Icono" Href="@mod.RutaPrincipal" Match="NavLinkMatch.Prefix">
                @mod.Titulo
            </MudNavLink>
        }
    }

    <MudDivider Class="my-2" />

    @* Sección de Seguridad / Usuario *@
    <AuthorizeView>
        <Authorized>
            <MudNavLink Icon="@Icons.Material.Filled.Logout"
                        IconColor="Color.Error"
                        OnClick="Logout"
                        Style="cursor:pointer">
                Cerrar Sesión
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Login"
                        IconColor="Color.Success">
                Iniciar Sesión
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>

</MudNavMenu>

@code {
    private ModuloAppItem? moduloActual = null;
    private List<ModuloAppItem> modulosPermitidos = new();
    private ClaimsPrincipal? user;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User;
        modulosPermitidos = ModuloNavService.ObtenerModulosPermitidos(user);
        ActualizarModuloActivo();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ActualizarModuloActivo();
        StateHasChanged();
    }

    private void ActualizarModuloActivo()
    {
        string relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        moduloActual = ModuloNavService.DetectarModuloPorUrl(relativePath);
    }

    private void IrAModulos()
    {
        NavigationManager.NavigateTo("/index");
    }

    public async Task Logout()
    {
        if (AuthenticationStateProvider is CustomAuthenticationStateProvider customAuth)
        {
            await customAuth.MarkUserAsLoggedOut();
        }
        _Iuser.SetUserInfo(new User());
        _Iuser.SetMenu(0);
        _Iuser.SetPermisos(new Menus());
        NavigationManager.NavigateTo("");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
