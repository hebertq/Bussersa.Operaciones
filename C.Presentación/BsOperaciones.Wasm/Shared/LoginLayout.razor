@inherits LayoutComponentBase

<MudThemeProvider Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    .login-wrapper {
        background: #090d16;
        background-image: 
            radial-gradient(circle at 10% 20%, rgba(249, 115, 22, 0.15) 0%, transparent 40%),
            radial-gradient(circle at 90% 80%, rgba(56, 189, 248, 0.15) 0%, transparent 40%),
            radial-gradient(circle at 50% 50%, #0d1527 0%, #090d16 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .login-container {
        width: 100%;
        max-width: 440px;
        animation: premiumFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes premiumFadeIn {
        from {
            opacity: 0;
            transform: translateY(24px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Custom styles for login button and fields */
    .btn-login-premium {
        background: linear-gradient(90deg, #f97316 0%, #ea580c 100%) !important;
        color: white !important;
        box-shadow: 0 4px 20px rgba(249, 115, 22, 0.3) !important;
        transition: all 0.3s ease !important;
        font-weight: 700 !important;
        letter-spacing: 1px;
    }

    .btn-login-premium:hover {
        transform: translateY(-2px) scale(1.01) !important;
        box-shadow: 0 6px 24px rgba(249, 115, 22, 0.45) !important;
    }
</style>

<div class="login-wrapper">
    <div class="login-container">
        @Body
    </div>
</div>

@code {
    private MudTheme _currentTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0f172a",
            Secondary = "#f97316",
            AppbarBackground = "#090d16",
            Surface = "rgba(255, 255, 255, 0.95)",
            Background = "#090d16",
            TextPrimary = "#0f172a",
            TextSecondary = "#475569"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "24px"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Outfit", "Inter", "sans-serif" },
                FontSize = ".9rem"
            }
        }
    };
}