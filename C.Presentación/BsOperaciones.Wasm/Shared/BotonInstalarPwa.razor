@using MudBlazor
@implements IDisposable

@if (_canInstallPwa && !_isAlreadyInstalled)
{
    @if (EsBanner)
    {
        <MudPaper Elevation="3" 
                  Class="@($"pa-4 mb-6 rounded-xl {Class}")" 
                  Style="@($"background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid rgba(245, 158, 11, 0.4); box-shadow: 0 4px 20px rgba(245, 158, 11, 0.15); {Style}")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large" Style="box-shadow: 0 0 12px rgba(245, 158, 11, 0.4);">
                        <MudIcon Icon="@Icons.Material.Filled.InstallMobile" Size="Size.Medium" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-white">
                            @TituloBanner
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #cbd5e1;">
                            @SubtituloBanner
                        </MudText>
                    </div>
                </MudStack>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Warning" 
                           Size="Size.Medium" 
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="InstalarApp"
                           Class="rounded-pill px-5 fw-bold"
                           Style="color: #0f172a; font-weight: 800; letter-spacing: 0.5px; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);">
                    INSTALAR AHORA
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudButton Variant="@Variant" 
                   Color="@Color" 
                   Size="@Size" 
                   StartIcon="@StartIcon" 
                   OnClick="@InstalarApp" 
                   Class="@Class" 
                   FullWidth="@FullWidth"
                   Style="@ComputedStyle">
            @Texto
        </MudButton>
    }
}

@code {
    [Inject] private IJSRuntime JS { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }
    [Inject] private IDialogService DialogService { get; set; }

    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public Color Color { get; set; } = Color.Warning;
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;
    [Parameter] public string StartIcon { get; set; } = Icons.Material.Filled.InstallMobile;
    [Parameter] public string Texto { get; set; } = "Instalar App";
    [Parameter] public bool FullWidth { get; set; } = false;
    [Parameter] public bool EsBanner { get; set; } = false;
    [Parameter] public string TituloBanner { get; set; } = "¿Deseas instalar la Aplicación en este dispositivo?";
    [Parameter] public string SubtituloBanner { get; set; } = "Agrégala a tu pantalla de inicio para acceder directamente con un solo toque y a pantalla completa.";

    private bool _canInstallPwa = false;
    private bool _isAlreadyInstalled = false;
    private DotNetObjectReference<BotonInstalarPwa>? _dotNetRef;

    private string ComputedStyle => !string.IsNullOrEmpty(Style) 
        ? Style 
        : "font-weight: 800; border-radius: 8px; letter-spacing: 0.3px; box-shadow: 0 0 10px rgba(245, 158, 11, 0.4);";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _isAlreadyInstalled = await JS.InvokeAsync<bool>("pwaInterop.isStandalone");
                if (!_isAlreadyInstalled)
                {
                    _dotNetRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("pwaInterop.registerListener", _dotNetRef);
                }
            }
            catch { }
        }
    }

    [JSInvokable]
    public void SetCanInstallPwa(bool canInstall)
    {
        _canInstallPwa = canInstall;
        StateHasChanged();
    }

    private async Task InstalarApp()
    {
        try
        {
            string result = await JS.InvokeAsync<string>("pwaInterop.installPwa");
            if (result == "ACCEPTED")
            {
                _canInstallPwa = false;
                _isAlreadyInstalled = true;
                Snackbar.Add("¡Aplicación instalada con éxito en tu pantalla de inicio!", Severity.Success);
                StateHasChanged();
            }
            else if (result == "IOS_INSTRUCTIONS")
            {
                await DialogService.ShowMessageBox(
                    "Instalar en iPad / iPhone",
                    "Para instalar en Safari:\n1. Toca el botón 'Compartir' (el icono con una flecha hacia arriba en la barra de Safari).\n2. Desplázate hacia abajo y selecciona 'Agregar a pantalla de inicio'.\n3. Toca 'Agregar' en la esquina superior derecha.",
                    yesText: "Entendido");
            }
        }
        catch { }
    }

    public void Dispose()
    {
        try
        {
            if (_dotNetRef != null)
            {
                JS.InvokeVoidAsync("pwaInterop.unregisterListener", _dotNetRef);
                _dotNetRef.Dispose();
            }
        }
        catch { }
    }
}
