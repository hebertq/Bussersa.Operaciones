@inherits LayoutComponentBase
@implements IDisposable
@using BsOperaciones.Services
@using System.Security.Claims

<MudThemeProvider Theme="_bussersaTheme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* --- BARRA SUPERIOR (APPBAR ESTILO ODOO) --- *@
    <MudAppBar Elevation="0" Color="Color.Default" Dense="true" Class="mud-appbar">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" Title="Alternar Menú" />
        
        @* Botón Odoo App Switcher para regresar al lanzador principal *@
        <MudTooltip Text="Lanzador de Módulos (Odoo App Switcher)">
            <MudIconButton Icon="@Icons.Material.Filled.Apps" 
                           Color="Color.Primary" 
                           OnClick="@IrAInicioModulos" 
                           Class="mr-1"
                           Title="Ver todos los módulos" />
        </MudTooltip>

        <div class="d-flex align-center px-2 cursor-pointer" @onclick="@IrAInicioModulos" style="cursor: pointer;" title="Ir al Lanzador de Módulos">
            <img src="/img/brand/sygnet.png" alt="Bussersa" style="height:30px;" class="mr-2" />
            <div class="d-none d-sm-flex align-center">
                <MudText Typo="Typo.h6" Style="font-weight: 800; letter-spacing: 0.8px; font-family: 'Outfit', sans-serif;">
                    BUSSERSA
                </MudText>
                @if (moduloActual != null)
                {
                    <span class="mx-2 text-muted-appbar" style="font-size: 1.1rem; font-weight: 300;">•</span>
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="font-weight: 700; letter-spacing: 0.5px;">
                        @moduloActual.Titulo.ToUpperInvariant()
                    </MudText>
                }
            </div>
        </div>
        <MudSpacer />

        @* Punto de Estado En Línea estilo Odoo *@
        <div class="d-none d-md-flex align-center mr-3" title="Sistema en línea y sincronizado">
            <span class="odoo-status-dot mr-1"></span>
            <MudText Typo="Typo.caption" Class="text-muted-appbar" Style="font-size: 0.7rem; font-weight: 600;">EN LÍNEA</MudText>
        </div>

        @* Botón de Instalación PWA en Barra Superior *@
        <BotonInstalarPwa Class="mr-2" Texto="Instalar App" />

        @* Dark Mode Toggler *@
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ToggleDarkMode"
                       Class="mr-2"
                       Title="Alternar Modo Oscuro" />

        <MudBadge Content="@("3")" Color="Color.Secondary" Overlap="true" Class="mr-4">
            <MudIcon Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" />
        </MudBadge>
        
        @* Píldora de Perfil del Usuario Logueado *@
        <div class="d-flex align-center ml-2 py-1 px-3 profile-pill">
            <div class="d-flex flex-column align-end mr-3 d-none d-md-flex">
                <MudText Typo="Typo.caption" Color="Color.Inherit" Style="line-height: 1.1; font-weight: 700;">@_userDisplayName</MudText>
                <MudText Typo="Typo.caption" Class="text-muted-appbar" Style="font-size: 0.65rem; font-weight: 600; letter-spacing: 0.5px;">@_userRoleName</MudText>
            </div>
            <MudAvatar Color="Color.Secondary" Size="Size.Small" Variant="MudBlazor.Variant.Filled" Style="font-weight: 700; font-size: 0.75rem;">
                @_userInitials
            </MudAvatar>
        </div>
    </MudAppBar>

    @* --- MENÚ LATERAL (DRAWER CONTEXTUAL) --- *@
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Mini" Class="border-light mud-drawer">
        <MudDrawerHeader Class="pa-4 d-flex align-center justify-space-between">
            @if (_drawerOpen)
            {
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@(moduloActual?.Icono ?? Icons.Material.Outlined.Business)" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight: 900; font-size: 0.75rem; font-family: 'Outfit';">
                        @(moduloActual?.Titulo?.ToUpperInvariant() ?? "BUSSERSA APPS")
                    </MudText>
                </div>
            }
            else
            {
                <MudIcon Icon="@(moduloActual?.Icono ?? Icons.Material.Outlined.Business)" Color="Color.Primary" />
            }
        </MudDrawerHeader>

        @* COMPONENTE NAVMENU *@
        <NavMenu />
    </MudDrawer>

    @* --- CONTENIDO PRINCIPAL --- *@
    <MudMainContent Style="min-height: 100vh;">
        <div class="page-transition">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-16">
                @Body
            </MudContainer>
        </div>
    </MudMainContent>
</MudLayout>

<style>
    .mud-appbar {
        border-bottom: 1px solid var(--mud-palette-divider) !important;
        backdrop-filter: blur(12px) !important;
        background-color: var(--mud-palette-appbar-background) !important;
    }
    
    .mud-drawer {
        border-right: 1px solid var(--mud-palette-divider) !important;
    }

    .profile-pill {
        border-radius: 24px;
        background: rgba(var(--mud-palette-action-default-rgb), 0.05) !important;
        border: 1px solid var(--mud-palette-divider) !important;
        transition: all 0.3s ease;
    }
    .profile-pill:hover {
        transform: translateY(-1px);
        box-shadow: var(--mud-elevation-2);
        background: rgba(var(--mud-palette-action-default-rgb), 0.08) !important;
    }

    .text-muted-appbar {
        color: var(--mud-palette-text-secondary) !important;
        opacity: 0.8;
    }

    .odoo-status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
        display: inline-block;
    }

    /* Esto garantiza que el texto desaparezca totalmente en modo mini */
    .mud-drawer--mini:not(.mud-drawer--open) .mud-nav-link-text {
        display: none !important;
    }
</style>

@code {
    [Inject] IJSRuntime JS { get; set; }
    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] ModuloNavigationService ModuloNavService { get; set; }

    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private DotNetObjectReference<MainLayout>? _objRef;
    private System.Threading.Timer? _validationTimer;

    private ModuloAppItem? moduloActual = null;
    private string _userDisplayName = "Usuario";
    private string _userRoleName = "COLABORADOR";
    private string _userInitials = "US";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private void IrAInicioModulos()
    {
        NavigationManager.NavigateTo("/index");
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        ActualizarModulo();
        _ = CargarInfoUsuario();

        // Periodic check every 30 seconds to ensure token validity
        _validationTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                var state = await AuthStateProvider.GetAuthenticationStateAsync();
                if (state.User.Identity?.IsAuthenticated != true)
                {
                    await LogoutOnInactivity();
                }
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ActualizarModulo();
        StateHasChanged();
    }

    private void ActualizarModulo()
    {
        string relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        moduloActual = ModuloNavService.DetectarModuloPorUrl(relative);
    }

    private async Task CargarInfoUsuario()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                _userDisplayName = user.Identity.Name ?? "Usuario";
                
                string nameLower = _userDisplayName.ToLowerInvariant();
                if (user.IsInRole("Admin") || user.IsInRole("Administrador") || nameLower == "admin" || nameLower.Contains("admin"))
                {
                    _userRoleName = "ADMINISTRADOR";
                }
                else
                {
                    _userRoleName = user.FindFirst(ClaimTypes.Role)?.Value?.ToUpperInvariant() ?? "SUPERVISOR";
                }

                if (!string.IsNullOrWhiteSpace(_userDisplayName))
                {
                    var parts = _userDisplayName.Split(new[] { ' ', '.', '@', '_' }, StringSplitOptions.RemoveEmptyEntries);
                    if (parts.Length >= 2)
                    {
                        _userInitials = $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
                    }
                    else if (_userDisplayName.Length >= 2)
                    {
                        _userInitials = _userDisplayName.Substring(0, 2).ToUpperInvariant();
                    }
                    else
                    {
                        _userInitials = _userDisplayName.ToUpperInvariant();
                    }
                }

                StateHasChanged();
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("window.inactivityTracker.init", _objRef);
        }
    }

    [JSInvokable]
    public async Task LogoutOnInactivity()
    {
        if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
        {
            await customAuth.MarkUserAsLoggedOut();
            NavigationManager.NavigateTo("Login", true);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _objRef?.Dispose();
        _validationTimer?.Dispose();
    }

    private MudTheme _bussersaTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0f172a",         // Slate 900
            Secondary = "#f97316",       // Orange 500
            AppbarBackground = "rgba(255, 255, 255, 0.8)", // Glassmorphic white
            AppbarText = "#0f172a",      // Slate 900
            Background = "#f8fafc",      // Slate 50
            Surface = "#ffffff",         // White cards
            DrawerBackground = "#ffffff",// White sidebar
            DrawerText = "#334155",      // Slate 700
            DrawerIcon = "#475569",      // Slate 600
            ActionDefault = "#475569",
            Divider = "#e2e8f0",         // Slate 200
            TextPrimary = "#0f172a",
            TextSecondary = "#475569",
            Success = "#10b981",         // Emerald 500
            Warning = "#f59e0b",         // Amber 500
            Error = "#ef4444",           // Red 500
            Info = "#06b6d4"             // Cyan 500
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#38bdf8",         // Sky 400
            Secondary = "#f97316",       // Orange 500
            AppbarBackground = "rgba(15, 23, 42, 0.8)", // Glassmorphic dark slate
            AppbarText = "#f8fafc",      // Slate 50
            Background = "#0b0f19",      // Deep Rich Dark
            Surface = "#111827",         // Gray 900
            DrawerBackground = "#111827",// Gray 900
            DrawerText = "#cbd5e1",      // Slate 300
            DrawerIcon = "#94a3b8",      // Slate 400
            ActionDefault = "#94a3b8",
            Divider = "#1f2937",         // Gray 800
            TextPrimary = "#f8fafc",
            TextSecondary = "#94a3b8",
            Success = "#34d399",         // Emerald 400
            Warning = "#fbbf24",         // Amber 400
            Error = "#f87171",           // Red 400
            Info = "#22d3ee"             // Cyan 400
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "16px" // Much rounder, premium look
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Outfit", "Inter", "sans-serif" },
                FontSize = ".9rem"
            },
            H4 = new H4Typography() { FontSize = "1.85rem", FontWeight = "800", FontFamily = new[] { "Outfit", "Inter" } },
            H5 = new H5Typography() { FontSize = "1.5rem", FontWeight = "800", FontFamily = new[] { "Outfit", "Inter" } },
            H6 = new H6Typography() { FontSize = "1.2rem", FontWeight = "700", FontFamily = new[] { "Outfit", "Inter" } },
            Subtitle1 = new Subtitle1Typography() { FontSize = "1rem", FontWeight = "600", FontFamily = new[] { "Outfit", "Inter" } },
            Subtitle2 = new Subtitle2Typography() { FontSize = "0.875rem", FontWeight = "600", FontFamily = new[] { "Outfit", "Inter" } },
            Caption = new CaptionTypography() { FontSize = "0.75rem", FontWeight = "500", FontFamily = new[] { "Outfit", "Inter" } }
        }
    };
}
