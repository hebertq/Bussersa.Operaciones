@using Modelo.Comercial
@inject HostService.Interfaces.IOdooService OdooService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <MudText Typo="Typo.h6">Listado de Matrices</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddMatrixDialog">
                Nueva Matriz
            </MudButton>
        </div>

        <MudTable Items="@matrices" Hover="true" Dense="true" Bordered="true" Loading="@isLoading">
            <HeaderContent>
                <MudTh>Matriz</MudTh>
                <MudTh>Puestos Asignados</MudTh>
                <MudTh Style="width: 120px;" class="text-center">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.nombre</MudTd>
                <MudTd>
                    @if (context.puestoIds != null && context.puestoIds.Any())
                    {
                        var names = string.Join(", ", AllJobs.Where(j => context.puestoIds.Contains(j.id)).Select(j => j.title));
                        <span class="text-muted">@names</span>
                    }
                    else
                    {
                        <span class="text-danger">Ningún puesto asignado</span>
                    }
                </MudTd>
                <MudTd class="text-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenEditMatrixDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMatrix(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">No hay matrices registradas.</MudText>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Default">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public List<JobDescription> AllJobs { get; set; } = new();

    private List<JobMatrix> matrices = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadMatrices();
    }

    private async Task LoadMatrices()
    {
        isLoading = true;
        try
        {
            var res = await OdooService.GetJobMatrices();
            if (res != null && !res.Respuesta.ExisteError)
            {
                matrices = res.Model?.ToList() ?? new List<JobMatrix>();
            }
            else
            {
                Snackbar.Add("Error al cargar matrices: " + res?.Respuesta.MensajeError, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar matrices: " + ex.Message, Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenAddMatrixDialog()
    {
        var parameters = new DialogParameters 
        { 
            ["Matrix"] = new JobMatrix(),
            ["AllJobs"] = AllJobs
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<DialogAddUpdJobMatrix>("Agregar Matriz", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is JobMatrix payload)
        {
            var res = await OdooService.SaveJobMatrix(payload);
            if (!res.Respuesta.ExisteError)
            {
                Snackbar.Add("Matriz agregada con éxito.", Severity.Success);
                await LoadMatrices();
            }
            else
            {
                Snackbar.Add("Error al agregar matriz: " + res.Respuesta.MensajeError, Severity.Error);
            }
        }
    }

    private async Task OpenEditMatrixDialog(JobMatrix matrix)
    {
        var parameters = new DialogParameters 
        { 
            ["Matrix"] = matrix,
            ["AllJobs"] = AllJobs
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<DialogAddUpdJobMatrix>("Editar Matriz", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is JobMatrix payload)
        {
            var res = await OdooService.SaveJobMatrix(payload);
            if (!res.Respuesta.ExisteError)
            {
                Snackbar.Add("Matriz actualizada con éxito.", Severity.Success);
                await LoadMatrices();
            }
            else
            {
                Snackbar.Add("Error al actualizar matriz: " + res.Respuesta.MensajeError, Severity.Error);
            }
        }
    }

    private async Task DeleteMatrix(JobMatrix matrix)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirmar Eliminación", 
            $"¿Está seguro de eliminar la matriz '{matrix.nombre}'? Se eliminarán todas sus actividades y asignaciones RACI correspondientes.", 
            yesText: "Eliminar", cancelText: "Cancelar"
        );

        if (confirm == true)
        {
            var res = await OdooService.DeleteJobMatrix(matrix.id);
            if (!res.Respuesta.ExisteError)
            {
                Snackbar.Add("Matriz eliminada con éxito.", Severity.Success);
                await LoadMatrices();
            }
            else
            {
                Snackbar.Add("Error al eliminar matriz: " + res.Respuesta.MensajeError, Severity.Error);
            }
        }
    }

    private void Close() => MudDialog.Close();
}
