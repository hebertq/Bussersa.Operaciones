@namespace BsOperaciones.Pages.Rrhh

<MudGrid Class="mt-2">
    <!-- Columna Izquierda: Buscador y Lista de Puestos -->
    <MudItem xs="12" md="4" lg="3">
        <MudCard Outlined="true" Class="pa-4 sidebar-card">
            @if (UserInfo.Permisos.Create)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" FullWidth="true" Class="mb-3" OnClick="AddJob">
                    Nuevo Puesto
                </MudButton>
            }
            <MudTextField @bind-Value="SearchQuery" 
                          Placeholder="Buscar puesto, funciones..." 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          IconSize="Size.Medium" 
                          Class="mb-4" 
                          Clearable="true" 
                          Immediate="true" />
            
            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">PUESTOS DISPONIBLES (@FilteredJobs().Count)</MudText>
            <div class="mb-2" style="font-size: 10px; color: gray; max-height: 50px; overflow: auto;">
                Raw: @(JobDescriptionsList != null ? string.Join(" | ", JobDescriptionsList.Select(x => $"{x.id}:{x.title}")) : "null")
            </div>
            
            <div class="job-list-container">
                @foreach (var job in FilteredJobs())
                {
                    <div class="job-item-card @(SelectedJob == job ? "selected" : "")" @onclick="() => SelectJob(job)">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@(string.IsNullOrEmpty(job.tab_icon) ? Icons.Material.Filled.Assignment : Icons.Material.Filled.Assignment)" Color="@(SelectedJob == job ? Color.Secondary : Color.Primary)" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.body2" Class="job-item-title">@job.title (ID: @job.id)</MudText>
                                <MudText Typo="Typo.caption" Class="job-item-subtitle">@job.department</MudText>
                            </div>
                        </div>
                    </div>
                }
                @if (!FilteredJobs().Any())
                {
                    <div class="pa-4 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">No se encontraron puestos</MudText>
                    </div>
                }
            </div>
        </MudCard>
    </MudItem>

    <!-- Columna Derecha: Detalle del Puesto Seleccionado -->
    <MudItem xs="12" md="8" lg="9">
        @if (SelectedJob != null)
        {
            <div class="detail-container">
                <!-- Tarjeta Principal / Identificación -->
                <MudCard Class="pa-6 mb-4 detail-header-card border-left-secondary">
                    <div class="d-flex align-start justify-space-between flex-wrap">
                        <div>
                            <MudText Typo="Typo.h5" Class="detail-title">@SelectedJob.title</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="d-flex align-center mt-1">
                                <MudIcon Icon="@Icons.Material.Outlined.Work" Size="Size.Small" Class="mr-1" />
                                @SelectedJob.department
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-2 mt-2 mt-sm-0">
                            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Info" Title="Descargar PDF" OnClick="PrintDescriptorPdf" />
                            @if (UserInfo.Permisos.Update)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Title="Editar" OnClick="EditJob" />
                            }
                            @if (UserInfo.Permisos.Delete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Title="Eliminar" OnClick="DeleteJob" />
                            }
                            <MudChip T="string" Color="Color.Secondary" Variant="MudBlazor.Variant.Text" Size="Size.Small">@SelectedJob.employment_type</MudChip>
                        </div>
                    </div>

                    <MudDivider Class="my-4" />

                    <MudGrid>
                        <MudItem xs="12" sm="6" md="4">
                            <div class="meta-item">
                                <MudIcon Icon="@Icons.Material.Outlined.Person" Class="meta-icon" />
                                <div>
                                    <MudText Typo="Typo.caption" Class="meta-label">REPORTA A</MudText>
                                    <MudText Typo="Typo.body2" Class="meta-value">@SelectedJob.reports_to</MudText>
                                </div>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <div class="meta-item">
                                <MudIcon Icon="@Icons.Material.Outlined.Group" Class="meta-icon" />
                                <div>
                                    <MudText Typo="Typo.caption" Class="meta-label">SUPERVISA A</MudText>
                                    <MudText Typo="Typo.body2" Class="meta-value">@SelectedJob.supervises</MudText>
                                </div>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <div class="meta-item">
                                <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Class="meta-icon" />
                                <div>
                                    <MudText Typo="Typo.caption" Class="meta-label">TURNO / JORNADA</MudText>
                                    <MudText Typo="Typo.body2" Class="meta-value">@SelectedJob.shift</MudText>
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudCard>

                <!-- Objetivo / Propósito -->
                <MudCard Class="pa-5 mb-4 objective-card">
                    <div class="d-flex align-start">
                        <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Large" Class="quote-icon mr-2" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="objective-title">OBJETIVO DEL PUESTO</MudText>
                            <MudText Typo="Typo.body2" Class="objective-text mt-1">@SelectedJob.objective</MudText>
                        </div>
                    </div>
                </MudCard>

                <!-- Funciones del Puesto -->
                <MudGrid Class="mb-4">
                    <MudItem xs="12" md="6">
                        <MudCard Class="pa-5 section-card full-height">
                            <MudText Typo="Typo.subtitle1" Class="section-title d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Success" Class="mr-2" />
                                Funciones Esenciales
                            </MudText>
                            <div class="mt-3">
                                @if (SelectedJob.essential_functions != null)
                                {
                                    @foreach (var func in SelectedJob.essential_functions)
                                    {
                                        <div class="function-item">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2 mt-1" />
                                            <MudText Typo="Typo.body2">@func</MudText>
                                        </div>
                                    }
                                }
                            </div>
                        </MudCard>
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudCard Class="pa-5 section-card full-height">
                            <MudText Typo="Typo.subtitle1" Class="section-title d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Color="Color.Info" Class="mr-2" />
                                Funciones de Apoyo / Ocasionales
                            </MudText>
                            <div class="mt-3">
                                @if (SelectedJob.occasional_functions != null)
                                {
                                    @foreach (var func in SelectedJob.occasional_functions)
                                    {
                                        <div class="function-item">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" Class="mr-2 mt-1" />
                                            <MudText Typo="Typo.body2">@func</MudText>
                                        </div>
                                    }
                                }
                            </div>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <!-- Requisitos del Puesto -->
                <MudCard Class="pa-5 mb-4 section-card">
                    <MudText Typo="Typo.subtitle1" Class="section-title d-flex align-center mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Class="mr-2" />
                        Requisitos del Puesto
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <div class="requirement-item">
                                <MudText Typo="Typo.caption" Class="requirement-label">EDUCACIÓN / FORMACIÓN</MudText>
                                <MudText Typo="Typo.body2" Class="requirement-value">@SelectedJob.education</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="requirement-item">
                                <MudText Typo="Typo.caption" Class="requirement-label">EXPERIENCIA REQUERIDA</MudText>
                                <MudText Typo="Typo.body2" Class="requirement-value">@SelectedJob.experience</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="requirement-item">
                                <MudText Typo="Typo.caption" Class="requirement-label">CONOCIMIENTOS TÉCNICOS</MudText>
                                <MudText Typo="Typo.body2" Class="requirement-value">@SelectedJob.technical_knowledge</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="requirement-item">
                                <MudText Typo="Typo.caption" Class="requirement-label">IDIOMAS / HERRAMIENTAS</MudText>
                                <MudText Typo="Typo.body2" Class="requirement-value">@SelectedJob.tools_languages</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudCard>

                <!-- Competencias y Condiciones -->
                <MudGrid Class="mb-4">
                    <MudItem xs="12" md="6">
                        <MudCard Class="pa-5 section-card full-height">
                            <MudText Typo="Typo.subtitle1" Class="section-title d-flex align-center mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Secondary" Class="mr-2" />
                                Competencias Clave
                            </MudText>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @if (SelectedJob.competencies != null)
                                {
                                    @foreach (var comp in SelectedJob.competencies)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Variant="MudBlazor.Variant.Text" Icon="@Icons.Material.Filled.Star" Size="Size.Small">@comp</MudChip>
                                    }
                                }
                            </div>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Class="pa-5 section-card full-height">
                            <MudText Typo="Typo.subtitle1" Class="section-title d-flex align-center mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Warning" Class="mr-2" />
                                Condiciones de Trabajo
                            </MudText>
                            <div class="work-condition-list">
                                <div class="condition-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-2 mt-1 text-warning" />
                                    <div>
                                        <MudText Typo="Typo.caption" Class="condition-label">HORARIO / TURNO</MudText>
                                        <MudText Typo="Typo.body2">@SelectedJob.horary</MudText>
                                    </div>
                                </div>
                                <div class="condition-item mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Class="mr-2 mt-1 text-warning" />
                                    <div>
                                        <MudText Typo="Typo.caption" Class="condition-label">EPP / REQUISITOS FÍSICOS</MudText>
                                        <MudText Typo="Typo.body2">@SelectedJob.epp_requirements</MudText>
                                    </div>
                                </div>
                                <div class="condition-item mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-2 mt-1 text-warning" />
                                    <div>
                                        <MudText Typo="Typo.caption" Class="condition-label">RIESGOS DEL PUESTO</MudText>
                                        <MudText Typo="Typo.body2">@SelectedJob.risks</MudText>
                                    </div>
                                </div>
                            </div>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <!-- Indicadores de Desempeño (KPI) -->
                @if (SelectedJob.kpis != null && SelectedJob.kpis.Any())
                {
                    <MudCard Class="pa-5 section-card border-left-success">
                        <MudText Typo="Typo.subtitle1" Class="section-title d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Class="mr-2" />
                            Indicadores de Desempeño (KPIs)
                        </MudText>
                        <MudGrid>
                            @for (int i = 0; i < SelectedJob.kpis.Count; i++)
                            {
                                var kpi = SelectedJob.kpis[i];
                                <MudItem xs="12" sm="6">
                                    <div class="kpi-card pa-4">
                                        <div class="d-flex align-center">
                                            <div class="kpi-num mr-3">@(i + 1)</div>
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@kpi</MudText>
                                        </div>
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudCard>
                }
            </div>
        }
        else
        {
            <MudCard Class="pa-12 text-center">
                <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Large" Color="Color.Default" Style="font-size: 4rem;" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">Selecciona un puesto de la lista</MudText>
                <MudText Typo="Typo.body2" Class="text-muted">Utiliza el panel izquierdo para buscar o filtrar entre los perfiles disponibles.</MudText>
            </MudCard>
        }
    </MudItem>
</MudGrid>
