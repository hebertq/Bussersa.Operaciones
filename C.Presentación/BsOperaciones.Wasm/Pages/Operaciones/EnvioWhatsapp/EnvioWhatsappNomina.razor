@page "/operaciones/envio-whatsapp-nomina"
@page "/nomina/envio-whatsapp-nomina"
@attribute [Authorize]
@using Modelo.ClasesGenericas
@using Modelo.Entidades.Entradas.Odoo

<PageTitle>Envío por WhatsApp — Días Laborados y Colilla de Pago</PageTitle>

<style>
    .wa-header-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-top: 4px solid #1e3a8a;
        border-radius: 14px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
    }
    .wa-filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }
    .wa-btn-resumen-grilla {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%) !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        padding: 9px 20px !important;
        text-transform: none !important;
        box-shadow: 0 2px 8px rgba(30, 58, 138, 0.25) !important;
    }
    .wa-btn-resumen-grilla.mud-disabled {
        background: #f1f5f9 !important;
        color: #94a3b8 !important;
        border: 1px solid #cbd5e1 !important;
        box-shadow: none !important;
    }
    .wa-btn-consultar {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        height: 42px !important;
        border-radius: 10px !important;
        text-transform: none !important;
        letter-spacing: 0.2px;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25) !important;
    }
    .wa-btn-masivo {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        padding: 8px 18px !important;
        text-transform: none !important;
        box-shadow: 0 2px 8px rgba(5, 150, 105, 0.25) !important;
    }
    .wa-btn-masivo.mud-disabled {
        background: #e2e8f0 !important;
        color: #94a3b8 !important;
        box-shadow: none !important;
    }
    .wa-pill-status-ok {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #6ee7b7;
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 0.78rem;
        font-weight: 700;
    }
    .wa-pill-status-warn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fcd34d;
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 0.78rem;
        font-weight: 700;
    }
    .wa-row-btn-img {
        border: 1px solid #0d9488 !important;
        color: #0f766e !important;
        background: #f0fdfa !important;
        font-weight: 700 !important;
        font-size: 0.73rem !important;
        border-radius: 8px !important;
        padding: 3px 9px !important;
        min-width: auto !important;
        text-transform: none !important;
    }
    .wa-row-btn-pdf {
        border: 1px solid #dc2626 !important;
        color: #b91c1c !important;
        background: #fef2f2 !important;
        font-weight: 700 !important;
        font-size: 0.73rem !important;
        border-radius: 8px !important;
        padding: 3px 9px !important;
        min-width: auto !important;
        text-transform: none !important;
    }
    .wa-row-btn-api {
        background: #1e3a8a !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 0.74rem !important;
        border-radius: 8px !important;
        padding: 4px 11px !important;
        min-width: auto !important;
        text-transform: none !important;
    }
    .wa-row-btn-api.mud-disabled, .wa-row-btn-direct.mud-disabled {
        background: #e2e8f0 !important;
        color: #94a3b8 !important;
    }
    .wa-row-btn-direct {
        background: #16a34a !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 0.74rem !important;
        border-radius: 8px !important;
        padding: 4px 11px !important;
        min-width: auto !important;
        text-transform: none !important;
    }
    .wa-tab-btn-active {
        background: #1e3a8a !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        text-transform: none !important;
        padding: 6px 16px !important;
    }
    .wa-tab-btn-inactive {
        background: #f1f5f9 !important;
        color: #334155 !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        text-transform: none !important;
        padding: 6px 16px !important;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">

    @* --- ENCABEZADO EJECUTIVO DE ALTO CONTRASTE --- *@
    <div class="wa-header-card pa-4 mb-4">
        <div class="d-flex flex-wrap align-center justify-space-between gap-3">
            <div class="d-flex align-center gap-3">
                <div class="d-flex align-center justify-center rounded-lg"
                     style="width: 48px; height: 48px; background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: white; flex-shrink: 0;">
                    <MudIcon Icon="@Icons.Material.Filled.SendToMobile" Size="Size.Medium" />
                </div>
                <div>
                    <div class="d-flex flex-wrap align-center gap-2">
                        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #0f172a; line-height: 1.2;">
                            Envío por WhatsApp — Días Laborados y Colillas
                        </MudText>
                        @if (TieneApiConfigurada)
                        {
                            <span class="wa-pill-status-ok">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
                                API Oficial Activa
                            </span>
                        }
                        else
                        {
                            <span class="wa-pill-status-warn">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b; display: inline-block;"></span>
                                Modo WhatsApp 1-Clic
                            </span>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Style="color: #475569; margin-top: 3px;">
                        Envía comprobantes oficiales en <b>Imagen directa</b> (sin lector PDF) o <b>PDF</b> a cada colaborador y consulta el consolidado y detalle de la grilla.
                    </MudText>
                </div>
            </div>

            <div class="d-flex flex-wrap align-center gap-2">
                <MudTooltip Text="@(ColaboradoresFiltrados.Count == 0 ? "Presione Consultar Colaboradores primero para habilitar el consolidado" : "Ver tabla consolidada y detalle día a día de los datos actuales de la grilla")">
                    <span>
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.TableChart"
                                   Disabled="@(ColaboradoresFiltrados.Count == 0)"
                                   OnClick="AbrirModalResumenGrilla"
                                   Class="wa-btn-resumen-grilla">
                            @(ColaboradoresFiltrados.Count > 0
                                ? $"Consolidado y Detalle de la Grilla ({ColaboradoresFiltrados.Count})"
                                : "Consolidado y Detalle de la Grilla")
                        </MudButton>
                    </span>
                </MudTooltip>
            </div>
        </div>
    </div>

    @* --- PANEL DE FILTROS EN 2 FILAS AMPLIAS Y LEGIBLES --- *@
    <div class="wa-filter-card pa-4 mb-4">
        <MudGrid Spacing="3" AlignItems="AlignItems.Center">
            <MudItem xs="12" md="5">
                <MudSelect T="int"
                           Label="Lote de Nómina (Opcional)"
                           Value="LoteSeleccionadoId"
                           ValueChanged="OnLoteChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="int" Value="0">-- Sin Lote (Consultar por Operación y Fechas) --</MudSelectItem>
                    @foreach (var lote in LotesNomina)
                    {
                        <MudSelectItem T="int" Value="@lote.Id">
                            @($"{lote.Nombre} ({lote.FechaInicio:dd/MM} al {lote.FechaFin:dd/MM/yy} · {lote.CantidadColillas} colillas)")
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="int"
                           Label="Operación / Cliente"
                           Value="OperacionSeleccionadaId"
                           ValueChanged="OnOperacionChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="int" Value="0">-- Todas las del Lote seleccionado --</MudSelectItem>
                    @foreach (var op in Operaciones)
                    {
                        <MudSelectItem T="int" Value="@op.id">@op.nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="Contenido del Comprobante"
                           @bind-Value="ModoContenido"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("AMBOS")">Colilla de Pago + Días Laborados</MudSelectItem>
                    <MudSelectItem T="string" Value="@("SOLO_DIAS")">Solo Días Laborados (Pre-Nómina)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("SOLO_COLILLA")">Solo Colilla de Pago Oficial</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="Fecha Desde"
                               @bind-Date="FechaDesde"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="Fecha Hasta"
                               @bind-Date="FechaHasta"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="Formato de Envío API"
                           @bind-Value="FormatoAdjunto"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("IMAGEN")">Imagen Foto Directa (Sin lector PDF)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PDF")">Documento PDF Directo</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Search"
                           Disabled="@Cargando"
                           OnClick="ConsultarDatosAsync"
                           Class="wa-btn-consultar">
                    Consultar Colaboradores
                </MudButton>
            </MudItem>
        </MudGrid>
    </div>

    @if (Cargando)
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center justify-center rounded-lg border" Style="background: #ffffff;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.subtitle1" Class="mt-3" Style="font-weight: 700; color: #1e293b;">
                Consolidando colillas de pago, días laborados y marcaciones diarias...
            </MudText>
        </MudPaper>
    }
    else if (Colaboradores.Count > 0)
    {
        @* --- TARJETAS KPI --- *@
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-3 rounded-lg border" Style="border-left: 4px solid #1e3a8a !important; background: #ffffff;">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #64748b;">COLABORADORES</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight: 800; color: #0f172a;">@ColaboradoresFiltrados.Count</MudText>
                    <MudText Typo="Typo.caption" Style="color: #475569;">
                        Con WhatsApp: <b style="color:#059669;">@ColaboradoresFiltrados.Count(x => TieneTelefonoValido(x.TelefonoWhatsapp))</b> · Sin número: <b style="color:#dc2626;">@ColaboradoresFiltrados.Count(x => !TieneTelefonoValido(x.TelefonoWhatsapp))</b>
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-3 rounded-lg border" Style="border-left: 4px solid #059669 !important; background: #ffffff;">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #64748b;">DÍAS A PAGAR Y H. EXTRAS</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight: 800; color: #065f46;">
                        @($"{ColaboradoresFiltrados.Sum(x => x.TotalDiasPagar):N2} días")
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: #475569;">
                        Horas Extras: <b>@($"{ColaboradoresFiltrados.Sum(x => x.HorasExtrasPeriodo):N2} hrs")</b>
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-3 rounded-lg border" Style="border-left: 4px solid #0284c7 !important; background: #ffffff;">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #64748b;">TOTAL NETO EN COLILLAS</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight: 800; color: #0369a1;">
                        @($"C$ {ColaboradoresFiltrados.Sum(x => x.NetoAPagar):N2}")
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: #475569;">
                        Con colilla cargada: <b>@ColaboradoresFiltrados.Count(x => x.TieneColilla)</b>
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-3 rounded-lg border" Style="border-left: 4px solid #ea580c !important; background: #ffffff;">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #64748b;">PROGRESO DE ENVÍOS</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight: 800; color: #c2410c;">
                        @($"{ColaboradoresFiltrados.Count(x => EsEnviado(x.UltimoEstadoEnvio))} / {ColaboradoresFiltrados.Count}")
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: #475569;">
                        Seleccionados para envío: <b>@SeleccionadosIds.Count</b>
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* --- BARRA DE BÚSQUEDA Y ACCIÓN MASIVA --- *@
        <MudPaper Elevation="0" Class="pa-3 mb-3 rounded-lg border" Style="background: #ffffff;">
            <div class="d-flex flex-wrap align-center justify-space-between gap-3">
                <div class="d-flex flex-wrap align-center gap-2" style="flex: 1; min-width: 280px;">
                    <MudTextField T="string"
                                  @bind-Value="TextoBusqueda"
                                  Placeholder="Buscar por nombre, #código, cédula, cargo o teléfono..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="min-width: 290px; max-width: 360px;" />

                    <MudSelect T="string"
                               Label="Filtrar Lista"
                               @bind-Value="FiltroRapido"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Style="min-width: 205px; max-width: 230px;">
                        <MudSelectItem T="string" Value="@("TODOS")">Todos (@Colaboradores.Count)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("CON_TELEFONO")">Con Teléfono (@Colaboradores.Count(x => TieneTelefonoValido(x.TelefonoWhatsapp)))</MudSelectItem>
                        <MudSelectItem T="string" Value="@("SIN_TELEFONO")">Sin Teléfono (@Colaboradores.Count(x => !TieneTelefonoValido(x.TelefonoWhatsapp)))</MudSelectItem>
                        <MudSelectItem T="string" Value="@("PENDIENTES")">Pendientes (@Colaboradores.Count(x => !EsEnviado(x.UltimoEstadoEnvio)))</MudSelectItem>
                        <MudSelectItem T="string" Value="@("ENVIADOS")">Enviados (@Colaboradores.Count(x => EsEnviado(x.UltimoEstadoEnvio)))</MudSelectItem>
                    </MudSelect>

                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.SelectAll"
                               OnClick="SeleccionarVisiblesConTelefono"
                               Style="text-transform: none; font-weight: 600; border-radius: 8px;">
                        Marcar todos con teléfono
                    </MudButton>

                    @if (SeleccionadosIds.Count > 0)
                    {
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   OnClick="LimpiarSeleccion"
                                   Style="text-transform: none; color: #64748b; font-weight: 600;">
                            Desmarcar
                        </MudButton>
                    }
                </div>

                <div>
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Send"
                               Disabled="@(EnviandoMasivo || SeleccionadosIds.Count == 0)"
                               OnClick="EnviarSeleccionadosMasivoApiAsync"
                               Class="wa-btn-masivo">
                        @if (EnviandoMasivo)
                        {
                            <span>@($"Enviando {ProgresoActual} de {ProgresoTotal}...")</span>
                        }
                        else
                        {
                            <span>@($"Enviar Seleccionados ({SeleccionadosIds.Count}) por WhatsApp API")</span>
                        }
                    </MudButton>
                </div>
            </div>

            @if (EnviandoMasivo && ProgresoTotal > 0)
            {
                <MudProgressLinear Color="Color.Success" Value="@((double)ProgresoActual * 100.0 / ProgresoTotal)" Class="mt-2 rounded" />
            }
        </MudPaper>

        @* --- TABLA PRINCIPAL DE COLABORADORES --- *@
        <MudPaper Elevation="0" Class="rounded-lg border overflow-hidden" Style="background: #ffffff;">
            <MudSimpleTable Hover="true" Dense="true" Bordered="false" Style="overflow-x: auto;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <th style="width: 38px;"></th>
                        <th style="width: 38px;"></th>
                        <th style="color: #0f172a; font-weight: 800;">Colaborador</th>
                        <th style="color: #0f172a; font-weight: 800;">Operación / Cargo</th>
                        <th style="min-width: 195px; color: #0f172a; font-weight: 800;">Teléfono WhatsApp</th>
                        <th class="text-right" style="color: #0f172a; font-weight: 800;">Consolidado Días</th>
                        <th class="text-right" style="color: #0f172a; font-weight: 800;">Colilla Neto</th>
                        <th class="text-center" style="color: #0f172a; font-weight: 800;">Estado</th>
                        <th class="text-center" style="min-width: 285px; color: #0f172a; font-weight: 800;">Descargar / Enviar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ColaboradoresFiltrados)
                    {
                        bool seleccionado = SeleccionadosIds.Contains(item.EmployeeId);
                        bool expandido = FilasExpandidas.Contains(item.EmployeeId);
                        bool procesandoFila = FilasProcesando.Contains(item.EmployeeId);

                        <tr>
                            <td>
                                <MudCheckBox T="bool"
                                             Value="@seleccionado"
                                             ValueChanged="@(val => ToggleSeleccionFila(item.EmployeeId, val))"
                                             Color="Color.Primary"
                                             Dense="true" />
                            </td>
                            <td>
                                <MudTooltip Text="@(expandido ? "Ocultar desglose" : "Ver detalle día a día y colilla")">
                                    <MudIconButton Icon="@(expandido ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => ToggleExpandirFila(item.EmployeeId))" />
                                </MudTooltip>
                            </td>
                            <td>
                                <div style="font-weight: 700; color: #0f172a;">
                                    @if (item.CodigoEmpleado > 0)
                                    {
                                        <span style="color: #1e3a8a; margin-right: 4px;">#@item.CodigoEmpleado</span>
                                    }
                                    @item.NombreEmpleado
                                </div>
                                <div style="font-size: 0.74rem; color: #64748b;">
                                    Cédula: @(string.IsNullOrWhiteSpace(item.Cedula) ? "N/D" : item.Cedula)
                                </div>
                            </td>
                            <td>
                                <div style="font-weight: 600; font-size: 0.8rem; color: #1e293b;">@item.OperacionNombre</div>
                                <div style="font-size: 0.74rem; color: #64748b;">@item.Cargo</div>
                            </td>
                            <td>
                                <div class="d-flex align-center gap-1">
                                    <MudTextField T="string"
                                                  @bind-Value="item.TelefonoWhatsapp"
                                                  Placeholder="8888-8888"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Style="max-width: 145px;" />
                                    <MudTooltip Text="Guardar número en ficha de empleado Odoo">
                                        <MudIconButton Icon="@Icons.Material.Filled.Save"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Disabled="@procesandoFila"
                                                       OnClick="@(() => GuardarTelefonoFilaAsync(item))" />
                                    </MudTooltip>
                                </div>
                            </td>
                            <td class="text-right">
                                @if (IncluirDiasLaborados)
                                {
                                    <div style="font-weight: 800; color: #065f46;">@($"{item.TotalDiasPagar:0.##} días")</div>
                                    <div style="font-size: 0.72rem; color: #475569;">
                                        Ord: @($"{item.DiasTrabajadosOrdinarios:0.##}") · 7mo: @($"{item.SeptimoDia:0.##}") · H.E.: <b>@($"{item.HorasExtrasPeriodo:0.##}h")</b>
                                    </div>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">Omitido</span>
                                }
                            </td>
                            <td class="text-right">
                                @if (item.TieneColilla && IncluirColilla)
                                {
                                    <div style="font-weight: 800; color: #1e3a8a;">@($"C$ {item.NetoAPagar:N2}")</div>
                                    <div style="font-size: 0.72rem; color: #64748b;">
                                        Ing: @($"{item.TotalIngresos:N2}") · Ded: @($"{item.TotalDeducciones:N2}")
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size: 0.75rem; color: #94a3b8;">@(IncluirColilla ? "Sin colilla" : "Omitida")</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (string.Equals(item.UltimoEstadoEnvio, "ENVIADO_API", StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudTooltip Text="@($"{item.DetalleUltimoEnvio} ({item.FechaUltimoEnvio:dd/MM HH:mm})")">
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Enviado API</MudChip>
                                    </MudTooltip>
                                }
                                else if (string.Equals(item.UltimoEstadoEnvio, "ENLACE_WA", StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudTooltip Text="@($"{item.DetalleUltimoEnvio} ({item.FechaUltimoEnvio:dd/MM HH:mm})")">
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">WhatsApp 1-Clic</MudChip>
                                    </MudTooltip>
                                }
                                else if (string.Equals(item.UltimoEstadoEnvio, "ERROR", StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudTooltip Text="@item.DetalleUltimoEnvio">
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">Revisar</MudChip>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #64748b; border-color: #cbd5e1;">Pendiente</MudChip>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex align-center justify-center gap-1">
                                    <MudTooltip Text="Descargar comprobante como Imagen Foto PNG">
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Image"
                                                   Disabled="@procesandoFila"
                                                   OnClick="@(() => DescargarImagenIndividualAsync(item))"
                                                   Class="wa-row-btn-img">
                                            Foto
                                        </MudButton>
                                    </MudTooltip>

                                    <MudTooltip Text="Descargar comprobante en PDF">
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                                   Disabled="@procesandoFila"
                                                   OnClick="@(() => DescargarPdfIndividualAsync(item))"
                                                   Class="wa-row-btn-pdf">
                                            PDF
                                        </MudButton>
                                    </MudTooltip>

                                    <MudTooltip Text="Enviar automáticamente por API oficial de WhatsApp">
                                        <MudButton Variant="Variant.Filled"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Send"
                                                   Disabled="@(procesandoFila || !TieneTelefonoValido(item.TelefonoWhatsapp))"
                                                   OnClick="@(() => EnviarApiIndividualFilaAsync(item))"
                                                   Class="wa-row-btn-api">
                                            Enviar API
                                        </MudButton>
                                    </MudTooltip>

                                    <MudTooltip Text="Abrir conversación en WhatsApp Web con el resumen">
                                        <MudButton Variant="Variant.Filled"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Chat"
                                                   Disabled="@(procesandoFila || !TieneTelefonoValido(item.TelefonoWhatsapp))"
                                                   OnClick="@(() => AbrirWhatsappDirectoFilaAsync(item))"
                                                   Class="wa-row-btn-direct">
                                            WhatsApp
                                        </MudButton>
                                    </MudTooltip>
                                </div>
                            </td>
                        </tr>

                        @* --- FILA EXPANDIBLE: DETALLE DÍA A DÍA Y COLILLA --- *@
                        @if (expandido)
                        {
                            <tr style="background: #f8fafc;">
                                <td colspan="9" class="pa-3">
                                    <MudGrid Spacing="2">
                                        @if (item.TieneColilla && IncluirColilla)
                                        {
                                            <MudItem xs="12" md="5">
                                                <MudPaper Elevation="0" Class="pa-3 rounded border" Style="background: #ffffff;">
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800; color: #1e3a8a;" Class="mb-2">
                                                        Desglose de Colilla (@item.NumeroRecibo)
                                                    </MudText>
                                                    <div class="d-flex justify-space-between" style="font-size: 0.78rem; color: #475569;">
                                                        <span>Salario Mensual Contrato:</span>
                                                        <b>@($"C$ {item.SalarioMensualContrato:N2}")</b>
                                                    </div>
                                                    <MudDivider Class="my-2" />
                                                    <div style="font-size: 0.76rem; font-weight: 700; color: #0f172a;">Ingresos:</div>
                                                    @foreach (var ing in item.LineasIngresos)
                                                    {
                                                        <div class="d-flex justify-space-between" style="font-size: 0.76rem;">
                                                            <span>@ing.Concepto @(ing.Cantidad > 0 ? $"({ing.Cantidad:0.##} {ing.Unidad})" : "")</span>
                                                            <span>@($"C$ {ing.Monto:N2}")</span>
                                                        </div>
                                                    }
                                                    <div class="d-flex justify-space-between mt-1" style="font-size: 0.78rem; font-weight: 700; color: #1e3a8a;">
                                                        <span>Total Ingresos:</span>
                                                        <span>@($"C$ {item.TotalIngresos:N2}")</span>
                                                    </div>

                                                    <MudDivider Class="my-2" />
                                                    <div style="font-size: 0.76rem; font-weight: 700; color: #991b1b;">Deducciones:</div>
                                                    @foreach (var ded in item.LineasDeducciones)
                                                    {
                                                        <div class="d-flex justify-space-between" style="font-size: 0.76rem; color: #991b1b;">
                                                            <span>@ded.Concepto</span>
                                                            <span>@($"- C$ {ded.Monto:N2}")</span>
                                                        </div>
                                                    }
                                                    <div class="d-flex justify-space-between mt-2 pa-2 rounded" style="background: #ecfdf5; font-weight: 800; color: #065f46;">
                                                        <span>NETO A RECIBIR:</span>
                                                        <span>@($"C$ {item.NetoAPagar:N2}")</span>
                                                    </div>
                                                </MudPaper>
                                            </MudItem>
                                        }

                                        <MudItem xs="12" md="@(item.TieneColilla && IncluirColilla ? 7 : 12)">
                                            <MudPaper Elevation="0" Class="pa-3 rounded border" Style="background: #ffffff;">
                                                <div class="d-flex flex-wrap justify-space-between align-center mb-2">
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800; color: #0f172a;">
                                                        Detalle Día a Día (@item.DetalleDias.Count registros)
                                                    </MudText>
                                                    <div style="font-size: 0.76rem; color: #475569;">
                                                        Hábiles: <b>@($"{item.DiasHabilesPeriodo:0.##}")</b> ·
                                                        Ord: <b>@($"{item.DiasTrabajadosOrdinarios:0.##}")</b> ·
                                                        Séptimos: <b>@($"{item.SeptimoDia:0.##}")</b> ·
                                                        Feriados: <b>@($"{item.DiasFeriados:0.##}")</b> ·
                                                        Vacaciones: <b style="color:#1e3a8a;">@($"{item.DiasVacacionesDescansadas:0.##}")</b> ·
                                                        Ausencias: <b style="color:#dc2626;">@($"{(item.DiasJustificados + item.DiasInjustificados + item.DiasSubsidio):0.##}")</b> ·
                                                        Total Días: <b style="color:#065f46;">@($"{item.TotalDiasPagar:0.##}")</b>
                                                    </div>
                                                </div>

                                                @if (item.DetalleDias.Count == 0)
                                                {
                                                    <MudText Typo="Typo.caption" Style="color: #64748b;">
                                                        Sin marcaciones diarias detalladas en el rango seleccionado.
                                                    </MudText>
                                                }
                                                else
                                                {
                                                    <div style="max-height: 260px; overflow-y: auto;">
                                                        <table style="width: 100%; border-collapse: collapse; font-size: 0.74rem;">
                                                            <thead>
                                                                <tr style="background: #e2e8f0; text-align: left;">
                                                                    <th style="padding: 4px;">Fecha</th>
                                                                    <th style="padding: 4px;">Día</th>
                                                                    <th style="padding: 4px;">Área</th>
                                                                    <th style="padding: 4px;">Entrada</th>
                                                                    <th style="padding: 4px;">Salida</th>
                                                                    <th style="padding: 4px; text-align: right;">Hrs</th>
                                                                    <th style="padding: 4px; text-align: right;">Día Eq.</th>
                                                                    <th style="padding: 4px; text-align: right;">H.E.</th>
                                                                    <th style="padding: 4px;">Estado / Observación</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var d in item.DetalleDias)
                                                                {
                                                                    bool esVac = !d.Asistio && (d.EstadoTexto ?? string.Empty).Contains("Vacacion", StringComparison.OrdinalIgnoreCase);
                                                                    string colorEst = !d.Asistio ? (esVac ? "#1e3a8a" : "#dc2626") : "#334155";
                                                                    <tr style="border-bottom: 1px solid #f1f5f9; background: @(esVac ? "#eff6ff" : "transparent");">
                                                                        <td style="padding: 3px 4px;">@($"{d.Fecha:dd/MM/yyyy}")</td>
                                                                        <td style="padding: 3px 4px; color: #475569;">@ObtenerDiaCorto(d.Fecha)</td>
                                                                        <td style="padding: 3px 4px;">@(string.IsNullOrWhiteSpace(d.Area) ? d.Cliente : d.Area)</td>
                                                                        <td style="padding: 3px 4px;">@d.HoraEntrada</td>
                                                                        <td style="padding: 3px 4px;">@d.HoraSalida</td>
                                                                        <td style="padding: 3px 4px; text-align: right;">@(d.HorasOrdinarias > 0 ? $"{d.HorasOrdinarias:0.##}" : "-")</td>
                                                                        <td style="padding: 3px 4px; text-align: right;">@(d.DiasEquivalentes > 0 ? $"{d.DiasEquivalentes:0.##}" : "-")</td>
                                                                        <td style="padding: 3px 4px; text-align: right; font-weight: 700; color: #1e3a8a;">@(d.HorasExtras > 0 ? $"{d.HorasExtras:0.##}" : "-")</td>
                                                                        <td style="padding: 3px 4px; color: @colorEst;">
                                                                            @d.EstadoTexto @(string.IsNullOrWhiteSpace(d.Observacion) ? "" : $"· {d.Observacion}")
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-8 text-center rounded-lg border" Style="background: #ffffff;">
            <MudIcon Icon="@Icons.Material.Outlined.SendToMobile" Size="Size.Large" Style="color: #1e3a8a;" />
            <MudText Typo="Typo.h6" Class="mt-2" Style="font-weight: 800; color: #0f172a;">
                Seleccione un Lote de Nómina o una Operación y presione Consultar Colaboradores
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #475569; max-width: 620px; margin: 4px auto 0;">
                Aquí podrá visualizar el consolidado y detalle día a día de días laborados junto con la colilla de pago, y enviarlos en Imagen directa o PDF por WhatsApp.
            </MudText>
        </MudPaper>
    }
</MudContainer>

@* --- MODAL EJECUTIVO: CONSOLIDADO Y DETALLE DE DATOS DE LA GRILLA --- *@
@if (MostrarModalResumenGrilla)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Elevation="12"
                  Class="rounded-xl overflow-hidden d-flex flex-column"
                  Style="width: 96vw; max-width: 1260px; max-height: 92vh; background: #ffffff;">

            @* Encabezado del Modal *@
            <div class="pa-4 d-flex flex-wrap align-center justify-space-between gap-2"
                 style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                <div class="d-flex align-center gap-3">
                    <div class="d-flex align-center justify-center rounded-lg"
                         style="width: 42px; height: 42px; background: #1e3a8a; color: #ffffff;">
                        <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Medium" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a; line-height: 1.2;">
                            Consolidado y Detalle de Datos de la Grilla
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color: #475569; font-weight: 600;">
                            @($"Período: {FechaDesde:dd/MM/yyyy} al {FechaHasta:dd/MM/yyyy} · {ColaboradoresFiltrados.Count} colaboradores en vista")
                        </MudText>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-center gap-2">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               Disabled="@DescargandoPdfGrilla"
                               OnClick="DescargarPdfConsolidadoGrillaAsync"
                               Class="wa-row-btn-pdf"
                               Style="padding: 6px 14px !important; font-size: 0.8rem !important;">
                        @(DescargandoPdfGrilla ? "Generando PDF..." : "Descargar PDF (Consolidado y Detalle)")
                    </MudButton>

                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Default"
                                   OnClick="@(() => MostrarModalResumenGrilla = false)" />
                </div>
            </div>

            @* Franja KPI de Totales de la Grilla *@
            <div class="px-4 py-3" style="background: #ffffff; border-bottom: 1px solid #e2e8f0;">
                <div class="d-flex flex-wrap align-center justify-space-between gap-3">
                    <div class="d-flex flex-wrap gap-3" style="font-size: 0.8rem;">
                        <div class="px-3 py-1 rounded border" style="background: #f8fafc;">
                            <span style="color: #64748b;">Días Ord.:</span>
                            <b style="color: #0f172a; margin-left: 4px;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasTrabajadosOrdinarios):N2}")</b>
                        </div>
                        <div class="px-3 py-1 rounded border" style="background: #f8fafc;">
                            <span style="color: #64748b;">Séptimos:</span>
                            <b style="color: #0f172a; margin-left: 4px;">@($"{ColaboradoresFiltrados.Sum(x => x.SeptimoDia):N2}")</b>
                        </div>
                        <div class="px-3 py-1 rounded border" style="background: #f8fafc;">
                            <span style="color: #64748b;">Feriados:</span>
                            <b style="color: #0f172a; margin-left: 4px;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasFeriados):N2}")</b>
                        </div>
                        <div class="px-3 py-1 rounded border" style="background: #eff6ff; border-color: #bfdbfe !important;">
                            <span style="color: #1e3a8a;">Vacaciones:</span>
                            <b style="color: #1e3a8a; margin-left: 4px;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasVacacionesDescansadas):N2}")</b>
                        </div>
                        <div class="px-3 py-1 rounded border" style="background: #fef2f2; border-color: #fecaca !important;">
                            <span style="color: #b91c1c;">Ausencias:</span>
                            <b style="color: #b91c1c; margin-left: 4px;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasJustificados + x.DiasInjustificados + x.DiasSubsidio):N2}")</b>
                        </div>
                        <div class="px-3 py-1 rounded border" style="background: #ecfdf5; border-color: #6ee7b7 !important;">
                            <span style="color: #065f46;">Total Días a Pagar:</span>
                            <b style="color: #065f46; margin-left: 4px;">@($"{ColaboradoresFiltrados.Sum(x => x.TotalDiasPagar):N2}")</b>
                        </div>
                        <div class="px-3 py-1 rounded border" style="background: #eff6ff; border-color: #bfdbfe !important;">
                            <span style="color: #1e3a8a;">H. Extras:</span>
                            <b style="color: #1e3a8a; margin-left: 4px;">@($"{ColaboradoresFiltrados.Sum(x => x.HorasExtrasPeriodo):N2} hrs")</b>
                        </div>
                        @if (IncluirColilla)
                        {
                            <div class="px-3 py-1 rounded border" style="background: #f0f9ff; border-color: #bae6fd !important;">
                                <span style="color: #0369a1;">Neto Colillas:</span>
                                <b style="color: #0369a1; margin-left: 4px;">@($"C$ {ColaboradoresFiltrados.Sum(x => x.NetoAPagar):N2}")</b>
                            </div>
                        }
                    </div>

                    @* Selector de Pestaña Consolidado vs Detalle Día a Día *@
                    <div class="d-flex align-center gap-2">
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Summarize"
                                   OnClick="@(() => { VistaResumenGrilla = "CONSOLIDADO"; EmpleadoFiltroDetalleId = 0; })"
                                   Class="@(VistaResumenGrilla == "CONSOLIDADO" ? "wa-tab-btn-active" : "wa-tab-btn-inactive")">
                            1. Consolidado General (@ColaboradoresFiltrados.Count)
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.CalendarMonth"
                                   OnClick="@(() => VistaResumenGrilla = "DETALLE")"
                                   Class="@(VistaResumenGrilla == "DETALLE" ? "wa-tab-btn-active" : "wa-tab-btn-inactive")">
                            2. Detalle Día a Día (@ColaboradoresFiltrados.Sum(x => x.DetalleDias?.Count ?? 0))
                        </MudButton>
                    </div>
                </div>
            </div>

            @* Contenido desplazable del Modal *@
            <div class="pa-4" style="overflow-y: auto; flex: 1;">
                @if (VistaResumenGrilla == "CONSOLIDADO")
                {
                    <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 10px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.79rem;">
                            <thead>
                                <tr style="background: #1e3a8a; color: #ffffff;">
                                    <th style="padding: 8px 6px; text-align: left;">Cód.</th>
                                    <th style="padding: 8px 6px; text-align: left;">Colaborador</th>
                                    <th style="padding: 8px 6px; text-align: left;">Operación / Cargo</th>
                                    <th style="padding: 8px 6px; text-align: right;">Hábiles</th>
                                    <th style="padding: 8px 6px; text-align: right;">Asist.</th>
                                    <th style="padding: 8px 6px; text-align: right;">Días Ord.</th>
                                    <th style="padding: 8px 6px; text-align: right;">Séptimos</th>
                                    <th style="padding: 8px 6px; text-align: right;">Feriados</th>
                                    <th style="padding: 8px 6px; text-align: right;">Vacaciones</th>
                                    <th style="padding: 8px 6px; text-align: right;">Ausencias</th>
                                    <th style="padding: 8px 6px; text-align: right; background: #065f46;">Total Días</th>
                                    <th style="padding: 8px 6px; text-align: right;">H. Extras</th>
                                    <th style="padding: 8px 6px; text-align: right;">Viáticos</th>
                                    @if (IncluirColilla)
                                    {
                                        <th style="padding: 8px 6px; text-align: right;">Neto C$</th>
                                    }
                                    <th style="padding: 8px 6px; text-align: center;">Detalle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rIdx = 0; }
                                @foreach (var emp in ColaboradoresFiltrados.OrderBy(x => x.NombreEmpleado))
                                {
                                    decimal ausEmp = emp.DiasJustificados + emp.DiasInjustificados + emp.DiasSubsidio;
                                    string bg = rIdx % 2 == 0 ? "#ffffff" : "#f8fafc";
                                    rIdx++;
                                    <tr style="background: @bg; border-bottom: 1px solid #e2e8f0;">
                                        <td style="padding: 6px; font-weight: 700; color: #1e3a8a;">@(emp.CodigoEmpleado > 0 ? $"#{emp.CodigoEmpleado}" : "-")</td>
                                        <td style="padding: 6px; font-weight: 700; color: #0f172a;">@emp.NombreEmpleado</td>
                                        <td style="padding: 6px; color: #475569;">
                                            <span style="font-weight: 600; color: #1e293b;">@emp.OperacionNombre</span>
                                            @if (!string.IsNullOrWhiteSpace(emp.Cargo))
                                            {
                                                <span> · @emp.Cargo</span>
                                            }
                                        </td>
                                        <td style="padding: 6px; text-align: right;">@($"{emp.DiasHabilesPeriodo:0.##}")</td>
                                        <td style="padding: 6px; text-align: right;">@emp.DiasAsistidosCalendario</td>
                                        <td style="padding: 6px; text-align: right; font-weight: 600;">@($"{emp.DiasTrabajadosOrdinarios:0.##}")</td>
                                        <td style="padding: 6px; text-align: right;">@($"{emp.SeptimoDia:0.##}")</td>
                                        <td style="padding: 6px; text-align: right;">@($"{emp.DiasFeriados:0.##}")</td>
                                        <td style="padding: 6px; text-align: right; font-weight: @(emp.DiasVacacionesDescansadas > 0 ? "700" : "400"); color: @(emp.DiasVacacionesDescansadas > 0 ? "#1e3a8a" : "#475569");">
                                            @($"{emp.DiasVacacionesDescansadas:0.##}")
                                        </td>
                                        <td style="padding: 6px; text-align: right; font-weight: @(ausEmp > 0 ? "700" : "400"); color: @(ausEmp > 0 ? "#dc2626" : "#475569");">
                                            @($"{ausEmp:0.##}")
                                        </td>
                                        <td style="padding: 6px; text-align: right; font-weight: 800; color: #065f46; background: #ecfdf5;">
                                            @($"{emp.TotalDiasPagar:0.##}")
                                        </td>
                                        <td style="padding: 6px; text-align: right; font-weight: 700; color: @(emp.HorasExtrasPeriodo > 0 ? "#1e3a8a" : "#64748b");">
                                            @($"{emp.HorasExtrasPeriodo:0.##}")
                                        </td>
                                        <td style="padding: 6px; text-align: right;">@($"{emp.ViaticosBonoPeriodo:N2}")</td>
                                        @if (IncluirColilla)
                                        {
                                            <td style="padding: 6px; text-align: right; font-weight: 700; color: #0f172a;">
                                                @(emp.TieneColilla ? $"{emp.NetoAPagar:N2}" : "-")
                                            </td>
                                        }
                                        <td style="padding: 4px 6px; text-align: center;">
                                            <MudButton Variant="Variant.Text"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => VerDetalleColaboradorEnModal(emp.EmployeeId))"
                                                       Style="text-transform: none; font-weight: 700; font-size: 0.74rem; min-width: auto;">
                                                Ver días (@(emp.DetalleDias?.Count ?? 0))
                                            </MudButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr style="background: #eff6ff; border-top: 2px solid #93c5fd; font-weight: 800; color: #0f172a;">
                                    <td colspan="4" style="padding: 8px 6px; text-align: right; color: #1e3a8a;">TOTALES CONSOLIDADOS DE LA GRILLA:</td>
                                    <td style="padding: 8px 6px; text-align: right;">@ColaboradoresFiltrados.Sum(x => x.DiasAsistidosCalendario)</td>
                                    <td style="padding: 8px 6px; text-align: right;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasTrabajadosOrdinarios):N2}")</td>
                                    <td style="padding: 8px 6px; text-align: right;">@($"{ColaboradoresFiltrados.Sum(x => x.SeptimoDia):N2}")</td>
                                    <td style="padding: 8px 6px; text-align: right;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasFeriados):N2}")</td>
                                    <td style="padding: 8px 6px; text-align: right; color: #1e3a8a;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasVacacionesDescansadas):N2}")</td>
                                    <td style="padding: 8px 6px; text-align: right; color: #dc2626;">@($"{ColaboradoresFiltrados.Sum(x => x.DiasJustificados + x.DiasInjustificados + x.DiasSubsidio):N2}")</td>
                                    <td style="padding: 8px 6px; text-align: right; color: #065f46; background: #d1fae5;">@($"{ColaboradoresFiltrados.Sum(x => x.TotalDiasPagar):N2}")</td>
                                    <td style="padding: 8px 6px; text-align: right; color: #1e3a8a;">@($"{ColaboradoresFiltrados.Sum(x => x.HorasExtrasPeriodo):N2}")</td>
                                    <td style="padding: 8px 6px; text-align: right;">@($"{ColaboradoresFiltrados.Sum(x => x.ViaticosBonoPeriodo):N2}")</td>
                                    @if (IncluirColilla)
                                    {
                                        <td style="padding: 8px 6px; text-align: right; color: #065f46;">@($"C$ {ColaboradoresFiltrados.Sum(x => x.NetoAPagar):N2}")</td>
                                    }
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    @* Barra de filtro dentro del Detalle Día a Día *@
                    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudSelect T="int"
                                       Label="Filtrar por Colaborador"
                                       @bind-Value="EmpleadoFiltroDetalleId"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Style="min-width: 310px; max-width: 420px;">
                                <MudSelectItem T="int" Value="0">-- Todos los colaboradores de la grilla (@ColaboradoresFiltrados.Count) --</MudSelectItem>
                                @foreach (var emp in ColaboradoresFiltrados.OrderBy(x => x.NombreEmpleado))
                                {
                                    <MudSelectItem T="int" Value="@emp.EmployeeId">
                                        @($"{(emp.CodigoEmpleado > 0 ? $"#{emp.CodigoEmpleado} - " : "")}{emp.NombreEmpleado}")
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField T="string"
                                          @bind-Value="BusquedaDetalleModal"
                                          Placeholder="Buscar colaborador o área..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="min-width: 240px;" />

                            @if (EmpleadoFiltroDetalleId > 0 || !string.IsNullOrWhiteSpace(BusquedaDetalleModal))
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           OnClick="@(() => { EmpleadoFiltroDetalleId = 0; BusquedaDetalleModal = string.Empty; })"
                                           Style="text-transform: none; font-weight: 700;">
                                    Mostrar todos
                                </MudButton>
                            }
                        </div>

                        <MudText Typo="Typo.caption" Style="color: #475569; font-weight: 700;">
                            @($"Mostrando {FilasDetalleGrilla.Count} registros diarios")
                        </MudText>
                    </div>

                    <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 10px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.78rem;">
                            <thead>
                                <tr style="background: #0f172a; color: #ffffff;">
                                    <th style="padding: 8px 6px; text-align: left;">Fecha</th>
                                    <th style="padding: 8px 6px; text-align: left;">Día</th>
                                    <th style="padding: 8px 6px; text-align: left;">Cód.</th>
                                    <th style="padding: 8px 6px; text-align: left;">Colaborador</th>
                                    <th style="padding: 8px 6px; text-align: left;">Área / Cliente</th>
                                    <th style="padding: 8px 6px; text-align: center;">Entrada</th>
                                    <th style="padding: 8px 6px; text-align: center;">Salida</th>
                                    <th style="padding: 8px 6px; text-align: right;">Hrs</th>
                                    <th style="padding: 8px 6px; text-align: right;">Día Eq.</th>
                                    <th style="padding: 8px 6px; text-align: right;">H. Extras</th>
                                    <th style="padding: 8px 6px; text-align: right;">Viáticos</th>
                                    <th style="padding: 8px 6px; text-align: left;">Estado / Observación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var filasDet = FilasDetalleGrilla;
                                    int dIdx = 0;
                                }
                                @if (filasDet.Count == 0)
                                {
                                    <tr>
                                        <td colspan="12" style="padding: 18px; text-align: center; color: #64748b;">
                                            No se encontraron marcaciones diarias para el filtro seleccionado.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in filasDet)
                                    {
                                        var d = row.Dia;
                                        bool esVac = !d.Asistio && (d.EstadoTexto ?? string.Empty).Contains("Vacacion", StringComparison.OrdinalIgnoreCase);
                                        string bg = !d.Asistio
                                            ? (esVac ? "#eff6ff" : "#fff1f2")
                                            : (dIdx % 2 == 0 ? "#ffffff" : "#f8fafc");
                                        string colObs = !d.Asistio ? (esVac ? "#1e3a8a" : "#dc2626") : "#334155";
                                        dIdx++;
                                        <tr style="background: @bg; border-bottom: 1px solid #e2e8f0;">
                                            <td style="padding: 5px 6px; white-space: nowrap;">@($"{d.Fecha:dd/MM/yyyy}")</td>
                                            <td style="padding: 5px 6px; color: #475569;">@ObtenerDiaCorto(d.Fecha)</td>
                                            <td style="padding: 5px 6px; font-weight: 700; color: #1e3a8a;">@(row.CodigoEmpleado > 0 ? $"#{row.CodigoEmpleado}" : "-")</td>
                                            <td style="padding: 5px 6px; font-weight: 600; color: #0f172a;">@row.NombreEmpleado</td>
                                            <td style="padding: 5px 6px;">@(string.IsNullOrWhiteSpace(d.Area) ? d.Cliente : d.Area)</td>
                                            <td style="padding: 5px 6px; text-align: center;">@(string.IsNullOrWhiteSpace(d.HoraEntrada) ? "-" : d.HoraEntrada)</td>
                                            <td style="padding: 5px 6px; text-align: center;">@(string.IsNullOrWhiteSpace(d.HoraSalida) ? "-" : d.HoraSalida)</td>
                                            <td style="padding: 5px 6px; text-align: right;">@(d.HorasOrdinarias > 0 ? $"{d.HorasOrdinarias:0.##}" : "-")</td>
                                            <td style="padding: 5px 6px; text-align: right; font-weight: 600;">@(d.DiasEquivalentes > 0 ? $"{d.DiasEquivalentes:0.##}" : "-")</td>
                                            <td style="padding: 5px 6px; text-align: right; font-weight: 700; color: @(d.HorasExtras > 0 ? "#1e3a8a" : "#64748b");">
                                                @(d.HorasExtras > 0 ? $"{d.HorasExtras:0.##}" : "-")
                                            </td>
                                            <td style="padding: 5px 6px; text-align: right;">@(d.ViaticosBono > 0 ? $"{d.ViaticosBono:N2}" : "-")</td>
                                            <td style="padding: 5px 6px; color: @colObs;">
                                                @d.EstadoTexto @(string.IsNullOrWhiteSpace(d.Observacion) ? "" : $"· {d.Observacion}")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (filasDet.Count > 0)
                            {
                                <tfoot>
                                    <tr style="background: #f1f5f9; border-top: 2px solid #cbd5e1; font-weight: 800; color: #0f172a;">
                                        <td colspan="7" style="padding: 8px 6px; text-align: right;">SUBTOTALES DE MARCACIONES MOSTRADAS:</td>
                                        <td style="padding: 8px 6px; text-align: right;">@($"{filasDet.Sum(x => x.Dia.HorasOrdinarias):N2}")</td>
                                        <td style="padding: 8px 6px; text-align: right;">@($"{filasDet.Sum(x => x.Dia.DiasEquivalentes):N2}")</td>
                                        <td style="padding: 8px 6px; text-align: right; color: #1e3a8a;">@($"{filasDet.Sum(x => x.Dia.HorasExtras):N2}")</td>
                                        <td style="padding: 8px 6px; text-align: right;">@($"{filasDet.Sum(x => x.Dia.ViaticosBono):N2}")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                }
            </div>
        </MudPaper>
    </MudOverlay>
}
