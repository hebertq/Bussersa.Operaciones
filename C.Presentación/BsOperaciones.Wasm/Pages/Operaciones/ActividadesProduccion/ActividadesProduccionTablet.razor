    // Estandarización de 3 Filtros Dinámicos en Cascada
    public class NivelFiltroDinamico
    {
        public string Clave { get; set; } = string.Empty;
        public string Titulo { get; set; } = string.Empty;
        public string ValorSeleccionado { get; set; } = string.Empty;
        public string BusquedaRapida { get; set; } = string.Empty;
