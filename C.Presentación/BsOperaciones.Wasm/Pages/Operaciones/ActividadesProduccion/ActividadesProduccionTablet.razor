        new ServicioInfoItem { TemplateId = 844, NombreCorto = "Desarme y Paletizado", Descripcion = "Desarme, paletizado y excedente de paletizantes", Icono = Icons.Material.Filled.Inventory },
        new ServicioInfoItem { TemplateId = 845, NombreCorto = "Movimientos Varios", Descripcion = "Movimientos entre contenedores y cuartos fríos", Icono = Icons.Material.Filled.MoveToInbox },
        new ServicioInfoItem { TemplateId = 837, NombreCorto = "Armado de Productos", Descripcion = "Armado de ofertas, packs y combos", Icono = Icons.Material.Filled.Build },
        new ServicioInfoItem { TemplateId = 853, NombreCorto = "Prelimpia de Productos", Descripcion = "Prelimpia y selección (Maíz, Cacao, Café)", Icono = Icons.Material.Filled.CleaningServices },
        new ServicioInfoItem { TemplateId = 847, NombreCorto = "Emplanchado / Desemplanchado", Descripcion = "Emplanchado y desemplanchado de productos", Icono = Icons.Material.Filled.TableRows },
        new ServicioInfoItem { TemplateId = 12, NombreCorto = "Carga y Descarga", Descripcion = "Carga y descarga de furgones y contenedores", Icono = Icons.Material.Filled.LocalShipping },
        new ServicioInfoItem { TemplateId = 838, NombreCorto = "Destrucción de Mermas", Descripcion = "Destrucción de mermas y productos no conformes", Icono = Icons.Material.Filled.DeleteSweep },
        new ServicioInfoItem { TemplateId = 852, NombreCorto = "Lavado / Limpieza Polines", Descripcion = "Lavado, limpieza y ordenamiento de polines", Icono = Icons.Material.Filled.CleaningServices },
        new ServicioInfoItem { TemplateId = 836, NombreCorto = "Limpieza de Producto", Descripcion = "Limpieza y acondicionamiento de producto terminado", Icono = Icons.Material.Filled.AutoAwesome }
    };

    private List<ServicioInfoItem> serviciosDisponibles = MasterCatalogoServicios.ToList();

    private ServicioInfoItem? servicioSeleccionado;
    private List<OdooVariantDto> todasVariantesServicio = new();
    private List<OdooVariantDto> variantesFiltradas = new();
    private OdooVariantDto? varianteSeleccionada;

    // Filtros activos
    private string filtroProducto = "";
    private string filtroBandeo = "";
    private string filtroPresentacion = "";
    private string filtroClimatizacion = "";

    // Opciones para chips
    private List<string> productosDisponibles = new();
    private List<string> bandeosDisponibles = new();
    private List<string> presentacionesDisponibles = new();
    private List<string> climatizacionesDisponibles = new();

    // Formulario de producción
    private decimal cantidadProducida = 0;
    private string noLote = "";
    private string ordenCompra = "";
    private string observaciones = "";

    // Historial del día
    private List<ProduccionDiariaDto> historialHoy = new();

    private bool PuedeGuardar => varianteSeleccionada != null && cantidadProducida > 0;    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                currentUserName = auth.User?.Identity?.Name ?? "Admin";
            }
        }
        catch { }

        try
        {
            var regop = await Mediator.Send(new GetAllCombosQuery("Operaciones"));
            if (!regop.Respuesta.ExisteError && regop.Model != null)
            {
                operacionesList = regop.Model.OrderBy(c => c.nombre).ToList();
            }
        }
        catch { }

        try
        {
            var guardado = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "actividades_tablet_cliente_id");
            if (int.TryParse(guardado, out int opId) && operacionesList.Any(o => o.id == opId))
            {
                operacionSeleccionadaId = opId;
            }
            else if (operacionesList.Any(o => o.id == 27))
            {
                operacionSeleccionadaId = 27;
            }
            else if (operacionesList.Any())
            {
                operacionSeleccionadaId = operacionesList.First().id;
            }
        }
        catch
        {
            if (operacionesList.Any()) operacionSeleccionadaId = operacionesList.First().id;
        }

        ActualizarNombreOperacion();
        await CargarAreasCliente();
        await CargarServiciosPorClienteYSupervisor();

        if (serviciosDisponibles.Any())
        {
            await SeleccionarServicio(serviciosDisponibles[0]);
        }
        await CargarHistorialHoy();
    }

    private async Task CargarAreasCliente()
    {
        try
        {
            var res = await OdooService.GetAreasOperacion(operacionSeleccionadaId);
            if (res?.Model != null && res.Model.Any())
            {
                areasClienteList = res.Model
                    .Select(a => a.Trim())
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(s => s)
                    .ToList();
            }
            else
            {
                areasClienteList = new List<string> { "CD" };
            }
        }
        catch
        {
            areasClienteList = new List<string> { "CD" };
        }

        if (!areasClienteList.Contains(areaSeleccionada, StringComparer.OrdinalIgnoreCase))
        {
            areaSeleccionada = areasClienteList.FirstOrDefault() ?? "CD";
        }
    }

    private async Task CargarServiciosPorClienteYSupervisor()
    {
        try
        {
            string? supFilter = (currentUserName.Equals("admin", StringComparison.OrdinalIgnoreCase) || 
                                 currentUserName.Equals("admin@bussersa.com", StringComparison.OrdinalIgnoreCase) ||
                                 currentUserName.Equals("hquintero", StringComparison.OrdinalIgnoreCase))
                                ? null : currentUserName;

            var res = await OdooService.GetClienteActividadesConfig(operacionSeleccionadaId, areaSeleccionada, supFilter);
            if (res?.Model != null && res.Model.Any())
            {
                configsCliente = res.Model.ToList();
                
                serviciosDisponibles = MasterCatalogoServicios
                    .Where(s => configsCliente.Any(c => c.TemplateId == s.TemplateId))
                    .ToList();

                if (!serviciosDisponibles.Any())
                {
                    serviciosDisponibles = MasterCatalogoServicios.ToList();
                }
            }
            else
            {
                serviciosDisponibles = MasterCatalogoServicios.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando configs actividades: {ex.Message}");
            serviciosDisponibles = MasterCatalogoServicios.ToList();
        }
    }

    private async Task OnOperacionChanged(int nuevoId)
    {
        operacionSeleccionadaId = nuevoId;
        ActualizarNombreOperacion();
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "actividades_tablet_cliente_id", nuevoId.ToString());
        }
        catch { }

        await CargarAreasCliente();
        await CargarServiciosPorClienteYSupervisor();

        if (serviciosDisponibles.Any())
        {
            await SeleccionarServicio(serviciosDisponibles[0]);
        }
        else
        {
            servicioSeleccionado = null;
            varianteSeleccionada = null;
            todasVariantesServicio.Clear();
            variantesFiltradas.Clear();
        }
        await CargarHistorialHoy();
    }

    private async Task OnAreaChanged(string nuevaArea)
    {
        areaSeleccionada = nuevaArea;
        await CargarServiciosPorClienteYSupervisor();
        if (servicioSeleccionado != null && serviciosDisponibles.Any(s => s.TemplateId == servicioSeleccionado.TemplateId))
        {
            await SeleccionarServicio(servicioSeleccionado);
        }
        else if (serviciosDisponibles.Any())
        {
            await SeleccionarServicio(serviciosDisponibles[0]);
        }
        else
        {
            servicioSeleccionado = null;
            varianteSeleccionada = null;
        }
    }

    private async Task OnTurnoChanged(string nuevoTurno)
    {
        turnoSeleccionado = nuevoTurno;
        AplicarFiltros();
        await Task.CompletedTask;
    }

    private void ActualizarNombreOperacion()
    {
        var op = operacionesList.FirstOrDefault(o => o.id == operacionSeleccionadaId);
        operacionSeleccionadaNombre = op?.nombre ?? "Operación #" + operacionSeleccionadaId;
    }

    private async Task SeleccionarServicio(ServicioInfoItem serv)
    {
        servicioSeleccionado = serv;
        varianteSeleccionada = null;
        LimpiarFiltros();

        estaCargando = true;
        mensajeCarga = $"Cargando catálogo de {serv.NombreCorto}...";
        StateHasChanged();

        try
        {
            var res = await OdooService.GetProductVariants(serv.TemplateId);
            if (!res.Respuesta.ExisteError && res.Model != null)
            {
                var all = res.Model.ToList();

                // Filtrar variantes por cliente automáticamente
                string nombreCliente = operacionSeleccionadaNombre.Trim().ToLowerInvariant();
                var variantesCliente = all.Where(v => v.nombre.ToLowerInvariant().Contains(nombreCliente)).ToList();

                if (variantesCliente.Any())
                {
                    todasVariantesServicio = variantesCliente;
                }
                else
                {
                    // Si el cliente no tiene nombre exacto en variantes, intentar con palabras clave
                    string[] palabras = nombreCliente.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                    var matchFuzzy = all.Where(v => palabras.Any(p => p.Length > 3 && v.nombre.ToLowerInvariant().Contains(p))).ToList();
                    todasVariantesServicio = matchFuzzy.Any() ? matchFuzzy : all;
                }

                serv.VariantesCount = todasVariantesServicio.Count;
                ExtraerOpcionesFiltros();
                AplicarFiltros();
            }
            else
            {
                Snackbar.Add($"No se pudieron cargar las variantes: {res.Respuesta.MensajeError}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar variantes: {ex.Message}", Severity.Error);
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }
    }

    private void ExtraerOpcionesFiltros()
    {
        var prods = new HashSet<string>();
        var bans = new HashSet<string>();
        var pres = new HashSet<string>();
        var clim = new HashSet<string>();

        foreach (var v in todasVariantesServicio)
        {
            var dict = ParsearAtributos(v.nombre);
            if (dict.TryGetValue("Producto", out var p)) prods.Add(p);
            if (dict.TryGetValue("Bandeo", out var b)) bans.Add(b);
            if (dict.TryGetValue("Precentación", out var pr)) pres.Add(pr);
            if (dict.TryGetValue("Presentación", out var pr2)) pres.Add(pr2);
            if (dict.TryGetValue("Climatización", out var cl)) clim.Add(cl);
        }

        productosDisponibles = prods.OrderBy(x => x).ToList();
        bandeosDisponibles = bans.OrderBy(x => x).ToList();
        presentacionesDisponibles = pres.OrderBy(x => x).ToList();
        climatizacionesDisponibles = clim.OrderBy(x => x).ToList();
    }

    private Dictionary<string, string> ParsearAtributos(string nombre)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(nombre)) return dict;

        var partes = nombre.Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var parte in partes)
        {
            var kv = parte.Split(new[] { ": " }, 2, StringSplitOptions.None);
            if (kv.Length == 2)
            {
                dict[kv[0].Trim()] = kv[1].Trim();
            }
        }
        return dict;
    }

    private string LimpiarNombreVariante(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "";
        return nombre.Replace($"Cliente: {operacionSeleccionadaNombre}, ", "", StringComparison.OrdinalIgnoreCase)
                     .Replace("Cliente: CBC Pepsi, ", "", StringComparison.OrdinalIgnoreCase)
                     .Replace("Area: CD, ", "")
                     .Replace("Precentación:", "Pres:");
    }

    private void ToggleFiltroProducto(string prod)
    {
        filtroProducto = filtroProducto == prod ? "" : prod;
        AplicarFiltros();
    }

    private void ToggleFiltroBandeo(string ban)
    {
        filtroBandeo = filtroBandeo == ban ? "" : ban;
        AplicarFiltros();
    }

    private void ToggleFiltroPresentacion(string pres)
    {
        filtroPresentacion = filtroPresentacion == pres ? "" : pres;
        AplicarFiltros();
    }

    private void ToggleFiltroClimatizacion(string clim)
    {
        filtroClimatizacion = filtroClimatizacion == clim ? "" : clim;
        AplicarFiltros();
    }

    private void LimpiarFiltros()
    {
        filtroProducto = "";
        filtroBandeo = "";
        filtroPresentacion = "";
        filtroClimatizacion = "";
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var q = todasVariantesServicio.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroProducto))
        {
            q = q.Where(v => v.nombre.Contains($"Producto: {filtroProducto}", StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroBandeo))
        {
            q = q.Where(v => v.nombre.Contains($"Bandeo: {filtroBandeo}", StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroPresentacion))
        {
            q = q.Where(v => v.nombre.Contains($"Precentación: {filtroPresentacion}", StringComparison.OrdinalIgnoreCase) ||
                             v.nombre.Contains($"Presentación: {filtroPresentacion}", StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroClimatizacion))
        {
            q = q.Where(v => v.nombre.Contains($"Climatización: {filtroClimatizacion}", StringComparison.OrdinalIgnoreCase));
        }        // 1. Filtro por Área si la variante la especifica
        bool plantillaTieneArea = todasVariantesServicio.Any(v => v.nombre.Contains("Area:", StringComparison.OrdinalIgnoreCase) || v.nombre.Contains("Área:", StringComparison.OrdinalIgnoreCase));
        if (plantillaTieneArea && !string.IsNullOrWhiteSpace(areaSeleccionada))
        {
            var matchArea = q.Where(v => v.nombre.Contains($"Area: {areaSeleccionada}", StringComparison.OrdinalIgnoreCase) ||
                                         v.nombre.Contains($"Área: {areaSeleccionada}", StringComparison.OrdinalIgnoreCase)).ToList();
            if (matchArea.Any())
            {
                q = matchArea;
            }
        }

        // 2. Filtro por Turno si la plantilla tiene Turno configurado o en variante
        bool plantillaTieneTurno = (servicioSeleccionado != null && configsCliente.Any(c => c.TemplateId == servicioSeleccionado.TemplateId && c.TieneTurno)) ||
                                   todasVariantesServicio.Any(v => v.nombre.Contains("Turno:", StringComparison.OrdinalIgnoreCase));
        if (plantillaTieneTurno && !string.IsNullOrWhiteSpace(turnoSeleccionado))
        {
            var matchTurno = q.Where(v => v.nombre.Contains($"Turno: {turnoSeleccionado}", StringComparison.OrdinalIgnoreCase)).ToList();
            if (matchTurno.Any())
            {
                q = matchTurno;
            }
        }

        variantesFiltradas = q.ToList();

        // Si solo queda 1 variante, preseleccionarla automáticamente
        if (variantesFiltradas.Count == 1)
        {
            varianteSeleccionada = variantesFiltradas[0];
        }
    }

    private void SeleccionarVariante(OdooVariantDto v)
    {
        varianteSeleccionada = v;
        Snackbar.Add($"Variante seleccionada: {v.default_code}", Severity.Info);
    }

    private void SumarCantidad(decimal delta)
    {
        cantidadProducida += delta;
    }

    private void RestarCantidad(decimal delta)
    {
        cantidadProducida = Math.Max(0, cantidadProducida - delta);
    }

    private void CambiarFecha(int dias)
    {
        fechaJornada = fechaJornada.AddDays(dias);
        _ = CargarHistorialHoy();
    }

    private void SetFechaHoy()
    {
        fechaJornada = DateTime.Today;
        _ = CargarHistorialHoy();
    }

    private void OnFechaChanged(DateTime? dt)
    {
        if (dt.HasValue)
        {
            fechaJornada = dt.Value;
            _ = CargarHistorialHoy();
        }
    }

    private async Task GuardarProduccion()
    {
        if (!PuedeGuardar) return;

        estaCargando = true;
        mensajeCarga = "Guardando producción de actividad...";
        StateHasChanged();

        try
        {
            var dict = ParsearAtributos(varianteSeleccionada!.nombre);
            string prodName = dict.TryGetValue("Producto", out var p) ? p : varianteSeleccionada.template_name;

            var item = new ProduccionDiariaDto
            {
                cliente = operacionSeleccionadaNombre,
                operacion_id = operacionSeleccionadaId,
                actividad = servicioSeleccionado?.NombreCorto ?? "Actividad de Producción",
                area_cliente = areaSeleccionada,
                servicio_codigo = varianteSeleccionada.default_code,
                servicio_descripcion = varianteSeleccionada.nombre,
                nombre_producto = prodName,
                cantidad_producto = cantidadProducida,
                costo_producto = 0, // Backend aplica automáticamente fixed_price de lista
                fecha_inicio = fechaJornada.Date,
                fecha_fin = fechaJornada.Date,
                hora_inicio = turnoSeleccionado.Contains("Nocturno") ? "19:00" : "07:00",
                hora_fin = turnoSeleccionado.Contains("Nocturno") ? "07:00" : "19:00",
                no_lote = string.IsNullOrWhiteSpace(noLote) ? null : noLote.Trim(),
                oc = string.IsNullOrWhiteSpace(ordenCompra) ? null : ordenCompra.Trim(),
                asignado_a = string.IsNullOrWhiteSpace(observaciones) ? null : observaciones.Trim(),
                facturada = false
            };

            var res = await OdooService.ImportarProduccionDiaria(new List<ProduccionDiariaDto> { item });
            if (!res.Respuesta.ExisteError)
            {
                Snackbar.Add($"¡Actividad registrada con éxito! {cantidadProducida:N0} unidades de {varianteSeleccionada.default_code}.", Severity.Success);
                
                // Reiniciar entrada para siguiente actividad
                cantidadProducida = 0;
                noLote = "";
                ordenCompra = "";
                varianteSeleccionada = null;
                LimpiarFiltros();
                await CargarHistorialHoy();
            }
            else
            {
                Snackbar.Add($"Error al guardar producción: {res.Respuesta.MensajeError}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarHistorialHoy()
    {
        try
        {
            var res = await OdooService.GetProduccionDiaria(fechaJornada, fechaJornada, operacionSeleccionadaId, null);
            if (!res.Respuesta.ExisteError && res.Model != null)
            {
                historialHoy = res.Model.OrderByDescending(h => h.id).ToList();
            }
            else
            {
                historialHoy = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar historial: {ex.Message}");
        }
    }
}
