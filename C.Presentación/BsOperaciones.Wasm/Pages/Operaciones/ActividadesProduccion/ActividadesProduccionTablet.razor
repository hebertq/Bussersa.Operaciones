@page "/operaciones/actividades-tablet"
@page "/operaciones/actividades-produccion"
@layout TabletLayout
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Entidades.Operaciones
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@using MediatR
@using BsOperaciones.Application.Features.Odoo.Queries
@implements IDisposable
@using System.Text.Json
@inject IOdooService OdooService
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IDialogService DialogService

<div class="actividades-tablet-container">
    @* --- OVERLAY DE CARGA Y GUARDADO --- *@
    <MudOverlay Visible="@estaBloqueandoAccion" DarkBackground="true" Absolute="false" ZIndex="99999" Class="d-flex flex-column align-center justify-center">
        <div class="d-flex flex-column align-center pa-6 rounded-xl" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(10px); min-width: 300px; border: 1px solid rgba(255,255,255,0.15);">
            <MudProgressCircular Color="Color.Warning" Size="Size.Large" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6" Class="font-bold text-white text-center">@mensajeCarga</MudText>
            <MudText Typo="Typo.caption" Class="mt-1 text-center" Style="color: #94a3b8;">Procesando datos en Odoo...</MudText>
        </div>
    </MudOverlay>

    @* --- BANNER Y ESTADO DE CONECTIVIDAD (MODO OFFLINE BODEGA) --- *@
    @if (!esModoOnline)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3 py-2 px-3 rounded-xl" Icon="@Icons.Material.Filled.WifiOff" Style="background-color: #ea580c; color: white;">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <div>
                    <b>MODO OFFLINE (BODEGA ACTIVO):</b> Sin señal de internet. Puedes continuar registrando la producción con total normalidad; los registros se guardan en la memoria local de este dispositivo. Al tener señal, presiona <b>Guardar en BD</b>.
                </div>
                @if (pendientesOffline.Any())
                {
                    <MudChip T="string" Color="Color.Surface" Size="Size.Small" Style="color: #ea580c; font-weight: 800;">
                        @pendientesOffline.Count pendientes por guardar en BD
                    </MudChip>
                }
            </div>
        </MudAlert>
    }

    <div class="d-flex align-center justify-space-between mb-2 flex-wrap gap-2">
        <div class="d-flex align-center gap-2">
            @if (!esModoOnline)
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.WifiOff" Style="background: #ea580c; color: white; font-weight: 700;" Title="Sin señal de internet en bodega. Cambios guardados en memoria local.">
                    OFFLINE (BODEGA)
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Wifi" Title="Conectado a internet">
                    EN LÍNEA
                </MudChip>
            }
        </div>

        @* BOTONES TÁCTICOS: ACTUALIZAR Y GUARDAR EN BD (VISIBLES SOLO EN LÍNEA) *@
        <div class="d-flex align-center gap-2">
            @if (esModoOnline)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Small"
                           StartIcon="@(estaActualizando ? null : Icons.Material.Filled.Refresh)"
                           OnClick="ActualizarCatalogoEnLinea"
                           Disabled="estaActualizando"
                           Class="fw-bold"
                           Title="Sincronizar clientes, servicios y variantes en una sola consulta indexada">
                    @if (estaActualizando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                        <span>Actualizando...</span>
                    }
                    else
                    {
                        <span>Actualizar</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Filled" 
                           Color="@(pendientesOffline.Any() ? Color.Success : Color.Default)" 
                           Size="Size.Small"
                           StartIcon="@(estaGuardandoEnBd ? null : Icons.Material.Filled.Save)"
                           OnClick="GuardarEnBaseDeDatos"
                           Disabled="@(!esModoOnline || !pendientesOffline.Any() || estaGuardandoEnBd)"
                           Class="fw-bold"
                           Title="@(pendientesOffline.Any() ? "Guardar en Base de Datos todas las actividades registradas" : "No hay actividades pendientes por guardar")">
                    @if (estaGuardandoEnBd)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                        <span>Guardando en BD...</span>
                    }
                    else if (pendientesOffline.Any())
                    {
                        <span>Guardar en BD (@pendientesOffline.Count)</span>
                    }
                    else
                    {
                        <span>Guardado en BD</span>
                    }
                </MudButton>
            }
        </div>
    </div>

    @if (estaCargando && !clientesPermitidos.Any())
    {
        <MudPaper Elevation="0" Class="pa-12 my-6 text-center rounded-xl border d-flex flex-column align-center justify-center" Style="background: #ffffff; min-height: 420px; border-color: #e2e8f0;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1e3a8a;">Cargando actividades de producción...</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Obteniendo catálogo de clientes, servicios y variantes en memoria.</MudText>
        </MudPaper>
    }
    else
    {
    @* --- TABS DE CLIENTES ASIGNADOS AL SUPERVISOR (CON SERVICIOS CONFIGURADOS) --- *@
    @if (clientesPermitidos.Any())
    {
        <div class="client-tabs-bar mb-3 pa-2 rounded-xl border d-flex align-center gap-2 flex-wrap" style="background: #ffffff; border-color: #e2e8f0;">
            <div class="d-flex align-center gap-1 px-3 py-1" style="border-right: 2px solid #e2e8f0;">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">Clientes:</MudText>
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                @foreach (var c in clientesPermitidos)
                {
                    bool isSelected = c.OperacionId == operacionSeleccionadaId;
                    <button type="button" class="client-tab-btn @(isSelected ? "active" : "")" @onclick="@(() => OnOperacionChanged(c.OperacionId))">
                        <div class="d-flex align-center gap-2">
                            <span class="client-name">@c.ClienteNombre</span>
                            <span class="client-badge">@c.ServiciosCount @(c.ServiciosCount == 1 ? "servicio" : "servicios")</span>
                        </div>
                    </button>
                }
            </div>
        </div>
    }
    else if (!estaCargando)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3 rounded-xl border">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.body2" Class="fw-bold">No tienes clientes con actividades de producción configuradas.</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Configura las plantillas de servicios en <strong>Supervisión &gt; Actividades por Cliente</strong> y verifica que el cliente esté asignado en <strong>Personal por Cliente</strong>.
                    </MudText>
                </div>
            </div>
        </MudAlert>
    }

    @* --- CABECERA DE JORNADA Y CLIENTE --- *@
    <MudPaper Elevation="2" Class="pa-3 mb-3 rounded-xl border" Style="background: #ffffff; border-color: #e2e8f0; border-left: 6px solid #f97316;">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            @* Navegación de Fecha *@
            <MudItem xs="12" sm="6" md="4">
                <div class="d-flex align-center gap-1">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Medium" OnClick="@(() => CambiarFecha(-1))" Title="Día anterior" />
                    <MudDatePicker Label="Fecha de Producción" 
                                   Date="@fechaJornada" 
                                   DateChanged="@OnFechaChanged"
                                   DateFormat="dd/MM/yyyy" 
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense" 
                                   Class="flex-grow-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Medium" OnClick="@(() => CambiarFecha(1))" Title="Día siguiente" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="@(() => SetFechaHoy())" Class="fw-bold">HOY</MudButton>
                </div>
            </MudItem>            @* Selector de Turno *@
            <MudItem xs="6" sm="3" md="2">
                <MudSelect T="string" Label="Turno" Value="turnoSeleccionado" ValueChanged="OnTurnoChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem Value="@("Diurno")">☀️ Diurno</MudSelectItem>
                    <MudSelectItem Value="@("Nocturno")">🌙 Nocturno</MudSelectItem>
                    <MudSelectItem Value="@("H extras / Domingos / Feraidos")">⚡ Extra / Feriado</MudSelectItem>
                </MudSelect>
            </MudItem>

            @* Selector de Área Dinámica del Cliente *@
            <MudItem xs="6" sm="3" md="2">
                <MudSelect T="string" Label="Área" Value="areaSeleccionada" ValueChanged="OnAreaChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    @if (areasClienteList.Any())
                    {
                        @foreach (var a in areasClienteList)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    }
                    else
                    {
                        <MudSelectItem Value="@("CD")">CD</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Indicador del Cliente Seleccionado en Tabs *@
            <MudItem xs="12" sm="12" md="4" Class="d-flex justify-sm-end align-center gap-2">
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Class="fw-bold" Icon="@Icons.Material.Filled.Business">
                    @operacionSeleccionadaNombre
                </MudChip>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* --- PASO 1: SELECCIONAR SERVICIO PRINCIPAL --- *@
    <MudPaper Elevation="1" Class="pa-3 mb-3 rounded-xl border" Style="background: #ffffff;">
        <div class="d-flex align-center justify-space-between mb-2">
            <div class="d-flex align-center gap-2">
                <span class="step-badge">1</span>
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a;">Selecciona el Servicio</MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="fw-bold">
                @(servicioSeleccionado?.NombreCorto ?? "Ninguno")
            </MudChip>
        </div>

        @if (!serviciosDisponibles.Any())
        {
            <div class="pa-6 text-center" style="color: #64748b;">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                <MudText Typo="Typo.body1" Class="fw-semibold">No hay servicios configurados para el cliente '@operacionSeleccionadaNombre' en el área '@areaSeleccionada'.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Configura las actividades del cliente en Supervisión &gt; Actividades por Cliente.</MudText>
            </div>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (var serv in serviciosDisponibles)
                {
                    bool isSelected = servicioSeleccionado?.TemplateId == serv.TemplateId;
                    <MudItem xs="12" sm="4" md="3">
                        <div class="service-card @(isSelected ? "selected" : "")" @onclick="@(() => SeleccionarServicio(serv))">
                            <div class="d-flex align-center gap-3">
                                <div class="service-icon-box @(isSelected ? "selected" : "")">
                                    <MudIcon Icon="@serv.Icono" Size="Size.Medium" />
                                </div>
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <div class="service-title text-truncate">@serv.NombreCorto</div>
                                    <div class="service-subtitle text-truncate">@serv.Descripcion</div>
                                    <div class="service-count">@serv.VariantesCount variantes</div>
                                </div>
                                @if (isSelected)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Warning" />
                                }
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudPaper>

    @* --- PASO 2: FILTROS TÁCTILES POR ATRIBUTOS DE LA VARIANTE --- *@
    @if (servicioSeleccionado != null)
    {
        <MudPaper Elevation="1" Class="pa-3 mb-3 rounded-xl border" Style="background: #ffffff;">
            <div class="d-flex align-center justify-space-between mb-2">
                <div class="d-flex align-center gap-2">
                    <span class="step-badge">2</span>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a;">Filtrar Atributos de la Actividad</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default" OnClick="@LimpiarFiltros" StartIcon="@Icons.Material.Filled.FilterAltOff">
                        Limpiar Filtros
                    </MudButton>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                        @variantesFiltradas.Count variantes encontradas
                    </MudChip>
                </div>
            </div>

            @* --- 3 FILTROS DINÁMICOS ESTANDARIZADOS EN CASCADA --- *@
            @if (!filtrosDinamicos.Any() || !filtrosDinamicos.Any(f => f.OpcionesDisponibles.Any()))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block my-2">
                    No hay atributos adicionales que filtrar para este servicio en esta área y turno; selecciona la variante directamente abajo.
                </MudText>
            }
            else
            {
                @for (int i = 0; i < filtrosDinamicos.Count; i++)
                {
                    var idx = i;
                    var filtro = filtrosDinamicos[idx];
                    if (filtro.OpcionesDisponibles.Any())
                    {
                        <div class="filter-group mb-2">
                            <div class="d-flex align-center justify-space-between flex-wrap gap-1">
                                <div class="filter-label">@filtro.Titulo</div>
                                @if (filtro.OpcionesDisponibles.Count > 8)
                                {
                                    <div class="filter-search-box">
                                        <input type="text" class="filter-search-input" placeholder="🔍 Buscar..." 
                                               @bind="filtro.BusquedaRapida" @bind:event="oninput" />
                                        @if (!string.IsNullOrWhiteSpace(filtro.BusquedaRapida))
                                        {
                                            <button type="button" class="btn-clear-search" @onclick="@(() => filtro.BusquedaRapida = "")">✕</button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var opcion in filtro.OpcionesVisibles)
                                {
                                    bool activo = filtro.ValorSeleccionado.Equals(opcion, StringComparison.OrdinalIgnoreCase);
                                    <button type="button" class="filter-chip @(activo ? "active" : "")" @onclick="@(() => ToggleFiltroDinamico(idx, opcion))">
                                        @opcion
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </MudPaper>

        @* --- PASO 3: SELECCIONAR LA VARIANTE ESPECÍFICA --- *@
        <MudPaper Elevation="1" Class="pa-3 mb-3 rounded-xl border" Style="background: #ffffff;">
            <div class="d-flex align-center justify-space-between mb-2">
                <div class="d-flex align-center gap-2">
                    <span class="step-badge">3</span>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a;">Selecciona la Variante Exacta</MudText>
                </div>
                @if (varianteSeleccionada != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Check">
                        @varianteSeleccionada.default_code
                    </MudChip>
                }
            </div>

            @if (varianteSeleccionada != null)
            {
                <div class="selected-variant-banner mb-3">
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <div class="variant-sku">SKU: @varianteSeleccionada.default_code</div>
                            <div class="variant-fullname">@varianteSeleccionada.nombre</div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => varianteSeleccionada = null)" Color="Color.Default" />
                    </div>
                </div>
            }

            @if (!variantesFiltradas.Any())
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="my-3 rounded-xl border">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                        <div>
                            <MudText Typo="Typo.body2" Class="fw-bold">No se encontraron variantes para la combinación de filtros seleccionada.</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                El producto seleccionado no cuenta con esa presentación o bandeo específico. Pruebe seleccionando otra opción o limpie los filtros.
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="LimpiarFiltros" StartIcon="@Icons.Material.Filled.FilterAltOff">
                            Limpiar Filtros
                        </MudButton>
                    </div>
                </MudAlert>
            }

            <div class="variants-scroll-container">
                <MudGrid Spacing="1">
                    @foreach (var v in variantesFiltradas)
                    {
                        bool isSel = varianteSeleccionada?.id == v.id;
                        <MudItem xs="12" sm="6" md="4">
                            <div class="variant-item-card @(isSel ? "selected" : "")" @onclick="@(() => SeleccionarVariante(v))">
                                <div class="d-flex align-center justify-space-between">
                                    <span class="variant-code">@v.default_code</span>
                                    @if (isSel)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                    }
                                </div>
                                <div class="variant-desc">@LimpiarNombreVariante(v.nombre)</div>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            </div>
        </MudPaper>

        @* --- PASO 4: CAPTURA DE CANTIDAD Y GUARDADO (PRECIOS OCULTOS) --- *@
        <MudPaper Elevation="2" Class="pa-4 mb-4 rounded-xl border" Style="background: #ffffff; border-left: 6px solid #10b981;">
            <div class="d-flex align-center gap-2 mb-3">
                <span class="step-badge" style="background: #10b981;">4</span>
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a;">Ingresar Cantidad Producida</MudText>
            </div>

            <MudGrid Spacing="3">
                @* Teclado Numérico y Display de Cantidad *@
                <MudItem xs="12" md="6">
                    <div class="quantity-input-box">
                        <div class="quantity-label">CANTIDAD PRODUCIDA (UNIDADES):</div>
                        <div class="d-flex align-center justify-center my-2">
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Large" Color="Color.Error" OnClick="@(() => RestarCantidad(1))" />
                            <input type="number" class="quantity-display mx-2" @bind="cantidadProducida" @bind:event="oninput" min="0" />
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Large" Color="Color.Success" OnClick="@(() => SumarCantidad(1))" />
                        </div>

                        <div class="quick-add-grid mt-3">
                            <button type="button" class="quick-btn" @onclick="@(() => SumarCantidad(10))">+10</button>
                            <button type="button" class="quick-btn" @onclick="@(() => SumarCantidad(25))">+25</button>
                            <button type="button" class="quick-btn" @onclick="@(() => SumarCantidad(50))">+50</button>
                            <button type="button" class="quick-btn" @onclick="@(() => SumarCantidad(100))">+100</button>
                            <button type="button" class="quick-btn" @onclick="@(() => SumarCantidad(250))">+250</button>
                            <button type="button" class="quick-btn" @onclick="@(() => SumarCantidad(500))">+500</button>
                            <button type="button" class="quick-btn reset" @onclick="@(() => cantidadProducida = 0)">RESET (0)</button>
                        </div>
                    </div>
                </MudItem>

                @* Datos complementarios y Botón Principal *@
                <MudItem xs="12" md="6">
                    <div class="d-flex flex-column gap-3 h-100 justify-space-between">
                        <div>
                            <MudTextField Label="No. Lote / Tarima (Opcional)" 
                                          @bind-Value="noLote" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          Placeholder="Ej: LOTE-2611-A" 
                                          HelperText="Código o número de lote impreso en tarima" />

                            <MudTextField Label="Orden de Compra / OC (Opcional)" 
                                          @bind-Value="ordenCompra" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          Class="mt-2"
                                          Placeholder="Ej: OC-8849" />

                            <MudTextField Label="Observaciones / Cuadrilla" 
                                          @bind-Value="observaciones" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          Class="mt-2"
                                          Lines="2"
                                          Placeholder="Supervisor a cargo, novedades o equipo de trabajo..." />
                        </div>

                        @* Botón de Guardado Grande Táctil *@
                        @if (!PuedeGuardar)
                        {
                            <div class="pa-2 mb-2 rounded-lg text-center" style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; font-size: 0.8rem; font-weight: 600;">
                                @if (varianteSeleccionada == null)
                                {
                                    <span>⚠️ Seleccione una variante en el Paso 3 para continuar.</span>
                                }
                                else if (cantidadProducida <= 0)
                                {
                                    <span>⚠️ Ingrese una cantidad producida mayor a 0.</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="pa-2 mb-2 rounded-lg text-center" style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; font-size: 0.8rem; font-weight: 700;">
                                ✓ Listo: @varianteSeleccionada.default_code (@cantidadProducida.ToString("N0") unid.)
                            </div>
                        }

                        <button type="button" class="submit-action-btn @(PuedeGuardar ? "ready" : "disabled")" @onclick="GuardarProduccion" disabled="@(!PuedeGuardar)">
                            <div class="d-flex align-center justify-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Large" />
                                <div>
                                    <div style="font-size: 1.15rem; font-weight: 800; line-height: 1.1;">REGISTRAR ACTIVIDAD</div>
                                    <div style="font-size: 0.75rem; opacity: 0.85;">Guardar en Producción Diaria (Odoo)</div>
                                </div>
                            </div>
                        </button>
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @* --- RESUMEN DEL DÍA / ACTIVIDADES YA REGISTRADAS --- *@
    <MudPaper Elevation="1" Class="pa-3 rounded-xl border" Style="background: #ffffff;">
        <div class="d-flex align-center justify-space-between mb-3">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a;">
                    Actividades Registradas Hoy (@fechaJornada.ToString("dd/MM/yyyy")) - @operacionSeleccionadaNombre
                </MudText>
            </div>
            <div class="d-flex align-center gap-2">
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                    Total: @historialHoy.Sum(h => h.cantidad_producto).ToString("N0") unidades
                </MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="@CargarHistorialHoy" Title="Refrescar lista" />
            </div>
        </div>

        @if (!historialHoy.Any())
        {
            <div class="pa-4 text-center text-muted">
                No hay actividades de producción registradas para esta fecha y turno todavía.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Servicio / Actividad</th>
                            <th>Código</th>
                            <th>Área</th>
                            <th>Turno</th>
                            <th>No. Lote</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width: 90px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in historialHoy)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@reg.actividad</div>
                                    <div class="text-muted small">@reg.nombre_producto</div>
                                </td>
                                <td><span class="badge-code-sm">@reg.servicio_codigo</span></td>
                                <td>@reg.area_cliente</td>
                                <td>@reg.hora_inicio - @reg.hora_fin</td>
                                <td>@(string.IsNullOrEmpty(reg.no_lote) ? "-" : reg.no_lote)</td>
                                <td class="text-end fw-bold">@reg.cantidad_producto.ToString("N0")</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(reg.no_lote))
                                    {
                                        <span class="badge bg-primary">Sellado</span>
                                    }
                                    else if (reg.id < 0)
                                    {
                                        <span class="badge" style="background: #ea580c; color: #ffffff; font-weight: 700;">Pendiente</span>
                                    }
                                    else if (pendientesOffline.Any(p => p.id == reg.id))
                                    {
                                        <span class="badge" style="background: #0284c7; color: #ffffff; font-weight: 700;">Modificado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success" style="font-weight: 700;">Guardado</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (string.IsNullOrEmpty(reg.no_lote) && !reg.facturada)
                                    {
                                        <div class="d-flex align-center justify-center gap-1">
                                            <MudTooltip Text="Editar cantidad">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                               OnClick="@(() => AbrirModalEditarTablet(reg))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Eliminar actividad">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                               OnClick="@(() => ConfirmarEliminarTablet(reg))" />
                                            </MudTooltip>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Actividad sellada en lote (Bloqueada para edición)">
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" />
                                        </MudTooltip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </MudPaper>
    }
</div>

