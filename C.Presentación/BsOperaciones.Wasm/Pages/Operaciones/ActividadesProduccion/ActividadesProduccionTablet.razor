@code {
    // Modelos Locales
    public class ServicioPepsiInfo
    {
        public int TemplateId { get; set; }
        public string NombreCorto { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public string Icono { get; set; } = string.Empty;
        public int VariantesCount { get; set; }
    }

    private bool estaCargando = false;
    private string mensajeCarga = "Cargando catálogo...";

    private DateTime fechaJornada = DateTime.Today;
    private string turnoSeleccionado = "Diurno";
    private string areaSeleccionada = "CD";

    // Servicios CBC Pepsi
    private List<ServicioPepsiInfo> serviciosDisponibles = new()
    {
        new ServicioPepsiInfo
        {
            TemplateId = 840,
            NombreCorto = "Bandeo de Productos",
            Descripcion = "Empaquetado y armado de packs (2p, 6p, 12p, etc.)",
            Icono = Icons.Material.Filled.TakeoutDining,
            VariantesCount = 75
        },
        new ServicioPepsiInfo
        {
            TemplateId = 839,
            NombreCorto = "Servicio de Etiquetado",
            Descripcion = "Etiquetado manual o mecánico de bultos y productos",
            Icono = Icons.Material.Filled.Sell,
            VariantesCount = 54
        },
        new ServicioPepsiInfo
        {
            TemplateId = 843,
            NombreCorto = "Trasiego de Productos",
            Descripcion = "Carga, descarga y trasiego de materias primas",
            Icono = Icons.Material.Filled.PublishedWithChanges,
            VariantesCount = 10
        }
    };

    private ServicioPepsiInfo? servicioSeleccionado;
    private List<OdooVariantDto> todasVariantesServicio = new();
    private List<OdooVariantDto> variantesFiltradas = new();
    private OdooVariantDto? varianteSeleccionada;

    // Filtros activos
    private string filtroProducto = "";
    private string filtroBandeo = "";
    private string filtroPresentacion = "";
    private string filtroClimatizacion = "";

    // Opciones para chips
    private List<string> productosDisponibles = new();
    private List<string> bandeosDisponibles = new();
    private List<string> presentacionesDisponibles = new();
    private List<string> climatizacionesDisponibles = new();

    // Formulario de producción
    private decimal cantidadProducida = 0;
    private string noLote = "";
    private string ordenCompra = "";
    private string observaciones = "";

    // Historial del día
    private List<ProduccionDiariaDto> historialHoy = new();

    private bool PuedeGuardar => varianteSeleccionada != null && cantidadProducida > 0;

    protected override async Task OnInitializedAsync()
    {
        // Seleccionar por defecto Bandeo de Productos
        await SeleccionarServicio(serviciosDisponibles[0]);
        await CargarHistorialHoy();
    }

    private async Task SeleccionarServicio(ServicioPepsiInfo serv)
    {
        servicioSeleccionado = serv;
        varianteSeleccionada = null;
        LimpiarFiltros();

        estaCargando = true;
        mensajeCarga = $"Cargando catálogo de {serv.NombreCorto}...";
        StateHasChanged();

        try
        {
            var res = await OdooService.GetProductVariants(serv.TemplateId);
            if (!res.Respuesta.ExisteError && res.Model != null)
            {
                todasVariantesServicio = res.Model.ToList();
                serv.VariantesCount = todasVariantesServicio.Count;
                ExtraerOpcionesFiltros();
                AplicarFiltros();
            }
            else
            {
                Snackbar.Add($"No se pudieron cargar las variantes: {res.Respuesta.MensajeError}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar variantes: {ex.Message}", Severity.Error);
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }
    }

    private void ExtraerOpcionesFiltros()
    {
        var prods = new HashSet<string>();
        var bans = new HashSet<string>();
        var pres = new HashSet<string>();
        var clim = new HashSet<string>();

        foreach (var v in todasVariantesServicio)
        {
            var dict = ParsearAtributos(v.nombre);
            if (dict.TryGetValue("Producto", out var p)) prods.Add(p);
            if (dict.TryGetValue("Bandeo", out var b)) bans.Add(b);
            if (dict.TryGetValue("Precentación", out var pr)) pres.Add(pr);
            if (dict.TryGetValue("Presentación", out var pr2)) pres.Add(pr2);
            if (dict.TryGetValue("Climatización", out var cl)) clim.Add(cl);
        }

        productosDisponibles = prods.OrderBy(x => x).ToList();
        bandeosDisponibles = bans.OrderBy(x => x).ToList();
        presentacionesDisponibles = pres.OrderBy(x => x).ToList();
        climatizacionesDisponibles = clim.OrderBy(x => x).ToList();
    }

    private Dictionary<string, string> ParsearAtributos(string nombre)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(nombre)) return dict;

        var partes = nombre.Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var parte in partes)
        {
            var kv = parte.Split(new[] { ": " }, 2, StringSplitOptions.None);
            if (kv.Length == 2)
            {
                dict[kv[0].Trim()] = kv[1].Trim();
            }
        }
        return dict;
    }

    private string LimpiarNombreVariante(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "";
        // Eliminar 'Cliente: CBC Pepsi, ' para ahorrar espacio
        return nombre.Replace("Cliente: CBC Pepsi, ", "")
                     .Replace("Area: CD, ", "")
                     .Replace("Precentación:", "Pres:");
    }

    private void ToggleFiltroProducto(string prod)
    {
        filtroProducto = filtroProducto == prod ? "" : prod;
        AplicarFiltros();
    }

    private void ToggleFiltroBandeo(string ban)
    {
        filtroBandeo = filtroBandeo == ban ? "" : ban;
        AplicarFiltros();
    }

    private void ToggleFiltroPresentacion(string pres)
    {
        filtroPresentacion = filtroPresentacion == pres ? "" : pres;
        AplicarFiltros();
    }

    private void ToggleFiltroClimatizacion(string clim)
    {
        filtroClimatizacion = filtroClimatizacion == clim ? "" : clim;
        AplicarFiltros();
    }

    private void LimpiarFiltros()
    {
        filtroProducto = "";
        filtroBandeo = "";
        filtroPresentacion = "";
        filtroClimatizacion = "";
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var q = todasVariantesServicio.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroProducto))
        {
            q = q.Where(v => v.nombre.Contains($"Producto: {filtroProducto}", StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroBandeo))
        {
            q = q.Where(v => v.nombre.Contains($"Bandeo: {filtroBandeo}", StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroPresentacion))
        {
            q = q.Where(v => v.nombre.Contains($"Precentación: {filtroPresentacion}", StringComparison.OrdinalIgnoreCase) ||
                             v.nombre.Contains($"Presentación: {filtroPresentacion}", StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroClimatizacion))
        {
            q = q.Where(v => v.nombre.Contains($"Climatización: {filtroClimatizacion}", StringComparison.OrdinalIgnoreCase));
        }

        // Filtro de Turno si coincide
        if (!string.IsNullOrWhiteSpace(turnoSeleccionado))
        {
            var matchTurno = q.Where(v => v.nombre.Contains($"Turno: {turnoSeleccionado}", StringComparison.OrdinalIgnoreCase)).ToList();
            if (matchTurno.Any())
            {
                q = matchTurno;
            }
        }

        variantesFiltradas = q.ToList();

        // Si solo queda 1 variante, preseleccionarla automáticamente
        if (variantesFiltradas.Count == 1)
        {
            varianteSeleccionada = variantesFiltradas[0];
        }
    }

    private void SeleccionarVariante(OdooVariantDto v)
    {
        varianteSeleccionada = v;
        Snackbar.Add($"Variante seleccionada: {v.default_code}", Severity.Info);
    }

    private void SumarCantidad(decimal delta)
    {
        cantidadProducida += delta;
    }

    private void RestarCantidad(decimal delta)
    {
        cantidadProducida = Math.Max(0, cantidadProducida - delta);
    }

    private void CambiarFecha(int dias)
    {
        fechaJornada = fechaJornada.AddDays(dias);
        _ = CargarHistorialHoy();
    }

    private void SetFechaHoy()
    {
        fechaJornada = DateTime.Today;
        _ = CargarHistorialHoy();
    }

    private void OnFechaChanged(DateTime? dt)
    {
        if (dt.HasValue)
        {
            fechaJornada = dt.Value;
            _ = CargarHistorialHoy();
        }
    }

    private async Task GuardarProduccion()
    {
        if (!PuedeGuardar) return;

        estaCargando = true;
        mensajeCarga = "Guardando producción de actividad...";
        StateHasChanged();

        try
        {
            var dict = ParsearAtributos(varianteSeleccionada!.nombre);
            string prodName = dict.TryGetValue("Producto", out var p) ? p : varianteSeleccionada.template_name;

            var item = new ProduccionDiariaDto
            {
                cliente = "CBC Pepsi",
                operacion_id = 27,
                actividad = servicioSeleccionado?.NombreCorto ?? "Bandeo de Productos",
                area_cliente = areaSeleccionada,
                servicio_codigo = varianteSeleccionada.default_code,
                servicio_descripcion = varianteSeleccionada.nombre,
                nombre_producto = prodName,
                cantidad_producto = cantidadProducida,
                costo_producto = 0, // Backend aplica automáticamente fixed_price de lista
                fecha_inicio = fechaJornada.Date,
                fecha_fin = fechaJornada.Date,
                hora_inicio = turnoSeleccionado.Contains("Nocturno") ? "19:00" : "07:00",
                hora_fin = turnoSeleccionado.Contains("Nocturno") ? "07:00" : "19:00",
                no_lote = string.IsNullOrWhiteSpace(noLote) ? null : noLote.Trim(),
                oc = string.IsNullOrWhiteSpace(ordenCompra) ? null : ordenCompra.Trim(),
                asignado_a = string.IsNullOrWhiteSpace(observaciones) ? null : observaciones.Trim(),
                facturada = false
            };

            var res = await OdooService.ImportarProduccionDiaria(new List<ProduccionDiariaDto> { item });
            if (!res.Respuesta.ExisteError)
            {
                Snackbar.Add($"✅ ¡Actividad registrada con éxito! {cantidadProducida:N0} unidades de {varianteSeleccionada.default_code}.", Severity.Success);
                
                // Reiniciar entrada para siguiente actividad
                cantidadProducida = 0;
                noLote = "";
                ordenCompra = "";
                varianteSeleccionada = null;
                LimpiarFiltros();

                await CargarHistorialHoy();
            }
            else
            {
                Snackbar.Add($"Error al registrar: {res.Respuesta.MensajeError}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Excepción al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarHistorialHoy()
    {
        try
        {
            var res = await OdooService.GetProduccionDiaria(fechaJornada, fechaJornada, 27, null);
            if (!res.Respuesta.ExisteError && res.Model != null)
            {
                historialHoy = res.Model.OrderByDescending(h => h.id).ToList();
            }
            else
            {
                historialHoy = new();
            }
        }
        catch
        {
            historialHoy = new();
        }
        StateHasChanged();
    }
}
