        public IEnumerable<string> OpcionesVisibles =>
            string.IsNullOrWhiteSpace(BusquedaRapida)
                ? OpcionesDisponibles
                : OpcionesDisponibles.Where(o => o.Contains(BusquedaRapida, StringComparison.OrdinalIgnoreCase));
    }

    private List<NivelFiltroDinamico> filtrosDinamicos = new();

    // Formulario de producción
    private decimal cantidadProducida = 0;
    private string noLote = "";
    private string ordenCompra = "";
    private string observaciones = "";

    // Historial del día
    private List<ProduccionDiariaDto> historialHoy = new();

    // Conectividad y Modo Offline (Bodega)
    private bool esModoOnline = true;
    private bool estaSincronizando = false;
    private List<ProduccionDiariaDto> pendientesOffline = new();
    private DotNetObjectReference<ActividadesProduccionTablet>? dotNetHelper;

    private string KeyOfflineQueue => $"actividades_tablet_offline_{currentUserName}";
    private string KeyCacheClientes => $"actividades_cache_clientes_{currentUserName}";
    private string KeyCacheConfigs => $"actividades_cache_configs_{operacionSeleccionadaId}_{currentUserName}";
    private string KeyCacheHistorial => $"actividades_cache_historial_{operacionSeleccionadaId}_{fechaJornada:yyyyMMdd}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            try
            {
                dotNetHelper = DotNetObjectReference.Create(this);
                esModoOnline = await JSRuntime.InvokeAsync<bool>("connectivityInterop.isOnline");
                await JSRuntime.InvokeVoidAsync("connectivityInterop.registerListener", dotNetHelper);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnConexionCambiada(bool online)
    {
        esModoOnline = online;
        if (online)
        {
            Snackbar.Add("🟢 Conexión a internet restablecida.", Severity.Success);
            if (pendientesOffline.Any())
            {
                await SincronizarPendientesOffline();
            }
        }
        else
        {
            Snackbar.Add("🟡 Modo Offline (Bodega): Sin conexión. Las actividades se guardarán en este dispositivo.", Severity.Warning);
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        try
        {
            dotNetHelper?.Dispose();
        }
        catch { }
    }

    private async Task CargarColaOfflineDesdeStorage()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", KeyOfflineQueue);
            if (!string.IsNullOrWhiteSpace(json))
            {
                pendientesOffline = JsonSerializer.Deserialize<List<ProduccionDiariaDto>>(json) ?? new();
            }
            else
            {
                pendientesOffline = new();
            }
        }
        catch
        {
            pendientesOffline = new();
        }
    }

    private async Task GuardarColaOfflineEnStorage()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", KeyOfflineQueue, JsonSerializer.Serialize(pendientesOffline));
        }
        catch { }
    }

    private async Task SincronizarPendientesOffline()
    {
        if (!pendientesOffline.Any())
        {
            Snackbar.Add("No hay actividades pendientes de sincronizar.", Severity.Info);
            return;
        }

        estaSincronizando = true;
        estaBloqueandoAccion = true;
        mensajeCarga = $"Sincronizando {pendientesOffline.Count} actividades a Odoo...";
        StateHasChanged();

        try
        {
            // Remover IDs temporales negativos
            var itemsAEnviar = pendientesOffline.Select(p => new ProduccionDiariaDto
            {
                cliente = p.cliente,
                operacion_id = p.operacion_id,
                actividad = p.actividad,
                area_cliente = p.area_cliente,
                servicio_codigo = p.servicio_codigo,
                servicio_descripcion = p.servicio_descripcion,
                nombre_producto = p.nombre_producto,
                cantidad_producto = p.cantidad_producto,
                costo_producto = p.costo_producto,
                fecha_inicio = p.fecha_inicio,
                fecha_fin = p.fecha_fin,
                hora_inicio = p.hora_inicio,
                hora_fin = p.hora_fin,
                no_lote = p.no_lote,
                oc = p.oc,
                asignado_a = p.asignado_a,
                facturada = false
            }).ToList();

            var res = await OdooService.ImportarProduccionDiaria(itemsAEnviar);
            if (!res.Respuesta.ExisteError)
            {
                int cant = pendientesOffline.Count;
                pendientesOffline.Clear();
                await GuardarColaOfflineEnStorage();
                Snackbar.Add($"¡{cant} actividades sincronizadas con éxito en Odoo!", Severity.Success);
                await CargarHistorialHoy();
            }
            else
            {
                Snackbar.Add($"Error al sincronizar: {res.Respuesta.MensajeError}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión al sincronizar: {ex.Message}", Severity.Error);
        }
        finally
        {
            estaSincronizando = false;
            estaBloqueandoAccion = false;
            StateHasChanged();
        }
    }

    private bool PuedeGuardar => varianteSeleccionada != null && cantidadProducida > 0;

    private CatalogoActividadesTabletDto catalogoCompleto = new();
    private const string KeyCacheCatalogoCompleto = "actividades_catalogo_completo_v2";
    private bool estaActualizando = false;
    private bool estaGuardandoEnBd = false;

    private async Task<bool> CargarDesdeCacheLocal()
    {
        try
        {
            var cached = await JSRuntime.InvokeAsync<string>("localStorage.getItem", KeyCacheCatalogoCompleto);
            if (!string.IsNullOrWhiteSpace(cached))
            {
                var bundle = JsonSerializer.Deserialize<CatalogoActividadesTabletDto>(cached);
                if (bundle != null && bundle.Clientes != null && bundle.Clientes.Any())
                {
                    catalogoCompleto = bundle;
                    return true;
                }
            }
        }
        catch { }
        return false;
    }

    private void ConfigurarDesdeCatalogoEnMemoria()
    {
        if (catalogoCompleto?.Clientes == null || !catalogoCompleto.Clientes.Any())
            return;

        // 1. Mapear clientes permitidos desde la memoria
        clientesPermitidos = catalogoCompleto.Clientes.Select(c => new ClienteTabItem
        {
            OperacionId = c.operacion_id,
            ClienteNombre = c.cliente_nombre,
            ServiciosCount = c.servicios_count
        }).ToList();

        // 2. Preseleccionar cliente si es necesario
        if (clientesPermitidos.Any())
        {
            if (!clientesPermitidos.Any(c => c.OperacionId == operacionSeleccionadaId))
            {
                operacionSeleccionadaId = clientesPermitidos.First().OperacionId;
            }
            ActualizarNombreOperacion();
            AplicarConfiguracionClienteEnMemoria();

            if (serviciosDisponibles.Any())
            {
                _ = SeleccionarServicio(serviciosDisponibles[0]);
            }
        }
    }

    private async Task SincronizarCatalogoEnLinea(bool forzar = false)
    {
        if (!esModoOnline && !forzar) return;

        try
        {
            var res = await OdooService.GetCatalogoActividadesTablet(currentUserName);
            if (!res.Respuesta.ExisteError && res.Model != null && res.Model.Clientes != null && res.Model.Clientes.Any())
            {
                catalogoCompleto = res.Model;
                esModoOnline = true;
                ConfigurarDesdeCatalogoEnMemoria();

                try
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", KeyCacheCatalogoCompleto, JsonSerializer.Serialize(catalogoCompleto));
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sincronizando catálogo: {ex.Message}");
            if (!catalogoCompleto.Clientes.Any())
            {
                await CargarDesdeCacheLocal();
                ConfigurarDesdeCatalogoEnMemoria();
            }
        }
    }

    private async Task CargarCatalogoCompleto(bool forzarOnline = false)
    {
        await SincronizarCatalogoEnLinea(forzarOnline);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                currentUserName = auth.User?.Identity?.Name ?? "Admin";
            }
        }
        catch { }

        try
        {
            var regop = await Mediator.Send(new GetAllCombosQuery("Operaciones"));
            if (!regop.Respuesta.ExisteError && regop.Model != null)
            {
                operacionesList = regop.Model.OrderBy(c => c.nombre).ToList();
            }
        }
        catch { }

        try
        {
            var guardado = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "actividades_tablet_cliente_id");
            if (int.TryParse(guardado, out int opId))
            {
                operacionSeleccionadaId = opId;
            }
        }
        catch { }

        await CargarColaOfflineDesdeStorage();

        // 1. CARGA INMEDIATA DESDE CACHÉ (0 ms):
        bool tieneCache = await CargarDesdeCacheLocal();
        if (tieneCache)
        {
            ConfigurarDesdeCatalogoEnMemoria();
            estaCargando = false;
            StateHasChanged();
        }

        // 2. SINCRONIZAR CON BASE DE DATOS EN LÍNEA:
        try
        {
            await SincronizarCatalogoEnLinea();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar catálogo en línea: {ex.Message}");
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }

        // 3. Historial del día en background:
        _ = CargarHistorialHoy();
    }

    private void AplicarConfiguracionClienteEnMemoria()
    {
        var cli = catalogoCompleto.Clientes.FirstOrDefault(c => c.operacion_id == operacionSeleccionadaId);
        if (cli != null)
        {
            operacionSeleccionadaNombre = cli.cliente_nombre;
            areasClienteList = (cli.areas != null && cli.areas.Any()) ? cli.areas.OrderBy(a => a).ToList() : new List<string> { "CD" };
        }
        else
        {
            areasClienteList = new List<string> { "CD" };
        }

        if (!areasClienteList.Contains(areaSeleccionada, StringComparer.OrdinalIgnoreCase))
        {
            areaSeleccionada = areasClienteList.FirstOrDefault() ?? "CD";
        }

        ActualizarServiciosDisponiblesPorArea();
    }

    private void ActualizarServiciosDisponiblesPorArea()
    {
        var cli = catalogoCompleto.Clientes.FirstOrDefault(c => c.operacion_id == operacionSeleccionadaId);
        if (cli != null && cli.servicios != null && cli.servicios.Any())
        {
            var serviciosArea = cli.servicios
                .Where(s => s.area_nombre == "*" || s.area_nombre.Equals(areaSeleccionada, StringComparison.OrdinalIgnoreCase))
                .ToList();

            serviciosDisponibles = serviciosArea.Select(s =>
            {
                var master = MasterCatalogoServicios.FirstOrDefault(m => m.TemplateId == s.template_id);
                return new ServicioInfoItem
                {
                    TemplateId = s.template_id,
                    NombreCorto = master?.NombreCorto ?? s.template_nombre,
                    Descripcion = master?.Descripcion ?? s.template_nombre,
                    Icono = master?.Icono ?? Icons.Material.Filled.Inventory2,
                    VariantesCount = s.variantes_count,
                    AreaNombre = s.area_nombre,
                    TieneTurno = s.tiene_turno,
                    Variantes = s.variantes ?? new()
                };
            }).ToList();
        }
        else
        {
            serviciosDisponibles.Clear();
        }
    }

    private async Task OnOperacionChanged(int nuevoId)
    {
        operacionSeleccionadaId = nuevoId;
        ActualizarNombreOperacion();
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "actividades_tablet_cliente_id", nuevoId.ToString());
        }
        catch { }

        // Navegación 100% en memoria: cero recargas, cero llamadas HTTP, instantáneo
        AplicarConfiguracionClienteEnMemoria();

        if (serviciosDisponibles.Any())
        {
            await SeleccionarServicio(serviciosDisponibles[0]);
        }
        else
        {
            servicioSeleccionado = null;
            varianteSeleccionada = null;
            todasVariantesServicio.Clear();
            variantesFiltradas.Clear();
        }

        // Cargar historial en background sin bloquear la interfaz
        if (esModoOnline)
        {
            _ = CargarHistorialHoy();
        }
        else
        {
            await CargarHistorialHoy();
        }
    }

    private async Task OnAreaChanged(string nuevaArea)
    {
        areaSeleccionada = nuevaArea;
        ActualizarServiciosDisponiblesPorArea();
        if (servicioSeleccionado != null && serviciosDisponibles.Any(s => s.TemplateId == servicioSeleccionado.TemplateId))
        {
            ConfigurarFiltrosDinamicos();
            ActualizarCascadaFiltros();
        }
        else if (serviciosDisponibles.Any())
        {
            await SeleccionarServicio(serviciosDisponibles[0]);
        }
        else
        {
            servicioSeleccionado = null;
            varianteSeleccionada = null;
            filtrosDinamicos.Clear();
            variantesFiltradas.Clear();
        }
        await Task.CompletedTask;
    }

    private async Task OnTurnoChanged(string nuevoTurno)
    {
        turnoSeleccionado = nuevoTurno;
        ConfigurarFiltrosDinamicos();
        ActualizarCascadaFiltros();
        await Task.CompletedTask;
    }

    private void ActualizarNombreOperacion()
    {
        var tab = clientesPermitidos.FirstOrDefault(o => o.OperacionId == operacionSeleccionadaId);
        if (tab != null)
        {
            operacionSeleccionadaNombre = tab.ClienteNombre;
            return;
        }

        var op = operacionesList.FirstOrDefault(o => o.id == operacionSeleccionadaId);
        operacionSeleccionadaNombre = op?.nombre ?? "Operación #" + operacionSeleccionadaId;
    }

    private async Task SeleccionarServicio(ServicioInfoItem serv)
    {
        servicioSeleccionado = serv;
        varianteSeleccionada = null;

        todasVariantesServicio = serv.Variantes ?? new();
        serv.VariantesCount = todasVariantesServicio.Count;

        ConfigurarFiltrosDinamicos();
        ActualizarCascadaFiltros();
        await Task.CompletedTask;
    }

    private async Task ActualizarCatalogoEnLinea()
    {
        if (!esModoOnline) return;
        estaActualizando = true;
        StateHasChanged();
        try
        {
            await SincronizarCatalogoEnLinea(forzar: true);
            await CargarHistorialHoy();
            Snackbar.Add("¡Catálogo, clientes y servicios actualizados con éxito desde la Base de Datos!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al actualizar: {ex.Message}", Severity.Error);
        }
        finally
        {
            estaActualizando = false;
            StateHasChanged();
        }
    }

    private async Task GuardarEnBaseDeDatos()
    {
        if (!esModoOnline) return;
        if (!pendientesOffline.Any())
        {
            Snackbar.Add("No hay actividades pendientes por guardar en Base de Datos.", Severity.Info);
            return;
        }

        estaGuardandoEnBd = true;
        estaBloqueandoAccion = true;
        mensajeCarga = $"Guardando {pendientesOffline.Count} actividades en Base de Datos...";
        StateHasChanged();

        try
        {
            var nuevos = pendientesOffline.Where(p => p.id < 0).Select(p => new ProduccionDiariaDto
            {
                cliente = p.cliente,
                operacion_id = p.operacion_id,
                actividad = p.actividad,
                area_cliente = p.area_cliente,
                servicio_codigo = p.servicio_codigo,
                servicio_descripcion = p.servicio_descripcion,
                nombre_producto = p.nombre_producto,
                cantidad_producto = p.cantidad_producto,
                costo_producto = p.costo_producto,
                fecha_inicio = p.fecha_inicio,
                fecha_fin = p.fecha_fin,
                hora_inicio = p.hora_inicio,
                hora_fin = p.hora_fin,
                no_lote = p.no_lote,
                oc = p.oc,
                asignado_a = p.asignado_a,
                facturada = p.facturada
            }).ToList();

            var modificados = pendientesOffline.Where(p => p.id > 0).ToList();

            bool todoOk = true;

            if (nuevos.Any())
            {
                var res = await OdooService.ImportarProduccionDiaria(nuevos);
                if (res.Respuesta.ExisteError)
                {
                    todoOk = false;
                    Snackbar.Add($"Error al guardar nuevas actividades en BD: {res.Respuesta.MensajeError}", Severity.Error);
                }
            }

            if (modificados.Any() && todoOk)
            {
                foreach (var mod in modificados)
                {
                    var resMod = await OdooService.UpdateProduccionDiaria(mod);
                    if (resMod.Respuesta.ExisteError)
                    {
                        todoOk = false;
                        Snackbar.Add($"Error al actualizar actividad #{mod.id} en BD: {resMod.Respuesta.MensajeError}", Severity.Error);
                        break;
                    }
                }
            }

            if (todoOk)
            {
                int cant = pendientesOffline.Count;
                pendientesOffline.Clear();
                await GuardarColaOfflineEnStorage();
                Snackbar.Add($"¡{cant} actividades guardadas en Base de Datos exitosamente!", Severity.Success);
                await CargarHistorialHoy();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión al guardar en BD: {ex.Message}", Severity.Error);
        }
        finally
        {
            estaGuardandoEnBd = false;
            estaBloqueandoAccion = false;
            StateHasChanged();
        }
    }

    // --- PRE-FILTRADO Y 3 FILTROS DINÁMICOS ESTANDARIZADOS EN CASCADA ---

    private List<OdooVariantDto> ObtenerVariantesBaseAreaYTurno()
    {
        if (!todasVariantesServicio.Any()) return new();

        var q = todasVariantesServicio.AsEnumerable();

        // 1. Pre-filtrar por Área si alguna variante del servicio especifica Área
        bool plantillaTieneArea = todasVariantesServicio.Any(v => 
            v.nombre.Contains("Area:", StringComparison.OrdinalIgnoreCase) || 
            v.nombre.Contains("Área:", StringComparison.OrdinalIgnoreCase));

        if (plantillaTieneArea && !string.IsNullOrWhiteSpace(areaSeleccionada))
        {
            var matchArea = q.Where(v => 
                MatchAtributo(v.nombre, "Area", areaSeleccionada) || 
                MatchAtributo(v.nombre, "Área", areaSeleccionada)).ToList();

            if (matchArea.Any())
            {
                q = matchArea;
            }
        }

        // 2. Pre-filtrar por Turno si alguna variante especifica Turno o la configuración del servicio tiene TieneTurno
        bool plantillaTieneTurno = (servicioSeleccionado?.TieneTurno == true) ||
                                   todasVariantesServicio.Any(v => v.nombre.Contains("Turno:", StringComparison.OrdinalIgnoreCase));

        if (plantillaTieneTurno && !string.IsNullOrWhiteSpace(turnoSeleccionado))
        {
            var matchTurno = q.Where(v => MatchAtributo(v.nombre, "Turno", turnoSeleccionado)).ToList();
            if (matchTurno.Any())
            {
                q = matchTurno;
            }
        }

        return q.ToList();
    }

    private void ConfigurarFiltrosDinamicos()
    {
        var baseVariantes = ObtenerVariantesBaseAreaYTurno();
        if (!baseVariantes.Any())
        {
            filtrosDinamicos.Clear();
            variantesFiltradas.Clear();
            varianteSeleccionada = null;
            return;
        }

        // Extraer atributos operativos ignorando los que ya están en la cabecera fija
        var clavesIgnoradas = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "Cliente", "Empresa", "Area", "Área", "Turno"
        };

        var clavesPresentes = new List<string>();
        foreach (var v in baseVariantes)
        {
            var dict = ParsearAtributos(v.nombre);
            foreach (var k in dict.Keys)
            {
                if (clavesIgnoradas.Contains(k)) continue;
                if (!clavesPresentes.Any(existente => SonClavesEquivalentes(existente, k)))
                {
                    clavesPresentes.Add(k);
                }
            }
        }

        // Evaluar si existe atributo de 'Tipo' u 'Operación'
        bool tieneTipoOperacion = clavesPresentes.Any(k => 
            SonClavesEquivalentes(k, "Tipo") || 
            SonClavesEquivalentes(k, "Operacion") || 
            SonClavesEquivalentes(k, "Operación"));

        var tresClaves = new List<string>();

        if (tieneTipoOperacion)
        {
            // CASO CON TIPO DE OPERACIÓN (ej: Carga y Descarga, Trasiego):
            // Nivel 1: TIPO / OPERACIÓN (pocas opciones: 2 a 4 botones; filtra primero para reducir el universo de productos)
            string? claveTipo = clavesPresentes.FirstOrDefault(k => 
                SonClavesEquivalentes(k, "Tipo") || 
                SonClavesEquivalentes(k, "Operacion") || 
                SonClavesEquivalentes(k, "Operación"));
            if (claveTipo != null) tresClaves.Add(claveTipo);

            // Nivel 2: PRODUCTO (los productos se reducen drásticamente según la operación elegida en Nivel 1)
            string? claveProd = clavesPresentes.FirstOrDefault(k => !tresClaves.Any(c => SonClavesEquivalentes(c, k)) &&
                                                                   (SonClavesEquivalentes(k, "Producto") || 
                                                                    SonClavesEquivalentes(k, "Material") || 
                                                                    SonClavesEquivalentes(k, "Item")));
            if (claveProd != null) tresClaves.Add(claveProd);

            // Nivel 3: CONTENEDOR > BANDEO > PRESENTACIÓN > EMPAQUE
            // Priorizando aquellos que tengan más de 1 opción real distinta (evitando que N/A opaque a Contenedor)
            var restantes = clavesPresentes.Where(k => !tresClaves.Any(c => SonClavesEquivalentes(c, k)))
                                           .OrderByDescending(k => ContarValoresDistintos(baseVariantes, k))
                                           .ToList();

            string? clave3 = restantes.FirstOrDefault(k => SonClavesEquivalentes(k, "Contenedor") || SonClavesEquivalentes(k, "Conntenedor"))
                             ?? restantes.FirstOrDefault(k => SonClavesEquivalentes(k, "Presentación") || SonClavesEquivalentes(k, "Precentación"))
                             ?? restantes.FirstOrDefault(k => SonClavesEquivalentes(k, "Bandeo"))
                             ?? restantes.FirstOrDefault(k => SonClavesEquivalentes(k, "Empaque"))
                             ?? restantes.FirstOrDefault();
            if (clave3 != null) tresClaves.Add(clave3);
        }
        else
        {
            // CASO SIN TIPO DE OPERACIÓN (ej: Bandeo de Productos):
            // Nivel 1: PRODUCTO
            string? claveProd = clavesPresentes.FirstOrDefault(k => 
                SonClavesEquivalentes(k, "Producto") || 
                SonClavesEquivalentes(k, "Material") || 
                SonClavesEquivalentes(k, "Item"))
                ?? clavesPresentes.FirstOrDefault();
            if (claveProd != null) tresClaves.Add(claveProd);

            // Nivel 2: BANDEO / PACK > CONTENEDOR > FORMATO
            var restantes = clavesPresentes.Where(k => !tresClaves.Any(c => SonClavesEquivalentes(c, k))).ToList();
            string? clave2 = restantes.FirstOrDefault(k => SonClavesEquivalentes(k, "Bandeo") ||
                                                           SonClavesEquivalentes(k, "Contenedor") ||
                                                           SonClavesEquivalentes(k, "Conntenedor") ||
                                                           SonClavesEquivalentes(k, "Formato"))
                             ?? restantes.FirstOrDefault();
            if (clave2 != null) tresClaves.Add(clave2);

            // Nivel 3: PRESENTACIÓN > EMPAQUE > CLIMATIZACIÓN (ordenado por diversidad de valores)
            restantes = clavesPresentes.Where(k => !tresClaves.Any(c => SonClavesEquivalentes(c, k)))
                                       .OrderByDescending(k => ContarValoresDistintos(baseVariantes, k))
                                       .ToList();

            string? clave3 = restantes.FirstOrDefault(k => SonClavesEquivalentes(k, "Presentación") ||
                                                           SonClavesEquivalentes(k, "Precentación") ||
                                                           SonClavesEquivalentes(k, "Empaque") ||
                                                           SonClavesEquivalentes(k, "Climatización") ||
                                                           SonClavesEquivalentes(k, "Calibre"))
                             ?? restantes.FirstOrDefault();
            if (clave3 != null) tresClaves.Add(clave3);
        }

        // Construir la lista de filtros dinámicos (hasta 3) preservando selecciones previas
        var nuevosFiltros = new List<NivelFiltroDinamico>();
        for (int i = 0; i < tresClaves.Count; i++)
        {
            string clave = tresClaves[i];
            string titulo = ObtenerTituloFiltro(clave);

            string valorPrevio = filtrosDinamicos.FirstOrDefault(f => SonClavesEquivalentes(f.Clave, clave))?.ValorSeleccionado ?? "";

            nuevosFiltros.Add(new NivelFiltroDinamico
            {
                Clave = clave,
                Titulo = titulo,
                ValorSeleccionado = valorPrevio,
                OpcionesDisponibles = new List<string>()
            });
        }

        filtrosDinamicos = nuevosFiltros;
    }

    private int ContarValoresDistintos(List<OdooVariantDto> variantes, string clave)
    {
        var valores = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var v in variantes)
        {
            var val = ObtenerValorAtributo(v.nombre, clave);
            if (!string.IsNullOrWhiteSpace(val) && !val.Equals("N/A", StringComparison.OrdinalIgnoreCase))
            {
                valores.Add(val);
            }
        }
        return valores.Count;
    }

    private void ActualizarCascadaFiltros()
    {
        var pool = ObtenerVariantesBaseAreaYTurno();

        for (int i = 0; i < filtrosDinamicos.Count; i++)
        {
            var f = filtrosDinamicos[i];

            // Opciones disponibles para este nivel según el pool actual
            var ops = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var v in pool)
            {
                var val = ObtenerValorAtributo(v.nombre, f.Clave);
                if (!string.IsNullOrWhiteSpace(val))
                {
                    ops.Add(val);
                }
            }
            f.OpcionesDisponibles = ops.OrderBy(x => x).ToList();

            // Si el valor seleccionado previamente ya no está disponible en las opciones, se limpia
            if (!string.IsNullOrWhiteSpace(f.ValorSeleccionado) && !f.OpcionesDisponibles.Contains(f.ValorSeleccionado, StringComparer.OrdinalIgnoreCase))
            {
                f.ValorSeleccionado = "";
            }

            // Filtrar el pool para el siguiente nivel si este nivel tiene valor seleccionado
            if (!string.IsNullOrWhiteSpace(f.ValorSeleccionado))
            {
                pool = pool.Where(v => MatchAtributo(v.nombre, f.Clave, f.ValorSeleccionado)).ToList();
            }
        }

        variantesFiltradas = pool;

        // Si solo queda 1 variante, preseleccionarla automáticamente
        if (variantesFiltradas.Count == 1)
        {
            varianteSeleccionada = variantesFiltradas[0];
        }
        else if (varianteSeleccionada != null && !variantesFiltradas.Any(v => v.id == varianteSeleccionada.id))
        {
            varianteSeleccionada = null;
        }
    }

    private void ToggleFiltroDinamico(int nivelIndex, string valor)
    {
        if (nivelIndex < 0 || nivelIndex >= filtrosDinamicos.Count) return;

        var f = filtrosDinamicos[nivelIndex];
        if (f.ValorSeleccionado.Equals(valor, StringComparison.OrdinalIgnoreCase))
        {
            f.ValorSeleccionado = "";
        }
        else
        {
            f.ValorSeleccionado = valor;
        }

        // Cascada sucesiva: al cambiar un nivel superior, limpiamos los niveles inferiores
        for (int j = nivelIndex + 1; j < filtrosDinamicos.Count; j++)
        {
            filtrosDinamicos[j].ValorSeleccionado = "";
        }

        ActualizarCascadaFiltros();
    }

    private void LimpiarFiltros()
    {
        foreach (var f in filtrosDinamicos)
        {
            f.ValorSeleccionado = "";
            f.BusquedaRapida = "";
        }
        ActualizarCascadaFiltros();
    }

    private Dictionary<string, string> ParsearAtributos(string nombre)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(nombre)) return dict;

        var partes = nombre.Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var parte in partes)
        {
            var kv = parte.Split(new[] { ": " }, 2, StringSplitOptions.None);
            if (kv.Length == 2)
            {
                dict[kv[0].Trim()] = kv[1].Trim();
            }
        }
        return dict;
    }

    private bool SonClavesEquivalentes(string k1, string k2)
    {
        if (string.Equals(k1, k2, StringComparison.OrdinalIgnoreCase)) return true;
        return NormalizarClave(k1).Equals(NormalizarClave(k2), StringComparison.OrdinalIgnoreCase);
    }

    private string NormalizarClave(string k)
    {
        if (string.IsNullOrWhiteSpace(k)) return "";
        k = k.Trim().ToLowerInvariant();
        if (k == "área" || k == "area") return "area";
        if (k == "precentación" || k == "presentación" || k == "presentacion") return "presentacion";
        if (k == "conntenedor" || k == "contenedor") return "contenedor";
        return k;
    }

    private bool MatchAtributo(string nombreVariante, string clave, string valorEsperado)
    {
        if (string.IsNullOrWhiteSpace(nombreVariante) || string.IsNullOrWhiteSpace(valorEsperado)) return false;
        var dict = ParsearAtributos(nombreVariante);
        foreach (var kvp in dict)
        {
            if (SonClavesEquivalentes(kvp.Key, clave))
            {
                return kvp.Value.Trim().Equals(valorEsperado.Trim(), StringComparison.OrdinalIgnoreCase);
            }
        }
        return false;
    }

    private string? ObtenerValorAtributo(string nombreVariante, string clave)
    {
        if (string.IsNullOrWhiteSpace(nombreVariante)) return null;
        var dict = ParsearAtributos(nombreVariante);
        foreach (var kvp in dict)
        {
            if (SonClavesEquivalentes(kvp.Key, clave))
            {
                return kvp.Value.Trim();
            }
        }
        return null;
    }

    private string ObtenerTituloFiltro(string clave)
    {
        string norm = NormalizarClave(clave);
        return norm switch
        {
            "producto" => "PRODUCTO:",
            "contenedor" => "CONTENEDOR:",
            "bandeo" => "BANDEO / PACK:",
            "presentacion" => "PRESENTACIÓN:",
            "tipo" => "TIPO / OPERACIÓN:",
            "empaque" => "EMPAQUE:",
            "climatizacion" => "CLIMATIZACIÓN:",
            _ => clave.ToUpperInvariant() + ":"
        };
    }

    private string LimpiarNombreVariante(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "";

        var dict = ParsearAtributos(nombre);
        var partesVisibles = new List<string>();

        var clavesIgnoradas = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "Cliente", "Empresa", "Area", "Área", "Turno"
        };

        foreach (var kvp in dict)
        {
            if (clavesIgnoradas.Contains(kvp.Key)) continue;

            string claveLimpia = kvp.Key;
            if (SonClavesEquivalentes(claveLimpia, "Conntenedor")) claveLimpia = "Contenedor";
            if (SonClavesEquivalentes(claveLimpia, "Precentación")) claveLimpia = "Pres";
            if (SonClavesEquivalentes(claveLimpia, "Presentación")) claveLimpia = "Pres";

            partesVisibles.Add($"{claveLimpia}: {kvp.Value}");
        }

        if (partesVisibles.Any())
        {
            return string.Join(", ", partesVisibles);
        }

        return nombre.Replace($"Cliente: {operacionSeleccionadaNombre}, ", "", StringComparison.OrdinalIgnoreCase)
                     .Replace("Cliente: CBC Pepsi, ", "", StringComparison.OrdinalIgnoreCase)
                     .Replace("Area: CD, ", "")
                     .Replace("Precentación:", "Pres:");
    }

    private void SeleccionarVariante(OdooVariantDto v)
    {
        varianteSeleccionada = v;
        Snackbar.Add($"Variante seleccionada: {v.default_code}", Severity.Info);
    }

    private void SumarCantidad(decimal delta)
    {
        cantidadProducida += delta;
    }

    private void RestarCantidad(decimal delta)
    {
        cantidadProducida = Math.Max(0, cantidadProducida - delta);
    }

    private void CambiarFecha(int dias)
    {
        fechaJornada = fechaJornada.AddDays(dias);
        _ = CargarHistorialHoy();
    }

    private void SetFechaHoy()
    {
        fechaJornada = DateTime.Today;
        _ = CargarHistorialHoy();
    }

    private void OnFechaChanged(DateTime? dt)
    {
        if (dt.HasValue)
        {
            fechaJornada = dt.Value;
            _ = CargarHistorialHoy();
        }
    }

    private async Task GuardarProduccion()
    {
        if (!PuedeGuardar) return;

        var dict = ParsearAtributos(varianteSeleccionada!.nombre);
        string prodName = "";
        if (dict.TryGetValue("Producto", out var p) && !string.IsNullOrWhiteSpace(p))
        {
            prodName = p;
        }
        else
        {
            var primeraOp = dict.FirstOrDefault(k => !SonClavesEquivalentes(k.Key, "Cliente") &&
                                                     !SonClavesEquivalentes(k.Key, "Empresa") &&
                                                     !SonClavesEquivalentes(k.Key, "Area") &&
                                                     !SonClavesEquivalentes(k.Key, "Turno"));
            prodName = !string.IsNullOrWhiteSpace(primeraOp.Value) ? primeraOp.Value : varianteSeleccionada.template_name;
        }

        string areaFinal = ObtenerValorAtributo(varianteSeleccionada.nombre, "Area") 
                        ?? ObtenerValorAtributo(varianteSeleccionada.nombre, "Área") 
                        ?? areaSeleccionada;

        var item = new ProduccionDiariaDto
        {
            cliente = operacionSeleccionadaNombre,
            operacion_id = operacionSeleccionadaId,
            actividad = servicioSeleccionado?.NombreCorto ?? "Actividad de Producción",
            area_cliente = !string.IsNullOrWhiteSpace(areaFinal) ? areaFinal : areaSeleccionada,
            servicio_codigo = varianteSeleccionada.default_code,
            servicio_descripcion = varianteSeleccionada.nombre,
            nombre_producto = prodName,
            cantidad_producto = cantidadProducida,
            costo_producto = 0, // Backend aplica automáticamente fixed_price de lista
            fecha_inicio = fechaJornada.Date,
            fecha_fin = fechaJornada.Date,
            hora_inicio = turnoSeleccionado.Contains("Nocturno") ? "19:00" : "07:00",
            hora_fin = turnoSeleccionado.Contains("Nocturno") ? "07:00" : "19:00",
            no_lote = string.IsNullOrWhiteSpace(noLote) ? null : noLote.Trim(),
            oc = string.IsNullOrWhiteSpace(ordenCompra) ? null : ordenCompra.Trim(),
            asignado_a = string.IsNullOrWhiteSpace(observaciones) ? null : observaciones.Trim(),
            facturada = false
        };

        // Guardar SIEMPRE en memoria primero (igual que Movimientos de Personal)
        item.id = -(pendientesOffline.Count + 1);
        pendientesOffline.Insert(0, item);
        await GuardarColaOfflineEnStorage();

        Snackbar.Add($"Actividad registrada en memoria ({cantidadProducida:N0} unid). Presione 'Guardar en BD' para sincronizar con la base de datos.", Severity.Info);

        // Reiniciar entrada para siguiente actividad
        cantidadProducida = 0;
        noLote = "";
        ordenCompra = "";
        varianteSeleccionada = null;
        LimpiarFiltros();
        _ = CargarHistorialHoy();
        StateHasChanged();
    }

    private async Task CargarHistorialHoy()
    {
        try
        {
            List<ProduccionDiariaDto> onlineList = new();

            if (esModoOnline)
            {
                var res = await OdooService.GetProduccionDiaria(fechaJornada, fechaJornada, operacionSeleccionadaId, null);
                if (!res.Respuesta.ExisteError && res.Model != null)
                {
                    onlineList = res.Model.OrderByDescending(h => h.id).ToList();
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("localStorage.setItem", KeyCacheHistorial, JsonSerializer.Serialize(onlineList));
                    }
                    catch { }
                }
            }
            else
            {
                try
                {
                    var cached = await JSRuntime.InvokeAsync<string>("localStorage.getItem", KeyCacheHistorial);
                    if (!string.IsNullOrWhiteSpace(cached))
                    {
                        onlineList = JsonSerializer.Deserialize<List<ProduccionDiariaDto>>(cached) ?? new();
                    }
                }
                catch { }
            }

            var offHoy = pendientesOffline
                .Where(p => p.fecha_inicio?.Date == fechaJornada.Date && p.operacion_id == operacionSeleccionadaId)
                .ToList();

            historialHoy = offHoy.Concat(onlineList).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar historial: {ex.Message}");
            try
            {
                var cached = await JSRuntime.InvokeAsync<string>("localStorage.getItem", KeyCacheHistorial);
                var onlineList = (!string.IsNullOrWhiteSpace(cached))
                    ? (JsonSerializer.Deserialize<List<ProduccionDiariaDto>>(cached) ?? new())
                    : new List<ProduccionDiariaDto>();

                var offHoy = pendientesOffline
                    .Where(p => p.fecha_inicio?.Date == fechaJornada.Date && p.operacion_id == operacionSeleccionadaId)
                    .ToList();

                historialHoy = offHoy.Concat(onlineList).ToList();
            }
            catch { }
        }
    }

    private async Task AbrirModalEditarTablet(ProduccionDiariaDto reg)
    {
        if (reg == null) return;
        if (!string.IsNullOrEmpty(reg.no_lote) || reg.facturada)
        {
            Snackbar.Add("No se puede editar una actividad ya sellada o facturada.", Severity.Warning);
            return;
        }

        var editDto = new ProduccionDiariaDto
        {
            id = reg.id,
            hoja_servicio = reg.hoja_servicio,
            actividad = reg.actividad,
            cliente = reg.cliente,
            area_cliente = reg.area_cliente,
            fecha_inicio = reg.fecha_inicio,
            fecha_fin = reg.fecha_fin,
            hora_inicio = reg.hora_inicio,
            hora_fin = reg.hora_fin,
            nombre_producto = reg.nombre_producto,
            no_lote = reg.no_lote,
            oc = reg.oc,
            no_marchamo = reg.no_marchamo,
            peso = reg.peso,
            cantidad_producto = reg.cantidad_producto,
            costo_producto = reg.costo_producto,
            servicio_codigo = reg.servicio_codigo,
            servicio_descripcion = reg.servicio_descripcion,
            asignado_a = reg.asignado_a,
            facturada = reg.facturada,
            operacion_id = reg.operacion_id
        };

        var parameters = new DialogParameters { ["Actividad"] = editDto };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DialogEditarActividadProduccion>("Editar Actividad", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ProduccionDiariaDto edited)
        {
            if (edited.id < 0)
            {
                // Es registro offline
                var offItem = pendientesOffline.FirstOrDefault(p => p.id == edited.id);
                if (offItem != null)
                {
                    offItem.cantidad_producto = edited.cantidad_producto;
                    offItem.no_lote = edited.no_lote;
                    offItem.oc = edited.oc;
                    offItem.asignado_a = edited.asignado_a;
                    await GuardarColaOfflineEnStorage();
                }
                var histItem = historialHoy.FirstOrDefault(h => h.id == edited.id);
                if (histItem != null)
                {
                    histItem.cantidad_producto = edited.cantidad_producto;
                    histItem.no_lote = edited.no_lote;
                    histItem.oc = edited.oc;
                    histItem.asignado_a = edited.asignado_a;
                }
                Snackbar.Add("Registro offline actualizado correctamente.", Severity.Success);
                StateHasChanged();
            }
            else
            {
                // Es registro que estaba en base de datos: actualizar en memoria y marcar pendiente de sincronizar
                var histItem = historialHoy.FirstOrDefault(h => h.id == edited.id);
                if (histItem != null)
                {
                    histItem.cantidad_producto = edited.cantidad_producto;
                    histItem.no_lote = edited.no_lote;
                    histItem.oc = edited.oc;
                    histItem.asignado_a = edited.asignado_a;
                }

                var existingOff = pendientesOffline.FirstOrDefault(p => p.id == edited.id);
                if (existingOff != null)
                {
                    existingOff.cantidad_producto = edited.cantidad_producto;
                    existingOff.no_lote = edited.no_lote;
                    existingOff.oc = edited.oc;
                    existingOff.asignado_a = edited.asignado_a;
                }
                else
                {
                    pendientesOffline.Add(edited);
                }

                await GuardarColaOfflineEnStorage();
                Snackbar.Add("Actividad modificada en memoria. Presione 'Guardar en BD' para sincronizar los cambios.", Severity.Info);
                StateHasChanged();
            }
        }
    }

    private async Task ConfirmarEliminarTablet(ProduccionDiariaDto reg)
    {
        if (reg == null) return;
        if (!string.IsNullOrEmpty(reg.no_lote) || reg.facturada)
        {
            Snackbar.Add("No se puede eliminar una actividad ya sellada o facturada.", Severity.Warning);
            return;
        }

        bool? confirm = await DialogService.ShowMessageBox(
            "Eliminar Actividad",
            $"¿Está seguro de eliminar el registro de '{reg.actividad}' ({reg.nombre_producto}) con {reg.cantidad_producto:N0} unidades?",
            yesText: "Sí, Eliminar",
            cancelText: "Cancelar"
        );

        if (confirm == true)
        {
            if (reg.id < 0)
            {
                // Borrar de la cola offline
                pendientesOffline.RemoveAll(p => p.id == reg.id);
                historialHoy.RemoveAll(h => h.id == reg.id);
                await GuardarColaOfflineEnStorage();
                Snackbar.Add("Actividad offline eliminada.", Severity.Success);
                StateHasChanged();
            }
            else
            {
                estaBloqueandoAccion = true;
                mensajeCarga = "Eliminando actividad de Odoo...";
                StateHasChanged();
                try
                {
                    var resp = await OdooService.DeleteProduccionDiaria(reg.id);
                    if (!resp.Respuesta.ExisteError)
                    {
                        Snackbar.Add("Actividad eliminada correctamente.", Severity.Success);
                        await CargarHistorialHoy();
                    }
                    else
                    {
                        Snackbar.Add($"Error al eliminar: {resp.Respuesta.MensajeError}", Severity.Error);
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
                }
                finally
                {
                    estaBloqueandoAccion = false;
                    StateHasChanged();
                }
            }
        }
    }
