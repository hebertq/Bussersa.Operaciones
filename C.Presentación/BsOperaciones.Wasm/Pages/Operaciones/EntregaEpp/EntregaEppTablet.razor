@page "/operaciones/entrega-epp"
@page "/operaciones/entrega-epp-tablet"
@layout TabletLayout

@using Modelo.Entidades.Operaciones
@using Modelo.Entidades.Entradas.Odoo
@using HostService.Interfaces
@using BsOperaciones.Pages.Operaciones.MovimientosPersonal
@using MudBlazor
@inject IOdooService OdooService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    @* Encabezado Principal *@
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 16px; background: linear-gradient(135deg, #1E3A8A 0%, #3B82F6 100%); color: white;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudAvatar Color="Color.Surface" Size="Size.Large" Variant="Variant.Filled" Style="color: #1E3A8A;">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Class="fw-bold">Dotación de EPP y Uniformes</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.9;">Control de entrega de equipos a colaboradores con firma digital y descuento de inventario en Odoo</MudText>
                </div>
            </MudStack>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.TabletAndroid" Size="Size.Medium">
                Modo Campo / Tablet
            </MudChip>
        </MudStack>
    </MudPaper>

    @* Pestañas: Nueva Entrega vs Historial *@
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Color="Color.Primary">
        @* PESTAÑA 1: NUEVA ENTREGA *@
        <MudTabPanel Text="Nueva Entrega" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
            <MudGrid Spacing="3">
                @* PASO 1: SELECCIONAR COLABORADOR *@
                <MudItem xs="12" md="5">
                    <MudCard Outlined="true" Style="border-radius: 16px; height: 100%;">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">1</MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Class="fw-bold">Colaborador</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Seleccione el trabajador que recibe la dotación</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Spacing="3">
                                <MudAutocomplete T="OdooEmployeeDto"
                                                 Label="Buscar por nombre o código..."
                                                 Value="colaboradorSeleccionado"
                                                 ValueChanged="OnColaboradorChanged"
                                                 SearchFunc="BuscarEmpleados"
                                                 ToStringFunc="@(e => e == null ? "" : $"{e.Name} (Cód: {e.CodigoEmpleado ?? e.Id})")"
                                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                                 AdornmentColor="Color.Primary"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="true"
                                                 CoerceValue="false"
                                                 Variant="Variant.Outlined"
                                                 Dense="true" />

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PeopleAlt"
                                           FullWidth="true"
                                           OnClick="AbrirCatalogoEmpleados">
                                    Explorar Catálogo de Personal
                                </MudButton>

                                @if (colaboradorSeleccionado != null)
                                {
                                    <MudPaper Class="pa-3 mt-2" Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-radius: 12px; border-left: 5px solid #2563EB;">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                                @(colaboradorSeleccionado.Name?.Substring(0, Math.Min(1, colaboradorSeleccionado.Name.Length)) ?? "E")
                                            </MudAvatar>
                                            <div style="overflow: hidden;">
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
                                                    @colaboradorSeleccionado.Name
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Cód: @(colaboradorSeleccionado.CodigoEmpleado ?? colaboradorSeleccionado.Id) | Cargo: @(colaboradorSeleccionado.JobTitle ?? "Operario")
                                                </MudText>
                                                @if (!string.IsNullOrEmpty(colaboradorSeleccionado.DepartmentName))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Info" Class="d-block">
                                                        Área/Op: @colaboradorSeleccionado.DepartmentName
                                                    </MudText>
                                                }
                                            </div>
                                        </MudStack>
                                    </MudPaper>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                        Busque al trabajador para habilitar la entrega.
                                    </MudAlert>
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                @* PASO 2: SELECCIONAR EQUIPO Y VARIANTE *@
                <MudItem xs="12" md="7">
                    <MudCard Outlined="true" Style="border-radius: 16px; height: 100%;">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">2</MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Class="fw-bold">Equipo de Protección / Uniforme</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Elija el producto y especifique la variante requerida</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Spacing="3">
                                @* Selector de Plantilla Principal (Botas, Cascos, Camisas) *@
                                <MudGrid Spacing="2">
                                    @foreach (var tmpl in catalogoEpp)
                                    {
                                        bool isSelected = plantillaSeleccionada?.TemplateId == tmpl.TemplateId;
                                        <MudItem xs="12" sm="4">
                                            <MudPaper Outlined="true"
                                                      Class="pa-3 text-center cursor-pointer"
                                                      Style="@(isSelected 
                                                               ? "border: 2px solid #2563EB; background-color: rgba(37, 99, 235, 0.08); border-radius: 12px;" 
                                                               : "border-radius: 12px; transition: all 0.2s;")"
                                                      OnClick="@(() => SeleccionarPlantilla(tmpl))">
                                                <MudIcon Icon="@ObtenerIconoPlantilla(tmpl.TemplateNombre)"
                                                         Color="@(isSelected ? Color.Primary : Color.Default)"
                                                         Size="Size.Large" Class="mb-1" />
                                                <MudText Typo="Typo.subtitle2" Class="fw-bold">@tmpl.TemplateNombre</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@tmpl.VariantesCount variantes</MudText>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>

                                @* Selector de Variante cuando hay plantilla seleccionada *@
                                @if (plantillaSeleccionada != null)
                                {
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Seleccione la Variante Exacta</MudText>

                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="8">
                                            <MudSelect T="EppVarianteItemDto"
                                                       Label="Variante (Tipo, Talla, Cintas)"
                                                       Value="varianteSeleccionada"
                                                       ValueChanged="OnVarianteChanged"
                                                       ToStringFunc="@(v => v == null ? "" : $"{v.DefaultCode} - {v.VarianteDescripcion}")"
                                                       Variant="Variant.Outlined"
                                                       Dense="true">
                                                @foreach (var v in plantillaSeleccionada.Variantes)
                                                {
                                                    <MudSelectItem Value="@v">
                                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                            <div>
                                                                <span class="fw-bold">@v.DefaultCode</span>
                                                                <small class="text-muted ms-2">@v.VarianteDescripcion</small>
                                                            </div>
                                                            <MudChip T="string" Size="Size.Small" Color="@(v.StockDisponible > 0 ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                                                                Stock: @v.StockDisponible
                                                            </MudChip>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField @bind-Value="cantidadEntrega"
                                                             Label="Cantidad"
                                                             Min="1"
                                                             Max="10"
                                                             Variant="Variant.Outlined"
                                                             Dense="true" />
                                        </MudItem>
                                    </MudGrid>

                                    @if (varianteSeleccionada != null)
                                    {
                                        <MudPaper Class="pa-2 px-3 mt-1" Style="background: #F0FDF4; border: 1px solid #86EFAC; border-radius: 8px;">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <div>
                                                    <MudText Typo="Typo.caption" Color="Color.Success" Class="fw-bold">SKU SELECCIONADO: @varianteSeleccionada.DefaultCode</MudText>
                                                    <MudText Typo="Typo.caption" Class="d-block">@varianteSeleccionada.VarianteDescripcion</MudText>
                                                </div>
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                                    Existencias: @varianteSeleccionada.StockDisponible
                                                </MudChip>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                @* PASO 3: MOTIVO Y FIRMA DIGITAL *@
                <MudItem xs="12">
                    <MudCard Outlined="true" Style="border-radius: 16px;">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">3</MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Class="fw-bold">Motivo y Firma Digital del Colaborador</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">El trabajador confirma la recepción del equipo firmando en la pantalla</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudGrid Spacing="3">
                                <MudItem xs="12" md="5">
                                    <MudStack Spacing="3">
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1">Motivo de Entrega</MudText>
                                            <MudChipSet T="string" @bind-SelectedValue="motivoSeleccionado" CheckMark="true" Variant="Variant.Filled" Color="Color.Primary">
                                                <MudChip T="string" Value="@("Dotación Inicial")">Dotación Inicial</MudChip>
                                                <MudChip T="string" Value="@("Reposición por Desgaste")">Reposición por Desgaste</MudChip>
                                                <MudChip T="string" Value="@("Reposición por Daño")">Reposición por Daño</MudChip>
                                                <MudChip T="string" Value="@("Reposición por Pérdida")">Reposición por Pérdida</MudChip>
                                                <MudChip T="string" Value="@("Cambio de Talla")">Cambio de Talla</MudChip>
                                            </MudChipSet>
                                        </div>

                                        <MudTextField @bind-Value="observaciones"
                                                      Label="Observaciones adicionales (opcional)"
                                                      Variant="Variant.Outlined"
                                                      Lines="3" />
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="12" md="7">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                                <MudIcon Icon="@Icons.Material.Filled.Draw" Size="Size.Small" Class="me-1" />
                                                Firma Táctil del Colaborador
                                            </MudText>
                                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LimpiarFirma" StartIcon="@Icons.Material.Filled.Refresh">
                                                Limpiar Firma
                                            </MudButton>
                                        </MudStack>

                                        <div style="border: 2px dashed #94A3B8; border-radius: 12px; background: white; touch-action: none; position: relative;">
                                            <canvas id="signatureCanvas"
                                                    style="width: 100%; height: 180px; display: block; cursor: crosshair; border-radius: 10px;"></canvas>
                                            @if (!firmaIniciada)
                                            {
                                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none; color: #94A3B8; text-align: center;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Large" />
                                                    <MudText Typo="Typo.caption" Class="d-block">Firme aquí con el dedo o lápiz</MudText>
                                                </div>
                                            }
                                        </div>
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                        <MudCardActions Class="pa-4 d-flex justify-end">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       Disabled="@(guardando || colaboradorSeleccionado == null || varianteSeleccionada == null)"
                                       OnClick="GuardarEntrega">
                                @if (guardando)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Registrando en Odoo...</MudText>
                                }
                                else
                                {
                                    <span>Confirmar Entrega de EPP</span>
                                }
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* PESTAÑA 2: HISTORIAL DE ENTREGAS *@
        <MudTabPanel Text="Historial de Entregas" Icon="@Icons.Material.Filled.History">
            <MudStack Spacing="3">
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" sm="5">
                        <MudTextField @bind-Value="filtroHistorial"
                                      Placeholder="Buscar por empleado, código o producto..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDateRangePicker @bind-DateRange="rangoFechasHistorial"
                                            PlaceholderStart="Desde"
                                            PlaceholderEnd="Hasta"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="3" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="CargarHistorial">
                            Actualizar
                        </MudButton>
                    </MudItem>
                </MudGrid>

                <MudTable Items="HistorialFiltrado" Dense="true" Hover="true" Striped="true" Elevation="1" Loading="cargandoHistorial">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Colaborador</MudTh>
                        <MudTh>Equipo / Uniforme</MudTh>
                        <MudTh>Variante</MudTh>
                        <MudTh>Cant.</MudTh>
                        <MudTh>Motivo</MudTh>
                        <MudTh>Entregado Por</MudTh>
                        <MudTh>Firma</MudTh>
                        <MudTh>Odoo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha">@context.FechaEntrega.ToString("dd/MM/yyyy hh:mm tt")</MudTd>
                        <MudTd DataLabel="Colaborador">
                            <MudText Typo="Typo.body2" Class="fw-bold">@context.EmpleadoNombre</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cód: @context.EmpleadoCodigo</MudText>
                        </MudTd>
                        <MudTd DataLabel="Equipo">@context.ProductoNombre</MudTd>
                        <MudTd DataLabel="Variante">@context.VarianteDescripcion</MudTd>
                        <MudTd DataLabel="Cant.">@context.Cantidad</MudTd>
                        <MudTd DataLabel="Motivo">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                @context.Motivo
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Entregado Por">@context.EntregadoPor</MudTd>
                        <MudTd DataLabel="Firma">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Title="Ver comprobante y firma"
                                           OnClick="@(() => VerDetalleEntrega(context))" />
                        </MudTd>
                        <MudTd DataLabel="Odoo">
                            @if (context.StockPickingId.HasValue && context.StockPickingId.Value > 0)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                    Move #@context.StockPickingId
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Registrado</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Class="pa-4 text-center">No hay registros de entregas de EPP para los filtros seleccionados.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudStack>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private List<EppCatalogoItemDto> catalogoEpp = new();
    private List<OdooEmployeeDto> empleadosActivos = new();
    private List<EppEntregaDto> historialEntregas = new();

    private OdooEmployeeDto? colaboradorSeleccionado;
    private EppCatalogoItemDto? plantillaSeleccionada;
    private EppVarianteItemDto? varianteSeleccionada;

    private decimal cantidadEntrega = 1;
    private string motivoSeleccionado = "Dotación Inicial";
    private string observaciones = string.Empty;

    private bool guardando = false;
    private bool cargandoHistorial = false;
    private bool firmaIniciada = false;

    private string filtroHistorial = string.Empty;
    private DateRange rangoFechasHistorial = new DateRange(DateTime.Today.AddDays(-30), DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await CargarHistorial();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InicializarCanvasFirma();
        }
    }

    private async Task CargarCatalogos()
    {
        try
        {
            var resTmpl = await OdooService.GetCatalogoEpp();
            if (!resTmpl.Respuesta.ExisteError && resTmpl.Model != null)
            {
                catalogoEpp = resTmpl.Model;
                if (catalogoEpp.Any())
                {
                    SeleccionarPlantilla(catalogoEpp.First());
                }
            }

            var resEmp = await OdooService.GetAllActiveEmployeesForRotation();
            if (!resEmp.Respuesta.ExisteError && resEmp.Model != null)
            {
                empleadosActivos = resEmp.Model;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar catálogos: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarHistorial()
    {
        cargandoHistorial = true;
        try
        {
            var res = await OdooService.GetHistorialEntregasEpp(null, rangoFechasHistorial.Start, rangoFechasHistorial.End);
            if (!res.Respuesta.ExisteError && res.Model != null)
            {
                historialEntregas = res.Model;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar historial: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargandoHistorial = false;
        }
    }

    private IEnumerable<EppEntregaDto> HistorialFiltrado
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroHistorial)) return historialEntregas;
            string s = filtroHistorial.Trim().ToLowerInvariant();
            return historialEntregas.Where(x =>
                (x.EmpleadoNombre != null && x.EmpleadoNombre.ToLowerInvariant().Contains(s)) ||
                (x.EmpleadoCodigo != null && x.EmpleadoCodigo.ToLowerInvariant().Contains(s)) ||
                (x.ProductoNombre != null && x.ProductoNombre.ToLowerInvariant().Contains(s)) ||
                (x.VarianteDescripcion != null && x.VarianteDescripcion.ToLowerInvariant().Contains(s))
            );
        }
    }

    private Task<IEnumerable<OdooEmployeeDto>> BuscarEmpleados(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<OdooEmployeeDto>>(empleadosActivos.Take(20));

        string s = value.Trim().ToLowerInvariant();
        var filtrados = empleadosActivos.Where(x =>
            (x.Name != null && x.Name.ToLowerInvariant().Contains(s)) ||
            (x.CodigoEmpleado.HasValue && x.CodigoEmpleado.Value.ToString().Contains(s)) ||
            (x.Id.ToString().Contains(s)) ||
            (x.JobTitle != null && x.JobTitle.ToLowerInvariant().Contains(s))
        ).Take(25);

        return Task.FromResult<IEnumerable<OdooEmployeeDto>>(filtrados);
    }

    private void OnColaboradorChanged(OdooEmployeeDto? emp)
    {
        colaboradorSeleccionado = emp;
    }

    private async Task AbrirCatalogoEmpleados()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<DialogCatalogoEmpleadosTablet>("Seleccionar Personal", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is List<OdooEmployeeDto> seleccionados && seleccionados.Any())
        {
            colaboradorSeleccionado = seleccionados.First();
        }
    }

    private void SeleccionarPlantilla(EppCatalogoItemDto tmpl)
    {
        plantillaSeleccionada = tmpl;
        varianteSeleccionada = tmpl.Variantes.FirstOrDefault();
    }

    private void OnVarianteChanged(EppVarianteItemDto? v)
    {
        varianteSeleccionada = v;
    }

    private string ObtenerIconoPlantilla(string nombre)
    {
        string n = (nombre ?? "").ToLowerInvariant();
        if (n.Contains("bota") || n.Contains("calzado")) return Icons.Material.Filled.Snowshoeing;
        if (n.Contains("casco") || n.Contains("craneal")) return Icons.Material.Filled.SportsMotorsports;
        if (n.Contains("camisa") || n.Contains("uniforme")) return Icons.Material.Filled.Checkroom;
        return Icons.Material.Filled.Shield;
    }

    private async Task InicializarCanvasFirma()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.setupSignaturePad = function() {
                    const canvas = document.getElementById('signatureCanvas');
                    if (!canvas) return;

                    const ctx = canvas.getContext('2d');
                    let painting = false;

                    function resizeCanvas() {
                        const rect = canvas.getBoundingClientRect();
                        canvas.width = rect.width;
                        canvas.height = rect.height;
                        ctx.strokeStyle = '#0F172A';
                        ctx.lineWidth = 2.5;
                        ctx.lineCap = 'round';
                        ctx.lineJoin = 'round';
                    }
                    resizeCanvas();
                    window.addEventListener('resize', resizeCanvas);

                    function getPos(e) {
                        const rect = canvas.getBoundingClientRect();
                        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                        return {
                            x: clientX - rect.left,
                            y: clientY - rect.top
                        };
                    }

                    function startPosition(e) {
                        painting = true;
                        window.hasSignature = true;
                        draw(e);
                    }

                    function endPosition() {
                        painting = false;
                        ctx.beginPath();
                    }

                    function draw(e) {
                        if (!painting) return;
                        if (e.cancelable) e.preventDefault();
                        const pos = getPos(e);
                        ctx.lineTo(pos.x, pos.y);
                        ctx.stroke();
                        ctx.beginPath();
                        ctx.moveTo(pos.x, pos.y);
                    }

                    canvas.addEventListener('mousedown', startPosition);
                    canvas.addEventListener('mouseup', endPosition);
                    canvas.addEventListener('mousemove', draw);
                    canvas.addEventListener('mouseleave', endPosition);

                    canvas.addEventListener('touchstart', startPosition, { passive: false });
                    canvas.addEventListener('touchend', endPosition);
                    canvas.addEventListener('touchmove', draw, { passive: false });

                    window.clearCanvas = function() {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        ctx.beginPath();
                        window.hasSignature = false;
                    };

                    window.getCanvasBase64 = function() {
                        return canvas.toDataURL('image/png');
                    };
                };
                window.setupSignaturePad();
            ");
        }
        catch { }
    }

    private async Task LimpiarFirma()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clearCanvas");
            firmaIniciada = false;
        }
        catch { }
    }

    private async Task GuardarEntrega()
    {
        if (colaboradorSeleccionado == null)
        {
            Snackbar.Add("Debe seleccionar un colaborador", Severity.Warning);
            return;
        }

        if (varianteSeleccionada == null || plantillaSeleccionada == null)
        {
            Snackbar.Add("Debe seleccionar un equipo y una variante", Severity.Warning);
            return;
        }

        guardando = true;
        try
        {
            string firmaBase64 = string.Empty;
            try
            {
                firmaBase64 = await JSRuntime.InvokeAsync<string>("getCanvasBase64");
            }
            catch { }

            var dto = new EppEntregaDto
            {
                EmpleadoId = colaboradorSeleccionado.Id,
                EmpleadoNombre = colaboradorSeleccionado.Name,
                EmpleadoCodigo = (colaboradorSeleccionado.CodigoEmpleado ?? colaboradorSeleccionado.Id).ToString(),
                ProductTmplId = plantillaSeleccionada.TemplateId,
                ProductId = varianteSeleccionada.ProductId,
                ProductoNombre = plantillaSeleccionada.TemplateNombre,
                VarianteDescripcion = varianteSeleccionada.VarianteDescripcion,
                Cantidad = cantidadEntrega,
                FechaEntrega = DateTime.Now,
                Motivo = motivoSeleccionado,
                Observaciones = observaciones,
                Estado = "ENTREGADO",
                FirmaDigital = firmaBase64
            };

            var res = await OdooService.RegistrarEntregaEpp(dto);
            if (!res.Respuesta.ExisteError)
            {
                Snackbar.Add($"¡Entrega registrada con éxito! El inventario de Odoo ha sido rebajado.", Severity.Success);
                
                // Limpiar formulario para el siguiente trabajador
                colaboradorSeleccionado = null;
                observaciones = string.Empty;
                cantidadEntrega = 1;
                await LimpiarFirma();
                await CargarCatalogos();
                await CargarHistorial();
            }
            else
            {
                Snackbar.Add($"Error al registrar: {res.Respuesta.MensajeError ?? "Ocurrió un error inesperado"}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task VerDetalleEntrega(EppEntregaDto item)
    {
        var parameters = new DialogParameters { ["Entrega"] = item };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<DialogDetalleEntregaEpp>("Detalle de Entrega", parameters, options);
    }
}
