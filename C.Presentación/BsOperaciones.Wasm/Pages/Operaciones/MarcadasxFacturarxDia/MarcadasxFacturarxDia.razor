@page "/marcadas-facturar"
@using Modelo.Report
@using Modelo.Entidades.Entradas.Odoo

<MudOverlay Visible="isloaddata" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Procesando datos...</MudText>
    </div>
</MudOverlay>

<MudPaper Elevation="0" Class="pa-4 mb-3" Style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
    <MudGrid Spacing="3" Class="align-end">
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="Desde" Date="_fchaDesdeWrapper" DateChanged="OnDesdeDateChanged" Variant="Variant.Outlined" Color="Color.Primary" DateFormat="dd/MM/yyyy" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="Hasta" Date="_fchaHastaWrapper" DateChanged="OnHastaDateChanged" Variant="Variant.Outlined" Color="Color.Primary" DateFormat="dd/MM/yyyy" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="int" Label="Operación / Cliente" Value="operacion" ValueChanged="OnChangeCliente" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="0">Seleccione una operación...</MudSelectItem>
                @if (PayLoadOper != null)
                {
                    @foreach (var item in PayLoadOper)
                    {
                        <MudSelectItem Value="@item.id">@item.nombre</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="ConfirmarCierre" Disabled="@BotonEnabled" FullWidth="true" Style="height: 40px; margin-bottom: 6px; font-weight: bold;">
                CERRAR DIAS
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* --- BANNER O PANEL DE CONCILIACIÓN CON CLIENTE --- *@
@if (SoportaConciliacionActual)
{
    @if (!TieneConciliacion)
    {
        <MudPaper Elevation="0" Class="pa-3 mb-3 d-flex align-center justify-between flex-wrap gap-2" Style="background-color: #f0fdf4; border: 1px dashed #86efac; border-radius: 12px;">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Success" Size="Size.Large" />
                <div>
                    <span class="fw-bold text-success" style="font-size: 14px;">Conciliación con Cliente Disponible (@nombreOperacion)</span>
                    <span class="text-secondary small d-block">Suba el archivo de reporte externo emitido por el cliente (.xlsx) para verificar que las horas ordinarias y extras consolidadas por área y puesto coincidan antes de cerrar.</span>
                </div>
            </div>
            <MudFileUpload T="IBrowserFile" FilesChanged="CargarArchivoConciliacion" Accept=".xlsx,.xls">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.UploadFile" Class="fw-bold rounded-pill px-4 py-2">
                        CONCILIAR CON CLIENTE (.XLSX)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background-color: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0;">
            <div class="d-flex align-center justify-between flex-wrap gap-2 mb-3">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold">
                        🏢 @resultadoConciliacion.NombreCliente
                    </MudChip>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                        📄 @nombreArchivoConciliacion
                    </MudChip>
                    @if (resultadoConciliacion.ConsolidadoCoincideTotalmente)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold" Icon="@Icons.Material.Filled.CheckCircle">
                            Consolidado Coincide 100%
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold" Icon="@Icons.Material.Filled.Warning">
                            @resultadoConciliacion.AreasConDiferencia Área(s) con Diferencia
                        </MudChip>
                    }
                </div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudFileUpload T="IBrowserFile" FilesChanged="CargarArchivoConciliacion" Accept=".xlsx,.xls">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh">
                                Cargar Otro Archivo
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="LimpiarConciliacion" StartIcon="@Icons.Material.Filled.Close">
                        Quitar Conciliación
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="ExportarConciliacionExcel" StartIcon="@Icons.Custom.FileFormats.FileExcel" Class="fw-bold rounded-pill px-3">
                        Exportar Conciliación
                    </MudButton>
                </div>
            </div>

            @* KPI Cards *@
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-2 text-center" Style="background-color: #f0f7ff; border: 1px solid #bfdbfe; border-radius: 8px;">
                        <span class="small text-secondary fw-semibold">Producción Bussersa</span>
                        <div class="fs-6 fw-bold text-primary">@resultadoConciliacion.TotalHorasBussersa.ToString("N2") h</div>
                        <div class="text-muted" style="font-size: 11px;">@resultadoConciliacion.TotalTurnosBussersa turnos (@resultadoConciliacion.TotalHorasOrdBussersa.ToString("N2")o + @resultadoConciliacion.TotalHorasExtBussersa.ToString("N2")e)</div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-2 text-center" Style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
                        <span class="small text-secondary fw-semibold">Reportado por @resultadoConciliacion.NombreCliente</span>
                        <div class="fs-6 fw-bold text-dark">@resultadoConciliacion.TotalHorasClienteTotal.ToString("N2") h</div>
                        <div class="text-muted" style="font-size: 11px;">@resultadoConciliacion.TotalTurnosClienteTotal turnos (@resultadoConciliacion.TotalHorasOrdClienteTotal.ToString("N2")o + @resultadoConciliacion.TotalHorasExtClienteTotal.ToString("N2")e)</div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-2 text-center" Style="@($"background-color: {(Math.Abs(resultadoConciliacion.DiferenciaTotalHorasGlobal) < 0.01m ? "#f0fdf4" : "#fef2f2")}; border: 1px solid {(Math.Abs(resultadoConciliacion.DiferenciaTotalHorasGlobal) < 0.01m ? "#86efac" : "#fca5a5")}; border-radius: 8px;")">
                        <span class="small fw-semibold @(Math.Abs(resultadoConciliacion.DiferenciaTotalHorasGlobal) < 0.01m ? "text-success" : "text-danger")">Diferencia Total Neta</span>
                        <div class="fs-6 fw-bold @(Math.Abs(resultadoConciliacion.DiferenciaTotalHorasGlobal) < 0.01m ? "text-success" : "text-danger")">
                            @resultadoConciliacion.DiferenciaTotalHorasGlobal.ToString("+0.00;-0.00;0.00") h
                        </div>
                        <div class="small" style="font-size: 11px;">(Ord: @resultadoConciliacion.DiferenciaHorasOrdGlobal.ToString("+0.00;-0.00;0.00")h | Ext: @resultadoConciliacion.DiferenciaHorasExtGlobal.ToString("+0.00;-0.00;0.00")h)</div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-2 text-center" Style="@($"background-color: {(resultadoConciliacion.AreasConDiferencia == 0 ? "#f0fdf4" : "#fffbeb")}; border: 1px solid {(resultadoConciliacion.AreasConDiferencia == 0 ? "#86efac" : "#fde68a")}; border-radius: 8px;")">
                        <span class="small fw-semibold @(resultadoConciliacion.AreasConDiferencia == 0 ? "text-success" : "text-warning")">Estado por Áreas</span>
                        <div class="fs-6 fw-bold @(resultadoConciliacion.AreasConDiferencia == 0 ? "text-success" : "text-warning")">
                            @resultadoConciliacion.AreasCoincidentes coincidentes / @resultadoConciliacion.AreasConDiferencia con dif.
                        </div>
                        <div class="small text-muted" style="font-size: 11px;">@resultadoConciliacion.ConsolidadoAreaPuesto.Count grupos evaluados</div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@* --- CUERPO PRINCIPAL --- *@
@if (!TieneConciliacion)
{
    <TablaMarcadasxFacturar PayLoadList="@PayLoadList"
                            OperacionName="@nombreOperacion"
                            OperacionId="@operacion"
                            OnValidationChanged="HandleValidationChange" 
                            OnRefreshData="GetAllMarcadasFacturar" />
}
else
{
    <MudTabs @bind-ActivePanelIndex="activeTabIndex" Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Default">
        @* PESTAÑA 0: CONSOLIDADO POR ÁREA *@
        <MudTabPanel Text="@($"CONSOLIDADO POR ÁREA ({(modoVistaConsolidado == "AreaPuesto" ? resultadoConciliacion.ConsolidadoAreaPuesto.Count : resultadoConciliacion.ConsolidadoSoloArea.Count)})")" Icon="@Icons.Material.Filled.TableChart">
            <MudPaper Elevation="0" Class="pa-3 mb-2 d-flex align-center justify-between flex-wrap gap-2" Style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
                <div class="d-flex align-center gap-2">
                    <span class="small fw-bold text-secondary">Vista de Agrupación:</span>
                    <MudSelect T="string" @bind-Value="modoVistaConsolidado" Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Style="min-width: 200px; background-color: white;">
                        <MudSelectItem Value="@("AreaPuesto")">Por Área y Puesto</MudSelectItem>
                        <MudSelectItem Value="@("SoloArea")">Solo por Área (Consolidado Bodega)</MudSelectItem>
                    </MudSelect>
                </div>
                <div style="min-width: 260px;">
                    <MudTextField @bind-Value="_searchConsolidado" Placeholder="Buscar área o puesto..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                </div>
            </MudPaper>

            @if (modoVistaConsolidado == "AreaPuesto")
            {
                <MudDataGrid Items="@resultadoConciliacion.ConsolidadoAreaPuesto" Dense="true" Hover="true" Striped="true"
                             RowsPerPage="15" QuickFilter="@_filterConsolidadoAreaPuesto">
                    <Columns>
                        <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 40px;" />
                        <PropertyColumn Property="x => x.Area" Title="Área / Bodega" />
                        <PropertyColumn Property="x => x.Puesto" Title="Puesto / Cargo" />
                        
                        @* Turnos *@
                        <PropertyColumn Property="x => x.TurnosBussersa" Title="Turnos Buss." HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <PropertyColumn Property="x => x.TurnosCliente" Title="Turnos Sinsa" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <TemplateColumn Title="Dif. Turnos" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(context.Item.DiferenciaTurnos == 0 ? "text-muted" : "fw-bold text-danger")">
                                    @(context.Item.DiferenciaTurnos == 0 ? "0" : context.Item.DiferenciaTurnos.ToString("+0;-0;0"))
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Horas Ordinarias *@
                        <PropertyColumn Property="x => x.HorasOrdBussersa" Title="Ord Buss." Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <PropertyColumn Property="x => x.HorasOrdCliente" Title="Ord Sinsa" Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <TemplateColumn Title="Dif. Ord" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(Math.Abs(context.Item.DiferenciaHorasOrd) < 0.01m ? "text-success fw-semibold" : "text-danger fw-bold")">
                                    @context.Item.DiferenciaHorasOrd.ToString("+0.00;-0.00;0.00")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Horas Extras *@
                        <PropertyColumn Property="x => x.HorasExtBussersa" Title="Ext Buss." Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <PropertyColumn Property="x => x.HorasExtCliente" Title="Ext Sinsa" Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <TemplateColumn Title="Dif. Ext" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(Math.Abs(context.Item.DiferenciaHorasExt) < 0.01m ? "text-success fw-semibold" : "text-danger fw-bold")">
                                    @context.Item.DiferenciaHorasExt.ToString("+0.00;-0.00;0.00")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Total Horas *@
                        <TemplateColumn Title="Total Buss." HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="fw-bold text-primary">@context.Item.TotalHorasBussersa.ToString("N2")</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Total Sinsa" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="fw-bold text-dark">@context.Item.TotalHorasCliente.ToString("N2")</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Dif. Total" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(Math.Abs(context.Item.DiferenciaTotalHoras) < 0.01m ? "text-success fw-bold" : "badge bg-danger text-white fw-bold px-2 py-1")">
                                    @context.Item.DiferenciaTotalHoras.ToString("+0.00;-0.00;0.00")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Estado *@
                        <TemplateColumn Title="Estado" HeaderStyle="width: 100px; text-align: center;" CellStyle="text-align: center;">
                            <CellTemplate>
                                @if (context.Item.Coincide)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold">
                                        COINCIDE
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold">
                                        DIFERENCIA
                                    </MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent><MudDataGridPager T="ConsolidadoAreaPuestoDto" /></PagerContent>
                </MudDataGrid>
            }
            else
            {
                <MudDataGrid Items="@resultadoConciliacion.ConsolidadoSoloArea" Dense="true" Hover="true" Striped="true"
                             RowsPerPage="15" QuickFilter="@_filterConsolidadoSoloArea">
                    <Columns>
                        <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 40px;" />
                        <PropertyColumn Property="x => x.Area" Title="Área / Bodega" />
                        
                        @* Turnos *@
                        <PropertyColumn Property="x => x.TurnosBussersa" Title="Turnos Buss." HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <PropertyColumn Property="x => x.TurnosCliente" Title="Turnos Sinsa" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <TemplateColumn Title="Dif. Turnos" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(context.Item.DiferenciaTurnos == 0 ? "text-muted" : "fw-bold text-danger")">
                                    @(context.Item.DiferenciaTurnos == 0 ? "0" : context.Item.DiferenciaTurnos.ToString("+0;-0;0"))
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Horas Ordinarias *@
                        <PropertyColumn Property="x => x.HorasOrdBussersa" Title="Ord Buss." Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <PropertyColumn Property="x => x.HorasOrdCliente" Title="Ord Sinsa" Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <TemplateColumn Title="Dif. Ord" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(Math.Abs(context.Item.DiferenciaHorasOrd) < 0.01m ? "text-success fw-semibold" : "text-danger fw-bold")">
                                    @context.Item.DiferenciaHorasOrd.ToString("+0.00;-0.00;0.00")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Horas Extras *@
                        <PropertyColumn Property="x => x.HorasExtBussersa" Title="Ext Buss." Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <PropertyColumn Property="x => x.HorasExtCliente" Title="Ext Sinsa" Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                        <TemplateColumn Title="Dif. Ext" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(Math.Abs(context.Item.DiferenciaHorasExt) < 0.01m ? "text-success fw-semibold" : "text-danger fw-bold")">
                                    @context.Item.DiferenciaHorasExt.ToString("+0.00;-0.00;0.00")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Total Horas *@
                        <TemplateColumn Title="Total Buss." HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="fw-bold text-primary">@context.Item.TotalHorasBussersa.ToString("N2")</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Total Sinsa" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="fw-bold text-dark">@context.Item.TotalHorasCliente.ToString("N2")</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Dif. Total" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>
                                <span class="@(Math.Abs(context.Item.DiferenciaTotalHoras) < 0.01m ? "text-success fw-bold" : "badge bg-danger text-white fw-bold px-2 py-1")">
                                    @context.Item.DiferenciaTotalHoras.ToString("+0.00;-0.00;0.00")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Estado *@
                        <TemplateColumn Title="Estado" HeaderStyle="width: 100px; text-align: center;" CellStyle="text-align: center;">
                            <CellTemplate>
                                @if (context.Item.Coincide)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold">
                                        COINCIDE
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold">
                                        DIFERENCIA
                                    </MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent><MudDataGridPager T="ConsolidadoSoloAreaDto" /></PagerContent>
                </MudDataGrid>
            }
        </MudTabPanel>

        @* PESTAÑA 1: DETALLE POR COLABORADOR *@
        <MudTabPanel Text="@($"DETALLE POR COLABORADOR ({resultadoConciliacion.TurnosFaltantes.Count + resultadoConciliacion.RegistrosSoloCliente.Count + resultadoConciliacion.DiferenciasDiasComunes.Count})")" Icon="@Icons.Material.Filled.PeopleAlt">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Secondary" Class="mt-2">
                @* SUB-TAB 0: TURNOS EN BUSSERSA OMITIDOS POR EL CLIENTE *@
                <MudTabPanel Text="@($"Faltantes en Sinsa ({resultadoConciliacion.TurnosFaltantes.Count})")" Icon="@Icons.Material.Filled.Warning">
                    <MudDataGrid Items="@resultadoConciliacion.TurnosFaltantes" Dense="true" Hover="true" Striped="true"
                                 RowsPerPage="10" QuickFilter="@_filterFaltante">
                        <ToolBarContent>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold text-danger">Turnos Registrados en Bussersa pero Omitidos en el Archivo de Sinsa</MudText>
                            <MudSpacer />
                            <MudTextField @bind-Value="_searchFaltante" Placeholder="Buscar faltante..." Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        </ToolBarContent>
                        <Columns>
                            <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 40px;" />
                            <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                            <PropertyColumn Property="x => x.DiaSemana" Title="Día" />
                            <PropertyColumn Property="x => x.NombreEmpleado" Title="Colaborador" />
                            <PropertyColumn Property="x => x.Area" Title="Área" />
                            <PropertyColumn Property="x => x.Cargo" Title="Cargo" />
                            <PropertyColumn Property="x => x.Turno" Title="Turno" />
                            <TemplateColumn Title="H. Ord" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate><span class="fw-bold text-primary">@context.Item.HorasOrdCobrables.ToString("N2")</span></CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="H. Ext" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate><span class="fw-bold text-success">@context.Item.HorasExtCobrables.ToString("N2")</span></CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Total Horas" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate><span class="badge bg-danger text-white fw-bold px-2 py-1">@context.Item.TotalHorasCobrables.ToString("N2")h</span></CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.MotivoJustificacion" Title="Observación" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="TurnoFaltanteClienteDto" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>

                @* SUB-TAB 1: SOLO EN SINSA (NO EN BUSSERSA) *@
                <MudTabPanel Text="@($"Solo en Sinsa ({resultadoConciliacion.RegistrosSoloCliente.Count})")" Icon="@Icons.Material.Filled.HelpOutline">
                    <MudDataGrid Items="@resultadoConciliacion.RegistrosSoloCliente" Dense="true" Hover="true" Striped="true"
                                 RowsPerPage="10" QuickFilter="@_filterSoloCliente">
                        <ToolBarContent>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold text-secondary">Registros en el Archivo de Sinsa No Encontrados en Movimientos de Bussersa</MudText>
                            <MudSpacer />
                            <MudTextField @bind-Value="_searchSoloCliente" Placeholder="Buscar en cliente..." Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        </ToolBarContent>
                        <Columns>
                            <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 40px;" />
                            <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                            <PropertyColumn Property="x => x.NombreEmpleado" Title="Nombre en Sinsa" />
                            <PropertyColumn Property="x => x.Bodega" Title="Bodega" />
                            <PropertyColumn Property="x => x.Puesto" Title="Puesto" />
                            <TemplateColumn Title="H. Ord" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate><span class="fw-bold text-primary">@context.Item.HorasOrd.ToString("N2")</span></CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="H. Ext" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate><span class="fw-bold text-success">@context.Item.HorasExt.ToString("N2")</span></CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Total Horas" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate><span class="fw-bold text-dark">@context.Item.TotalHoras.ToString("N2")h</span></CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Diagnostico" Title="Diagnóstico" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="RegistroSoloClienteDto" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>

                @* SUB-TAB 2: DIFERENCIAS DE HORAS EN MISMO DÍA *@
                <MudTabPanel Text="@($"Diferencias de Horas ({resultadoConciliacion.DiferenciasDiasComunes.Count})")" Icon="@Icons.Material.Filled.CompareArrows">
                    <MudDataGrid Items="@resultadoConciliacion.DiferenciasDiasComunes" Dense="true" Hover="true" Striped="true"
                                 RowsPerPage="10" QuickFilter="@_filterDiferencia">
                        <ToolBarContent>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold text-warning">Colaboradores Presentes en Ambos pero con Diferencias en Horas</MudText>
                            <MudSpacer />
                            <MudTextField @bind-Value="_searchDiferencia" Placeholder="Buscar diferencia..." Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                        </ToolBarContent>
                        <Columns>
                            <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 40px;" />
                            <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                            <PropertyColumn Property="x => x.NombreEmpleado" Title="Colaborador" />
                            <PropertyColumn Property="x => x.AreaBussersa" Title="Área Bussersa" />
                            <PropertyColumn Property="x => x.BodegaCliente" Title="Bodega Sinsa" />
                            <PropertyColumn Property="x => x.Cargo" Title="Puesto" />
                            <PropertyColumn Property="x => x.HorasOrdBussersa" Title="Ord Buss." Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                            <PropertyColumn Property="x => x.HorasOrdCliente" Title="Ord Sinsa" Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                            <TemplateColumn Title="Dif. Ord" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate>
                                    <span class="@(Math.Abs(context.Item.DiferenciaHorasOrd) < 0.01m ? "text-success" : "text-danger fw-bold")">
                                        @context.Item.DiferenciaHorasOrd.ToString("+0.00;-0.00;0.00")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.HorasExtBussersa" Title="Ext Buss." Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                            <PropertyColumn Property="x => x.HorasExtCliente" Title="Ext Sinsa" Format="N2" HeaderStyle="text-align: right;" CellStyle="text-align: right;" />
                            <TemplateColumn Title="Dif. Ext" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate>
                                    <span class="@(Math.Abs(context.Item.DiferenciaHorasExt) < 0.01m ? "text-success" : "text-danger fw-bold")">
                                        @context.Item.DiferenciaHorasExt.ToString("+0.00;-0.00;0.00")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Dif. Total" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate>
                                    <span class="badge bg-warning text-dark fw-bold px-2 py-1">@context.Item.DiferenciaHoras.ToString("+0.00;-0.00;0.00")h</span>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="DiferenciaDiaComunDto" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
            </MudTabs>
        </MudTabPanel>

        @* PESTAÑA 2: MARCADAS POR FACTURAR (ORIGINAL) *@
        <MudTabPanel Text="@($"MARCADAS POR FACTURAR ({PayLoadList.Count})")" Icon="@Icons.Material.Filled.ListAlt">
            <TablaMarcadasxFacturar PayLoadList="@PayLoadList"
                                    OperacionName="@nombreOperacion"
                                    OperacionId="@operacion"
                                    OnValidationChanged="HandleValidationChange" 
                                    OnRefreshData="GetAllMarcadasFacturar" />
        </MudTabPanel>
    </MudTabs>
}
