@using Modelo.Entidades.Entradas.Odoo

<MudOverlay Visible="isloading" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Generando reporte Excel...</MudText>
    </div>
</MudOverlay>

@if (PayLoadList != null && PayLoadList.Any())
{
    <MudPaper Elevation="0" Class="pa-4 mb-3" Style="background-color: #f1f5f9; border-radius: 12px;">
        <MudGrid Justify="Justify.Center">
            <MudItem xs="6" sm="3">
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" ContentAlignment="HorizontalAlignment.Center">
                    OK: @PayLoadList.Count(x => x.estado_calculado == "OK")
                </MudAlert>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" ContentAlignment="HorizontalAlignment.Center">
                    ALERTAS: @PayLoadList.Count(x => x.estado_calculado == "S. MOV" || x.estado_calculado == "S. MARC" || x.estado_calculado == "DESBORDE")
                </MudAlert>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" ContentAlignment="HorizontalAlignment.Center">
                    CRUCES: @PayLoadList.Count(x => x.estado_calculado == "CRUCE")
                </MudAlert>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" ContentAlignment="HorizontalAlignment.Center">
                    DUPLICADOS: @PayLoadList.Count(x => x.estado_calculado == "DUPLICADO")
                </MudAlert>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

<MudDataGrid T="DiasTrabajadosAreas" Items="@PayLoadList" SortMode="MudBlazor.SortMode.Multiple" Filterable="true"
             QuickFilter="@_quickFilter" Dense="true" Elevation="0" RowsPerPage="15">
    <ToolBarContent>
        <MudButton Variant="MudBlazor.Variant.Filled"
                   Color="MudBlazor.Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Analytics"
                   OnClick="@DownloadFile"
                   Class="rounded-pill px-6">
            EXPORTAR ANÁLISIS
        </MudButton>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar empleado, id o estado..."
                      Adornment="MudBlazor.Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="MudBlazor.Size.Medium"
                      Class="mt-0"
                      Immediate="true" />
    </ToolBarContent>
    <Columns>   
        <PropertyColumn Property="x => x.estado_calculado" Title="Estado" Sortable="true" Filterable="true"
                        HeaderStyle="width: 100px;" Style="width: 100px;">
            <CellTemplate>
                @{
                    var status = ObtenerEstadoRegistro(context.Item);
                }
                <MudTooltip Text="@status.Mensaje">
                    <MudChip T="string" Variant="MudBlazor.Variant.Text" Color="@status.Color" Size="MudBlazor.Size.Small" Icon="@status.Icono">
                        @context.Item.estado_calculado
                     </MudChip>
                </MudTooltip>
            </CellTemplate>
        </PropertyColumn>

        <TemplateColumn Title="Verif." Size="Size.Small" StickyLeft="true"
                        HeaderStyle="width: 60px;" Style="width: 60px;">
            <CellTemplate>
                <div class="d-flex justify-center">
                    @if (context.Item.cierre)
                    {
                        <MudTooltip Text="Registro Cerrado / Verificado">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Pendiente de Verificación">
                            <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Default" Size="Size.Medium" Style="opacity:0.4" />
                        </MudTooltip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.id" Title="Id" HeaderStyle="width: 80px;" Style="width: 80px;">
            <CellTemplate>
                <MudLink Typo="Typo.body2" Underline="Underline.Hover" Color="Color.Info" Class="cursor-pointer font-bold"
                         OnClick="@(() => MostrarDetalle(context.Item))">
                    @context.Item.id
                </MudLink>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.nombre" Title="Empleado" />
        <PropertyColumn Property="x => x.tarea" Title="Tarea" />
        <PropertyColumn Property="x => x.areamov" Title="Area" />
        <PropertyColumn Property="x => x.entrada" Title="Entrada" />
        <PropertyColumn Property="x => x.salida" Title="Salida" />    
    </Columns>
    <PagerContent>
        <MudDataGridPager T="DiasTrabajadosAreas" />
    </PagerContent>
</MudDataGrid>