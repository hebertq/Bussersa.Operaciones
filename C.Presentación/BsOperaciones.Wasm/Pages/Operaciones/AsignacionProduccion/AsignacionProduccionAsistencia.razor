@page "/operaciones/asistencia-produccion"
@using MudBlazor
@using Modelo.Entidades.Operaciones
@using Modelo.ClasesGenericas

<MudOverlay Visible="estaCargando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Color="Color.Surface" Class="mt-3">@mensajeCarga</MudText>
    </div>
</MudOverlay>

<div class="d-flex align-center justify-space-between mb-3">
    <div>
        <MudText Typo="Typo.h5" Class="fw-bold" Color="Color.Primary">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Class="mr-2" />
            ASIGNACIÓN DE ASISTENCIA A PRODUCCIÓN Y VARIANTES
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Conversión de asistencia biométrica cerrada a servicios facturables Odoo, sellado de lotes y auditoría de fugas por movimientos de personal.
        </MudText>
    </div>
</div>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" KeepPanelsAlive="true" Color="Color.Primary">

    @* ==========================================
       PESTAÑA 1: GENERACIÓN SEMANAL Y SELLADO
       ========================================== *@
    <MudTabPanel Text="Generación Semanal y Sellado" Icon="@Icons.Material.Filled.CalendarViewWeek">
        @* Panel de Filtros *@
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" sm="12" md="3">
                    <MudSelect T="int" Label="Operación / Cliente" @bind-Value="operacionId"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="0">Seleccione un cliente configurado...</MudSelectItem>
                        @foreach (var op in OperacionesConfiguradas)
                        {
                            <MudSelectItem Value="@op.id">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="12" md="5" Class="d-flex align-center gap-1">
                    <MudTooltip Text="Semana Anterior">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" OnClick="SemanaAnterior" Size="Size.Small" />
                    </MudTooltip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="SemanaActual" Class="px-2">
                        Esta Semana
                    </MudButton>
                    <MudTooltip Text="Semana Siguiente">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" OnClick="SemanaSiguiente" Size="Size.Small" />
                    </MudTooltip>
                    <div class="ml-2">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">
                            @fchaInicioSemana.ToString("dd/MM/yyyy") - @fchaFinSemana.ToString("dd/MM/yyyy")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Semana ISO @numeroSemana del @fchaInicioSemana.Year
                        </MudText>
                    </div>
                </MudItem>

                <MudItem xs="12" sm="6" md="2" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="soloPendientes" Color="Color.Warning" Label="Solo Pendientes" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConsultarSemana" FullWidth="true"
                               Disabled="@(operacionId <= 0 || estaCargando)" StartIcon="@Icons.Material.Filled.Search" Style="height: 40px;">
                        CONSULTAR
                    </MudButton>
                </MudItem>
            </MudGrid>

            @* Fila 2: Filtros de Facturación y Reglas de Negocio *@
            <div class="d-flex align-center justify-between mt-3 pt-3 border-top flex-wrap gap-3">
                <div class="d-flex align-center gap-4 flex-wrap">
                    <div class="d-flex align-center gap-1">
                        <MudCheckBox T="bool" Value="@aplicarReglasCobro" ValueChanged="@((bool val) => { aplicarReglasCobro = val; _ = ConsultarSemana(); })" Color="Color.Success" Dense="true">
                            <span class="fw-bold" style="font-size: 13px;">Reglas de Cobro</span>
                        </MudCheckBox>
                        <MudTooltip Text="Calcula las horas normales y extras según los convenios del cliente (12h Montacarga, Equivalencia Nocturna 7h->8h, Fijo 8h Conductor, etc.) o estándar 8h.">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                        </MudTooltip>
                    </div>

                    <div class="d-flex align-center gap-1">
                        <MudCheckBox T="bool" Value="@excluirSupervisores" ValueChanged="@((bool val) => { excluirSupervisores = val; _ = ConsultarSemana(); })" Color="Color.Error" Dense="true">
                            <span class="fw-bold" style="font-size: 13px;">Excluir Supervisores</span>
                        </MudCheckBox>
                        <MudTooltip Text="Al activar esta opción, las horas de puestos de supervisión se excluyen de la producción para no ser facturadas al cliente.">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                        </MudTooltip>
                    </div>
                </div>

                <div class="d-flex align-center gap-2">
                    @if (aplicarReglasCobro)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">
                            ⚖️ Reglas de Cobro Activas
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                            ⏱️ Marcación Real (Sin Reglas)
                        </MudChip>
                    }

                    @if (excluirSupervisores)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            🚫 Supervisores Excluidos
                        </MudChip>
                    }
                </div>
            </div>
        </MudPaper>

        @* Alerta de Semana Encajonada *@
        @if (EsSemanaEncajonada)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.DateRange">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div>
                        <b>Semana Encajonada (Mes Dividido):</b> Contiene días de 
                        <b>@NombreMesAnterior (@PeriodoMesAnteriorTexto)</b> y <b>@NombreMesActual (@PeriodoMesActualTexto)</b>.
                        Se generaron los ítems separados por corte mensual para asegurar la correcta facturación y cierre contable.
                    </div>
                    <div class="d-flex gap-2">
                        <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Filled">
                            @NombreMesAnterior: @TotalHorasMesAnterior.ToString("N2") h ($ @TotalMontoMesAnterior.ToString("N2"))
                        </MudChip>
                        <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Filled">
                            @NombreMesActual: @TotalHorasMesActual.ToString("N2") h ($ @TotalMontoMesActual.ToString("N2"))
                        </MudChip>
                    </div>
                </div>
            </MudAlert>
        }

        @* Tarjetas KPI *@
        @if (grillaProduccion != null && grillaProduccion.Any())
        {
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3 d-flex align-center justify-space-between" Style="background-color: #e0f2fe; border-left: 5px solid #0284c7; border-radius: 8px;">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">HORAS ORDINARIAS</MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #0369a1;">@TotalHorasOrdinarias.ToString("N2") h</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Large" Style="color: #0284c7;" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3 d-flex align-center justify-space-between" Style="background-color: #ffedd5; border-left: 5px solid #f97316; border-radius: 8px;">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">HORAS EXTRAS</MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #c2410c;">@TotalHorasExtras.ToString("N2") h</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.MoreTime" Size="Size.Large" Style="color: #f97316;" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3 d-flex align-center justify-space-between" Style="background-color: #f3e8ff; border-left: 5px solid #9333ea; border-radius: 8px;">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL FACTURABLE</MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #7e22ce;">@TotalHorasFacturables.ToString("N2") h</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Large" Style="color: #9333ea;" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3 d-flex align-center justify-space-between" Style="background-color: #dcfce7; border-left: 5px solid #16a34a; border-radius: 8px;">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">MONTO VENTA ESTIMADO</MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #15803d;">$ @TotalMontoVenta.ToString("N2")</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Style="color: #16a34a;" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

        @* Barra de Acciones *@
        <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">
                    Resumen Consolidado de Producción
                </MudText>
                @if (grillaProduccion != null)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@GrillaFiltrada.Count() líneas</MudChip>
                }

                @if (EsSemanaEncajonada)
                {
                    <div class="d-flex align-center gap-1 ml-2">
                        <MudChip T="string" Color="@(filtroPeriodoCorte == "TODOS" ? Color.Primary : Color.Default)"
                                 Variant="@(filtroPeriodoCorte == "TODOS" ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => { filtroPeriodoCorte = "TODOS"; StateHasChanged(); })" Size="Size.Small">
                            Todos (@grillaProduccion.Count)
                        </MudChip>
                        <MudChip T="string" Color="@(filtroPeriodoCorte == "MES_ANTERIOR" ? Color.Warning : Color.Default)"
                                 Variant="@(filtroPeriodoCorte == "MES_ANTERIOR" ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => { filtroPeriodoCorte = "MES_ANTERIOR"; StateHasChanged(); })" Size="Size.Small">
                            @NombreMesAnterior (@PeriodoMesAnteriorTexto)
                        </MudChip>
                        <MudChip T="string" Color="@(filtroPeriodoCorte == "MES_ACTUAL" ? Color.Info : Color.Default)"
                                 Variant="@(filtroPeriodoCorte == "MES_ACTUAL" ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => { filtroPeriodoCorte = "MES_ACTUAL"; StateHasChanged(); })" Size="Size.Small">
                            @NombreMesActual (@PeriodoMesActualTexto)
                        </MudChip>
                    </div>
                }
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CloudUpload"
                           OnClick="IngresarProduccionDiariaDirecto" Disabled="@(grillaProduccion == null || !grillaProduccion.Any())">
                    Ingresar a Producción
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportarExcel" Disabled="@(grillaProduccion == null || !grillaProduccion.Any())">
                    Exportar Excel
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Lock"
                           OnClick="AbrirModalSellarLote" Disabled="@(marcadasList == null || !marcadasList.Any(m => m.IsSelected && !m.asignado_produccion))">
                    Sellar Lote (@(marcadasList?.Count(m => m.IsSelected && !m.asignado_produccion) ?? 0))
                </MudButton>
            </div>
        </div>

        @* Tabla 1: Grilla de Producción Semanal Segregada *@
        <MudTable Items="@GrillaFiltrada" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="1" Class="mb-4">
            <HeaderContent>
                <MudTh>Corte / Período</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Área</MudTh>
                <MudTh>Cargo / Puesto</MudTh>
                <MudTh>Turno</MudTh>
                <MudTh>Tipo Hora</MudTh>
                <MudTh>SKU Odoo</MudTh>
                <MudTh>Descripción de Servicio</MudTh>
                <MudTh Style="text-align: right;">Tarifa ($)</MudTh>
                <MudTh Style="text-align: right;">Horas</MudTh>
                <MudTh Style="text-align: right;">Total Venta ($)</MudTh>
                <MudTh Style="text-align: center;">Empleados</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Corte">
                    @if (context.es_mes_anterior)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">
                            📅 @context.periodo_mes
                        </MudChip>
                    }
                    else if (EsSemanaEncajonada)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">
                            📅 @context.periodo_mes
                        </MudChip>
                    }
                    else
                    {
                        <span style="font-size: 11px; color: #64748b;">@context.periodo_mes</span>
                    }
                </MudTd>
                <MudTd DataLabel="Cliente">@context.cliente_nombre</MudTd>
                <MudTd DataLabel="Área">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.area_cliente</MudChip>
                </MudTd>
                <MudTd DataLabel="Cargo"><b>@context.cargo</b></MudTd>
                <MudTd DataLabel="Turno">
                    @if (context.turno == "Diurno")
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">☀️ Diurno</MudChip>
                    }
                    else if (context.turno == "Nocturno")
                    {
                        <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold text-white" Style="font-size: 11px; background-color: #34495e;">🌙 Nocturno</MudChip>
                    }
                    else if (context.turno == "Mixto")
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">⚖️ Mixto</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text" Style="font-size: 11px;">@context.turno</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Tipo Hora">
                    <MudChip T="string" Size="Size.Small" Color="@(context.tipo_hora == "EXTRA" ? Color.Warning : Color.Primary)">
                        @context.tipo_hora
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="SKU">
                    <code>@context.servicio_codigo</code>
                </MudTd>
                <MudTd DataLabel="Descripción">@context.servicio_descripcion</MudTd>
                <MudTd DataLabel="Tarifa" Style="text-align: right;">$ @context.tarifa_venta.ToString("N2")</MudTd>
                <MudTd DataLabel="Horas" Style="text-align: right;"><b>@context.cantidad_horas.ToString("N2")</b></MudTd>
                <MudTd DataLabel="Total Venta" Style="text-align: right; font-weight: bold; color: #16a34a;">
                    $ @context.subtotal_facturable.ToString("N2")
                </MudTd>
                <MudTd DataLabel="Empleados" Style="text-align: center;">@context.cantidad_empleados</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTh Class="fw-bold" colspan="9">TOTALES SEMANA</MudTh>
                <MudTh Class="fw-bold" Style="text-align: right;">@TotalHorasFacturables.ToString("N2") h</MudTh>
                <MudTh Class="fw-bold" Style="text-align: right; color: #16a34a;">$ @TotalMontoVenta.ToString("N2")</MudTh>
                <MudTh></MudTh>
            </FooterContent>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4 text-center">
                    No se encontraron horas registradas para esta semana o no se han configurado reglas en el catálogo.
                </MudText>
            </NoRecordsContent>
        </MudTable>

        @* Sección: Detalle de Marcadas por Empleado *@
        <MudExpansionPanels MultiExpansion="true" Elevation="1" Class="mt-4">
            <MudExpansionPanel Text="@($"Detalle Individual de Asistencias ({marcadasList.Count} registros - {(marcadasList.Count(m => !m.asignado_produccion))} pendientes)")" Expanded="true">
                <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SeleccionarTodasMarcadas" StartIcon="@Icons.Material.Filled.SelectAll">
                            Seleccionar Pendientes
                        </MudButton>
                        @if (EsSemanaEncajonada)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" OnClick="SeleccionarMarcadasMesAnterior">
                                Sel. @NombreMesAnterior
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" OnClick="SeleccionarMarcadasMesActual">
                                Sel. @NombreMesActual
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="DeseleccionarTodasMarcadas" StartIcon="@Icons.Material.Filled.Deselect">
                            Deseleccionar Todo
                        </MudButton>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @marcadasList.Count(m => m.IsSelected) marcadas seleccionadas
                        </MudText>
                    </div>
                    <MudTextField @bind-Value="filtroDetalle" Placeholder="Buscar empleado, cargo o área..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Style="max-width: 300px;" />
                </div>

                <MudTable Items="@MarcadasFiltradas" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="width: 50px; text-align: center;">Sel</MudTh>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Empleado</MudTh>
                        <MudTh>Cargo</MudTh>
                        <MudTh>Área</MudTh>
                        <MudTh>Turno</MudTh>
                        <MudTh Style="text-align: right;">Horas Ord</MudTh>
                        <MudTh Style="text-align: right;">Horas Ext</MudTh>
                        <MudTh Style="text-align: right;">Total Horas</MudTh>
                        <MudTh>Estado Asignación</MudTh>
                        <MudTh>Lote / N° Asignación</MudTh>
                        <MudTh Style="text-align: center;">Regla</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="text-align: center;">
                            @if (!context.asignado_produccion)
                            {
                                <MudCheckBox T="bool" @bind-Value="context.IsSelected" Color="Color.Primary" Dense="true" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Fecha">@context.fecha_asistencia.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Empleado">
                            <b>@context.nombre_empleado</b>
                            @if (context.es_supervisor)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="ml-1" Style="font-size: 10px;">SUPERVISOR</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Cargo">@context.cargo</MudTd>
                        <MudTd DataLabel="Área">@context.area_nombre</MudTd>
                        <MudTd DataLabel="Turno">
                            @if (context.turno == "Diurno")
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">☀️ Diurno</MudChip>
                            }
                            else if (context.turno == "Nocturno")
                            {
                                <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold text-white" Style="font-size: 11px; background-color: #34495e;">🌙 Nocturno</MudChip>
                            }
                            else if (context.turno == "Mixto")
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">⚖️ Mixto</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text" Style="font-size: 11px;">@context.turno</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Horas Ord" Style="text-align: right;">@context.horas_ordinarias.ToString("N2")</MudTd>
                        <MudTd DataLabel="Horas Ext" Style="text-align: right;">@context.horas_extras.ToString("N2")</MudTd>
                        <MudTd DataLabel="Total" Style="text-align: right; font-weight: bold;">@context.horas_totales.ToString("N2")</MudTd>
                        <MudTd DataLabel="Estado">
                            @if (context.asignado_produccion)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Lock">ASIGNADO</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.HourglassEmpty">PENDIENTE</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Lote">
                            @if (!string.IsNullOrWhiteSpace(context.numero_asignacion_produccion))
                            {
                                <code>@context.numero_asignacion_produccion</code>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Regla" Style="text-align: center;">
                            @if (context.tiene_regla_catalogo)
                            {
                                <MudTooltip Text="@($"Regla variante catálogo asignada | Cobro: {context.regla_aplicada}")">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@($"Sin regla de SKU en catálogo | Cobro: {context.regla_aplicada}")">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 15, 30, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudTabPanel>

    @* ==========================================
       PESTAÑA 2: CATÁLOGO DE VARIANTES POR PUESTO Y ÁREA
       ========================================== *@
    <MudTabPanel Text="Catálogo de Variantes y Tarifas" Icon="@Icons.Material.Filled.Rule">

        @* Encabezado y Acción *@
        <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold text-dark d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" Size="Size.Medium" />
                    Reglas de Facturación y Tarifas por Puesto / Área
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Asocie cada combinación de puesto, área y jornada al código de servicio Odoo correspondiente para la emisión de proformas.
                </MudText>
            </div>
            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AbrirModalNuevaRegla" Style="border-radius: 8px; font-weight: 600; text-transform: none;">
                    Nueva Regla de Tarifa
                </MudButton>
            </div>
        </div>

        @* Barra de Filtros Unificada y Elegante *@
        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
            <MudGrid Spacing="2" Class="align-center">
                @* 1. Selector de Cliente *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int" Label="Cliente / Operación" Value="catalogoClienteId"
                               ValueChanged="OnCatalogoClienteChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Business"
                               Style="background-color: #ffffff; border-radius: 8px;">
                        <MudSelectItem Value="0">Todas las operaciones configuradas...</MudSelectItem>
                        @foreach (var op in OperacionesConfiguradas)
                        {
                            <MudSelectItem Value="@op.id">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* 2. Filtro de Área *@
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="string" Label="Área" Value="@filtroCatalogoArea" ValueChanged="OnFiltroAreaChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Apartment"
                               Style="background-color: #ffffff; border-radius: 8px;">
                        <MudSelectItem Value="@("")">Todas las áreas (*)</MudSelectItem>
                        @foreach (var area in DistinctAreasCatalogo)
                        {
                            <MudSelectItem Value="@area">@area</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* 3. Filtro de Cargo / Puesto *@
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="string" Label="Cargo / Puesto" Value="@filtroCatalogoCargo" ValueChanged="OnFiltroCargoChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge"
                               Style="background-color: #ffffff; border-radius: 8px;">
                        <MudSelectItem Value="@("")">Todos los puestos</MudSelectItem>
                        @foreach (var cargo in DistinctCargosCatalogo)
                        {
                            <MudSelectItem Value="@cargo">@cargo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* 4. Filtro de Tipo de Hora *@
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="string" Label="Tipo de Hora" Value="@filtroCatalogoTipoHora" ValueChanged="OnFiltroTipoHoraChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Schedule"
                               Style="background-color: #ffffff; border-radius: 8px;">
                        <MudSelectItem Value="@("")">Todos los tipos</MudSelectItem>
                        @foreach (var tipo in DistinctTiposHoraCatalogo)
                        {
                            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* 5. Buscador de Texto (SKU / Servicio) *@
                <MudItem xs="12" sm="12" md="3">
                    <MudTextField @bind-Value="filtroCatalogoTexto"
                                  Placeholder="Buscar SKU o servicio..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Small" Margin="Margin.Dense" Variant="Variant.Outlined"
                                  Immediate="true" Clearable="true"
                                  TextChanged="@((string val) => { filtroCatalogoTexto = val; FiltrarCatalogo(); })"
                                  Style="background-color: #ffffff; border-radius: 8px;" />
                </MudItem>
            </MudGrid>

            @* Sub-barra de Resumen y Filtros Activos *@
            <div class="d-flex align-center justify-space-between mt-2 pt-2 border-top flex-wrap gap-2" style="font-size: 0.82rem;">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <span class="text-secondary fw-semibold">
                        @if (HayFiltrosActivosCatalogo)
                        {
                            <span>Mostrando <b class="text-primary">@catalogoList.Count</b> de <b>@TotalReglasCliente</b> reglas</span>
                        }
                        else
                        {
                            <span>Total: <b class="text-primary">@catalogoList.Count</b> reglas configuradas @(catalogoClienteId > 0 ? $"({OperacionesConfiguradas.FirstOrDefault(o => o.id == catalogoClienteId)?.nombre})" : "")</span>
                        }
                    </span>

                    @if (!string.IsNullOrWhiteSpace(filtroCatalogoArea))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                 OnClose="@(() => OnFiltroAreaChanged(""))" Class="ma-0" Style="height: 22px; font-size: 11px;">
                            Área: @filtroCatalogoArea
                        </MudChip>
                    }
                    @if (!string.IsNullOrWhiteSpace(filtroCatalogoCargo))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                 OnClose="@(() => OnFiltroCargoChanged(""))" Class="ma-0" Style="height: 22px; font-size: 11px;">
                            Puesto: @filtroCatalogoCargo
                        </MudChip>
                    }
                    @if (!string.IsNullOrWhiteSpace(filtroCatalogoTipoHora))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                 OnClose="@(() => OnFiltroTipoHoraChanged(""))" Class="ma-0" Style="height: 22px; font-size: 11px;">
                            Tipo: @filtroCatalogoTipoHora
                        </MudChip>
                    }
                    @if (!string.IsNullOrWhiteSpace(filtroCatalogoTexto))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                 OnClose="@(() => { filtroCatalogoTexto = ""; FiltrarCatalogo(); })" Class="ma-0" Style="height: 22px; font-size: 11px;">
                            Texto: "@filtroCatalogoTexto"
                        </MudChip>
                    }
                </div>

                @if (HayFiltrosActivosCatalogo)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="LimpiarFiltrosCatalogo" Style="text-transform: none; font-size: 12px; font-weight: 600;">
                        Limpiar todos los filtros
                    </MudButton>
                }
            </div>
        </MudPaper>

        @* Grilla de Datos Moderna y Compacta *@
        <MudTable Items="@catalogoList" Dense="true" Hover="true" Bordered="false" Striped="true" Elevation="0"
                  Style="border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background-color: #ffffff;">
            <HeaderContent>
                @if (catalogoClienteId == 0)
                {
                    <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px;">Cliente</MudTh>
                }
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px;">Área</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px;">Cargo / Puesto</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px; text-align: center;">Turno</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px;">Tipo Hora</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px; min-width: 140px;">SKU Odoo</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px;">Descripción de Servicio Odoo</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px; text-align: center;">UoM</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px; text-align: right;">Tarifa ($)</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px; text-align: center;">Estado</MudTh>
                <MudTh Style="background-color: #f1f5f9; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px 14px; text-align: center; min-width: 90px;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (catalogoClienteId == 0)
                {
                    <MudTd DataLabel="Cliente">
                        <span class="fw-semibold text-dark" style="font-size: 0.82rem;">@context.cliente_nombre</span>
                    </MudTd>
                }
                <MudTd DataLabel="Área">
                    @if (context.area_nombre == "*")
                    {
                        <span class="text-secondary" style="font-size: 0.8rem; font-style: italic;">Todas (*)</span>
                    }
                    else
                    {
                        <span style="background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; font-size: 0.76rem; font-weight: 600; padding: 2px 8px; border-radius: 6px; display: inline-block;">
                            @context.area_nombre
                        </span>
                    }
                </MudTd>
                <MudTd DataLabel="Cargo">
                    <span style="font-weight: 600; color: #0f172a; font-size: 0.85rem;">@context.cargo</span>
                </MudTd>
                <MudTd DataLabel="Turno" Style="text-align: center;">
                    @if (context.turno == "Diurno")
                    {
                        <span style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.74rem; font-weight: 600; padding: 2px 7px; border-radius: 9999px; display: inline-block;">☀️ Diurno</span>
                    }
                    else if (context.turno == "Nocturno")
                    {
                        <span style="background-color: #1e293b; color: #f8fafc; font-size: 0.74rem; font-weight: 600; padding: 2px 7px; border-radius: 9999px; display: inline-block;">🌙 Nocturno</span>
                    }
                    else if (context.turno == "Mixto")
                    {
                        <span style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-size: 0.74rem; font-weight: 600; padding: 2px 7px; border-radius: 9999px; display: inline-block;">⚖️ Mixto</span>
                    }
                    else
                    {
                        <span class="text-secondary" style="font-size: 0.78rem;">@context.turno</span>
                    }
                </MudTd>
                <MudTd DataLabel="Tipo Hora">
                    @if (context.tipo_hora == "ORDINARIA")
                    {
                        <span style="background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-size: 0.74rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; display: inline-block;">
                            ORDINARIA
                        </span>
                    }
                    else if (context.tipo_hora == "EXTRA")
                    {
                        <span style="background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-size: 0.74rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; display: inline-block;">
                            EXTRA
                        </span>
                    }
                    else if (context.tipo_hora == "DOMINGO_FERIADO")
                    {
                        <span style="background-color: #faf5ff; color: #7e22ce; border: 1px solid #e9d5ff; font-size: 0.74rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; display: inline-block;">
                            DOMINGO / FERIADO
                        </span>
                    }
                    else
                    {
                        <span style="background-color: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; font-size: 0.74rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; display: inline-block;">
                            @context.tipo_hora
                        </span>
                    }
                </MudTd>
                <MudTd DataLabel="SKU">
                    <span style="font-family: Consolas, 'Courier New', monospace; font-size: 0.78rem; font-weight: 600; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px 6px; color: #0f172a; white-space: nowrap; display: inline-block;">
                        @context.servicio_codigo
                    </span>
                </MudTd>
                <MudTd DataLabel="Descripción" Style="max-width: 320px;">
                    <div style="font-size: 0.81rem; color: #334155; line-height: 1.35;">
                        @context.servicio_descripcion
                    </div>
                </MudTd>
                <MudTd DataLabel="UoM" Style="text-align: center;">
                    <span style="font-size: 0.72rem; font-weight: 700; color: #64748b; background-color: #f1f5f9; border: 1px solid #e2e8f0; padding: 2px 6px; border-radius: 4px; display: inline-block;">
                        @context.unidad_medida
                    </span>
                </MudTd>
                <MudTd DataLabel="Tarifa" Style="text-align: right;">
                    <span style="font-weight: 700; color: #059669; font-size: 0.95rem;">
                        $ @context.tarifa_venta.ToString("N2")
                    </span>
                </MudTd>
                <MudTd DataLabel="Estado" Style="text-align: center;">
                    @if (context.activo)
                    {
                        <span style="background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 4px;">
                            <span style="width: 6px; height: 6px; background-color: #10b981; border-radius: 50%; display: inline-block;"></span>
                            Activo
                        </span>
                    }
                    else
                    {
                        <span style="background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 4px;">
                            <span style="width: 6px; height: 6px; background-color: #ef4444; border-radius: 50%; display: inline-block;"></span>
                            Inactivo
                        </span>
                    }
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: center;">
                    <div class="d-inline-flex align-center gap-1">
                        <MudTooltip Text="Editar Regla">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           Style="padding: 4px; background-color: #eff6ff;"
                                           OnClick="@(() => AbrirModalEditarRegla(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar Regla">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                           Style="padding: 4px; background-color: #fef2f2;"
                                           OnClick="@(() => EliminarRegla(context.id))" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.subtitle1" Class="fw-bold text-secondary">No se encontraron reglas con los filtros aplicados</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Pruebe ajustando los filtros o cree una nueva regla de tarifa para este cliente.</MudText>
                    @if (HayFiltrosActivosCatalogo)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="LimpiarFiltrosCatalogo" StartIcon="@Icons.Material.Filled.FilterAltOff">
                            Limpiar Filtros
                        </MudButton>
                    }
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{15, 25, 50, 100}"
                               RowsPerPageString="Reglas por página:"
                               InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </MudTabPanel>

    @* ==========================================
       PESTAÑA 3: TRAZABILIDAD, LOTES E INCIDENCIAS (FUGAS)
       ========================================== *@
    <MudTabPanel Text="Trazabilidad y Fugas" Icon="@Icons.Material.Filled.History">
        <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
            Esta sección audita los lotes asignados y permite detectar <b>fugas de facturación</b> causadas por <b>movimientos de personal o correcciones de asistencia retroactivas</b> que ingresaron al sistema después de haber cerrado la semana.
        </MudAlert>

        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" sm="5">
                    <MudSelect T="int" Label="Operación / Cliente" @bind-Value="historicoClienteId"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="0">Todas las operaciones configuradas...</MudSelectItem>
                        @foreach (var op in OperacionesConfiguradas)
                        {
                            <MudSelectItem Value="@op.id">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect T="int" Label="Año" @bind-Value="historicoAnio" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="2026">2026</MudSelectItem>
                        <MudSelectItem Value="2025">2025</MudSelectItem>
                        <MudSelectItem Value="2024">2024</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarHistorico" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Refresh" Style="height: 40px;">
                        CONSULTAR HISTÓRICO
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable Items="@historicoList" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="1">
            <HeaderContent>
                <MudTh>N° Asignación / Lote</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Rango de Fechas</MudTh>
                <MudTh Style="text-align: center;">Empleados</MudTh>
                <MudTh Style="text-align: right;">Marcadas Asignadas</MudTh>
                <MudTh Style="text-align: right;">Total Horas</MudTh>
                <MudTh>Fecha Asignación</MudTh>
                <MudTh Style="text-align: center;">Fugas / Retroactivos</MudTh>
                <MudTh Style="text-align: center;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Lote">
                    <code>@context.numero_asignacion</code>
                </MudTd>
                <MudTd DataLabel="Cliente">@context.cliente_nombre</MudTd>
                <MudTd DataLabel="Rango">
                    @context.fecha_min.ToString("dd/MM/yyyy") - @context.fecha_max.ToString("dd/MM/yyyy")
                </MudTd>
                <MudTd DataLabel="Empleados" Style="text-align: center;">@context.cantidad_empleados</MudTd>
                <MudTd DataLabel="Marcadas" Style="text-align: right;">@context.total_marcadas</MudTd>
                <MudTd DataLabel="Total Horas" Style="text-align: right; font-weight: bold;">@context.total_horas.ToString("N2") h</MudTd>
                <MudTd DataLabel="Fecha Asignación">
                    @(context.fecha_asignacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                </MudTd>
                <MudTd DataLabel="Fugas" Style="text-align: center;">
                    @if (context.marcadas_pendientes_en_rango > 0)
                    {
                        <MudTooltip Text="Hay marcadas sin cobrar registradas posteriormente para este rango de fecha">
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                                @context.marcadas_pendientes_en_rango pend. (@context.horas_pendientes_en_rango.ToString("N1") h)
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">
                            Al día
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: center;">
                    <div class="d-flex align-center justify-center gap-1">
                        @if (context.marcadas_pendientes_en_rango > 0)
                        {
                            <MudTooltip Text="Cargar semana para facturar horas huérfanas">
                                <MudIconButton Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Small" Color="Color.Warning"
                                               OnClick="@(() => IrAFacturarFugas(context))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Revertir lote (Desasignar horas)">
                            <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DesasignarLote(context.numero_asignacion))" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4 text-center">
                    No hay historial de lotes asignados para este año/cliente.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>

</MudTabs>
