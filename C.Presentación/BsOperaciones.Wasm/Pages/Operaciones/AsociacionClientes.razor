@page "/operaciones/asociacion-clientes"
@using Modelo.Entidades.Operaciones
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@using System.Text.Json
@inject IOdooService _OdooService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<div class="container-fluid p-4" style="background-color: #f8fafc; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom bg-white p-3 rounded-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0f172a;">
                <i class="bi bi-diagram-3-fill text-primary me-2"></i>Asociación de Clientes (Producción Diaria)
            </h2>
            <p class="text-secondary small mb-0 fw-semibold">
                Asocie clientes/operaciones secundarias (ej: Las Condes) a operaciones principales (ej: WalMart) independientemente para la Producción Diaria.
            </p>
        </div>
        <div>
            <button class="btn btn-primary btn-sm px-3 shadow-sm rounded-pill fw-bold" @onclick="PrepareCreate">
                <i class="bi bi-plus-lg me-1"></i>+ NUEVA ASOCIACIÓN
            </button>
        </div>
    </div>

    <!-- Info Banner -->
    <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div>
            <strong>Consolidación exclusiva en Producción Diaria:</strong>
            Al filtrar por la <em>Operación Destino (Principal)</em> en la Producción Diaria, la grilla mostrará automáticamente los movimientos de la operación principal junto con sus <em>Operaciones Origen (Secundarias)</em> configuradas en esta tabla.
        </div>
    </div>

    <!-- Search & Summary -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0" style="color: #0f172a;">
                <i class="bi bi-link-45deg me-2 text-primary"></i>Listado de Clientes Asociados (@FilteredAsociaciones.Count())
            </h5>
            <div class="input-group input-group-sm" style="max-width: 320px;">
                <span class="input-group-text bg-white border"><i class="bi bi-search text-dark"></i></span>
                <input type="text" class="form-control border" style="color: #000; font-weight: 500;" placeholder="Buscar por cliente/operación..." @bind="searchText" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <!-- Table -->
    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-dark fw-semibold mt-2">Cargando asociaciones...</p>
        </div>
    }
    else if (!FilteredAsociaciones.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-inbox text-secondary display-4"></i>
            <p class="text-secondary fw-semibold mt-2">No hay asociaciones de clientes registradas para producción.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small fw-bold text-uppercase">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Operación Origen (Secundaria)</th>
                            <th class="text-center">Asociada a</th>
                            <th>Operación Destino (Principal / Producción)</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredAsociaciones)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                                <td>
                                    <span class="badge bg-secondary px-2 py-1 me-2">ID @item.OperacionOrigenId</span>
                                    <strong class="text-dark">@item.OperacionOrigenNombre</strong>
                                </td>
                                <td class="text-center text-primary">
                                    <span class="badge bg-primary-subtle text-primary rounded-circle p-2 shadow-sm">
                                        <i class="bi bi-arrow-right fs-6"></i>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-primary px-2 py-1 me-2">ID @item.OperacionDestinoId</span>
                                    <strong class="text-dark">@item.OperacionDestinoNombre</strong>
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1 fw-bold">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm btn-primary px-3 rounded-2 fw-bold shadow-sm d-inline-flex align-items-center" title="Editar" @onclick="() => PrepareEdit(item)">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </button>
                                        <button class="btn btn-sm btn-danger px-3 rounded-2 fw-bold shadow-sm d-inline-flex align-items-center" title="Eliminar" @onclick="() => DeleteAsociacion(item.Id)">
                                            <i class="bi bi-trash3-fill me-1"></i> Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Form -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-diagram-3 me-2"></i>@(currentModel.Id > 0 ? "Editar Asociación de Cliente" : "Nueva Asociación de Cliente")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small fw-semibold mb-3">@errorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Operación Origen (Secundaria / Asociada)</label>
                        <select class="form-select border fw-semibold" @bind="currentModel.OperacionOrigenId">
                            <option value="0">-- Seleccione Operación Origen --</option>
                            @foreach (var op in operacionesCombo)
                            {
                                <option value="@op.id">@op.nombre (ID: @op.id)</option>
                            }
                        </select>
                        <div class="form-text small">Cliente/operación secundaria cuyos movimientos se mostrarán en la principal.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Operación Destino (Principal / Producción)</label>
                        <select class="form-select border fw-semibold" @bind="currentModel.OperacionDestinoId">
                            <option value="0">-- Seleccione Operación Principal --</option>
                            @foreach (var op in operacionesCombo)
                            {
                                <option value="@op.id">@op.nombre (ID: @op.id)</option>
                            }
                        </select>
                        <div class="form-text small">Cliente/operación principal que consolidará los movimientos en la Producción Diaria.</div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="chkActivoCli" @bind="currentModel.Activo" />
                        <label class="form-check-label fw-bold text-dark small" for="chkActivoCli">Asociación Activa</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill fw-bold px-4" @onclick="CloseModal">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill fw-bold px-4 shadow-sm" @onclick="SaveAsociacion" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string STORAGE_KEY = "asociaciones_clientes_produccion";
    private List<AsociacionOperacionDto> asociaciones = new();
    private List<Combos> operacionesCombo = new();
    private AsociacionOperacionDto currentModel = new();
    private bool loading = true;
    private bool saving = false;
    private bool showModal = false;
    private string searchText = "";
    private string errorMessage = "";

    private IEnumerable<AsociacionOperacionDto> FilteredAsociaciones =>
        string.IsNullOrWhiteSpace(searchText)
            ? asociaciones
            : asociaciones.Where(a =>
                (a.OperacionOrigenNombre ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (a.OperacionDestinoNombre ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                a.OperacionOrigenId.ToString().Contains(searchText) ||
                a.OperacionDestinoId.ToString().Contains(searchText));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var resCombos = await _OdooService.GetAllCombosHost("Operaciones");
            operacionesCombo = resCombos.Model?.ToList() ?? new();

            string? json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", STORAGE_KEY);
            if (!string.IsNullOrEmpty(json))
            {
                asociaciones = JsonSerializer.Deserialize<List<AsociacionOperacionDto>>(json) ?? new();
            }
            else
            {
                var lasCondesCombo = operacionesCombo.FirstOrDefault(c => c.id == 5 || c.nombre.Contains("Condes", StringComparison.OrdinalIgnoreCase));
                var walmartCombo = operacionesCombo.FirstOrDefault(c => c.id == 4 || c.nombre.Contains("WalMart", StringComparison.OrdinalIgnoreCase) || c.nombre.Contains("Walmart", StringComparison.OrdinalIgnoreCase));

                asociaciones = new List<AsociacionOperacionDto>
                {
                    new AsociacionOperacionDto
                    {
                        Id = 1,
                        OperacionOrigenId = lasCondesCombo?.id ?? 5,
                        OperacionOrigenNombre = lasCondesCombo?.nombre ?? "Las Condes",
                        OperacionDestinoId = walmartCombo?.id ?? 4,
                        OperacionDestinoNombre = walmartCombo?.nombre ?? "WalMart",
                        Activo = true
                    }
                };
                await SaveToStorage();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveToStorage()
    {
        try
        {
            string json = JsonSerializer.Serialize(asociaciones);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", STORAGE_KEY, json);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al guardar en localStorage: " + ex.Message);
        }
    }

    private void PrepareCreate()
    {
        currentModel = new AsociacionOperacionDto { Activo = true };
        errorMessage = "";
        showModal = true;
    }

    private void PrepareEdit(AsociacionOperacionDto item)
    {
        currentModel = new AsociacionOperacionDto
        {
            Id = item.Id,
            OperacionOrigenId = item.OperacionOrigenId,
            OperacionOrigenNombre = item.OperacionOrigenNombre,
            OperacionDestinoId = item.OperacionDestinoId,
            OperacionDestinoNombre = item.OperacionDestinoNombre,
            Activo = item.Activo
        };
        errorMessage = "";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveAsociacion()
    {
        if (currentModel.OperacionOrigenId <= 0)
        {
            errorMessage = "Debe seleccionar una operación origen.";
            return;
        }

        if (currentModel.OperacionDestinoId <= 0)
        {
            errorMessage = "Debe seleccionar una operación destino.";
            return;
        }

        if (currentModel.OperacionOrigenId == currentModel.OperacionDestinoId)
        {
            errorMessage = "La operación origen y destino no pueden ser la misma.";
            return;
        }

        saving = true;
        errorMessage = "";
        try
        {
            var origenObj = operacionesCombo.FirstOrDefault(o => o.id == currentModel.OperacionOrigenId);
            var destinoObj = operacionesCombo.FirstOrDefault(o => o.id == currentModel.OperacionDestinoId);
            currentModel.OperacionOrigenNombre = origenObj?.nombre ?? $"Operación #{currentModel.OperacionOrigenId}";
            currentModel.OperacionDestinoNombre = destinoObj?.nombre ?? $"Operación #{currentModel.OperacionDestinoId}";

            if (currentModel.Id > 0)
            {
                var existing = asociaciones.FirstOrDefault(a => a.Id == currentModel.Id);
                if (existing != null)
                {
                    existing.OperacionOrigenId = currentModel.OperacionOrigenId;
                    existing.OperacionOrigenNombre = currentModel.OperacionOrigenNombre;
                    existing.OperacionDestinoId = currentModel.OperacionDestinoId;
                    existing.OperacionDestinoNombre = currentModel.OperacionDestinoNombre;
                    existing.Activo = currentModel.Activo;
                }
            }
            else
            {
                currentModel.Id = asociaciones.Any() ? asociaciones.Max(a => a.Id) + 1 : 1;
                asociaciones.Add(currentModel);
            }

            await SaveToStorage();
            Snackbar.Add("Asociación guardada exitosamente.", Severity.Success);
            showModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAsociacion(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar esta asociación?");
        if (!confirmed) return;

        try
        {
            asociaciones.RemoveAll(a => a.Id == id);
            await SaveToStorage();
            Snackbar.Add("Asociación eliminada exitosamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }
}
