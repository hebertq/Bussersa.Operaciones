@page "/consulta-cierres"
@using Modelo.Report

<MudOverlay Visible="isloading" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Procesando...</MudText>
    </div>
</MudOverlay>

<MudText Typo="Typo.h5" Class="mb-4 fw-bold" Color="Color.Primary">REPORTE DE AUDITORÍA Y CIERRE</MudText>

@* --- PANEL DE FILTROS --- *@
<MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: #f8fafc; border-radius: 16px; border: 1px solid #e2e8f0;">
    @* --- FILA 1: PARÁMETROS DE CONSULTA Y BOTÓN PRINCIPAL --- *@
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="12" md="4">
            <MudSelect T="int" Label="Operación / Cliente" @bind-Value="operacionId"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="0">Seleccione un cliente...</MudSelectItem>
                @if (PayLoadOper != null)
                {
                    @foreach (var item in PayLoadOper)
                    {
                        <MudSelectItem Value="@item.id">@item.nombre</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="4" md="2">
            <MudSelect T="bool" Label="Filtrar por" @bind-Value="esRango" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="false">Mes y Año</MudSelectItem>
                <MudSelectItem Value="true">Rango de Fecha</MudSelectItem>
            </MudSelect>
        </MudItem>

        @if (!esRango)
        {
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="int" Label="Año" @bind-Value="anio" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    @foreach (var year in YearsList)
                    {
                        <MudSelectItem T="int" Value="@year">@year</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="int" Label="Mes" @bind-Value="mes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem Value="1">ENERO</MudSelectItem>
                    <MudSelectItem Value="2">FEBRERO</MudSelectItem>
                    <MudSelectItem Value="3">MARZO</MudSelectItem>
                    <MudSelectItem Value="4">ABRIL</MudSelectItem>
                    <MudSelectItem Value="5">MAYO</MudSelectItem>
                    <MudSelectItem Value="6">JUNIO</MudSelectItem>
                    <MudSelectItem Value="7">JULIO</MudSelectItem>
                    <MudSelectItem Value="8">AGOSTO</MudSelectItem>
                    <MudSelectItem Value="9">SEPTIEMBRE</MudSelectItem>
                    <MudSelectItem Value="10">OCTUBRE</MudSelectItem>
                    <MudSelectItem Value="11">NOVIEMBRE</MudSelectItem>
                    <MudSelectItem Value="12">DICIEMBRE</MudSelectItem>
                </MudSelect>
            </MudItem>
        }
        else
        {
            <MudItem xs="6" sm="4" md="2"><MudDatePicker Label="Inicio" @bind-Date="fchaInicio" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" sm="4" md="2"><MudDatePicker Label="Fin" @bind-Date="fchaFin" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        }

        <MudItem xs="12" sm="12" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConsultarReporte" FullWidth="true" Disabled="@isloading" Style="height: 40px; font-weight: bold;" StartIcon="@Icons.Material.Filled.Search">
                @(isloading ? "Buscando..." : "CONSULTAR")
            </MudButton>
        </MudItem>
    </MudGrid>

    @* --- FILA 2: CONFIGURACIÓN DE FACTURACIÓN Y BOTONES DE ACCIÓN --- *@
    <div class="d-flex align-center justify-between mt-3 pt-3 border-top flex-wrap gap-3">
        @* Opciones de cálculo y agrupación *@
        <div class="d-flex align-center gap-3 flex-wrap">
            <div class="d-flex align-center gap-1">
                <MudCheckBox T="bool" Value="@ReglasConfig.AplicarReglas" ValueChanged="@((bool val) => { ReglasConfig.AplicarReglas = val; AplicarFiltrosYTotales(); })" Color="Color.Success" Dense="true">
                    <span class="font-bold text-dark" style="font-size: 13px;">Reglas de Cobro</span>
                </MudCheckBox>
                <MudTooltip Text="Calcula las horas cobrables según las reglas asignadas al cliente seleccionado o la regla estándar de 8h.">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                </MudTooltip>
            </div>

            <div class="d-flex align-center gap-1">
                <MudCheckBox T="bool" Value="@excluirSupervisores" ValueChanged="@((bool val) => { excluirSupervisores = val; AplicarFiltrosYTotales(); })" Color="Color.Error" Dense="true">
                    <span class="font-bold text-dark" style="font-size: 13px;">Excluir Supervisores</span>
                </MudCheckBox>
                <MudTooltip Text="Al activar esta opción, las horas y marcaciones de supervisores no se cobran ni aparecen en el resumen cobrable.">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                </MudTooltip>
            </div>

            <div class="d-flex align-center gap-1">
                <span class="small fw-bold text-secondary" style="font-size: 12px; white-space: nowrap;">Agrupar:</span>
                <MudSelect T="string" Value="@ReglasConfig.ModoAgrupacion" ValueChanged="@((string val) => { ReglasConfig.ModoAgrupacion = val; AplicarFiltrosYTotales(); })"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 175px; background-color: white;">
                    <MudSelectItem Value="@("AreaCargoTurno")">Área, Cargo y Turno</MudSelectItem>
                    <MudSelectItem Value="@("AreaCargo")">Área y Cargo (Global)</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        @* Botones de gestión y exportación en su propia fila/bloque *@
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudTooltip Text="Configurar supervisores a excluir del cobro">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="AbrirModalSupervisores" Style="height: 36px; white-space: nowrap;" StartIcon="@Icons.Material.Filled.SupervisorAccount">
                    Supervisores (@CantidadSupervisoresConfigurados)
                </MudButton>
            </MudTooltip>

            <MudTooltip Text="Configurar reglas de cobro de horas por cliente y puesto">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="AbrirModalReglas" Style="height: 36px; white-space: nowrap;" StartIcon="@Icons.Material.Filled.Tune">
                    Reglas Cobro
                </MudButton>
            </MudTooltip>

            @if (SoportaConciliacionActual)
            {
                <MudFileUpload T="IBrowserFile" FilesChanged="CargarArchivoConciliacion" Accept=".xlsx,.xls">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled" Color="@(TieneConciliacion ? Color.Tertiary : Color.Warning)" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   Style="height: 36px; white-space: nowrap;" Class="fw-bold rounded-pill px-3">
                            @(TieneConciliacion ? $"Conciliación Activa ({resultadoConciliacion.BrechaPagadoTotalHoras:N0}h brecha)" : $"Conciliar con {NombreOperacionActual}")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Custom.FileFormats.FileExcel"
                       Disabled="@(DatosCierre == null || !DatosCierre.Any())"
                       OnClick="ExportarExcelCompleto" Style="height: 36px; white-space: nowrap;" Class="fw-bold rounded-pill px-3">
                Exportar Excel (2 Hojas)
            </MudButton>
        </div>
    </div>

    @* Fila de Badges Informativos de Estado *@
    @if (ReglasConfig.AplicarReglas || (excluirSupervisores && CantidadMarcacionesExcluidas > 0))
    {
        <div class="d-flex align-center gap-2 mt-2 pt-2 border-top flex-wrap">
            @if (ReglasConfig.AplicarReglas)
            {
                <MudChip T="string" Color="@(ReglasResumenTexto.Contains("Especiales") ? Color.Success : Color.Info)" Size="Size.Small" Variant="Variant.Outlined" Style="font-size: 11px; font-weight: 600;">
                    @ReglasResumenTexto
                </MudChip>
            }
            @if (excluirSupervisores && CantidadMarcacionesExcluidas > 0)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Style="font-size: 11px; font-weight: bold;">
                    🚫 @CantidadMarcacionesExcluidas marcaciones de supervisores excluidas del cobro
                </MudChip>
            }
        </div>
    }
</MudPaper>

@* --- CONTENEDOR DE RESULTADOS --- *@
<div>
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary" @bind-ActivePanelIndex="activeTabIndex">

        @* TAB 1: CONSOLIDADO *@
        <MudTabPanel Text="CONSOLIDADO POR ÁREA" Icon="@Icons.Material.Filled.Assignment">
            <MudDataGrid Items="@ResumenPorArea" Dense="true" Hover="true" Striped="true"
                         RowsPerPage="10" QuickFilter="@_filterMaestro" Loading="@isloading">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Resumen Áreas</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchMaestro" Placeholder="Buscar área..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Area" Title="Área / Proyecto" />
                    <PropertyColumn Property="x => x.Cargo" Title="Cargo" />
                    <TemplateColumn Title="Turno">
                        <CellTemplate>
                            @if (context.Item.Turno == "Diurno")
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">
                                    ☀️ Diurno
                                </MudChip>
                            }
                            else if (context.Item.Turno == "Nocturno")
                            {
                                <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold text-white" Style="font-size: 11px; background-color: #34495e;">
                                    🌙 Nocturno
                                </MudChip>
                            }
                            else if (context.Item.Turno == "Mixto")
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="fw-bold" Style="font-size: 11px;">
                                    ⚖️ Mixto
                                </MudChip>
                            }
                            else
                            {
                                <span class="badge bg-secondary" style="font-size: 10px;">@context.Item.Turno</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Periodo">
                        <CellTemplate>
                            @(context.Item.FechaMin == default ? "---" : $"{context.Item.FechaMin:dd/MM} al {context.Item.FechaMax:dd/MM/yyyy}")
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.DiasLaborados" Title="Días" />
                    <PropertyColumn Property="x => x.TotalColaboradores" Title="Pers." />
                    <TemplateColumn Title="Horas Cobrables">
                        <CellTemplate>
                            <span class="fw-bold text-primary" style="font-size: 13px;">@context.Item.TotalHoras.ToString("N1")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Extras Cobrables">
                        <CellTemplate>
                            <span class="fw-bold text-success" style="font-size: 13px;">@context.Item.TotalExtras.ToString("N1")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Total Cobro">
                        <CellTemplate>
                            <span class="fw-bold text-dark" style="font-size: 13px;">@((context.Item.TotalHoras + context.Item.TotalExtras).ToString("N1"))</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Marcadas">
                        <CellTemplate>
                            <span class="text-secondary small">@context.Item.TotalHorasReales.ToString("N1")h / @context.Item.TotalExtrasReales.ToString("N1")e</span>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4 text-center">No hay datos disponibles. Realice una consulta.</MudText>
                </NoRecordsContent>
                <PagerContent><MudDataGridPager T="ConsolidadoCierre" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        @* TAB 2: DETALLE *@
        <MudTabPanel Text="DETALLE NOMINAL" Icon="@Icons.Material.Filled.People">
            <MudDataGrid Items="@DatosCierre" Dense="true" Hover="true" Striped="true"
                         RowsPerPage="10" QuickFilter="@_filterDetalle" Loading="@isloading">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Listado Detallado</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchDetalle" Placeholder="Buscar colaborador..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.fecha_asistencia" Title="Fecha" Format="dd/MM/yyyy" />
                    <PropertyColumn Property="x => x.area_nombre" Title="Área" />
                    <PropertyColumn Property="x => x.cargo" Title="Cargo" />
                    <TemplateColumn Title="Turno">
                        <CellTemplate>
                            @if (context.Item.Turno == "Diurno")
                            {
                                <span class="badge bg-warning text-dark fw-semibold" style="font-size: 11px;">☀️ Diurno</span>
                            }
                            else if (context.Item.Turno == "Nocturno")
                            {
                                <span class="badge bg-dark text-white fw-semibold" style="font-size: 11px;">🌙 Nocturno</span>
                            }
                            else if (context.Item.Turno == "Mixto")
                            {
                                <span class="badge bg-info text-dark fw-semibold" style="font-size: 11px;">⚖️ Mixto</span>
                            }
                            else
                            {
                                <span class="text-muted small">---</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Colaborador">
                        <CellTemplate>
                            <div class="d-flex align-center gap-1">
                                <span class="font-bold">@context.Item.nombre_empleado</span>
                                @if (EsSupervisor(context.Item))
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Style="font-size: 9px; height: 18px; padding: 0 4px;">
                                        SUPERVISOR (NO COBRABLE)
                                    </MudChip>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.entrada_movimiento" Title="Entrada" />
                    <PropertyColumn Property="x => x.salida_movimiento" Title="Salida" />
                    <TemplateColumn Title="Marcadas">
                        <CellTemplate>
                            <span class="text-secondary small">@context.Item.horas_totales.ToString("N1") + @context.Item.horas_extras.ToString("N1")e</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Horas Cobro">
                        <CellTemplate>
                            <span class="badge bg-primary text-white fw-bold px-2 py-1" style="font-size: 12px;">@context.Item.HorasNormalesCobrables.ToString("N1")h</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Extras Cobro">
                        <CellTemplate>
                            @if (context.Item.HorasExtrasCobrables > 0)
                            {
                                <span class="badge bg-success text-white fw-bold px-2 py-1" style="font-size: 12px;">+@context.Item.HorasExtrasCobrables.ToString("N1")h</span>
                            }
                            else
                            {
                                <span class="text-muted small">0.0h</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Regla Cobro">
                        <CellTemplate>
                            <span class="badge bg-light text-dark border small" title="@context.Item.ReglaAplicada">@context.Item.ReglaAplicada</span>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4 text-center">No hay registros detallados para mostrar.</MudText>
                </NoRecordsContent>
                <PagerContent><MudDataGridPager T="ReporteCierreMarcadasDetalle" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        @* TAB 3: CONCILIACIÓN CON CLIENTE *@
        <MudTabPanel Text="CONCILIACIÓN CLIENTE" Icon="@Icons.Material.Filled.CompareArrows" Disabled="@(!SoportaConciliacionActual && !TieneConciliacion)">
            @if (!TieneConciliacion)
            {
                <MudPaper Elevation="0" Class="pa-8 my-4 text-center" Style="background-color: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" Style="font-size: 3rem;" />
                    <MudText Typo="Typo.h6" Class="fw-bold mt-2" Color="Color.Dark">Conciliación Biométrica / Facturación Externa (@(string.IsNullOrEmpty(NombreOperacionActual) ? "Cliente" : NombreOperacionActual))</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary mt-1 mb-4" Style="max-width: 600px; margin: 0 auto;">
                        Cargue el archivo de control biométrico o gastos de terceros emitido por el cliente (ej. <code>gastos_terceros_*.xlsx</code>) para comparar la producción real registrada por Bussersa contra lo facturado y pagado por el cliente.
                    </MudText>
                    <div class="d-flex justify-center">
                        <MudFileUpload T="IBrowserFile" FilesChanged="CargarArchivoConciliacion" Accept=".xlsx,.xls">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Size="Size.Medium" Class="fw-bold px-4 py-2 rounded-pill">
                                    SELECCIONAR ARCHIVO DE CLIENTE
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </div>
                </MudPaper>
            }
            else
            {
                @* ENCABEZADO DE CONCILIACIÓN Y ACCIONES *@
                <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <div class="d-flex justify-between align-center flex-wrap gap-3">
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold">
                                🏢 Cliente: @resultadoConciliacion.NombreCliente
                            </MudChip>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Class="fw-bold">
                                📄 Archivo: @nombreArchivoConciliacion
                            </MudChip>
                            @if (resultadoConciliacion.FechaInicio.HasValue && resultadoConciliacion.FechaFin.HasValue)
                            {
                                <MudChip T="string" Color="Color.Dark" Variant="Variant.Outlined" Size="Size.Small">
                                    📅 Periodo: @resultadoConciliacion.FechaInicio.Value.ToString("dd/MM/yyyy") al @resultadoConciliacion.FechaFin.Value.ToString("dd/MM/yyyy")
                                </MudChip>
                            }
                        </div>
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudFileUpload T="IBrowserFile" FilesChanged="CargarArchivoConciliacion" Accept=".xlsx,.xls">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh">
                                        Cargar Otro Archivo
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="LimpiarConciliacion" StartIcon="@Icons.Material.Filled.Close">
                                Quitar Conciliación
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="ExportarConciliacionExcel" StartIcon="@Icons.Custom.FileFormats.FileExcel" Class="fw-bold rounded-pill px-3">
                                Exportar Conciliación Completa (Excel)
                            </MudButton>
                        </div>
                    </div>

                    @* TARJETAS KPI COMPARATIVAS *@
                    <MudGrid Spacing="2" Class="mt-3">
                        @* 1. Bussersa Producción Cobrable *@
                        <MudItem xs="12" sm="6" md="2">
                            <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #f0f7ff; border: 1px solid #bfdbfe; border-radius: 10px;">
                                <span class="small text-secondary fw-semibold">Producción Bussersa</span>
                                <div class="fs-5 fw-bold text-primary mt-1">@resultadoConciliacion.TotalHorasBussersa.ToString("N1") h</div>
                                <div class="small text-muted" style="font-size: 11px;">@resultadoConciliacion.TotalTurnosBussersa turnos (@resultadoConciliacion.TotalHorasOrdBussersa.ToString("N1")o + @resultadoConciliacion.TotalHorasExtBussersa.ToString("N1")e)</div>
                            </MudPaper>
                        </MudItem>

                        @* 2. Cliente Pagado *@
                        <MudItem xs="12" sm="6" md="2">
                            <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px;">
                                <span class="small text-secondary fw-semibold">Cliente Pagado</span>
                                <div class="fs-5 fw-bold text-success mt-1">@resultadoConciliacion.TotalHorasClientePagado.ToString("N1") h</div>
                                <div class="small text-muted" style="font-size: 11px;">@resultadoConciliacion.TotalTurnosClientePagado turnos (@resultadoConciliacion.TotalHorasOrdClientePagado.ToString("N1")o + @resultadoConciliacion.TotalHorasExtClientePagado.ToString("N1")e)</div>
                            </MudPaper>
                        </MudItem>

                        @* 3. Cliente Facturas Pendientes *@
                        <MudItem xs="12" sm="6" md="2">
                            <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #fefce8; border: 1px solid #fef08a; border-radius: 10px;">
                                <span class="small text-secondary fw-semibold">Facturas Pendientes</span>
                                <div class="fs-5 fw-bold text-warning mt-1">@resultadoConciliacion.TotalHorasClientePendiente.ToString("N1") h</div>
                                <div class="small text-muted" style="font-size: 11px;">@resultadoConciliacion.TotalTurnosClientePendiente turnos (@resultadoConciliacion.TotalHorasOrdClientePendiente.ToString("N1")o + @resultadoConciliacion.TotalHorasExtClientePendiente.ToString("N1")e)</div>
                            </MudPaper>
                        </MudItem>

                        @* 4. Total Registrado Cliente *@
                        <MudItem xs="12" sm="6" md="2">
                            <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
                                <span class="small text-secondary fw-semibold">Total en Cliente</span>
                                <div class="fs-5 fw-bold text-dark mt-1">@resultadoConciliacion.TotalHorasClienteTotal.ToString("N1") h</div>
                                <div class="small text-muted" style="font-size: 11px;">@resultadoConciliacion.TotalTurnosClienteTotal turnos registrados</div>
                            </MudPaper>
                        </MudItem>

                        @* 5. Brecha Neta vs Efectivamente Pagado (DIFERENCIA A COBRAR) *@
                        <MudItem xs="12" sm="6" md="2">
                            <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #fef2f2; border: 2px solid #ef4444; border-radius: 10px;">
                                <span class="small fw-bold text-danger">⚠️ Brecha vs Pagado</span>
                                <div class="fs-5 fw-bold text-danger mt-1">@resultadoConciliacion.BrechaPagadoTotalHoras.ToString("N1") h</div>
                                <div class="small text-danger fw-semibold" style="font-size: 11px;">@resultadoConciliacion.BrechaPagadoTurnos turnos pendientes</div>
                            </MudPaper>
                        </MudItem>

                        @* 6. Diferencia Neta Global *@
                        <MudItem xs="12" sm="6" md="2">
                            <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px;">
                                <span class="small text-secondary fw-semibold">Diferencia Neta Global</span>
                                <div class="fs-5 fw-bold text-orange mt-1">@resultadoConciliacion.DiferenciaTotalHorasGlobal.ToString("N1") h</div>
                                <div class="small text-muted" style="font-size: 11px;">@resultadoConciliacion.DiferenciaTurnosGlobal turnos netos</div>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @* SUB-PESTAÑAS DE DETALLE DE CONCILIACIÓN *@
                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Default" Class="mt-2">
                    @* SUB-TAB 1: TURNOS FALTANTES (OMITIDOS) *@
                    <MudTabPanel Text="@($"Turnos Omitidos / Faltantes ({resultadoConciliacion.TurnosFaltantes.Count})")" Icon="@Icons.Material.Filled.Warning">
                        <MudDataGrid Items="@resultadoConciliacion.TurnosFaltantes" Dense="true" Hover="true" Striped="true"
                                     RowsPerPage="10" QuickFilter="@_filterFaltante">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold text-danger">Turnos Laborados en Bussersa Omitidos por el Cliente</MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="_searchFaltante" Placeholder="Buscar faltante..." Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 50px;" />
                                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.DiaSemana" Title="Día" />
                                <PropertyColumn Property="x => x.NombreEmpleado" Title="Colaborador" />
                                <PropertyColumn Property="x => x.Area" Title="Área" />
                                <PropertyColumn Property="x => x.Cargo" Title="Cargo" />
                                <TemplateColumn Title="Turno">
                                    <CellTemplate><span class="badge bg-light text-dark border">@context.Item.Turno</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="H. Ord">
                                    <CellTemplate><span class="fw-bold text-primary">@context.Item.HorasOrdCobrables.ToString("N1")</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="H. Ext">
                                    <CellTemplate><span class="fw-bold text-success">@context.Item.HorasExtCobrables.ToString("N1")</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Total Horas">
                                    <CellTemplate><span class="badge bg-danger text-white fw-bold px-2 py-1">@context.Item.TotalHorasCobrables.ToString("N1")h</span></CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.CategoriaFaltante" Title="Categoría" />
                                <PropertyColumn Property="x => x.MotivoJustificacion" Title="Motivo / Diagnóstico" />
                            </Columns>
                            <PagerContent><MudDataGridPager T="TurnoFaltanteClienteDto" /></PagerContent>
                        </MudDataGrid>
                    </MudTabPanel>

                    @* SUB-TAB 2: FACTURAS PENDIENTES *@
                    <MudTabPanel Text="@($"Facturas Pendientes ({resultadoConciliacion.FacturasPendientes.Count})")" Icon="@Icons.Material.Filled.HourglassTop">
                        <MudDataGrid Items="@resultadoConciliacion.FacturasPendientes" Dense="true" Hover="true" Striped="true"
                                     RowsPerPage="10" QuickFilter="@_filterPendiente">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold text-warning">Registros del Cliente en Estado PENDIENTE</MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="_searchPendiente" Placeholder="Buscar factura o colaborador..." Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 50px;" />
                                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.NombreEmpleado" Title="Colaborador" />
                                <PropertyColumn Property="x => x.Puesto" Title="Puesto" />
                                <PropertyColumn Property="x => x.Bodega" Title="Bodega" />
                                <TemplateColumn Title="H. Ord">
                                    <CellTemplate><span>@context.Item.HorasOrd.ToString("N1")</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="H. Ext">
                                    <CellTemplate><span>@context.Item.HorasExt.ToString("N1")</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Total Horas">
                                    <CellTemplate><span class="badge bg-warning text-dark fw-bold px-2 py-1">@context.Item.TotalHoras.ToString("N1")h</span></CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.NoFactura" Title="No. Factura" />
                                <TemplateColumn Title="Estado">
                                    <CellTemplate><span class="badge bg-danger text-white">PENDIENTE</span></CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Observacion" Title="Observación" />
                            </Columns>
                            <PagerContent><MudDataGridPager T="RegistroPendienteClienteDto" /></PagerContent>
                        </MudDataGrid>
                    </MudTabPanel>

                    @* SUB-TAB 3: DIFERENCIAS EN DÍAS COMUNES *@
                    <MudTabPanel Text="@($"Diferencias en Días Comunes ({resultadoConciliacion.DiferenciasDiasComunes.Count})")" Icon="@Icons.Material.Filled.SyncProblem">
                        <MudDataGrid Items="@resultadoConciliacion.DiferenciasDiasComunes" Dense="true" Hover="true" Striped="true"
                                     RowsPerPage="10" QuickFilter="@_filterDiferencia">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold text-info">Discrepancias de Horas en Días Registrados por Ambos</MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="_searchDiferencia" Placeholder="Buscar discrepancia..." Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 50px;" />
                                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.NombreEmpleado" Title="Colaborador" />
                                <PropertyColumn Property="x => x.Area" Title="Área" />
                                <PropertyColumn Property="x => x.Cargo" Title="Cargo" />
                                <TemplateColumn Title="Bussersa">
                                    <CellTemplate><span class="fw-bold text-primary">@context.Item.HorasBussersa.ToString("N2")h</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Cliente">
                                    <CellTemplate><span class="fw-bold text-dark">@context.Item.HorasCliente.ToString("N2")h</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Diferencia">
                                    <CellTemplate>
                                        <span class="badge @(context.Item.DiferenciaHoras > 0 ? "bg-danger text-white" : "bg-success text-white") fw-bold">
                                            @(context.Item.DiferenciaHoras > 0 ? $"+{context.Item.DiferenciaHoras:N2}h" : $"{context.Item.DiferenciaHoras:N2}h")
                                        </span>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.NoFacturaCliente" Title="Factura" />
                                <PropertyColumn Property="x => x.DetalleDiferencia" Title="Detalle" />
                            </Columns>
                            <PagerContent><MudDataGridPager T="DiferenciaDiaComunDto" /></PagerContent>
                        </MudDataGrid>
                    </MudTabPanel>

                    @* SUB-TAB 4: RESUMEN POR COLABORADOR *@
                    <MudTabPanel Text="@($"Resumen por Colaborador ({resultadoConciliacion.ResumenColaboradores.Count})")" Icon="@Icons.Material.Filled.PeopleAlt">
                        <MudDataGrid Items="@resultadoConciliacion.ResumenColaboradores" Dense="true" Hover="true" Striped="true"
                                     RowsPerPage="10" QuickFilter="@_filterResumenColab">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary">Consolidado de Faltantes por Colaborador</MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="_searchResumenColab" Placeholder="Buscar colaborador..." Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 50px;" />
                                <PropertyColumn Property="x => x.IdEmpleado" Title="ID" HeaderStyle="width: 80px;" />
                                <PropertyColumn Property="x => x.NombreEmpleado" Title="Colaborador" />
                                <PropertyColumn Property="x => x.AreaPrincipal" Title="Área Principal" />
                                <PropertyColumn Property="x => x.CargoPrincipal" Title="Cargo" />
                                <TemplateColumn Title="Días Omitidos">
                                    <CellTemplate><span class="badge bg-danger text-white fw-bold px-2 py-1">@context.Item.DiasOmitidos días</span></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Horas Omitidas">
                                    <CellTemplate><span class="fw-bold text-danger fs-6">@context.Item.TotalHorasOmitidas.ToString("N1")h</span></CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.CategoriaFaltante" Title="Categoría" />
                                <PropertyColumn Property="x => x.CausaRaiz" Title="Causa Raíz" />
                                <PropertyColumn Property="x => x.FechasOmitidas" Title="Fechas Omitidas" />
                            </Columns>
                            <PagerContent><MudDataGridPager T="ResumenColaboradorFaltanteDto" /></PagerContent>
                        </MudDataGrid>
                    </MudTabPanel>

                    @* SUB-TAB 5: SOLO EN ARCHIVO CLIENTE *@
                    <MudTabPanel Text="@($"Solo en Cliente ({resultadoConciliacion.RegistrosSoloCliente.Count})")" Icon="@Icons.Material.Filled.HelpOutline">
                        <MudDataGrid Items="@resultadoConciliacion.RegistrosSoloCliente" Dense="true" Hover="true" Striped="true"
                                     RowsPerPage="10" QuickFilter="@_filterSoloCliente">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold text-secondary">Registros en el Archivo del Cliente No Encontrados en Bussersa</MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="_searchSoloCliente" Placeholder="Buscar..." Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.No" Title="#" HeaderStyle="width: 50px;" />
                                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.NombreEmpleado" Title="Nombre en Cliente" />
                                <PropertyColumn Property="x => x.Puesto" Title="Puesto" />
                                <PropertyColumn Property="x => x.Bodega" Title="Bodega" />
                                <TemplateColumn Title="Total Horas">
                                    <CellTemplate><span class="fw-bold text-dark">@context.Item.TotalHoras.ToString("N1")h</span></CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.NoFactura" Title="Factura" />
                                <PropertyColumn Property="x => x.EstadoPago" Title="Estado" />
                                <PropertyColumn Property="x => x.Diagnostico" Title="Diagnóstico" />
                            </Columns>
                            <PagerContent><MudDataGridPager T="RegistroSoloClienteDto" /></PagerContent>
                        </MudDataGrid>
                    </MudTabPanel>
                </MudTabs>
            }
        </MudTabPanel>
    </MudTabs>
</div>

@* --- MODAL DE GESTIÓN DE SUPERVISORES --- *@
@if (mostrarModalSupervisores)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 99999;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill fs-4"></i>
                        Gestión de Supervisores (Exclusión de Cobro)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalSupervisores = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 small fw-semibold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <span>Los colaboradores marcados como <strong>Supervisor</strong> se excluirán automáticamente del reporte de auditoría y del resumen cobrable a clientes. Los supervisores seleccionados aparecen en la parte superior.</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="input-group input-group-sm" style="max-width: 340px;">
                            <span class="input-group-text bg-white border"><i class="bi bi-search text-dark"></i></span>
                            <input type="text" class="form-control border" placeholder="Buscar por colaborador, ID o cédula..." @bind="_searchSupervisor" @bind:event="oninput" />
                        </div>
                        <div>
                            <button class="btn btn-outline-danger btn-sm me-2 fw-semibold" @onclick="DesmarcarTodosSupervisores">Desmarcar Todos</button>
                            <button class="btn btn-outline-primary btn-sm fw-semibold" @onclick="MarcarTodosSupervisores">Marcar Visibles</button>
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-secondary small fw-bold text-uppercase sticky-top" style="z-index: 10;">
                                <tr>
                                    <th class="text-center" style="width: 90px;">Supervisor</th>
                                    <th style="width: 90px;">ID</th>
                                    <th>Colaborador</th>
                                    <th>Detalle / Cédula</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredSupervisoresList)
                                {
                                    <tr class="@(item.EsSupervisor ? "table-warning" : "")">
                                        <td class="text-center">
                                            <input class="form-check-input" type="checkbox" @bind="item.EsSupervisor" style="width: 20px; height: 20px; cursor: pointer;" />
                                        </td>
                                        <td class="fw-bold text-secondary">#@item.IdEmpleado</td>
                                        <td class="fw-bold text-dark">
                                            @item.Nombre
                                            @if (item.EsSupervisor)
                                            {
                                                <span class="badge bg-danger ms-2" style="font-size: 10px;">EXCLUIDO DEL COBRO</span>
                                            }
                                        </td>
                                        <td class="text-secondary small">@item.Area</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <span class="small text-secondary fw-semibold">
                        Supervisores seleccionados: <strong>@ListaEmpleadosSupervisores.Count(x => x.EsSupervisor)</strong> de @ListaEmpleadosSupervisores.Count colaboradores
                    </span>
                    <div>
                        <button type="button" class="btn btn-secondary btn-sm rounded-pill fw-bold px-4 me-2" @onclick="() => mostrarModalSupervisores = false">Cancelar</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-pill fw-bold px-4 shadow-sm" @onclick="GuardarSupervisoresConfig">Guardar Configuración</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL DE CONFIGURACIÓN DE REGLAS DE COBRO POR CLIENTE --- *@
@if (mostrarModalReglas)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.55); z-index: 99999;">
        <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 1140px;">
            <div class="modal-content border-0 shadow-lg rounded-3">
                @* HEADER *@
                <div class="modal-header bg-dark text-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-gear-wide-connected fs-4 text-info"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Reglas de Cobro de Horas por Operación</h5>
                            <small class="text-light opacity-75">Configuración y persistencia en Base de Datos (PostgreSQL)</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalReglas = false"></button>
                </div>

                @* BODY *@
                <div class="modal-body p-4" style="max-height: 80vh; overflow-y: auto;">
                    
                    @* 1. FILTRO POR OPERACIÓN *@
                    <div class="card border-0 bg-light p-3 mb-3 shadow-sm rounded-3">
                        <div class="row align-items-center g-2">
                            <div class="col-md-7">
                                <label class="form-label fw-bold text-dark small mb-1">
                                    <i class="bi bi-building me-1 text-primary"></i> Filtrar por Operación / Cliente:
                                </label>
                                <select class="form-select form-select-sm fw-bold border-primary shadow-sm" value="@modalOperacionId" @onchange="OnModalOperacionChanged">
                                    <option value="0">-- Seleccione una Operación --</option>
                                    @if (PayLoadOper != null)
                                    {
                                        @foreach (var op in PayLoadOper)
                                        {
                                            <option value="@op.id">@op.nombre</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-5 d-flex align-items-center justify-content-md-end gap-2 mt-2 mt-md-0">
                                @if (modalOperacionId > 0)
                                {
                                    <span class="badge bg-primary px-3 py-2 fs-6">
                                        <i class="bi bi-check-circle-fill me-1"></i> @NombreOperacionModal
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Seleccione una operación
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (modalOperacionId > 0)
                    {
                        @* 2. CONTROLES DE EDICIÓN (FORMULARIO MASTER) *@
                        <div class="card border-primary border-opacity-50 shadow-sm mb-4">
                            <div class="card-header bg-primary bg-opacity-10 py-2 d-flex justify-content-between align-items-center">
                                <div class="fw-bold text-primary small d-flex align-items-center gap-1">
                                    <i class="bi @(editingRegla.Id > 0 ? "bi-pencil-square" : "bi-plus-circle")"></i>
                                    <span>@(editingRegla.Id > 0 ? $"Editando Regla: {editingRegla.NombreRegla}" : "Controles de Edición: Agregar Nueva Regla")</span>
                                </div>
                                @if (editingRegla.Id > 0)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 small" @onclick="LimpiarFormularioEdicion">
                                        <i class="bi bi-x-circle me-1"></i> Cancelar Edición
                                    </button>
                                }
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="small fw-bold text-secondary mb-1">Nombre de la Regla:</label>
                                        <input type="text" class="form-control form-control-sm fw-semibold" placeholder="ej. Operador de Montacargas" @bind="editingRegla.NombreRegla" />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="small fw-bold text-secondary mb-0">
                                                <i class="bi bi-briefcase-fill text-primary me-1"></i> Cargo (hr_job):
                                            </label>
                                            <button type="button" class="btn btn-link p-0 text-decoration-none small text-muted" style="font-size: 0.75rem;" @onclick="() => permitirCargoManual = !permitirCargoManual">
                                                <i class="bi @(permitirCargoManual ? "bi-list-ul" : "bi-pencil") me-1"></i>@(permitirCargoManual ? "Elegir de lista" : "Escribir manual")
                                            </button>
                                        </div>
                                        @if (!permitirCargoManual)
                                        {
                                            <select class="form-select form-select-sm fw-semibold" value="@editingRegla.CargoPatron" @onchange="OnCargoChanged">
                                                <option value="">-- Seleccione un Cargo --</option>
                                                @if (ListaCargosHr != null)
                                                {
                                                    @foreach (var c in ListaCargosHr)
                                                    {
                                                        <option value="@c.nombre">@c.nombre</option>
                                                    }
                                                }
                                                @if (!string.IsNullOrEmpty(editingRegla.CargoPatron) && ListaCargosHr != null && !ListaCargosHr.Any(x => string.Equals(x.nombre, editingRegla.CargoPatron, StringComparison.OrdinalIgnoreCase)))
                                                {
                                                    <option value="@editingRegla.CargoPatron">@editingRegla.CargoPatron (Personalizado)</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control form-control-sm" placeholder="ej. Operador de montacarga, conductor" @bind="editingRegla.CargoPatron" />
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <label class="small fw-bold text-secondary mb-1">Tipo / Comportamiento de Cobro:</label>
                                        <select class="form-select form-select-sm" value="@editingRegla.TipoRegla" @onchange="OnTipoReglaChanged">
                                            <option value="MONTACARGA_12H">🚜 Montacargas 12h (12 Cobrables + Exceso a Extras)</option>
                                            <option value="NOCTURNO_EQUIVALENCIA">🌙 Nocturno Equivalente (7h → 8N)</option>
                                            <option value="FIJO_DIARIO">🚚 Tarifa Fija Diaria (Horas Fijas)</option>
                                            <option value="TOPE_DIARIO">⏱️ Tope Diario (Exceso a Extras)</option>
                                            <option value="PERSONALIZADA">⚙️ Personalizada</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="small fw-bold text-secondary mb-1">Horas Normales:</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="editingRegla.HorasNormales" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="small fw-bold text-secondary mb-1">Horas Extras Base:</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="editingRegla.HorasExtrasBase" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="small fw-bold text-secondary mb-1">Horas Base Turno:</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="editingRegla.HorasBaseTurno" />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-center gap-3 pt-3">
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" id="chkModalReglaActiva" @bind="editingRegla.Activa" />
                                            <label class="form-check-label small fw-bold @(editingRegla.Activa ? "text-success" : "text-muted")" for="chkModalReglaActiva">
                                                @(editingRegla.Activa ? "Regla Activa" : "Regla Inactiva")
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="LimpiarFormularioEdicion" disabled="@guardandoRegla">
                                        <i class="bi bi-eraser-fill me-1"></i> Limpiar
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="GuardarReglaFormulario" disabled="@guardandoRegla">
                                        @if (guardandoRegla)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            <span>Guardando...</span>
                                        }
                                        else
                                        {
                                            <i class="bi @(editingRegla.Id > 0 ? "bi-check-circle-fill" : "bi-cloud-arrow-up-fill") me-1"></i>
                                            <span>@(editingRegla.Id > 0 ? "Actualizar Regla en Base de Datos" : "Guardar Regla en Base de Datos")</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>

                        @* 3. GRILLA DE REGLAS APLICADAS *@
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                <span class="fw-bold small text-dark">
                                    <i class="bi bi-table me-1 text-primary"></i> Reglas Aplicadas Registradas (@ReglasCliente.Count)
                                </span>
                                <small class="text-muted">Presione <strong>Editar</strong> en cualquier fila para cargarla en los controles superiores.</small>
                            </div>
                            <div class="card-body p-0">
                                @if (cargandoReglas)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="small text-muted ms-2">Cargando reglas desde la base de datos...</span>
                                    </div>
                                }
                                else if (!ReglasCliente.Any())
                                {
                                    <div class="text-center py-4 bg-light">
                                        <i class="bi bi-inbox fs-3 text-muted"></i>
                                        <p class="small text-muted mb-0 mt-1">No hay reglas registradas para esta operación. Ingrese una en los controles de arriba para agregarla.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover table-striped align-middle mb-0 small">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th style="width: 40px;" class="text-center">#</th>
                                                    <th>Nombre Regla</th>
                                                    <th>Cargo (hr_job)</th>
                                                    <th>Tipo de Cobro</th>
                                                    <th class="text-center">H. Normales</th>
                                                    <th class="text-center">H. Extras Base</th>
                                                    <th class="text-center">H. Base Turno</th>
                                                    <th class="text-center">Estado</th>
                                                    <th class="text-center" style="width: 140px;">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < ReglasCliente.Count; i++)
                                                {
                                                    var regla = ReglasCliente[i];
                                                    int num = i + 1;
                                                    bool isEditingThis = editingRegla.Id > 0 && editingRegla.Id == regla.Id;
                                                    <tr class="@(isEditingThis ? "table-warning fw-bold" : "")">
                                                        <td class="text-center fw-bold">@num</td>
                                                        <td class="fw-bold text-primary">@regla.NombreRegla</td>
                                                        <td>
                                                            <code>@regla.CargoPatron</code>
                                                        </td>
                                                        <td>
                                                            @switch (regla.TipoRegla)
                                                            {
                                                                case "MONTACARGA_12H":
                                                                    <span>🚜 Montacargas 12h</span>
                                                                    break;
                                                                case "NOCTURNO_EQUIVALENCIA":
                                                                    <span>🌙 Nocturno 7h→8N</span>
                                                                    break;
                                                                case "FIJO_DIARIO":
                                                                    <span>🚚 Tarifa Fija</span>
                                                                    break;
                                                                case "TOPE_DIARIO":
                                                                    <span>⏱️ Tope Diario</span>
                                                                    break;
                                                                default:
                                                                    <span>⚙️ Personalizada</span>
                                                                    break;
                                                            }
                                                        </td>
                                                        <td class="text-center">@regla.HorasNormales.ToString("F1") h</td>
                                                        <td class="text-center">@regla.HorasExtrasBase.ToString("F1") h</td>
                                                        <td class="text-center">@regla.HorasBaseTurno.ToString("F1") h</td>
                                                        <td class="text-center">
                                                            @if (regla.Activa)
                                                            {
                                                                <span class="badge bg-success">Activa</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Inactiva</span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            <div class="d-flex justify-content-center gap-1">
                                                                <button type="button" class="btn btn-outline-primary btn-sm py-1 px-2" title="Editar regla" @onclick="() => EditarRegla(regla)">
                                                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                                                </button>
                                                                <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2" title="Eliminar regla" @onclick="() => EliminarReglaDeGrilla(regla)">
                                                                    <i class="bi bi-trash-fill"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* FOOTER *@
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill fw-bold px-4" @onclick="() => mostrarModalReglas = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}