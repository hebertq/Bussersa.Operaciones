@using MudBlazor
@using System.Globalization
@using Modelo.Admin
@using Modelo.ClasesGenericas

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Editar en Mi Plantilla</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <b>#@ItemOriginal.CodigoEmpleado</b> - @ItemOriginal.NombreEmpleado
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @* Cliente y Área *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Cliente Inicial" Value="Cliente" ValueChanged="@OnClienteChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Área Inicial" @bind-Value="Area" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var a in areasFiltradas)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Puesto y Tipo de Empleado *@
                <MudItem xs="12" md="7">
                    <MudSelect T="string" Label="Puesto Inicial" @bind-Value="Puesto" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudSelect T="string" Label="Tipo de Empleado" @bind-Value="TipoEmpleado" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("Permanente")">Permanente</MudSelectItem>
                        <MudSelectItem Value="@("Temporal")">Temporal</MudSelectItem>
                        <MudSelectItem Value="@("Prestamo")">Préstamo</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (string.Equals(TipoEmpleado, "Prestamo", StringComparison.OrdinalIgnoreCase) || string.Equals(TipoEmpleado, "Temporal", StringComparison.OrdinalIgnoreCase))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-1">
                            Este colaborador está en condición de <b>Préstamo</b>. Se mantendrá en tu lista de personal pero no se grabará en la administración base del cliente.
                        </MudAlert>
                        <MudSelect T="string" 
                                   Label="Cliente de Origen / Nómina (Préstamo)" 
                                   @bind-Value="ClienteOrigenNomina" 
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense" 
                                   Dense="true"
                                   HelperText="Cliente al que pertenece legalmente la nómina del trabajador">
                            <MudSelectItem Value="@("")">-- Seleccionar Cliente Origen --</MudSelectItem>
                            @foreach (var cNom in ObtenerClientesNomina())
                            {
                                <MudSelectItem Value="@cNom">@cNom</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @* Horario y Comida *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Horario y Tiempo de Comida
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Entrada" @bind-Value="HoraEntrada" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="06:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Salida" @bind-Value="HoraSalida" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="14:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     Label="Tiempo Comida (Horas)" 
                                     @bind-Value="TiempoComida" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     Max="24" 
                                     Step="0.5m" 
                                     Format="0.00" 
                                     Adornment="Adornment.End" 
                                     AdornmentText="hrs" />
                </MudItem>

                @* Viáticos Base *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                        Viáticos y Bonos Base (Por Defecto)
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoTrasp" 
                                     Label="Transporte (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoTrasp = 0)">C$ 0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 35 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 35)">35</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 50)">50</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 70)">70</MudChip>
                    </div>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoAlim" 
                                     Label="Alimentación (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoAlim = 0)">C$ 0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 50)">50</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 70)">70</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 100)">100</MudChip>
                    </div>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="BonoBnc" 
                                     Label="Bono BNC (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => BonoBnc = 0)">C$ 0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 100)">100</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 150 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 150)">150</MudChip>
                    </div>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" 
                   Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   Disabled="@guardando"
                   StartIcon="@(guardando ? null : Icons.Material.Filled.Save)">
            @if (guardando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar Cambios</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public SupervisorPlantillaItemDto ItemOriginal { get; set; } = new();
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public Dictionary<string, List<string>> AreasPorCliente { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();

    private string Cliente = string.Empty;
    private string Area = string.Empty;
    private string Puesto = string.Empty;
    private string TipoEmpleado = "Permanente";
    private string ClienteOrigenNomina = string.Empty;
    private string Turno = "Diurno";
    private string HoraEntrada = "06:00";
    private string HoraSalida = "14:00";
    private decimal TiempoComida = 1.00m;
    private decimal VtcoTrasp;
    private decimal VtcoAlim;
    private decimal BonoBnc;

    private List<string> areasFiltradas = new();

    protected override void OnInitialized()
    {
        if (ItemOriginal != null)
        {
            Cliente = ItemOriginal.ClienteDefault;
            Area = ItemOriginal.AreaDefault;
            Puesto = ItemOriginal.PuestoDefault;
            TipoEmpleado = string.IsNullOrWhiteSpace(ItemOriginal.TipoEmpleado) ? "Permanente" : ItemOriginal.TipoEmpleado;
            ClienteOrigenNomina = LimpiarTextoOdoo(ItemOriginal.ClienteOrigenNomina);
            Turno = string.IsNullOrWhiteSpace(ItemOriginal.TurnoDefault) ? "Diurno" : ItemOriginal.TurnoDefault;
            HoraEntrada = string.IsNullOrWhiteSpace(ItemOriginal.HoraEntradaDefault) ? "06:00" : ItemOriginal.HoraEntradaDefault;
            HoraSalida = string.IsNullOrWhiteSpace(ItemOriginal.HoraSalidaDefault) ? "14:00" : ItemOriginal.HoraSalidaDefault;
            
            if (decimal.TryParse(ItemOriginal.TiempoComidaDefault?.Replace(',', '.'), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal tc))
                TiempoComida = tc;
            else
                TiempoComida = 1.00m;

            VtcoTrasp = ItemOriginal.VtcoTraspDefault;
            VtcoAlim = ItemOriginal.VtcoAlimDefault;
            BonoBnc = ItemOriginal.BonoBncDefault;
        }

        ActualizarAreasParaCliente(Cliente);
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        Cliente = nuevoCliente;
        ActualizarAreasParaCliente(nuevoCliente);
        if (!areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasFiltradas.FirstOrDefault() ?? "Operaciones";
        }
    }

    private void ActualizarAreasParaCliente(string cliente)
    {
        if (!string.IsNullOrWhiteSpace(cliente) && AreasPorCliente.TryGetValue(cliente, out var areas) && areas.Any())
        {
            areasFiltradas = new List<string>(areas);
        }
        else
        {
            areasFiltradas = new List<string> { "Operaciones", "Bodega", "Rampa", "Almacen", "Distribucion" };
        }

        if (!string.IsNullOrWhiteSpace(Area) && !areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            areasFiltradas.Insert(0, Area);
        }
    }

    private static string LimpiarTextoOdoo(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        var trimmed = raw.Trim();
        if (trimmed.StartsWith("{") && trimmed.EndsWith("}"))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(trimmed);
                var root = doc.RootElement;
                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    string[] preferredKeys = { "es_419", "es_NI", "es_ES", "es_MX", "en_US" };
                    foreach (var k in preferredKeys)
                    {
                        if (root.TryGetProperty(k, out var elem) && !string.IsNullOrWhiteSpace(elem.GetString()))
                            return elem.GetString()!.Trim();
                    }
                    foreach (var prop in root.EnumerateObject())
                    {
                        var val = prop.Value.GetString();
                        if (!string.IsNullOrWhiteSpace(val)) return val.Trim();
                    }
                }
            }
            catch { }
        }
        return trimmed;
    }

    private List<string> ObtenerClientesNomina()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        set.Add("Administración");

        if (OperacionesDisponibles != null)
        {
            foreach (var op in OperacionesDisponibles)
            {
                var nombreLimpio = LimpiarTextoOdoo(op?.nombre);
                if (!string.IsNullOrWhiteSpace(nombreLimpio))
                {
                    set.Add(nombreLimpio);
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(ClienteOrigenNomina))
        {
            var limpio = LimpiarTextoOdoo(ClienteOrigenNomina);
            if (!string.IsNullOrWhiteSpace(limpio))
            {
                set.Add(limpio);
            }
        }

        return set.OrderBy(x => string.Equals(x, "Administración", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                  .ThenBy(x => x)
                  .ToList();
    }

    private void Cancelar() => MudDialog.Cancel();

    private bool guardando = false;

    private void Guardar()
    {
        if (guardando) return;
        guardando = true;
        var modificado = new SupervisorPlantillaItemDto
        {
            Id = ItemOriginal.Id,
            UsuarioSupervisor = ItemOriginal.UsuarioSupervisor,
            IdEmpleado = ItemOriginal.IdEmpleado,
            CodigoEmpleado = ItemOriginal.CodigoEmpleado,
            NombreEmpleado = ItemOriginal.NombreEmpleado,
            ClienteDefault = Cliente,
            AreaDefault = Area,
            PuestoDefault = Puesto,
            TurnoDefault = Turno,
            HoraEntradaDefault = HoraEntrada,
            HoraSalidaDefault = HoraSalida,
            TiempoComidaDefault = TiempoComida.ToString("0.00", CultureInfo.InvariantCulture),
            VtcoTraspDefault = VtcoTrasp,
            VtcoAlimDefault = VtcoAlim,
            BonoBncDefault = BonoBnc,
            TipoEmpleado = TipoEmpleado,
            ClienteOrigenNomina = LimpiarTextoOdoo(ClienteOrigenNomina),
            Activo = true
        };

        MudDialog.Close(DialogResult.Ok(modificado));
    }
}
