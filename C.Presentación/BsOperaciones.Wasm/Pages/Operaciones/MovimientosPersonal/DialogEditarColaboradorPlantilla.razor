@using MudBlazor
@using Modelo.Admin
@using Modelo.ClasesGenericas

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Editar en Mi Plantilla</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <b>#@ItemOriginal.CodigoEmpleado</b> - @ItemOriginal.NombreEmpleado
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @* Cliente y Área *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Cliente Inicial" Value="Cliente" ValueChanged="@OnClienteChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Área Inicial" @bind-Value="Area" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var a in areasFiltradas)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Puesto y Turno *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Puesto Inicial" @bind-Value="Puesto" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Turno Habitual" Value="Turno" ValueChanged="@OnTurnoChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("Diurno")">Diurno (06:00 - 14:00)</MudSelectItem>
                        <MudSelectItem Value="@("Sinsa")">Sinsa (07:00 - 16:00)</MudSelectItem>
                        <MudSelectItem Value="@("Normal")">Normal (08:00 - 17:00)</MudSelectItem>
                        <MudSelectItem Value="@("DCC")">DCC (06:00 - 15:30)</MudSelectItem>
                        <MudSelectItem Value="@("Mixto")">Mixto (14:00 - 22:00)</MudSelectItem>
                        <MudSelectItem Value="@("Nocturno")">Nocturno (22:00 - 06:00)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Horas Entrada y Salida *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="HoraEntrada" Label="Hora Entrada" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="06:00" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Login" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="HoraSalida" Label="Hora Salida" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="14:00" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Logout" />
                </MudItem>

                @* Viáticos Base *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                        Viáticos y Bonos Base (Por Defecto)
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoTrasp" 
                                     Label="Transporte (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoTrasp = 0)">C$ 0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 35 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 35)">35</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 50)">50</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 70)">70</MudChip>
                    </div>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoAlim" 
                                     Label="Alimentación (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoAlim = 0)">C$ 0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="@(() => VtcoAlim = 50)">50</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="@(() => VtcoAlim = 70)">70</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="@(() => VtcoAlim = 100)">100</MudChip>
                    </div>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="BonoBnc" 
                                     Label="Bono BNC (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => BonoBnc = 0)">C$ 0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 100)">100</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 150 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 150)">150</MudChip>
                    </div>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">
            Guardar Cambios
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public SupervisorPlantillaItemDto ItemOriginal { get; set; } = new();
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public Dictionary<string, List<string>> AreasPorCliente { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();

    private string Cliente = string.Empty;
    private string Area = string.Empty;
    private string Puesto = string.Empty;
    private string Turno = "Diurno";
    private string HoraEntrada = "06:00";
    private string HoraSalida = "14:00";
    private decimal VtcoTrasp;
    private decimal VtcoAlim;
    private decimal BonoBnc;

    private List<string> areasFiltradas = new();

    protected override void OnInitialized()
    {
        if (ItemOriginal != null)
        {
            Cliente = ItemOriginal.ClienteDefault;
            Area = ItemOriginal.AreaDefault;
            Puesto = ItemOriginal.PuestoDefault;
            Turno = string.IsNullOrWhiteSpace(ItemOriginal.TurnoDefault) ? "Diurno" : ItemOriginal.TurnoDefault;
            HoraEntrada = string.IsNullOrWhiteSpace(ItemOriginal.HoraEntradaDefault) ? "06:00" : ItemOriginal.HoraEntradaDefault;
            HoraSalida = string.IsNullOrWhiteSpace(ItemOriginal.HoraSalidaDefault) ? "14:00" : ItemOriginal.HoraSalidaDefault;
            VtcoTrasp = ItemOriginal.VtcoTraspDefault;
            VtcoAlim = ItemOriginal.VtcoAlimDefault;
            BonoBnc = ItemOriginal.BonoBncDefault;
        }

        ActualizarAreasParaCliente(Cliente);
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        Cliente = nuevoCliente;
        ActualizarAreasParaCliente(nuevoCliente);
        if (!areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasFiltradas.FirstOrDefault() ?? "Operaciones";
        }
    }

    private void ActualizarAreasParaCliente(string cliente)
    {
        if (!string.IsNullOrWhiteSpace(cliente) && AreasPorCliente.TryGetValue(cliente, out var areas) && areas.Any())
        {
            areasFiltradas = new List<string>(areas);
        }
        else
        {
            areasFiltradas = new List<string> { "Operaciones", "Bodega", "Rampa", "Almacen", "Distribucion" };
        }

        if (!string.IsNullOrWhiteSpace(Area) && !areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            areasFiltradas.Insert(0, Area);
        }
    }

    private void OnTurnoChanged(string nuevoTurno)
    {
        Turno = nuevoTurno;
        if (nuevoTurno == "Diurno") { HoraEntrada = "06:00"; HoraSalida = "14:00"; }
        else if (nuevoTurno == "Sinsa") { HoraEntrada = "07:00"; HoraSalida = "16:00"; }
        else if (nuevoTurno == "Normal") { HoraEntrada = "08:00"; HoraSalida = "17:00"; }
        else if (nuevoTurno == "DCC") { HoraEntrada = "06:00"; HoraSalida = "15:30"; }
        else if (nuevoTurno == "Mixto") { HoraEntrada = "14:00"; HoraSalida = "22:00"; }
        else if (nuevoTurno == "Nocturno") { HoraEntrada = "22:00"; HoraSalida = "06:00"; }
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        var modificado = new SupervisorPlantillaItemDto
        {
            Id = ItemOriginal.Id,
            UsuarioSupervisor = ItemOriginal.UsuarioSupervisor,
            IdEmpleado = ItemOriginal.IdEmpleado,
            CodigoEmpleado = ItemOriginal.CodigoEmpleado,
            NombreEmpleado = ItemOriginal.NombreEmpleado,
            ClienteDefault = Cliente,
            AreaDefault = Area,
            PuestoDefault = Puesto,
            TurnoDefault = Turno,
            HoraEntradaDefault = HoraEntrada,
            HoraSalidaDefault = HoraSalida,
            VtcoTraspDefault = VtcoTrasp,
            VtcoAlimDefault = VtcoAlim,
            BonoBncDefault = BonoBnc,
            Activo = true
        };

        MudDialog.Close(DialogResult.Ok(modificado));
    }
}
