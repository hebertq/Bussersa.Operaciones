@using MudBlazor
@using System.Globalization
@using Modelo.Admin
@using Modelo.ClasesGenericas

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Editar Asistencia</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <b>#@ItemOriginal.CodigoEmpleado</b> - @ItemOriginal.NombreEmpleado
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0" Style="max-height: 75vh; overflow-y: auto; padding-right: 4px;">
            @if (RegistroSinsa != null)
            {
                <MudPaper Class="pa-3 mb-3 rounded-lg" Elevation="0" Style="background: #f0fdf4; border: 1.5px solid #86efac;">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-1 mb-2">
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Success" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #166534;">
                                Datos del Archivo SINSA (@(RegistroSinsa.Fecha?.ToString("dd/MM/yyyy") ?? ""))
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                   OnClick="@AplicarTodoSegunSinsa"
                                   Style="height: 26px; font-size: 0.72rem; font-weight: 800;">
                            Cuadrar Todo con SINSA
                        </MudButton>
                    </div>

                    @* 1. ELEGIR ÁREA *@
                    <div class="mb-2">
                        <div class="text-caption fw-bold mb-1" style="color: #1e293b; font-size: 0.73rem;">
                            1. Elegir Área (Zona SINSA: <b>@ZonaSinsaCanonica</b>):
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(string.Equals(Area, ZonaSinsaCanonica, StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Default)"
                                     Variant="@(string.Equals(Area, ZonaSinsaCanonica, StringComparison.OrdinalIgnoreCase) ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => SeleccionarAreaSinsa(ZonaSinsaCanonica))"
                                     Class="my-0 fw-bold">
                                Zona SINSA: @ZonaSinsaCanonica
                            </MudChip>
                            @if (!string.IsNullOrWhiteSpace(ItemOriginal.Area) && !string.Equals(ItemOriginal.Area, ZonaSinsaCanonica, StringComparison.OrdinalIgnoreCase))
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(string.Equals(Area, ItemOriginal.Area, StringComparison.OrdinalIgnoreCase) ? Color.Primary : Color.Default)"
                                         Variant="@(string.Equals(Area, ItemOriginal.Area, StringComparison.OrdinalIgnoreCase) ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => SeleccionarAreaSinsa(ItemOriginal.Area))"
                                         Class="my-0">
                                    Actual: @ItemOriginal.Area
                                </MudChip>
                            }
                        </div>
                    </div>

                    @* 2. ELEGIR HORARIO *@
                    <div class="mb-2">
                        <div class="text-caption fw-bold mb-1" style="color: #1e293b; font-size: 0.73rem;">
                            2. Elegir Horario (Ord: <b>@RegistroSinsa.HorasOrdinarias.ToString("0.##")h</b> &bull; Reloj: <b>@RegistroSinsa.HoraEntradaRelojHm - @RegistroSinsa.HoraSalidaRelojHm</b>):
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            @{
                                string salTurnoConHe = HorasExtrasEdit > 0m
                                    ? ConciliacionSinsaHelper.SumarHorasHm(RegistroSinsa.TurnoFin, HorasExtrasEdit)
                                    : RegistroSinsa.TurnoFin;
                                bool esTurnoActivo = string.Equals(HoraEntrada, RegistroSinsa.TurnoInicio, StringComparison.OrdinalIgnoreCase)
                                    && string.Equals(HoraSalida, salTurnoConHe, StringComparison.OrdinalIgnoreCase);
                                bool esRelojActivo = string.Equals(HoraEntrada, RegistroSinsa.HoraEntradaRelojHm, StringComparison.OrdinalIgnoreCase)
                                    && string.Equals(HoraSalida, RegistroSinsa.HoraSalidaRelojHm, StringComparison.OrdinalIgnoreCase);
                            }
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(esTurnoActivo ? Color.Success : Color.Default)"
                                     Variant="@(esTurnoActivo ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@AplicarHorarioTurnoSinsa"
                                     Class="my-0 font-monospace fw-bold">
                                Turno SINSA: @RegistroSinsa.TurnoInicio - @salTurnoConHe
                            </MudChip>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(esRelojActivo ? Color.Info : Color.Default)"
                                     Variant="@(esRelojActivo ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@AplicarHorarioRelojSinsa"
                                     Class="my-0 font-monospace fw-bold">
                                Reloj SINSA: @RegistroSinsa.HoraEntradaRelojHm - @RegistroSinsa.HoraSalidaRelojHm
                            </MudChip>
                            @if (HorasExtrasEdit > 0m)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="Color.Default"
                                         Variant="Variant.Outlined"
                                         OnClick="@AplicarSoloTurnoSinHe"
                                         Class="my-0 font-monospace">
                                    Solo Turno: @RegistroSinsa.TurnoInicio - @RegistroSinsa.TurnoFin
                                </MudChip>
                            }
                        </div>
                    </div>

                    @* 3. HORAS EXTRAS CONFORME AL ARCHIVO SINSA *@
                    <div class="pt-1" style="border-top: 1px dashed #86efac;">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-1 mb-1">
                            <MudCheckBox T="bool"
                                         Dense="true"
                                         Color="Color.Warning"
                                         @bind-Value="AplicarCuadreHorasExtras"
                                         Label="@($"Generar / cuadrar Horas Extras (Archivo SINSA: {RegistroSinsa.HorasExtra:0.##} hrs)")" />
                            @if (RegistroSinsa.ExcesoRelojSobreTurnoHoras >= 0.75m && HorasExtrasEdit == 0m)
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           OnClick="@UsarSalidaRelojComoHe"
                                           Style="height: 22px; font-size: 0.68rem; font-weight: 700;">
                                    Usar exceso reloj (+@RegistroSinsa.ExcesoRelojSobreTurnoHoras.ToString("0.##")h)
                                </MudButton>
                            }
                        </div>
                        @if (AplicarCuadreHorasExtras)
                        {
                            <MudGrid Spacing="1">
                                <MudItem xs="4">
                                    <MudTextField T="string"
                                                  Label="Inicio Extra"
                                                  Value="@HoraInicioExtraEdit"
                                                  ValueChanged="@OnInicioExtraChanged"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Style="background: white; font-family: monospace; font-size: 0.78rem;" />
                                </MudItem>
                                <MudItem xs="4">
                                    <MudTextField T="string"
                                                  Label="Fin Extra"
                                                  Value="@HoraFinExtraEdit"
                                                  ValueChanged="@OnFinExtraChanged"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Style="background: white; font-family: monospace; font-size: 0.78rem;" />
                                </MudItem>
                                <MudItem xs="4">
                                    <MudNumericField T="decimal"
                                                     Label="Cant. H.E."
                                                     Value="@HorasExtrasEdit"
                                                     ValueChanged="@OnCantidadHeChanged"
                                                     Min="0m"
                                                     Max="16m"
                                                     Step="0.25m"
                                                     Format="F2"
                                                     HideSpinButtons="true"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Adornment="Adornment.End"
                                                     AdornmentText="h"
                                                     Style="background: white; font-family: monospace; font-weight: 700; font-size: 0.78rem;" />
                                </MudItem>
                            </MudGrid>
                        }
                    </div>
                </MudPaper>
            }

            <MudGrid Spacing="2">
                @* Cliente y Área *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Cliente / Operación" Value="Cliente" ValueChanged="@OnClienteChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in ObtenerClientesDisponibles())
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Área de Trabajo" @bind-Value="Area" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var a in areasFiltradas)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Puesto y Tipo de Empleado *@
                <MudItem xs="12" md="7">
                    <MudSelect T="string" Label="Puesto / Cargo" @bind-Value="Puesto" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudSelect T="string" Label="Condición / Tipo" @bind-Value="TipoEmpleado" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("Permanente")">Permanente</MudSelectItem>
                        <MudSelectItem Value="@("Temporal")">Temporal</MudSelectItem>
                        <MudSelectItem Value="@("Prestamo")">Préstamo</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Asistencia (Presente / Ausente) *@
                <MudItem xs="12">
                    <div class="d-flex align-center justify-space-between p-2 rounded-lg" style="background: #f1f5f9;">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@(Asistio ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" 
                                     Color="@(Asistio ? Color.Success : Color.Error)" />
                            <MudText Typo="Typo.body2" Class="fw-bold">
                                Estado: <span style="@(Asistio ? "color: #16a34a;" : "color: #dc2626;")">@(Asistio ? "PRESENTE" : "AUSENTE")</span>
                            </MudText>
                        </div>
                        <MudSwitch @bind-Value="Asistio" Color="Color.Success" UnCheckedColor="Color.Error" />
                    </div>
                </MudItem>

                @if (string.Equals(TipoEmpleado, "Prestamo", StringComparison.OrdinalIgnoreCase) || !string.IsNullOrWhiteSpace(ClienteOrigenNomina))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-1" Icon="@Icons.Material.Filled.SwapHoriz">
                            Colaborador en <b>Préstamo</b> para este cliente. Su asistencia se registrará en <b>@Cliente</b> manteniendo su nómina en el cliente de origen.
                        </MudAlert>
                        <MudSelect T="string" 
                                   Label="Cliente de Origen / Nómina (Préstamo)" 
                                   @bind-Value="ClienteOrigenNomina" 
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense" 
                                   Dense="true"
                                   HelperText="Cliente al que pertenece legalmente la nómina del trabajador">
                            <MudSelectItem Value="@("")">-- Seleccionar Origen --</MudSelectItem>
                            @foreach (var cNom in ObtenerClientesNomina())
                            {
                                <MudSelectItem Value="@cNom">@cNom</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @* Horario y Comida *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Horario y Tiempo de Comida
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Entrada" @bind-Value="HoraEntrada" Disabled="@(!Asistio)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="06:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Salida" @bind-Value="HoraSalida" Disabled="@(!Asistio)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="14:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     Label="Tiempo Comida (Horas)" 
                                     @bind-Value="TiempoComida" 
                                     Disabled="@(!Asistio)"
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     Max="24" 
                                     Step="0.5m" 
                                     Format="0.00" 
                                     Adornment="Adornment.End" 
                                     AdornmentText="hrs" />
                </MudItem>

                @* Viáticos y Bonos *@
                @if (Asistio)
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-1" />
                        <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                            Viáticos y Bono del Día
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" 
                                         @bind-Value="VtcoTrasp" 
                                         Label="Transporte (C$)" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Min="0" 
                                         HideSpinButtons="true" 
                                         Format="N2" 
                                         Adornment="Adornment.Start" 
                                         AdornmentText="C$" />
                        <div class="d-flex gap-1 mt-1">
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoTrasp = 0)">C$ 0</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 35 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 35)">35</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 50)">50</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 70)">70</MudChip>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" 
                                         @bind-Value="VtcoAlim" 
                                         Label="Alimentación (C$)" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Min="0" 
                                         HideSpinButtons="true" 
                                         Format="N2" 
                                         Adornment="Adornment.Start" 
                                         AdornmentText="C$" />
                        <div class="d-flex gap-1 mt-1">
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoAlim = 0)">C$ 0</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 50)">50</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 70)">70</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 100)">100</MudChip>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" 
                                         @bind-Value="BonoBnc" 
                                         Label="Bono BNC (C$)" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Min="0" 
                                         HideSpinButtons="true" 
                                         Format="N2" 
                                         Adornment="Adornment.Start" 
                                         AdornmentText="C$" />
                        <div class="d-flex gap-1 mt-1">
                            <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => BonoBnc = 0)">C$ 0</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 100)">100</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 150 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 150)">150</MudChip>
                        </div>
                    </MudItem>
                }

                @* Observaciones *@
                <MudItem xs="12">
                    <MudTextField T="string" 
                                  Label="Observaciones del Día" 
                                  @bind-Value="Observaciones" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  Lines="2" 
                                  Placeholder="Anotaciones de la jornada o motivo de préstamo..." />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" 
                   Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Save">
            Guardar Cambios
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public class ResultadoEdicionAsistencia
    {
        public EmpleadoJornadaItem EmpleadoModificado { get; set; } = new();
        public bool AplicarCuadreHorasExtras { get; set; }
        public decimal HorasExtrasAutorizadas { get; set; }
        public string HoraInicioExtra { get; set; } = "17:00";
        public string HoraFinExtra { get; set; } = "18:00";
    }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public EmpleadoJornadaItem ItemOriginal { get; set; } = new();
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public List<string> ClientesSugeridos { get; set; } = new();
    [Parameter] public Dictionary<string, List<string>> AreasPorCliente { get; set; } = new();
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();
    [Parameter] public List<string> ClientesAsignadosSupervisor { get; set; } = new();
    [Parameter] public RegistroArchivoSinsaItem? RegistroSinsa { get; set; }
    [Parameter] public decimal? HorasExtrasActuales { get; set; }
    [Parameter] public string? HoraInicioExtraActual { get; set; }
    [Parameter] public string? HoraFinExtraActual { get; set; }

    private string Cliente { get; set; } = string.Empty;
    private string Area { get; set; } = string.Empty;
    private string Puesto { get; set; } = string.Empty;
    private string TipoEmpleado { get; set; } = "Permanente";
    private string ClienteOrigenNomina { get; set; } = string.Empty;
    private bool Asistio { get; set; } = true;
    private string HoraEntrada { get; set; } = "06:00";
    private string HoraSalida { get; set; } = "14:00";
    private decimal TiempoComida { get; set; } = 1.00m;
    private decimal VtcoTrasp { get; set; } = 0;
    private decimal VtcoAlim { get; set; } = 0;
    private decimal BonoBnc { get; set; } = 0;
    private string Observaciones { get; set; } = string.Empty;

    private bool AplicarCuadreHorasExtras { get; set; }
    private decimal HorasExtrasEdit { get; set; }
    private string HoraInicioExtraEdit { get; set; } = "17:00";
    private string HoraFinExtraEdit { get; set; } = "18:00";

    private List<string> areasFiltradas = new();

    private string ZonaSinsaCanonica =>
        RegistroSinsa != null
            ? ConciliacionSinsaHelper.ResolverAreaCanonica(RegistroSinsa.Zona, areasFiltradas)
            : string.Empty;

    protected override void OnInitialized()
    {
        Cliente = ItemOriginal.Cliente ?? "";
        Area = ItemOriginal.Area ?? "";
        Puesto = ItemOriginal.Puesto ?? "";
        TipoEmpleado = !string.IsNullOrWhiteSpace(ItemOriginal.TipoEmpleado) ? ItemOriginal.TipoEmpleado : "Permanente";
        ClienteOrigenNomina = ItemOriginal.ClienteOrigenNomina ?? "";
        Asistio = ItemOriginal.Asistio;
        HoraEntrada = ItemOriginal.HoraEntrada ?? "06:00";
        HoraSalida = ItemOriginal.HoraSalida ?? "14:00";

        if (decimal.TryParse(ItemOriginal.TiempoComida, NumberStyles.Any, CultureInfo.InvariantCulture, out var tComida))
        {
            TiempoComida = tComida;
        }

        VtcoTrasp = ItemOriginal.VtcoTrasp;
        VtcoAlim = ItemOriginal.VtcoAlim;
        BonoBnc = ItemOriginal.BonoBnc;
        Observaciones = ItemOriginal.Observaciones ?? "";

        CargarAreasCliente(Cliente);

        if (RegistroSinsa != null)
        {
            if (!string.IsNullOrWhiteSpace(RegistroSinsa.Zona) && !areasFiltradas.Contains(RegistroSinsa.Zona, StringComparer.OrdinalIgnoreCase))
            {
                areasFiltradas.Insert(0, RegistroSinsa.Zona.Trim());
            }
            AplicarCuadreHorasExtras = true;
            HorasExtrasEdit = HorasExtrasActuales ?? RegistroSinsa.HorasExtra;
            HoraInicioExtraEdit = !string.IsNullOrWhiteSpace(HoraInicioExtraActual) ? HoraInicioExtraActual! : RegistroSinsa.HoraInicioExtraSugerida;
            HoraFinExtraEdit = !string.IsNullOrWhiteSpace(HoraFinExtraActual)
                ? HoraFinExtraActual!
                : (HorasExtrasEdit > 0m ? ConciliacionSinsaHelper.SumarHorasHm(HoraInicioExtraEdit, HorasExtrasEdit) : RegistroSinsa.TurnoFin);
        }
    }

    private void SeleccionarAreaSinsa(string nuevaArea)
    {
        if (string.IsNullOrWhiteSpace(nuevaArea)) return;
        if (!areasFiltradas.Contains(nuevaArea, StringComparer.OrdinalIgnoreCase))
            areasFiltradas.Insert(0, nuevaArea);
        Area = nuevaArea;
    }

    private void AplicarHorarioTurnoSinsa()
    {
        if (RegistroSinsa == null) return;
        Asistio = true;
        HoraEntrada = RegistroSinsa.TurnoInicio;
        HoraSalida = HorasExtrasEdit > 0m
            ? ConciliacionSinsaHelper.SumarHorasHm(RegistroSinsa.TurnoFin, HorasExtrasEdit)
            : RegistroSinsa.TurnoFin;
        TiempoComida = RegistroSinsa.TiempoComidaSugeridoTurno;
    }

    private void AplicarSoloTurnoSinHe()
    {
        if (RegistroSinsa == null) return;
        Asistio = true;
        HoraEntrada = RegistroSinsa.TurnoInicio;
        HoraSalida = RegistroSinsa.TurnoFin;
        TiempoComida = RegistroSinsa.TiempoComidaSugeridoTurno;
    }

    private void AplicarHorarioRelojSinsa()
    {
        if (RegistroSinsa == null) return;
        Asistio = true;
        HoraEntrada = RegistroSinsa.HoraEntradaRelojHm;
        HoraSalida = RegistroSinsa.HoraSalidaRelojHm;
        TiempoComida = RegistroSinsa.TiempoComidaSugeridoTurno;
    }

    private void UsarSalidaRelojComoHe()
    {
        if (RegistroSinsa == null) return;
        AplicarCuadreHorasExtras = true;
        HoraInicioExtraEdit = RegistroSinsa.TurnoFin;
        HoraFinExtraEdit = RegistroSinsa.HoraSalidaRelojHm;
        HorasExtrasEdit = RegistroSinsa.ExcesoRelojSobreTurnoHoras;
        HoraEntrada = RegistroSinsa.HoraEntradaRelojHm;
        HoraSalida = RegistroSinsa.HoraSalidaRelojHm;
        TiempoComida = RegistroSinsa.TiempoComidaSugeridoTurno;
    }

    private void AplicarTodoSegunSinsa()
    {
        if (RegistroSinsa == null) return;
        Asistio = true;
        SeleccionarAreaSinsa(ZonaSinsaCanonica);
        AplicarCuadreHorasExtras = true;
        HorasExtrasEdit = RegistroSinsa.HorasExtra;
        HoraInicioExtraEdit = RegistroSinsa.HoraInicioExtraSugerida;
        HoraFinExtraEdit = HorasExtrasEdit > 0m
            ? ConciliacionSinsaHelper.SumarHorasHm(HoraInicioExtraEdit, HorasExtrasEdit)
            : RegistroSinsa.TurnoFin;
        HoraEntrada = RegistroSinsa.TurnoInicio;
        HoraSalida = HorasExtrasEdit > 0m ? HoraFinExtraEdit : RegistroSinsa.TurnoFin;
        TiempoComida = RegistroSinsa.TiempoComidaSugeridoTurno;
    }

    private void OnInicioExtraChanged(string val)
    {
        HoraInicioExtraEdit = val?.Trim() ?? "17:00";
        decimal d = ConciliacionSinsaHelper.CalcularDiferenciaHoras(HoraInicioExtraEdit, HoraFinExtraEdit);
        if (d > 0m && d <= 16m) HorasExtrasEdit = d;
    }

    private void OnFinExtraChanged(string val)
    {
        HoraFinExtraEdit = val?.Trim() ?? "18:00";
        decimal d = ConciliacionSinsaHelper.CalcularDiferenciaHoras(HoraInicioExtraEdit, HoraFinExtraEdit);
        if (d > 0m && d <= 16m) HorasExtrasEdit = d;
    }

    private void OnCantidadHeChanged(decimal val)
    {
        HorasExtrasEdit = Math.Round(Math.Max(0m, val), 2);
        if (HorasExtrasEdit > 0m)
        {
            HoraFinExtraEdit = ConciliacionSinsaHelper.SumarHorasHm(HoraInicioExtraEdit, HorasExtrasEdit);
        }
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        Cliente = nuevoCliente;
        CargarAreasCliente(nuevoCliente);

        if (!string.Equals(ItemOriginal.Cliente, nuevoCliente, StringComparison.OrdinalIgnoreCase))
        {
            TipoEmpleado = "Prestamo";
            if (string.IsNullOrWhiteSpace(ClienteOrigenNomina))
            {
                ClienteOrigenNomina = ItemOriginal.Cliente;
            }
        }
    }

    private void CargarAreasCliente(string cliente)
    {
        areasFiltradas = new List<string>();
        if (!string.IsNullOrWhiteSpace(cliente))
        {
            foreach (var kvp in AreasPorCliente)
            {
                if (string.Equals(kvp.Key, cliente, StringComparison.OrdinalIgnoreCase))
                {
                    areasFiltradas = kvp.Value.Where(a => !string.IsNullOrWhiteSpace(a)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                    break;
                }
            }
        }

        if (!areasFiltradas.Any())
        {
            areasFiltradas = new List<string> { "Operaciones", "Almacen", "Rampa", "Control de calidad", "General" };
        }

        if (!string.IsNullOrWhiteSpace(Area) && !areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            areasFiltradas.Insert(0, Area);
        }
        else if (string.IsNullOrWhiteSpace(Area) || !areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasFiltradas.FirstOrDefault() ?? "Operaciones";
        }
    }

    private List<string> ObtenerClientesDisponibles()
    {
        var lista = new List<string>();
        if (ClientesSugeridos != null) lista.AddRange(ClientesSugeridos);
        if (ClientesAsignadosSupervisor != null) lista.AddRange(ClientesAsignadosSupervisor);
        if (OperacionesDisponibles != null) lista.AddRange(OperacionesDisponibles.Select(o => o.nombre));
        if (!string.IsNullOrWhiteSpace(Cliente) && !lista.Contains(Cliente, StringComparer.OrdinalIgnoreCase)) lista.Add(Cliente);
        return lista.Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c).ToList();
    }

    private List<string> ObtenerClientesNomina() => ObtenerClientesDisponibles();

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        string turnoFinal = ItemOriginal.TurnoNombre;
        if (!Asistio)
        {
            turnoFinal = "Ausente";
        }
        else if (TimeSpan.TryParse(HoraEntrada, out var tEnt))
        {
            if (tEnt.Hours >= 18) turnoFinal = "Nocturno";
            else if (tEnt.Hours >= 13) turnoFinal = "Mixto";
            else turnoFinal = "Diurno";
        }

        var modificado = new EmpleadoJornadaItem
        {
            Id = ItemOriginal.Id,
            IdEmpleado = ItemOriginal.IdEmpleado,
            CodigoEmpleado = ItemOriginal.CodigoEmpleado,
            NombreEmpleado = ItemOriginal.NombreEmpleado,
            Cliente = Cliente,
            Area = Area,
            Puesto = Puesto,
            TipoEmpleado = TipoEmpleado,
            ClienteOrigenNomina = ClienteOrigenNomina,
            Asistio = Asistio,
            HoraEntrada = Asistio ? HoraEntrada : "--:--",
            HoraSalida = Asistio ? HoraSalida : "--:--",
            TiempoComida = Asistio ? TiempoComida.ToString("F2", CultureInfo.InvariantCulture) : "0",
            VtcoTrasp = Asistio ? VtcoTrasp : 0m,
            VtcoAlim = Asistio ? VtcoAlim : 0m,
            BonoBnc = Asistio ? BonoBnc : 0m,
            Bnc = Asistio ? BonoBnc.ToString("F2", CultureInfo.InvariantCulture) : "0",
            Observaciones = Observaciones,
            TurnoNombre = turnoFinal,
            Estado = ItemOriginal.Estado,
            TicketRedmineId = ItemOriginal.TicketRedmineId,
            TicketViaticoId = ItemOriginal.TicketViaticoId,
            TicketBonoId = ItemOriginal.TicketBonoId,
            TicketAusenciaId = ItemOriginal.TicketAusenciaId,
            TipoAusencia = ItemOriginal.TipoAusencia,
            FechaInicioAusencia = ItemOriginal.FechaInicioAusencia,
            FechaFinAusencia = ItemOriginal.FechaFinAusencia,
            DiasAusencia = ItemOriginal.DiasAusencia,
            VacacionesTipo = ItemOriginal.VacacionesTipo,
            Modificado = true
        };

        MudDialog.Close(DialogResult.Ok(new ResultadoEdicionAsistencia
        {
            EmpleadoModificado = modificado,
            AplicarCuadreHorasExtras = AplicarCuadreHorasExtras && Asistio,
            HorasExtrasAutorizadas = Asistio ? Math.Round(Math.Max(0m, HorasExtrasEdit), 2) : 0m,
            HoraInicioExtra = HoraInicioExtraEdit,
            HoraFinExtra = HoraFinExtraEdit
        }));
    }
}
