@using MudBlazor
@using System.Globalization
@using Modelo.Admin
@using Modelo.ClasesGenericas

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Editar Asistencia</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <b>#@ItemOriginal.CodigoEmpleado</b> - @ItemOriginal.NombreEmpleado
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @* Cliente y Área *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Cliente / Operación" Value="Cliente" ValueChanged="@OnClienteChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in ObtenerClientesDisponibles())
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Área de Trabajo" @bind-Value="Area" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var a in areasFiltradas)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Puesto y Tipo de Empleado *@
                <MudItem xs="12" md="7">
                    <MudSelect T="string" Label="Puesto / Cargo" @bind-Value="Puesto" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudSelect T="string" Label="Condición / Tipo" @bind-Value="TipoEmpleado" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("Permanente")">Permanente</MudSelectItem>
                        <MudSelectItem Value="@("Temporal")">Temporal</MudSelectItem>
                        <MudSelectItem Value="@("Prestamo")">Préstamo</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Asistencia (Presente / Ausente) *@
                <MudItem xs="12">
                    <div class="d-flex align-center justify-space-between p-2 rounded-lg" style="background: #f1f5f9;">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@(Asistio ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" 
                                     Color="@(Asistio ? Color.Success : Color.Error)" />
                            <MudText Typo="Typo.body2" Class="fw-bold">
                                Estado: <span style="@(Asistio ? "color: #16a34a;" : "color: #dc2626;")">@(Asistio ? "PRESENTE" : "AUSENTE")</span>
                            </MudText>
                        </div>
                        <MudSwitch @bind-Value="Asistio" Color="Color.Success" UnCheckedColor="Color.Error" />
                    </div>
                </MudItem>

                @if (string.Equals(TipoEmpleado, "Prestamo", StringComparison.OrdinalIgnoreCase) || !string.IsNullOrWhiteSpace(ClienteOrigenNomina))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-1" Icon="@Icons.Material.Filled.SwapHoriz">
                            Colaborador en <b>Préstamo</b> para este cliente. Su asistencia se registrará en <b>@Cliente</b> manteniendo su nómina en el cliente de origen.
                        </MudAlert>
                        <MudSelect T="string" 
                                   Label="Cliente de Origen / Nómina (Préstamo)" 
                                   @bind-Value="ClienteOrigenNomina" 
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense" 
                                   Dense="true"
                                   HelperText="Cliente al que pertenece legalmente la nómina del trabajador">
                            <MudSelectItem Value="@("")">-- Seleccionar Origen --</MudSelectItem>
                            @foreach (var cNom in ObtenerClientesNomina())
                            {
                                <MudSelectItem Value="@cNom">@cNom</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @* Horario y Comida *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Horario y Tiempo de Comida
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Entrada" @bind-Value="HoraEntrada" Disabled="@(!Asistio)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="06:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Salida" @bind-Value="HoraSalida" Disabled="@(!Asistio)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="14:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     Label="Tiempo Comida (Horas)" 
                                     @bind-Value="TiempoComida" 
                                     Disabled="@(!Asistio)"
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     Max="24" 
                                     Step="0.5m" 
                                     Format="0.00" 
                                     Adornment="Adornment.End" 
                                     AdornmentText="hrs" />
                </MudItem>

                @* Viáticos y Bonos *@
                @if (Asistio)
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-1" />
                        <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                            Viáticos y Bono del Día
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" 
                                         @bind-Value="VtcoTrasp" 
                                         Label="Transporte (C$)" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Min="0" 
                                         HideSpinButtons="true" 
                                         Format="N2" 
                                         Adornment="Adornment.Start" 
                                         AdornmentText="C$" />
                        <div class="d-flex gap-1 mt-1">
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoTrasp = 0)">C$ 0</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 35 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 35)">35</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 50)">50</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 70)">70</MudChip>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" 
                                         @bind-Value="VtcoAlim" 
                                         Label="Alimentación (C$)" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Min="0" 
                                         HideSpinButtons="true" 
                                         Format="N2" 
                                         Adornment="Adornment.Start" 
                                         AdornmentText="C$" />
                        <div class="d-flex gap-1 mt-1">
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoAlim = 0)">C$ 0</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 50)">50</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 70)">70</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 100)">100</MudChip>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" 
                                         @bind-Value="BonoBnc" 
                                         Label="Bono BNC (C$)" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Min="0" 
                                         HideSpinButtons="true" 
                                         Format="N2" 
                                         Adornment="Adornment.Start" 
                                         AdornmentText="C$" />
                        <div class="d-flex gap-1 mt-1">
                            <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => BonoBnc = 0)">C$ 0</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 100)">100</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 150 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 150)">150</MudChip>
                        </div>
                    </MudItem>
                }

                @* Observaciones *@
                <MudItem xs="12">
                    <MudTextField T="string" 
                                  Label="Observaciones del Día" 
                                  @bind-Value="Observaciones" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  Lines="2" 
                                  Placeholder="Anotaciones de la jornada o motivo de préstamo..." />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" 
                   Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Save">
            Guardar Cambios
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public EmpleadoJornadaItem ItemOriginal { get; set; } = new();
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public List<string> ClientesSugeridos { get; set; } = new();
    [Parameter] public Dictionary<string, List<string>> AreasPorCliente { get; set; } = new();
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();
    [Parameter] public List<string> ClientesAsignadosSupervisor { get; set; } = new();

    private string Cliente { get; set; } = string.Empty;
    private string Area { get; set; } = string.Empty;
    private string Puesto { get; set; } = string.Empty;
    private string TipoEmpleado { get; set; } = "Permanente";
    private string ClienteOrigenNomina { get; set; } = string.Empty;
    private bool Asistio { get; set; } = true;
    private string HoraEntrada { get; set; } = "06:00";
    private string HoraSalida { get; set; } = "14:00";
    private decimal TiempoComida { get; set; } = 1.00m;
    private decimal VtcoTrasp { get; set; } = 0;
    private decimal VtcoAlim { get; set; } = 0;
    private decimal BonoBnc { get; set; } = 0;
    private string Observaciones { get; set; } = string.Empty;

    private List<string> areasFiltradas = new();

    protected override void OnInitialized()
    {
        Cliente = ItemOriginal.Cliente ?? "";
        Area = ItemOriginal.Area ?? "";
        Puesto = ItemOriginal.Puesto ?? "";
        TipoEmpleado = !string.IsNullOrWhiteSpace(ItemOriginal.TipoEmpleado) ? ItemOriginal.TipoEmpleado : "Permanente";
        ClienteOrigenNomina = ItemOriginal.ClienteOrigenNomina ?? "";
        Asistio = ItemOriginal.Asistio;
        HoraEntrada = ItemOriginal.HoraEntrada ?? "06:00";
        HoraSalida = ItemOriginal.HoraSalida ?? "14:00";

        if (decimal.TryParse(ItemOriginal.TiempoComida, NumberStyles.Any, CultureInfo.InvariantCulture, out var tComida))
        {
            TiempoComida = tComida;
        }

        VtcoTrasp = ItemOriginal.VtcoTrasp;
        VtcoAlim = ItemOriginal.VtcoAlim;

        BonoBnc = ItemOriginal.BonoBnc;

        Observaciones = ItemOriginal.Observaciones ?? "";

        CargarAreasCliente(Cliente);
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        Cliente = nuevoCliente;
        CargarAreasCliente(nuevoCliente);

        // Si cambia a un cliente distinto del original, sugerir condición de Préstamo
        if (!string.Equals(ItemOriginal.Cliente, nuevoCliente, StringComparison.OrdinalIgnoreCase))
        {
            TipoEmpleado = "Prestamo";
            if (string.IsNullOrWhiteSpace(ClienteOrigenNomina))
            {
                ClienteOrigenNomina = ItemOriginal.Cliente;
            }
        }
    }

    private void CargarAreasCliente(string cliente)
    {
        areasFiltradas = new List<string>();
        if (!string.IsNullOrWhiteSpace(cliente))
        {
            foreach (var kvp in AreasPorCliente)
            {
                if (string.Equals(kvp.Key, cliente, StringComparison.OrdinalIgnoreCase))
                {
                    areasFiltradas = kvp.Value.Where(a => !string.IsNullOrWhiteSpace(a)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                    break;
                }
            }
        }

        if (!areasFiltradas.Any())
        {
            areasFiltradas = new List<string> { "Operaciones", "Almacen", "Rampa", "Control de calidad", "General" };
        }

        if (!string.IsNullOrWhiteSpace(Area) && !areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            areasFiltradas.Insert(0, Area);
        }
        else if (string.IsNullOrWhiteSpace(Area) || !areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasFiltradas.FirstOrDefault() ?? "Operaciones";
        }
    }

    private List<string> ObtenerClientesDisponibles()
    {
        var lista = new List<string>();
        if (ClientesSugeridos != null) lista.AddRange(ClientesSugeridos);
        if (ClientesAsignadosSupervisor != null) lista.AddRange(ClientesAsignadosSupervisor);
        if (OperacionesDisponibles != null) lista.AddRange(OperacionesDisponibles.Select(o => o.nombre));
        if (!string.IsNullOrWhiteSpace(Cliente) && !lista.Contains(Cliente, StringComparer.OrdinalIgnoreCase)) lista.Add(Cliente);
        return lista.Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c).ToList();
    }

    private List<string> ObtenerClientesNomina() => ObtenerClientesDisponibles();

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        var modificado = new EmpleadoJornadaItem
        {
            Id = ItemOriginal.Id,
            IdEmpleado = ItemOriginal.IdEmpleado,
            CodigoEmpleado = ItemOriginal.CodigoEmpleado,
            NombreEmpleado = ItemOriginal.NombreEmpleado,
            Cliente = Cliente,
            Area = Area,
            Puesto = Puesto,
            TipoEmpleado = TipoEmpleado,
            ClienteOrigenNomina = ClienteOrigenNomina,
            Asistio = Asistio,
            HoraEntrada = Asistio ? HoraEntrada : "--:--",
            HoraSalida = Asistio ? HoraSalida : "--:--",
            TiempoComida = Asistio ? TiempoComida.ToString("F2", CultureInfo.InvariantCulture) : "0",
            VtcoTrasp = Asistio ? VtcoTrasp : 0m,
            VtcoAlim = Asistio ? VtcoAlim : 0m,
            BonoBnc = Asistio ? BonoBnc : 0m,
            Bnc = Asistio ? BonoBnc.ToString("F2", CultureInfo.InvariantCulture) : "0",
            Observaciones = Observaciones,
            TurnoNombre = Asistio ? ItemOriginal.TurnoNombre : "Ausente",
            Estado = ItemOriginal.Estado,
            TicketRedmineId = ItemOriginal.TicketRedmineId,
            TicketViaticoId = ItemOriginal.TicketViaticoId,
            TicketBonoId = ItemOriginal.TicketBonoId,
            TicketAusenciaId = ItemOriginal.TicketAusenciaId,
            TipoAusencia = ItemOriginal.TipoAusencia,
            FechaInicioAusencia = ItemOriginal.FechaInicioAusencia,
            FechaFinAusencia = ItemOriginal.FechaFinAusencia,
            DiasAusencia = ItemOriginal.DiasAusencia,
            VacacionesTipo = ItemOriginal.VacacionesTipo,
            Modificado = true
        };

        MudDialog.Close(DialogResult.Ok(modificado));
    }
}
