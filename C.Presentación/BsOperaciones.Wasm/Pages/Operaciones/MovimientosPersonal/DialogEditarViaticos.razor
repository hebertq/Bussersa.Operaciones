@using MudBlazor
@using Modelo.ClasesGenericas

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Viáticos & Pago en Nómina</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <b>#@CodigoEmpleado</b> - @NombreEmpleado
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            @* Resumen en Nómina y en Efectivo *@
            <MudPaper Class="pa-3 mb-3" Elevation="0" Style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px;">
                <div class="d-flex justify-space-between align-center">
                    <div class="d-flex align-center gap-4">
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase fw-bold" Style="font-size: 0.72rem;">En Nómina</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Success" Class="fw-bold" Style="line-height: 1.1;">
                                    C$ @BonoBncCalculado.ToString("N2")
                                </MudText>
                            </div>
                        </div>
                        <MudDivider Vertical="true" FlexItem="true" />
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase fw-bold" Style="font-size: 0.72rem;">En Efectivo</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Warning" Class="fw-bold" Style="line-height: 1.1;">
                                    C$ @TotalEfectivo.ToString("N2")
                                </MudText>
                            </div>
                        </div>
                    </div>
                    @if (VtcoTrasp > 0 || VtcoAlim > 0 || BonoExtra > 0)
                    {
                        <MudButton Variant="Variant.Text" 
                                   Color="Color.Error" 
                                   Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="LimpiarTodos">
                            Limpiar
                        </MudButton>
                    }
                </div>
            </MudPaper>

            @* 1. Viático Transporte Encerrado en Grupo con Checkbox Nómina *@
            <MudCard Outlined="true" Class="mb-3 pa-3" Style="@($"border-radius: 10px; border-left: 4px solid {(TraspAplicaNomina ? "#2563eb" : "#f59e0b")};")">
                <div class="d-flex justify-space-between align-center mb-1">
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Size="Size.Small" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Viático Transporte</MudText>
                    </div>
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoTrasp" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="C$"
                                     Style="width: 130px; text-align: right;" />
                </div>
                
                <MudStack Row="true" Spacing="1" Class="my-2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">Atajos:</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoTrasp = 0)">C$ 0</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 35 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 35)">C$ 35</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 50)">C$ 50</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 70)">C$ 70</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 100)">C$ 100</MudChip>
                </MudStack>

                <div class="d-flex align-center justify-space-between pa-2 rounded" style="@($"background: {(TraspAplicaNomina ? "#eff6ff" : "#fffbeb")}; border: 1px dashed {(TraspAplicaNomina ? "#93c5fd" : "#fcd34d")};")">
                    <MudCheckBox @bind-Value="TraspAplicaNomina" Color="Color.Primary" Dense="true" Class="ma-0 pa-0">
                        <MudText Typo="Typo.body2" Class="fw-bold">
                            Aplicar en nómina
                        </MudText>
                    </MudCheckBox>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(TraspAplicaNomina ? Color.Primary : Color.Warning)" Style="height: 20px; font-size: 0.68rem; font-weight: 700;">
                        @(TraspAplicaNomina ? "PAGAR EN NÓMINA" : "PAGAR EN EFECTIVO")
                    </MudChip>
                </div>
            </MudCard>

            @* 2. Viático Alimentación Encerrado en Grupo con Checkbox Nómina *@
            <MudCard Outlined="true" Class="mb-3 pa-3" Style="@($"border-radius: 10px; border-left: 4px solid {(AlimAplicaNomina ? "#2563eb" : "#f59e0b")};")">
                <div class="d-flex justify-space-between align-center mb-1">
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Viático Alimentación</MudText>
                    </div>
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoAlim" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="C$"
                                     Style="width: 130px; text-align: right;" />
                </div>

                <MudStack Row="true" Spacing="1" Class="my-2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">Atajos:</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoAlim = 0)">C$ 0</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="@(() => VtcoAlim = 50)">C$ 50</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="@(() => VtcoAlim = 70)">C$ 70</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="@(() => VtcoAlim = 100)">C$ 100</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 120 ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="@(() => VtcoAlim = 120)">C$ 120</MudChip>
                </MudStack>

                <div class="d-flex align-center justify-space-between pa-2 rounded" style="@($"background: {(AlimAplicaNomina ? "#eff6ff" : "#fffbeb")}; border: 1px dashed {(AlimAplicaNomina ? "#93c5fd" : "#fcd34d")};")">
                    <MudCheckBox @bind-Value="AlimAplicaNomina" Color="Color.Primary" Dense="true" Class="ma-0 pa-0">
                        <MudText Typo="Typo.body2" Class="fw-bold">
                            Aplicar en nómina
                        </MudText>
                    </MudCheckBox>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(AlimAplicaNomina ? Color.Primary : Color.Warning)" Style="height: 20px; font-size: 0.68rem; font-weight: 700;">
                        @(AlimAplicaNomina ? "PAGAR EN NÓMINA" : "PAGAR EN EFECTIVO")
                    </MudChip>
                </div>
            </MudCard>

            @* 3. Bono Adicional Nómina (Opcional) *@
            @if (!OcultarBono)
            {
                <MudCard Outlined="true" Class="mb-3 pa-3" Style="border-radius: 10px;">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Size="Size.Small" Class="mr-1 align-text-bottom" Color="Color.Success" />
                                Bono Adicional Nómina (Opcional):
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Bono extra independiente de transporte y alimentación
                            </MudText>
                        </div>
                        <MudNumericField T="decimal" 
                                         @bind-Value="BonoExtra" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Min="0" 
                                         HideSpinButtons="true"
                                         Format="N2"
                                         Adornment="Adornment.Start"
                                         AdornmentText="C$"
                                         Style="width: 130px; text-align: right;" />
                    </div>
                </MudCard>
            }

            @if (CantidadSeleccionados > 1)
            {
                <MudDivider Class="my-2" />
                <MudCheckBox @bind-Value="AplicarASeleccionados" 
                             Color="Color.Primary" 
                             Dense="true" 
                             Class="mt-1">
                    <MudText Typo="Typo.body2">
                        Aplicar estos mismos viáticos y formas de pago a los otros <b>@(CantidadSeleccionados - 1) colaboradores seleccionados</b>
                    </MudText>
                </MudCheckBox>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="Confirmar">Guardar Viáticos</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int CodigoEmpleado { get; set; }
    [Parameter] public string NombreEmpleado { get; set; } = string.Empty;
    [Parameter] public decimal VtcoTraspInicial { get; set; } = 0;
    [Parameter] public decimal VtcoAlimInicial { get; set; } = 0;
    [Parameter] public decimal BonoBncInicial { get; set; } = 0;
    [Parameter] public bool TraspAplicaNominaInicial { get; set; } = false;
    [Parameter] public bool AlimAplicaNominaInicial { get; set; } = false;
    [Parameter] public int CantidadSeleccionados { get; set; } = 0;
    [Parameter] public bool OcultarBono { get; set; } = false;

    public decimal VtcoTrasp { get; set; } = 0;
    public decimal VtcoAlim { get; set; } = 0;
    public bool TraspAplicaNomina { get; set; } = false;
    public bool AlimAplicaNomina { get; set; } = false;
    public decimal BonoExtra { get; set; } = 0;
    public bool AplicarASeleccionados { get; set; } = false;

    public decimal BonoBncCalculado => (TraspAplicaNomina ? VtcoTrasp : 0) + (AlimAplicaNomina ? VtcoAlim : 0) + BonoExtra;
    public decimal TotalEfectivo => (TraspAplicaNomina ? 0 : VtcoTrasp) + (AlimAplicaNomina ? 0 : VtcoAlim);

    protected override void OnInitialized()
    {
        VtcoTrasp = VtcoTraspInicial;
        VtcoAlim = VtcoAlimInicial;
        TraspAplicaNomina = TraspAplicaNominaInicial;
        AlimAplicaNomina = AlimAplicaNominaInicial;

        // Auto-detección de checkboxes si vienen de datos anteriores con BonoBnc > 0 y flags en false
        if (!TraspAplicaNomina && !AlimAplicaNomina && BonoBncInicial > 0)
        {
            if (VtcoTrasp > 0 && VtcoAlim > 0 && BonoBncInicial >= (VtcoTrasp + VtcoAlim))
            {
                TraspAplicaNomina = true;
                AlimAplicaNomina = true;
            }
            else if (VtcoTrasp > 0 && BonoBncInicial >= VtcoTrasp)
            {
                TraspAplicaNomina = true;
            }
            else if (VtcoAlim > 0 && BonoBncInicial >= VtcoAlim)
            {
                AlimAplicaNomina = true;
            }
        }

        decimal baseViaticosNomina = (TraspAplicaNomina ? VtcoTrasp : 0) + (AlimAplicaNomina ? VtcoAlim : 0);
        BonoExtra = Math.Max(0, BonoBncInicial - baseViaticosNomina);
    }

    private void LimpiarTodos()
    {
        VtcoTrasp = 0;
        VtcoAlim = 0;
        TraspAplicaNomina = false;
        AlimAplicaNomina = false;
        BonoExtra = 0;
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Confirmar()
    {
        MudDialog.Close(DialogResult.Ok(new ResultadoEdicionViaticos
        {
            VtcoTrasp = this.VtcoTrasp,
            VtcoAlim = this.VtcoAlim,
            TraspAplicaNomina = this.TraspAplicaNomina,
            AlimAplicaNomina = this.AlimAplicaNomina,
            BonoBnc = this.BonoBncCalculado,
            AplicarASeleccionados = this.AplicarASeleccionados
        }));
    }

    public class ResultadoEdicionViaticos
    {
        public decimal VtcoTrasp { get; set; }
        public decimal VtcoAlim { get; set; }
        public bool TraspAplicaNomina { get; set; }
        public bool AlimAplicaNomina { get; set; }
        public decimal BonoBnc { get; set; }
        public bool AplicarASeleccionados { get; set; }
    }
}
