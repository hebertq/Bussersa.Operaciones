@page "/operaciones/movimientos-personal-excel"
@using Modelo.ClasesGenericas
@using Modelo.Admin
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    @* Encabezado Principal *@
    <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-left: 5px solid #1E88E5; border-radius: 8px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.GroupWork" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Class="fw-bold">Carga de Movimientos de Personal (Excel a Redmine)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Importa jornadas y agrupaciones desde la pestaña <strong>Consolidado Agrupado</strong> y genera automáticamente los tickets en Redmine.
                    </MudText>
                </div>
            </MudStack>
            @if (filasExcel.Any())
            {
                <MudStack Row="true" Spacing="2">
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                        Total: @filasExcel.Count
                    </MudChip>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                        Seleccionadas: @filasExcel.Count(x => x.Seleccionado)
                    </MudChip>
                    @if (totalExitosos > 0)
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                            Movimientos: @totalExitosos
                        </MudChip>
                    }
                    @if (totalViaticosCreados > 0)
                    {
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Payments">
                            Viáticos: @totalViaticosCreados
                        </MudChip>
                    }
                    @if (totalFallidos > 0)
                    {
                        <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Error">
                            Errores: @totalFallidos
                        </MudChip>
                    }
                </MudStack>
            }
        </MudStack>
    </MudPaper>

    @* Panel de Configuración y Carga *@
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudGrid>
                @* 1. Selector de Operación / Cliente *@
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" 
                               Label="Cliente de la Operación" 
                               Value="@selectedOperacionId" 
                               ValueChanged="OnOperacionChanged"
                               Placeholder="Seleccione el cliente..."
                               Variant="Variant.Outlined"
                               Dense="true"
                               AdornmentIcon="@Icons.Material.Filled.Business" 
                               AdornmentColor="Color.Primary">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- Seleccione un cliente --</MudSelectItem>
                        @foreach (var op in operacionesList)
                        {
                            <MudSelectItem T="int?" Value="@((int?)op.id)">@($"{op.id}-{op.nombre}")</MudSelectItem>
                        }
                    </MudSelect>
                    @if (!string.IsNullOrEmpty(clienteRedmineIdentificador))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="mt-1 d-block">
                            Cliente Redmine: <strong>@clienteRedmineIdentificador</strong>
                        </MudText>
                    }
                </MudItem>

                @* 2. Subida de Archivo Excel *@
                <MudItem xs="12" sm="6" md="5">
                    <MudFileUpload T="IBrowserFile" 
                                   Accept=".xlsx" 
                                   FilesChanged="OnExcelFileSelected"
                                   Class="d-flex align-center">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Custom.FileFormats.FileExcel"
                                       Disabled="@estaCargandoArchivo"
                                       Size="Size.Medium">
                                @(estaCargandoArchivo ? "Leyendo archivo..." : "Seleccionar Excel (.xlsx)")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (archivoExcel != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Dark" Class="mt-1 d-block text-truncate">
                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                            @archivoExcel.Name (@((archivoExcel.Size / 1024.0).ToString("N1")) KB)
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                            Debe contener la pestaña <em>Consolidado Agrupado</em>.
                        </MudText>
                    }
                </MudItem>

                @* 3. Filtro por Fecha (si hay datos) *@
                <MudItem xs="12" sm="6" md="3">
                    @if (fechasDisponibles.Any())
                    {
                        <MudSelect T="string" 
                                   Label="Filtrar por Fecha" 
                                   Value="@filtroFecha" 
                                   ValueChanged="OnFiltroFechaChanged"
                                   Variant="Variant.Outlined" 
                                   Dense="true">
                            <MudSelectItem T="string" Value="@("TODAS")">Todas las fechas (@filasExcel.Count)</MudSelectItem>
                            @foreach (var f in fechasDisponibles)
                            {
                                <MudSelectItem T="string" Value="@f">@f (@filasExcel.Count(x => x.Fecha == f))</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                @* 4. Selector Estético de Modo de Generación *@
                @if (filasExcel.Any())
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-3 rounded-lg" Style="background-color: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-lines-default);">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="mr-1" />
                                        Modo de Creación en Redmine:
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Seleccione qué tipos de tickets se enviarán a Redmine para las jornadas seleccionadas.
                                    </MudText>
                                </div>
                                <MudToggleGroup T="ModoGeneracionTickets" 
                                                Value="@modoSeleccionado" 
                                                ValueChanged="@((ModoGeneracionTickets m) => { modoSeleccionado = m; StateHasChanged(); })" 
                                                Color="Color.Primary" 
                                                CheckMark="true" 
                                                FixedContent="true" 
                                                Disabled="@estaProcesando">
                                    <MudToggleItem Value="@ModoGeneracionTickets.Ambos">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Small" Color="Color.Primary" />
                                            <span>Ambos (Movimientos + Viáticos)</span>
                                        </MudStack>
                                    </MudToggleItem>
                                    <MudToggleItem Value="@ModoGeneracionTickets.SoloMovimientos">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Info" />
                                            <span>Solo Movimientos</span>
                                        </MudStack>
                                    </MudToggleItem>
                                    <MudToggleItem Value="@ModoGeneracionTickets.SoloViaticos">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Color="Color.Success" />
                                            <span>Solo Viáticos</span>
                                        </MudStack>
                                    </MudToggleItem>
                                </MudToggleGroup>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>

        @* Barra de progreso de lectura *@
        @if (estaCargandoArchivo)
        {
            <MudProgressLinear Color="Color.Success" Indeterminate="true" Class="my-0" />
        }
    </MudCard>

    @* Grilla de Movimientos *@
    @if (filasFiltradas.Any())
    {
        <MudCard Elevation="3" Class="mb-4">
            <MudCardHeader Class="pb-2">
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">
                            Jornadas Detectadas en el Consolidado (@filasFiltradas.Count)
                        </MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.SelectAll"
                                       OnClick="SeleccionarTodo">
                                Seleccionar Todos
                            </MudButton>
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Secondary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.Deselect"
                                       OnClick="DeseleccionarTodo">
                                Deseleccionar
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-0">
                <MudTable Items="@filasFiltradas" 
                          Hover="true" 
                          Dense="true" 
                          Striped="true" 
                          Bordered="true" 
                          Elevation="0"
                          Virtualize="true"
                          FixedHeader="true"
                          Height="520px">
                    <HeaderContent>
                        <MudTh Style="width: 50px; text-align: center;">Sel.</MudTh>
                        <MudTh Style="min-width: 140px;">Tickets Redmine</MudTh>
                        <MudTh>Área del Cliente</MudTh>
                        <MudTh>Cargo / Puesto</MudTh>
                        <MudTh Style="width: 100px; text-align: center;">Fecha</MudTh>
                        <MudTh Style="width: 110px; text-align: center;">Horario</MudTh>
                        <MudTh Style="width: 70px; text-align: center;">Recursos</MudTh>
                        <MudTh Style="width: 95px; text-align: center;">Vtco Trasp</MudTh>
                        <MudTh Style="width: 95px; text-align: center;">Vtco Alim</MudTh>
                        <MudTh Style="min-width: 150px;">IDs Empleados</MudTh>
                        <MudTh Style="min-width: 180px;">Asunto del Ticket</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="text-align: center;">
                            <MudCheckBox @bind-Value="@context.Seleccionado" 
                                         Color="Color.Primary" 
                                         Dense="true" 
                                         Disabled="@(context.Estado == EstadoCreacion.Exitoso || estaProcesando)" />
                        </MudTd>
                        <MudTd>
                            <MudStack Spacing="1">
                                @if (context.RedmineIssueId.HasValue)
                                {
                                    <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{context.RedmineIssueId.Value}")" 
                                             Target="_blank" 
                                             Underline="Underline.Always">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.OpenInNew">
                                            Mov #@context.RedmineIssueId.Value
                                        </MudChip>
                                    </MudLink>
                                }
                                @if (context.RedmineViaticosIssueId.HasValue)
                                {
                                    <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{context.RedmineViaticosIssueId.Value}")" 
                                             Target="_blank" 
                                             Underline="Underline.Always">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Payments">
                                            Viat #@context.RedmineViaticosIssueId.Value
                                        </MudChip>
                                    </MudLink>
                                }
                                @if (!context.RedmineIssueId.HasValue && !context.RedmineViaticosIssueId.HasValue)
                                {
                                    @if (context.Estado == EstadoCreacion.Pendiente)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Pendiente</MudChip>
                                    }
                                    else if (context.Estado == EstadoCreacion.EnProceso)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Creando...</MudChip>
                                    }
                                    else if (context.Estado == EstadoCreacion.Exitoso)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Creado</MudChip>
                                    }
                                }
                                @if (context.Estado == EstadoCreacion.Fallido)
                                {
                                    <MudTooltip Text="@context.MensajeError" Color="Color.Error">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.ErrorOutline">
                                            Error
                                        </MudChip>
                                    </MudTooltip>
                                }
                            </MudStack>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2" Class="fw-bold">@context.Area</MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2">@context.Cargo</MudText>
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            <MudText Typo="Typo.body2">@context.FechaFormateada</MudText>
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                                @($"{context.HoraInicio} - {context.HoraFin}")
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            <MudBadge Content="@context.CantidadEmpleados" Color="Color.Info" Overlap="false" Class="d-inline-block">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            </MudBadge>
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            @if (EsMontoValido(context.VtcoTrasp))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                    @context.VtcoTrasp
                                </MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            @if (EsMontoValido(context.VtcoAlim))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                                    @context.VtcoAlim
                                </MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            <MudTooltip Text="@context.IdsEmpleados">
                                <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 180px;">
                                    @context.IdsEmpleados
                                </MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd>
                            <MudTextField @bind-Value="@context.Asunto" 
                                          Margin="Margin.Dense" 
                                          Variant="Variant.Outlined" 
                                          Disabled="@(context.Estado == EstadoCreacion.Exitoso || estaProcesando)" 
                                          Class="py-0" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="6" Class="fw-bold text-end">Total de Colaboradores Seleccionados:</MudTd>
                        <MudTd Style="text-align: center;" Class="fw-bold">
                            @filasFiltradas.Where(x => x.Seleccionado).Sum(x => x.CantidadEmpleados)
                        </MudTd>
                        <MudTd colspan="4"></MudTd>
                    </FooterContent>
                </MudTable>
            </MudCardContent>

            @* Barra de progreso de envío a Redmine *@
            @if (estaProcesando)
            {
                <MudCardContent Class="py-2">
                    <MudProgressLinear Color="Color.Primary" Value="@progresoEnvio" Class="my-1" />
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="d-block text-center">
                        Procesando @progresoActual de @progresoTotal tickets en Redmine (@progresoEnvio%)...
                    </MudText>
                </MudCardContent>
            }

            @* Botones de Acción *@
            <MudCardActions Class="pa-4 d-flex justify-space-between align-center">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Secondary" 
                           StartIcon="@Icons.Material.Filled.Clear"
                           Disabled="@estaProcesando"
                           OnClick="LimpiarTodo">
                    Limpiar Grilla
                </MudButton>

                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Disabled="@(!PuedeCrear)"
                           OnClick="ConfirmarYCrearMovimientos">
                    @TextoBotonCrear
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudContainer>
