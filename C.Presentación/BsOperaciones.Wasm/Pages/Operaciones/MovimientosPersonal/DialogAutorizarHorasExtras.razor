@using MudBlazor
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@inject IOdooService _odooService
@inject ISnackbar _snackbar
@inject NavigationManager _nav

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center gap-2">
                <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.MoreTime" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold" Style="line-height: 1.2;">
                        Horas Extras por Área según Regla (Helpdesk)
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Cliente: <b>@ClienteNombre</b> &bull; Fecha: <b>@Fecha.ToString("dd/MM/yyyy")</b>
                    </MudText>
                </div>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div style="max-height: 74vh; overflow-y: auto; padding-right: 4px;">
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                Solo se muestran las <b>Áreas y colaboradores que superan su jornada ordinaria según la regla del Área/Turno</b>. Se genera <b>1 ticket por Área</b> en Helpdesk con los carnets separados por coma en la descripción (igual que Movimientos).
            </MudAlert>

            @if (CandidatosConExtras == null || !CandidatosConExtras.Any())
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="my-2">
                    Ningún colaborador presente en la jornada del <b>@Fecha.ToString("dd/MM/yyyy")</b> supera las horas ordinarias de su Área y Turno según la regla configurada.
                </MudAlert>
            }
            else
            {
                <MudPaper Class="pa-3 mb-3 rounded-lg" Elevation="0" Style="background: #f8fafc; border: 1px solid #e2e8f0;">
                    <MudGrid Spacing="2" Class="mb-3">
                        <MudItem xs="12" sm="5">
                            <div class="text-caption fw-bold text-secondary mb-1">Área del Cliente (solo con Horas Extras)</div>
                            <MudSelect T="string"
                                       Value="@areaFiltroSeleccionada"
                                       ValueChanged="@OnAreaFiltroChanged"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Style="background: white;">
                                <MudSelectItem T="string" Value="@("TODAS")">Todas las Áreas con Extras (@AreasDisponibles.Count áreas • @CandidatosConExtras.Count pers.)</MudSelectItem>
                                @foreach (var ar in AreasDisponibles)
                                {
                                    int cantArea = CandidatosConExtras.Count(c => string.Equals(NormalizarArea(c.Area), ar, StringComparison.OrdinalIgnoreCase));
                                    decimal sumHeArea = CandidatosConExtras
                                        .Where(c => string.Equals(NormalizarArea(c.Area), ar, StringComparison.OrdinalIgnoreCase))
                                        .Sum(c => c.HorasExtrasAutorizadas);
                                    <MudSelectItem T="string" Value="@ar">@ar (@cantArea pers. • @sumHeArea.ToString("N2") hrs)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <div class="text-caption fw-bold text-secondary mb-1">Buscar colaborador</div>
                            <MudTextField @bind-Value="busquedaCandidato"
                                          Placeholder="Carnet o nombre..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Style="background: white;" />
                        </MudItem>
                        <MudItem xs="12" sm="3" Class="d-flex align-end gap-1">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       FullWidth="true"
                                       Style="height: 40px;"
                                       OnClick="@SeleccionarFiltrados">
                                @(areaFiltroSeleccionada == "TODAS" ? "Marcar Todas" : "Marcar Área")
                            </MudButton>
                            @if (ColaboradoresSeleccionados.Any())
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.ClearAll"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Title="Desmarcar todos"
                                               OnClick="@LimpiarSeleccionColaboradores" />
                            }
                        </MudItem>
                    </MudGrid>

                    @foreach (var grupo in CandidatosFiltrados.GroupBy(c => NormalizarArea(c.Area), StringComparer.OrdinalIgnoreCase))
                    {
                        decimal sumaArea = grupo.Sum(x => x.HorasExtrasAutorizadas);
                        <div class="mb-2 rounded overflow-hidden" style="background: #ffffff; border: 1px solid #cbd5e1;">
                            <div class="px-3 py-1 d-flex align-center justify-space-between" style="background: #eff6ff; border-bottom: 1px solid #cbd5e1;">
                                <span class="fw-bold" style="color: #013161; font-size: 0.84rem;">
                                    Área: @grupo.Key (@grupo.Count() colaborador@(grupo.Count() == 1 ? "" : "es"))
                                </span>
                                <span class="badge bg-warning text-dark fw-bold" style="font-size: 0.76rem;">
                                    Total Área: @sumaArea.ToString("N2") hrs extra
                                </span>
                            </div>
                            <div class="px-3 py-1">
                                @foreach (var cand in grupo)
                                {
                                    bool sel = CodigosSeleccionados.Contains(cand.CodigoEmpleado);
                                    <div class="d-flex align-center justify-space-between py-1 border-bottom flex-wrap gap-1" style="font-size: 0.81rem;">
                                        <MudCheckBox T="bool" Dense="true" Color="Color.Primary"
                                                     Value="@sel"
                                                     ValueChanged="@((bool val) => ToggleCandidato(cand, val))"
                                                     Label="@($"#{cand.CodigoEmpleado} - {cand.NombreEmpleado}")" />
                                        <div class="d-flex align-center gap-2 font-monospace">
                                            <span class="text-secondary" style="font-size: 0.76rem;">
                                                Jornada: @cand.HoraEntradaJornada - @cand.HoraSalidaJornada
                                            </span>
                                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold my-0">
                                                +@cand.HorasExtrasAutorizadas.ToString("N2") hrs (@cand.HoraInicioExtra - @cand.HoraFinExtra)
                                            </MudChip>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </MudPaper>

                <MudTextField @bind-Value="Motivo"
                              Label="Observaciones (se envía al campo Observaciones en Helpdesk)"
                              Placeholder="Ej: Descarga de contenedor / cierre de despacho autorizado por el cliente..."
                              Lines="2"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@Cancelar" Disabled="@enviando">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@(enviando ? null : Icons.Material.Filled.ConfirmationNumber)"
                   OnClick="@EnviarAutorizacion"
                   Disabled="@(enviando || !ColaboradoresSeleccionados.Any())"
                   Style="font-weight: 800;">
            @if (enviando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Surface" />
                <span>Generando Ticket(s) por Área...</span>
            }
            else
            {
                <span>Generar Ticket por Área (@AreasSeleccionadasCount área@(AreasSeleccionadasCount == 1 ? "" : "s") • @ColaboradoresSeleccionados.Count pers.)</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int OperacionId { get; set; }
    [Parameter] public string ClienteNombre { get; set; } = string.Empty;
    [Parameter] public DateTime Fecha { get; set; } = DateTime.Today;
    [Parameter] public string SupervisorInicial { get; set; } = string.Empty;
    [Parameter] public string UsuarioRegistro { get; set; } = string.Empty;
    [Parameter] public List<ColaboradorAutorizacionItemDto> ColaboradoresIniciales { get; set; } = new();
    [Parameter] public List<ColaboradorAutorizacionItemDto> CandidatosDisponibles { get; set; } = new();

    private HashSet<int> CodigosSeleccionados = new();
    private List<ColaboradorAutorizacionItemDto> ColaboradoresSeleccionados = new();
    private string areaFiltroSeleccionada = "TODAS";
    private string busquedaCandidato = string.Empty;
    private string Motivo = string.Empty;
    private bool enviando = false;

    private static string NormalizarArea(string? area) =>
        string.IsNullOrWhiteSpace(area) ? "Operaciones" : area.Trim();

    private List<ColaboradorAutorizacionItemDto> CandidatosConExtras =>
        (CandidatosDisponibles ?? new List<ColaboradorAutorizacionItemDto>())
            .Where(c => c.HorasExtrasAutorizadas > 0m)
            .OrderBy(c => NormalizarArea(c.Area))
            .ThenBy(c => c.NombreEmpleado)
            .ToList();

    private List<string> AreasDisponibles =>
        CandidatosConExtras
            .Select(c => NormalizarArea(c.Area))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a)
            .ToList();

    private int AreasSeleccionadasCount =>
        ColaboradoresSeleccionados
            .Select(c => NormalizarArea(c.Area))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private List<ColaboradorAutorizacionItemDto> CandidatosFiltrados
    {
        get
        {
            IEnumerable<ColaboradorAutorizacionItemDto> q = CandidatosConExtras;
            if (!string.IsNullOrWhiteSpace(areaFiltroSeleccionada) && areaFiltroSeleccionada != "TODAS")
            {
                q = q.Where(c => string.Equals(NormalizarArea(c.Area), areaFiltroSeleccionada, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(busquedaCandidato))
            {
                string term = busquedaCandidato.Trim();
                q = q.Where(c =>
                    c.CodigoEmpleado.ToString().Contains(term) ||
                    (!string.IsNullOrWhiteSpace(c.NombreEmpleado) && c.NombreEmpleado.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    NormalizarArea(c.Area).Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return q.OrderBy(c => NormalizarArea(c.Area)).ThenBy(c => c.NombreEmpleado).ToList();
        }
    }

    protected override void OnInitialized()
    {
        var inicialesValidos = (ColaboradoresIniciales ?? new List<ColaboradorAutorizacionItemDto>())
            .Where(c => c.HorasExtrasAutorizadas > 0m)
            .ToList();

        if (inicialesValidos.Any())
        {
            foreach (var c in inicialesValidos)
            {
                if (CodigosSeleccionados.Add(c.CodigoEmpleado))
                    ColaboradoresSeleccionados.Add(c);
            }
            var areasInit = inicialesValidos.Select(c => NormalizarArea(c.Area)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (areasInit.Count == 1)
                areaFiltroSeleccionada = areasInit[0];
        }
        else if (CandidatosConExtras.Any())
        {
            // Por defecto pre-seleccionar todos los colaboradores que tienen extras según la regla
            foreach (var c in CandidatosConExtras)
            {
                if (CodigosSeleccionados.Add(c.CodigoEmpleado))
                    ColaboradoresSeleccionados.Add(c);
            }
        }
    }

    private void OnAreaFiltroChanged(string nuevaArea)
    {
        areaFiltroSeleccionada = string.IsNullOrWhiteSpace(nuevaArea) ? "TODAS" : nuevaArea;
    }

    private void ToggleCandidato(ColaboradorAutorizacionItemDto cand, bool seleccionado)
    {
        if (seleccionado)
        {
            if (CodigosSeleccionados.Add(cand.CodigoEmpleado))
                ColaboradoresSeleccionados.Add(cand);
        }
        else
        {
            CodigosSeleccionados.Remove(cand.CodigoEmpleado);
            ColaboradoresSeleccionados.RemoveAll(x => x.CodigoEmpleado == cand.CodigoEmpleado);
        }
    }

    private void SeleccionarFiltrados()
    {
        foreach (var cand in CandidatosFiltrados)
        {
            if (CodigosSeleccionados.Add(cand.CodigoEmpleado))
                ColaboradoresSeleccionados.Add(cand);
        }
    }

    private void LimpiarSeleccionColaboradores()
    {
        CodigosSeleccionados.Clear();
        ColaboradoresSeleccionados.Clear();
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task EnviarAutorizacion()
    {
        if (!ColaboradoresSeleccionados.Any())
        {
            _snackbar.Add("Seleccione al menos un colaborador con horas extras según la regla.", Severity.Warning);
            return;
        }

        string obs = string.IsNullOrWhiteSpace(Motivo)
            ? "Horas extras según regla del Área/Turno"
            : Motivo.Trim();

        var primero = ColaboradoresSeleccionados.First();
        var req = new CrearAutorizacionHorasExtrasRequestDto
        {
            OperacionId = OperacionId,
            ClienteNombre = ClienteNombre,
            Fecha = Fecha.ToString("yyyy-MM-dd"),
            HoraInicioExtra = string.IsNullOrWhiteSpace(primero.HoraInicioExtra) ? "17:00" : primero.HoraInicioExtra,
            HoraFinExtra = string.IsNullOrWhiteSpace(primero.HoraFinExtra) ? "20:00" : primero.HoraFinExtra,
            HorasExtrasAutorizadas = Math.Round(ColaboradoresSeleccionados.Average(x => x.HorasExtrasAutorizadas), 2),
            Motivo = obs,
            UsuarioRegistro = UsuarioRegistro,
            BaseUrlPortal = _nav.BaseUri.TrimEnd('/'),
            Colaboradores = ColaboradoresSeleccionados
        };

        enviando = true;
        try
        {
            var resp = await _odooService.CrearAutorizacionHorasExtras(req);
            if (resp != null && !resp.Respuesta.ExisteError && resp.Model != null)
            {
                var res = resp.Model;
                if (res.Exitosos > 0)
                {
                    int cantAreas = ColaboradoresSeleccionados.Select(x => NormalizarArea(x.Area)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                    _snackbar.Add($"Se generaron los tickets de Horas Extras para {cantAreas} área(s) ({res.Exitosos} colaborador(es)) en Helpdesk.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(res));
                }
                else
                {
                    string err = res.Detalles.FirstOrDefault()?.Mensaje ?? "No se pudo crear el ticket en Helpdesk.";
                    _snackbar.Add(err, Severity.Error);
                }
            }
            else
            {
                _snackbar.Add(resp?.Respuesta?.MensajeError ?? "Error al procesar la solicitud.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            enviando = false;
        }
    }
}
