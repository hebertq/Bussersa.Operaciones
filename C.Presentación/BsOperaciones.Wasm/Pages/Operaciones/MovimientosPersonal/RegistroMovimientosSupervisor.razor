                                                @if (totBeneficios > 0)
                                                {
                                                    <MudChip T="string" 
                                                             Color="Color.Info" 
                                                             Variant="Variant.Filled" 
                                                             Size="Size.Small" 
                                                             Class="cursor-pointer font-monospace fw-bold" 
                                                             Style="height: 22px; font-size: 0.70rem; white-space: nowrap;" 
                                                             OnClick="@(() => AbrirEditorViaticoIndividual(emp, false))"
                                                             Title="@($"Total Viáticos & Bono: C$ {totBeneficios:N0} (Trasp: C$ {emp.VtcoTrasp:N0}, Alim: C$ {emp.VtcoAlim:N0}, Bono BNC: C$ {emp.BonoBnc:N0})")">
                                                        @($"C$ {totBeneficios:N0}")
                                                    </MudChip>
