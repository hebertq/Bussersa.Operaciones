                                            <option value="2.00">2.0 h</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                    }
                                </MudTd>
                                <MudTd Class="text-center">
                                    @if (context.Asistio)
                                    {
                                        var totalViaticos = context.VtcoTrasp + context.VtcoAlim + context.BonoBnc;
                                        @if (totalViaticos > 0)
                                        {
                                            <MudChip T="string" 
                                                     Color="Color.Success" 
                                                     Variant="Variant.Filled" 
                                                     Size="Size.Small" 
                                                     Class="cursor-pointer font-monospace fw-bold px-2" 
                                                     Style="height: 22px; font-size: 0.75rem;" 
                                                     OnClick="@(() => AbrirEditorViaticoIndividual(context))" 
                                                     Title="@($"Trasp: C$ {context.VtcoTrasp:N0} | Alim: C$ {context.VtcoAlim:N0}{(context.BonoBnc > 0 ? $" | BNC: C$ {context.BonoBnc:N0}" : "")}. Tocar para editar.")">
                                                C$ @totalViaticos.ToString("N0")
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Outlined" 
                                                       Color="Color.Default" 
                                                       Size="Size.Small" 
                                                       Class="px-2 py-0" 
                                                       Style="font-size: 0.72rem; min-height: 22px; text-transform: none; border-color: #cbd5e1;" 
                                                       StartIcon="@Icons.Material.Filled.Add" 
                                                       OnClick="@(() => AbrirEditorViaticoIndividual(context))" 
                                                       Title="Asignar viático a este colaborador">
                                                + Viático
                                            </MudButton>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                   Color="Color.Error" 
                                                   Size="Size.Small" 
                                                   OnClick="@(() => EliminarEmpleadoDeJornada(context))" 
                                                   Title="Quitar de la jornada" />
                                </MudTd>
                            }
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudStack AlignItems="AlignItems.Center" Class="py-6">
                                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.body1" Class="fw-bold">No se encontraron colaboradores que coincidan con '@textoBusqueda'</MudText>
                                @if (!string.IsNullOrWhiteSpace(textoBusqueda))
                                {
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Info" 
                                               Size="Size.Small" 
                                               StartIcon="@Icons.Material.Filled.PersonAdd" 
                                               Class="mt-2" 
                                               OnClick="@(() => AbrirDialogoAgregarColaborador(textoBusqueda))">
                                        Agregar "@textoBusqueda" a la Jornada
                                    </MudButton>
                                }
                            </MudStack>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>

        @* ==========================================
           TAB 2: VIÁTICOS
           ========================================== *@
        <MudTabPanel Text="Viáticos" ToolTip="Viáticos" Icon="@Icons.Material.Filled.AttachMoney" BadgeData="@TotalConViaticos" BadgeColor="Color.Warning">
            <MudPaper Class="pa-3 mt-2" Elevation="0">
                @* Cards de Resumen de Viáticos *@
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-success" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-success) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Total Viáticos</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Success" Class="fw-bold">C$ @TotalViaticosGlobal.ToString("N2")</MudText>
                                </div>
                                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-info" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-info) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Transporte</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Info" Class="fw-bold">C$ @TotalViaticosTrasp.ToString("N2")</MudText>
                                </div>
                                <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-warning" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-warning) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Alimentación</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Warning" Class="fw-bold">C$ @TotalViaticosAlim.ToString("N2")</MudText>
                                </div>
                                <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-primary" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-primary) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Bono BNC</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-bold">C$ @TotalViaticosBnc.ToString("N2")</MudText>
                                </div>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                @* Filtros de Viáticos y Acciones *@
                <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="textoBusquedaViaticos" 
                                      Placeholder="Buscar por nombre, carnet (#) o área..." 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Immediate="true" 
                                      Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudChip T="string" Color="@(filtroViaticos == "CON_VIATICOS" ? Color.Warning : Color.Default)"
                                     Variant="@(filtroViaticos == "CON_VIATICOS" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     Class="fw-bold"
                                     OnClick="@(() => filtroViaticos = "CON_VIATICOS")">
                                Con Viáticos / Bono (@TotalConViaticos)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroViaticos == "TODOS" ? Color.Primary : Color.Default)"
                                     Variant="@(filtroViaticos == "TODOS" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroViaticos = "TODOS")">
                                Todos (@TotalPresentes)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroViaticos == "SIN_VIATICOS" ? Color.Dark : Color.Default)"
                                     Variant="@(filtroViaticos == "SIN_VIATICOS" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroViaticos = "SIN_VIATICOS")">
                                Sin Viáticos (@TotalSinViaticos)
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="flex-wrap">
                            @if (CantidadSeleccionados > 0)
                            {
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Bolt"
                                           OnClick="AsignarViaticosMasivosASeleccionados">
                                    Asignar (@CantidadSeleccionados)
                                </MudButton>
                            }
                            @if (TotalConViaticos > 0)
                            {
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.ClearAll"
                                           OnClick="LimpiarTodosLosViaticos">
                                    Limpiar Todos
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.RocketLaunch"
                                       Disabled="@(estaEnviandoHelpdesk || !gruposConsolidados.Any())"
                                       OnClick="@EnviarAHelpdeskMasivo"
                                       Style="background: linear-gradient(135deg, #1e3a8a, #2563eb); color: white; font-weight: 700; white-space: nowrap;"
                                       Title="Generar y sincronizar tickets de Viáticos y Movimientos en Helpdesk (Redmine)">
                                @(estaEnviandoHelpdesk ? "Generando..." : "Generar Tickets")
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>

                @* Tabla Detallada de Viáticos *@
                @if (!EmpleadosViaticosFiltrados.Any())
                {
                    <MudPaper Elevation="0" Class="pa-6 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 12px;">
                        <MudIcon Icon="@Icons.Material.Filled.MoneyOff" Size="Size.Large" Color="Color.Secondary" Class="mb-1" />
                        @if (filtroViaticos == "CON_VIATICOS")
                        {
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">No hay colaboradores con viáticos o bono asignados en esta jornada</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                                Para asignar viáticos o bonos a su personal presente, cambie a la vista de todos los colaboradores.
                            </MudText>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.People"
                                       OnClick="@(() => filtroViaticos = "TODOS")">
                                Ver Todos para Asignar Viáticos (@empleadosJornada.Count(x => x.Asistio))
                            </MudButton>
                        }
                        else
                        {
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">No se encontraron colaboradores con el filtro seleccionado</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Solo se muestran colaboradores marcados como PRESENTE en la jornada diaria.
                            </MudText>
                        }
                    </MudPaper>
                }
                else
                {
                    <MudTable Items="@EmpleadosViaticosFiltrados" 
                              Dense="true" 
                              Hover="true" 
                              Striped="true" 
                              Elevation="1" 
                              Class="rounded-lg"
                              Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh Style="width: 44px;">
                                <MudCheckBox T="bool" 
                                             Value="@(EmpleadosViaticosFiltrados.Any() && EmpleadosViaticosFiltrados.All(x => x.Seleccionado))"
                                             ValueChanged="@MarcarTodosViaticos"
                                             Color="Color.Primary" />
                            </MudTh>
                            <MudTh>Colaborador</MudTh>
                            <MudTh Style="width: 170px;">Área / Cliente</MudTh>
                            <MudTh Style="width: 130px;">Turno / Horas</MudTh>
                            <MudTh Style="width: 120px;">Trasp (C$)</MudTh>
                            <MudTh Style="width: 120px;">Alim (C$)</MudTh>
                            <MudTh Style="width: 120px;">BNC (C$)</MudTh>
                            <MudTh Style="width: 110px;" Class="text-right">Total (C$)</MudTh>
                            <MudTh Style="width: 60px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudCheckBox @bind-Value="@context.Seleccionado" Color="Color.Primary" />
                            </MudTd>
                            <MudTd>
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem; min-width: 48px; justify-content: center;">
                                        #@context.CodigoEmpleado
                                    </MudChip>
                                    <MudText Typo="Typo.body2" Class="fw-bold">
                                        @context.NombreEmpleado
                                    </MudText>
                                </div>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Class="fw-bold d-block">@context.Area</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Cliente</MudText>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Class="fw-bold">@context.TurnoNombre</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-monospace d-block">@context.HoraEntrada - @context.HoraSalida</MudText>
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" 
                                                 Value="@context.VtcoTrasp" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 Dense="true" 
                                                 Min="0" 
                                                 HideSpinButtons="true"
                                                 Format="N2"
                                                 Adornment="Adornment.Start"
                                                 AdornmentText="C$"
                                                 Style="font-size: 0.82rem; text-align: right;" 
                                                 ValueChanged="@((val) => { context.VtcoTrasp = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" 
                                                 Value="@context.VtcoAlim" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 Dense="true" 
                                                 Min="0" 
                                                 HideSpinButtons="true"
                                                 Format="N2"
                                                 Adornment="Adornment.Start"
                                                 AdornmentText="C$"
                                                 Style="font-size: 0.82rem; text-align: right;" 
                                                 ValueChanged="@((val) => { context.VtcoAlim = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" 
                                                 Value="@context.BonoBnc" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 Dense="true" 
                                                 Min="0" 
                                                 HideSpinButtons="true"
                                                 Format="N2"
                                                 Adornment="Adornment.Start"
                                                 AdornmentText="C$"
                                                 Style="font-size: 0.82rem; text-align: right;" 
                                                 ValueChanged="@((val) => { context.BonoBnc = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />
                            </MudTd>
                            <MudTd Class="text-right">
                                @{
                                    var rowTotal = context.VtcoTrasp + context.VtcoAlim + context.BonoBnc;
                                }
                                <MudText Typo="Typo.body2" Class="fw-bold" Color="@(rowTotal > 0 ? Color.Success : Color.Secondary)">
                                    C$ @rowTotal.ToString("N2")
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudStack Row="true" Spacing="0" Justify="Justify.Center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                   Size="Size.Small" 
                                                   Color="Color.Primary" 
                                                   OnClick="@(() => AbrirEditorViaticoIndividual(context))"
                                                   Title="Editar en diálogo con atajos" />
                                    @if (context.VtcoTrasp > 0 || context.VtcoAlim > 0 || context.BonoBnc > 0)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Clear" 
                                                       Size="Size.Small" 
                                                       Color="Color.Error" 
                                                       OnClick="@(() => { context.VtcoTrasp = 0; context.VtcoAlim = 0; context.BonoBnc = 0; context.Modificado = true; ActualizarGruposConsolidados(); })"
                                                       Title="Poner viáticos a 0" />
                                    }
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>

        @* ==========================================
           TAB 3: CONSOLIDADO & ENVÍO A HELPDESK
           ========================================== *@
        <MudTabPanel Text="Movimientos" ToolTip="Movimientos" Icon="@Icons.Material.Filled.ConfirmationNumber" BadgeData="@gruposConsolidados.Count" BadgeColor="Color.Primary">
            <MudPaper Class="pa-3 mt-2" Elevation="0">
                <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Outlined">
                    Esta pestaña agrupa automáticamente la asistencia activa exactamente con la lógica de <b>OPM_Produccion_Diaria_Hrs</b> 
                    para generar y sincronizar los tickets de <b>Movimientos de Personal (Tracker 1)</b> y <b>Viáticos Operativos (Tracker 28)</b> en Helpdesk.
                </MudAlert>

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.h6" Class="fw-bold">Grupos Listos para Helpdesk (@gruposConsolidados.Count)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Total de @TotalPresentes colaboradores distribuidos en @gruposConsolidados.Count asignaciones
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Size="Size.Large" 
                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                               Disabled="@(estaEnviandoHelpdesk || !gruposConsolidados.Any())"
                               OnClick="@EnviarAHelpdeskMasivo"
                               Style="font-weight: 800; letter-spacing: 0.5px; border-radius: 12px;">
                        @(estaEnviandoHelpdesk ? "Sincronizando con Helpdesk..." : "ENVIAR JORNADA A HELPDESK")
                    </MudButton>
                </MudStack>

                @if (estaEnviandoHelpdesk)
                {
                    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-2" />
                }

                @* Listado de Tarjetas de Grupos Consolidados *@
                <MudGrid Spacing="2">
                    @foreach (var grupo in gruposConsolidados)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudCard Elevation="2" Class="rounded-lg" Style="@(grupo.Sincronizado ? "border-left: 5px solid #10b981;" : "border-left: 5px solid #f59e0b;")">
                                <MudCardHeader Class="pb-1">
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="@(grupo.Sincronizado ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                                            #@grupo.GrupoIndex
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <div class="d-flex align-center gap-1 mb-1">
                                            @if (!string.IsNullOrWhiteSpace(grupo.Cliente))
                                            {
                                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="px-1 fw-bold" Style="height: 18px; font-size: 0.7rem;">
                                                    @grupo.Cliente
                                                </MudChip>
                                            }
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold text-truncate">
                                                @grupo.Area
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @grupo.Puesto • @grupo.TurnoNombre (@grupo.HoraInicio - @grupo.HoraFin) • Comida: @grupo.TiempoComida h
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        @if (grupo.Sincronizado)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                                Sincronizado
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                                Pendiente
                                            </MudChip>
                                        }
                                    </CardHeaderActions>
                                </MudCardHeader>

                                <MudCardContent Class="pt-1 pb-2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Class="fw-bold">
                                            @grupo.Cantidad colaboradores asignados
                                        </MudText>
                                    </MudStack>

                                    @* Lista de Códigos/Carnets *@
                                    <MudPaper Class="pa-2 mb-2 rounded" Style="background: rgba(0,0,0,0.03); max-height: 80px; overflow-y: auto;">
                                        <MudText Typo="Typo.caption" Class="font-monospace fw-bold" Style="word-break: break-all;">
                                            @grupo.IdsEmpleadosTexto
                                        </MudText>
                                    </MudPaper>

                                    @* Viáticos *@
                                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                        @if (grupo.VtcoTrasp > 0)
                                        {
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                                Trasp: C$ @grupo.VtcoTrasp.ToString("N0") c/u
                                            </MudChip>
                                        }
                                        @if (grupo.VtcoAlim > 0)
                                        {
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                                Alim: C$ @grupo.VtcoAlim.ToString("N0") c/u
                                            </MudChip>
                                        }
                                        @if (grupo.VtcoBnc > 0)
                                        {
                                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold">
                                                Bono BNC: C$ @grupo.VtcoBnc.ToString("N0") c/u
                                            </MudChip>
                                        }
                                    </MudStack>

                                    @* Trazabilidad Helpdesk si ya fue enviado *@
                                    @if (grupo.TicketRedmineId.HasValue && grupo.TicketRedmineId > 0)
                                    {
                                        <MudDivider Class="my-2" />
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" Color="Color.Success" />
                                            <MudText Typo="Typo.caption" Class="fw-bold text-success">
                                                Ticket Redmine: #@grupo.TicketRedmineId
                                            </MudText>
                                            @if (grupo.TicketViaticoId.HasValue && grupo.TicketViaticoId > 0)
                                            {
                                                <MudText Typo="Typo.caption" Class="fw-bold text-info ml-2">
                                                    • Viáticos: #@grupo.TicketViaticoId
                                                </MudText>
                                            }
                                        </MudStack>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        @* ==========================================
           TAB 4: MI PERSONAL (PLANTILLA PERMANENTE)
           ========================================== *@
        <MudTabPanel Text="Mi Personal" ToolTip="Mi Personal" Icon="@Icons.Material.Filled.Badge" BadgeData="@miPlantillaPersonal.Count" BadgeColor="Color.Info">
            <MudPaper Class="pa-4 mt-2" Elevation="0">
                <MudAlert Severity="Severity.Normal" Class="mb-3" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Info">
                    Define tu equipo habitual de colaboradores con su <b>Cliente Inicial</b>, área y puesto. 
                    Al abrir la aplicación o presionar <b>"Mi Personal"</b> en la barra superior, la jornada diaria se cargará automáticamente con esta lista.
                </MudAlert>

                @* BARRA DE HERRAMIENTAS Y VISTAS ESTILO ODOO *@
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                    <div class="d-flex align-center gap-2 flex-grow-1" style="max-width: 520px;">
                        <MudTextField @bind-Value="textoBusquedaPlantilla" 
                                      Placeholder="Buscar en mi plantilla por nombre o carnet..." 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Immediate="true" 
                                      Clearable="true"
                                      Class="flex-grow-1" />

                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.PersonAdd"
                                   OnClick="@(() => AbrirDialogoAgregarColaborador())"
                                   Style="white-space: nowrap; height: 36px; text-transform: none; font-weight: 600;">
                            + Colaborador
                        </MudButton>
                    </div>

                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Secondary" 
                                   Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.DownloadForOffline"
                                   Disabled="@(!empleadosJornada.Any())"
                                   OnClick="@GuardarJornadaComoMiPlantilla"
                                   Style="white-space: nowrap; height: 36px; text-transform: none; font-weight: 600;"
                                   Title="Guarda los colaboradores de la grilla diaria actual como tu plantilla permanente">
                            Guardar Grilla como Plantilla
                        </MudButton>

                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Success" 
                                   Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Disabled="@(!miPlantillaPersonal.Any())"
                                   OnClick="@(() => PrecargarDesdeMiPlantilla())"
                                   Style="white-space: nowrap; height: 36px; text-transform: none; font-weight: 600;"
                                   Title="Cargar estos colaboradores a la grilla diaria">
                            Cargar en Grilla
                        </MudButton>

                        <span class="text-secondary fw-bold ml-1" style="font-size: 0.8rem; white-space: nowrap;">
                            @PlantillaFiltrada.Count() colaboradores
                        </span>

                                                @* Control de Vistas Estilo Odoo para Mi Personal *@
                        <div class="odoo-view-switcher" role="group" aria-label="Cambiar modo de vista">
                            <MudTooltip Text="Vista Horarios & Viáticos" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPlantilla == ModoVistaGrilla.Operativo ? "active" : "")" 
                                        @onclick="@(() => modoVistaPlantilla = ModoVistaGrilla.Operativo)"
                                        title="Vista Horarios & Viáticos">
                                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Cliente, Área y Puesto" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPlantilla == ModoVistaGrilla.Ubicacion ? "active" : "")" 
                                        @onclick="@(() => modoVistaPlantilla = ModoVistaGrilla.Ubicacion)"
                                        title="Vista Cliente, Área y Puesto">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tabla Completa" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPlantilla == ModoVistaGrilla.Completo ? "active" : "")" 
                                        @onclick="@(() => modoVistaPlantilla = ModoVistaGrilla.Completo)"
                                        title="Vista Tabla Completa">
                                    <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tarjetas (Kanban)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPlantilla == ModoVistaGrilla.Tarjetas ? "active" : "")" 
                                        @onclick="@(() => modoVistaPlantilla = ModoVistaGrilla.Tarjetas)"
                                        title="Vista Tarjetas (Kanban)">
                                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                        </div>
                    </div>
                </div>

                @if (cargandoPlantilla)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else if (!miPlantillaPersonal.Any())
                {
                    <MudPaper Elevation="0" Class="pa-8 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 16px;">
                        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Large" Color="Color.Info" Class="mb-2" />
                        <MudText Typo="Typo.h6" Class="fw-bold">Aún no tienes colaboradores en tu plantilla</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Puedes agregar colaboradores o, si ya tienes la jornada de hoy en la Grilla Diaria, presionar "Guardar Grilla como Mi Plantilla".
                        </MudText>
                        <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => AbrirDialogoAgregarColaborador())">
                                Agregar Primer Colaborador
                            </MudButton>
                            @if (empleadosJornada.Any())
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.DownloadForOffline" OnClick="@GuardarJornadaComoMiPlantilla">
                                    Importar de Grilla Diaria (@empleadosJornada.Count)
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                }
                else if (modoVistaPlantilla == ModoVistaGrilla.Tarjetas)
                {
                    @* --- MODO TARJETAS TOUCH-FRIENDLY (Estilo Odoo Kanban para Mi Personal) --- *@
                    <MudGrid Spacing="2">
                        @foreach (var context in PlantillaFiltrada)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudCard Elevation="2" Class="rounded-lg pa-3" Style="border-left: 5px solid #2563eb; border: 1px solid #e2e8f0; background: white;">
                                    <div class="d-flex align-center justify-space-between mb-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Style="font-size: 0.85rem; font-weight: 700;">
                                                @(string.IsNullOrWhiteSpace(context.NombreEmpleado) ? "?" : context.NombreEmpleado.Substring(0, 1))
                                            </MudAvatar>
                                            <div style="min-width: 0;">
                                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-truncate" Style="line-height: 1.2; max-width: 170px;">
                                                    @context.NombreEmpleado
                                                </MudText>
                                                <div class="d-flex align-center gap-1 mt-1">
                                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold px-1" Style="height: 18px; font-size: 0.7rem;">
                                                        #@context.CodigoEmpleado
                                                    </MudChip>
                                                    <MudChip T="string" Color="@GetColorTurno(context.TurnoDefault)" Variant="Variant.Outlined" Size="Size.Small" Class="px-1" Style="height: 18px; font-size: 0.68rem; font-weight: 600;">
                                                        @context.TurnoDefault
                                                    </MudChip>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex align-center gap-1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                           Color="Color.Primary" 
                                                           Size="Size.Small" 
                                                           OnClick="@(() => AbrirDialogoEditarPlantilla(context))"
                                                           Title="Editar datos del colaborador" />
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                           Color="Color.Error" 
                                                           Size="Size.Small" 
                                                           OnClick="@(() => EliminarItemPlantilla(context))"
                                                           Title="Quitar de mi plantilla" />
                                        </div>
                                    </div>

                                    <MudDivider Class="my-2" />

                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudSelect T="string" 
                                                       Label="Cliente Inicial" 
                                                       Value="@context.ClienteDefault" 
                                                       Dense="true" 
                                                       Margin="Margin.Dense" 
                                                       Variant="Variant.Outlined"
                                                       ValueChanged="@(async (val) => { 
                                                           context.ClienteDefault = val; 
                                                           var areasCli = GetAreasParaCliente(val);
                                                           if (!areasCli.Contains(context.AreaDefault, StringComparer.OrdinalIgnoreCase))
                                                           {
                                                               context.AreaDefault = areasCli.FirstOrDefault() ?? "Operaciones";
                                                           }
                                                           await GuardarItemPlantilla(context); 
                                                       })">
                                                @foreach (var op in operacionesList)
                                                {
                                                    <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudSelect T="string" 
                                                       Label="Área Inicial" 
                                                       Value="@context.AreaDefault" 
                                                       Dense="true" 
                                                       Margin="Margin.Dense" 
                                                       Variant="Variant.Outlined"
                                                       ValueChanged="@(async (val) => { 
                                                           context.AreaDefault = val; 
                                                           await GuardarItemPlantilla(context); 
                                                       })">
                                                @{
                                                    var areasP = GetAreasParaCliente(context.ClienteDefault);
                                                    if (!string.IsNullOrWhiteSpace(context.AreaDefault) && !areasP.Contains(context.AreaDefault, StringComparer.OrdinalIgnoreCase))
                                                    {
                                                        areasP = new List<string>(areasP) { context.AreaDefault };
                                                    }
                                                }
                                                @foreach (var a in areasP)
                                                {
                                                    <MudSelectItem Value="@a">@a</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudSelect T="string" 
                                                       Label="Puesto Inicial" 
                                                       Value="@context.PuestoDefault" 
                                                       Dense="true" 
                                                       Margin="Margin.Dense" 
                                                       Variant="Variant.Outlined"
                                                       ValueChanged="@(async (val) => { context.PuestoDefault = val; await GuardarItemPlantilla(context); })">
                                                @foreach (var c in cargosDisponibles)
                                                {
                                                    <MudSelectItem Value="@c">@c</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudSelect T="string" 
                                                       Label="Turno Habitual" 
                                                       Value="@context.TurnoDefault" 
                                                       Dense="true" 
                                                       Margin="Margin.Dense" 
                                                       Variant="Variant.Outlined"
                                                       ValueChanged="@(async (val) => { 
                                                           context.TurnoDefault = val; 
                                                           if (val == "Diurno") { context.HoraEntradaDefault = "06:00"; context.HoraSalidaDefault = "14:00"; }
                                                           else if (val == "Sinsa") { context.HoraEntradaDefault = "07:00"; context.HoraSalidaDefault = "16:00"; }
                                                           else if (val == "Normal") { context.HoraEntradaDefault = "08:00"; context.HoraSalidaDefault = "17:00"; }
                                                           else if (val == "DCC") { context.HoraEntradaDefault = "06:00"; context.HoraSalidaDefault = "15:30"; }
                                                           else if (val == "Mixto") { context.HoraEntradaDefault = "14:00"; context.HoraSalidaDefault = "22:00"; }
                                                           else if (val == "Nocturno") { context.HoraEntradaDefault = "22:00"; context.HoraSalidaDefault = "06:00"; }
                                                           await GuardarItemPlantilla(context); 
                                                       })">
                                                <MudSelectItem Value="@("Diurno")">Diurno (06:00 - 14:00)</MudSelectItem>
                                                <MudSelectItem Value="@("Sinsa")">Sinsa (07:00 - 16:00)</MudSelectItem>
                                                <MudSelectItem Value="@("Normal")">Normal (08:00 - 17:00)</MudSelectItem>
                                                <MudSelectItem Value="@("DCC")">DCC (06:00 - 15:30)</MudSelectItem>
                                                <MudSelectItem Value="@("Mixto")">Mixto (14:00 - 22:00)</MudSelectItem>
                                                <MudSelectItem Value="@("Nocturno")">Nocturno (22:00 - 06:00)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>

                                    <div class="d-flex align-center justify-space-between mt-2 pt-2" style="border-top: 1px dashed #e2e8f0;">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Viáticos Base:
                                        </MudText>
                                        @{
                                            var totalCardV = context.VtcoTraspDefault + context.VtcoAlimDefault + context.BonoBncDefault;
                                        }
                                        <MudButton Variant="Variant.Outlined" 
                                                   Color="@(totalCardV > 0 ? Color.Success : Color.Default)" 
                                                   Size="Size.Small" 
                                                   Class="px-2 py-0" 
                                                   Style="font-size: 0.72rem; min-height: 22px; text-transform: none;" 
                                                   StartIcon="@(totalCardV > 0 ? Icons.Material.Filled.AttachMoney : Icons.Material.Filled.Add)" 
                                                   OnClick="@(() => AbrirEditorViaticoPlantilla(context))" 
                                                   Title="Editar viáticos y bono base">
                                            @if (totalCardV > 0)
                                            {
                                                <span>Tr: @context.VtcoTraspDefault:N0 | Al: @context.VtcoAlimDefault:N0@(context.BonoBncDefault > 0 ? $" | Bnc: {context.BonoBncDefault:N0}" : "")</span>
                                            }
                                            else
                                            {
                                                <span>+ Configurar</span>
                                            }
                                        </MudButton>
                                    </div>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudTable Items="@PlantillaFiltrada" Dense="true" Hover="true" Striped="true" Elevation="1" Class="rounded-lg">
                        <HeaderContent>
                            @if (modoVistaPlantilla == ModoVistaGrilla.Operativo)
                            {
                                <MudTh Style="width: 80px;">Carnet</MudTh>
                                <MudTh>Colaborador</MudTh>
                                <MudTh Style="width: 280px;">Turno / Horarios</MudTh>
                                <MudTh Style="width: 220px;">Viáticos Base (C$)</MudTh>
                                <MudTh Style="width: 90px;" Class="text-center">Acciones</MudTh>
                            }
                            else if (modoVistaPlantilla == ModoVistaGrilla.Ubicacion)
                            {
                                <MudTh Style="width: 80px;">Carnet</MudTh>
                                <MudTh>Colaborador</MudTh>
                                <MudTh Style="width: 220px;">Cliente Inicial</MudTh>
                                <MudTh Style="width: 200px;">Área Inicial</MudTh>
                                <MudTh Style="width: 240px;">Puesto Inicial</MudTh>
                                <MudTh Style="width: 90px;" Class="text-center">Acciones</MudTh>
                            }
                            else
                            {
                                <MudTh Style="width: 80px;">Carnet</MudTh>
                                <MudTh>Colaborador</MudTh>
                                <MudTh Style="width: 170px;">Cliente Inicial</MudTh>
                                <MudTh Style="width: 150px;">Área Inicial</MudTh>
                                <MudTh Style="width: 180px;">Puesto Inicial</MudTh>
                                <MudTh Style="width: 140px;">Turno</MudTh>
                                <MudTh Style="width: 200px;">Viáticos Base (C$)</MudTh>
                                <MudTh Style="width: 90px;" Class="text-center">Acciones</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            @if (modoVistaPlantilla == ModoVistaGrilla.Operativo)
                            {
                                <MudTd>
                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold">
                                        #@context.CodigoEmpleado
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.body2" Class="fw-bold">@context.NombreEmpleado</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @context.ClienteDefault • @context.AreaDefault • @context.PuestoDefault
                                        </MudText>
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                        <div class="d-flex align-center gap-1 justify-center">
                                            <MudChip T="string" 
                                                     Color="@GetColorTurno(context.TurnoDefault)" 
                                                     Variant="Variant.Filled" 
                                                     Size="Size.Small" 
                                                     Class="px-2" 
                                                     Style="height: 20px; font-size: 0.72rem; font-weight: 600;">
                                                @context.TurnoDefault
                                            </MudChip>
                                            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Dense="true" Size="Size.Small" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Title="Elegir horario predefinido">
                                                <MudMenuItem OnClick="@(() => AplicarPresetHorarioPlantilla(context, "06:00", "14:00", "Diurno"))">
                                                    <MudText Typo="Typo.caption" Class="fw-bold text-primary">Diurno (06:00 - 14:00)</MudText>
                                                </MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AplicarPresetHorarioPlantilla(context, "07:00", "16:00", "Sinsa"))">
                                                    <MudText Typo="Typo.caption" Class="fw-bold text-success">Sinsa (07:00 - 16:00)</MudText>
                                                </MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AplicarPresetHorarioPlantilla(context, "08:00", "17:00", "Normal"))">
                                                    <MudText Typo="Typo.caption" Class="fw-bold text-info">Normal (08:00 - 17:00)</MudText>
                                                </MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AplicarPresetHorarioPlantilla(context, "06:00", "15:30", "DCC"))">
                                                    <MudText Typo="Typo.caption" Class="fw-bold text-secondary">DCC (06:00 - 15:30)</MudText>
                                                </MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AplicarPresetHorarioPlantilla(context, "14:00", "22:00", "Mixto"))">
                                                    <MudText Typo="Typo.caption" Class="fw-bold text-warning">Mixto (14:00 - 22:00)</MudText>
                                                </MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AplicarPresetHorarioPlantilla(context, "22:00", "06:00", "Nocturno"))">
                                                    <MudText Typo="Typo.caption" Class="fw-bold text-dark">Nocturno (22:00 - 06:00)</MudText>
                                                </MudMenuItem>
                                            </MudMenu>
                                        </div>
                                        <div class="d-flex align-center justify-center gap-1 font-monospace" style="font-size: 0.75rem;">
                                            <input type="text" 
                                                   value="@context.HoraEntradaDefault" 
                                                   @onchange="@(async (ChangeEventArgs e) => { context.HoraEntradaDefault = e.Value?.ToString() ?? ""; await GuardarItemPlantilla(context); })" 
                                                   style="width: 44px; border: 1px solid #ced4da; border-radius: 4px; padding: 1px 2px; font-size: 0.75rem; text-align: center;" 
                                                   title="Hora Entrada (ej. 06:00)" />
                                            <span>-</span>
                                            <input type="text" 
                                                   value="@context.HoraSalidaDefault" 
                                                   @onchange="@(async (ChangeEventArgs e) => { context.HoraSalidaDefault = e.Value?.ToString() ?? ""; await GuardarItemPlantilla(context); })" 
                                                   style="width: 44px; border: 1px solid #ced4da; border-radius: 4px; padding: 1px 2px; font-size: 0.75rem; text-align: center;" 
                                                   title="Hora Salida (ej. 14:00)" />
                                        </div>
                                    </MudStack>
                                </MudTd>
                                <MudTd>
                                    @{
                                        var totalVOp = context.VtcoTraspDefault + context.VtcoAlimDefault + context.BonoBncDefault;
                                    }
                                    <MudButton Variant="Variant.Outlined" 
                                               Color="@(totalVOp > 0 ? Color.Success : Color.Default)" 
                                               Size="Size.Small" 
                                               Class="px-2 py-0 text-start" 
                                               Style="font-size: 0.74rem; min-height: 24px; text-transform: none;" 
                                               StartIcon="@(totalVOp > 0 ? Icons.Material.Filled.AttachMoney : Icons.Material.Filled.Add)" 
                                               OnClick="@(() => AbrirEditorViaticoPlantilla(context))" 
                                               Title="Clic para editar viáticos base">
                                        @if (totalVOp > 0)
                                        {
                                            <span>Tr: @context.VtcoTraspDefault:N0 | Al: @context.VtcoAlimDefault:N0@(context.BonoBncDefault > 0 ? $" | Bnc: {context.BonoBncDefault:N0}" : "")</span>
                                        }
                                        else
                                        {
                                            <span>+ Viáticos</span>
                                        }
                                    </MudButton>
                                </MudTd>
                                <MudTd Class="text-center">
                                    <div class="d-inline-flex align-center gap-1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                       Color="Color.Primary" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => AbrirDialogoEditarPlantilla(context))" 
                                                       Title="Editar colaborador" />
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => EliminarItemPlantilla(context))" 
                                                       Title="Quitar de mi plantilla" />
                                    </div>
                                </MudTd>
                            }
                            else if (modoVistaPlantilla == ModoVistaGrilla.Ubicacion)
                            {
                                <MudTd>
                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold">
                                        #@context.CodigoEmpleado
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.body2" Class="fw-bold">@context.NombreEmpleado</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Turno @context.TurnoDefault (@context.HoraEntradaDefault - @context.HoraSalidaDefault)</MudText>
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@context.ClienteDefault" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { 
                                                   context.ClienteDefault = val; 
                                                   var areasCli = GetAreasParaCliente(val);
                                                   if (!areasCli.Contains(context.AreaDefault, StringComparer.OrdinalIgnoreCase))
                                                   {
                                                       context.AreaDefault = areasCli.FirstOrDefault() ?? "Operaciones";
                                                   }
                                                   await GuardarItemPlantilla(context); 
                                               })">
                                        @foreach (var op in operacionesList)
                                        {
                                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@context.AreaDefault" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { 
                                                   context.AreaDefault = val; 
                                                   await GuardarItemPlantilla(context); 
                                               })">
                                        @{
                                            var areasP = GetAreasParaCliente(context.ClienteDefault);
                                            if (!string.IsNullOrWhiteSpace(context.AreaDefault) && !areasP.Contains(context.AreaDefault, StringComparer.OrdinalIgnoreCase))
                                            {
                                                areasP = new List<string>(areasP) { context.AreaDefault };
                                            }
                                        }
                                        @foreach (var a in areasP)
                                        {
                                            <MudSelectItem Value="@a">@a</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@context.PuestoDefault" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { context.PuestoDefault = val; await GuardarItemPlantilla(context); })">
                                        @foreach (var c in cargosDisponibles)
                                        {
                                            <MudSelectItem Value="@c">@c</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd Class="text-center">
                                    <div class="d-inline-flex align-center gap-1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                       Color="Color.Primary" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => AbrirDialogoEditarPlantilla(context))" 
                                                       Title="Editar colaborador" />
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => EliminarItemPlantilla(context))" 
                                                       Title="Quitar de mi plantilla" />
                                    </div>
                                </MudTd>
                            }
                            else
                            {
                                <MudTd>
                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold">
                                        #@context.CodigoEmpleado
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Class="fw-bold">@context.NombreEmpleado</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@context.ClienteDefault" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { 
                                                   context.ClienteDefault = val; 
                                                   var areasCli = GetAreasParaCliente(val);
                                                   if (!areasCli.Contains(context.AreaDefault, StringComparer.OrdinalIgnoreCase))
                                                   {
                                                       context.AreaDefault = areasCli.FirstOrDefault() ?? "Operaciones";
                                                   }
                                                   await GuardarItemPlantilla(context); 
                                               })">
                                        @foreach (var op in operacionesList)
                                        {
                                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@context.AreaDefault" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { 
                                                   context.AreaDefault = val; 
                                                   await GuardarItemPlantilla(context); 
                                               })">
                                        @{
                                            var areasP = GetAreasParaCliente(context.ClienteDefault);
                                            if (!string.IsNullOrWhiteSpace(context.AreaDefault) && !areasP.Contains(context.AreaDefault, StringComparer.OrdinalIgnoreCase))
                                            {
                                                areasP = new List<string>(areasP) { context.AreaDefault };
                                            }
                                        }
                                        @foreach (var a in areasP)
                                        {
                                            <MudSelectItem Value="@a">@a</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@context.PuestoDefault" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { context.PuestoDefault = val; await GuardarItemPlantilla(context); })">
                                        @foreach (var c in cargosDisponibles)
                                        {
                                            <MudSelectItem Value="@c">@c</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@context.TurnoDefault" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { 
                                                   context.TurnoDefault = val; 
                                                   if (val == "Diurno") { context.HoraEntradaDefault = "06:00"; context.HoraSalidaDefault = "14:00"; }
                                                   else if (val == "Sinsa") { context.HoraEntradaDefault = "07:00"; context.HoraSalidaDefault = "16:00"; }
                                                   else if (val == "Normal") { context.HoraEntradaDefault = "08:00"; context.HoraSalidaDefault = "17:00"; }
                                                   else if (val == "DCC") { context.HoraEntradaDefault = "06:00"; context.HoraSalidaDefault = "15:30"; }
                                                   else if (val == "Mixto") { context.HoraEntradaDefault = "14:00"; context.HoraSalidaDefault = "22:00"; }
                                                   else if (val == "Nocturno") { context.HoraEntradaDefault = "22:00"; context.HoraSalidaDefault = "06:00"; }
                                                   await GuardarItemPlantilla(context); 
                                               })">
                                        <MudSelectItem Value="@("Diurno")">Diurno</MudSelectItem>
                                        <MudSelectItem Value="@("Sinsa")">Sinsa</MudSelectItem>
                                        <MudSelectItem Value="@("Normal")">Normal</MudSelectItem>
                                        <MudSelectItem Value="@("DCC")">DCC</MudSelectItem>
                                        <MudSelectItem Value="@("Mixto")">Mixto</MudSelectItem>
                                        <MudSelectItem Value="@("Nocturno")">Nocturno</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    @{
                                        var totalVComp = context.VtcoTraspDefault + context.VtcoAlimDefault + context.BonoBncDefault;
                                    }
                                    <MudButton Variant="Variant.Outlined" 
                                               Color="@(totalVComp > 0 ? Color.Success : Color.Default)" 
                                               Size="Size.Small" 
                                               Class="px-2 py-0 text-start" 
                                               Style="font-size: 0.74rem; min-height: 24px; text-transform: none;" 
                                               StartIcon="@(totalVComp > 0 ? Icons.Material.Filled.AttachMoney : Icons.Material.Filled.Add)" 
                                               OnClick="@(() => AbrirEditorViaticoPlantilla(context))" 
                                               Title="Clic para editar viáticos base">
                                        @if (totalVComp > 0)
                                        {
                                            <span>Tr: @context.VtcoTraspDefault:N0 | Al: @context.VtcoAlimDefault:N0@(context.BonoBncDefault > 0 ? $" | Bnc: {context.BonoBncDefault:N0}" : "")</span>
                                        }
                                        else
                                        {
                                            <span>+ Viáticos</span>
                                        }
                                    </MudButton>
                                </MudTd>
                                <MudTd Class="text-center">
                                    <div class="d-inline-flex align-center gap-1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                       Color="Color.Primary" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => AbrirDialogoEditarPlantilla(context))" 
                                                       Title="Editar colaborador" />
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => EliminarItemPlantilla(context))" 
                                                       Title="Quitar de mi plantilla" />
                                    </div>
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>

        @* ==========================================
           TAB 5: CONFIGURACIÓN DE ÁREAS POR CLIENTE
           ========================================== *@
        <MudTabPanel Text="Configuración" ToolTip="Configuración" Icon="@Icons.Material.Filled.Settings" BadgeData="@catalogoClienteAreas.Count" BadgeColor="Color.Dark">
            <MudPaper Class="pa-4 mt-2" Elevation="0">
                <MudAlert Severity="Severity.Normal" Class="mb-3" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Tune">
                    Gestiona el catálogo de <b>Áreas Operativas correspondientes a cada Cliente / Operación</b>. 
                    Las áreas registradas aquí se cargan automáticamente en la grilla diaria, en la ventana de agregar colaborador y en la plantilla del supervisor.
                </MudAlert>

                @* Formulario rápido para agregar nueva área *@
                <MudPaper Class="pa-3 mb-4 rounded-lg" Elevation="2" Style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" Class="mr-1" />
                        Registrar Nueva Área para un Cliente
                    </MudText>
                    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                        <MudItem xs="12" sm="5">
                            <MudSelect T="int?" Label="Cliente / Operación" @bind-Value="nuevoClienteAreaOpId" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                <MudSelectItem T="int?" Value="@((int?)null)">-- Seleccione el cliente --</MudSelectItem>
                                @foreach (var op in operacionesList)
                                {
                                    <MudSelectItem T="int?" Value="@op.id">@op.nombre</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudSelect T="string" Label="Área (Atributo de Inventario)" @bind-Value="nuevaAreaNombre" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                                <MudSelectItem T="string" Value="@((string?)null)">-- Seleccione el área (@(listaAreasAtributoOdoo.Any() ? listaAreasAtributoOdoo.Count : catalogoClienteAreas.Count) áreas disponibles) --</MudSelectItem>
                                @if (listaAreasAtributoOdoo.Any())
                                {
                                    @foreach (var area in listaAreasAtributoOdoo)
                                    {
                                        <MudSelectItem T="string" Value="@area.nombre">@area.nombre</MudSelectItem>
                                    }
                                }
                                else
                                {
                                    @foreach (var areaName in catalogoClienteAreas.Select(c => c.AreaNombre).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s))
                                    {
                                        <MudSelectItem T="string" Value="@areaName">@areaName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" FullWidth="true" StartIcon="@Icons.Material.Filled.Save" OnClick="@GuardarNuevaAreaCliente">
                                Guardar
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @* Filtros de búsqueda de catálogo *@
                <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudItem xs="12" sm="5">
                        <MudSelect T="int?" Label="Filtrar por Cliente" @bind-Value="filtroClienteAreaId" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                            <MudSelectItem T="int?" Value="@((int?)null)">-- Todos los Clientes (@catalogoClienteAreas.Count áreas) --</MudSelectItem>
                            @foreach (var op in operacionesList)
                            {
                                int count = catalogoClienteAreas.Count(a => a.OperacionId == op.id);
                                <MudSelectItem T="int?" Value="@op.id">@op.nombre (@count)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudTextField @bind-Value="filtroTextoArea" Placeholder="Buscar por área o cliente..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@CargarCatalogoClienteAreas" Disabled="@cargandoAreas">
                            Actualizar
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @if (cargandoAreas)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else
                {
                    <MudTable Items="@CatalogoAreasFiltrado" Dense="true" Hover="true" Striped="true" Elevation="1" Class="rounded-lg" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh Style="width: 250px;">Cliente / Operación</MudTh>
                            <MudTh>Área Operativa</MudTh>
                            <MudTh Style="width: 140px;">Registrado por</MudTh>
                            <MudTh Style="width: 140px;">Fecha</MudTh>
                            <MudTh Style="width: 60px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="fw-bold">
                                    @context.ClienteNombre
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="fw-bold">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="mr-1 text-secondary" />
                                    @context.AreaNombre
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(string.IsNullOrWhiteSpace(context.Usuario) ? "Sistema" : context.Usuario)</MudText>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.FechaCreacion.HasValue ? context.FechaCreacion.Value.ToString("dd/MM/yyyy") : "-")</MudText>
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => EliminarAreaCliente(context))" Title="Eliminar área" />
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 15, 30, 50, 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas por página:" />
                        </PagerContent>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</div>

<style>
    .tablet-tabs .mud-tabs-tabbar {
        padding-bottom: 4px;
    }
    .tablet-tabs .mud-tab {
        margin-right: 8px !important;
        padding-left: 12px !important;
        padding-right: 14px !important;
        font-weight: 700 !important;
        letter-spacing: 0.3px;
        min-height: 44px;
        border-radius: 8px !important;
    }
    .tablet-tabs .mud-tab-badge {
        margin-left: 8px !important;
        margin-right: 4px !important;
    }
    .tablet-tabs .mud-tab-slider {
        height: 3px !important;
    }

    /* En resoluciones medianas y pequenas (tablets y telefonos, max 1080px):
       Ocultar el texto del tab para dejar solo el icono + badge y que nunca se corte ni desaparezca Configuracion */
    @@media (max-width: 1080px) {
        .tablet-tabs .mud-tabs-tabbar {
            overflow-x: visible !important;
        }
        .tablet-tabs .mud-tab {
            font-size: 0 !important;
            margin-right: 4px !important;
            padding-left: 10px !important;
            padding-right: 10px !important;
            min-width: 44px !important;
            height: 42px !important;
            min-height: 42px !important;
            justify-content: center;
        }
        .tablet-tabs .mud-tab .mud-tab-text {
            display: none !important;
        }
        .tablet-tabs .mud-tab .mud-icon-root {
            margin-right: 0 !important;
            margin-left: 0 !important;
            font-size: 1.45rem !important;
            width: 1.45rem !important;
            height: 1.45rem !important;
        }
        .tablet-tabs .mud-tab-badge {
            margin-left: 4px !important;
            margin-right: 0 !important;
            font-size: 0.72rem !important;
            padding: 2px 4px !important;
            min-width: 18px !important;
            height: 18px !important;
            line-height: 14px !important;
        }
    }

    /* Control de Vistas Estilo Odoo (Top-Right Toolbar Switcher) */
    .odoo-view-switcher {
        display: inline-flex;
        align-items: stretch;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background-color: #ffffff;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        height: 34px;
    }
    .odoo-view-switcher .mud-tooltip-root {
        display: inline-flex;
        height: 100%;
        border-right: 1px solid #e2e8f0;
    }
    .odoo-view-switcher .mud-tooltip-root:last-child {
        border-right: none;
    }
    .odoo-view-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 34px;
        border: none;
        background-color: #ffffff;
        color: #475569;
        cursor: pointer;
        padding: 0;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .odoo-view-btn:hover {
        background-color: #f1f5f9;
        color: #0f172a;
    }
    .odoo-view-btn.active {
        background-color: #1e293b !important;
        color: #ffffff !important;
    }
    .odoo-view-btn.active .mud-icon-root {
        fill: #ffffff !important;
    }
</style>
