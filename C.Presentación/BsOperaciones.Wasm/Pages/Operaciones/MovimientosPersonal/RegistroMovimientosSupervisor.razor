@page "/operaciones/registro-movimientos-supervisor"
@layout TabletLayout
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using System.Globalization
@attribute [Authorize]

<div class="px-2 py-1">

    @* --- BARRA SUPERIOR DE CONTROL DE JORNADA --- *@
    <MudPaper Elevation="2" Class="pa-3 mb-3 rounded-lg" Style="border-left: 6px solid #f97316;">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            @* Fecha con Navegación Rápida de 1 Toque *@
            <MudItem xs="12" sm="5" md="4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                                   Size="Size.Medium" 
                                   Color="Color.Default" 
                                   OnClick="@(() => CambiarFecha(-1))" 
                                   Title="Día Anterior" />
                    <MudDatePicker Label="Fecha de la Jornada" 
                                   Date="@fechaSeleccionada" 
                                   DateChanged="@OnFechaSeleccionadaChanged"
                                   DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense"
                                   Class="flex-grow-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" 
                                   Size="Size.Medium" 
                                   Color="Color.Default" 
                                   OnClick="@(() => CambiarFecha(1))" 
                                   Title="Día Siguiente" />
                    <MudButton Variant="Variant.Outlined" 
                               Size="Size.Small" 
                               Color="Color.Primary" 
                               OnClick="@(() => OnFechaSeleccionadaChanged(DateTime.Today))">
                        Hoy
                    </MudButton>
                </MudStack>
            </MudItem>

            @* Botones Principales de Acción Táctica *@
            <MudItem xs="12" sm="7" md="8">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.Groups"
                               Disabled="@estaCargando"
                               OnClick="@(() => PrecargarDesdeMiPlantilla())"
                               Title="Cargar mi equipo habitual con sus clientes asignados">
                        Mi Personal
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.ContentCopy"
                               Disabled="@estaCargando"
                               OnClick="@CopiarDeAyer"
                               Title="Copiar jornada del día anterior">
                        Copiar Ayer
                    </MudButton>

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Custom.FileFormats.FileExcel"
                               Disabled="@(!empleadosJornada.Any())"
                               OnClick="@ExportarExcel"
                               Title="Exportar la jornada del día a archivo Excel (.xlsx)">
                        Excel
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Info" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="@(() => AbrirDialogoAgregarColaborador())"
                               Title="Agregar nuevo colaborador a la jornada">
                        + Colaborador
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Error" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               Disabled="@(!empleadosJornada.Any())"
                               OnClick="@LimpiarGrillaCompleta"
                               Title="Limpiar toda la grilla de la jornada">
                        Limpiar
                    </MudButton>

                    <MudButton Variant="Variant.Filled" 
                               Color="@(HayCambiosSinGuardar ? Color.Warning : Color.Success)" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(estaGuardando || estaCargando || !empleadosJornada.Any())"
                               OnClick="@GuardarEnBaseDatos">
                        @(estaGuardando ? "Guardando..." : "Guardar en BD")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        @* Cinta de Indicadores en Vivo *@
        <MudDivider Class="my-2" />
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap justify-space-between">
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Groups">
                    Total: <b>@TotalColaboradores</b>
                </MudChip>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                    Presentes: <b>@TotalPresentes</b>
                </MudChip>
                @if (TotalAusentes > 0)
                {
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel">
                        Ausentes: <b>@TotalAusentes</b>
                    </MudChip>
                }
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.DirectionsBus">
                    Trasp: <b>C$ @TotalViaticosTrasp.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Fastfood">
                    Alim: <b>C$ @TotalViaticosAlim.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CardGiftcard">
                    BNC: <b>C$ @TotalViaticosBnc.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Payments">
                    Total Viát: <b>C$ @TotalViaticosGlobal.ToString("N0")</b>
                </MudChip>
            </MudStack>

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Person">
                    Supervisor: <b>@(string.IsNullOrWhiteSpace(currentUserName) ? "Cargando..." : currentUserName)</b>
                </MudChip>
                @if (HayCambiosSinGuardar)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                        Cambios sin guardar en BD
                    </MudChip>
                }
                else if (empleadosJornada.Any())
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.CloudDone">
                        Sincronizado con BD
                    </MudChip>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    @* --- PESTAÑAS PRINCIPALES DE LA APLICACIÓN --- *@
    <MudTabs @bind-ActivePanelIndex="@activeTabIndex" 
             Elevation="2" 
             Rounded="true" 
             Border="true" 
             ApplyEffectsToContainer="true" 
             Color="Color.Surface" 
             SliderColor="Color.Secondary" 
             Class="tablet-tabs">

        @* ==========================================
           TAB 1: GRILLA DIARIA DE CAPTURA
           ========================================== *@
        <MudTabPanel Text="Grilla Diaria  " Icon="@Icons.Material.Filled.TableChart" BadgeData="@TotalPresentes" BadgeColor="Color.Success">
            <MudPaper Class="pa-3 mt-2" Elevation="0">
                
                @* Barra de Filtros y Búsqueda *@
                <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @bind-Value="textoBusqueda" 
                                          Placeholder="Buscar por nombre o carnet (#)..." 
                                          Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Search" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          Immediate="true" 
                                          Clearable="true" 
                                          Class="flex-grow-1" />
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Info" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="@(() => AbrirDialogoAgregarColaborador(textoBusqueda))"
                                       Title="Agregar colaborador a la jornada">
                                + Agregar
                            </MudButton>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Row="true" Spacing="1">
                            <MudChip T="string" Color="@(filtroAsistencia == "TODOS" ? Color.Primary : Color.Default)"
                                     Variant="@(filtroAsistencia == "TODOS" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Medium"
                                     OnClick="@(() => filtroAsistencia = "TODOS")">
                                Todos (@TotalColaboradores)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroAsistencia == "PRESENTES" ? Color.Success : Color.Default)"
                                     Variant="@(filtroAsistencia == "PRESENTES" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Medium"
                                     OnClick="@(() => filtroAsistencia = "PRESENTES")">
                                Presentes (@TotalPresentes)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroAsistencia == "AUSENTES" ? Color.Error : Color.Default)"
                                     Variant="@(filtroAsistencia == "AUSENTES" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Medium"
                                     OnClick="@(() => filtroAsistencia = "AUSENTES")">
                                Ausentes (@TotalAusentes)
                            </MudChip>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       OnClick="@(() => MarcarTodos(true))">
                                Marcar Todos
                            </MudButton>
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       OnClick="@(() => MarcarTodos(false))">
                                Desmarcar
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>

                @* BARRA DE ACCIÓN FLOTANTE / MASIVA (Cuando hay seleccionados) *@
                @if (CantidadSeleccionados > 0)
                {
                    <MudPaper Elevation="4" Class="pa-2 mb-2 rounded-lg" Style="background: linear-gradient(90deg, #0f172a, #1e293b); color: white;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudBadge Content="@CantidadSeleccionados" Color="Color.Secondary" Overlap="false" Class="mx-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Medium" />
                                </MudBadge>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                    @CantidadSeleccionados colaboradores seleccionados
                                </MudText>
                            </MudStack>

                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Secondary" 
                                           Size="Size.Medium" 
                                           StartIcon="@Icons.Material.Filled.Bolt"
                                           OnClick="@AbrirAsignacionMasiva">
                                    Asignación Masiva
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Success" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Check"
                                           OnClick="@(() => MarcarAsistenciaSeleccionados(true))">
                                    Presentes
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Close"
                                           OnClick="@(() => MarcarAsistenciaSeleccionados(false))">
                                    Ausentes
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }

                @* TABLA PRINCIPAL DE EMPLEADOS (Touch-Friendly) *@
                @if (estaCargando)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="py-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle1" Class="mt-2">Cargando jornada...</MudText>
                    </MudStack>
                }
                else if (!empleadosJornada.Any())
                {
                    <MudPaper Elevation="0" Class="pa-8 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 16px;">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.h6" Class="fw-bold">No hay movimientos registrados para esta fecha</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Puedes precargar los colaboradores activos de la operación o copiar la distribución de ayer.
                        </MudText>
                        <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       StartIcon="@Icons.Material.Filled.Group"
                                       OnClick="@(() => PrecargarDesdeMiPlantilla(true))">
                                Cargar Mi Personal
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Secondary" 
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="@CopiarDeAyer">
                                Copiar Jornada de Ayer
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }
                else
                {
                    <MudTable Items="@EmpleadosFiltrados" 
                              Dense="true" 
                              Hover="true" 
                              Striped="true" 
                              Elevation="1" 
                              Class="rounded-lg"
                              Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh Style="width: 44px;">
                                <MudCheckBox T="bool" 
                                             Value="@(EmpleadosFiltrados.Any() && EmpleadosFiltrados.All(x => x.Seleccionado))"
                                             ValueChanged="@MarcarTodos"
                                             Color="Color.Primary" />
                            </MudTh>
                            <MudTh>Colaborador</MudTh>
                            <MudTh Style="width: 175px;">Cliente / Op.</MudTh>
                            <MudTh Style="width: 110px;">Asistencia</MudTh>
                            <MudTh>Área Operativa</MudTh>
                            <MudTh>Cargo / Puesto</MudTh>
                            <MudTh Style="width: 135px;">Turno / Horas</MudTh>
                            <MudTh Style="width: 235px;">Viáticos & BNC (C$)</MudTh>
                            <MudTh Style="width: 45px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudCheckBox @bind-Value="@context.Seleccionado" Color="Color.Primary" />
                            </MudTd>

                            @* Empleado *@
                            <MudTd>
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem; min-width: 48px; justify-content: center;">
                                        #@context.CodigoEmpleado
                                    </MudChip>
                                    <MudText Typo="Typo.body2" Class="fw-bold" Style="white-space: normal; line-height: 1.2;">
                                        @context.NombreEmpleado
                                    </MudText>
                                </div>
                            </MudTd>

                            @* Cliente / Operación *@
                            <MudTd>
                                <MudSelect T="string" 
                                           @bind-Value="@context.Cliente" 
                                           Dense="true" 
                                           Margin="Margin.Dense" 
                                           Variant="Variant.Outlined" 
                                           Placeholder="Seleccione..."
                                           AnchorOrigin="Origin.BottomCenter"
                                           SelectedValuesChanged="@(() => { context.Modificado = true; ActualizarGruposConsolidados(); })">
                                    @foreach (var op in operacionesList)
                                    {
                                        <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>

                            @* Asistencia (Touch Switch) *@
                            <MudTd>
                                <MudChip T="string" 
                                         Color="@(context.Asistio ? Color.Success : Color.Error)" 
                                         Variant="@(context.Asistio ? Variant.Filled : Variant.Outlined)" 
                                         Size="Size.Small" 
                                         Class="cursor-pointer"
                                         OnClick="@(() => { context.Asistio = !context.Asistio; context.Modificado = true; ActualizarGruposConsolidados(); })">
                                    @(context.Asistio ? "PRESENTE" : "AUSENTE")
                                </MudChip>
                            </MudTd>

                            @* Área Operativa *@
                            <MudTd>
                                @if (context.Asistio)
                                {
                                    <MudAutocomplete T="string" 
                                                     @bind-Value="@context.Area"
                                                     SearchFunc="@((val, token) => Task.FromResult(areasSugeridas.Where(x => string.IsNullOrWhiteSpace(val) || x.Contains(val, StringComparison.OrdinalIgnoreCase))))"
                                                     ResetValueOnEmptyText="false"
                                                     CoerceText="true"
                                                     CoerceValue="true"
                                                     Dense="true" 
                                                     Margin="Margin.Dense" 
                                                     Variant="Variant.Outlined" 
                                                     TextChanged="@(() => { context.Modificado = true; ActualizarGruposConsolidados(); })" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>

                            @* Cargo / Puesto *@
                            <MudTd>
                                @if (context.Asistio)
                                {
                                    <MudSelect T="string" 
                                               @bind-Value="@context.Puesto" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined" 
                                               SelectedValuesChanged="@(() => { context.Modificado = true; ActualizarGruposConsolidados(); })">
                                        @foreach (var c in cargosDisponibles)
                                        {
                                            <MudSelectItem Value="@c">@c</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>

                            @* Turno / Horas (Botón Táctil de Rotación Rápida) *@
                            <MudTd>
                                @if (context.Asistio)
                                {
                                    <MudStack Spacing="0">
                                        <MudChip T="string" 
                                                 Color="Color.Primary" 
                                                 Variant="Variant.Outlined" 
                                                 Size="Size.Small" 
                                                 Class="cursor-pointer mb-1" 
                                                 OnClick="@(() => AlternarTurnoRapido(context))"
                                                 Title="Tocar para alternar turno (Diurno -> DCC -> Mixto -> Nocturno)">
                                            @context.TurnoNombre
                                        </MudChip>
                                        <MudText Typo="Typo.caption" Class="font-monospace text-center">
                                            @context.HoraEntrada - @context.HoraSalida
                                        </MudText>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>

                            @* Viáticos & BNC (C$) *@
                            <MudTd>
                                @if (context.Asistio)
                                {
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudNumericField T="decimal" 
                                                         Value="@context.VtcoTrasp" 
                                                         Label="Trasp" 
                                                         Variant="Variant.Outlined" 
                                                         Margin="Margin.Dense" 
                                                         Dense="true" 
                                                         Min="0" 
                                                         HideSpinButtons="true"
                                                         Style="width: 68px; font-size: 0.8rem; text-align: right;" 
                                                         ValueChanged="@((val) => { context.VtcoTrasp = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />

                                        <MudNumericField T="decimal" 
                                                         Value="@context.VtcoAlim" 
                                                         Label="Alim" 
                                                         Variant="Variant.Outlined" 
                                                         Margin="Margin.Dense" 
                                                         Dense="true" 
                                                         Min="0" 
                                                         HideSpinButtons="true"
                                                         Style="width: 68px; font-size: 0.8rem; text-align: right;" 
                                                         ValueChanged="@((val) => { context.VtcoAlim = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />

                                        <MudNumericField T="decimal" 
                                                         Value="@context.BonoBnc" 
                                                         Label="BNC" 
                                                         Variant="Variant.Outlined" 
                                                         Margin="Margin.Dense" 
                                                         Dense="true" 
                                                         Min="0" 
                                                         HideSpinButtons="true"
                                                         Style="width: 68px; font-size: 0.8rem; text-align: right;" 
                                                         ValueChanged="@((val) => { context.BonoBnc = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>

                            @* Acciones *@
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                               Color="Color.Error" 
                                               Size="Size.Small" 
                                               OnClick="@(() => EliminarEmpleadoDeJornada(context))"
                                               Title="Quitar de la jornada" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudStack AlignItems="AlignItems.Center" Class="py-6">
                                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.body1" Class="fw-bold">No se encontraron colaboradores que coincidan con '@textoBusqueda'</MudText>
                                @if (!string.IsNullOrWhiteSpace(textoBusqueda))
                                {
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Info" 
                                               Size="Size.Small" 
                                               StartIcon="@Icons.Material.Filled.PersonAdd" 
                                               Class="mt-2"
                                               OnClick="@(() => AbrirDialogoAgregarColaborador(textoBusqueda))">
                                        Agregar "@textoBusqueda" a la Jornada
                                    </MudButton>
                                }
                            </MudStack>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>

        @* ==========================================
           TAB 2: CONSOLIDADO & ENVÍO A HELPDESK
           ========================================== *@
        <MudTabPanel Text="Consolidado & Helpdesk  " Icon="@Icons.Material.Filled.ConfirmationNumber" BadgeData="@gruposConsolidados.Count" BadgeColor="Color.Primary">
            <MudPaper Class="pa-3 mt-2" Elevation="0">
                <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Outlined">
                    Esta pestaña agrupa automáticamente la asistencia activa exactamente con la lógica de <b>OPM_Produccion_Diaria_Hrs</b> 
                    para generar y sincronizar los tickets de <b>Movimientos de Personal (Tracker 1)</b> y <b>Viáticos Operativos (Tracker 28)</b> en Helpdesk.
                </MudAlert>

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.h6" Class="fw-bold">Grupos Listos para Helpdesk (@gruposConsolidados.Count)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Total de @TotalPresentes colaboradores distribuidos en @gruposConsolidados.Count asignaciones
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Size="Size.Large" 
                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                               Disabled="@(estaEnviandoHelpdesk || !gruposConsolidados.Any())"
                               OnClick="@EnviarAHelpdeskMasivo"
                               Style="font-weight: 800; letter-spacing: 0.5px; border-radius: 12px;">
                        @(estaEnviandoHelpdesk ? "Sincronizando con Helpdesk..." : "ENVIAR JORNADA A HELPDESK")
                    </MudButton>
                </MudStack>

                @if (estaEnviandoHelpdesk)
                {
                    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-2" />
                }

                @* Listado de Tarjetas de Grupos Consolidados *@
                <MudGrid Spacing="2">
                    @foreach (var grupo in gruposConsolidados)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudCard Elevation="2" Class="rounded-lg" Style="@(grupo.Sincronizado ? "border-left: 5px solid #10b981;" : "border-left: 5px solid #f59e0b;")">
                                <MudCardHeader Class="pb-1">
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="@(grupo.Sincronizado ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                                            #@grupo.GrupoIndex
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <div class="d-flex align-center gap-1 mb-1">
                                            @if (!string.IsNullOrWhiteSpace(grupo.Cliente))
                                            {
                                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="px-1 fw-bold" Style="height: 18px; font-size: 0.7rem;">
                                                    @grupo.Cliente
                                                </MudChip>
                                            }
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold text-truncate">
                                                @grupo.Area
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @grupo.Puesto • @grupo.TurnoNombre (@grupo.HoraInicio - @grupo.HoraFin)
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        @if (grupo.Sincronizado)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                                Sincronizado
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                                Pendiente
                                            </MudChip>
                                        }
                                    </CardHeaderActions>
                                </MudCardHeader>

                                <MudCardContent Class="pt-1 pb-2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Class="fw-bold">
                                            @grupo.Cantidad colaboradores asignados
                                        </MudText>
                                    </MudStack>

                                    @* Lista de Códigos/Carnets *@
                                    <MudPaper Class="pa-2 mb-2 rounded" Style="background: rgba(0,0,0,0.03); max-height: 80px; overflow-y: auto;">
                                        <MudText Typo="Typo.caption" Class="font-monospace fw-bold" Style="word-break: break-all;">
                                            @grupo.IdsEmpleadosTexto
                                        </MudText>
                                    </MudPaper>

                                    @* Viáticos *@
                                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                        @if (grupo.VtcoTrasp > 0)
                                        {
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                                Trasp: C$ @grupo.VtcoTrasp.ToString("N0") c/u
                                            </MudChip>
                                        }
                                        @if (grupo.VtcoAlim > 0)
                                        {
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                                Alim: C$ @grupo.VtcoAlim.ToString("N0") c/u
                                            </MudChip>
                                        }
                                        @if (grupo.VtcoBnc > 0)
                                        {
                                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">
                                                BNC: C$ @grupo.VtcoBnc.ToString("N0") c/u
                                            </MudChip>
                                        }
                                    </MudStack>

                                    @* Trazabilidad Helpdesk si ya fue enviado *@
                                    @if (grupo.TicketRedmineId.HasValue && grupo.TicketRedmineId > 0)
                                    {
                                        <MudDivider Class="my-2" />
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" Color="Color.Success" />
                                            <MudText Typo="Typo.caption" Class="fw-bold text-success">
                                                Ticket Redmine: #@grupo.TicketRedmineId
                                            </MudText>
                                            @if (grupo.TicketViaticoId.HasValue && grupo.TicketViaticoId > 0)
                                            {
                                                <MudText Typo="Typo.caption" Class="fw-bold text-info ml-2">
                                                    • Viáticos: #@grupo.TicketViaticoId
                                                </MudText>
                                            }
                                        </MudStack>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        @* ==========================================
           TAB 3: HISTORIAL & MODIFICACIONES
           ========================================== *@
        <MudTabPanel Text="Historial & Modificaciones  " Icon="@Icons.Material.Filled.History">
            <MudPaper Class="pa-3 mt-2" Elevation="0">
                <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudItem xs="12" sm="6" md="4">
                        <MudDatePicker Label="Consultar Fecha Anterior" 
                                       @bind-Date="fechaHistorial" 
                                       DateFormat="dd/MM/yyyy"
                                       Variant="Variant.Outlined" 
                                       Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="@ConsultarHistorial">
                            Buscar en Historial
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @if (cargandoHistorial)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else if (listaHistorial.Any())
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            Registros del @fechaHistorial:dd/MM/yyyy (@listaHistorial.Count movimientos)
                        </MudText>
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Secondary" 
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => CargarJornadaHistorialParaModificar(fechaHistorial!.Value))">
                            Cargar esta Jornada para Modificar
                        </MudButton>
                    </MudStack>

                    <MudTable Items="@listaHistorial" Dense="true" Hover="true" Striped="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>Código</MudTh>
                            <MudTh>Colaborador</MudTh>
                            <MudTh>Área</MudTh>
                            <MudTh>Cargo</MudTh>
                            <MudTh>Horario</MudTh>
                            <MudTh>Viáticos</MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh>Ticket Redmine</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><b>#@context.CodigoEmpleado</b></MudTd>
                            <MudTd>@context.NombreEmpleado</MudTd>
                            <MudTd>@context.Area</MudTd>
                            <MudTd>@context.Puesto</MudTd>
                            <MudTd>@context.HoraEntrada - @context.HoraSalida (@context.TurnoNombre)</MudTd>
                            <MudTd>Trasp: @context.VtcoTrasp | Alim: @context.VtcoAlim</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@(context.Estado == "SINCRONIZADO" ? Color.Success : Color.Default)">
                                    @context.Estado
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                @(context.TicketRedmineId.HasValue ? $"#{context.TicketRedmineId}" : "-")
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="py-4">
                        Selecciona una fecha y pulsa "Buscar en Historial" para revisar movimientos registrados previamente.
                    </MudText>
                }
            </MudPaper>
        </MudTabPanel>

        @* ==========================================
           TAB 4: MI PERSONAL (PLANTILLA PERMANENTE)
           ========================================== *@
        <MudTabPanel Text="Mi Personal  " Icon="@Icons.Material.Filled.Badge" BadgeData="@miPlantillaPersonal.Count" BadgeColor="Color.Info">
            <MudPaper Class="pa-4 mt-2" Elevation="0">
                <MudAlert Severity="Severity.Normal" Class="mb-3" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Info">
                    Define tu equipo habitual de colaboradores con su <b>Cliente Inicial</b>, área y puesto. 
                    Al abrir la aplicación o presionar <b>"Mi Personal"</b> en la barra superior, la jornada diaria se cargará automáticamente con esta lista.
                </MudAlert>

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap gap-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h6" Class="fw-bold">Plantilla de @currentUserName (@miPlantillaPersonal.Count colaboradores)</MudText>
                    </MudStack>

                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PersonAdd"
                                   OnClick="@(() => AbrirDialogoAgregarColaborador())">
                            + Agregar a Plantilla
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Secondary" 
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DownloadForOffline"
                                   Disabled="@(!empleadosJornada.Any())"
                                   OnClick="@GuardarJornadaComoMiPlantilla"
                                   Title="Guarda los colaboradores de la grilla diaria actual como tu plantilla permanente">
                            Guardar Grilla como Mi Plantilla
                        </MudButton>

                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Success" 
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Disabled="@(!miPlantillaPersonal.Any())"
                                   OnClick="@(() => PrecargarDesdeMiPlantilla())"
                                   Title="Cargar estos colaboradores a la grilla diaria">
                            Cargar en Grilla Diaria
                        </MudButton>
                    </MudStack>
                </MudStack>

                @* Buscador interno de plantilla *@
                <MudTextField @bind-Value="textoBusquedaPlantilla" 
                              Placeholder="Buscar en mi plantilla por nombre, carnet o cliente..." 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Class="mb-3"
                              Immediate="true" 
                              Clearable="true" />

                @if (cargandoPlantilla)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else if (!miPlantillaPersonal.Any())
                {
                    <MudPaper Elevation="0" Class="pa-8 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 16px;">
                        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Large" Color="Color.Info" Class="mb-2" />
                        <MudText Typo="Typo.h6" Class="fw-bold">Aún no tienes colaboradores en tu plantilla</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Puedes agregar colaboradores o, si ya tienes la jornada de hoy en la Grilla Diaria, presionar "Guardar Grilla como Mi Plantilla".
                        </MudText>
                        <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => AbrirDialogoAgregarColaborador())">
                                Agregar Primer Colaborador
                            </MudButton>
                            @if (empleadosJornada.Any())
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.DownloadForOffline" OnClick="@GuardarJornadaComoMiPlantilla">
                                    Importar de Grilla Diaria (@empleadosJornada.Count)
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                }
                else
                {
                    <MudTable Items="@PlantillaFiltrada" Dense="true" Hover="true" Striped="true" Elevation="1" Class="rounded-lg">
                        <HeaderContent>
                            <MudTh Style="width: 80px;">Carnet</MudTh>
                            <MudTh>Colaborador</MudTh>
                            <MudTh Style="width: 180px;">Cliente Inicial</MudTh>
                            <MudTh Style="width: 160px;">Área Inicial</MudTh>
                            <MudTh Style="width: 200px;">Puesto Inicial</MudTh>
                            <MudTh Style="width: 110px;">Turno</MudTh>
                            <MudTh Style="width: 170px;">Viáticos Base (C$)</MudTh>
                            <MudTh Style="width: 50px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold">
                                    #@context.CodigoEmpleado
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="fw-bold">@context.NombreEmpleado</MudText>
                            </MudTd>
                            <MudTd>
                                <MudSelect T="string" 
                                           Value="@context.ClienteDefault" 
                                           Dense="true" 
                                           Margin="Margin.Dense" 
                                           Variant="Variant.Outlined"
                                           ValueChanged="@(async (val) => { context.ClienteDefault = val; await GuardarItemPlantilla(context); })">
                                    @foreach (var op in operacionesList)
                                    {
                                        <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudTextField @bind-Value="@context.AreaDefault" 
                                              Dense="true" 
                                              Margin="Margin.Dense" 
                                              Variant="Variant.Outlined"
                                              OnBlur="@(async () => await GuardarItemPlantilla(context))" />
                            </MudTd>
                            <MudTd>
                                <MudSelect T="string" 
                                           Value="@context.PuestoDefault" 
                                           Dense="true" 
                                           Margin="Margin.Dense" 
                                           Variant="Variant.Outlined"
                                           ValueChanged="@(async (val) => { context.PuestoDefault = val; await GuardarItemPlantilla(context); })">
                                    @foreach (var c in cargosDisponibles)
                                    {
                                        <MudSelectItem Value="@c">@c</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Class="fw-bold">@context.TurnoDefault</MudText>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption">
                                    Tr: C$ @context.VtcoTraspDefault.ToString("N0") | Al: C$ @context.VtcoAlimDefault.ToString("N0")
                                    @(context.BonoBncDefault > 0 ? $" | BNC: C$ {context.BonoBncDefault:N0}" : "")
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                               Color="Color.Error" 
                                               Size="Size.Small" 
                                               OnClick="@(() => EliminarItemPlantilla(context))"
                                               Title="Quitar de mi plantilla" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</div>

<style>
    .tablet-tabs .mud-tabs-tabbar {
        padding-bottom: 4px;
    }
    .tablet-tabs .mud-tab {
        margin-right: 28px !important;
        padding-left: 20px !important;
        padding-right: 24px !important;
        font-weight: 700 !important;
        letter-spacing: 0.4px;
        min-height: 48px;
        border-radius: 8px !important;
    }
    .tablet-tabs .mud-tab-badge {
        margin-left: 12px !important;
        margin-right: 8px !important;
    }
    .tablet-tabs .mud-tab-slider {
        height: 3px !important;
    }
</style>
