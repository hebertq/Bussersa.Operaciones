@page "/operaciones/registro-movimientos-supervisor"
@layout TabletLayout
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using System.Globalization
@attribute [Authorize]

<div class="px-2 py-1">

    @* --- BARRA SUPERIOR DE CONTROL DE JORNADA --- *@
    <MudPaper Elevation="2" Class="pa-3 mb-3 rounded-lg" Style="border-left: 6px solid #f97316;">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            @* Fecha con Navegación Rápida de 1 Toque *@
            <MudItem xs="12" sm="5" md="4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                                   Size="Size.Medium" 
                                   Color="Color.Default" 
                                   OnClick="@(() => CambiarFecha(-1))" 
                                   Title="Día Anterior" />
                    <MudDatePicker Label="Fecha de la Jornada" 
                                   Date="@fechaSeleccionada" 
                                   DateChanged="@OnFechaSeleccionadaChanged"
                                   DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense"
                                   Class="flex-grow-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" 
                                   Size="Size.Medium" 
                                   Color="Color.Default" 
                                   OnClick="@(() => CambiarFecha(1))" 
                                   Title="Día Siguiente" />
                    <MudButton Variant="Variant.Outlined" 
                               Size="Size.Small" 
                               Color="Color.Primary" 
                               OnClick="@(() => OnFechaSeleccionadaChanged(DateTime.Today))">
                        Hoy
                    </MudButton>
                </MudStack>
            </MudItem>

            @* Botones Principales de Acción Táctica *@
            <MudItem xs="12" sm="7" md="8">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="flex-wrap">

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Custom.FileFormats.FileExcel"
                               Disabled="@(!empleadosJornada.Any())"
                               OnClick="@ExportarExcel"
                               Title="Exportar la jornada del día a archivo Excel (.xlsx)">
                        Excel
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Info" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="@(() => AbrirDialogoAgregarColaborador())"
                               Title="Agregar nuevo colaborador a la jornada">
                        + Colaborador
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Error" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               Disabled="@(!empleadosJornada.Any())"
                               OnClick="@LimpiarGrillaCompleta"
                               Title="Limpiar toda la grilla de la jornada">
                        Limpiar
                    </MudButton>

                    <MudButton Variant="Variant.Filled" 
                               Color="@(HayCambiosSinGuardar ? Color.Warning : Color.Success)" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(estaGuardando || estaCargando || !empleadosJornada.Any())"
                               OnClick="@GuardarEnBaseDatos">
                        @(estaGuardando ? "Guardando..." : "Guardar en BD")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        @* Cinta de Indicadores en Vivo *@
        <MudDivider Class="my-2" />
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap justify-space-between">
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Groups">
                    Total: <b>@TotalColaboradores</b>
                </MudChip>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                    Presentes: <b>@TotalPresentes</b>
                </MudChip>
                @if (TotalAusentes > 0)
                {
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel">
                        Ausentes: <b>@TotalAusentes</b>
                    </MudChip>
                }
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.DirectionsBus">
                    Trasp: <b>C$ @TotalViaticosTrasp.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Fastfood">
                    Alim: <b>C$ @TotalViaticosAlim.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CardGiftcard">
                    BNC: <b>C$ @TotalViaticosBnc.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Payments">
                    Total Viát: <b>C$ @TotalViaticosGlobal.ToString("N0")</b>
                </MudChip>
            </MudStack>

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Person">
                    Supervisor: <b>@(string.IsNullOrWhiteSpace(currentUserName) ? "Cargando..." : currentUserName)</b>
                </MudChip>
                @if (HayCambiosSinGuardar)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                        Cambios sin guardar en BD
                    </MudChip>
                }
                else if (empleadosJornada.Any())
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.CloudDone">
                        Sincronizado con BD
                    </MudChip>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    @* --- PESTAÑAS PRINCIPALES DE LA APLICACIÓN --- *@
    <MudTabs @bind-ActivePanelIndex="@activeTabIndex" 
             Elevation="2" 
             Rounded="true" 
             Border="true" 
             ApplyEffectsToContainer="true" 
             Color="Color.Surface" 
             SliderColor="Color.Secondary" 
             Class="tablet-tabs">

        @* ==========================================
           TAB 1: ASISTENCIAS
           ========================================== *@
        <MudTabPanel Text="Asistencias" ToolTip="Asistencias" Icon="@Icons.Material.Filled.TableChart" BadgeData="@TotalPresentes" BadgeColor="Color.Success">
            <MudPaper Class="pa-3 mt-2" Elevation="0">
                
                @* Barra de Filtros, Búsqueda y Modos de Vista Responsiva Estilo Odoo *@
                <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-2">
                    @* Izquierda: Buscador + Agregar Colaborador *@
                    <div class="d-flex align-center gap-1" style="flex: 1 1 280px; max-width: 440px;">
                        <MudTextField @bind-Value="textoBusqueda" 
                                      Placeholder="Buscar por nombre o carnet (#)..." 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Immediate="true" 
                                      Clearable="true" 
                                      Class="flex-grow-1" />
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.PersonAdd"
                                   OnClick="@(() => AbrirDialogoAgregarColaborador(textoBusqueda))"
                                   Style="white-space: nowrap; height: 36px; text-transform: none; font-weight: 600;"
                                   Title="Agregar colaborador a la jornada">
                            + Colaborador
                        </MudButton>
                    </div>

                    @* Derecha: Filtros de Asistencia y Control de Vistas Estilo Odoo *@
                    <div class="d-flex flex-wrap align-center gap-2 justify-end" style="flex: 2 1 auto;">
                        @* Filtros de Asistencia y Selección Rápida *@
                        <div class="d-flex align-center gap-1 flex-wrap">
                            <MudChip T="string" Color="@(filtroAsistencia == "TODOS" ? Color.Primary : Color.Default)"
                                     Variant="@(filtroAsistencia == "TODOS" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroAsistencia = "TODOS")">
                                Todos (@TotalColaboradores)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroAsistencia == "PRESENTES" ? Color.Success : Color.Default)"
                                     Variant="@(filtroAsistencia == "PRESENTES" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroAsistencia = "PRESENTES")">
                                Presentes (@TotalPresentes)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroAsistencia == "AUSENTES" ? Color.Error : Color.Default)"
                                     Variant="@(filtroAsistencia == "AUSENTES" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroAsistencia = "AUSENTES")">
                                Ausentes (@TotalAusentes)
                            </MudChip>
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Class="px-1" 
                                       OnClick="@(() => MarcarTodos(true))">
                                Todos
                            </MudButton>
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Class="px-1" 
                                       OnClick="@(() => MarcarTodos(false))">
                                Ninguno
                            </MudButton>
                        </div>

                                                                                                @* Control de Vistas Estilo Odoo *@
                        <div class="odoo-view-switcher" role="group" aria-label="Cambiar modo de vista">
                            <MudTooltip Text="Vista Horarios, Comida & Viáticos" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Operativo ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Operativo)"
                                        title="Vista Horarios, Comida & Viáticos">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Ubicación & Puesto (Cliente, Área, Cargo)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Ubicacion ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Ubicacion)"
                                        title="Vista Ubicación & Puesto">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tabla Completa (Todas las columnas)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Completo ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Completo)"
                                        title="Vista Tabla Completa">
                                    <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tarjetas (Kanban estilo Odoo)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Tarjetas ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Tarjetas)"
                                        title="Vista Tarjetas (Kanban)">
                                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                        </div>
                    </div>
                </div>

                @* BARRA DE ACCIÓN FLOTANTE / MASIVA (Cuando hay seleccionados) *@
                @if (CantidadSeleccionados > 0)
                {
                    <MudPaper Elevation="3" Class="pa-2 px-3 mb-3 d-flex align-center justify-space-between flex-wrap gap-2" Style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudBadge Content="@CantidadSeleccionados" Color="Color.Primary" Overlap="true">
                                <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Medium" />
                            </MudBadge>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                @CantidadSeleccionados colaboradores seleccionados
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.Bolt"
                                       OnClick="@AbrirAsignacionMasiva"
                                       Style="text-transform: none; font-weight: 600;">
                                Asignación Masiva
                            </MudButton>
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Success" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="@(() => MarcarAsistenciaSeleccionados(true))"
                                       Style="text-transform: none;">
                                Presentes
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Error" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.Cancel"
                                       OnClick="@(() => MarcarAsistenciaSeleccionados(false))"
                                       Style="text-transform: none;">
                                Ausentes
                            </MudButton>
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       OnClick="@(() => MarcarTodos(false))"
                                       Style="text-transform: none;">
                                Desmarcar
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }

                @* ESTADO VACÍO CUANDO NO HAY EMPLEADOS *@
                @if (!empleadosJornada.Any())
                {
                    <MudPaper Class="pa-8 my-4 text-center d-flex flex-column align-center justify-center" 
                              Elevation="0" 
                              Style="background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 12px; min-height: 280px;">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Color="Color.Warning" Class="mb-3" Style="font-size: 3rem;" />
                        <MudText Typo="Typo.h6" Class="fw-bold text-dark mb-1">
                            No hay movimientos registrados para esta fecha
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 500px;">
                            Puedes precargar los colaboradores activos de la operación o copiar la distribución de ayer.
                        </MudText>
                        <MudStack Row="true" Spacing="2" Class="flex-wrap justify-center">
                            @if (miPlantillaPersonal.Any())
                            {
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Dark" 
                                           StartIcon="@Icons.Material.Filled.Groups" 
                                           OnClick="@(() => PrecargarDesdeMiPlantilla(true))"
                                           Style="text-transform: none; font-weight: 700; background: #0f172a; color: white;">
                                    CARGAR MI PERSONAL
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Warning" 
                                       StartIcon="@Icons.Material.Filled.ContentCopy" 
                                       OnClick="@CopiarDeAyer"
                                       Style="text-transform: none; font-weight: 700; border-color: #f97316; color: #ea580c;">
                                COPIAR JORNADA DE AYER
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }
                else if (modoVistaGrilla == ModoVistaGrilla.Tarjetas)
                {
                    @* VISTA MODO TARJETAS (KANBAN TOUCH-FRIENDLY PARA TABLETS) *@
                    <MudGrid Spacing="2" Class="mb-2">
                        @foreach (var emp in EmpleadosFiltrados)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudCard Elevation="2" 
                                         Class="@(emp.Seleccionado ? "border-2 border-primary" : "")" 
                                         Style="@($"border-radius: 12px; transition: transform 0.15s ease, box-shadow 0.15s ease; border-left: 5px solid {(emp.Asistio ? "#16a34a" : "#dc2626")};")">
                                    <MudCardHeader Class="pa-2 pb-1">
                                        <CardHeaderAvatar>
                                            <MudCheckBox @bind-Value="@emp.Seleccionado" Color="Color.Primary" Dense="true" Class="ma-0 pa-0" />
                                        </CardHeaderAvatar>
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-1">
                                                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 18px; font-size: 0.7rem; min-width: 42px; justify-content: center;">
                                                    #@emp.CodigoEmpleado
                                                </MudChip>
                                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-truncate" Style="max-width: 140px;" Title="@emp.NombreEmpleado">
                                                    @emp.NombreEmpleado
                                                </MudText>
                                            </div>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                           Color="Color.Error" 
                                                           Size="Size.Small" 
                                                           OnClick="@(() => EliminarEmpleadoDeJornada(emp))" 
                                                           Title="Quitar de jornada" />
                                        </CardHeaderActions>
                                    </MudCardHeader>

                                    <MudCardContent Class="pa-2 pt-0 pb-1">
                                        @* Asistencia *@
                                        <div class="d-flex align-center justify-space-between mb-2">
                                            <MudChip T="string" 
                                                     Color="@(emp.Asistio ? Color.Success : Color.Error)" 
                                                     Variant="@(emp.Asistio ? Variant.Filled : Variant.Outlined)" 
                                                     Size="Size.Small" 
                                                     Class="cursor-pointer fw-bold" 
                                                     Style="height: 22px; font-size: 0.72rem;"
                                                     OnClick="@(() => { emp.Asistio = !emp.Asistio; emp.Modificado = true; ActualizarGruposConsolidados(); })">
                                                @(emp.Asistio ? "PRESENTE" : "AUSENTE")
                                            </MudChip>

                                            @* Viáticos Resumen *@
                                            @{
                                                var totViatico = emp.VtcoTrasp + emp.VtcoAlim + emp.BonoBnc;
                                            }
                                            <MudChip T="string" 
                                                     Color="@(totViatico > 0 ? Color.Info : Color.Default)" 
                                                     Variant="@(totViatico > 0 ? Variant.Filled : Variant.Outlined)" 
                                                     Size="Size.Small" 
                                                     Class="cursor-pointer font-monospace fw-bold" 
                                                     Style="height: 22px; font-size: 0.72rem;"
                                                     OnClick="@(() => AbrirEditorViaticoIndividual(emp))"
                                                     Title="Configurar viáticos y bono BNC">
                                                @(totViatico > 0 ? $"C$ {totViatico:N0}" : "+ Viático")
                                            </MudChip>
                                        </div>

                                        @* Ubicación: Cliente, Área, Cargo *@
                                        <div class="d-flex flex-column gap-1 mb-2 text-secondary" style="font-size: 0.75rem;">
                                            <div class="d-flex align-center gap-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="font-size: 0.85rem;" Color="Color.Primary" />
                                                <b class="text-primary text-truncate">@emp.Cliente</b>
                                                <span>•</span>
                                                <span class="text-truncate">@emp.Area</span>
                                            </div>
                                            <div class="text-truncate text-muted pl-3">
                                                @emp.Puesto
                                            </div>
                                        </div>

                                        @* Horario y Tiempo de Comida *@
                                        <div class="d-flex align-center justify-space-between pt-1 border-top" style="font-size: 0.75rem;">
                                            <div class="d-flex align-center gap-1 font-monospace">
                                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Style="font-size: 0.85rem;" Color="Color.Default" />
                                                <input type="text" value="@emp.HoraEntrada" 
                                                       @onchange="@((ChangeEventArgs e) => OnHorarioEntradaCambiado(emp, e.Value?.ToString()))" 
                                                       style="width: 44px; border: 1px solid #ced4da; border-radius: 4px; padding: 1px; font-size: 0.75rem; text-align: center;" 
                                                       title="Hora Entrada" />
                                                <span>-</span>
                                                <input type="text" value="@emp.HoraSalida" 
                                                       @onchange="@((ChangeEventArgs e) => OnHorarioSalidaCambiado(emp, e.Value?.ToString()))" 
                                                       style="width: 44px; border: 1px solid #ced4da; border-radius: 4px; padding: 1px; font-size: 0.75rem; text-align: center;" 
                                                       title="Hora Salida" />
                                            </div>

                                            <select value="@emp.TiempoComida" 
                                                    @onchange="@((ChangeEventArgs e) => OnTiempoComidaCambiado(emp, e.Value?.ToString()))" 
                                                    style="width: 68px; font-size: 0.72rem; border: 1px solid #ced4da; border-radius: 4px; padding: 1px 2px; background: white;" 
                                                    title="Tiempo de comida">
                                                <option value="1.00">1.0h</option>
                                                <option value="0.50">0.5h</option>
                                                <option value="0.00">0h</option>
                                            </select>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    @* VISTA MODO TABLA COMPLETA / OPERATIVA / UBICACIÓN *@
                    <MudTable Items="@EmpleadosFiltrados" 
                              Dense="true" 
                              Hover="true" 
                              Striped="true" 
                              Elevation="0" 
                              Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            @if (modoVistaGrilla == ModoVistaGrilla.Operativo)
                            {
                                <MudTh Style="width: 44px;">
                                    <MudCheckBox T="bool" 
                                                 Value="@(EmpleadosFiltrados.Any() && EmpleadosFiltrados.All(x => x.Seleccionado))" 
                                                 ValueChanged="@MarcarTodos" 
                                                 Color="Color.Primary" />
                                </MudTh>
                                <MudTh>Colaborador & Ubicación Asignada</MudTh>
                                <MudTh Style="width: 105px;">Asistencia</MudTh>
                                <MudTh Style="width: 140px;">Horario</MudTh>
                                <MudTh Style="width: 85px;">Comida</MudTh>
                                <MudTh Style="width: 130px;">Viáticos</MudTh>
                                <MudTh Style="width: 45px;"></MudTh>
                            }
                            else if (modoVistaGrilla == ModoVistaGrilla.Ubicacion)
                            {
                                <MudTh Style="width: 44px;">
                                    <MudCheckBox T="bool" 
                                                 Value="@(EmpleadosFiltrados.Any() && EmpleadosFiltrados.All(x => x.Seleccionado))" 
                                                 ValueChanged="@MarcarTodos" 
                                                 Color="Color.Primary" />
                                </MudTh>
                                <MudTh>Colaborador</MudTh>
                                <MudTh Style="width: 105px;">Asistencia</MudTh>
                                <MudTh Style="width: 220px;">Cliente / Operación</MudTh>
                                <MudTh Style="min-width: 190px;">Área Operativa</MudTh>
                                <MudTh Style="width: 200px;">Cargo / Puesto</MudTh>
                                <MudTh Style="width: 45px;"></MudTh>
                            }
                            else
                            {
                                @* ModoVistaGrilla.Completo *@
                                <MudTh Style="width: 44px;">
                                    <MudCheckBox T="bool" 
                                                 Value="@(EmpleadosFiltrados.Any() && EmpleadosFiltrados.All(x => x.Seleccionado))" 
                                                 ValueChanged="@MarcarTodos" 
                                                 Color="Color.Primary" />
                                </MudTh>
                                <MudTh>Colaborador</MudTh>
                                <MudTh Style="width: 105px;">Asistencia</MudTh>
                                <MudTh Style="width: 170px;">Cliente / Operación</MudTh>
                                <MudTh Style="min-width: 170px;">Área Operativa</MudTh>
                                <MudTh Style="width: 180px;">Cargo / Puesto</MudTh>
                                <MudTh Style="width: 140px;">Horario</MudTh>
                                <MudTh Style="width: 85px;">Comida</MudTh>
                                <MudTh Style="width: 130px;">Viáticos</MudTh>
                                <MudTh Style="width: 45px;"></MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            @if (modoVistaGrilla == ModoVistaGrilla.Operativo)
                            {
                                <MudTd>
                                    <MudCheckBox @bind-Value="@context.Seleccionado" Color="Color.Primary" />
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-column">
                                        <div class="d-flex align-center gap-2">
                                            <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem; min-width: 48px; justify-content: center;">
                                                #@context.CodigoEmpleado
                                            </MudChip>
