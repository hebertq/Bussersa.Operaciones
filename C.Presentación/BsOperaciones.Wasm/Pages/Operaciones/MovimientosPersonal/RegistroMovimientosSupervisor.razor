                                                                       Variant="Variant.Outlined" 
                                                                       Color="Color.Default" 
                                                                       Size="Size.Small" 
                                                                       Style="height: 24px; width: 24px; border-radius: 6px;" 
                                                                       OnClick="@(() => AbrirEditorViaticoIndividual(emp, false))" />
                                                    </MudTooltip>
