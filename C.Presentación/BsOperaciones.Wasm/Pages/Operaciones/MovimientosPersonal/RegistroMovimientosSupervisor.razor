                                    <div class="d-flex align-center gap-1 font-monospace" style="font-size: 0.8rem;">
                                        <input type="text" value="@context.HoraEntrada" 
                                               @onchange="@((ChangeEventArgs e) => OnHorarioEntradaCambiado(context, e.Value?.ToString()))" 
                                               style="width: 48px; border: 1px solid #ced4da; border-radius: 4px; padding: 2px; text-align: center;" 
                                               title="Hora Entrada (ej. 06:00)" />
                                        <span>-</span>
                                        <input type="text" value="@context.HoraSalida" 
