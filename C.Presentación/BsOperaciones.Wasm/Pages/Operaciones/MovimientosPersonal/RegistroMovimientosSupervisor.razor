                                <MudTd>
                                    <div class="d-flex align-center gap-2">
                                        <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem; min-width: 48px; justify-content: center;">
                                            #@context.CodigoEmpleado
                                        </MudChip>
                                        <MudText Typo="Typo.body2" Class="fw-bold" Style="white-space: normal; line-height: 1.2;">
                                            @context.NombreEmpleado
                                        </MudText>
                                        @if (string.Equals(context.TipoEmpleado, "Prestamo", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Class="px-1 fw-bold" Style="height: 18px; font-size: 0.65rem; background: #ea580c; color: white;">
                                                PRÉSTAMO
                                            </MudChip>
                                        }
                                    </div>
                                </MudTd>
