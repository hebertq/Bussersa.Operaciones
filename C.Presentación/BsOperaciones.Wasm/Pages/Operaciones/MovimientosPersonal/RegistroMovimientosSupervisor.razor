                                             Size="Size.Small" 
                                             Class="cursor-pointer" 
                                             OnClick="@(() => { context.Asistio = !context.Asistio; context.Modificado = true; ActualizarGruposConsolidados(); })">
                                        @(context.Asistio ? "PRESENTE" : "AUSENTE")
                                    </MudChip>
                                </MudTd>
