                                                       value="@(emp.Asistio ? emp.HoraEntrada : "--:--")" 
                                                       disabled="@(!emp.Asistio)"
                                                       @onchange="@((ChangeEventArgs e) => OnHorarioEntradaCambiado(emp, e.Value?.ToString()))" 
                                                       style="@($"width: 44px; border: {(emp.TieneConflictoHorario ? "2px solid #ef4444" : (emp.Asistio ? "1px solid #ced4da" : "1px dashed #cbd5e1"))}; border-radius: 4px; padding: 1px; font-size: 0.75rem; text-align: center; background: {(emp.TieneConflictoHorario ? "#fee2e2" : (emp.Asistio ? "white" : "#f8fafc"))}; color: {(emp.TieneConflictoHorario ? "#b91c1c; font-weight: bold;" : (emp.Asistio ? "inherit" : "#94a3b8"))};")" 
                                                       title="@(emp.Asistio ? "Hora Entrada" : "Ausente")" />
                                                <span>-</span>
                                                <input type="text" 
                                                       value="@(emp.Asistio ? emp.HoraSalida : "--:--")" 
                                                       disabled="@(!emp.Asistio)"
                                                       @onchange="@((ChangeEventArgs e) => OnHorarioSalidaCambiado(emp, e.Value?.ToString()))" 
                                                       style="@($"width: 44px; border: {(emp.TieneConflictoHorario ? "2px solid #ef4444" : (emp.Asistio ? "1px solid #ced4da" : "1px dashed #cbd5e1"))}; border-radius: 4px; padding: 1px; font-size: 0.75rem; text-align: center; background: {(emp.TieneConflictoHorario ? "#fee2e2" : (emp.Asistio ? "white" : "#f8fafc"))}; color: {(emp.TieneConflictoHorario ? "#b91c1c; font-weight: bold;" : (emp.Asistio ? "inherit" : "#94a3b8"))};")" 
                                                       title="@(emp.Asistio ? "Hora Salida" : "Ausente")" />
