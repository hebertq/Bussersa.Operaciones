                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="fw-bold" Style="font-size: 0.70rem; height: 20px;">
                                            #@context.TicketRedmineId
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" Style="font-size: 0.70rem; height: 20px;">
                                            Pendiente
                                        </MudChip>
                                    }
                                </MudTd>
                            }
                            else
                            {
                                @* ModoVistaGrilla.Completo *@
                                <MudTd>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-monospace fw-bold">
                                        #@context.GrupoIndex
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <b class="text-primary" style="font-size: 0.78rem;">@context.Cliente</b>
                                </MudTd>
                                <MudTd>
                                    <span class="fw-bold" style="font-size: 0.78rem;">@context.Area</span>
                                </MudTd>
                                <MudTd>
                                    <span class="text-secondary" style="font-size: 0.75rem;">@context.Puesto</span>
                                </MudTd>
                                <MudTd>
                                    <span class="font-monospace" style="font-size: 0.75rem;">@context.HoraInicio - @context.HoraFin</span>
                                </MudTd>
                                <MudTd>
                                    <span class="font-monospace" style="font-size: 0.75rem;">@context.TiempoComida h</span>
