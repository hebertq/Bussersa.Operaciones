                                                <span>•</span>
                                                <span class="text-truncate">@emp.Area</span>
                                            </div>
                                            <div class="text-truncate text-muted pl-3">
                                                @emp.Puesto
                                            </div>
                                        </div>

                                        @if (emp.TieneConflictoHorario)
                                        {
                                            <div class="pa-1 mb-1 rounded d-flex align-center gap-1" style="background: #fee2e2; border: 1px solid #f87171; color: #991b1b; font-size: 0.70rem; line-height: 1.2;">
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Style="font-size: 0.85rem;" Color="Color.Error" />
                                                <span><b>Cruce de horario:</b> @emp.DetalleConflictoHorario</span>
                                            </div>
                                        }

                                        @* Horario y Tiempo de Comida *@
                                        <div class="d-flex align-center justify-space-between pt-1 border-top" style="font-size: 0.75rem;">
                                            <div class="d-flex align-center gap-1 font-monospace">
                                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Style="font-size: 0.85rem;" Color="@(emp.TieneConflictoHorario ? Color.Error : Color.Default)" />
