                                            <input type="number" 
                                                   step="any" 
                                                   min="0" 
                                                   max="24" 
                                                   disabled="@(!emp.Asistio)"
                                                   value="@(emp.Asistio ? emp.TiempoComida : "0")" 
                                                   @onchange="@((ChangeEventArgs e) => OnTiempoComidaCambiado(emp, e.Value?.ToString()))" 
                                                   style="@($"width: 52px; font-size: 0.72rem; border: 1px {(emp.Asistio ? "solid #ced4da" : "dashed #cbd5e1")}; border-radius: 4px; padding: 1px 2px; text-align: center; background: {(emp.Asistio ? "white" : "#f8fafc")}; color: {(emp.Asistio ? "inherit" : "#94a3b8")};")" 
                                                   title="@(emp.Asistio ? "Tiempo de comida en horas" : "Comida (0 para ausentes)")" />
                                        </div>

                                        @* Tickets de Helpdesk *@
                                        <div class="d-flex align-center gap-1 flex-wrap pt-1 border-top mt-1" style="font-size: 0.72rem;">
                                            <span class="text-muted fw-bold" style="font-size: 0.68rem;">Tickets:</span>
                                            @if (emp.TicketRedmineId.HasValue && emp.TicketRedmineId > 0)
                                            {
                                                <MudTooltip Text="Ver Movimiento en Helpdesk" Arrow="true">
                                                    <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{emp.TicketRedmineId}")" Target="_blank" Underline="Underline.None">
                                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Style="height: 18px; font-size: 0.65rem; font-weight: 700; padding: 0 4px;">
                                                            Mov #@emp.TicketRedmineId
                                                        </MudChip>
                                                    </MudLink>
                                                </MudTooltip>
                                            }
                                            @if (emp.TicketViaticoId.HasValue && emp.TicketViaticoId > 0)
                                            {
                                                <MudTooltip Text="Ver Viáticos en Helpdesk" Arrow="true">
                                                    <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{emp.TicketViaticoId}")" Target="_blank" Underline="Underline.None">
                                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Style="height: 18px; font-size: 0.65rem; font-weight: 700; padding: 0 4px;">
                                                            Viat #@emp.TicketViaticoId
                                                        </MudChip>
                                                    </MudLink>
                                                </MudTooltip>
                                            }
                                            @if (emp.TicketBonoId.HasValue && emp.TicketBonoId > 0)
                                            {
                                                <MudTooltip Text="Ver Bono en Helpdesk" Arrow="true">
                                                    <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{emp.TicketBonoId}")" Target="_blank" Underline="Underline.None">
                                                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Style="height: 18px; font-size: 0.65rem; font-weight: 700; padding: 0 4px;">
                                                            Bono #@emp.TicketBonoId
                                                        </MudChip>
                                                    </MudLink>
                                                </MudTooltip>
                                            }
                                            @if (emp.TicketAusenciaId.HasValue && emp.TicketAusenciaId > 0)
                                            {
                                                <MudTooltip Text="Ver Ausencia en Helpdesk" Arrow="true">
                                                    <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{emp.TicketAusenciaId}")" Target="_blank" Underline="Underline.None">
                                                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Style="height: 18px; font-size: 0.65rem; font-weight: 700; padding: 0 4px;">
                                                            Aus #@emp.TicketAusenciaId
                                                        </MudChip>
                                                    </MudLink>
                                                </MudTooltip>
                                            }
                                            @if (!emp.TicketRedmineId.HasValue && !emp.TicketViaticoId.HasValue && !emp.TicketBonoId.HasValue && !emp.TicketAusenciaId.HasValue)
                                            {
                                                <span class="text-muted font-monospace" style="font-size: 0.68rem;">—</span>
                                            }
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    @* VISTA MODO TABLA COMPLETA / OPERATIVA / UBICACIÓN *@
