@page "/operaciones/registro-movimientos-supervisor"
@layout TabletLayout
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using System.Globalization
@attribute [Authorize]

<div class="px-2 py-1">

    @* --- BARRA SUPERIOR DE CONTROL DE JORNADA --- *@
    <MudPaper Elevation="2" Class="pa-3 mb-3 rounded-lg" Style="border-left: 6px solid #f97316;">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            @* Fecha con Navegación Rápida de 1 Toque *@
            <MudItem xs="12" sm="5" md="4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                                   Size="Size.Medium" 
                                   Color="Color.Default" 
                                   OnClick="@(() => CambiarFecha(-1))" 
                                   Title="Día Anterior" />
                    <MudDatePicker Label="Fecha de la Jornada" 
                                   Date="@fechaSeleccionada" 
                                   DateChanged="@OnFechaSeleccionadaChanged"
                                   DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined" 
                                   Margin="Margin.Dense"
                                   Class="flex-grow-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" 
                                   Size="Size.Medium" 
                                   Color="Color.Default" 
                                   OnClick="@(() => CambiarFecha(1))" 
                                   Title="Día Siguiente" />
                    <MudButton Variant="Variant.Outlined" 
                               Size="Size.Small" 
                               Color="Color.Primary" 
                               OnClick="@(() => OnFechaSeleccionadaChanged(DateTime.Today))">
                        Hoy
                    </MudButton>
                </MudStack>
            </MudItem>

            @* Botones Principales de Acción Táctica *@
            <MudItem xs="12" sm="7" md="8">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.Groups"
                               Disabled="@estaCargando"
                               OnClick="@(() => PrecargarDesdeMiPlantilla())"
                               Title="Cargar mi equipo habitual con sus clientes asignados">
                        Mi Personal
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.ContentCopy"
                               Disabled="@estaCargando"
                               OnClick="@CopiarDeAyer"
                               Title="Copiar jornada del día anterior">
                        Copiar Ayer
                    </MudButton>

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Custom.FileFormats.FileExcel"
                               Disabled="@(!empleadosJornada.Any())"
                               OnClick="@ExportarExcel"
                               Title="Exportar la jornada del día a archivo Excel (.xlsx)">
                        Excel
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Info" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="@(() => AbrirDialogoAgregarColaborador())"
                               Title="Agregar nuevo colaborador a la jornada">
                        + Colaborador
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Error" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               Disabled="@(!empleadosJornada.Any())"
                               OnClick="@LimpiarGrillaCompleta"
                               Title="Limpiar toda la grilla de la jornada">
                        Limpiar
                    </MudButton>

                    <MudButton Variant="Variant.Filled" 
                               Color="@(HayCambiosSinGuardar ? Color.Warning : Color.Success)" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(estaGuardando || estaCargando || !empleadosJornada.Any())"
                               OnClick="@GuardarEnBaseDatos">
                        @(estaGuardando ? "Guardando..." : "Guardar en BD")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        @* Cinta de Indicadores en Vivo *@
        <MudDivider Class="my-2" />
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap justify-space-between">
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Groups">
                    Total: <b>@TotalColaboradores</b>
                </MudChip>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                    Presentes: <b>@TotalPresentes</b>
                </MudChip>
                @if (TotalAusentes > 0)
                {
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel">
                        Ausentes: <b>@TotalAusentes</b>
                    </MudChip>
                }
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.DirectionsBus">
                    Trasp: <b>C$ @TotalViaticosTrasp.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Fastfood">
                    Alim: <b>C$ @TotalViaticosAlim.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CardGiftcard">
                    BNC: <b>C$ @TotalViaticosBnc.ToString("N0")</b>
                </MudChip>
                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Payments">
                    Total Viát: <b>C$ @TotalViaticosGlobal.ToString("N0")</b>
                </MudChip>
            </MudStack>

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Person">
                    Supervisor: <b>@(string.IsNullOrWhiteSpace(currentUserName) ? "Cargando..." : currentUserName)</b>
                </MudChip>
                @if (HayCambiosSinGuardar)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                        Cambios sin guardar en BD
                    </MudChip>
                }
                else if (empleadosJornada.Any())
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.CloudDone">
                        Sincronizado con BD
                    </MudChip>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    @* --- PESTAÑAS PRINCIPALES DE LA APLICACIÓN --- *@
    <MudTabs @bind-ActivePanelIndex="@activeTabIndex" 
             Elevation="2" 
             Rounded="true" 
             Border="true" 
             ApplyEffectsToContainer="true" 
             Color="Color.Surface" 
             SliderColor="Color.Secondary" 
             Class="tablet-tabs">

        @* ==========================================
           TAB 1: ASISTENCIAS
           ========================================== *@
        <MudTabPanel Text="Asistencias" ToolTip="Asistencias" Icon="@Icons.Material.Filled.TableChart" BadgeData="@TotalPresentes" BadgeColor="Color.Success">
            <MudPaper Class="pa-3 mt-2" Elevation="0">
                
                @* Barra de Filtros, Búsqueda y Modos de Vista Responsiva Estilo Odoo *@
                <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-2">
                    @* Izquierda: Buscador + Agregar Colaborador *@
                    <div class="d-flex align-center gap-1" style="flex: 1 1 280px; max-width: 440px;">
                        <MudTextField @bind-Value="textoBusqueda" 
                                      Placeholder="Buscar por nombre o carnet (#)..." 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Immediate="true" 
                                      Clearable="true" 
                                      Class="flex-grow-1" />
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.PersonAdd"
                                   OnClick="@(() => AbrirDialogoAgregarColaborador(textoBusqueda))"
                                   Style="white-space: nowrap; height: 36px; text-transform: none; font-weight: 600;"
                                   Title="Agregar colaborador o segundo turno a la jornada">
                            + Colaborador
                        </MudButton>
                    </div>

                    @* Derecha: Filtros de Asistencia y Control de Vistas Estilo Odoo *@
                    <div class="d-flex flex-wrap align-center gap-2 justify-end" style="flex: 2 1 auto;">
                        @* Filtros de Asistencia y Selección Rápida *@
                        <div class="d-flex align-center gap-1 flex-wrap">
                            <MudChip T="string" Color="@(filtroAsistencia == "TODOS" ? Color.Primary : Color.Default)"
                                     Variant="@(filtroAsistencia == "TODOS" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroAsistencia = "TODOS")">
                                Todos (@TotalColaboradores)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroAsistencia == "PRESENTES" ? Color.Success : Color.Default)"
                                     Variant="@(filtroAsistencia == "PRESENTES" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroAsistencia = "PRESENTES")">
                                Presentes (@TotalPresentes)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroAsistencia == "AUSENTES" ? Color.Error : Color.Default)"
                                     Variant="@(filtroAsistencia == "AUSENTES" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroAsistencia = "AUSENTES")">
                                Ausentes (@TotalAusentes)
                            </MudChip>
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Class="px-1" 
                                       OnClick="@(() => MarcarTodos(true))">
                                Todos
                            </MudButton>
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Class="px-1" 
                                       OnClick="@(() => MarcarTodos(false))">
                                Ninguno
                            </MudButton>
                        </div>

                        @* Control de Vistas Estilo Odoo *@
                        <div class="odoo-view-switcher" role="group" aria-label="Cambiar modo de vista">
                            <MudTooltip Text="Vista Operativa (Horarios, Comida & Viáticos)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Operativo ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Operativo)"
                                        title="Vista Operativa (Horarios, Comida & Viáticos)">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Ubicación & Puesto (Cliente, Área, Cargo)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Ubicacion ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Ubicacion)"
                                        title="Vista Ubicación & Puesto">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tabla Completa (Todas las columnas)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Completo ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Completo)"
                                        title="Vista Tabla Completa">
                                    <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tarjetas (Kanban estilo Odoo)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaGrilla == ModoVistaGrilla.Tarjetas ? "active" : "")" 
                                        @onclick="@(() => modoVistaGrilla = ModoVistaGrilla.Tarjetas)"
                                        title="Vista Tarjetas (Kanban)">
                                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                        </div>
                    </div>
                </div>

                @* BARRA DE ACCIÓN FLOTANTE / MASIVA (Cuando hay seleccionados) *@
                @if (CantidadSeleccionados > 0)
                {
                    <MudPaper Elevation="4" Class="pa-2 mb-2 rounded-lg" Style="background: linear-gradient(90deg, #0f172a, #1e293b); color: white;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudBadge Content="@CantidadSeleccionados" Color="Color.Secondary" Overlap="false" Class="mx-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Medium" />
                                </MudBadge>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                    @CantidadSeleccionados colaboradores seleccionados
                                </MudText>
                            </MudStack>

                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Secondary" 
                                           Size="Size.Medium" 
                                           StartIcon="@Icons.Material.Filled.Bolt"
                                           OnClick="@AbrirAsignacionMasiva">
                                    Asignación Masiva
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Success" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Check"
                                           OnClick="@(() => MarcarAsistenciaSeleccionados(true))">
                                    Presentes
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Close"
                                           OnClick="@(() => MarcarAsistenciaSeleccionados(false))">
                                    Ausentes
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }

                @* TABLA PRINCIPAL DE EMPLEADOS (Touch-Friendly) *@
                @if (estaCargando)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="py-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle1" Class="mt-2">Cargando jornada...</MudText>
                    </MudStack>
                }
                else if (!empleadosJornada.Any())
                {
                    <MudPaper Elevation="0" Class="pa-8 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 16px;">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.h6" Class="fw-bold">No hay movimientos registrados para esta fecha</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Puedes precargar los colaboradores activos de la operación o copiar la distribución de ayer.
                        </MudText>
                        <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       StartIcon="@Icons.Material.Filled.Group"
                                       OnClick="@(() => PrecargarDesdeMiPlantilla(true))">
                                Cargar Mi Personal
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Secondary" 
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="@CopiarDeAyer">
                                Copiar Jornada de Ayer
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }
                else if (modoVistaGrilla == ModoVistaGrilla.Tarjetas)
                {
                    @* --- MODO TARJETAS TOUCH-FRIENDLY (Estilo Odoo Kanban) --- *@
                    <MudGrid Spacing="2">
                        @foreach (var context in EmpleadosFiltrados)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudCard Elevation="2" Class="rounded-lg pa-3" Style="@(context.Asistio ? "border-left: 5px solid #10b981; border: 1px solid #e2e8f0;" : "border-left: 5px solid #ef4444; border: 1px solid #e2e8f0; opacity: 0.85;")">
                                    <div class="d-flex align-center justify-space-between mb-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudCheckBox @bind-Value="@context.Seleccionado" Color="Color.Primary" Dense="true" />
                                            <MudAvatar Color="@(context.Asistio ? Color.Primary : Color.Default)" Variant="Variant.Filled" Size="Size.Medium" Style="font-size: 0.85rem; font-weight: 700;">
                                                @(string.IsNullOrWhiteSpace(context.NombreEmpleado) ? "?" : context.NombreEmpleado.Substring(0, 1))
                                            </MudAvatar>
                                            <div style="min-width: 0;">
                                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-truncate" Style="line-height: 1.2; max-width: 170px;">
                                                    @context.NombreEmpleado
                                                </MudText>
                                                <div class="d-flex align-center gap-1 mt-1">
                                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold px-1" Style="height: 18px; font-size: 0.7rem;">
                                                        #@context.CodigoEmpleado
                                                    </MudChip>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate" Style="max-width: 120px;">
                                                        @(string.IsNullOrWhiteSpace(context.Puesto) ? "Sin puesto" : context.Puesto)
                                                    </MudText>
                                                </div>
                                            </div>
                                        </div>
                                        <MudChip T="string" 
                                                 Color="@(context.Asistio ? Color.Success : Color.Error)" 
                                                 Variant="@(context.Asistio ? Variant.Filled : Variant.Outlined)" 
                                                 Size="Size.Small" 
                                                 Class="cursor-pointer"
                                                 OnClick="@(() => { context.Asistio = !context.Asistio; context.Modificado = true; ActualizarGruposConsolidados(); })">
                                            @(context.Asistio ? "PRESENTE" : "AUSENTE")
                                        </MudChip>
                                    </div>

                                    @if (context.Asistio)
                                    {
                                        <MudDivider Class="my-2" />
                                        <MudGrid Spacing="1">
                                            <MudItem xs="12">
                                                <MudSelect T="string" Label="Cliente" @bind-Value="@context.Cliente" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                           SelectedValuesChanged="@(() => { 
                                                               context.Modificado = true; 
                                                               var areasN = GetAreasParaCliente(context.Cliente);
                                                               if (!areasN.Contains(context.Area, StringComparer.OrdinalIgnoreCase)) context.Area = areasN.FirstOrDefault() ?? "Operaciones";
                                                               ActualizarGruposConsolidados(); 
                                                           })">
                                                    @foreach (var op in operacionesList) { <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem> }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudSelect T="string" Label="Área" Value="@context.Area" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                           ValueChanged="@((val) => { context.Area = val; context.Modificado = true; ActualizarGruposConsolidados(); })">
                                                    @{
                                                        var areasG = GetAreasParaCliente(context.Cliente);
                                                        if (!string.IsNullOrWhiteSpace(context.Area) && !areasG.Contains(context.Area, StringComparer.OrdinalIgnoreCase)) areasG = new List<string>(areasG) { context.Area };
                                                    }
                                                    @foreach (var a in areasG) { <MudSelectItem Value="@a">@a</MudSelectItem> }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudSelect T="string" Label="Puesto" @bind-Value="@context.Puesto" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                           SelectedValuesChanged="@(() => { context.Modificado = true; ActualizarGruposConsolidados(); })">
                                                    @foreach (var c in cargosDisponibles) { <MudSelectItem Value="@c">@c</MudSelectItem> }
                                                </MudSelect>
                                            </MudItem>
                                        </MudGrid>

                                        <div class="d-flex align-center justify-space-between gap-1 mt-2">
                                            <div class="d-flex align-center gap-1">
                                                <MudChip T="string" Color="@GetColorTurno(context.TurnoNombre)" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold">
                                                    @context.TurnoNombre
                                                </MudChip>
                                                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Dense="true" Size="Size.Small">
                                                    <MudMenuItem OnClick="@(() => AplicarPresetHorario(context, "06:00", "14:00"))">Diurno (06-14)</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => AplicarPresetHorario(context, "07:00", "16:00"))">Sinsa (07-16)</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => AplicarPresetHorario(context, "08:00", "17:00"))">Normal (08-17)</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => AplicarPresetHorario(context, "06:00", "15:30"))">DCC (06-15:30)</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => AplicarPresetHorario(context, "14:00", "22:00"))">Mixto (14-22)</MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => AplicarPresetHorario(context, "22:00", "06:00"))">Nocturno (22-06)</MudMenuItem>
                                                </MudMenu>
                                            </div>
                                            <div class="d-flex align-center gap-1 font-monospace" style="font-size: 0.8rem;">
                                                <input type="text" value="@context.HoraEntrada" 
                                                       @onchange="@((ChangeEventArgs e) => OnHorarioEntradaCambiado(context, e.Value?.ToString()))" 
                                                       style="width: 48px; border: 1px solid #ced4da; border-radius: 4px; padding: 2px; text-align: center;" />
                                                <span>-</span>
                                                <input type="text" value="@context.HoraSalida" 
                                                       @onchange="@((ChangeEventArgs e) => OnHorarioSalidaCambiado(context, e.Value?.ToString()))" 
                                                       style="width: 48px; border: 1px solid #ced4da; border-radius: 4px; padding: 2px; text-align: center;" />
                                            </div>
                                            <div>
                                                <select value="@context.TiempoComida" 
                                                        @onchange="@((ChangeEventArgs e) => OnTiempoComidaCambiado(context, e.Value?.ToString()))" 
                                                        class="form-select form-select-sm" 
                                                        style="width: 72px; font-size: 0.75rem; border: 1px solid #ced4da; border-radius: 4px; padding: 2px 4px; background: white;" 
                                                        title="Tiempo de comida en horas">
                                                    <option value="1.00">1.0h com</option>
                                                    <option value="0.50">0.5h com</option>
                                                    <option value="0.00">0.0h com</option>
                                                    <option value="1.50">1.5h com</option>
                                                    <option value="2.00">2.0h com</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="d-flex align-center justify-space-between mt-2 pt-2" style="border-top: 1px dashed #e2e8f0;">
                                            @{
                                                var totalV = context.VtcoTrasp + context.VtcoAlim + context.BonoBnc;
                                            }
                                            <MudButton Variant="@(totalV > 0 ? Variant.Filled : Variant.Outlined)" 
                                                       Color="@(totalV > 0 ? Color.Success : Color.Default)" 
                                                       Size="Size.Small" 
                                                       StartIcon="@Icons.Material.Filled.AttachMoney" 
                                                       OnClick="@(() => AbrirEditorViaticoIndividual(context))">
