                                           value="@context.TiempoComidaDefault" 
                                           @onchange="@(async (ChangeEventArgs e) => { context.TiempoComidaDefault = NormalizarDecimalComida(e.Value?.ToString()); await GuardarItemPlantilla(context); })" 
                                           style="width: 50px; border: 1px solid #ced4da; border-radius: 4px; padding: 1px 2px; font-size: 0.75rem; text-align: center; background: white;" 
                                           title="Tiempo de comida en horas" />
                                </MudTd>
                                <MudTd>
                                    @{
                                        var totalVComp = context.VtcoTraspDefault + context.VtcoAlimDefault + context.BonoBncDefault;
                                    }
                                    @if (totalVComp > 0)
                                    {
                                        <MudChip T="string" 
                                                 Color="Color.Info" 
                                                 Variant="Variant.Filled" 
                                                 Size="Size.Small" 
                                                 Class="cursor-pointer font-monospace fw-bold" 
                                                 Style="height: 24px; font-size: 0.75rem; white-space: nowrap;" 
                                                 OnClick="@(() => AbrirEditorViaticoPlantilla(context))"
                                                 Title="Editar viáticos base">
                                            @($"C$ {totalVComp:N0}")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Agregar viáticos base" Arrow="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.AttachMoney" 
                                                           Variant="Variant.Outlined" 
                                                           Color="Color.Default" 
                                                           Size="Size.Small" 
                                                           Style="height: 28px; width: 28px; border-radius: 6px;" 
                                                           OnClick="@(() => AbrirEditorViaticoPlantilla(context))" />
                                        </MudTooltip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@(string.IsNullOrWhiteSpace(context.TipoEmpleado) ? "Permanente" : context.TipoEmpleado)" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@(async (val) => { 
                                                   context.TipoEmpleado = val; 
                                                   await GuardarItemPlantilla(context); 
                                               })">
                                        <MudSelectItem Value="@("Permanente")">Permanente</MudSelectItem>
                                        <MudSelectItem Value="@("Temporal")">Temporal</MudSelectItem>
                                        <MudSelectItem Value="@("Prestamo")">Préstamo</MudSelectItem>
                                    </MudSelect>
                                    @if (context.TipoEmpleado == "Prestamo" && !string.IsNullOrWhiteSpace(context.ClienteOrigenNomina))
                                    {
                                        <div class="text-muted text-truncate mt-1" style="font-size: 0.7rem;" title="@($"Nómina: {context.ClienteOrigenNomina}")">
                                            Origen: @context.ClienteOrigenNomina
                                        </div>
                                    }
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex align-center gap-1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                       Color="Color.Primary" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => AbrirDialogoEditarPlantilla(context))" 
                                                       Title="Editar colaborador" />
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => EliminarItemPlantilla(context))" 
                                                       Title="Quitar de mi plantilla" />
                                    </div>
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>



            </MudTabs>
</div>

