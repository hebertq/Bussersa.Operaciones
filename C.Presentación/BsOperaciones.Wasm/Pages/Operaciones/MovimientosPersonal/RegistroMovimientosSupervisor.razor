                                    @if (context.TieneConflictoHorario)
                                    {
                                        <MudTooltip Text="@context.DetalleConflictoHorario" Arrow="true">
                                            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.ErrorOutline" Style="height: 22px; font-size: 0.68rem; font-weight: 700;">
                                                CRUCE
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    else if (context.GuardadoEnBd)
                                    {
                                        <MudTooltip Text="@($"Guardado en BD con ID #{context.Id}")" Arrow="true">
                                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" Style="height: 22px; font-size: 0.68rem; font-weight: 600;">
                                                En BD #@context.Id
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    else if (context.Id > 0 && context.Modificado)
                                    {
                                        <MudTooltip Text="@($"Registro #{context.Id} modificado (pendiente de guardar)")" Arrow="true">
                                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Style="height: 22px; font-size: 0.68rem; font-weight: 700;">
                                                Modificado
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Colaborador nuevo aún sin guardar en BD" Arrow="true">
                                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.FiberNew" Style="height: 22px; font-size: 0.68rem; font-weight: 700; border-color: #f97316; color: #ea580c;">
                                                Sin Guardar
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" 
                                             Color="@(context.Asistio ? Color.Success : Color.Error)" 
                                             Variant="@(context.Asistio ? Variant.Filled : Variant.Outlined)" 
                                             Size="Size.Small" 
                                             Class="cursor-pointer" 
                                             OnClick="@(() => ToggleAsistencia(context))">
                                        @(context.Asistio ? "PRESENTE" : "AUSENTE")
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               Value="@(string.IsNullOrWhiteSpace(context.TipoEmpleado) ? "Permanente" : context.TipoEmpleado)" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               ValueChanged="@((val) => { 
                                                   context.TipoEmpleado = val; 
                                                   context.Modificado = true; 
                                                   ActualizarGruposConsolidados(); 
                                               })">
                                        <MudSelectItem Value="@("Permanente")">Permanente</MudSelectItem>
                                        <MudSelectItem Value="@("Temporal")">Temporal</MudSelectItem>
                                        <MudSelectItem Value="@("Prestamo")">Préstamo</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               @bind-Value="@context.Cliente" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               SelectedValuesChanged="@(() => OnClienteFilaCambiado(context))">
                                        @foreach (var op in operacionesList)
                                        {
                                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    @{
                                        var areasFilaComp = GetAreasParaCliente(context.Cliente);
                                        if (!areasFilaComp.Contains(context.Area, StringComparer.OrdinalIgnoreCase))
                                        {
                                            areasFilaComp = new List<string>(areasFilaComp) { context.Area };
                                        }
                                    }
                                    <MudSelect T="string" 
                                               @bind-Value="@context.Area" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               SelectedValuesChanged="@(() => OnAreaFilaCambiado(context))">
                                        @foreach (var a in areasFilaComp)
                                        {
                                            <MudSelectItem Value="@a">@a</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" 
                                               @bind-Value="@context.Puesto" 
                                               Dense="true" 
                                               Margin="Margin.Dense" 
                                               Variant="Variant.Outlined"
                                               SelectedValuesChanged="@(() => OnAreaFilaCambiado(context))">
                                        @foreach (var c in cargosDisponibles)
                                        {
                                            <MudSelectItem Value="@c">@c</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex align-center justify-center gap-1 font-monospace" style="font-size: 0.75rem;">
                                        <input type="text" 
                                               value="@(context.Asistio ? context.HoraEntrada : "--:--")" 
                                               disabled="@(!context.Asistio)"
                                               @onchange="@((ChangeEventArgs e) => OnHorarioEntradaCambiado(context, e.Value?.ToString()))" 
                                               style="@($"width: 44px; border: 1px {(context.Asistio ? "solid #ced4da" : "dashed #cbd5e1")}; border-radius: 4px; padding: 1px 2px; font-size: 0.75rem; text-align: center; background: {(context.Asistio ? "white" : "#f8fafc")}; color: {(context.Asistio ? "inherit" : "#94a3b8")};")" 
                                               title="@(context.Asistio ? "Hora Entrada (ej. 06:00)" : "Ausente")" />
                                        <span>-</span>
                                        <input type="text" 
                                               value="@(context.Asistio ? context.HoraSalida : "--:--")" 
                                               disabled="@(!context.Asistio)"
                                               @onchange="@((ChangeEventArgs e) => OnHorarioSalidaCambiado(context, e.Value?.ToString()))" 
                                               style="@($"width: 44px; border: 1px {(context.Asistio ? "solid #ced4da" : "dashed #cbd5e1")}; border-radius: 4px; padding: 1px 2px; font-size: 0.75rem; text-align: center; background: {(context.Asistio ? "white" : "#f8fafc")}; color: {(context.Asistio ? "inherit" : "#94a3b8")};")" 
                                               title="@(context.Asistio ? "Hora Salida (ej. 14:00)" : "Ausente")" />
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <input type="number" 
                                           step="any" 
                                           min="0" 
                                           max="24" 
                                           disabled="@(!context.Asistio)"
                                           value="@(context.Asistio ? context.TiempoComida : "0")" 
                                           @onchange="@((ChangeEventArgs e) => OnTiempoComidaCambiado(context, e.Value?.ToString()))" 
                                           style="@($"width: 50px; border: 1px {(context.Asistio ? "solid #ced4da" : "dashed #cbd5e1")}; border-radius: 4px; padding: 1px 2px; font-size: 0.75rem; text-align: center; background: {(context.Asistio ? "white" : "#f8fafc")}; color: {(context.Asistio ? "inherit" : "#94a3b8")};")" 
                                           title="@(context.Asistio ? "Tiempo de comida en horas" : "Comida (0 para ausentes)")" />
                                </MudTd>
                                <MudTd>
                                    @{
                                        var totalV = context.VtcoTrasp + context.VtcoAlim + context.BonoBnc;
                                    }
                                    @if (totalV > 0)
                                    {
                                        <MudChip T="string" 
                                                 Color="Color.Info" 
                                                 Variant="Variant.Filled" 
                                                 Size="Size.Small" 
                                                 Class="cursor-pointer font-monospace fw-bold" 
                                                 Style="height: 24px; font-size: 0.75rem; white-space: nowrap;" 
                                                 OnClick="@(() => AbrirEditorViaticoIndividual(context, false))"
                                                 Title="@($"Total Viáticos & Bono: C$ {totalV:N0} (Trasp: C$ {context.VtcoTrasp:N0}, Alim: C$ {context.VtcoAlim:N0}, Bono BNC: C$ {context.BonoBnc:N0})")">
                                            @($"C$ {totalV:N0}")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Agregar viáticos / bono" Arrow="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.AttachMoney" 
                                                           Variant="Variant.Outlined" 
                                                           Color="Color.Default" 
                                                           Size="Size.Small" 
                                                           Style="height: 28px; width: 28px; border-radius: 6px;" 
                                                           OnClick="@(() => AbrirEditorViaticoIndividual(context, false))" />
                                        </MudTooltip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                   Color="Color.Error" 
                                                   Size="Size.Small" 
                                                   OnClick="@(() => EliminarEmpleadoDeJornada(context))" 
                                                   Title="Quitar de la jornada" />
                                </MudTd>
                            }
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudStack AlignItems="AlignItems.Center" Class="py-6">
                                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.body1" Class="fw-bold">No se encontraron colaboradores que coincidan con '@textoBusqueda'</MudText>
                                @if (!string.IsNullOrWhiteSpace(textoBusqueda))
                                {
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Info" 
                                               Size="Size.Small" 
                                               StartIcon="@Icons.Material.Filled.PersonAdd" 
                                               Class="mt-2" 
                                               OnClick="@(() => AbrirDialogoAgregarColaborador(textoBusqueda))">
                                        Agregar "@textoBusqueda" a la Jornada
                                    </MudButton>
                                }
                            </MudStack>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>



        @* ==========================================
           TAB 2: VIÁTICOS
           ========================================== *@
                        @* ==========================================
           TAB 2: AUSENCIAS (REPORTAR AUSENCIAS A HELPDESK TRACKER 8)
           ========================================== *@
        <MudTabPanel Text="Ausencias" ToolTip="Ausencias del Personal" Icon="@Icons.Material.Filled.PersonOff" BadgeData="@TotalAusentes" BadgeColor="Color.Error">
            <MudPaper Class="pa-3 mt-2" Elevation="0">

                @if (HayCambiosSinGuardar)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3" Elevation="1">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                            <span>
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                <b>Cambios pendientes:</b> Hay información sin guardar en Base de Datos. Debes hacer clic en <b>GUARDAR EN BD</b> antes de reportar ausencias a Helpdesk.
                            </span>
                            <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="@GuardarEnBaseDatos" Style="font-weight: 700;">
                                Guardar en BD Ahora
                            </MudButton>
                        </div>
                    </MudAlert>
                }

                @* KPIs Resumen de Ausencias *@
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="4">
                        <MudPaper Elevation="1" Class="pa-3 border-l-4 border-solid border-error d-flex align-center justify-space-between" 
                                  Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-error) !important; border-radius: 10px;">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Total Ausencias</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Error" Class="fw-bold">@TotalAusentes</MudText>
                            </div>
                            <MudAvatar Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" />
                            </MudAvatar>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudPaper Elevation="1" Class="pa-3 border-l-4 border-solid border-warning d-flex align-center justify-space-between" 
                                  Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-warning) !important; border-radius: 10px;">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Pendientes Helpdesk</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Warning" Class="fw-bold">@TotalAusenciasPendientes</MudText>
                            </div>
                            <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Small" />
                            </MudAvatar>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudPaper Elevation="1" Class="pa-3 border-l-4 border-solid border-success d-flex align-center justify-space-between" 
                                  Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-success) !important; border-radius: 10px;">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Con Ticket Helpdesk</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Success" Class="fw-bold">@TotalAusenciasSincronizadas</MudText>
                            </div>
                            <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                            </MudAvatar>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @* Barra de Filtros, Búsqueda, Acciones y Selector de Vistas Odoo *@
                <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                    @* Izquierda: Buscador *@
                    <div class="d-flex align-center gap-2 flex-grow-1" style="max-width: 460px; min-width: 250px;">
                        <MudTextField @bind-Value="textoBusquedaAusencias" 
                                      Placeholder="Buscar ausente por nombre, carnet (#) o cliente..." 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Immediate="true" 
                                      Clearable="true" 
                                      Class="flex-grow-1" />
                    </div>

                    @* Derecha: Botón Envío Helpdesk + Selector de Vistas Odoo *@
                    <div class="d-flex align-center flex-wrap gap-2">
                        @if (TotalAusentes > 0)
                        {
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default">
                                <MudButton OnClick="@(() => MarcarTodosAusentes(true))" Size="Size.Small">Todos</MudButton>
                                <MudButton OnClick="@(() => MarcarTodosAusentes(false))" Size="Size.Small">Ninguno</MudButton>
                            </MudButtonGroup>

                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Error" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.Send" 
                                       Disabled="@(estaEnviandoAusencias || TotalAusentes == 0 || HayCambiosSinGuardar)"
                                       OnClick="@(() => EnviarAusenciasAHelpdeskMasivo(CantidadAusentesSeleccionados > 0))"
                                       Title="@(HayCambiosSinGuardar ? "Debe guardar la jornada en Base de Datos (clic en GUARDAR EN BD) antes de reportar ausencias a Helpdesk" : "Reportar ausencias a RRHH Helpdesk")"
                                       Style="font-weight: 700; text-transform: none; border-radius: 8px; box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);">
                                @if (estaEnviandoAusencias)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Solicitando en Helpdesk...</span>
                                }
                                else
                                {
                                    <span>@(CantidadAusentesSeleccionados > 0 ? $"Solicitar Seleccionados ({CantidadAusentesSeleccionados}) en Helpdesk" : $"Solicitar Todas las Ausencias ({TotalAusentes}) en Helpdesk")</span>
                                }
                            </MudButton>
                        }

                        @* Selector de 2 Vistas (Tarjetas y Operativa) *@
                        <div class="odoo-view-switcher">
                            <button type="button" 
                                    class="switcher-btn @(modoVistaAusencias == ModoVistaGrilla.Tarjetas ? "active" : "")" 
                                    @onclick="@(() => modoVistaAusencias = ModoVistaGrilla.Tarjetas)" 
                                    title="Vista Tarjetas (Predefinida)">
                                <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                            </button>
                            <button type="button" 
                                    class="switcher-btn @(modoVistaAusencias == ModoVistaGrilla.Operativo ? "active" : "")" 
                                    @onclick="@(() => modoVistaAusencias = ModoVistaGrilla.Operativo)" 
                                    title="Vista Operativa">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                            </button>
                        </div>
                    </div>
                </div>

                @* ESTADO VACÍO *@
                @if (!AusentesFiltrados.Any())
                {
                    <MudPaper Elevation="0" Class="pa-8 my-4 text-center d-flex flex-column align-center justify-center" 
                              Style="background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 12px; min-height: 240px;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" Color="Color.Success" Class="mb-3" Style="font-size: 3.5rem;" />
                        <MudText Typo="Typo.h6" Class="fw-bold text-dark mb-1">
                            @(TotalAusentes == 0 ? "¡No hay ausencias registradas para esta jornada!" : "No se encontraron colaboradores ausentes con el filtro aplicado")
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3" Style="max-width: 520px;">
                            @(TotalAusentes == 0 ? "Todos los colaboradores están marcados como presentes. Si algún colaborador no asistió, márquelo como ausente en la pestaña Asistencias para configurar y generar su solicitud a Helpdesk." : $"Pruebe borrando el texto de búsqueda '{textoBusquedaAusencias}'.")
                        </MudText>
                        @if (TotalAusentes == 0)
                        {
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.TableChart" 
                                       OnClick="@(() => activeTabIndex = 0)">
                                Ir a la pestaña de Asistencias
                            </MudButton>
                        }
                    </MudPaper>
                }
                else
                {
                    @* 4 VISUALIZACIONES OPTIMIZADAS *@
                    @if (modoVistaAusencias == ModoVistaGrilla.Tarjetas)
                    {
                        @* VISTA TARJETAS (KANBAN) - PREDEFINIDA *@
                        <MudGrid Spacing="2">
                            @foreach (var emp in AusentesFiltrados)
                            {
                                <MudItem xs="12" sm="6" lg="4">
                                    <MudCard Elevation="2" Class="pa-3 rounded-xl border border-solid transition-all" 
                                             Style="@(emp.SincronizadoAusencia 
                                                ? "border-color: #10b981; border-left: 6px solid #10b981; background: #ffffff;" 
                                                : "border-color: #fca5a5; border-left: 6px solid #ef4444; background: #ffffff;")">
                                        
                                        @* Header de la Tarjeta *@
                                        <div class="d-flex align-center justify-space-between mb-2">
                                            <div class="d-flex align-center gap-1">
                                                <MudCheckBox @bind-Value="@emp.Seleccionado" Color="Color.Error" Dense="true" />
                                                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold px-2" Style="height: 22px; font-size: 0.75rem;">
                                                    #@emp.CodigoEmpleado
                                                </MudChip>
                                                @if (emp.SincronizadoAusencia)
                                                {
                                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold px-2" Style="height: 22px; font-size: 0.72rem;">
                                                        TICKET #@emp.TicketAusenciaId
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold px-2" Style="height: 22px; font-size: 0.72rem;">
                                                        AUSENTE
                                                    </MudChip>
                                                }
                                            </div>
                                            <MudTooltip Text="Revertir: Marcar como Presente" Arrow="true">
                                                <MudIconButton Icon="@Icons.Material.Filled.Undo" 
                                                               Color="Color.Success" 
                                                               Size="Size.Small" 
                                                               OnClick="@(() => MarcarComoPresente(emp))" />
                                            </MudTooltip>
                                        </div>

                                        @* Nombre y Subtítulo *@
                                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-dark mb-0 text-truncate" Title="@emp.NombreEmpleado" Style="font-size: 0.95rem;">
                                            @emp.NombreEmpleado
                                        </MudText>
                                        <div class="d-flex align-center gap-1 text-secondary mb-3" style="font-size: 0.8rem;">
                                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" Style="font-size: 0.85rem;" />
                                            <span class="fw-bold text-dark">@emp.Cliente</span>
                                            <span>• @emp.Puesto</span>
                                        </div>

                                        <MudDivider Class="mb-3" />

                                        @* Tipo de Ausencia Odoo *@
                                        <div class="mb-2">
                                            <label class="text-caption fw-bold text-secondary d-block mb-1">Tipo de Permiso / Ausencia (Odoo):</label>
                                            <MudSelect T="string" 
                                                       Value="@emp.TipoAusencia" 
                                                       ValueChanged="@((string v) => { emp.TipoAusencia = v; emp.Modificado = true; })" 
                                                       Dense="true" 
                                                       Margin="Margin.Dense" 
                                                       Variant="Variant.Outlined"
                                                       Class="bg-white">
                                                @foreach (var t in tiposAusenciaOdoo)
                                                {
                                                    <MudSelectItem Value="@t.nombre">@t.nombre</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>

                                        @if (emp.TipoAusencia == "Vacaciones")
                                        {
                                            <div class="mb-2">
                                                <label class="text-caption fw-bold text-secondary d-block mb-1">Modalidad de Vacaciones:</label>
                                                <MudSelect T="string" 
                                                           Value="@emp.VacacionesTipo" 
                                                           ValueChanged="@((string v) => { emp.VacacionesTipo = v; emp.Modificado = true; })" 
                                                           Dense="true" 
                                                           Margin="Margin.Dense" 
                                                           Variant="Variant.Outlined"
                                                           Class="bg-white">
                                                    <MudSelectItem Value="@("Descansadas")">Descansadas</MudSelectItem>
                                                    <MudSelectItem Value="@("Pagadas")">Pagadas</MudSelectItem>
                                                </MudSelect>
                                            </div>
                                        }

                                        @* Rango de Fechas & Días *@
                                        <div class="d-flex align-center gap-2 mb-2">
                                            <div class="flex-grow-1">
                                                <MudDatePicker Label="Inicio" 
                                                               Date="@(emp.FechaInicioAusencia ?? fechaSeleccionada ?? DateTime.Today)" 
                                                               DateChanged="@((DateTime? d) => OnFechaInicioAusenciaChanged(emp, d))" 
                                                               DateFormat="dd/MM/yyyy" 
                                                               Margin="Margin.Dense" 
                                                               Variant="Variant.Outlined" 
                                                               PopoverClass="mud-picker-popover-wide"
                                                               Class="bg-white" />
                                            </div>
                                            <div class="flex-grow-1">
                                                <MudDatePicker Label="Fin" 
                                                               Date="@(emp.FechaFinAusencia ?? emp.FechaInicioAusencia ?? fechaSeleccionada ?? DateTime.Today)" 
                                                               DateChanged="@((DateTime? d) => OnFechaFinAusenciaChanged(emp, d))" 
                                                               DateFormat="dd/MM/yyyy" 
                                                               Margin="Margin.Dense" 
                                                               Variant="Variant.Outlined" 
                                                               PopoverClass="mud-picker-popover-wide"
                                                               Class="bg-white" />
                                            </div>
                                            <div style="width: 72px;">
                                                <MudNumericField T="decimal" 
                                                                 Label="Días" 
                                                                 @bind-Value="@emp.DiasAusencia" 
                                                                 Min="1m" 
                                                                 Step="1m" 
                                                                 Margin="Margin.Dense" 
                                                                 Variant="Variant.Outlined" 
                                                                 Class="bg-white"
                                                                 Style="text-align: center;" />
                                            </div>
                                        </div>

                                        @* Motivo / Observaciones *@
                                        <div class="mb-2">
                                            <MudTextField @bind-Value="@emp.ObservacionesAusencia" 
                                                          Placeholder="Motivo u observaciones (opcional)..." 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Dense" 
                                                          Class="bg-white"
                                                          Lines="1" />
                                        </div>

                                        @* Footer de la Tarjeta *@
                                        <div class="d-flex align-center justify-space-between pt-2 border-t mt-2">
                                            @if (emp.SincronizadoAusencia)
                                            {
                                                <a href="@($"https://helpdesk.bussersa.com/issues/{emp.TicketAusenciaId}")" 
                                                   target="_blank" 
                                                   class="d-flex align-center gap-1 text-success text-decoration-none fw-bold" 
                                                   style="font-size: 0.82rem;">
                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                                    Ver Ticket #@emp.TicketAusenciaId en Helpdesk ↗
                                                </a>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Class="font-monospace fw-bold" Style="height: 22px; font-size: 0.72rem;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" Style="font-size: 0.85rem;" />
                                                    Pendiente
                                                </MudChip>
                                            }
                                        </div>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        @* VISTAS DE TABLA: OPERATIVO, UBICACIÓN O COMPLETO (COMPACTAS Y ADAPTADAS PARA TABLET) *@
                        <div class="overflow-x-auto rounded-lg border">
                            <MudTable Items="@AusentesFiltrados" 
                                      Dense="true" 
                                      Hover="true" 
                                      Bordered="true" 
                                      Striped="true" 
                                      Elevation="0" 
                                      Class="odoo-table"
                                      Style="min-width: 980px;">
                                <HeaderContent>
                                    <MudTh Style="width: 40px; text-align: center;"><MudCheckBox T="bool" Value="@(AusentesFiltrados.Any() && AusentesFiltrados.All(x => x.Seleccionado))" ValueChanged="@((bool v) => MarcarTodosAusentes(v))" Color="Color.Error" Dense="true" /></MudTh>
                                    <MudTh Style="width: 220px;">Colaborador</MudTh>
                                    @if (modoVistaAusencias == ModoVistaGrilla.Ubicacion || modoVistaAusencias == ModoVistaGrilla.Completo)
                                    {
                                        <MudTh Style="width: 140px;">Área</MudTh>
                                    }
                                    <MudTh Style="width: 170px;">Tipo de Ausencia (Odoo)</MudTh>
                                    @if (modoVistaAusencias == ModoVistaGrilla.Completo)
                                    {
                                        <MudTh Style="width: 120px;">Modalidad</MudTh>
                                    }
                                    <MudTh Style="width: 320px;">Período (Inicio - Fin)</MudTh>
                                    <MudTh Style="width: 60px; text-align: center;">Días</MudTh>
                                    <MudTh Style="min-width: 150px;">Motivo / Observaciones</MudTh>
                                    <MudTh Style="width: 130px; text-align: center;">Helpdesk</MudTh>
                                    <MudTh Style="width: 50px; text-align: center;">Acción</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Style="text-align: center;">
                                        <MudCheckBox @bind-Value="@context.Seleccionado" Color="Color.Error" Dense="true" />
                                    </MudTd>
                                    <MudTd>
                                        <div class="d-flex align-center gap-1 mb-1">
                                            <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold px-1" Style="height: 18px; font-size: 0.7rem;">
                                                #@context.CodigoEmpleado
                                            </MudChip>
                                            <MudText Typo="Typo.body2" Class="fw-bold text-dark text-truncate" Style="max-width: 160px;" Title="@context.NombreEmpleado">
                                                @context.NombreEmpleado
                                            </MudText>
                                        </div>
                                        <div class="text-secondary" style="font-size: 0.72rem; line-height: 1.1;">
                                            <b>@context.Cliente</b> • @context.Puesto
                                        </div>
                                    </MudTd>
                                    @if (modoVistaAusencias == ModoVistaGrilla.Ubicacion || modoVistaAusencias == ModoVistaGrilla.Completo)
                                    {
                                        <MudTd>
                                            <MudText Typo="Typo.caption" Class="fw-bold">@context.Area</MudText>
                                        </MudTd>
                                    }
                                    <MudTd>
                                        <MudSelect T="string" 
                                                   Value="@context.TipoAusencia" 
                                                   ValueChanged="@((string v) => { context.TipoAusencia = v; context.Modificado = true; })" 
                                                   Dense="true" 
                                                   Margin="Margin.Dense" 
                                                   Variant="Variant.Outlined"
                                                   Class="bg-white"
                                                   Style="font-size: 0.8rem;">
                                            @foreach (var t in tiposAusenciaOdoo)
                                            {
                                                <MudSelectItem Value="@t.nombre">@t.nombre</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudTd>
                                    @if (modoVistaAusencias == ModoVistaGrilla.Completo)
                                    {
                                        <MudTd>
                                            @if (context.TipoAusencia == "Vacaciones")
                                            {
                                                <MudSelect T="string" 
                                                           Value="@context.VacacionesTipo" 
                                                           ValueChanged="@((string v) => { context.VacacionesTipo = v; context.Modificado = true; })" 
                                                           Dense="true" 
                                                           Margin="Margin.Dense" 
                                                           Variant="Variant.Outlined"
                                                           Class="bg-white">
                                                    <MudSelectItem Value="@("Descansadas")">Descansadas</MudSelectItem>
                                                    <MudSelectItem Value="@("Pagadas")">Pagadas</MudSelectItem>
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                            }
                                        </MudTd>
                                    }
                                    <MudTd Style="min-width: 320px; width: 320px;">
                                        <div class="d-flex align-center gap-2">
                                            <div style="width: 145px; min-width: 140px;">
                                                <MudDatePicker Label="Inicio" 
                                                               Date="@(context.FechaInicioAusencia ?? fechaSeleccionada ?? DateTime.Today)" 
                                                               DateChanged="@((DateTime? d) => OnFechaInicioAusenciaChanged(context, d))" 
                                                               DateFormat="dd/MM/yyyy" 
                                                               Margin="Margin.Dense" 
                                                               Variant="Variant.Outlined" 
                                                               PopoverClass="mud-picker-popover-wide"
                                                               Class="bg-white" />
                                            </div>
                                            <div style="width: 145px; min-width: 140px;">
                                                <MudDatePicker Label="Fin" 
                                                               Date="@(context.FechaFinAusencia ?? context.FechaInicioAusencia ?? fechaSeleccionada ?? DateTime.Today)" 
                                                               DateChanged="@((DateTime? d) => OnFechaFinAusenciaChanged(context, d))" 
                                                               DateFormat="dd/MM/yyyy" 
                                                               Margin="Margin.Dense" 
                                                               Variant="Variant.Outlined" 
                                                               PopoverClass="mud-picker-popover-wide"
                                                               Class="bg-white" />
                                            </div>
                                        </div>
                                    </MudTd>
                                    <MudTd Style="text-align: center;">
                                        <MudNumericField T="decimal" 
                                                         @bind-Value="@context.DiasAusencia" 
                                                         Min="1m" 
                                                         Step="1m" 
                                                         Margin="Margin.Dense" 
                                                         Variant="Variant.Outlined" 
                                                         Class="bg-white"
                                                         Style="width: 50px; text-align: center; font-size: 0.8rem;" />
                                    </MudTd>
                                    <MudTd>
                                        <MudTextField @bind-Value="@context.ObservacionesAusencia" 
                                                      Placeholder="Motivo..." 
                                                      Variant="Variant.Outlined" 
                                                      Margin="Margin.Dense" 
                                                      Class="bg-white"
                                                      Style="font-size: 0.8rem;" />
                                    </MudTd>
                                    <MudTd Style="text-align: center;">
                                        @if (context.SincronizadoAusencia)
                                        {
                                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold"
                                                     Href="@($"https://helpdesk.bussersa.com/issues/{context.TicketAusenciaId}")" Target="_blank"
                                                     Title="Ver solicitud de ausencia en Helpdesk">
                                                #@context.TicketAusenciaId
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Class="font-monospace fw-bold" Style="height: 22px; font-size: 0.75rem;">
                                                Pendiente
                                            </MudChip>
                                        }
                                    </MudTd>
                                    <MudTd Style="text-align: center;">
                                        <MudTooltip Text="Marcar PRESENTE (Revertir)" Arrow="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.Undo" 
                                                           Color="Color.Success" 
                                                           Size="Size.Small" 
                                                           OnClick="@(() => MarcarComoPresente(context))" />
                                        </MudTooltip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }
            </MudPaper>
        </MudTabPanel>


        <MudTabPanel Text="Viáticos" ToolTip="Viáticos (Operaciones - Tracker 27)" Icon="@Icons.Material.Filled.AttachMoney" BadgeData="@TotalConViaticosTransporteAlim" BadgeColor="Color.Warning">
            <MudPaper Class="pa-3 mt-2" Elevation="0">

                @if (HayCambiosSinGuardar)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3" Elevation="1">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                            <span>
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                <b>Cambios pendientes:</b> Hay información sin guardar en Base de Datos. Debes hacer clic en <b>GUARDAR EN BD</b> antes de enviar viáticos a Helpdesk.
                            </span>
                            <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="@GuardarEnBaseDatos" Style="font-weight: 700;">
                                Guardar en BD Ahora
                            </MudButton>
                        </div>
                    </MudAlert>
                }

                @* Cards de Resumen de Viáticos *@
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-success" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-success) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Total Viáticos</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Success" Class="fw-bold">C$ @((TotalViaticosTrasp + TotalViaticosAlim).ToString("N2"))</MudText>
                                </div>
                                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-info" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-info) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Transporte</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Info" Class="fw-bold">C$ @TotalViaticosTrasp.ToString("N2")</MudText>
                                </div>
                                <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-warning" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-warning) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Alimentación</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Warning" Class="fw-bold">C$ @TotalViaticosAlim.ToString("N2")</MudText>
                                </div>
                                <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-primary" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-primary) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Recursos con Viáticos</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">@TotalConViaticosTransporteAlim personas</MudText>
                                </div>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                @* Filtros de Viáticos y Acciones *@
                <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="textoBusquedaViaticos" 
                                      Placeholder="Buscar por nombre, carnet (#) o área..." 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Immediate="true" 
                                      Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                            @* Selector de vista: Solicitudes (Grupos con Recursos) vs Por Colaborador *@
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
                                <MudButton Variant="@(modoVistaViaticos == "GRUPOS" ? Variant.Filled : Variant.Outlined)"
                                           StartIcon="@Icons.Material.Filled.GroupWork"
                                           OnClick="@(() => modoVistaViaticos = "GRUPOS")">
                                    Solicitudes (@GruposViaticos.Count)
                                </MudButton>
                                <MudButton Variant="@(modoVistaViaticos == "COLABORADORES" ? Variant.Filled : Variant.Outlined)"
                                           StartIcon="@Icons.Material.Filled.Person"
                                           OnClick="@(() => modoVistaViaticos = "COLABORADORES")">
                                    Colaboradores (@TotalPresentes)
                                </MudButton>
                            </MudButtonGroup>

                            @* Selector de 2 Formatos: Tarjetas vs Tabla *@
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary">
                                <MudButton Variant="@(modoVistaViaticosFormato == ModoVistaGrilla.Tarjetas ? Variant.Filled : Variant.Outlined)"
                                           StartIcon="@Icons.Material.Filled.GridView"
                                           OnClick="@(() => modoVistaViaticosFormato = ModoVistaGrilla.Tarjetas)"
                                           Title="Vista de Tarjetas">
                                    Tarjetas
                                </MudButton>
                                <MudButton Variant="@(modoVistaViaticosFormato == ModoVistaGrilla.Operativo ? Variant.Filled : Variant.Outlined)"
                                           StartIcon="@Icons.Material.Filled.TableChart"
                                           OnClick="@(() => modoVistaViaticosFormato = ModoVistaGrilla.Operativo)"
                                           Title="Vista de Tabla">
                                    Tabla
                                </MudButton>
                            </MudButtonGroup>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        @if (modoVistaViaticos == "COLABORADORES")
                        {
                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                <MudChip T="string" Color="@(filtroViaticos == "CON_VIATICOS" ? Color.Warning : Color.Default)"
                                         Variant="@(filtroViaticos == "CON_VIATICOS" ? Variant.Filled : Variant.Outlined)"
                                         Size="Size.Small"
                                         Class="fw-bold"
                                         OnClick="@(() => filtroViaticos = "CON_VIATICOS")">
                                    Con Viáticos (@TotalConViaticosTransporteAlim)
                                </MudChip>
                                <MudChip T="string" Color="@(filtroViaticos == "TODOS" ? Color.Primary : Color.Default)"
                                         Variant="@(filtroViaticos == "TODOS" ? Variant.Filled : Variant.Outlined)"
                                         Size="Size.Small"
                                         OnClick="@(() => filtroViaticos = "TODOS")">
                                    Todos (@TotalPresentes)
                                </MudChip>
                                <MudChip T="string" Color="@(filtroViaticos == "SIN_VIATICOS" ? Color.Dark : Color.Default)"
                                         Variant="@(filtroViaticos == "SIN_VIATICOS" ? Variant.Filled : Variant.Outlined)"
                                         Size="Size.Small"
                                         OnClick="@(() => filtroViaticos = "SIN_VIATICOS")">
                                    Sin Viáticos (@TotalSinViaticos)
                                </MudChip>
                            </MudStack>
                        }
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="flex-wrap">
                            @if (CantidadSeleccionados > 0 && modoVistaViaticos == "COLABORADORES")
                            {
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Bolt"
                                           OnClick="AsignarViaticosMasivosASeleccionados">
                                    Asignar (@CantidadSeleccionados)
                                </MudButton>
                            }
                            @if (TotalConViaticosTransporteAlim > 0)
                            {
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.ClearAll"
                                           OnClick="LimpiarTodosLosViaticos">
                                    Limpiar Viáticos
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.Payments"
                                       Disabled="@(estaEnviandoViaticos || TotalGruposViaticosPendientes == 0 || HayCambiosSinGuardar)"
                                       OnClick="@EnviarViaticosMasivo"
                                       Style="background: linear-gradient(135deg, #1e3a8a, #2563eb); color: white; font-weight: 700; white-space: nowrap;"
                                       Title="@(HayCambiosSinGuardar ? "Debe guardar los viáticos en Base de Datos (clic en GUARDAR EN BD) antes de enviar a Operaciones" : (TotalGruposViaticosPendientes == 0 ? "Todas las solicitudes de viáticos ya fueron enviadas a Helpdesk" : "Generar solicitudes de Viáticos (Tracker 27) en Operaciones Helpdesk"))">
                                @(estaEnviandoViaticos ? "Enviando a Operaciones..." : (TotalGruposViaticosPendientes == 0 ? "Viáticos Sincronizados" : $"Enviar Viáticos ({TotalGruposViaticosPendientes})"))
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>

                @* VISTA 1: SOLICITUDES DE VIÁTICOS (GRUPOS CON COLUMNA DE RECURSOS) *@
                @if (modoVistaViaticos == "GRUPOS")
                {
                    @if (!GruposViaticos.Any())
                    {
                        <MudPaper Elevation="0" Class="pa-6 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.MoneyOff" Size="Size.Large" Color="Color.Secondary" Class="mb-1" />
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">No hay solicitudes de viáticos configuradas</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                                Para asignar viáticos de transporte y alimentación a su personal presente, cambie a la vista de "Colaboradores" o asígnelos desde Asistencias.
                            </MudText>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.People"
                                       OnClick="@(() => modoVistaViaticos = "COLABORADORES")">
                                Ver Colaboradores para Asignar Viáticos (@TotalPresentes)
                            </MudButton>
                        </MudPaper>
                    }
                    else if (modoVistaViaticosFormato == ModoVistaGrilla.Tarjetas)
                    {
                        @* 1.A: MODO TARJETAS DE SOLICITUDES *@
                        <MudGrid Spacing="2">
                            @foreach (var grupo in GruposViaticos)
                            {
                                <MudItem xs="12" md="6" lg="4">
                                    <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between" 
                                             Style="@(grupo.Sincronizado ? "border-left: 5px solid #10b981; background: #fff;" : "border-left: 5px solid #f59e0b; background: #fff;")">
                                        <MudCardHeader Class="pb-2 pt-3 px-3">
                                            <CardHeaderContent>
                                                <div class="d-flex align-center justify-space-between">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-monospace fw-bold">
                                                            #@grupo.Index
                                                        </MudChip>
                                                        <div>
                                                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-primary">@grupo.Cliente</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold">@grupo.Area</MudText>
                                                        </div>
                                                    </div>
                                                    @if (grupo.Sincronizado)
                                                    {
                                                        <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{grupo.TicketViaticoId}")" Target="_blank" Underline="Underline.Always">
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Payments" Class="fw-bold">
                                                                Viat #@grupo.TicketViaticoId
                                                            </MudChip>
                                                        </MudLink>
                                                    }
                                                    else
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="fw-bold">
                                                            Pendiente
                                                        </MudChip>
                                                    }
                                                </div>
                                            </CardHeaderContent>
                                        </MudCardHeader>

                                        <MudCardContent Class="py-2 px-3">
                                            @* Puesto y Horario *@
                                            <div class="mb-2">
                                                <MudText Typo="Typo.body2" Class="fw-bold">@grupo.Puesto</MudText>
                                                <div class="d-flex align-center gap-1 font-monospace text-secondary" style="font-size: 0.78rem;">
                                                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Style="font-size: 0.9rem;" />
                                                    <span>@grupo.HoraInicio - @grupo.HoraFin (@grupo.TurnoNombre)</span>
                                                </div>
                                            </div>

                                            @* Cuadro Destacado: Recursos y Montos *@
                                            <MudPaper Elevation="0" Class="pa-2 my-2 rounded" Style="background: #f1f5f9; border: 1px solid #e2e8f0;">
                                                <div class="d-flex justify-space-between align-center mb-1">
                                                    <span style="font-size: 0.78rem; font-weight: 600; color: #475569;">RECURSOS:</span>
                                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold" Style="height: 22px; font-size: 0.78rem;">
                                                        @grupo.Recursos recurso(s)
                                                    </MudChip>
                                                </div>
                                                <div class="d-flex justify-space-between text-secondary" style="font-size: 0.78rem;">
                                                    <span>Trasp: C$ @grupo.VtcoTrasp.ToString("N2")</span>
                                                    <span>Alim: C$ @grupo.VtcoAlim.ToString("N2")</span>
                                                </div>
                                                <MudDivider Class="my-1" />
                                                <div class="d-flex justify-space-between align-center">
                                                    <span style="font-size: 0.82rem; font-weight: 700; color: #1e293b;">TOTAL VIÁTICO:</span>
                                                    <span class="font-monospace fw-bold" style="font-size: 0.95rem; color: #059669;">
                                                        C$ @grupo.TotalGrupo.ToString("N2")
                                                    </span>
                                                </div>
                                                <div class="text-right text-muted" style="font-size: 0.68rem;">
                                                    (@grupo.Recursos × C$ @grupo.TotalPorPersona.ToString("N2"))
                                                </div>
                                            </MudPaper>

                                            @* Colaboradores asignados (Chips) *@
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold mb-1 d-block">Colaboradores:</MudText>
                                                <div class="d-flex flex-wrap gap-1" style="max-height: 80px; overflow-y: auto;">
                                                    @foreach (var emp in grupo.Empleados)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined" Class="font-monospace fw-bold px-1" Style="height: 20px; font-size: 0.70rem;" Title="@emp.NombreEmpleado">
                                                            #@emp.CodigoEmpleado @emp.NombreEmpleado
                                                        </MudChip>
                                                    }
                                                </div>
                                            </div>
                                        </MudCardContent>

                                        <MudCardActions Class="px-3 pb-2 pt-0 d-flex justify-space-between align-center">
                                            <MudButton Variant="Variant.Outlined" 
                                                       Color="Color.Primary" 
                                                       Size="Size.Small" 
                                                       StartIcon="@Icons.Material.Filled.Edit" 
                                                       OnClick="@(() => AbrirEditorViaticoGrupo(grupo))"
                                                       Style="font-size: 0.75rem;">
                                                Editar Viáticos
                                            </MudButton>
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudTable Items="@GruposViaticos" 
                                  Dense="true" 
                                  Hover="true" 
                                  Striped="true" 
                                  Elevation="1" 
                                  Class="rounded-lg"
                                  Breakpoint="Breakpoint.None">
                            <HeaderContent>
                                <MudTh Style="width: 50px;">#</MudTh>
                                <MudTh>Cliente & Área Operativa</MudTh>
                                <MudTh Style="width: 160px;">Cargo / Puesto</MudTh>
                                <MudTh Style="width: 140px;">Horario / Turno</MudTh>
                                <MudTh Style="width: 110px; text-align: center;">Recursos</MudTh>
                                <MudTh Style="width: 120px;" Class="text-right">Trasp (C$)</MudTh>
                                <MudTh Style="width: 120px;" Class="text-right">Alim (C$)</MudTh>
                                <MudTh Style="width: 140px;" Class="text-right">Total Viático (C$)</MudTh>
                                <MudTh Style="min-width: 180px;">Colaboradores Asignados</MudTh>
                                <MudTh Style="width: 130px;" Class="text-center">Ticket Viáticos</MudTh>
                                <MudTh Style="width: 60px;"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-monospace fw-bold">
                                        #@context.Index
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-column">
                                        <b class="text-primary">@context.Cliente</b>
                                        <span class="fw-bold" style="font-size: 0.82rem;">@context.Area</span>
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.caption" Class="fw-bold">@context.Puesto</MudText>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-column font-monospace" style="font-size: 0.78rem;">
                                        <span>@context.HoraInicio - @context.HoraFin</span>
                                        <span class="text-secondary" style="font-size: 0.70rem;">@context.TurnoNombre</span>
                                    </div>
                                </MudTd>
                                <MudTd Style="text-align: center;">
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold" Style="height: 22px; font-size: 0.75rem;">
                                        @context.Recursos recurso(s)
                                    </MudChip>
                                </MudTd>
                                <MudTd Class="text-right">
                                    <MudText Typo="Typo.body2" Class="font-monospace">
                                        C$ @context.VtcoTrasp.ToString("N2")
                                    </MudText>
                                </MudTd>
                                <MudTd Class="text-right">
                                    <MudText Typo="Typo.body2" Class="font-monospace">
                                        C$ @context.VtcoAlim.ToString("N2")
                                    </MudText>
                                </MudTd>
                                <MudTd Class="text-right">
                                    <MudText Typo="Typo.body2" Class="fw-bold font-monospace" Color="Color.Success">
                                        C$ @context.TotalGrupo.ToString("N2")
                                    </MudText>
                                    <span class="text-muted d-block" style="font-size: 0.68rem;">(@context.Recursos × C$ @context.TotalPorPersona.ToString("N2"))</span>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 250px;">
                                        @foreach (var emp in context.Empleados)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined" Class="font-monospace fw-bold px-1" Style="height: 18px; font-size: 0.68rem;" Title="@emp.NombreEmpleado">
                                                #@emp.CodigoEmpleado
                                            </MudChip>
                                        }
                                    </div>
                                </MudTd>
                                <MudTd Class="text-center">
                                    @if (context.Sincronizado)
                                    {
                                        <MudLink Href="@($"https://helpdesk.bussersa.com/issues/{context.TicketViaticoId}")" Target="_blank" Underline="Underline.Always">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Payments">
                                                Viat #@context.TicketViaticoId
                                            </MudChip>
                                        </MudLink>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                            Pendiente
                                        </MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                   Size="Size.Small" 
                                                   Color="Color.Primary" 
                                                   OnClick="@(() => AbrirEditorViaticoGrupo(context))" 
                                                   Title="Editar viáticos del grupo" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                }
                else
                {
                    @* VISTA 2: ASIGNACIÓN DETALLADA POR COLABORADOR (SIN BNC) *@
                    @if (!EmpleadosViaticosFiltrados.Any())
                    {
                        <MudPaper Elevation="0" Class="pa-6 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.MoneyOff" Size="Size.Large" Color="Color.Secondary" Class="mb-1" />
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">No se encontraron colaboradores con el filtro seleccionado</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Solo se muestran colaboradores marcados como PRESENTE en la jornada diaria.
                            </MudText>
                        </MudPaper>
                    }
                    else if (modoVistaViaticosFormato == ModoVistaGrilla.Tarjetas)
                    {
                        @* 2.A: MODO TARJETAS POR COLABORADOR *@
                        <MudGrid Spacing="2">
                            @foreach (var emp in EmpleadosViaticosFiltrados)
                            {
                                <MudItem xs="12" sm="6" md="4" lg="3">
                                    <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between"
                                             Style="@((emp.VtcoTrasp > 0 || emp.VtcoAlim > 0) ? "border-left: 5px solid #10b981; background: #fff;" : "border-left: 5px solid #cbd5e1; background: #fff;")">
                                        <MudCardHeader Class="pb-1 pt-3 px-3">
                                            <CardHeaderContent>
                                                <div class="d-flex align-center justify-space-between">
                                                    <div class="d-flex align-center gap-1">
                                                        <MudCheckBox @bind-Value="@emp.Seleccionado" Color="Color.Primary" Dense="true" Class="pa-0 ma-0" />
                                                        <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem;">
                                                            #@emp.CodigoEmpleado
                                                        </MudChip>
                                                    </div>
                                                    @{
                                                        var tot = emp.VtcoTrasp + emp.VtcoAlim;
                                                    }
                                                    <MudChip T="string" Color="@(tot > 0 ? Color.Success : Color.Default)" Variant="Variant.Filled" Size="Size.Small" Class="font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem;">
                                                        C$ @tot.ToString("N2")
                                                    </MudChip>
                                                </div>
                                            </CardHeaderContent>
                                        </MudCardHeader>

                                        <MudCardContent Class="py-2 px-3">
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" Title="@emp.NombreEmpleado">
                                                @emp.NombreEmpleado
                                            </MudText>
                                            <div class="mb-2">
                                                <MudText Typo="Typo.caption" Class="fw-bold d-block">@emp.Area</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@emp.Cliente</MudText>
                                            </div>

                                            <div class="d-flex gap-2">
                                                <div class="flex-grow-1">
                                                    <MudNumericField T="decimal" 
                                                                     Label="Trasp"
                                                                     Value="@emp.VtcoTrasp" 
                                                                     Variant="Variant.Outlined" 
                                                                     Margin="Margin.Dense" 
                                                                     Min="0" 
                                                                     HideSpinButtons="true" 
                                                                     Format="N2" 
                                                                     Adornment="Adornment.Start" 
                                                                     AdornmentText="C$" 
                                                                     Style="font-size: 0.82rem; text-align: right;" 
                                                                     ValueChanged="@((val) => { emp.VtcoTrasp = val; emp.Modificado = true; ActualizarGruposConsolidados(); })" />
                                                </div>
                                                <div class="flex-grow-1">
                                                    <MudNumericField T="decimal" 
                                                                     Label="Alim"
                                                                     Value="@emp.VtcoAlim" 
                                                                     Variant="Variant.Outlined" 
                                                                     Margin="Margin.Dense" 
                                                                     Min="0" 
                                                                     HideSpinButtons="true" 
                                                                     Format="N2" 
                                                                     Adornment="Adornment.Start" 
                                                                     AdornmentText="C$" 
                                                                     Style="font-size: 0.82rem; text-align: right;" 
                                                                     ValueChanged="@((val) => { emp.VtcoAlim = val; emp.Modificado = true; ActualizarGruposConsolidados(); })" />
                                                </div>
                                            </div>
                                        </MudCardContent>

                                        <MudCardActions Class="px-3 pb-2 pt-0 d-flex justify-space-between align-center">
                                            <MudButton Variant="Variant.Text" 
                                                       Color="Color.Primary" 
                                                       Size="Size.Small" 
                                                       StartIcon="@Icons.Material.Filled.Edit" 
                                                       OnClick="@(() => AbrirEditorViaticoIndividual(emp, true))">
                                                Editar
                                            </MudButton>
                                            @if (emp.VtcoTrasp > 0 || emp.VtcoAlim > 0)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Clear" 
                                                               Size="Size.Small" 
                                                               Color="Color.Error" 
                                                               OnClick="@(() => { emp.VtcoTrasp = 0; emp.VtcoAlim = 0; emp.Modificado = true; ActualizarGruposConsolidados(); })" 
                                                               Title="Poner viáticos a 0" />
                                            }
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudTable Items="@EmpleadosViaticosFiltrados" 
                                  Dense="true" 
                                  Hover="true" 
                                  Striped="true" 
                                  Elevation="1" 
                                  Class="rounded-lg"
                                  Breakpoint="Breakpoint.None">
                            <HeaderContent>
                                <MudTh Style="width: 44px;">
                                    <MudCheckBox T="bool" 
                                                 Value="@(EmpleadosViaticosFiltrados.Any() && EmpleadosViaticosFiltrados.All(x => x.Seleccionado))"
                                                 ValueChanged="@MarcarTodosViaticos"
                                                 Color="Color.Primary" />
                                </MudTh>
                                <MudTh>Colaborador</MudTh>
                                <MudTh Style="width: 170px;">Área / Cliente</MudTh>
                                <MudTh Style="width: 130px;">Trasp (C$)</MudTh>
                                <MudTh Style="width: 130px;">Alim (C$)</MudTh>
                                <MudTh Style="width: 120px;" Class="text-right">Total (C$)</MudTh>
                                <MudTh Style="width: 60px;"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudCheckBox @bind-Value="@context.Seleccionado" Color="Color.Primary" />
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex align-center gap-2">
                                        <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem; min-width: 48px; justify-content: center;">
                                            #@context.CodigoEmpleado
                                        </MudChip>
                                        <MudText Typo="Typo.body2" Class="fw-bold">
                                            @context.NombreEmpleado
                                        </MudText>
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.caption" Class="fw-bold d-block">@context.Area</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Cliente</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal" 
                                                     Value="@context.VtcoTrasp" 
                                                     Variant="Variant.Outlined" 
                                                     Margin="Margin.Dense" 
                                                     Dense="true" 
                                                     Min="0" 
                                                     HideSpinButtons="true"
                                                     Format="N2"
                                                     Adornment="Adornment.Start"
                                                     AdornmentText="C$"
                                                     Style="font-size: 0.82rem; text-align: right;" 
                                                     ValueChanged="@((val) => { context.VtcoTrasp = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal" 
                                                     Value="@context.VtcoAlim" 
                                                     Variant="Variant.Outlined" 
                                                     Margin="Margin.Dense" 
                                                     Dense="true" 
                                                     Min="0" 
                                                     HideSpinButtons="true"
                                                     Format="N2"
                                                     Adornment="Adornment.Start"
                                                     AdornmentText="C$"
                                                     Style="font-size: 0.82rem; text-align: right;" 
                                                     ValueChanged="@((val) => { context.VtcoAlim = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />
                                </MudTd>
                                <MudTd Class="text-right">
                                    @{
                                        var rowTotal = context.VtcoTrasp + context.VtcoAlim;
                                    }
                                    <MudText Typo="Typo.body2" Class="fw-bold" Color="@(rowTotal > 0 ? Color.Success : Color.Secondary)">
                                        C$ @rowTotal.ToString("N2")
                                    </MudText>
                                </MudTd>
                                <MudTd>
                                    <MudStack Row="true" Spacing="0" Justify="Justify.Center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                       Size="Size.Small" 
                                                       Color="Color.Primary" 
                                                       OnClick="@(() => AbrirEditorViaticoIndividual(context, true))"
                                                       Title="Editar viáticos en diálogo" />
                                        @if (context.VtcoTrasp > 0 || context.VtcoAlim > 0)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Clear" 
                                                           Size="Size.Small" 
                                                           Color="Color.Error" 
                                                           OnClick="@(() => { context.VtcoTrasp = 0; context.VtcoAlim = 0; context.Modificado = true; ActualizarGruposConsolidados(); })"
                                                           Title="Poner viáticos a 0" />
                                        }
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                }
            </MudPaper>
        </MudTabPanel>

                @* ==========================================
           TAB 4: BONO DIARIO (RRHH - TRACKER 11: APLICAR BONO DEL DIA)
           ========================================== *@
        <MudTabPanel Text="Bono Diario" ToolTip="Bono Diario (RRHH - Tracker 11)" Icon="@Icons.Material.Filled.MonetizationOn" BadgeData="@TotalConBono" BadgeColor="Color.Primary">
            <MudPaper Class="pa-3 mt-2" Elevation="0">

                @if (HayCambiosSinGuardar)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3" Elevation="1">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                            <span>
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                <b>Cambios pendientes:</b> Hay información sin guardar en Base de Datos. Debes hacer clic en <b>GUARDAR EN BD</b> antes de enviar bonos a Helpdesk.
                            </span>
                            <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="@GuardarEnBaseDatos" Style="font-weight: 700;">
                                Guardar en BD Ahora
                            </MudButton>
                        </div>
                    </MudAlert>
                }

                <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Outlined">
                    La solicitud de <b>Bono Diario (Tracker 11 - Aplicar bono del dia)</b> se genera en el proyecto <b>RRHH</b> 
                    de forma individual para registrar formalmente el pago de bono de cumplimiento o BNC a los colaboradores autorizados en la jornada.
                </MudAlert>

                @* Cards de Resumen de Bonos *@
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-primary" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-primary) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Total Bonos</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">C$ @TotalViaticosBnc.ToString("N2")</MudText>
                                </div>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Paid" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-info" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-info) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Colaboradores</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Info" Class="fw-bold">@TotalConBono</MudText>
                                </div>
                                <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-success" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-success) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">En RRHH (Sinc)</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Success" Class="fw-bold">@TotalBonosSincronizados</MudText>
                                </div>
                                <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudCard Elevation="1" Class="pa-3 border-l-4 border-solid border-warning" Style="border-left-width: 4px !important; border-left-color: var(--mud-palette-warning) !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold text-uppercase">Pendientes</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Warning" Class="fw-bold">@TotalBonosPendientes</MudText>
                                </div>
                                <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Small" />
                                </MudAvatar>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                @* Filtros de Bonos y Acciones *@
                <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="textoBusquedaBonos" 
                                      Placeholder="Buscar colaborador con bono..." 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Immediate="true" 
                                      Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudChip T="string" Color="@(filtroBonos == "CON_BONO" ? Color.Primary : Color.Default)"
                                     Variant="@(filtroBonos == "CON_BONO" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     Class="fw-bold"
                                     OnClick="@(() => filtroBonos = "CON_BONO")">
                                Con Bono (@TotalConBono)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroBonos == "PENDIENTES" ? Color.Warning : Color.Default)"
                                     Variant="@(filtroBonos == "PENDIENTES" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroBonos = "PENDIENTES")">
                                Pendientes (@TotalBonosPendientes)
                            </MudChip>
                            <MudChip T="string" Color="@(filtroBonos == "TODOS" ? Color.Dark : Color.Default)"
                                     Variant="@(filtroBonos == "TODOS" ? Variant.Filled : Variant.Outlined)"
                                     Size="Size.Small"
                                     OnClick="@(() => filtroBonos = "TODOS")">
                                Todos (@TotalPresentes)
                            </MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        @* Selector de 2 Formatos: Tarjetas vs Tabla *@
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary">
                            <MudButton Variant="@(modoVistaBonos == ModoVistaGrilla.Tarjetas ? Variant.Filled : Variant.Outlined)"
                                       StartIcon="@Icons.Material.Filled.GridView"
                                       OnClick="@(() => modoVistaBonos = ModoVistaGrilla.Tarjetas)"
                                       Title="Vista de Tarjetas">
                                Tarjetas
                            </MudButton>
                            <MudButton Variant="@(modoVistaBonos == ModoVistaGrilla.Operativo ? Variant.Filled : Variant.Outlined)"
                                       StartIcon="@Icons.Material.Filled.TableChart"
                                       OnClick="@(() => modoVistaBonos = ModoVistaGrilla.Operativo)"
                                       Title="Vista de Tabla">
                                Tabla
                            </MudButton>
                        </MudButtonGroup>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="flex-wrap">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.Send"
                                       Disabled="@(estaEnviandoBonos || TotalBonosPendientes == 0 || HayCambiosSinGuardar)"
                                       OnClick="@EnviarBonosMasivo"
                                       Style="background: linear-gradient(135deg, #1e3a8a, #2563eb); color: white; font-weight: 700; white-space: nowrap;"
                                       Title="@(HayCambiosSinGuardar ? "Debe guardar los bonos en Base de Datos (clic en GUARDAR EN BD) antes de enviar a RRHH" : (TotalBonosPendientes == 0 ? "Todas las solicitudes de bono ya fueron enviadas a Helpdesk" : "Generar solicitudes de Bono del Día en Helpdesk RRHH (Tracker 11)"))">
                                @(estaEnviandoBonos ? "Enviando a RRHH..." : (TotalBonosPendientes == 0 ? "Bonos Sincronizados" : $"Enviar Bonos a RRHH ({TotalBonosPendientes})"))
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>

                @if (estaEnviandoBonos)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                }

                @* Tabla Detallada de Bonos *@
                @if (!EmpleadosBonosFiltrados.Any())
                {
                    <MudPaper Elevation="0" Class="pa-6 text-center" Style="border: 2px dashed #cbd5e1; border-radius: 12px;">
                        <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Size="Size.Large" Color="Color.Secondary" Class="mb-1" />
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">No hay colaboradores con bono asignado</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                            Puedes asignar montos de bono BNC en la grilla de Asistencias o directamente en esta tabla.
                        </MudText>
                    </MudPaper>
                }
                else if (modoVistaBonos == ModoVistaGrilla.Tarjetas)
                {
                    @* 1. VISTA MODO TARJETAS DE BONOS *@
                    <MudGrid Spacing="2">
                        @foreach (var emp in EmpleadosBonosFiltrados)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between"
                                         Style="@(emp.SincronizadoBono ? "border-left: 5px solid #10b981; background: #fff;" : (emp.BonoBnc > 0 ? "border-left: 5px solid #3b82f6; background: #fff;" : "border-left: 5px solid #cbd5e1; background: #fff;"))">
                                    <MudCardHeader Class="pb-1 pt-3 px-3">
                                        <CardHeaderContent>
                                            <div class="d-flex align-center justify-space-between">
                                                <div class="d-flex align-center gap-2">
                                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 22px; font-size: 0.75rem; min-width: 48px; justify-content: center;">
                                                        #@emp.CodigoEmpleado
                                                    </MudChip>
                                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" Title="@emp.NombreEmpleado">
                                                        @emp.NombreEmpleado
                                                    </MudText>
                                                </div>
                                                @if (emp.SincronizadoBono)
                                                {
                                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="px-2 fw-bold" Style="height: 22px; font-size: 0.72rem;">
                                                        RRHH #@emp.TicketBonoId
                                                    </MudChip>
                                                }
                                                else if (emp.BonoBnc > 0)
                                                {
                                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Class="px-2 fw-bold" Style="height: 22px; font-size: 0.72rem;">
                                                        Pendiente
                                                    </MudChip>
                                                }
                                            </div>
                                        </CardHeaderContent>
                                    </MudCardHeader>

                                    <MudCardContent Class="py-2 px-3">
                                        <div class="mb-2">
                                            <MudText Typo="Typo.caption" Class="fw-bold d-block">@emp.Area</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@emp.Cliente</MudText>
                                        </div>

                                        <MudNumericField T="decimal" 
                                                         Label="Monto Bono"
                                                         Value="@emp.BonoBnc" 
                                                         Variant="Variant.Outlined" 
                                                         Margin="Margin.Dense" 
                                                         Min="0" 
                                                         HideSpinButtons="true"
                                                         Format="N2"
                                                         Adornment="Adornment.Start"
                                                         AdornmentText="C$"
                                                         Class="mb-2"
                                                         Style="font-weight: 700; text-align: right;" 
                                                         ValueChanged="@((val) => { emp.BonoBnc = val; emp.Modificado = true; ActualizarGruposConsolidados(); })" />

                                        <MudTextField @bind-Value="@emp.Observaciones" 
                                                      Label="Observaciones / Motivo"
                                                      Variant="Variant.Outlined" 
                                                      Margin="Margin.Dense" 
                                                      Placeholder="Motivo de bono de cumplimiento..." 
                                                      Lines="2"
                                                      Style="font-size: 0.8rem;"
                                                      OnBlur="@(() => emp.Modificado = true)" />
                                    </MudCardContent>

                                    <MudCardActions Class="px-3 pb-2 pt-0 d-flex justify-space-between align-center">
                                        @if (emp.BonoBnc > 0)
                                        {
                                            <MudButton Variant="Variant.Text" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       StartIcon="@Icons.Material.Filled.Clear"
                                                       OnClick="@(() => { emp.BonoBnc = 0; emp.Modificado = true; ActualizarGruposConsolidados(); })">
                                                Quitar Bono
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <div></div>
                                        }
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudTable Items="@EmpleadosBonosFiltrados" 
                              Dense="true" 
                              Hover="true" 
                              Striped="true" 
                              Elevation="1" 
                              Class="rounded-lg"
                              Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>Colaborador</MudTh>
                            <MudTh Style="width: 170px;">Área / Cliente</MudTh>
                            <MudTh Style="width: 130px;">Monto Bono (C$)</MudTh>
                            <MudTh>Observaciones</MudTh>
                            <MudTh Style="width: 150px;" Class="text-center">Ticket RRHH</MudTh>
                            <MudTh Style="width: 80px;" Class="text-center">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem; min-width: 48px; justify-content: center;">
                                        #@context.CodigoEmpleado
                                    </MudChip>
                                    <MudText Typo="Typo.body2" Class="fw-bold">
                                        @context.NombreEmpleado
                                    </MudText>
                                </div>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Class="fw-bold d-block">@context.Area</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Cliente</MudText>
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" 
                                                 Value="@context.BonoBnc" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 Dense="true" 
                                                 Min="0" 
                                                 HideSpinButtons="true"
                                                 Format="N2"
                                                 Adornment="Adornment.Start"
                                                 AdornmentText="C$"
                                                 Style="font-size: 0.82rem; text-align: right;" 
                                                 ValueChanged="@((val) => { context.BonoBnc = val; context.Modificado = true; ActualizarGruposConsolidados(); })" />
                            </MudTd>
                            <MudTd>
                                <MudTextField @bind-Value="@context.Observaciones" 
                                              Variant="Variant.Outlined" 
                                              Margin="Margin.Dense" 
                                              Dense="true" 
                                              Placeholder="Motivo de bono de cumplimiento..." 
                                              Style="font-size: 0.8rem;"
                                              OnBlur="@(() => context.Modificado = true)" />
                            </MudTd>
                            <MudTd Class="text-center">
                                @if (context.SincronizadoBono)
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="px-2 fw-bold" Style="height: 22px; font-size: 0.75rem;">
                                        RRHH #@context.TicketBonoId
                                    </MudChip>
                                }
                                else if (context.BonoBnc > 0)
                                {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Class="px-2 fw-bold" Style="height: 22px; font-size: 0.75rem;">
                                        Pendiente
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>
                            <MudTd Class="text-center">
                                @if (context.BonoBnc > 0)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Clear" 
                                                   Size="Size.Small" 
                                                   Color="Color.Error" 
                                                   OnClick="@(() => { context.BonoBnc = 0; context.Modificado = true; ActualizarGruposConsolidados(); })"
                                                   Title="Poner bono a 0" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>


        @* ==========================================
           TAB 3: CONSOLIDADO & ENVÍO A HELPDESK
           ========================================== *@
        <MudTabPanel Text="Movimientos" ToolTip="Movimientos" Icon="@Icons.Material.Filled.ConfirmationNumber" BadgeData="@gruposConsolidados.Count" BadgeColor="Color.Primary">
            <MudPaper Class="pa-3 mt-2" Elevation="0">

                @if (HayCambiosSinGuardar)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3" Elevation="1">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                            <span>
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                <b>Cambios pendientes:</b> Hay información sin guardar en Base de Datos. Debes hacer clic en <b>GUARDAR EN BD</b> antes de enviar la jornada a Helpdesk.
                            </span>
                            <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="@GuardarEnBaseDatos" Style="font-weight: 700;">
                                Guardar en BD Ahora
                            </MudButton>
                        </div>
                    </MudAlert>
                }

                <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Outlined">
                    Esta pestaña agrupa automáticamente la asistencia activa exactamente con la lógica de <b>OPM_Produccion_Diaria_Hrs</b> 
                    para generar y sincronizar los tickets de <b>Movimientos de Personal (Tracker 1)</b> y <b>Viáticos Operativos (Tracker 28)</b> en Helpdesk.
                </MudAlert>

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.h6" Class="fw-bold">Grupos Listos para Helpdesk (@gruposConsolidados.Count)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Total de @TotalPresentes colaboradores distribuidos en @gruposConsolidados.Count asignaciones
                        </MudText>
                    </div>

                    <div class="d-flex align-center gap-2">
                        @* Selector de 2 Vistas (Tarjetas y Operativa) *@
                        <div class="odoo-view-switcher">
                            <button type="button" 
                                    class="odoo-view-btn @(modoVistaMovimientos == ModoVistaGrilla.Tarjetas ? "active" : "")" 
                                    @onclick="@(() => modoVistaMovimientos = ModoVistaGrilla.Tarjetas)" 
                                    title="Vista Tarjetas (Kanban)">
                                <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                            </button>
                            <button type="button" 
                                    class="odoo-view-btn @(modoVistaMovimientos == ModoVistaGrilla.Operativo ? "active" : "")" 
                                    @onclick="@(() => modoVistaMovimientos = ModoVistaGrilla.Operativo)" 
                                    title="Vista Operativa (Tabla)">
                                <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" />
                            </button>
                        </div>

                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Size="Size.Large" 
                                   StartIcon="@Icons.Material.Filled.RocketLaunch"
                                   Disabled="@(estaEnviandoHelpdesk || TotalGruposMovimientosPendientes == 0 || HayCambiosSinGuardar)"
                                   OnClick="@EnviarAHelpdeskMasivo"
                                   Style="font-weight: 800; letter-spacing: 0.5px; border-radius: 12px;"
                                   Title="@(HayCambiosSinGuardar ? "Debe guardar la jornada en Base de Datos (clic en GUARDAR EN BD) antes de enviar a Helpdesk" : (TotalGruposMovimientosPendientes == 0 ? "Todos los grupos de movimiento ya están sincronizados con Helpdesk" : "Sincronizar y generar tickets de Movimientos en Helpdesk"))">
                            @(estaEnviandoHelpdesk ? "Sincronizando con Helpdesk..." : (TotalGruposMovimientosPendientes == 0 ? "JORNADA SINCRONIZADA" : $"ENVIAR JORNADA A HELPDESK ({TotalGruposMovimientosPendientes})"))
                        </MudButton>
                    </div>
                </MudStack>

                @if (estaEnviandoHelpdesk)
                {
                    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-2" />
                }

                @if (!gruposConsolidados.Any())
                {
                    <MudPaper Class="pa-8 my-4 text-center d-flex flex-column align-center justify-center" 
                              Elevation="0" 
                              Style="background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 12px; min-height: 200px;">
                        <MudIcon Icon="@Icons.Material.Filled.GroupWork" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.body1" Class="fw-bold text-dark">
                            No hay colaboradores presentes para consolidar en grupos
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Registra asistencia en la pestaña de Asistencias para generar automáticamente los grupos de movimiento.
                        </MudText>
                    </MudPaper>
                }
                else if (modoVistaMovimientos == ModoVistaGrilla.Tarjetas)
                {
                    @* 1. VISTA MODO TARJETAS (KANBAN TOUCH-FRIENDLY) *@
                    <MudGrid Spacing="2">
                        @foreach (var grupo in gruposConsolidados)
                        {
                            <MudItem xs="12" md="6" lg="4">
                                <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between" Style="@(grupo.Sincronizado ? "border-left: 5px solid #10b981;" : "border-left: 5px solid #f59e0b;")">
                                    <MudCardHeader Class="pb-1">
                                        <CardHeaderAvatar>
                                            <MudAvatar Color="@(grupo.Sincronizado ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                                                #@grupo.GrupoIndex
                                            </MudAvatar>
                                        </CardHeaderAvatar>
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-1 mb-1 flex-wrap">
                                                @if (!string.IsNullOrWhiteSpace(grupo.Cliente))
                                                {
                                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="px-1 fw-bold" Style="height: 18px; font-size: 0.7rem;">
                                                        @grupo.Cliente
                                                    </MudChip>
                                                }
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold text-truncate">
                                                    @grupo.Area
                                                </MudText>
                                            </div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @grupo.Puesto • Horario: @grupo.HoraInicio - @grupo.HoraFin • Comida: @grupo.TiempoComida h
                                            </MudText>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            @if (grupo.Sincronizado)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                                    Sincronizado
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                                    Pendiente
                                                </MudChip>
                                            }
                                        </CardHeaderActions>
                                    </MudCardHeader>

                                    <MudCardContent Class="pt-1 pb-2">
