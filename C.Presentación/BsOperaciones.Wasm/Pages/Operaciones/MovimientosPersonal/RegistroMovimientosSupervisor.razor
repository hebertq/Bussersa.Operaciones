                                            style="width: 72px; font-size: 0.75rem; border: 1px solid #ced4da; border-radius: 4px; padding: 2px 4px; background: white;" 
                                            title="Tiempo de comida en horas">
                                        <option value="1.00">1.0h com</option>
                                        <option value="0.50">0.5h com</option>
                                        <option value="0.00">Sin com</option>
                                    </select>
                                </MudTd>
                                <MudTd>
                                    @{
                                        var totalVOp = context.VtcoTrasp + context.VtcoAlim + context.BonoBnc;
