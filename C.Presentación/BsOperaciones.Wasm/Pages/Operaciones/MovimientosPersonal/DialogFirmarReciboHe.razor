@using MudBlazor
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@inject IOdooService _odooService
@inject IJSRuntime _js
@inject ISnackbar _snackbar

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.Draw" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.subtitle1" Class="fw-bold">
                    Agregar Firma de @(TipoFirma == "SUPERVISOR" ? "Supervisor" : "Gerente / Autorizador")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    #@Autorizacion.CodigoEmpleado @Autorizacion.NombreEmpleado &bull; @Autorizacion.HorasExtrasAutorizadas.ToString("N2")h (@Autorizacion.Fecha.ToString("dd/MM/yyyy"))
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="nombreFirmante" Label="Nombre completo de quien firma" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        <MudTextField @bind-Value="cargoFirmante" Label="Cargo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

        <div class="d-flex justify-space-between align-center mb-1">
            <MudText Typo="Typo.caption" Class="fw-bold">Dibuje la firma aquí:</MudText>
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CleaningServices" OnClick="@Limpiar">
                Limpiar
            </MudButton>
        </div>
        <div style="border: 2px dashed #475569; border-radius: 8px; background: #ffffff; overflow: hidden;">
            <canvas id="canvas_firma_adicional" style="width: 100%; height: 155px; display: block; touch-action: none; cursor: crosshair;"></canvas>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => MudDialog.Cancel())" Disabled="@guardando">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="@Guardar" Disabled="@guardando">
            @(guardando ? "Guardando en Helpdesk..." : "Guardar Firma")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public AutorizacionHorasExtrasDto Autorizacion { get; set; } = new();
    [Parameter] public string TipoFirma { get; set; } = "GERENTE";

    private string nombreFirmante = string.Empty;
    private string cargoFirmante = "Gerente / Autorizador";
    private bool guardando = false;

    protected override void OnInitialized()
    {
        if (TipoFirma == "SUPERVISOR")
        {
            nombreFirmante = Autorizacion.SupervisorNombre ?? string.Empty;
            cargoFirmante = string.IsNullOrWhiteSpace(Autorizacion.SupervisorCargo) ? "Supervisor de Operaciones" : Autorizacion.SupervisorCargo;
        }
        else
        {
            nombreFirmante = Autorizacion.GerenteNombre ?? string.Empty;
            cargoFirmante = string.IsNullOrWhiteSpace(Autorizacion.GerenteCargo) ? "Gerente / Autorizador" : Autorizacion.GerenteCargo;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(120);
            await _js.InvokeVoidAsync("signaturePadInterop.init", "canvas_firma_adicional");
        }
    }

    private async Task Limpiar() => await _js.InvokeVoidAsync("signaturePadInterop.clear", "canvas_firma_adicional");

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(nombreFirmante))
        {
            _snackbar.Add("Ingrese el nombre de quien firma.", Severity.Warning);
            return;
        }
        bool ok = await _js.InvokeAsync<bool>("signaturePadInterop.hasSignature", "canvas_firma_adicional");
        if (!ok)
        {
            _snackbar.Add("Dibuje la firma en el recuadro antes de guardar.", Severity.Warning);
            return;
        }

        string png = await _js.InvokeAsync<string>("signaturePadInterop.getDataUrl", "canvas_firma_adicional");
        guardando = true;
        try
        {
            var resp = await _odooService.AgregarFirmaAutorizacionHorasExtras(new AgregarFirmaAutorizacionRequestDto
            {
                AutorizacionId = Autorizacion.Id,
                TipoFirma = TipoFirma,
                NombreFirmante = nombreFirmante.Trim(),
                CargoFirmante = cargoFirmante.Trim(),
                FirmaBase64 = png,
                UsuarioActualizacion = nombreFirmante.Trim()
            });

            if (resp != null && !resp.Respuesta.ExisteError && resp.Model != null)
            {
                _snackbar.Add("Firma guardada y adjuntada a la tarea de Helpdesk.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(resp.Model));
            }
            else
            {
                _snackbar.Add(resp?.Respuesta?.MensajeError ?? "No se pudo guardar la firma.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }
}
