@using MudBlazor
@using System.Globalization
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using Modelo.Entidades.Entradas.Odoo
@using HostService.Interfaces

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Agregar Colaborador a la Jornada</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Buscar en el catálogo de personal de Odoo o ingresar manualmente
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @* Selector / Buscador de Odoo *@
                <MudItem xs="12">
                    <MudAutocomplete T="OdooEmployeeDto"
                                     Label="Buscar Colaborador en Odoo (Nombre o Carnet #)"
                                     Value="@empleadoSeleccionado"
                                     ValueChanged="@OnEmpleadoOdooSeleccionado"
                                     SearchFunc="@BuscarColaboradorOdoo"
                                     ToStringFunc="@(e => e != null ? $"#{e.CodigoEmpleado ?? e.Id} - {e.Name} ({e.JobTitle ?? "Colaborador"})" : string.Empty)"
                                     ResetValueOnEmptyText="false"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     Dense="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Placeholder="Escribe el nombre o carnet del colaborador..." />
                </MudItem>

                @* Datos del Empleado *@
                <MudItem xs="4">
                    <MudNumericField T="int" @bind-Value="CodigoEmpleado" Label="Carnet / ID" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                </MudItem>
                <MudItem xs="8">
                    <MudTextField @bind-Value="NombreEmpleado" Label="Nombre Completo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                @* Cliente y Área *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Cliente / Operación" Value="Cliente" ValueChanged="@OnClienteChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               Label="Área Operativa"
                               @bind-Value="Area"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        @{
                            var areasDlg = areasActuales;
                            if (!string.IsNullOrWhiteSpace(Area) && !areasDlg.Contains(Area, StringComparer.OrdinalIgnoreCase))
                            {
                                areasDlg = new List<string>(areasDlg) { Area };
                            }
                        }
                        @foreach (var a in areasDlg)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Puesto *@
                <MudItem xs="12">
                    <MudSelect T="string" Label="Cargo / Puesto" @bind-Value="Puesto" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Horario y Tiempo de Comida *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Horario y Tiempo de Comida
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Entrada" @bind-Value="HoraEntrada" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="06:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Salida" @bind-Value="HoraSalida" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="14:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     Label="Tiempo Comida (Horas)" 
                                     @bind-Value="TiempoComida" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     Max="24" 
                                     Step="0.5m" 
                                     Format="0.00" 
                                     Adornment="Adornment.End" 
                                     AdornmentText="hrs" />
                </MudItem>

                @* Viáticos y BNC *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                        Viáticos y Bonos (Opcional)
                    </MudText>
                </MudItem>

                <MudItem xs="4">
                    <MudNumericField T="decimal" @bind-Value="VtcoTrasp" Label="Trasp (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoTrasp = 0)">0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 35 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 35)">35</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 50)">50</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoTrasp == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => VtcoTrasp = 70)">70</MudChip>
                    </div>
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField T="decimal" @bind-Value="VtcoAlim" Label="Alim (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => VtcoAlim = 0)">0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 50)">50</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 70)">70</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(VtcoAlim == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => VtcoAlim = 100)">100</MudChip>
                    </div>
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField T="decimal" @bind-Value="BonoBnc" Label="BNC (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0" />
                    <div class="d-flex gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => BonoBnc = 0)">0</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 100)">100</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="@(BonoBnc == 150 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => BonoBnc = 150)">150</MudChip>
                    </div>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Agregar" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">
            Agregar a la Jornada
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private IOdooService _odooService { get; set; } = null!;
    [Inject] private ISnackbar _snackbar { get; set; } = null!;

    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public List<string> AreasDisponibles { get; set; } = new();
    [Parameter] public Dictionary<string, List<string>> AreasPorCliente { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();
    [Parameter] public string OperacionDefecto { get; set; } = string.Empty;
    [Parameter] public string AreaDefecto { get; set; } = string.Empty;
    [Parameter] public string TextoBusquedaInicial { get; set; } = string.Empty;

    private int IdEmpleado;
    private int CodigoEmpleado;
    private string NombreEmpleado = string.Empty;
    private string Cliente = string.Empty;
    private string Area = string.Empty;
    private string Puesto = "6-Operador de almacen";
    private string TurnoNombre = "General";
    private string HoraEntrada = "06:00";
    private string HoraSalida = "14:00";
    private decimal TiempoComida = 1.00m;
    private decimal VtcoTrasp = 0;
    private decimal VtcoAlim = 0;
    private decimal BonoBnc = 0;

    private List<string> areasActuales = new();
    private List<OdooEmployeeDto> catalogoOdooCompleto = new();
    private OdooEmployeeDto? empleadoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        Cliente = !string.IsNullOrWhiteSpace(OperacionDefecto) ? OperacionDefecto : (OperacionesDisponibles.FirstOrDefault()?.nombre ?? "WalMart");
        ActualizarAreasParaCliente(Cliente);
        Area = !string.IsNullOrWhiteSpace(AreaDefecto) && areasActuales.Contains(AreaDefecto, StringComparer.OrdinalIgnoreCase)
            ? AreaDefecto
            : (areasActuales.FirstOrDefault() ?? "Operaciones");

        try
        {
            var resp = await _odooService.GetAllActiveEmployeesForRotation();
            if (resp?.Model != null)
            {
                catalogoOdooCompleto = resp.Model.ToList();
            }
        }
        catch { }

        if (!string.IsNullOrWhiteSpace(TextoBusquedaInicial))
        {
            if (int.TryParse(TextoBusquedaInicial, out int cod))
            {
                CodigoEmpleado = cod;
                var match = catalogoOdooCompleto.FirstOrDefault(e => (e.CodigoEmpleado ?? e.Id) == cod);
                if (match != null) OnEmpleadoOdooSeleccionado(match);
            }
            else
            {
                NombreEmpleado = TextoBusquedaInicial;
                var match = catalogoOdooCompleto.FirstOrDefault(e => e.Name.Contains(TextoBusquedaInicial, StringComparison.OrdinalIgnoreCase));
                if (match != null) OnEmpleadoOdooSeleccionado(match);
            }
        }
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        Cliente = nuevoCliente;
        ActualizarAreasParaCliente(nuevoCliente);
        if (!areasActuales.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasActuales.FirstOrDefault() ?? "Operaciones";
        }
    }

    private void ActualizarAreasParaCliente(string? cliente)
    {
        if (string.IsNullOrWhiteSpace(cliente))
        {
            areasActuales = AreasDisponibles.Any() ? AreasDisponibles : new List<string> { "Operaciones" };
            return;
        }

        string limpio = cliente.Trim();
        if (AreasPorCliente.TryGetValue(limpio, out var list) && list.Any())
        {
            areasActuales = list;
            return;
        }

        var match = AreasPorCliente.FirstOrDefault(kvp =>
            kvp.Key.Contains(limpio, StringComparison.OrdinalIgnoreCase) ||
            limpio.Contains(kvp.Key, StringComparison.OrdinalIgnoreCase));

        if (match.Value != null && match.Value.Any())
        {
            areasActuales = match.Value;
            return;
        }

        areasActuales = AreasDisponibles.Any() ? AreasDisponibles : new List<string> { "Operaciones" };
    }

    private Task<IEnumerable<OdooEmployeeDto>> BuscarColaboradorOdoo(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return Task.FromResult<IEnumerable<OdooEmployeeDto>>(catalogoOdooCompleto.Take(15));

        var query = catalogoOdooCompleto.Where(e =>
            e.Name.Contains(valor, StringComparison.OrdinalIgnoreCase) ||
            (e.CodigoEmpleado.HasValue && e.CodigoEmpleado.Value.ToString().Contains(valor)) ||
            e.Id.ToString().Contains(valor)
        ).Take(20);

        return Task.FromResult(query);
    }

    private void OnEmpleadoOdooSeleccionado(OdooEmployeeDto? emp)
    {
        empleadoSeleccionado = emp;
        if (emp != null)
        {
            IdEmpleado = emp.Id;
            CodigoEmpleado = emp.CodigoEmpleado ?? emp.Id;
            NombreEmpleado = emp.Name;
            if (!string.IsNullOrWhiteSpace(emp.JobTitle))
            {
                var cargoMatch = CargosDisponibles.FirstOrDefault(c => c.Contains(emp.JobTitle, StringComparison.OrdinalIgnoreCase));
                Puesto = cargoMatch ?? emp.JobTitle;
            }
        }
    }

    private Task<IEnumerable<string>> BuscarAreas(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return Task.FromResult<IEnumerable<string>>(areasActuales);

        return Task.FromResult(areasActuales.Where(x => x.Contains(valor, StringComparison.OrdinalIgnoreCase)));
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Agregar()
    {
        if (string.IsNullOrWhiteSpace(NombreEmpleado))
        {
            _snackbar.Add("Ingrese el nombre del colaborador.", Severity.Warning);
            return;
        }

        if (CodigoEmpleado <= 0)
        {
            _snackbar.Add("Ingrese un código o carnet válido para el colaborador.", Severity.Warning);
            return;
        }

        var item = new EmpleadoJornadaItem
        {
            Id = 0,
            IdEmpleado = IdEmpleado > 0 ? IdEmpleado : CodigoEmpleado,
            CodigoEmpleado = CodigoEmpleado,
            NombreEmpleado = NombreEmpleado.Trim(),
            Cliente = Cliente,
            Area = Area,
            Puesto = Puesto,
            TurnoNombre = TurnoNombre,
            HoraEntrada = HoraEntrada,
            HoraSalida = HoraSalida,
            TiempoComida = TiempoComida.ToString("0.00", CultureInfo.InvariantCulture),
            VtcoTrasp = VtcoTrasp,
            VtcoAlim = VtcoAlim,
            BonoBnc = BonoBnc,
            Asistio = true,
            Estado = "BORRADOR",
            Modificado = true
        };

        MudDialog.Close(DialogResult.Ok(item));
    }
}
