@using MudBlazor
@using Modelo.ClasesGenericas

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Asignación Masiva Rápida</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Aplicar cliente, área, puesto y viáticos a <b>@CantidadSeleccionada colaboradores</b> seleccionados
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @* Cliente, Área y Cargo *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1">1. Cliente, Área Operativa y Puesto</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Cliente / Operación" Value="@Cliente" ValueChanged="@OnClienteChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("")">-- Mantener cliente actual de cada colaborador --</MudSelectItem>
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               Label="Área Operativa"
                               @bind-Value="Area"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Place">
                        @{
                            var areasMasiva = areasActuales;
                            if (!string.IsNullOrWhiteSpace(Area) && !areasMasiva.Contains(Area, StringComparer.OrdinalIgnoreCase))
                            {
                                areasMasiva = new List<string>(areasMasiva) { Area };
                            }
                        }
                        @foreach (var a in areasMasiva)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="12">
                    <MudSelect T="string" Label="Cargo / Puesto" @bind-Value="Puesto" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Viáticos *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 mt-2">2. Viáticos por Persona</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Transporte (C$):</MudText>
                    <MudStack Row="true" Spacing="1" Class="mb-1">
                        @foreach (var v in new[] { 0, 50, 100, 150 })
                        {
                            <MudChip T="string" Size="Size.Small" 
                                     Color="@(VtcoTrasp == v ? Color.Info : Color.Default)"
                                     Variant="@(VtcoTrasp == v ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => VtcoTrasp = v)">
                                C$ @v
                            </MudChip>
                        }
                    </MudStack>
                    <MudNumericField @bind-Value="VtcoTrasp" Label="Monto Transporte" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Alimentación (C$):</MudText>
                    <MudStack Row="true" Spacing="1" Class="mb-1">
                        @foreach (var v in new[] { 0, 50, 70, 100, 150 })
                        {
                            <MudChip T="string" Size="Size.Small" 
                                     Color="@(VtcoAlim == v ? Color.Info : Color.Default)"
                                     Variant="@(VtcoAlim == v ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => VtcoAlim = v)">
                                C$ @v
                            </MudChip>
                        }
                    </MudStack>
                    <MudNumericField @bind-Value="VtcoAlim" Label="Monto Alimentación" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Bono BNC (C$):</MudText>
                    <MudStack Row="true" Spacing="1" Class="mb-1">
                        @foreach (var v in new[] { 0, 50, 100, 150 })
                        {
                            <MudChip T="string" Size="Size.Small" 
                                     Color="@(BonoBnc == v ? Color.Info : Color.Default)"
                                     Variant="@(BonoBnc == v ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => BonoBnc = v)">
                                C$ @v
                            </MudChip>
                        }
                    </MudStack>
                    <MudNumericField @bind-Value="BonoBnc" Label="Monto Bono BNC" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="@Aplicar" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check">
            Aplicar a @CantidadSeleccionada Empleados
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int CantidadSeleccionada { get; set; }
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public Dictionary<string, List<string>> AreasPorCliente { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public List<string> AreasDisponibles { get; set; } = new();
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();
    [Parameter] public string AreaInicial { get; set; } = string.Empty;
    [Parameter] public string PuestoInicial { get; set; } = "6-Operador de almacen";
    [Parameter] public string ClienteInicial { get; set; } = string.Empty;

    public string TurnoSeleccionado { get; set; } = "Diurno";
    public string HoraEntrada { get; set; } = "06:00";
    public string HoraSalida { get; set; } = "14:00";
    public string Area { get; set; } = string.Empty;
    public string Puesto { get; set; } = "6-Operador de almacen";
    public string Cliente { get; set; } = string.Empty;
    public decimal VtcoTrasp { get; set; } = 0m;
    public decimal VtcoAlim { get; set; } = 0m;
    public decimal BonoBnc { get; set; } = 0m;

    private List<string> areasActuales = new();

    protected override void OnInitialized()
    {
        Area = AreaInicial;
        Puesto = string.IsNullOrWhiteSpace(PuestoInicial) ? "6-Operador de almacen" : PuestoInicial;
        Cliente = ClienteInicial;
        ActualizarAreasParaCliente(Cliente);
        if (string.IsNullOrWhiteSpace(Area) || !areasActuales.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasActuales.FirstOrDefault() ?? AreaInicial;
        }
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        Cliente = nuevoCliente;
        ActualizarAreasParaCliente(nuevoCliente);
        if (!areasActuales.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasActuales.FirstOrDefault() ?? "Operaciones";
        }
    }

    private void ActualizarAreasParaCliente(string? cliente)
    {
        if (string.IsNullOrWhiteSpace(cliente))
        {
            areasActuales = AreasDisponibles.Any() ? AreasDisponibles : new List<string> { "Operaciones" };
            return;
        }

        string limpio = cliente.Trim();
        if (AreasPorCliente.TryGetValue(limpio, out var list) && list.Any())
        {
            areasActuales = list;
            return;
        }

        var match = AreasPorCliente.FirstOrDefault(kvp =>
            kvp.Key.Contains(limpio, StringComparison.OrdinalIgnoreCase) ||
            limpio.Contains(kvp.Key, StringComparison.OrdinalIgnoreCase));

        if (match.Value != null && match.Value.Any())
        {
            areasActuales = match.Value;
            return;
        }

        areasActuales = AreasDisponibles.Any() ? AreasDisponibles : new List<string> { "Operaciones" };
    }

    private void SetTurno(string turno, string entrada, string salida)
    {
        TurnoSeleccionado = turno;
        HoraEntrada = entrada;
        HoraSalida = salida;
    }

    private Task<IEnumerable<string>> BuscarAreas(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return Task.FromResult<IEnumerable<string>>(areasActuales);

        return Task.FromResult(areasActuales.Where(x => x.Contains(valor, StringComparison.OrdinalIgnoreCase)));
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Aplicar()
    {
        var model = new ResultadoAsignacionMasiva
        {
            TurnoNombre = TurnoSeleccionado,
            HoraEntrada = HoraEntrada,
            HoraSalida = HoraSalida,
            Area = Area,
            Puesto = Puesto,
            Cliente = Cliente,
            VtcoTrasp = VtcoTrasp,
            VtcoAlim = VtcoAlim,
            BonoBnc = BonoBnc
        };
        MudDialog.Close(DialogResult.Ok(model));
    }

    public class ResultadoAsignacionMasiva
    {
        public string TurnoNombre { get; set; } = "Diurno";
        public string HoraEntrada { get; set; } = "06:00";
        public string HoraSalida { get; set; } = "14:00";
        public string Area { get; set; } = string.Empty;
        public string Puesto { get; set; } = string.Empty;
        public string Cliente { get; set; } = string.Empty;
        public decimal VtcoTrasp { get; set; }
        public decimal VtcoAlim { get; set; }
        public decimal BonoBnc { get; set; }
    }
}
