@page "/operaciones/productos-adicionales"
@inject IOdooService OdooService
@inject IJSRuntime JSRuntime
@using Modelo.Entidades.Operaciones
@using Modelo.ClasesGenericas
@using Modelo.Entidades.Entradas.Odoo
@using HostService.Interfaces

<div class="container-fluid p-4" style="background-color: #f8fafc; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom bg-white p-3 rounded-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0f172a;">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>Gestión de Productos Adicionales e Insumos Automáticos
            </h2>
            <p class="text-secondary small mb-0 fw-semibold">
                Configure insumos y productos adicionales (ej. *40 etiquetas por cada unidad de servicio principal*) que se agregan automáticamente al registrar la producción diaria.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/operaciones/produccion-diaria" class="btn btn-outline-secondary btn-sm px-3 rounded-pill fw-bold">
                <i class="bi bi-journal-text me-1"></i>Ver Producción Diaria
            </a>
            <button class="btn btn-primary btn-sm px-3 shadow-sm rounded-pill fw-bold" @onclick="PrepareCreate">
                <i class="bi bi-plus-lg me-1"></i>+ NUEVO INSUMO ADICIONAL
            </button>
        </div>
    </div>

    <!-- Summary Badges -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm text-white rounded-3 p-3" style="background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3 fs-3 d-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.2); width: 50px; height: 50px;">
                        <i class="bi bi-boxes text-white"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small fw-bold">TOTAL REGLAS DE INSUMOS CONFIGURADAS</div>
                        <div class="fs-2 fw-bold text-white">@itemsList.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm text-white rounded-3 p-3" style="background: linear-gradient(135deg, #0369a1 0%, #38bdf8 100%);">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3 fs-3 d-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.2); width: 50px; height: 50px;">
                        <i class="bi bi-building text-white"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small fw-bold">OPERACIONES CON INSUMOS</div>
                        <div class="fs-2 fw-bold text-white">@itemsList.Select(x => x.OperacionId).Distinct().Count()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0" style="color: #0f172a;">
                <i class="bi bi-list-check me-2 text-primary"></i>Catálogo de Insumos Automáticos por Servicio (@FilteredItems.Count())
            </h5>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="max-width: 300px;">
                    <span class="input-group-text bg-white border"><i class="bi bi-search text-dark"></i></span>
                    <input type="text" class="form-control border" style="color: #000; font-weight: 500;" placeholder="Buscar insumo o servicio..." @bind="searchText" @bind:event="oninput" />
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-dark fw-semibold mt-2">Cargando catálogo de productos adicionales...</p>
                </div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary display-4"></i>
                    <p class="text-secondary fw-semibold mt-2">No se encontraron productos adicionales configurados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: #0f172a; width: 100%;">
                        <thead style="background-color: #f1f5f9; color: #1e293b;" class="small fw-bold text-uppercase border-bottom">
                            <tr>
                                <th style="width: 50px;" class="ps-3 py-3">ID</th>
                                <th style="width: 200px;" class="py-3">Cliente / Operación</th>
                                <th style="width: 250px;" class="py-3">Servicio Principal</th>
                                <th class="py-3">Insumo / Producto Adicional Derivado</th>
                                <th style="width: 180px;" class="py-3 text-end">Cantidad por Unidad Principal</th>
                                <th style="width: 90px;" class="py-3 text-center">Estado</th>
                                <th style="width: 100px;" class="text-end pe-3 py-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredItems)
                            {
                                <tr style="border-bottom: 1px solid #e2e8f0; background-color: #ffffff;">
                                    <td class="ps-3 py-3 fw-bold" style="color: #475569; font-size: 13px;">#@item.Id</td>
                                    <td class="py-3">
                                        <div style="font-weight: 700; color: #1d4ed8; font-size: 13px;">
                                            <i class="bi bi-building me-1"></i>@(string.IsNullOrWhiteSpace(item.OperacionNombre) ? "GLOBAL" : item.OperacionNombre)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.AreaCliente))
                                        {
                                            <div class="small text-secondary fw-semibold" style="font-size: 12px;">
                                                <i class="bi bi-geo-alt me-1"></i>@item.AreaCliente
                                            </div>
                                        }
                                    </td>
                                    <td class="py-3 fw-bold" style="color: #0f172a; font-size: 13px;">
                                        <i class="bi bi-gear-fill me-1 text-secondary"></i>@item.ServicioNombre
                                    </td>
                                    <td class="py-3">
                                        <div>
                                            <span style="font-weight: 700; color: #065f46; font-size: 14px;">
                                                <i class="bi bi-tag-fill me-1 text-success"></i>@item.NombreProductoAdicional
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(item.CodigoItem))
                                            {
                                                <span class="ms-2 badge bg-light text-dark border">@item.CodigoItem</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-3 text-end fw-bold" style="color: #059669; font-size: 15px;">
                                        <i class="bi bi-plus-circle me-1"></i>@item.CantidadFactor.ToString("N2") <span class="small text-muted font-normal">unidades</span>
                                    </td>
                                    <td class="py-3 text-center">
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3 py-3">
                                        <div style="display: flex; gap: 4px; justify-content: flex-end;">
                                            <button type="button" class="btn btn-sm btn-primary" style="padding: 4px 8px; font-size: 12px;" title="Editar" @onclick="() => EditItem(item)">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger" style="padding: 4px 8px; font-size: 12px;" title="Eliminar" @onclick="() => DeleteItem(item.Id)">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Form -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.6);" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" style="max-height: 90vh;">
            <div class="modal-content border-0 shadow-lg" style="max-height: 90vh; display: flex; flex-direction: column;">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-box-seam me-2"></i>Configuración de Servicio Principal e Insumos Adicionales
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showModal = false"></button>
                </div>
                
                <div class="modal-body p-4" style="overflow-y: auto; background-color: #ffffff; color: #0f172a; flex: 1 1 auto;">
                    <!-- SECCIÓN 1: CLIENTE Y SERVICIO PRINCIPAL -->
                    <div class="card border border-primary-subtle bg-light mb-4 shadow-sm">
                        <div class="card-header bg-white border-bottom fw-bold text-primary">
                            <i class="bi bi-gear-fill me-2"></i>1. Definición del Servicio Principal
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <!-- Operación / Cliente -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small" style="color: #334155;">Cliente / Operación Configurada *</label>
                                    <select class="form-select fw-bold" style="color: #0f172a;" @bind="selectedOperacionId" @bind:after="OnOperacionChanged">
                                        <option value="0">🌐 GLOBAL (Todas las operaciones)</option>
                                        @foreach (var op in operacionesList)
                                        {
                                            <option value="@op.id">@op.nombre</option>
                                        }
                                    </select>
                                </div>

                                <!-- Área de Cliente -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small" style="color: #334155;">Área / Departamento de Cliente (Opcional)</label>
                                    <input type="text" class="form-control fw-bold" style="color: #0f172a;" @bind="areaCliente" placeholder="Ej: Bodega, Baneo, Empaque..." />
                                </div>

                                <!-- Plantilla Principal -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small" style="color: #334155;">Plantilla de Producto Principal (Odoo) *</label>
                                    <select class="form-select fw-bold" style="color: #0f172a;" @bind="selectedMainTemplateId" @bind:after="OnMainTemplateChanged">
                                        <option value="">-- Seleccionar Plantilla Principal (@productTemplatesList.Count disponibles) --</option>
                                        @foreach (var t in productTemplatesList)
                                        {
                                            <option value="@t.id">@t.nombre</option>
                                        }
                                    </select>
                                </div>

                                <!-- Variante Principal (Filtrada por Cliente) -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small" style="color: #334155;">Variante del Servicio Principal *</label>
                                    @if (loadingMainVariants)
                                    {
                                        <div class="d-flex align-items-center gap-2 py-2">
                                            <span class="spinner-border spinner-border-sm text-primary"></span>
                                            <span class="small text-secondary fw-semibold">Cargando variantes principales...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <select class="form-select fw-bold" style="color: #0f172a;" @bind="selectedMainVariantId" @bind:after="OnMainVariantChanged">
                                            <option value="">-- Seleccionar Variante Principal (@FilteredMainVariants.Count() disponibles) --</option>
                                            @foreach (var v in FilteredMainVariants)
                                            {
                                                <option value="@v.id">@v.nombre (@v.default_code)</option>
                                            }
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECCIÓN 2: FORMULARIO DE AGREGAR INSUMOS ADICIONALES (PRODUCTOS ADICIONALES) -->
                    <div class="card border border-success-subtle bg-white mb-4 shadow-sm">
                        <div class="card-header bg-success text-white fw-bold">
                            <i class="bi bi-plus-circle-fill me-2"></i>2. Agregar Insumo / Producto Adicional Derivado
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3 align-items-end">
                                <!-- Plantilla Secundaria -->
                                <div class="col-md-5">
                                    <label class="form-label fw-bold small" style="color: #334155;">Plantilla de Insumo Adicional *</label>
                                    <select class="form-select fw-bold" style="color: #0f172a;" @bind="selectedSecTemplateId" @bind:after="OnSecTemplateChanged">
                                        <option value="">-- Seleccionar Plantilla Adicional (@productTemplatesList.Count disponibles) --</option>
                                        @foreach (var t in productTemplatesList)
                                        {
                                            <option value="@t.id">@t.nombre</option>
                                        }
                                    </select>
                                </div>

                                <!-- Variante Secundaria -->
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small" style="color: #334155;">Variante Específica de Insumo *</label>
                                    @if (loadingSecVariants)
                                    {
                                        <div class="d-flex align-items-center gap-2 py-2">
                                            <span class="spinner-border spinner-border-sm text-success"></span>
                                            <span class="small text-secondary fw-semibold">Cargando variantes de insumo...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <select class="form-select fw-bold" style="color: #0f172a;" @bind="selectedSecVariantId" @bind:after="OnSecVariantChanged">
                                            <option value="">-- Seleccionar Variante (@secVariantsList.Count disponibles) --</option>
                                            @foreach (var v in secVariantsList)
                                            {
                                                <option value="@v.id">@v.nombre (@v.default_code)</option>
                                            }
                                        </select>
                                    }
                                </div>

                                <!-- Cantidad Requerida por Unidad Principal -->
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small" style="color: #334155;">Cantidad por Unidad Principal *</label>
                                    <input type="number" step="0.0001" class="form-control fw-bold text-end" style="color: #0f172a;" @bind="newCantidadFactor" placeholder="Ej. 40.0" />
                                </div>

                                <!-- Botón Agregar a Grilla -->
                                <div class="col-12 text-end">
                                    <button type="button" class="btn btn-success fw-bold shadow-sm px-4" @onclick="AddInsumoToDraft">
                                        <i class="bi bi-plus-lg me-1"></i>+ AGREGAR INSUMO A LA LISTA
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECCIÓN 3: GRILLA DE INSUMOS A REGISTRAR -->
                    <div class="card border shadow-sm">
                        <div class="card-header bg-light fw-bold text-dark d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-table me-2 text-primary"></i>Insumos Adicionales Configurados para este Servicio (@draftInsumosList.Count)</span>
                        </div>
                        <div class="card-body p-0">
                            @if (!draftInsumosList.Any())
                            {
                                <div class="text-center py-4 text-secondary fw-semibold">
                                    <i class="bi bi-info-circle me-1"></i>No ha agregado productos ni insumos adicionales a la lista. Seleccione la plantilla y variante arriba y presione <b>+ AGREGAR INSUMO A LA LISTA</b>.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Producto / Insumo Adicional</th>
                                                <th>Código SKU</th>
                                                <th class="text-end">Cantidad Requerida por Unidad Principal</th>
                                                <th class="text-center" style="width: 80px;">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < draftInsumosList.Count; i++)
                                            {
                                                var idx = i;
                                                var item = draftInsumosList[idx];
                                                <tr>
                                                    <td class="fw-bold">@(idx + 1)</td>
                                                    <td class="fw-bold text-success">
                                                        <i class="bi bi-tag-fill me-1"></i>@item.NombreProductoAdicional
                                                    </td>
                                                    <td><span class="badge bg-light text-dark border">@item.CodigoItem</span></td>
                                                    <td class="text-end fw-bold text-success" style="font-size: 14px;">
                                                        @item.CantidadFactor.ToString("N2") <span class="small text-muted font-normal">unidades</span>
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => RemoveInsumoFromDraft(idx)">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light py-3 px-4 d-flex justify-content-end gap-2" style="flex: 0 0 auto;">
                    <button type="button" class="btn btn-secondary btn-md rounded-pill px-4 fw-bold" @onclick="() => showModal = false">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-primary btn-md rounded-pill px-4 fw-bold shadow-sm" @onclick="SaveAllDraftInsumos" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-circle-fill me-1"></i>Guardar Regla de Insumos (@draftInsumosList.Count)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductoAdicionalConfig> itemsList = new();
    private List<Combos> operacionesList = new();
    private List<Combos> productTemplatesList = new();

    private List<OdooVariantDto> mainVariantsList = new();
    private List<OdooVariantDto> secVariantsList = new();
    private List<ProductoAdicionalConfig> draftInsumosList = new();

    private bool loading = true;
    private bool saving = false;
    private bool loadingMainVariants = false;
    private bool loadingSecVariants = false;
    private bool showModal = false;
    private string searchText = "";

    // Form state
    private int selectedOperacionId = 0;
    private string areaCliente = "";
    private int? selectedMainTemplateId;
    private int? selectedMainVariantId;
    private string mainServiceNombre = "";
    private string mainServiceCodigo = "";

    // Secondary item state
    private int? selectedSecTemplateId;
    private int? selectedSecVariantId;
    private string newSecNombre = "";
    private string newSecCodigo = "";
    private decimal newCantidadFactor = 40.0m;

    private IEnumerable<OdooVariantDto> FilteredMainVariants
    {
        get
        {
            if (selectedOperacionId <= 0) return mainVariantsList;

            var opObj = operacionesList.FirstOrDefault(o => o.id == selectedOperacionId);
            string opName = opObj?.nombre ?? "";

            if (string.IsNullOrWhiteSpace(opName)) return mainVariantsList;

            var matched = mainVariantsList.Where(v => IsClientMatch(opName, v.nombre)).ToList();
            return matched.Any() ? matched : mainVariantsList;
        }
    }

    private bool IsClientMatch(string op, string clientAttr)
    {
        if (string.IsNullOrEmpty(op) || string.IsNullOrEmpty(clientAttr)) return false;
        string cleanOp = op.ToLower().Replace(" s.a", "").Replace(" sa", "").Trim();
        string cleanAttr = clientAttr.ToLower().Replace(" s.a", "").Replace(" sa", "").Trim();
        if (cleanOp.Contains(cleanAttr) || cleanAttr.Contains(cleanOp)) return true;
        if (cleanOp.Contains("cerveceria") && cleanAttr.Contains("pepsi")) return true;
        return false;
    }

    private IEnumerable<ProductoAdicionalConfig> FilteredItems => itemsList
        .Where(i => string.IsNullOrWhiteSpace(searchText) ||
                    (i.NombreProductoAdicional != null && i.NombreProductoAdicional.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (i.ServicioNombre != null && i.ServicioNombre.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (i.OperacionNombre != null && i.OperacionNombre.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (i.AreaCliente != null && i.AreaCliente.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var res = await OdooService.GetAllProductosAdicionalesConfig();
            if (res?.Model != null) itemsList = res.Model.ToList();

            var resOp = await OdooService.GetAllCombosHost("Operaciones");
            if (resOp?.Model != null) operacionesList = resOp.Model.ToList();

            var resTmpl = await OdooService.GetProductTemplates();
            if (resTmpl?.Model != null) productTemplatesList = resTmpl.Model.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando productos adicionales: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PrepareCreate()
    {
        selectedOperacionId = 0;
        areaCliente = "";
        selectedMainTemplateId = null;
        selectedMainVariantId = null;
        mainServiceNombre = "";
        mainServiceCodigo = "";

        selectedSecTemplateId = null;
        selectedSecVariantId = null;
        newSecNombre = "";
        newSecCodigo = "";
        newCantidadFactor = 40.0m;

        draftInsumosList.Clear();

        if (!productTemplatesList.Any())
        {
            var resTmpl = await OdooService.GetProductTemplates();
            if (resTmpl?.Model != null) productTemplatesList = resTmpl.Model.ToList();
        }

        showModal = true;
    }

    private async Task OnOperacionChanged()
    {
        StateHasChanged();
    }

    private async Task OnMainTemplateChanged()
    {
        selectedMainVariantId = null;
        mainServiceNombre = "";
        mainServiceCodigo = "";
        mainVariantsList.Clear();

        if (!selectedMainTemplateId.HasValue || selectedMainTemplateId.Value <= 0) return;

        loadingMainVariants = true;
        try
        {
            var res = await OdooService.GetProductVariants(selectedMainTemplateId.Value);
            if (res?.Model != null) mainVariantsList = res.Model.ToList();
        }
        finally
        {
            loadingMainVariants = false;
        }
    }

    private void OnMainVariantChanged()
    {
        if (!selectedMainVariantId.HasValue || selectedMainVariantId.Value <= 0) return;

        var variant = mainVariantsList.FirstOrDefault(v => v.id == selectedMainVariantId.Value);
        if (variant != null)
        {
            var mainTmpl = productTemplatesList.FirstOrDefault(t => t.id == selectedMainTemplateId);
            mainServiceNombre = string.IsNullOrWhiteSpace(variant.nombre) ? (mainTmpl?.nombre ?? "") : variant.nombre;
            mainServiceCodigo = variant.default_code ?? "";
        }
    }

    private async Task OnSecTemplateChanged()
    {
        selectedSecVariantId = null;
        newSecNombre = "";
        newSecCodigo = "";
        secVariantsList.Clear();

        if (!selectedSecTemplateId.HasValue || selectedSecTemplateId.Value <= 0) return;

        loadingSecVariants = true;
        try
        {
            var res = await OdooService.GetProductVariants(selectedSecTemplateId.Value);
            if (res?.Model != null) secVariantsList = res.Model.ToList();
        }
        finally
        {
            loadingSecVariants = false;
        }
    }

    private void OnSecVariantChanged()
    {
        if (!selectedSecVariantId.HasValue || selectedSecVariantId.Value <= 0) return;

        var variant = secVariantsList.FirstOrDefault(v => v.id == selectedSecVariantId.Value);
        if (variant != null)
        {
            var secTmpl = productTemplatesList.FirstOrDefault(t => t.id == selectedSecTemplateId);
            newSecNombre = string.IsNullOrWhiteSpace(variant.nombre) ? (secTmpl?.nombre ?? "") : variant.nombre;
            newSecCodigo = variant.default_code ?? "";
        }
    }

    private void AddInsumoToDraft()
    {
        if (!selectedSecVariantId.HasValue || string.IsNullOrWhiteSpace(newSecNombre))
        {
            JSRuntime.InvokeVoidAsync("alert", "Por favor seleccione la variante del insumo adicional.");
            return;
        }

        if (newCantidadFactor <= 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "Ingrese una cantidad válida mayor a 0.");
            return;
        }

        var opObj = operacionesList.FirstOrDefault(o => o.id == selectedOperacionId);

        var item = new ProductoAdicionalConfig
        {
            OperacionId = selectedOperacionId > 0 ? selectedOperacionId : null,
            OperacionNombre = opObj?.nombre,
            AreaCliente = areaCliente,
            ServicioCodigo = mainServiceCodigo,
            ServicioNombre = string.IsNullOrWhiteSpace(mainServiceNombre) ? "Servicio Principal" : mainServiceNombre,
            TemplateId = selectedSecTemplateId,
            VariantId = selectedSecVariantId,
            NombreProductoAdicional = newSecNombre,
            CodigoItem = newSecCodigo,
            TipoCalculo = "PROPORCIONAL",
            CantidadFactor = newCantidadFactor,
            CostoUnitario = 0.0m,
            Activo = true
        };

        draftInsumosList.Add(item);

        // Reset secondary form selection for next insumo
        selectedSecVariantId = null;
        newSecNombre = "";
        newSecCodigo = "";
    }

    private void RemoveInsumoFromDraft(int index)
    {
        if (index >= 0 && index < draftInsumosList.Count)
        {
            draftInsumosList.RemoveAt(index);
        }
    }

    private async Task SaveAllDraftInsumos()
    {
        if (!draftInsumosList.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debe agregar al menos un insumo adicional a la lista antes de guardar.");
            return;
        }

        saving = true;
        try
        {
            foreach (var item in draftInsumosList)
            {
                await OdooService.SaveProductoAdicionalConfig(item);
            }

            showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error guardando productos adicionales: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private void EditItem(ProductoAdicionalConfig item)
    {
        _ = PrepareCreate();
        selectedOperacionId = item.OperacionId ?? 0;
        areaCliente = item.AreaCliente ?? "";
        mainServiceNombre = item.ServicioNombre;
        mainServiceCodigo = item.ServicioCodigo ?? "";

        draftInsumosList.Add(item);
        showModal = true;
    }

    private async Task DeleteItem(int id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar esta regla de producto adicional?");
        if (!confirm) return;

        try
        {
            await OdooService.DeleteProductoAdicionalConfig(id);
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error eliminando regla: {ex.Message}");
        }
    }
}
