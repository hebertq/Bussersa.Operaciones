@page "/index"
@using System.Security.Claims
@using BsOperaciones.Services
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authenticationStateProvider
@inject ModuloNavigationService ModuloNavService

<div class="bussersa-launcher-wrapper">
    <div class="bussersa-launcher-container">
        @* Decoraciones de fondo sutiles con identidad corporativa Bussersa *@
        <div class="bussersa-bg-glow bussersa-glow-navy"></div>
        <div class="bussersa-bg-glow bussersa-glow-orange"></div>

        <div class="bussersa-content-inner">
            @* Encabezado y Bienvenida (Colores y Marca Bussersa) *@
            <div class="text-center mb-8">
                <div class="d-inline-flex align-center gap-2 px-3 py-1 mb-3 bussersa-brand-pill">
                    <img src="/img/brand/sygnet.png" alt="Bussersa" style="height: 22px;" />
                    <span style="font-size: 0.8rem; font-weight: 800; letter-spacing: 1px; color: #0f172a;">
                        BUSSERSA • SISTEMA OPERATIVO & ERP
                    </span>
                </div>
                <h1 class="bussersa-main-title">
                    ¡Bienvenido, @userName!
                </h1>
                <p class="bussersa-subtitle">
                    Seleccione el módulo al que desea ingresar para comenzar a trabajar
                </p>
            </div>

            @* Buscador de Módulos *@
            <div class="d-flex justify-center mb-8">
                <div class="bussersa-search-box">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Medium" Class="mr-2 text-muted" />
                    <input type="text"
                           class="bussersa-search-input"
                           placeholder="Buscar módulo por nombre o descripción..."
                           @bind="filtroBusqueda"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(filtroBusqueda))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       OnClick="@(() => filtroBusqueda = string.Empty)"
                                       Class="pa-1" />
                    }
                </div>
            </div>

            @* Banner Inteligente de Instalación de la Aplicación (PWA) *@
            <div class="mb-6 mx-auto" style="max-width: 850px;">
                <BotonInstalarPwa EsBanner="true" />
            </div>

            @if (cargando)
            {
                <div class="d-flex flex-column align-center justify-center py-16">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.body2" Class="text-muted">Cargando módulos autorizados...</MudText>
                </div>
            }
            else if (!modulosFiltrados.Any())
            {
                <div class="text-center py-16">
                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a;">No se encontraron módulos</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">
                        @(string.IsNullOrWhiteSpace(filtroBusqueda)
                            ? "No cuenta con módulos asignados en este momento. Contacte a su supervisor o administrador."
                            : $"No se encontraron coincidencias para '{filtroBusqueda}'.")
                    </MudText>
                </div>
            }
            else
            {
                @* Grilla de Módulos Principales (Colores Bussersa y navegación a Inicio de Módulo) *@
                <div class="bussersa-modules-grid">
                    @foreach (var modulo in modulosFiltrados)
                    {
                        <div class="bussersa-module-card" @onclick="@(() => NavegarAModulo(modulo.RutaPrincipal))">
                            <div class="d-flex align-start justify-space-between mb-4">
                                <div class="bussersa-module-icon" style="background: @modulo.ColorFondoGradiente;">
                                    <MudIcon Icon="@modulo.Icono" Style="color: #ffffff; font-size: 2.5rem;" />
                                </div>
                                <span class="bussersa-card-badge">
                                    @modulo.Herramientas.Count funciones
                                </span>
                            </div>

                            <h2 class="bussersa-card-title">@modulo.Titulo</h2>
                            <p class="bussersa-card-desc">@modulo.Subtitulo</p>

                            <div class="bussersa-card-action">
                                <span>Ingresar al módulo</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            </div>
                        </div>
                    }
                </div>
            }

            @* Pie de Página Institucional *@
            <div class="text-center pt-10">
                <MudText Typo="Typo.caption" Class="text-muted" Style="font-size: 0.75rem; letter-spacing: 0.6px; font-weight: 600;">
                    BUSSERSA • SISTEMA INTEGRAL DE GESTIÓN OPERATIVA • ENTORNO SEGURO EN LA NUBE
                </MudText>
            </div>
        </div>
    </div>
</div>

<style>
    /* Contenedor principal con paleta corporativa Bussersa */
    .bussersa-launcher-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 0;
    }

    .bussersa-launcher-container {
        width: 100%;
        max-width: 1200px;
        min-height: calc(100vh - 110px);
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%);
        border-radius: 28px;
        padding: 3rem 2.5rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.8);
        transition: all 0.3s ease;
    }

    .mud-theme-dark .bussersa-launcher-container {
        background: linear-gradient(135deg, #0b0f19 0%, #0f172a 50%, #1e293b 100%) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5) !important;
    }

    /* Brillos de fondo corporativos Bussersa */
    .bussersa-bg-glow {
        position: absolute;
        pointer-events: none;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.4;
        z-index: 1;
    }

    .bussersa-glow-navy {
        width: 450px;
        height: 450px;
        background: #1e3a8a;
        top: -120px;
        right: -100px;
        opacity: 0.12;
    }

    .bussersa-glow-orange {
        width: 400px;
        height: 400px;
        background: #f97316;
        bottom: -100px;
        left: -100px;
        opacity: 0.1;
    }

    .bussersa-content-inner {
        position: relative;
        z-index: 2;
    }

    /* Píldora de marca Bussersa */
    .bussersa-brand-pill {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }
    .mud-theme-dark .bussersa-brand-pill {
        background: #1e293b !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
    .mud-theme-dark .bussersa-brand-pill span {
        color: #f8fafc !important;
    }

    .bussersa-main-title {
        font-family: 'Outfit', sans-serif;
        font-size: 2.4rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .mud-theme-dark .bussersa-main-title {
        color: #f8fafc !important;
    }

    .bussersa-subtitle {
        font-size: 1rem;
        color: #64748b;
        margin-top: 6px;
        font-weight: 500;
    }
    .mud-theme-dark .bussersa-subtitle {
        color: #94a3b8 !important;
    }

    /* Barra de Búsqueda Bussersa */
    .bussersa-search-box {
        display: flex;
        align-items: center;
        width: 100%;
        max-width: 480px;
        background: #ffffff;
        border-radius: 30px;
        padding: 9px 20px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
        transition: all 0.25s ease;
    }
    .bussersa-search-box:focus-within {
        border-color: var(--mud-palette-secondary);
        box-shadow: 0 6px 20px rgba(249, 115, 22, 0.15);
        transform: translateY(-1px);
    }
    .mud-theme-dark .bussersa-search-box {
        background: #1e293b !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
    .mud-theme-dark .bussersa-search-box:focus-within {
        border-color: var(--mud-palette-secondary) !important;
    }

    .bussersa-search-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.95rem;
        font-family: inherit;
        color: #0f172a;
    }
    .mud-theme-dark .bussersa-search-input {
        color: #f8fafc;
    }

    /* Grilla de Módulos */
    .bussersa-modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.8rem;
    }

    @@media (max-width: 600px) {
        .bussersa-modules-grid {
            grid-template-columns: 1fr;
            gap: 1.2rem;
        }
        .bussersa-launcher-container {
            padding: 2rem 1rem;
            border-radius: 20px;
        }
    }

    /* Tarjetas de Módulo */
    .bussersa-module-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.8rem;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
        position: relative;
    }

    .mud-theme-dark .bussersa-module-card {
        background: #1e293b !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3) !important;
    }

    .bussersa-module-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 32px -6px rgba(15, 23, 42, 0.12);
        border-color: var(--mud-palette-secondary);
    }

    .bussersa-module-icon {
        width: 68px;
        height: 68px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        transition: transform 0.28s ease;
    }

    .bussersa-module-card:hover .bussersa-module-icon {
        transform: scale(1.08);
    }

    .bussersa-card-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 10px;
        background: #f1f5f9;
        color: #475569;
        border-radius: 12px;
    }
    .mud-theme-dark .bussersa-card-badge {
        background: rgba(255, 255, 255, 0.08) !important;
        color: #cbd5e1 !important;
    }

    .bussersa-card-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 6px 0;
        letter-spacing: -0.3px;
    }
    .mud-theme-dark .bussersa-card-title {
        color: #f8fafc !important;
    }

    .bussersa-card-desc {
        font-size: 0.88rem;
        color: #64748b;
        margin: 0 0 20px 0;
        line-height: 1.45;
        flex: 1;
    }
    .mud-theme-dark .bussersa-card-desc {
        color: #94a3b8 !important;
    }

    .bussersa-card-action {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 800;
        color: var(--mud-palette-secondary);
        transition: gap 0.2s ease;
    }

    .bussersa-module-card:hover .bussersa-card-action {
        gap: 10px;
    }
</style>

@code {
    private ClaimsPrincipal? user;
    private string userName = "Usuario";
    private bool cargando = true;
    private string filtroBusqueda = string.Empty;

    private List<ModuloAppItem> todosModulos = new();

    private List<ModuloAppItem> modulosFiltrados =>
        string.IsNullOrWhiteSpace(filtroBusqueda)
            ? todosModulos
            : todosModulos.Where(m =>
                m.Titulo.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
                m.Subtitulo.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User;

        if (user?.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "Usuario";
            todosModulos = ModuloNavService.ObtenerModulosPermitidos(user);
            cargando = false;
        }
        else
        {
            navigationManager.NavigateTo("/");
        }
    }

    private void NavegarAModulo(string ruta)
    {
        if (!string.IsNullOrWhiteSpace(ruta))
        {
            navigationManager.NavigateTo(ruta);
        }
    }
}
