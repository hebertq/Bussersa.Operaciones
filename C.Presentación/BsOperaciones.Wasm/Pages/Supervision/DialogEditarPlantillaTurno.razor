@using MudBlazor
@using System.Globalization
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using HostService.Interfaces

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@(IsNuevo ? Icons.Material.Filled.AddAlarm : Icons.Material.Filled.EditCalendar)" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">
                    @(IsNuevo ? "Nuevo Turno / Requerimiento del Cliente" : "Editar Turno del Cliente")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Define el área, puesto, horario, cantidad de recursos y viáticos para el cliente
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @* Cliente *@
                <MudItem xs="12">
                    <MudSelect T="string" Label="Cliente / Operación" @bind-Value="ClienteNombre"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               AnchorOrigin="Origin.BottomCenter"
                               AdornmentIcon="@Icons.Material.Filled.Business" Adornment="Adornment.Start">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Área y Puesto *@
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Área Operativa" @bind-Value="Area"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="Ej. WalMart Importado DCC"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Place" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Puesto / Cargo" @bind-Value="Puesto"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Fecha y Recursos *@
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Fecha (Opcional)" @bind-Value="Fecha"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="dd-MM-yyyy (ej. 19-10-2026)"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" Label="Recursos (Personas requeridas)" @bind-Value="Recursos"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="200"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Group" />
                </MudItem>

                @* Horario *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold text-primary mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Horario del Turno
                    </MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudTextField T="string" Label="Hora Inicio (Entrada)" @bind-Value="HoraInicio"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="09:00" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField T="string" Label="Hora Fin (Salida)" @bind-Value="HoraFin"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="17:00" />
                </MudItem>

                @* Bonos y Viáticos *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold text-primary mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                        Bonos y Viáticos Base
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" Label="Bono BNC (C$)" @bind-Value="BonoBnc"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0"
                                     HideSpinButtons="true" Format="N0"
                                     Adornment="Adornment.Start" AdornmentText="C$" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" Label="Vtco Transporte (C$)" @bind-Value="VtcoTrasp"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0"
                                     HideSpinButtons="true" Format="N0"
                                     Adornment="Adornment.Start" AdornmentText="C$" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" Label="Vtco Alimentación (C$)" @bind-Value="VtcoAlim"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0"
                                     HideSpinButtons="true" Format="N0"
                                     Adornment="Adornment.Start" AdornmentText="C$" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancelar">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Guardar" Disabled="@(string.IsNullOrWhiteSpace(ClienteNombre) || string.IsNullOrWhiteSpace(Area))">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PlantillaClienteTurnoDto ItemOriginal { get; set; } = new();
    [Parameter] public bool IsNuevo { get; set; } = false;
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();
    [Parameter] public string ClienteSeleccionadoInicial { get; set; } = string.Empty;

    private int Id;
    private string ClienteNombre = string.Empty;
    private string Area = string.Empty;
    private string Puesto = "6-Operador de almacen";
    private string Fecha = string.Empty;
    private string HoraInicio = "09:00";
    private string HoraFin = "17:00";
    private int Recursos = 1;
    private decimal BonoBnc = 0;
    private decimal VtcoTrasp = 0;
    private decimal VtcoAlim = 0;

    protected override void OnInitialized()
    {
        if (IsNuevo)
        {
            ClienteNombre = !string.IsNullOrWhiteSpace(ClienteSeleccionadoInicial)
                ? ClienteSeleccionadoInicial
                : (OperacionesDisponibles.FirstOrDefault()?.nombre ?? "WalMart");
            Area = "WalMart Importado DCC";
            Recursos = 1;
            BonoBnc = 70;
        }
        else if (ItemOriginal != null)
        {
            Id = ItemOriginal.Id;
            ClienteNombre = ItemOriginal.ClienteNombre;
            Area = ItemOriginal.Area;
            Puesto = ItemOriginal.Puesto;
            Fecha = ItemOriginal.Fecha;
            HoraInicio = ItemOriginal.HoraInicio;
            HoraFin = ItemOriginal.HoraFin;
            Recursos = ItemOriginal.Recursos;
            BonoBnc = ItemOriginal.BonoBnc;
            VtcoTrasp = ItemOriginal.VtcoTrasp;
            VtcoAlim = ItemOriginal.VtcoAlim;
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        int? operacionId = null;
        var op = OperacionesDisponibles.FirstOrDefault(o => o.nombre.Equals(ClienteNombre, StringComparison.OrdinalIgnoreCase));
        if (op != null) operacionId = op.id;

        var request = new GuardarPlantillaClienteTurnoRequest
        {
            Id = Id,
            OperacionId = operacionId,
            ClienteNombre = ClienteNombre.Trim(),
            Area = Area.Trim(),
            Puesto = Puesto.Trim(),
            Fecha = Fecha?.Trim() ?? string.Empty,
            HoraInicio = string.IsNullOrWhiteSpace(HoraInicio) ? "09:00" : HoraInicio.Trim(),
            HoraFin = string.IsNullOrWhiteSpace(HoraFin) ? "17:00" : HoraFin.Trim(),
            Recursos = Recursos <= 0 ? 1 : Recursos,
            BonoBnc = BonoBnc,
            VtcoTrasp = VtcoTrasp,
            VtcoAlim = VtcoAlim,
            Activo = true
        };

        MudDialog.Close(DialogResult.Ok(request));
    }
}
