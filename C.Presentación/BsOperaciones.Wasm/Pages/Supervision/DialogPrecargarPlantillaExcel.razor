@using MudBlazor
@using System.IO
@using System.Globalization
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using Modelo.Entidades.Entradas.Odoo
@using HostService.Interfaces
@using NPOI.SS.UserModel

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Custom.FileFormats.FileExcel" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Cargar Plantilla de Personal (Excel / Google Sheets)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Importa colaboradores desde la plantilla. Los empleados que ya existan en este cliente serán obviados automáticamente.
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            @* Selector de Cliente *@
            <MudGrid Spacing="2" Class="mb-3" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Cliente / Operación Destino" @bind-Value="clienteSeleccionado"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Required="true"
                               AnchorOrigin="Origin.BottomCenter"
                               AdornmentIcon="@Icons.Material.Filled.Business" Adornment="Adornment.Start">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Formato esperado: <b>Área | Puesto | Fecha | Hora Inicio | Hora Fin | Recursos / IDs | BNC | Vtco Trasp | Vtco Alim</b>
                    </MudText>
                </MudItem>
            </MudGrid>

            @* Pestañas de Carga: Archivo .xlsx o Pegar desde Google Sheets *@
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-2">
                <MudTabPanel Text="Subir Archivo Excel (.xlsx)" Icon="@Icons.Custom.FileFormats.FileExcel">
                    <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="OnExcelFileSelected" Class="d-flex align-center gap-3">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="@procesando">
                                Seleccionar Archivo Excel
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (!string.IsNullOrWhiteSpace(nombreArchivo))
                    {
                        <MudText Typo="Typo.caption" Class="mt-1 d-block text-success fw-bold">
                            Archivo: @nombreArchivo
                        </MudText>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Pegar desde Google Sheets" Icon="@Icons.Material.Filled.ContentPaste">
                    <MudTextField T="string" @bind-Value="textoPegado"
                                  Label="Pegar datos copiados desde Google Sheets"
                                  Placeholder="Pega aquí las celdas copiadas con Ctrl+V..."
                                  Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ProcesarTextoPegado">
                        Procesar Datos Pegados
                    </MudButton>
                </MudTabPanel>
            </MudTabs>

            @if (procesando)
            {
                <div class="d-flex align-center justify-center my-4">
                    <MudProgressCircular Color="Color.Success" Indeterminate="true" Size="Size.Medium" Class="mr-2" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Procesando colaboradores y validando duplicados...</MudText>
                </div>
            }

            @* Resumen de Colaboradores Nuevos vs Obviados *@
            @if (colaboradoresNuevos.Any() || totalObviados > 0)
            {
                <div class="d-flex align-center justify-space-between mt-3 mb-2 flex-wrap gap-2">
                    <MudStack Row="true" Spacing="2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.PersonAdd">
                            Nuevos a Agregar: @colaboradoresNuevos.Count
                        </MudChip>
                        @if (totalObviados > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.PersonRemove">
                                Ya Existentes (Obviados): @totalObviados
                            </MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Total detectados en plantilla: @(colaboradoresNuevos.Count + totalObviados)
                    </MudText>
                </div>

                <div style="max-height: 280px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <MudTable Items="@colaboradoresNuevos" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh Style="width: 80px;">Carnet</MudTh>
                            <MudTh>Colaborador</MudTh>
                            <MudTh>Área</MudTh>
                            <MudTh>Puesto</MudTh>
                            <MudTh Style="width: 110px;">Horario</MudTh>
                            <MudTh Style="width: 80px;">BNC</MudTh>
                            <MudTh Style="width: 80px;">Trasp</MudTh>
                            <MudTh Style="width: 80px;">Alim</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="fw-bold">
                                    #@context.CodigoEmpleado
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="fw-bold">@context.NombreEmpleado</MudText>
                            </MudTd>
                            <MudTd><MudText Typo="Typo.caption">@context.AreaDefault</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.caption">@context.PuestoDefault</MudText></MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                                    @context.HoraEntradaDefault - @context.HoraSalidaDefault
                                </MudChip>
                            </MudTd>
                            <MudTd><MudText Typo="Typo.caption">@(context.BonoBncDefault > 0 ? $"C$ {context.BonoBncDefault:N0}" : "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.caption">@(context.VtcoTraspDefault > 0 ? $"C$ {context.VtcoTraspDefault:N0}" : "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.caption">@(context.VtcoAlimDefault > 0 ? $"C$ {context.VtcoAlimDefault:N0}" : "-")</MudText></MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancelar">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Guardar" Disabled="@(!colaboradoresNuevos.Any() || string.IsNullOrWhiteSpace(clienteSeleccionado) || procesando)">
            Guardar en Grilla (@colaboradoresNuevos.Count colaboradores)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private ISnackbar _snackbar { get; set; } = null!;

    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public string ClienteInicial { get; set; } = string.Empty;
    [Parameter] public List<PersonalClienteItemDto> PersonalExistente { get; set; } = new();
    [Parameter] public List<OdooEmployeeDto> CatalogoOdoo { get; set; } = new();

    private string clienteSeleccionado = string.Empty;
    private string nombreArchivo = string.Empty;
    private string textoPegado = string.Empty;
    private bool procesando = false;

    private List<PersonalClienteItemDto> colaboradoresNuevos = new();
    private int totalObviados = 0;

    protected override void OnInitialized()
    {
        clienteSeleccionado = !string.IsNullOrWhiteSpace(ClienteInicial)
            ? ClienteInicial
            : (OperacionesDisponibles.FirstOrDefault()?.nombre ?? string.Empty);
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        if (string.IsNullOrWhiteSpace(clienteSeleccionado))
        {
            _snackbar.Add("Seleccione el cliente / operación destino.", Severity.Warning);
            return;
        }

        if (!colaboradoresNuevos.Any())
        {
            _snackbar.Add("No hay nuevos colaboradores para agregar (los detectados ya existían en la grilla).", Severity.Info);
            return;
        }

        int? operacionId = null;
        var op = OperacionesDisponibles.FirstOrDefault(o => o.nombre.Equals(clienteSeleccionado, StringComparison.OrdinalIgnoreCase));
        if (op != null) operacionId = op.id;

        foreach (var item in colaboradoresNuevos)
        {
            item.ClienteNombre = clienteSeleccionado.Trim();
            item.OperacionId = operacionId ?? 0;
        }

        MudDialog.Close(DialogResult.Ok(colaboradoresNuevos));
    }

    private async Task OnExcelFileSelected(IBrowserFile file)
    {
        if (file == null) return;
        nombreArchivo = file.Name;
        procesando = true;
        colaboradoresNuevos.Clear();
        totalObviados = 0;
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            IWorkbook workbook = WorkbookFactory.Create(ms);
            IFormulaEvaluator evaluator = workbook.GetCreationHelper().CreateFormulaEvaluator();

            ISheet? sheet = null;
            for (int s = 0; s < workbook.NumberOfSheets; s++)
            {
                var sName = workbook.GetSheetName(s).ToLowerInvariant();
                if (sName.Contains("consolidado") || sName.Contains("plantilla") || sName.Contains("personal") || sName.Contains("horario"))
                {
                    sheet = workbook.GetSheetAt(s);
                    break;
                }
            }
            if (sheet == null) sheet = workbook.GetSheetAt(0);

            // Buscar cabeceras
            IRow? headerRow = null;
            int headerRowIndex = -1;
            for (int r = 0; r <= Math.Min(sheet.LastRowNum, 15); r++)
            {
                var row = sheet.GetRow(r);
                if (row == null) continue;

                for (int c = 0; c < row.LastCellNum; c++)
                {
                    var val = row.GetCell(c)?.ToString()?.Trim()?.ToLowerInvariant() ?? "";
                    if (val.Contains("área") || val.Contains("area") || val.Contains("puesto") || val.Contains("empleado") || val.Contains("carnet"))
                    {
                        headerRow = row;
                        headerRowIndex = r;
                        break;
                    }
                }
                if (headerRow != null) break;
            }

            int colArea = -1, colPuesto = -1, colHoraInicio = -1, colHoraFin = -1, colBnc = -1, colVtcoTrasp = -1, colVtcoAlim = -1, colIds = -1;

            if (headerRow != null)
            {
                for (int c = 0; c < headerRow.LastCellNum; c++)
                {
                    var val = headerRow.GetCell(c)?.ToString()?.Trim()?.ToLowerInvariant() ?? "";
                    if (val == "área" || val == "area") colArea = c;
                    else if (val.Contains("puesto") || val.Contains("cargo")) colPuesto = c;
                    else if (val.Contains("hora inicio") || val.Contains("inicio") || val.Contains("entrada")) colHoraInicio = c;
                    else if (val.Contains("hora fin") || val.Contains("fin") || val.Contains("salida")) colHoraFin = c;
                    else if (val.Contains("bnc")) colBnc = c;
                    else if (val.Contains("trasp") || val.Contains("transporte")) colVtcoTrasp = c;
                    else if (val.Contains("alim") || val.Contains("alimentaci")) colVtcoAlim = c;
                    else if (val.Contains("id") || val.Contains("carnet") || val.Contains("empleado") || val.Contains("colaborador") || val.Contains("código")) colIds = c;
                }
            }

            if (colArea == -1) colArea = 0;
            if (colPuesto == -1) colPuesto = 1;
            if (colHoraInicio == -1) colHoraInicio = 3;
            if (colHoraFin == -1) colHoraFin = 4;
            if (colIds == -1) colIds = 5;
            if (colBnc == -1) colBnc = 6;
            if (colVtcoTrasp == -1) colVtcoTrasp = 7;
            if (colVtcoAlim == -1) colVtcoAlim = 8;

            int startRow = headerRowIndex >= 0 ? headerRowIndex + 1 : 0;
            for (int r = startRow; r <= sheet.LastRowNum; r++)
            {
                var row = sheet.GetRow(r);
                if (row == null) continue;

                string area = ExtraerString(row.GetCell(colArea), evaluator);
                string puesto = ExtraerString(row.GetCell(colPuesto), evaluator);
                string horaInicio = ExtraerHora(row.GetCell(colHoraInicio), evaluator);
                string horaFin = ExtraerHora(row.GetCell(colHoraFin), evaluator);
                string rawIds = colIds >= 0 ? ExtraerString(row.GetCell(colIds), evaluator) : "";
                decimal bnc = colBnc >= 0 ? ExtraerDecimal(row.GetCell(colBnc), evaluator) : 0;
                decimal vtcoTrasp = colVtcoTrasp >= 0 ? ExtraerDecimal(row.GetCell(colVtcoTrasp), evaluator) : 0;
                decimal vtcoAlim = colVtcoAlim >= 0 ? ExtraerDecimal(row.GetCell(colVtcoAlim), evaluator) : 0;

                if (string.IsNullOrWhiteSpace(area) && string.IsNullOrWhiteSpace(puesto) && string.IsNullOrWhiteSpace(rawIds))
                    continue;

                ProcesarFilaColaboradores(area, puesto, horaInicio, horaFin, rawIds, bnc, vtcoTrasp, vtcoAlim);
            }

            _snackbar.Add($"Proceso terminado: {colaboradoresNuevos.Count} nuevos para agregar, {totalObviados} ya existían.", Severity.Success);
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al leer archivo Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private void ProcesarTextoPegado()
    {
        if (string.IsNullOrWhiteSpace(textoPegado))
        {
            _snackbar.Add("Pegue el contenido desde Google Sheets.", Severity.Warning);
            return;
        }

        colaboradoresNuevos.Clear();
        totalObviados = 0;

        var lines = textoPegado.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var line in lines)
        {
            var parts = line.Split('\t');
            if (parts.Length < 2) continue;

            string col0 = parts[0].Trim();
            if (col0.Equals("Área", StringComparison.OrdinalIgnoreCase) || col0.Equals("Area", StringComparison.OrdinalIgnoreCase))
                continue;

            string area = parts.Length > 0 ? parts[0].Trim() : "";
            string puesto = parts.Length > 1 ? parts[1].Trim() : "";
            string horaInicio = parts.Length > 3 ? parts[3].Trim() : "09:00";
            string horaFin = parts.Length > 4 ? parts[4].Trim() : "17:00";
            string rawIds = parts.Length > 5 ? parts[5].Trim() : "";

            decimal bnc = 0;
            if (parts.Length > 6 && decimal.TryParse(parts[6].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal b)) bnc = b;

            decimal vtcoTrasp = 0;
            if (parts.Length > 7 && decimal.TryParse(parts[7].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal vt)) vtcoTrasp = vt;

            decimal vtcoAlim = 0;
            if (parts.Length > 8 && decimal.TryParse(parts[8].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal va)) vtcoAlim = va;

            ProcesarFilaColaboradores(area, puesto, horaInicio, horaFin, rawIds, bnc, vtcoTrasp, vtcoAlim);
        }

        _snackbar.Add($"Texto procesado: {colaboradoresNuevos.Count} nuevos para agregar, {totalObviados} ya existían.", Severity.Success);
    }

    private void ProcesarFilaColaboradores(string area, string puesto, string horaInicio, string horaFin, string rawIds, decimal bnc, decimal vtcoTrasp, decimal vtcoAlim)
    {
        // Separar si vienen múltiples IDs/carnets separados por coma o espacio
        var idTokens = rawIds.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (!idTokens.Any())
        {
            // Si la columna Recursos es un número (ej. "2") sin carnet explícito
            if (int.TryParse(rawIds, out int cantRecursos) && cantRecursos > 0)
            {
                // No trae carnet explícito, se omite o se maneja
                return;
            }
            return;
        }

        foreach (var token in idTokens)
        {
            if (!int.TryParse(token.Trim(), out int codigoEmpleado) || codigoEmpleado <= 0)
                continue;

            // REGLA: Si ya existe en este cliente, obviarlo
            bool yaExiste = PersonalExistente.Any(p =>
                p.CodigoEmpleado == codigoEmpleado &&
                p.ClienteNombre.Equals(clienteSeleccionado, StringComparison.OrdinalIgnoreCase));

            // También verificar si ya lo agregamos en esta misma carga
            bool yaAgregadoEnLote = colaboradoresNuevos.Any(p => p.CodigoEmpleado == codigoEmpleado);

            if (yaExiste || yaAgregadoEnLote)
            {
                totalObviados++;
                continue;
            }

            // Buscar datos del colaborador en Odoo
            var empOdoo = CatalogoOdoo.FirstOrDefault(e =>
                e.CodigoEmpleado.HasValue && e.CodigoEmpleado.Value == codigoEmpleado ||
                e.Id == codigoEmpleado);

            string nombre = empOdoo != null ? empOdoo.Name : $"Colaborador #{codigoEmpleado}";
            string cargoFinal = !string.IsNullOrWhiteSpace(puesto) ? puesto : (empOdoo?.JobTitle ?? "6-Operador de almacen");

            colaboradoresNuevos.Add(new PersonalClienteItemDto
            {
                Id = 0,
                OperacionId = 0,
                ClienteNombre = clienteSeleccionado.Trim(),
                UsuarioSupervisor = string.Empty,
                IdEmpleado = empOdoo?.Id ?? codigoEmpleado,
                CodigoEmpleado = codigoEmpleado,
                NombreEmpleado = nombre,
                AreaDefault = string.IsNullOrWhiteSpace(area) ? "Operaciones" : area,
                PuestoDefault = cargoFinal,
                TurnoDefault = "Diurno",
                HoraEntradaDefault = string.IsNullOrWhiteSpace(horaInicio) ? "09:00" : horaInicio,
                HoraSalidaDefault = string.IsNullOrWhiteSpace(horaFin) ? "17:00" : horaFin,
                TiempoComidaDefault = "1.00",
                VtcoTraspDefault = vtcoTrasp,
                VtcoAlimDefault = vtcoAlim,
                BonoBncDefault = bnc,
                TipoEmpleado = "Permanente",
                Activo = true
            });
        }
    }

    private string ExtraerString(ICell? cell, IFormulaEvaluator evaluator)
    {
        if (cell == null) return string.Empty;
        try
        {
            if (cell.CellType == CellType.Formula)
            {
                var eval = evaluator.Evaluate(cell);
                return eval?.StringValue?.Trim() ?? cell.ToString()?.Trim() ?? string.Empty;
            }
            return cell.ToString()?.Trim() ?? string.Empty;
        }
        catch { return cell.ToString()?.Trim() ?? string.Empty; }
    }

    private string ExtraerHora(ICell? cell, IFormulaEvaluator evaluator)
    {
        if (cell == null) return string.Empty;
        try
        {
            if (cell.CellType == CellType.Numeric)
            {
                double num = cell.NumericCellValue;
                if (num < 1.0)
                {
                    var ts = TimeSpan.FromDays(num);
                    return $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}";
                }
                if (DateUtil.IsCellDateFormatted(cell))
                    return cell.DateCellValue.ToString("HH:mm");
            }
            var s = cell.ToString()?.Trim() ?? string.Empty;
            if (TimeSpan.TryParse(s, out TimeSpan tParsed))
                return $"{(int)tParsed.TotalHours:D2}:{tParsed.Minutes:D2}";
            return s;
        }
        catch { return cell.ToString()?.Trim() ?? string.Empty; }
    }

    private decimal ExtraerDecimal(ICell? cell, IFormulaEvaluator evaluator)
    {
        if (cell == null) return 0;
        try
        {
            if (cell.CellType == CellType.Numeric) return (decimal)cell.NumericCellValue;
            var text = cell.ToString()?.Trim() ?? "";
            text = text.Replace("C$", "").Replace("$", "").Trim();
            if (decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out decimal val)) return val;
            return 0;
        }
        catch { return 0; }
    }
}
