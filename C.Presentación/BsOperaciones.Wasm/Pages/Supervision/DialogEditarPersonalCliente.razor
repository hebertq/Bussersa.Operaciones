@using MudBlazor
@using System.Globalization
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using Modelo.Entidades.Entradas.Odoo
@using HostService.Interfaces

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@(IsNuevo ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.Edit)" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">
                    @(IsNuevo ? "Asignar Colaborador a Cliente" : "Editar Colaborador del Cliente")
                </MudText>
                @if (!IsNuevo && ItemOriginal != null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        <b>#@ItemOriginal.CodigoEmpleado</b> - @ItemOriginal.NombreEmpleado
                    </MudText>
                }
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @if (IsNuevo)
                {
                    <MudItem xs="12">
                        <MudAutocomplete T="OdooEmployeeDto"
                                         Label="Buscar Colaborador en Odoo (Nombre o Carnet #)"
                                         Value="@empleadoSeleccionado"
                                         ValueChanged="@OnEmpleadoOdooSeleccionado"
                                         SearchFunc="@BuscarColaboradorOdoo"
                                         ToStringFunc="@(e => e != null ? $"#{e.CodigoEmpleado ?? e.Id} - {e.Name} ({e.JobTitle ?? "Colaborador"})" : string.Empty)"
                                         ResetValueOnEmptyText="false"
                                         CoerceText="false"
                                         CoerceValue="false"
                                         Dense="true"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         Placeholder="Escribe el nombre o carnet del colaborador..." />
                    </MudItem>

                    <MudItem xs="4">
                        <MudNumericField T="int" @bind-Value="CodigoEmpleado" Label="Carnet / ID" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                    </MudItem>
                    <MudItem xs="8">
                        <MudTextField @bind-Value="NombreEmpleado" Label="Nombre Completo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }

                @* Asignación: Cliente y Supervisor *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Cliente / Operación" Value="ClienteNombre" ValueChanged="@OnClienteChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Supervisor Asignado (Opcional)" @bind-Value="UsuarioSupervisor" 
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                               AnchorOrigin="Origin.BottomCenter"
                               Placeholder="Sin Asignar">
                        @foreach (var u in SupervisoresDisponibles)
                        {
                            <MudSelectItem Value="@u.username">@u.nombres @u.apellidos (@u.username)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Área y Puesto *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Área Operativa" @bind-Value="Area" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var a in areasFiltradas)
                        {
                            <MudSelectItem Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Puesto / Cargo" @bind-Value="Puesto" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var c in CargosDisponibles)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Horario y Tiempo de Comida *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Horario y Tiempo de Comida por Defecto
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Entrada" @bind-Value="HoraEntrada" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="06:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Hora Salida" @bind-Value="HoraSalida" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="14:00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     Label="Tiempo Comida (Horas)" 
                                     @bind-Value="TiempoComida" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     Max="24" 
                                     Step="0.5m" 
                                     Format="0.00" 
                                     Adornment="Adornment.End" 
                                     AdornmentText="hrs" />
                </MudItem>

                @* Viáticos Base *@
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                        Viáticos y Bonos Base
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoTrasp" 
                                     Label="Transporte (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="VtcoAlim" 
                                     Label="Alimentación (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" 
                                     @bind-Value="BonoBnc" 
                                     Label="Bono BNC (C$)" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     HideSpinButtons="true" 
                                     Format="N2" 
                                     Adornment="Adornment.Start" 
                                     AdornmentText="C$" />
                </MudItem>

                @* Tipo de Empleado y Estado *@
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Tipo de Empleado" @bind-Value="TipoEmpleado" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("Permanente")">Permanente (General)</MudSelectItem>
                        <MudSelectItem Value="@("Prestamo")">Préstamo (Temporal)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Checked="Activo" Color="Color.Success" Label="Colaborador Activo" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private IOdooService _odooService { get; set; } = null!;
    [Inject] private ISnackbar _snackbar { get; set; } = null!;

    [Parameter] public PersonalClienteItemDto ItemOriginal { get; set; } = new();
    [Parameter] public bool IsNuevo { get; set; } = false;
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public Dictionary<string, List<string>> AreasPorCliente { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public List<string> CargosDisponibles { get; set; } = new();
    [Parameter] public List<User> SupervisoresDisponibles { get; set; } = new();
    [Parameter] public string ClienteSeleccionadoInicial { get; set; } = string.Empty;
    [Parameter] public string SupervisorSeleccionadoInicial { get; set; } = string.Empty;

    private int IdEmpleado;
    private int CodigoEmpleado;
    private string NombreEmpleado = string.Empty;
    private string ClienteNombre = string.Empty;
    private string UsuarioSupervisor = string.Empty;
    private string Area = string.Empty;
    private string Puesto = "6-Operador de almacen";
    private string Turno = "Diurno";
    private string HoraEntrada = "06:00";
    private string HoraSalida = "14:00";
    private decimal TiempoComida = 1.00m;
    private decimal VtcoTrasp = 0;
    private decimal VtcoAlim = 0;
    private decimal BonoBnc = 0;
    private string TipoEmpleado = "Permanente";
    private bool Activo = true;

    private List<string> areasFiltradas = new();
    private List<OdooEmployeeDto> catalogoOdooCompleto = new();
    private OdooEmployeeDto? empleadoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        if (IsNuevo)
        {
            ClienteNombre = !string.IsNullOrWhiteSpace(ClienteSeleccionadoInicial)
                ? ClienteSeleccionadoInicial
                : (OperacionesDisponibles.FirstOrDefault()?.nombre ?? "WalMart");

            UsuarioSupervisor = SupervisorSeleccionadoInicial;

            try
            {
                var resp = await _odooService.GetAllActiveEmployeesForRotation();
                if (resp?.Model != null)
                {
                    catalogoOdooCompleto = resp.Model.ToList();
                }
            }
            catch { }
        }
        else if (ItemOriginal != null)
        {
            IdEmpleado = ItemOriginal.IdEmpleado;
            CodigoEmpleado = ItemOriginal.CodigoEmpleado;
            NombreEmpleado = ItemOriginal.NombreEmpleado;
            ClienteNombre = ItemOriginal.ClienteNombre;
            UsuarioSupervisor = ItemOriginal.UsuarioSupervisor;
            Area = ItemOriginal.AreaDefault;
            Puesto = ItemOriginal.PuestoDefault;
            Turno = string.IsNullOrWhiteSpace(ItemOriginal.TurnoDefault) ? "Diurno" : ItemOriginal.TurnoDefault;
            HoraEntrada = string.IsNullOrWhiteSpace(ItemOriginal.HoraEntradaDefault) ? "06:00" : ItemOriginal.HoraEntradaDefault;
            HoraSalida = string.IsNullOrWhiteSpace(ItemOriginal.HoraSalidaDefault) ? "14:00" : ItemOriginal.HoraSalidaDefault;
            
            if (decimal.TryParse(ItemOriginal.TiempoComidaDefault?.Replace(',', '.'), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal tc))
                TiempoComida = tc;
            else
                TiempoComida = 1.00m;

            VtcoTrasp = ItemOriginal.VtcoTraspDefault;
            VtcoAlim = ItemOriginal.VtcoAlimDefault;
            BonoBnc = ItemOriginal.BonoBncDefault;
            TipoEmpleado = string.IsNullOrWhiteSpace(ItemOriginal.TipoEmpleado) ? "Permanente" : ItemOriginal.TipoEmpleado;
            Activo = ItemOriginal.Activo;
        }

        ActualizarAreasParaCliente(ClienteNombre);
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        ClienteNombre = nuevoCliente;
        ActualizarAreasParaCliente(nuevoCliente);
        if (!areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            Area = areasFiltradas.FirstOrDefault() ?? "Operaciones";
        }
    }

    private void ActualizarAreasParaCliente(string cliente)
    {
        if (!string.IsNullOrWhiteSpace(cliente) && AreasPorCliente.TryGetValue(cliente, out var areas) && areas.Any())
        {
            areasFiltradas = new List<string>(areas);
        }
        else
        {
            areasFiltradas = new List<string> { "Operaciones", "Bodega", "Rampa", "Almacen", "Distribucion" };
        }

        if (!string.IsNullOrWhiteSpace(Area) && !areasFiltradas.Contains(Area, StringComparer.OrdinalIgnoreCase))
        {
            areasFiltradas.Insert(0, Area);
        }
    }

    private Task<IEnumerable<OdooEmployeeDto>> BuscarColaboradorOdoo(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return Task.FromResult<IEnumerable<OdooEmployeeDto>>(catalogoOdooCompleto.Take(15));

        var query = catalogoOdooCompleto.Where(e =>
            e.Name.Contains(valor, StringComparison.OrdinalIgnoreCase) ||
            (e.CodigoEmpleado.HasValue && e.CodigoEmpleado.Value.ToString().Contains(valor)) ||
            e.Id.ToString().Contains(valor)
        ).Take(20);

        return Task.FromResult(query);
    }

    private void OnEmpleadoOdooSeleccionado(OdooEmployeeDto? emp)
    {
        empleadoSeleccionado = emp;
        if (emp != null)
        {
            IdEmpleado = emp.Id;
            CodigoEmpleado = emp.CodigoEmpleado ?? emp.Id;
            NombreEmpleado = emp.Name;
            if (!string.IsNullOrWhiteSpace(emp.JobTitle))
            {
                var cargoMatch = CargosDisponibles.FirstOrDefault(c => c.Contains(emp.JobTitle, StringComparison.OrdinalIgnoreCase));
                Puesto = cargoMatch ?? emp.JobTitle;
            }
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        if (string.IsNullOrWhiteSpace(NombreEmpleado))
        {
            _snackbar.Add("Ingrese el nombre del colaborador.", Severity.Warning);
            return;
        }

        if (CodigoEmpleado <= 0)
        {
            _snackbar.Add("Ingrese un carnet o código válido.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(ClienteNombre))
        {
            _snackbar.Add("Seleccione el cliente / operación.", Severity.Warning);
            return;
        }

        var opMatch = OperacionesDisponibles.FirstOrDefault(o => o.nombre.Equals(ClienteNombre, StringComparison.OrdinalIgnoreCase));

        var resultado = new PersonalClienteItemDto
        {
            Id = IsNuevo ? 0 : ItemOriginal.Id,
            OperacionId = opMatch?.id ?? 0,
            ClienteNombre = ClienteNombre,
            UsuarioSupervisor = UsuarioSupervisor ?? string.Empty,
            IdEmpleado = IdEmpleado > 0 ? IdEmpleado : CodigoEmpleado,
            CodigoEmpleado = CodigoEmpleado,
            NombreEmpleado = NombreEmpleado.Trim(),
            AreaDefault = Area,
            PuestoDefault = Puesto,
            TurnoDefault = Turno,
            HoraEntradaDefault = HoraEntrada,
            HoraSalidaDefault = HoraSalida,
            TiempoComidaDefault = TiempoComida.ToString("0.00", CultureInfo.InvariantCulture),
            VtcoTraspDefault = VtcoTrasp,
            VtcoAlimDefault = VtcoAlim,
            BonoBncDefault = BonoBnc,
            TipoEmpleado = TipoEmpleado,
            Activo = Activo
        };

        MudDialog.Close(DialogResult.Ok(resultado));
    }
}
