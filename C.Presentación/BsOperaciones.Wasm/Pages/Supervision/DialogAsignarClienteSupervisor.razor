@using MudBlazor
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using HostService.Interfaces

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Asignar Cliente a Supervisor</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Vincular un cliente u operación al usuario supervisor para visualización de personal
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudSelect T="string" Label="Supervisor / Usuario" @bind-Value="usuarioSeleccionado" 
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               Required="true" RequiredError="Debe seleccionar un supervisor"
                               AnchorOrigin="Origin.BottomCenter"
                               AdornmentIcon="@Icons.Material.Filled.SupervisorAccount" Adornment="Adornment.Start">
                        @foreach (var user in SupervisoresDisponibles)
                        {
                            <MudSelectItem Value="@user.username">
                                <div class="d-flex align-center">
                                    <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2" Style="font-size: 11px;">
                                        @(user.username.Length >= 2 ? user.username.Substring(0, 2).ToUpper() : "U")
                                    </MudAvatar>
                                    <div>
                                        <div class="fw-bold">@user.nombres @user.apellidos</div>
                                        <div class="text-secondary" style="font-size: 11px;">
                                            ID: <b>@user.id</b> &bull; @@@user.username &bull; @user.email
                                        </div>
                                    </div>
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="string" Label="Cliente / Operación" @bind-Value="clienteSeleccionado"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               Required="true" RequiredError="Debe seleccionar un cliente"
                               AnchorOrigin="Origin.BottomCenter"
                               AdornmentIcon="@Icons.Material.Filled.Business" Adornment="Adornment.Start">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">
                                <div class="d-flex align-center justify-space-between">
                                    <span>@op.nombre</span>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-2">
                                        ID: @op.id
                                    </MudChip>
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(MensajeError))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">
                            @MensajeError
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancelar">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Guardar" Disabled="@(string.IsNullOrWhiteSpace(usuarioSeleccionado) || string.IsNullOrWhiteSpace(clienteSeleccionado))">
            Asignar Cliente
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public List<User> SupervisoresDisponibles { get; set; } = new();

    [Parameter]
    public List<Combos> OperacionesDisponibles { get; set; } = new();

    [Parameter]
    public string SupervisorInicial { get; set; } = string.Empty;

    [Parameter]
    public string ClienteInicial { get; set; } = string.Empty;

    private string usuarioSeleccionado = string.Empty;
    private string clienteSeleccionado = string.Empty;
    private string MensajeError = string.Empty;

    protected override void OnInitialized()
    {
        usuarioSeleccionado = SupervisorInicial ?? string.Empty;
        clienteSeleccionado = ClienteInicial ?? string.Empty;
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        MensajeError = string.Empty;
        if (string.IsNullOrWhiteSpace(usuarioSeleccionado))
        {
            MensajeError = "Seleccione un supervisor.";
            return;
        }

        if (string.IsNullOrWhiteSpace(clienteSeleccionado))
        {
            MensajeError = "Seleccione un cliente.";
            return;
        }

        var user = SupervisoresDisponibles.FirstOrDefault(u => 
            u.username.Equals(usuarioSeleccionado, StringComparison.OrdinalIgnoreCase) ||
            u.id.ToString() == usuarioSeleccionado ||
            (u.email != null && u.email.Equals(usuarioSeleccionado, StringComparison.OrdinalIgnoreCase)));

        int? operacionId = null;
        var op = OperacionesDisponibles.FirstOrDefault(o => o.nombre.Equals(clienteSeleccionado, StringComparison.OrdinalIgnoreCase));
        if (op != null)
        {
            operacionId = op.id;
        }

        var request = new GuardarSupervisorClienteRequest
        {
            OperacionId = operacionId,
            ClienteNombre = clienteSeleccionado.Trim(),
            UsuarioSupervisor = user != null ? user.username : usuarioSeleccionado.Trim(),
            UsuarioId = user?.id,
            UsuarioEmail = user?.email,
            NombreSupervisor = user != null ? $"{user.nombres} {user.apellidos}".Trim() : string.Empty,
            UsuarioCreacion = string.Empty
        };

        MudDialog.Close(DialogResult.Ok(request));
    }
}
