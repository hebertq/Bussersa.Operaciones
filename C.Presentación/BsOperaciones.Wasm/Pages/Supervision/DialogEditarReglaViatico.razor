@using MudBlazor
@using System.Globalization
@using Modelo.ClasesGenericas
@using HostService.Interfaces

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@(IsNuevo ? Icons.Material.Filled.AddCard : Icons.Material.Filled.EditNote)" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">
                    @(IsNuevo ? "Nueva Regla de Viáticos" : $"Editar Regla de Viáticos #{Item.Id}")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Configuración de pago automático de viáticos (Transporte, Alimentación y Nómina BNC) por horario.
                </MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudGrid Spacing="2">
                @* Cliente y Área *@
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Cliente / Operación *" Value="Item.ClienteNombre" ValueChanged="OnClienteChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Required="true">
                        @foreach (var op in OperacionesDisponibles)
                        {
                            <MudSelectItem Value="@op.nombre">@op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Área Operativa *" @bind-Value="Item.Area"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("*")"><b>* Todas las Áreas (Comodín)</b></MudSelectItem>
                        @foreach (var area in areasFiltradas)
                        {
                            <MudSelectItem Value="@area">@area</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Nombre de la Regla *@
                <MudItem xs="12">
                    <MudTextField T="string" Label="Nombre / Descripción de la Regla *" @bind-Value="Item.NombreRegla"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="Ej: Entrada Madrugada, Turno Nocturno, Salida Tarde" />
                </MudItem>

                @* Criterio de Horario *@
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Condiciones de Horario de Entrada y Salida
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Modo de Criterio Horario" @bind-Value="Item.ModoCriterioHorario"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("EntradaYSalida")">Entrada Y Salida (Debe cumplir ambas)</MudSelectItem>
                        <MudSelectItem Value="@("SoloEntrada")">Solo Entrada (Según hora de ingreso)</MudSelectItem>
                        <MudSelectItem Value="@("SoloSalida")">Solo Salida (Según hora de retiro)</MudSelectItem>
                        <MudSelectItem Value="@("EntradaOSalida")">Entrada O Salida (Cualquiera de las dos)</MudSelectItem>
                        <MudSelectItem Value="@("Siempre")">Siempre (Cualquier horario del cliente/área)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                        @GetExplicacionModoHorario()
                    </MudText>
                </MudItem>

                @if (Item.ModoCriterioHorario != "SoloSalida" && Item.ModoCriterioHorario != "Siempre")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Hora Entrada Desde (HH:mm)" @bind-Value="Item.HoraEntradaDesde"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="04:00 (Opcional)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Hora Entrada Hasta (HH:mm)" @bind-Value="Item.HoraEntradaHasta"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="06:00 (Entra a las 6:00 o antes)" />
                    </MudItem>
                }

                @if (Item.ModoCriterioHorario != "SoloEntrada" && Item.ModoCriterioHorario != "Siempre")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Hora Salida Desde (HH:mm)" @bind-Value="Item.HoraSalidaDesde"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="19:00 (Sale a las 19:00 o después)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Hora Salida Hasta (HH:mm)" @bind-Value="Item.HoraSalidaHasta"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="23:59 (Opcional)" />
                    </MudItem>
                }

                @* Montos y Destino de Pago *@
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1 text-primary">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Class="mr-1" />
                        Montos del Viático y Aplicación (Nómina vs. Caja)
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" Label="Monto Transporte (C$)" @bind-Value="Item.MontoTransporte"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Format="F2" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" Label="Monto Alimentación (C$)" @bind-Value="Item.MontoAlimentacion"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Format="F2" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-2 d-flex flex-column align-center justify-center rounded-lg" Elevation="0"
                              Style="background-color: #f1f5f9; border: 1px dashed #cbd5e1; height: 100%;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Consolidado</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold" Color="Color.Primary">
                            C$ @((Item.MontoTransporte + Item.MontoAlimentacion).ToString("N2"))
                        </MudText>
                    </MudPaper>
                </MudItem>

                @* Switch Nómina BNC *@
                <MudItem xs="12">
                    <MudPaper Class="pa-3 rounded-lg" Elevation="1"
                              Style="@(Item.PagaEnNomina ? "background-color: #f0fdf4; border: 1px solid #86efac;" : "background-color: #f8fafc; border: 1px solid #e2e8f0;")">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@(Item.PagaEnNomina ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.HelpOutline)"
                                             Color="@(Item.PagaEnNomina ? Color.Success : Color.Secondary)" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                        ¿Estos viáticos se pagan en Nómina?
                                    </MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @if (Item.PagaEnNomina)
                                    {
                                        <span class="text-success fw-bold">
                                            SÍ SE PAGA EN NÓMINA: El transporte (C$ @Item.MontoTransporte.ToString("N2")) y la alimentación (C$ @Item.MontoAlimentacion.ToString("N2")) se sumarán en <b>Bono BNC (C$ @((Item.MontoTransporte + Item.MontoAlimentacion).ToString("N2")))</b>.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            NO SE PAGA EN NÓMINA: Se registrarán directamente en las columnas de <b>Transporte</b> y <b>Alimentación</b> para pago de caja o viático semanal.
                                        </span>
                                    }
                                </MudText>
                            </div>
                            <MudSwitch T="bool" @bind-Value="Item.PagaEnNomina" Color="Color.Success" Size="Size.Large" />
                        </MudStack>
                    </MudPaper>
                </MudItem>

                @* Observaciones y Activo *@
                <MudItem xs="12" sm="9">
                    <MudTextField T="string" Label="Observaciones / Justificación" @bind-Value="Item.Observaciones"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                                  Placeholder="Notas aclaratorias sobre esta regla..." />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center">
                    <MudCheckBox T="bool" @bind-Value="Item.Activo" Label="Regla Activa" Color="Color.Primary" Dense="true" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Guardar" Disabled="guardando">
            @(guardando ? "Guardando..." : "Guardar Regla")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ReglaViaticoDto ItemOriginal { get; set; }
    [Parameter] public List<Combos> OperacionesDisponibles { get; set; } = new();
    [Parameter] public List<ClienteAreaDto> CatalogoClienteAreas { get; set; } = new();
    [Parameter] public string UsuarioActual { get; set; } = "Admin";

    private ReglaViaticoDto Item = new();
    private bool IsNuevo => ItemOriginal == null || ItemOriginal.Id <= 0;
    private bool guardando = false;
    private List<string> areasFiltradas = new();

    @inject ISnackbar _snackbar

    protected override void OnInitialized()
    {
        if (ItemOriginal != null)
        {
            Item = new ReglaViaticoDto
            {
                Id = ItemOriginal.Id,
                OperacionId = ItemOriginal.OperacionId,
                ClienteNombre = ItemOriginal.ClienteNombre ?? "",
                Area = string.IsNullOrWhiteSpace(ItemOriginal.Area) ? "*" : ItemOriginal.Area,
                NombreRegla = ItemOriginal.NombreRegla ?? "",
                ModoCriterioHorario = string.IsNullOrWhiteSpace(ItemOriginal.ModoCriterioHorario) ? "EntradaYSalida" : ItemOriginal.ModoCriterioHorario,
                HoraEntradaDesde = ItemOriginal.HoraEntradaDesde,
                HoraEntradaHasta = ItemOriginal.HoraEntradaHasta,
                HoraSalidaDesde = ItemOriginal.HoraSalidaDesde,
                HoraSalidaHasta = ItemOriginal.HoraSalidaHasta,
                MontoTransporte = ItemOriginal.MontoTransporte,
                MontoAlimentacion = ItemOriginal.MontoAlimentacion,
                PagaEnNomina = ItemOriginal.PagaEnNomina,
                Activo = ItemOriginal.Activo,
                Observaciones = ItemOriginal.Observaciones
            };
        }
        else
        {
            Item = new ReglaViaticoDto
            {
                ClienteNombre = OperacionesDisponibles.FirstOrDefault()?.nombre ?? "",
                Area = "*",
                NombreRegla = "Regla de Viáticos General",
                ModoCriterioHorario = "EntradaYSalida",
                HoraEntradaHasta = "06:00",
                HoraSalidaDesde = "19:00",
                MontoTransporte = 0,
                MontoAlimentacion = 0,
                PagaEnNomina = false,
                Activo = true
            };
        }

        ActualizarAreasFiltradas();
    }

    private void OnClienteChanged(string nuevoCliente)
    {
        Item.ClienteNombre = nuevoCliente;
        var op = OperacionesDisponibles.FirstOrDefault(o => string.Equals(o.nombre, nuevoCliente, StringComparison.OrdinalIgnoreCase));
        if (op != null)
        {
            Item.OperacionId = op.id;
        }
        ActualizarAreasFiltradas();
    }

    private void ActualizarAreasFiltradas()
    {
        areasFiltradas.Clear();
        if (string.IsNullOrWhiteSpace(Item.ClienteNombre)) return;

        var areas = CatalogoClienteAreas
            .Where(c => c.Activo && string.Equals(c.ClienteNombre?.Trim(), Item.ClienteNombre.Trim(), StringComparison.OrdinalIgnoreCase))
            .Select(c => c.AreaNombre?.Trim() ?? "")
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a)
            .ToList();

        areasFiltradas = areas;
    }

    private string GetExplicacionModoHorario()
    {
        return Item.ModoCriterioHorario switch
        {
            "SoloEntrada" => "Aplica automáticamente según la hora de entrada del colaborador.",
            "SoloSalida" => "Aplica automáticamente según la hora de salida del colaborador.",
            "EntradaYSalida" => "El colaborador debe cumplir con la condición de entrada Y de salida a la vez.",
            "EntradaOSalida" => "Aplica si el colaborador cumple la condición de entrada O la condición de salida.",
            "Siempre" => "Aplica siempre para los colaboradores de este cliente y área sin importar el horario.",
            _ => "Criterio de horario."
        };
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Guardar()
    {
        if (string.IsNullOrWhiteSpace(Item.ClienteNombre))
        {
            _snackbar.Add("Debe seleccionar un cliente.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(Item.NombreRegla))
        {
            _snackbar.Add("Debe especificar un nombre para la regla.", Severity.Warning);
            return;
        }

        if (Item.MontoTransporte <= 0 && Item.MontoAlimentacion <= 0)
        {
            _snackbar.Add("Debe especificar al menos un monto de Transporte o Alimentación mayor a cero.", Severity.Warning);
            return;
        }

        Item.UsuarioCreacion = UsuarioActual;
        MudDialog.Close(DialogResult.Ok(Item));
    }
}
