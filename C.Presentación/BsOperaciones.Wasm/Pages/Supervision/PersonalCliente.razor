        private List<string> GetAreasParaCliente(string? cliente)
    {
        if (!string.IsNullOrWhiteSpace(cliente) && areasPorCliente.TryGetValue(cliente, out var list) && list.Any())
        {
            return list;
        }
        return new List<string> { "Operaciones", "Bodega", "Rampa", "Almacen", "Distribucion" };
    }

    private string NormalizarDecimalComida(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor)) return "1.00";
        valor = valor.Trim().Replace(',', '.');
        if (decimal.TryParse(valor, NumberStyles.Any, CultureInfo.InvariantCulture, out decimal d))
        {
            return d.ToString("0.00", CultureInfo.InvariantCulture);
        }
        return "1.00";
    }

