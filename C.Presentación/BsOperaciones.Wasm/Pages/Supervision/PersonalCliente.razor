                @* TABLA DETALLADA DE ASIGNACIONES *@
                <MudPaper Elevation="1" Class="rounded-xl overflow-hidden mt-4" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                    <div class="pa-3" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #334155;">
