        @* ----------------------------------------------------
           PESTAÑA 2: ASIGNACIÓN DE CLIENTES A SUPERVISORES
           ---------------------------------------------------- *@
        <MudTabPanel Text="@("Clientes por Supervisor\u00A0\u00A0\u00A0")" Icon="@Icons.Material.Filled.SupervisorAccount" BadgeData="@listaSupervisorClientes.Count" BadgeColor="Color.Warning">

            @* BARRA DE HERRAMIENTAS Y BÚSQUEDA *@
            <MudPaper Class="pa-3 mb-4 rounded-xl" Elevation="1" Style="background: #ffffff; border: 1px solid #e2e8f0;">
                <div class="d-flex flex-column flex-md-row align-start align-md-center justify-space-between gap-3">
                    <div class="d-flex align-center gap-2 flex-grow-1" style="max-width: 480px;">
                        <MudTextField @bind-Value="filtroSupervisorTab" Placeholder="Buscar supervisor o cliente asignado..." 
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
                    </div>

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PersonAddAlt1"
                                   OnClick="@(() => AbrirDialogAsignarConSupervisor())"
                                   Class="rounded-lg text-capitalize shadow-sm">
                            Asignar Cliente a Supervisor
                        </MudButton>

                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Size="Size.Small"
                                       OnClick="@CargarSupervisorClientes" Disabled="@cargandoSupervisores" Title="Recargar asignaciones" />
                    </MudStack>
                </div>
            </MudPaper>

            @if (cargandoSupervisores)
            {
                <div class="d-flex flex-column align-center justify-center my-12">
                    <MudProgressCircular Color="Color.Warning" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">Cargando clientes por supervisor...</MudText>
                </div>
            }
            else if (!SupervisoresAgrupadosFiltrados.Any())
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center rounded-xl my-4 text-center" Elevation="1" Style="border: 2px dashed #cbd5e1; background: #f8fafc;">
                    <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Large" Class="mb-3" Style="background: #e2e8f0;">
                        <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Large" Style="color: #64748b;" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #334155;">No hay asignaciones de clientes a supervisores</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 480px;">
                        Asigna uno o varios clientes a cada supervisor para que puedan gestionar su personal de manera personalizada.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAddAlt1" OnClick="@(() => AbrirDialogAsignarConSupervisor())">
                        Asignar Primer Cliente
                    </MudButton>
                </MudPaper>
            }
            else
            {
                @* VISTA DE TARJETAS AGRUPADAS POR SUPERVISOR *@
                <MudGrid Spacing="3" Class="mb-4">
                    @foreach (var grupo in SupervisoresAgrupadosFiltrados)
                    {
                        var user = supervisoresList.FirstOrDefault(u => u.username.Equals(grupo.Key, StringComparison.OrdinalIgnoreCase));
                        string nombreCompleto = user != null ? $"{user.nombres} {user.apellidos}" : grupo.Key;
                        int totalClientes = grupo.Count();

                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-4 rounded-xl d-flex flex-column justify-space-between h-100" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                                <div>
                                    @* Encabezado de la tarjeta del Supervisor *@
                                    <div class="d-flex align-center justify-space-between mb-3">
                                        <div class="d-flex align-center gap-3">
                                            <MudAvatar Color="Color.Primary" Size="Size.Medium" Style="background-color: #1e3a8a !important; font-weight: bold;">
                                                @(nombreCompleto.Length >= 2 ? nombreCompleto.Substring(0, 2).ToUpper() : "SU")
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a; line-height: 1.2;">
                                                    @nombreCompleto
                                                </MudText>
                                                <div class="d-flex align-center gap-1 flex-wrap mt-1">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Style="font-size: 10px; height: 18px; padding: 0 4px;">
                                                        ID: @(user?.id > 0 ? user.id.ToString() : (grupo.FirstOrDefault()?.UsuarioId?.ToString() ?? "-"))
                                                    </MudChip>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 11px;">
                                                        @@@grupo.Key
                                                    </MudText>
                                                    @{
                                                        string correoCard = !string.IsNullOrWhiteSpace(user?.email) 
                                                            ? user.email 
                                                            : (!string.IsNullOrWhiteSpace(grupo.FirstOrDefault()?.UsuarioEmail) ? grupo.FirstOrDefault()!.UsuarioEmail! : "");
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(correoCard))
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 11px;">
                                                            &bull; @correoCard
                                                        </MudText>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="fw-bold">
                                            @totalClientes @(totalClientes == 1 ? "cliente" : "clientes")
                                        </MudChip>
                                    </div>

                                    <MudDivider Class="my-2" />

                                    @* Lista de Clientes asignados como Chips con botón de desvincular *@
                                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase d-block mb-2" Style="color: #64748b; letter-spacing: 0.5px;">
                                        Clientes Asignados:
                                    </MudText>

                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        @foreach (var asignacion in grupo)
                                        {
                                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium"
                                                     Class="fw-bold" Style="border-color: #93c5fd; background-color: #f0fdf4;"
                                                     Icon="@Icons.Material.Filled.Business"
                                                     OnClose="@(() => EliminarAsignacionSupervisorCliente(asignacion))"
                                                     CloseIcon="@Icons.Material.Filled.Close">
                                                @asignacion.ClienteNombre
                                            </MudChip>
                                        }
                                    </div>
                                </div>

                                @* Botón de acción rápida: Asignar otro cliente al mismo supervisor *@
                                <div class="mt-2 pt-2" style="border-top: 1px dashed #e2e8f0;">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => AbrirDialogAsignarConSupervisor(grupo.Key))"
                                               Class="rounded-lg text-capitalize">
                                        Asignar Otro Cliente
                                    </MudButton>
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                @* TABLA DETALLADA DE ASIGNACIONES *@
                <MudPaper Elevation="1" Class="rounded-xl overflow-hidden mt-4" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                    <div class="pa-3" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #334155;">
                            Detalle de Asignaciones Individuales (@listaSupervisorClientes.Count)
                        </MudText>
                    </div>
                    <MudTable Items="@AsignacionesDetalladasFiltradas" Dense="true" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh Style="font-weight: 700; color: #475569;">Supervisor</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">ID / Usuario</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">Correo</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">Cliente / Operación</MudTh>
                            <MudTh Style="width: 150px; font-weight: 700; color: #475569;">Fecha Asignación</MudTh>
                            <MudTh Style="width: 90px; text-align: center; font-weight: 700; color: #475569;">Acción</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @{
                                    var u = ObtenerSupervisor(context);
                                    string nCompleto = !string.IsNullOrWhiteSpace(context.NombreSupervisor) 
                                        ? context.NombreSupervisor 
                                        : (u != null ? $"{u.nombres} {u.apellidos}" : context.UsuarioSupervisor);
                                }
                                <div class="fw-bold" style="color: #0f172a;">@nCompleto</div>
                            </MudTd>
                            <MudTd>
                                <div class="d-flex align-center gap-1">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Style="font-size: 11px; height: 20px;">
                                        ID: @(context.UsuarioId ?? ObtenerSupervisor(context)?.id ?? 0)
                                    </MudChip>
                                    <span class="text-secondary" style="font-size: 12px;">@@@context.UsuarioSupervisor</span>
                                </div>
                            </MudTd>
                            <MudTd>
                                @{
                                    var supFila = ObtenerSupervisor(context);
                                    string correoMostrar = !string.IsNullOrWhiteSpace(context.UsuarioEmail) 
                                        ? context.UsuarioEmail 
                                        : (!string.IsNullOrWhiteSpace(supFila?.email) ? supFila!.email : "-");
                                }
                                <span class="text-secondary" style="font-size: 12px;">@correoMostrar</span>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Style="background-color: #1e3a8a !important;">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Class="mr-1" />
                                    @context.ClienteNombre
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <span class="text-secondary" style="font-size: 12px;">@(context.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                            </MudTd>
                            <MudTd Class="text-center">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => EliminarAsignacionSupervisorCliente(context))"
                                               Title="Desvincular cliente de supervisor" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>

    </MudTabs>

</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private string currentUserName = string.Empty;
    private bool cargandoPersonal = false;
    private bool cargandoSupervisores = false;
    private bool procesandoExcelDirecto = false;
    private bool guardandoEnBd = false;

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Inicio", href: "/"),
        new BreadcrumbItem("Supervisión", href: null, disabled: true),
        new BreadcrumbItem("Personal por Cliente", href: null, disabled: true)
    };

    // Catálogos
    private List<Combos> operacionesList = new();
    private List<User> supervisoresList = new();
    private List<OdooEmployeeDto> catalogoOdooCompleto = new();
    private Dictionary<string, List<string>> areasPorCliente = new(StringComparer.OrdinalIgnoreCase);
    private List<string> cargosDisponibles = new()
    {
        "6-Operador de almacen",
        "12-Holler",
        "10-Operador de montacarga",
        "5-Supervisor de personal",
        "11-Conductor",
        "3-Asistentes de gerencia",
        "Chequeador",
        "Estibador",
        "Auxiliar de bodega"
    };

    // Datos principales
    private List<PersonalClienteItemDto> listaPersonal = new();
    private List<PersonalClienteItemDto> colaboradoresPendientes = new();
    private List<SupervisorClienteDto> listaSupervisorClientes = new();

    // Modo de vista de la grilla de personal (Odoo switcher)
    private ModoVistaGrilla modoVistaPersonal = ModoVistaGrilla.Operativo;

    // Filtros Pestaña 1 (Personal)
    private string? filtroCliente = "";
    private string? filtroTipoPersonal = "";
    private string? filtroTexto = "";

    // Filtros Pestaña 2 (Supervisores)
    private string? filtroSupervisorTab = "";

    private int TotalSupervisoresConAsignacion =>
        listaSupervisorClientes.Select(x => x.UsuarioSupervisor).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    // Filtro de la grilla combinada (Pendientes de guardar + Guardados en BD)
    private IEnumerable<PersonalClienteItemDto> PersonalFiltrado
    {
        get
        {
            var todos = colaboradoresPendientes.Concat(listaPersonal);

            if (!string.IsNullOrWhiteSpace(filtroCliente))
            {
                todos = todos.Where(p => p.ClienteNombre != null && p.ClienteNombre.Equals(filtroCliente, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filtroTipoPersonal))
            {
                todos = todos.Where(p => p.TipoEmpleado != null && p.TipoEmpleado.Equals(filtroTipoPersonal, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var term = filtroTexto.Trim().ToLowerInvariant();
                todos = todos.Where(p =>
                    p.CodigoEmpleado.ToString().Contains(term) ||
                    (p.NombreEmpleado != null && p.NombreEmpleado.ToLowerInvariant().Contains(term)) ||
                    (p.AreaDefault != null && p.AreaDefault.ToLowerInvariant().Contains(term)) ||
                    (p.PuestoDefault != null && p.PuestoDefault.ToLowerInvariant().Contains(term)) ||
                    (p.UsuarioSupervisor != null && p.UsuarioSupervisor.ToLowerInvariant().Contains(term))
                );
            }

            return todos.OrderBy(p => p.Id > 0 ? 1 : 0).ThenBy(p => p.NombreEmpleado);
        }
    }

    // Filtro de supervisores agrupados
    private IEnumerable<IGrouping<string, SupervisorClienteDto>> SupervisoresAgrupadosFiltrados
    {
        get
        {
            var query = listaSupervisorClientes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroSupervisorTab))
            {
                var term = filtroSupervisorTab.Trim().ToLowerInvariant();
                query = query.Where(a =>
                    a.UsuarioSupervisor.ToLowerInvariant().Contains(term) ||
                    a.ClienteNombre.ToLowerInvariant().Contains(term) ||
                    supervisoresList.Any(u => u.username.Equals(a.UsuarioSupervisor, StringComparison.OrdinalIgnoreCase) && 
                        ($"{u.nombres} {u.apellidos}").ToLowerInvariant().Contains(term))
                );
            }

            return query.GroupBy(a => a.UsuarioSupervisor).OrderBy(g => g.Key);
        }
    }

    // Filtro de tabla detallada de supervisores
    private IEnumerable<SupervisorClienteDto> AsignacionesDetalladasFiltradas
    {
        get
        {
            var query = listaSupervisorClientes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroSupervisorTab))
            {
                var term = filtroSupervisorTab.Trim().ToLowerInvariant();
                query = query.Where(a =>
                    a.UsuarioSupervisor.ToLowerInvariant().Contains(term) ||
                    a.ClienteNombre.ToLowerInvariant().Contains(term) ||
                    supervisoresList.Any(u => u.username.Equals(a.UsuarioSupervisor, StringComparison.OrdinalIgnoreCase) && 
                        ($"{u.nombres} {u.apellidos}").ToLowerInvariant().Contains(term))
                );
            }

            return query.OrderBy(a => a.UsuarioSupervisor).ThenBy(a => a.ClienteNombre);
        }
    }

    private User? ObtenerSupervisor(SupervisorClienteDto dto)
    {
        return supervisoresList.FirstOrDefault(x => 
            (dto.UsuarioId.HasValue && dto.UsuarioId.Value > 0 && x.id == dto.UsuarioId.Value) ||
            x.username.Equals(dto.UsuarioSupervisor, StringComparison.OrdinalIgnoreCase));
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                currentUserName = auth.User?.Identity?.Name ?? "Admin";
            }
        }
        catch { }

        // Carga paralela de los catálogos y asignaciones para evitar retrasos y pantalla vacía
        cargandoSupervisores = true;
        try
        {
            var taskOp = _odooService.GetAllCombosHost("Operaciones");
            var taskUsers = _odooService.GetUsers();
            var taskAreas = _odooService.GetAllClienteAreas();
            var taskSupervisores = _odooService.GetSupervisorClientes();

            await Task.WhenAll(taskOp, taskUsers, taskAreas, taskSupervisores);

            if (taskOp.Result?.Model != null)
            {
                operacionesList = taskOp.Result.Model.OrderBy(o => o.nombre).ToList();
            }

            if (taskUsers.Result?.Model != null)
            {
                supervisoresList = taskUsers.Result.Model.OrderBy(u => u.nombres).ToList();
            }

            if (taskAreas.Result?.Model != null)
            {
                areasPorCliente.Clear();
                foreach (var item in taskAreas.Result.Model.Where(x => x.Activo))
                {
                    var cName = item.ClienteNombre?.Trim();
                    var aName = item.AreaNombre?.Trim();
                    if (!string.IsNullOrWhiteSpace(cName) && !string.IsNullOrWhiteSpace(aName))
                    {
                        if (!areasPorCliente.ContainsKey(cName))
                            areasPorCliente[cName] = new List<string>();

                        if (!areasPorCliente[cName].Contains(aName, StringComparer.OrdinalIgnoreCase))
                            areasPorCliente[cName].Add(aName);
                    }
                }
            }

            if (taskSupervisores.Result?.Model != null)
            {
                listaSupervisorClientes = taskSupervisores.Result.Model.Where(x => x.Activo).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en carga paralela: {ex.Message}");
        }
        finally
        {
            cargandoSupervisores = false;
            StateHasChanged();
        }

        // Carga en background del catálogo grande de empleados de Odoo para autocompletar sin bloquear
        _ = Task.Run(async () =>
        {
            try
            {
                var respOdoo = await _odooService.GetAllActiveEmployeesForRotation();
                if (respOdoo?.Model != null)
                {
                    catalogoOdooCompleto = respOdoo.Model.ToList();
                }
            }
            catch { }
        });
    }

    private async Task CargarPersonal(string cliente = "")
    {
        string cBuscar = !string.IsNullOrWhiteSpace(cliente) ? cliente : (filtroCliente ?? "");
        if (string.IsNullOrWhiteSpace(cBuscar))
        {
            listaPersonal.Clear();
            StateHasChanged();
            return;
        }

        cargandoPersonal = true;
        StateHasChanged();
        try
        {
            var resp = await _odooService.GetPersonalCliente(cliente: cBuscar, usuario: "");
            if (resp?.Model != null)
            {
                listaPersonal = resp.Model.ToList();
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al cargar colaboradores de '{cBuscar}': {ex.Message}", Severity.Error);
        }
        finally
        {
            cargandoPersonal = false;
            StateHasChanged();
        }
    }

    private async Task CargarSupervisorClientes()
    {
        cargandoSupervisores = true;
        try
        {
            var resp = await _odooService.GetSupervisorClientes();
            if (resp?.Model != null)
            {
                listaSupervisorClientes = resp.Model.Where(x => x.Activo).ToList();
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al cargar asignaciones de supervisores: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargandoSupervisores = false;
            StateHasChanged();
        }
    }

    // =========================================================================
    // CAMBIO DE CLIENTE EN EL COMBO
    // =========================================================================
    private async Task OnClienteComboChanged(string nuevoCliente)
    {
        filtroCliente = nuevoCliente;
        if (colaboradoresPendientes.Any() && !string.IsNullOrWhiteSpace(nuevoCliente))
        {
            int? opId = operacionesList.FirstOrDefault(o => o.nombre.Equals(nuevoCliente, StringComparison.OrdinalIgnoreCase))?.id;
            foreach (var item in colaboradoresPendientes)
            {
                item.ClienteNombre = nuevoCliente.Trim();
                item.OperacionId = opId ?? 0;
            }
            _snackbar.Add($"Los {colaboradoresPendientes.Count} colaboradores cargados se asignaron a '{nuevoCliente}'.", Severity.Info);
        }

        if (!string.IsNullOrWhiteSpace(nuevoCliente))
        {
            await CargarPersonal(nuevoCliente);
        }
        else
        {
            listaPersonal.Clear();
        }
        StateHasChanged();
    }

    // =========================================================================
    // CARGA DIRECTA DE ARCHIVO EXCEL A LA GRILLA (SIN MODAL INTERMEDIO)
    // =========================================================================
    private async Task OnArchivoExcelSubidoDirecto(IBrowserFile file)
    {
        if (file == null) return;

        procesandoExcelDirecto = true;
        StateHasChanged();

        try
        {
            // Si el combo de cliente está vacío, pre-seleccionar el primero para que no quede huérfano
            if (string.IsNullOrWhiteSpace(filtroCliente))
            {
                filtroCliente = operacionesList.FirstOrDefault(o => !string.Equals(o.nombre, "Administración", StringComparison.OrdinalIgnoreCase))?.nombre ?? "WalMart";
                _snackbar.Add($"Se asignó el cliente '{filtroCliente}' del combo. Puedes cambiarlo si lo deseas.", Severity.Info);
            }

            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            IWorkbook workbook = WorkbookFactory.Create(ms);
            IFormulaEvaluator evaluator = workbook.GetCreationHelper().CreateFormulaEvaluator();

            ISheet? sheet = null;
            for (int s = 0; s < workbook.NumberOfSheets; s++)
            {
                var sName = workbook.GetSheetName(s).ToLowerInvariant();
                if (sName.Contains("ht") || sName.Contains("consolidado") || sName.Contains("plantilla") || sName.Contains("personal") || sName.Contains("horario"))
                {
                    sheet = workbook.GetSheetAt(s);
                    break;
                }
            }
            if (sheet == null) sheet = workbook.GetSheetAt(0);

            // Buscar fila de encabezados
            IRow? headerRow = null;
            int headerRowIndex = -1;
            for (int r = 0; r <= Math.Min(sheet.LastRowNum, 15); r++)
            {
                var row = sheet.GetRow(r);
                if (row == null) continue;

                for (int c = 0; c < row.LastCellNum; c++)
                {
                    var val = row.GetCell(c)?.ToString()?.Trim()?.ToLowerInvariant() ?? "";
                    if (val.Contains("rea") || val.Contains("puesto") || val.Contains("empleado") || val.Contains("carnet") || val.Contains("id"))
                    {
                        headerRow = row;
                        headerRowIndex = r;
                        break;
                    }
                }
                if (headerRow != null) break;
            }

            int colArea = -1, colPuesto = -1, colHoraInicio = -1, colHoraFin = -1, colBnc = -1, colVtcoTrasp = -1, colVtcoAlim = -1, colIds = -1, colNombre = -1;

            if (headerRow != null)
            {
                for (int c = 0; c < headerRow.LastCellNum; c++)
                {
                    var val = headerRow.GetCell(c)?.ToString()?.Trim()?.ToLowerInvariant() ?? "";
                    if (string.IsNullOrWhiteSpace(val)) continue;

                    if (val.Contains("rea") || val.Contains("area") || val.Contains("área"))
                        colArea = c;
                    else if (val.Contains("salida") || val.Contains("fin"))
                        colHoraFin = c;
                    else if (val.Contains("entrada") || val.Contains("inicio"))
                        colHoraInicio = c;
                    else if (val.Contains("nombre"))
                        colNombre = c;
                    else if (val.Contains("puesto") || val.Contains("cargo"))
                        colPuesto = c;
                    else if (val.Contains("bnc") || val.Contains("bono"))
                        colBnc = c;
                    else if (val.Contains("trasp") || val.Contains("transp"))
                        colVtcoTrasp = c;
                    else if (val.Contains("alim"))
                        colVtcoAlim = c;
                    else if (val.Contains("carnet") || val.Contains("código") || val.Contains("codigo") || val.Contains("recurso") || val.StartsWith("id") || val.EndsWith("id") || val.Contains(" id") || val.Contains("id ") || (val.Contains("empleado") && !val.Contains("nombre")))
                        colIds = c;
                }
            }

            // Fallbacks de columnas para la plantilla HT.xlsx
            if (colIds == -1)
            {
                colArea = 0;
                colIds = 1;
                colNombre = 2;
                colPuesto = 3;
                colHoraInicio = 4;
                colHoraFin = 5;
                colBnc = 6;
                colVtcoTrasp = 7;
                colVtcoAlim = 8;
            }
            if (colArea == -1) colArea = 0;
            if (colPuesto == -1) colPuesto = 3;
            if (colHoraInicio == -1) colHoraInicio = 4;
            if (colHoraFin == -1) colHoraFin = 5;

            int startRow = headerRowIndex >= 0 ? headerRowIndex + 1 : 1;
            int agregados = 0;
            int obviados = 0;

            int? opId = operacionesList.FirstOrDefault(o => o.nombre.Equals(filtroCliente, StringComparison.OrdinalIgnoreCase))?.id;

            for (int r = startRow; r <= sheet.LastRowNum; r++)
            {
                var row = sheet.GetRow(r);
                if (row == null) continue;

                string area = colArea >= 0 ? ExtraerStringExcel(row.GetCell(colArea), evaluator) : "";
                string puesto = colPuesto >= 0 ? ExtraerStringExcel(row.GetCell(colPuesto), evaluator) : "";
                string horaInicio = colHoraInicio >= 0 ? ExtraerHoraExcel(row.GetCell(colHoraInicio), evaluator) : "";
                string horaFin = colHoraFin >= 0 ? ExtraerHoraExcel(row.GetCell(colHoraFin), evaluator) : "";
                string rawIds = colIds >= 0 ? ExtraerStringExcel(row.GetCell(colIds), evaluator) : "";
                string nombre = colNombre >= 0 ? ExtraerStringExcel(row.GetCell(colNombre), evaluator) : "";
                decimal bnc = colBnc >= 0 ? ExtraerDecimalExcel(row.GetCell(colBnc), evaluator) : 0;
                decimal vtcoTrasp = colVtcoTrasp >= 0 ? ExtraerDecimalExcel(row.GetCell(colVtcoTrasp), evaluator) : 0;
                decimal vtcoAlim = colVtcoAlim >= 0 ? ExtraerDecimalExcel(row.GetCell(colVtcoAlim), evaluator) : 0;

                if (string.IsNullOrWhiteSpace(area) && string.IsNullOrWhiteSpace(puesto) && string.IsNullOrWhiteSpace(rawIds))
                    continue;

                var idTokens = rawIds.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries);
                if (!idTokens.Any()) continue;

                foreach (var token in idTokens)
                {
                    if (!int.TryParse(token.Trim(), out int codigoEmpleado) || codigoEmpleado <= 0)
                        continue;

                    // REGLA: Si ya existe en BD para este cliente, obviarlo
                    bool yaExisteEnBd = listaPersonal.Any(p =>
                        p.CodigoEmpleado == codigoEmpleado &&
                        p.ClienteNombre.Equals(filtroCliente, StringComparison.OrdinalIgnoreCase));

                    // REGLA: Si ya está en la lista de pendientes cargados, obviarlo
                    bool yaEnPendientes = colaboradoresPendientes.Any(p => p.CodigoEmpleado == codigoEmpleado);

                    if (yaExisteEnBd || yaEnPendientes)
                    {
                        obviados++;
                        continue;
                    }

                    // Buscar datos del colaborador en Odoo si no viene nombre en el archivo
                    var empOdoo = catalogoOdooCompleto.FirstOrDefault(e =>
                        e.CodigoEmpleado.HasValue && e.CodigoEmpleado.Value == codigoEmpleado ||
                        e.Id == codigoEmpleado);

                    string nombreFinal = !string.IsNullOrWhiteSpace(nombre)
                        ? nombre.Trim()
                        : (empOdoo != null ? empOdoo.Name : $"Colaborador #{codigoEmpleado}");

                    string cargoFinal = !string.IsNullOrWhiteSpace(puesto) ? puesto : (empOdoo?.JobTitle ?? "6-Operador de almacen");

                    colaboradoresPendientes.Add(new PersonalClienteItemDto
                    {
                        Id = 0, // Id = 0 indica pendiente de persistir en BD
                        OperacionId = opId ?? 0,
                        ClienteNombre = filtroCliente.Trim(),
                        UsuarioSupervisor = string.Empty,
                        IdEmpleado = empOdoo?.Id ?? codigoEmpleado,
                        CodigoEmpleado = codigoEmpleado,
                        NombreEmpleado = nombreFinal,
                        AreaDefault = string.IsNullOrWhiteSpace(area) ? "Operaciones" : area,
                        PuestoDefault = cargoFinal,
                        TurnoDefault = "Diurno",
                        HoraEntradaDefault = string.IsNullOrWhiteSpace(horaInicio) ? "09:00" : horaInicio,
                        HoraSalidaDefault = string.IsNullOrWhiteSpace(horaFin) ? "17:00" : horaFin,
                        TiempoComidaDefault = "1.00",
                        VtcoTraspDefault = vtcoTrasp,
                        VtcoAlimDefault = vtcoAlim,
                        BonoBncDefault = bnc,
                        TipoEmpleado = "Permanente",
                        Activo = true
                    });
                    agregados++;
                }
            }

            if (agregados > 0)
            {
                _snackbar.Add($"¡Éxito! Se cargaron {agregados} colaboradores de la plantilla a la grilla ({obviados} ya existían). Presiona 'Guardar en Base de Datos' para confirmar.", Severity.Success);
            }
            else if (obviados > 0)
            {
                _snackbar.Add($"Todos los colaboradores ({obviados}) detectados ya estaban registrados en la base de datos para '{filtroCliente}'.", Severity.Info);
            }
            else
            {
                _snackbar.Add($"No se detectaron filas válidas en el archivo Excel. Verifique que la columna 'ID Empleado' contenga carnets numéricos.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al leer el archivo Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            procesandoExcelDirecto = false;
            StateHasChanged();
        }
    }

    // =========================================================================
    // GUARDAR EN BASE DE DATOS
    // =========================================================================
    private async Task GuardarEnBaseDeDatos()
    {
        if (!colaboradoresPendientes.Any())
        {
            _snackbar.Add("No hay colaboradores pendientes de guardar en la grilla.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(filtroCliente))
        {
            _snackbar.Add("Por favor, seleccione el Cliente / Operación en el combo antes de guardar.", Severity.Warning);
            return;
        }

        guardandoEnBd = true;
        StateHasChanged();

        try
        {
            int? opId = operacionesList.FirstOrDefault(o => o.nombre.Equals(filtroCliente, StringComparison.OrdinalIgnoreCase))?.id;

            foreach (var item in colaboradoresPendientes)
            {
                item.ClienteNombre = filtroCliente.Trim();
                item.OperacionId = opId ?? 0;
                item.UsuarioCreacion = currentUserName;
            }

            var request = new GuardarPersonalClienteRequest
            {
                ClienteNombre = filtroCliente.Trim(),
                UsuarioSupervisor = currentUserName,
                Items = colaboradoresPendientes.ToList()
            };

            var res = await _odooService.SavePersonalClienteMasivo(request);
            if (res?.Respuesta?.ExisteError == false)
            {
                int guardados = colaboradoresPendientes.Count;
                colaboradoresPendientes.Clear();
                _snackbar.Add($"¡Éxito! Se guardaron {guardados} colaboradores en la base de datos para '{filtroCliente}'.", Severity.Success);
                await CargarPersonal();
            }
            else
            {
                _snackbar.Add(res?.Respuesta?.MensajeError ?? "Error al guardar colaboradores en la base de datos.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al guardar en base de datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            guardandoEnBd = false;
            StateHasChanged();
        }
    }

    private void DescartarPendientes()
    {
        colaboradoresPendientes.Clear();
        _snackbar.Add("Se descartaron los colaboradores cargados pendientes de guardar.", Severity.Info);
        StateHasChanged();
    }

