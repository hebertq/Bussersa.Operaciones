    // =========================================================================
    // UTILIDADES DE EXCEL NPOI
    // =========================================================================
    private string ExtraerStringExcel(ICell? cell, IFormulaEvaluator evaluator)
    {
        if (cell == null) return string.Empty;
        try
        {
            if (cell.CellType == CellType.Formula)
            {
                var eval = evaluator.Evaluate(cell);
                if (eval != null)
                {
                    if (eval.CellType == CellType.Numeric)
                    {
                        double v = eval.NumberValue;
                        if (Math.Abs(v - Math.Round(v)) < 0.0001)
                            return Math.Round(v).ToString("0");
                        return v.ToString(CultureInfo.InvariantCulture);
                    }
                    return eval.StringValue?.Trim() ?? cell.ToString()?.Trim() ?? string.Empty;
                }
            }

            if (cell.CellType == CellType.Numeric)
            {
                double v = cell.NumericCellValue;
                if (Math.Abs(v - Math.Round(v)) < 0.0001)
                    return Math.Round(v).ToString("0");
                return v.ToString(CultureInfo.InvariantCulture);
            }

            return cell.ToString()?.Trim() ?? string.Empty;
        }
        catch { return cell.ToString()?.Trim() ?? string.Empty; }
    }

    private string ExtraerHoraExcel(ICell? cell, IFormulaEvaluator evaluator)
    {
        if (cell == null) return string.Empty;
        try
        {
            if (cell.CellType == CellType.Formula)
            {
                var eval = evaluator.Evaluate(cell);
                if (eval != null)
                {
                    if (eval.CellType == CellType.Numeric)
                        return FormatearHoraNumero(eval.NumberValue);
                    return NormalizarHoraTexto(eval.StringValue);
                }
            }
            if (cell.CellType == CellType.Numeric)
            {
                if (DateUtil.IsCellDateFormatted(cell))
                    return cell.DateCellValue.ToString("HH:mm");
                return FormatearHoraNumero(cell.NumericCellValue);
            }
            return NormalizarHoraTexto(cell.ToString());
        }
        catch { return cell.ToString()?.Trim() ?? string.Empty; }
    }

    private string FormatearHoraNumero(double num)
    {
        if (num >= 0 && num <= 1.0)
        {
            int totalMinutes = (int)Math.Round(num * 1440.0);
            int h = (totalMinutes / 60) % 24;
            int m = totalMinutes % 60;
            return $"{h:D2}:{m:D2}";
        }
        try
        {
            var dt = DateTime.FromOADate(num);
            return dt.ToString("HH:mm");
        }
        catch
        {
            return string.Empty;
        }
    }

    private string NormalizarHoraTexto(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return string.Empty;
        s = s.Trim();
        if (double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out double num) && num >= 0 && num <= 1.0)
            return FormatearHoraNumero(num);

        if (DateTime.TryParse(s, out DateTime dt))
            return dt.ToString("HH:mm");
        if (TimeSpan.TryParse(s, out TimeSpan ts))
            return $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}";
        return s;
    }

    private decimal ExtraerDecimalExcel(ICell? cell, IFormulaEvaluator evaluator)
    {
        if (cell == null) return 0;
        try
        {
            if (cell.CellType == CellType.Formula)
            {
                var eval = evaluator.Evaluate(cell);
                if (eval != null && eval.CellType == CellType.Numeric) return (decimal)eval.NumberValue;
            }
            if (cell.CellType == CellType.Numeric) return (decimal)cell.NumericCellValue;
            var text = cell.ToString()?.Trim() ?? "";
            text = text.Replace("C$", "").Replace("$", "").Trim();
            if (decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out decimal val)) return val;
            return 0;
        }
        catch { return 0; }
    }
