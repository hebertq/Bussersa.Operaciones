@page "/admon/supervision/personal-cliente"
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@using NPOI.SS.UserModel
@using System.IO
@using System.Globalization
@attribute [Authorize]
@inject IOdooService _odooService
@inject ISnackbar _snackbar
@inject IDialogService _dialogService
@inject NavigationManager _navigationManager

<PageTitle>Personal por Cliente y Supervisión - BUSSERSA</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-3 mb-8">

    @* ==========================================
       HERO / HEADER SECTION
       ========================================== *@
    <MudPaper Class="pa-4 mb-4 rounded-xl" Elevation="1" Style="background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%); border: 1px solid #e2e8f0;">
        <div class="d-flex flex-column flex-md-row align-start align-md-center justify-space-between gap-3">
            <div class="d-flex align-center gap-3">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="rounded-lg shadow-sm" Style="background-color: #1e3a8a !important;">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <MudBreadcrumbs Items="_breadcrumbItems" Separator=">" Class="pa-0 mb-1" />
                    <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #0f172a;">
                        Personal por Cliente y Asignación de Supervisión
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Configuración de la plantilla de colaboradores por cliente y gestión de múltiples clientes por supervisor.
                    </MudText>
                </div>
            </div>

            <MudStack Row="true" Spacing="2" Class="align-self-end align-self-md-center flex-wrap">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Domain"
                           OnClick="@(() => _navigationManager.NavigateTo("/admon/supervision/areas-cliente"))"
                           Class="rounded-pill px-3 text-capitalize">
                    Áreas del Cliente
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.SupervisorAccount"
                           OnClick="@(() => AbrirDialogAsignarConSupervisor())"
                           Class="rounded-pill px-3 text-capitalize shadow-sm">
                    Asignar Cliente a Supervisor
                </MudButton>
            </MudStack>
        </div>
    </MudPaper>

    @* ==========================================
       TARJETAS DE MÉTRICAS (KPIs)
       ========================================== *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">Colaboradores Totales</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #1e3a8a;">@listaPersonal.Count</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">En plantilla general</MudText>
                </div>
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">En Cliente Actual</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #0284c7;">@PersonalFiltrado.Count()</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(string.IsNullOrWhiteSpace(filtroCliente) ? "Todos los clientes" : filtroCliente)</MudText>
                </div>
                <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">Permanentes</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #059669;">@listaPersonal.Count(p => p.TipoEmpleado == "Permanente" || string.IsNullOrWhiteSpace(p.TipoEmpleado))</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Plantilla fija</MudText>
                </div>
                <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">Supervisores con Clientes</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #d97706;">@TotalSupervisoresConAsignacion</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@listaSupervisorClientes.Count asignaciones totales</MudText>
                </div>
                <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ==========================================
       PESTAÑAS PRINCIPALES DEL MÓDULO
       ========================================== *@
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3 pt-4" Color="Color.Surface">

        @* ----------------------------------------------------
           PESTAÑA 1: PERSONAL POR CLIENTE
           ---------------------------------------------------- *@
        <MudTabPanel Text="Personal por Cliente" Icon="@Icons.Material.Filled.Badge" BadgeData="@listaPersonal.Count" BadgeColor="Color.Primary">

            @* BARRA DE FILTROS Y ACCIONES DIRECTAS *@
            <MudPaper Class="pa-3 mb-4 rounded-xl" Elevation="1" Style="background: #ffffff; border: 1px solid #e2e8f0;">
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="4" md="3">
                        <MudSelect T="string" Label="Cliente / Operación" @bind-Value="filtroCliente" 
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" 
                                   Clearable="true" Placeholder="Todos los Clientes"
                                   AnchorOrigin="Origin.BottomCenter"
                                   AdornmentIcon="@Icons.Material.Filled.Business" Adornment="Adornment.Start">
                            @foreach (var op in operacionesList)
                            {
                                int count = listaPersonal.Count(p => p.ClienteNombre.Equals(op.nombre, StringComparison.OrdinalIgnoreCase));
                                <MudSelectItem Value="@op.nombre">
                                    <div class="d-flex align-center justify-space-between">
                                        <span>@op.nombre</span>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-2">@count</MudChip>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4" md="2">
                        <MudSelect T="string" Label="Tipo" @bind-Value="filtroTipoPersonal"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" 
                                   Clearable="true" Placeholder="Todos"
                                   AnchorOrigin="Origin.BottomCenter"
                                   AdornmentIcon="@Icons.Material.Filled.FilterList" Adornment="Adornment.Start">
                            <MudSelectItem Value="@("Permanente")">Permanente</MudSelectItem>
                            <MudSelectItem Value="@("Prestamo")">Préstamo</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField @bind-Value="filtroTexto" Placeholder="Buscar carnet, colaborador, puesto, área..." 
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
                    </MudItem>

                    <MudItem xs="12" sm="12" md="4" Class="d-flex justify-end gap-2 flex-wrap align-center">
                        @* BOTÓN DE CARGA DIRECTA DE ARCHIVO EXCEL (SIN MODAL) *@
                        <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="OnArchivoExcelSubidoDirecto" Class="d-inline-flex">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           StartIcon="@Icons.Custom.FileFormats.FileExcel"
                                           Disabled="@(cargandoPersonal || procesandoExcelDirecto)"
                                           Class="rounded-lg text-capitalize shadow-sm">
                                    @if (procesandoExcelDirecto)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                                        <span>Procesando archivo...</span>
                                    }
                                    else
                                    {
                                        <span>Cargar Plantilla Excel</span>
                                    }
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@AbrirDialogNuevoColaborador"
                                   Class="rounded-lg text-capitalize shadow-sm">
                            Nuevo Colaborador
                        </MudButton>

                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Size="Size.Small"
                                       OnClick="@CargarPersonal" Disabled="@(cargandoPersonal || procesandoExcelDirecto)" Title="Recargar grilla" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* GRILLA / TABLA DE PERSONAL POR CLIENTE *@
            @if (cargandoPersonal)
            {
                <div class="d-flex flex-column align-center justify-center my-12">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">Cargando grilla de colaboradores...</MudText>
                </div>
            }
            else if (!PersonalFiltrado.Any())
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center rounded-xl my-4 text-center" Elevation="1" Style="border: 2px dashed #cbd5e1; background: #f8fafc;">
                    <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Large" Class="mb-3" Style="background: #e2e8f0;">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" Style="color: #64748b;" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #334155;">No hay colaboradores registrados para este cliente</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 520px;">
                        Selecciona el cliente en el filtro superior y presiona <b>Cargar Plantilla Excel</b> para elegir tu archivo <b>HT.xlsx</b> directamente sin pasos intermedios.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Class="align-center">
                        <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="OnArchivoExcelSubidoDirecto" Class="d-inline-flex">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Custom.FileFormats.FileExcel"
                                           Disabled="@(cargandoPersonal || procesandoExcelDirecto)">
                                    @if (procesandoExcelDirecto)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                                        <span>Procesando...</span>
                                    }
                                    else
                                    {
                                        <span>Cargar Plantilla Excel</span>
                                    }
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@AbrirDialogNuevoColaborador">
                            Nuevo Colaborador
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="1" Class="rounded-xl overflow-hidden" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                    <MudTable Items="@PersonalFiltrado" Dense="true" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh Style="width: 85px; font-weight: 700; color: #475569;">Carnet</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">Colaborador</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">Cliente / Operación</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">Área Operativa</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">Puesto</MudTh>
                            <MudTh Style="width: 130px; font-weight: 700; color: #475569;">Horario</MudTh>
                            <MudTh Style="width: 85px; font-weight: 700; color: #475569;">Comida</MudTh>
                            <MudTh Style="width: 105px; font-weight: 700; color: #475569;">Viáticos</MudTh>
                            <MudTh Style="width: 95px; font-weight: 700; color: #475569;">Tipo</MudTh>
                            <MudTh Style="width: 80px; font-weight: 700; color: #475569;">Estado</MudTh>
                            <MudTh Style="width: 90px; text-align: center; font-weight: 700; color: #475569;">Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="fw-bold rounded-pill" Style="background-color: #1e3a8a !important;">
                                    #@context.CodigoEmpleado
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <div class="d-flex align-center">
                                    <MudAvatar Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Class="mr-2" Style="background: #e0e7ff; color: #1e40af; font-weight: bold; font-size: 11px;">
                                        @(context.NombreEmpleado.Length >= 2 ? context.NombreEmpleado.Substring(0, 2).ToUpper() : "C")
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="fw-bold" Style="color: #0f172a;">@context.NombreEmpleado</MudText>
                                        @if (!string.IsNullOrWhiteSpace(context.UsuarioSupervisor))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Sup: @context.UsuarioSupervisor</MudText>
                                        }
                                    </div>
                                </div>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Class="mr-1" />
                                    @context.ClienteNombre
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2">@context.AreaDefault</MudText>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2">@context.PuestoDefault</MudText>
                            </MudTd>
                            <MudTd>
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Default" Style="font-size: 14px;" />
                                    <span class="fw-bold" style="font-size: 12px; color: #1e293b;">@context.HoraEntradaDefault - @context.HoraSalidaDefault</span>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.TurnoDefault</MudText>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2">@context.TiempoComidaDefault hrs</MudText>
                            </MudTd>
                            <MudTd>
                                @{
                                    decimal totalV = context.VtcoTraspDefault + context.VtcoAlimDefault + context.BonoBncDefault;
                                }
                                @if (totalV > 0)
                                {
                                    <div class="fw-bold text-success" style="font-size: 12px;">C$ @totalV.ToString("N2")</div>
                                    <div class="text-secondary" style="font-size: 10px;">
                                        @(context.VtcoTraspDefault > 0 ? $"T:{context.VtcoTraspDefault:N0} " : "")
                                        @(context.VtcoAlimDefault > 0 ? $"A:{context.VtcoAlimDefault:N0} " : "")
                                        @(context.BonoBncDefault > 0 ? $"B:{context.BonoBncDefault:N0}" : "")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-secondary" style="font-size: 12px;">C$ 0.00</span>
                                }
                            </MudTd>
                            <MudTd>
                                @if (context.TipoEmpleado == "Prestamo")
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Class="rounded-pill">
                                        Préstamo
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Class="rounded-pill">
                                        Permanente
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                @if (context.Activo)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                                        Activo
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">
                                        Inactivo
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd Class="text-center">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary" OnClick="@(() => AbrirDialogEditar(context))">
                                        Editar
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => EliminarColaborador(context))">
                                        Eliminar
                                    </MudMenuItem>
                                </MudMenu>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>

        @* ----------------------------------------------------
           PESTAÑA 2: ASIGNACIÓN DE CLIENTES A SUPERVISORES
           ---------------------------------------------------- *@
        <MudTabPanel Text="Clientes por Supervisor" Icon="@Icons.Material.Filled.SupervisorAccount" BadgeData="@listaSupervisorClientes.Count" BadgeColor="Color.Warning">

            @* BARRA DE HERRAMIENTAS Y BÚSQUEDA *@
            <MudPaper Class="pa-3 mb-4 rounded-xl" Elevation="1" Style="background: #ffffff; border: 1px solid #e2e8f0;">
                <div class="d-flex flex-column flex-md-row align-start align-md-center justify-space-between gap-3">
                    <div class="d-flex align-center gap-2 flex-grow-1" style="max-width: 480px;">
                        <MudTextField @bind-Value="filtroSupervisorTab" Placeholder="Buscar supervisor o cliente asignado..." 
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
                    </div>

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PersonAddAlt1"
                                   OnClick="@(() => AbrirDialogAsignarConSupervisor())"
                                   Class="rounded-lg text-capitalize shadow-sm">
                            Asignar Cliente a Supervisor
                        </MudButton>

                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Size="Size.Small"
                                       OnClick="@CargarSupervisorClientes" Disabled="@cargandoSupervisores" Title="Recargar asignaciones" />
                    </MudStack>
                </div>
            </MudPaper>

            @if (cargandoSupervisores)
            {
                <div class="d-flex flex-column align-center justify-center my-12">
                    <MudProgressCircular Color="Color.Warning" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">Cargando clientes por supervisor...</MudText>
                </div>
            }
            else if (!SupervisoresAgrupadosFiltrados.Any())
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center rounded-xl my-4 text-center" Elevation="1" Style="border: 2px dashed #cbd5e1; background: #f8fafc;">
                    <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Large" Class="mb-3" Style="background: #e2e8f0;">
                        <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Large" Style="color: #64748b;" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #334155;">No hay asignaciones de clientes a supervisores</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 480px;">
                        Asigna uno o varios clientes a cada supervisor para que puedan gestionar su personal de manera personalizada.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAddAlt1" OnClick="@(() => AbrirDialogAsignarConSupervisor())">
                        Asignar Primer Cliente
                    </MudButton>
                </MudPaper>
            }
            else
            {
                @* VISTA DE TARJETAS AGRUPADAS POR SUPERVISOR *@
                <MudGrid Spacing="3" Class="mb-4">
                    @foreach (var grupo in SupervisoresAgrupadosFiltrados)
                    {
                        var user = supervisoresList.FirstOrDefault(u => u.username.Equals(grupo.Key, StringComparison.OrdinalIgnoreCase));
                        string nombreCompleto = user != null ? $"{user.nombres} {user.apellidos}" : grupo.Key;
                        int totalClientes = grupo.Count();

                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-4 rounded-xl d-flex flex-column justify-space-between h-100" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                                <div>
                                    @* Encabezado de la tarjeta del Supervisor *@
                                    <div class="d-flex align-center justify-space-between mb-3">
                                        <div class="d-flex align-center gap-3">
                                            <MudAvatar Color="Color.Primary" Size="Size.Medium" Style="background-color: #1e3a8a !important; font-weight: bold;">
                                                @(nombreCompleto.Length >= 2 ? nombreCompleto.Substring(0, 2).ToUpper() : "SU")
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a; line-height: 1.2;">
                                                    @nombreCompleto
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @@@grupo.Key
                                                </MudText>
                                            </div>
                                        </div>

                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="fw-bold">
                                            @totalClientes @(totalClientes == 1 ? "cliente" : "clientes")
                                        </MudChip>
                                    </div>

