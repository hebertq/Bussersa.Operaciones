@page "/admon/supervision/personal-cliente"
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Admin
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@using NPOI.SS.UserModel
@using System.IO
@using System.Globalization
@using BsOperaciones.Pages.Operaciones.MovimientosPersonal
@attribute [Authorize]
@inject IOdooService _odooService
@inject ISnackbar _snackbar
@inject IDialogService _dialogService
@inject NavigationManager _navigationManager

<PageTitle>Personal por Cliente y Supervisión - BUSSERSA</PageTitle>

<style>
    .tabs-personal-supervisor .mud-tab {
        padding-right: 32px !important;
        padding-left: 20px !important;
        margin-right: 8px !important;
        letter-spacing: 0.3px;
    }
    .tabs-personal-supervisor .mud-tab .mud-tab-badge {
        margin-left: 10px !important;
    }
    .odoo-view-switcher {
        display: inline-flex;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }
    .odoo-view-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 34px;
        border: none;
        background-color: #ffffff;
        color: #475569;
        cursor: pointer;
        padding: 0;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .odoo-view-btn:hover {
        background-color: #f1f5f9;
        color: #0f172a;
    }
    .odoo-view-btn.active {
        background-color: #1e293b !important;
        color: #ffffff !important;
    }
    .odoo-view-btn.active .mud-icon-root {
        fill: #ffffff !important;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-3 mb-8">

    @* ==========================================
       HERO / HEADER SECTION
       ========================================== *@
    <MudPaper Class="pa-4 mb-4 rounded-xl" Elevation="1" Style="background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%); border: 1px solid #e2e8f0;">
        <div class="d-flex flex-column flex-md-row align-start align-md-center justify-space-between gap-3">
            <div class="d-flex align-center gap-3">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="rounded-lg shadow-sm" Style="background-color: #1e3a8a !important;">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <MudBreadcrumbs Items="_breadcrumbItems" Separator=">" Class="pa-0 mb-1" />
                    <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #0f172a;">
                        Personal por Cliente y Asignación de Supervisión
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Carga directa de plantilla Excel a la grilla, selección de cliente y gestión de múltiples clientes por supervisor.
                    </MudText>
                </div>
            </div>

            <MudStack Row="true" Spacing="2" Class="align-self-end align-self-md-center flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.SupervisorAccount"
                           OnClick="@(() => AbrirDialogAsignarConSupervisor())"
                           Class="rounded-pill px-3 text-capitalize shadow-sm">
                    Asignar Cliente a Supervisor
                </MudButton>
            </MudStack>
        </div>
    </MudPaper>

    @* ==========================================
       TARJETAS DE MÉTRICAS (KPIs)
       ========================================== *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">Colaboradores Totales</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #1e3a8a;">@(listaPersonal.Count + colaboradoresPendientes.Count)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">En plantilla y grilla</MudText>
                </div>
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">En Cliente Actual</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #0284c7;">@PersonalFiltrado.Count()</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(string.IsNullOrWhiteSpace(filtroCliente) ? "Todos los clientes" : filtroCliente)</MudText>
                </div>
                <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">Pendientes por Guardar</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #d97706;">@colaboradoresPendientes.Count</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Cargados en grilla</MudText>
                </div>
                <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 rounded-xl d-flex align-center justify-space-between" Elevation="1" Style="border: 1px solid #e2e8f0; background: #ffffff;">
                <div>
                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase" Style="color: #64748b; letter-spacing: 0.5px;">Supervisores con Clientes</MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold my-1" Style="color: #059669;">@TotalSupervisoresConAsignacion</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@listaSupervisorClientes.Count asignaciones totales</MudText>
                </div>
                <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Large" Class="rounded-xl">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Medium" />
                </MudAvatar>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ==========================================
       PESTAÑAS PRINCIPALES DEL MÓDULO
       ========================================== *@
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3 pt-4" Color="Color.Surface" Class="tabs-personal-supervisor">

        @* ----------------------------------------------------
           PESTAÑA 1: PERSONAL POR CLIENTE
           ---------------------------------------------------- *@
        <MudTabPanel Text="@("Personal por Cliente\u00A0\u00A0\u00A0")" Icon="@Icons.Material.Filled.Badge" BadgeData="@(listaPersonal.Count + colaboradoresPendientes.Count)" BadgeColor="Color.Primary">

            @* BANNER DE ALERTA SI HAY REGISTROS PENDIENTES DE GUARDAR EN BASE DE DATOS *@
            @if (colaboradoresPendientes.Any())
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3 rounded-xl shadow-sm d-flex align-center justify-space-between flex-wrap gap-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Medium" />
                        <div>
                            <span class="fw-bold">Hay @colaboradoresPendientes.Count colaborador(es) cargados en la grilla listos para guardar.</span>
                            <div style="font-size: 11px; opacity: 0.9;">
                                Cliente seleccionado: <b>@(string.IsNullOrWhiteSpace(filtroCliente) ? "Sin seleccionar" : filtroCliente)</b>. Puedes cambiar el cliente en el combo y luego presionar Guardar.
                            </div>
                        </div>
                    </div>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@GuardarEnBaseDeDatos"
                                   Disabled="@(guardandoEnBd || string.IsNullOrWhiteSpace(filtroCliente))"
                                   Class="rounded-lg text-capitalize fw-bold">
                            @if (guardandoEnBd)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                                <span>Guardando en BD...</span>
                            }
                            else
                            {
                                <span>Guardar en Base de Datos (@colaboradoresPendientes.Count)</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small"
                                   OnClick="@DescartarPendientes"
                                   Disabled="@guardandoEnBd"
                                   Class="rounded-lg text-capitalize">
                            Descartar
                        </MudButton>
                    </MudStack>
                </MudAlert>
            }

            @* BARRA DE FILTROS Y ACCIONES DIRECTAS *@
            <MudPaper Class="pa-3 mb-4 rounded-xl" Elevation="1" Style="background: #ffffff; border: 1px solid #e2e8f0;">
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="4" md="3">
                        <MudSelect T="string" Label="Cliente / Operación" Value="filtroCliente" ValueChanged="OnClienteComboChanged"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" 
                                   Clearable="true" Placeholder="Seleccione de la lista..."
                                   AnchorOrigin="Origin.BottomCenter"
                                   AdornmentIcon="@Icons.Material.Filled.Business" Adornment="Adornment.Start">
                            @foreach (var op in operacionesList)
                            {
                                int count = listaPersonal.Count(p => p.ClienteNombre.Equals(op.nombre, StringComparison.OrdinalIgnoreCase))
                                            + colaboradoresPendientes.Count(p => p.ClienteNombre.Equals(op.nombre, StringComparison.OrdinalIgnoreCase));
                                <MudSelectItem Value="@op.nombre">
                                    <div class="d-flex align-center justify-space-between">
                                        <span>@op.nombre</span>
                                        @if (count > 0)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-2">@count</MudChip>
                                        }
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4" md="2">
                        <MudSelect T="string" Label="Tipo" @bind-Value="filtroTipoPersonal"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" 
                                   Clearable="true" Placeholder="Todos"
                                   AnchorOrigin="Origin.BottomCenter"
                                   AdornmentIcon="@Icons.Material.Filled.FilterList" Adornment="Adornment.Start">
                            <MudSelectItem Value="@("Permanente")">Permanente</MudSelectItem>
                            <MudSelectItem Value="@("Prestamo")">Préstamo</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField @bind-Value="filtroTexto" Placeholder="Buscar carnet, colaborador, puesto, área..." 
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
                    </MudItem>

                    <MudItem xs="12" sm="12" md="4" Class="d-flex justify-end gap-2 flex-wrap align-center">
                        @* Control de Vistas Estilo Odoo (4 Vistas) *@
                        <div class="odoo-view-switcher" role="group" aria-label="Cambiar modo de vista">
                            <MudTooltip Text="Vista Horarios, Comida & Viáticos" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPersonal == ModoVistaGrilla.Operativo ? "active" : "")" 
                                        @onclick="@(() => modoVistaPersonal = ModoVistaGrilla.Operativo)"
                                        title="Vista Horarios, Comida & Viáticos">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Ubicación & Puesto (Cliente, Área, Cargo)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPersonal == ModoVistaGrilla.Ubicacion ? "active" : "")" 
                                        @onclick="@(() => modoVistaPersonal = ModoVistaGrilla.Ubicacion)"
                                        title="Vista Ubicación & Puesto">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tabla Completa (Todas las columnas)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPersonal == ModoVistaGrilla.Completo ? "active" : "")" 
                                        @onclick="@(() => modoVistaPersonal = ModoVistaGrilla.Completo)"
                                        title="Vista Tabla Completa">
                                    <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Vista Tarjetas (Kanban estilo Odoo)" Arrow="true" Placement="Placement.Top">
                                <button type="button" 
                                        class="odoo-view-btn @(modoVistaPersonal == ModoVistaGrilla.Tarjetas ? "active" : "")" 
                                        @onclick="@(() => modoVistaPersonal = ModoVistaGrilla.Tarjetas)"
                                        title="Vista Tarjetas (Kanban)">
                                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                        </div>
                        @* BOTÓN DE CARGA DIRECTA DE ARCHIVO EXCEL A LA GRILLA (SIN MODAL) *@
                        <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="OnArchivoExcelSubidoDirecto" Class="d-inline-flex">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           StartIcon="@Icons.Custom.FileFormats.FileExcel"
                                           Disabled="@(cargandoPersonal || procesandoExcelDirecto || guardandoEnBd)"
                                           Class="rounded-lg text-capitalize shadow-sm">
                                    @if (procesandoExcelDirecto)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                                        <span>Cargando en Grilla...</span>
                                    }
                                    else
                                    {
                                        <span>Cargar Plantilla Excel</span>
                                    }
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @* BOTÓN GUARDAR EN BASE DE DATOS (HABILITADO SI HAY PENDIENTES) *@
                        @if (colaboradoresPendientes.Any())
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="@GuardarEnBaseDeDatos"
                                       Disabled="@(guardandoEnBd || string.IsNullOrWhiteSpace(filtroCliente))"
                                       Class="rounded-lg text-capitalize shadow-sm fw-bold">
                                @if (guardandoEnBd)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar en BD (@colaboradoresPendientes.Count)</span>
                                }
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@AbrirDialogNuevoColaborador"
                                   Class="rounded-lg text-capitalize">
                            Nuevo
                        </MudButton>

                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => CargarPersonal())" Disabled="@(cargandoPersonal || procesandoExcelDirecto || guardandoEnBd)" Title="Recargar grilla" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* GRILLA / TABLA DE PERSONAL POR CLIENTE *@
            @if (cargandoPersonal)
            {
                <div class="d-flex flex-column align-center justify-center my-12">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">Cargando grilla de colaboradores...</MudText>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(filtroCliente) && !colaboradoresPendientes.Any())
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center rounded-xl my-4 text-center" Elevation="1" Style="border: 2px dashed #93c5fd; background: #f8fafc;">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large" Class="mb-3" Style="background: #eff6ff;">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Style="color: #2563eb;" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1e3a8a;">Seleccione un Cliente de la lista</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 520px;">
                        Seleccione un cliente u operación en el combo superior para cargar y gestionar sus colaboradores base, o suba una plantilla de Excel directamente a la grilla.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Class="align-center">
                        <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="OnArchivoExcelSubidoDirecto" Class="d-inline-flex">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Custom.FileFormats.FileExcel">
                                    <span>Cargar Plantilla Excel</span>
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </MudStack>
                </MudPaper>
            }
            else if (!PersonalFiltrado.Any())
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center rounded-xl my-4 text-center" Elevation="1" Style="border: 2px dashed #cbd5e1; background: #f8fafc;">
                    <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Large" Class="mb-3" Style="background: #e2e8f0;">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" Style="color: #64748b;" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #334155;">No hay colaboradores en la grilla para '@filtroCliente'</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 520px;">
                        Presiona <b>Cargar Plantilla Excel</b> para subir tu archivo <b>HT.xlsx</b> directamente a la grilla, o registra uno nuevo con <b>Nuevo Colaborador</b>.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Class="align-center">
                        <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="OnArchivoExcelSubidoDirecto" Class="d-inline-flex">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Custom.FileFormats.FileExcel"
                                           Disabled="@(cargandoPersonal || procesandoExcelDirecto || guardandoEnBd)">
                                    @if (procesandoExcelDirecto)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Color="Color.Surface" />
                                        <span>Cargando en Grilla...</span>
                                    }
                                    else
                                    {
                                        <span>Cargar Plantilla Excel</span>
                                    }
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@AbrirDialogNuevoColaborador">
                            Nuevo Colaborador
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
            else if (modoVistaPersonal == ModoVistaGrilla.Tarjetas)
            {
                @* VISTA TARJETAS (KANBAN TOUCH-FRIENDLY PARA MI PERSONAL) *@
                <MudGrid Spacing="2" Class="mb-4">
                    @foreach (var context in PersonalFiltrado)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudCard Elevation="2" Style="@($"border-radius: 12px; border-left: 5px solid {(context.Id == 0 ? "#f59e0b" : "#2563eb")};")">
                                <MudCardHeader Class="pa-2 pb-1">
                                    <CardHeaderContent>
                                        <div class="d-flex align-center gap-1">
                                            <MudChip T="string" Color="@(context.Id == 0 ? Color.Warning : Color.Dark)" Variant="Variant.Filled" Size="Size.Small" Class="px-1 font-monospace fw-bold" Style="height: 20px; font-size: 0.72rem; min-width: 44px; justify-content: center;">
                                                #@context.CodigoEmpleado
                                            </MudChip>
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-truncate" Style="max-width: 170px; flex-grow: 1;" Title="@context.NombreEmpleado">
                                                @context.NombreEmpleado
                                            </MudText>
                                        </div>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                       Color="Color.Primary" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => AbrirDialogEditar(context))" 
                                                       Title="Editar colaborador" />
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => EliminarColaborador(context))" 
                                                       Title="Eliminar colaborador" />
                                    </CardHeaderActions>
                                </MudCardHeader>

                                <MudCardContent Class="pa-2 pt-0 pb-2">
                                    @* Ubicación: Cliente, Área, Cargo *@
                                    <div class="d-flex flex-column gap-1 mb-2 text-secondary" style="font-size: 0.75rem;">
                                        <div class="d-flex align-center gap-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="font-size: 0.85rem;" Color="Color.Primary" />
                                            <b class="text-primary text-truncate">@context.ClienteNombre</b>
                                            <span>•</span>
                                            <span class="text-truncate">@context.AreaDefault</span>
                                        </div>
                                        <div class="text-truncate text-muted pl-3">
                                            @context.PuestoDefault
                                        </div>
                                    </div>

                                    @* Horario y Tiempo de Comida *@
                                    <div class="d-flex align-center justify-space-between pt-1 border-top" style="font-size: 0.75rem;">
                                        <div class="d-flex align-center gap-1 font-monospace">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Style="font-size: 0.85rem;" Color="Color.Default" />
                                            <input type="text" value="@context.HoraEntradaDefault" 
                                                   @onchange="@(async (ChangeEventArgs e) => { context.HoraEntradaDefault = e.Value?.ToString() ?? "06:00"; await GuardarItemPersonalInline(context); })" 
                                                   style="width: 44px; border: 1px solid #ced4da; border-radius: 4px; padding: 1px; font-size: 0.75rem; text-align: center;" 
                                                   title="Hora Entrada (ej. 06:00)" />
                                            <span>-</span>
                                            <input type="text" value="@context.HoraSalidaDefault" 
