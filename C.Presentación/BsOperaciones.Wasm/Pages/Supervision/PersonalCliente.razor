                            <MudTh Style="font-weight: 700; color: #475569;">Usuario</MudTh>
                            <MudTh Style="font-weight: 700; color: #475569;">Cliente / Operación</MudTh>
                            <MudTh Style="width: 150px; font-weight: 700; color: #475569;">Fecha Asignación</MudTh>
                            <MudTh Style="width: 90px; text-align: center; font-weight: 700; color: #475569;">Acción</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @{
                                    var u = supervisoresList.FirstOrDefault(x => x.username.Equals(context.UsuarioSupervisor, StringComparison.OrdinalIgnoreCase));
                                }
                                <div class="fw-bold" style="color: #0f172a;">@(u != null ? $"{u.nombres} {u.apellidos}" : context.UsuarioSupervisor)</div>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">
                                    @@@context.UsuarioSupervisor
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Style="background-color: #1e3a8a !important;">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Class="mr-1" />
                                    @context.ClienteNombre
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <span class="text-secondary" style="font-size: 12px;">@(context.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                            </MudTd>
                            <MudTd Class="text-center">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => EliminarAsignacionSupervisorCliente(context))"
                                               Title="Desvincular cliente de supervisor" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>

    </MudTabs>

</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private string currentUserName = string.Empty;
    private bool cargandoPersonal = false;
    private bool cargandoSupervisores = false;
    private bool procesandoExcelDirecto = false;

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Inicio", href: "/"),
        new BreadcrumbItem("Supervisión", href: null, disabled: true),
        new BreadcrumbItem("Personal por Cliente", href: null, disabled: true)
    };

    // Catálogos
    private List<Combos> operacionesList = new();
    private List<User> supervisoresList = new();
    private List<OdooEmployeeDto> catalogoOdooCompleto = new();
    private Dictionary<string, List<string>> areasPorCliente = new(StringComparer.OrdinalIgnoreCase);
    private List<string> cargosDisponibles = new()
    {
        "6-Operador de almacen",
        "12-Holler",
        "10-Operador de montacarga",
        "5-Supervisor de personal",
        "11-Conductor",
        "3-Asistentes de gerencia",
        "Chequeador",
        "Estibador",
        "Auxiliar de bodega"
    };

    // Datos principales
    private List<PersonalClienteItemDto> listaPersonal = new();
    private List<SupervisorClienteDto> listaSupervisorClientes = new();

    // Filtros Pestaña 1 (Personal)
    private string? filtroCliente = "";
    private string? filtroTipoPersonal = "";
    private string? filtroTexto = "";

    // Filtros Pestaña 2 (Supervisores)
    private string? filtroSupervisorTab = "";

    private int TotalSupervisoresConAsignacion =>
        listaSupervisorClientes.Select(x => x.UsuarioSupervisor).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    // Filtro de la grilla de personal
    private IEnumerable<PersonalClienteItemDto> PersonalFiltrado
    {
        get
        {
            var query = listaPersonal.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroCliente))
            {
                query = query.Where(p => p.ClienteNombre != null && p.ClienteNombre.Equals(filtroCliente, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filtroTipoPersonal))
            {
                query = query.Where(p => p.TipoEmpleado != null && p.TipoEmpleado.Equals(filtroTipoPersonal, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var term = filtroTexto.Trim().ToLowerInvariant();
                query = query.Where(p =>
                    p.CodigoEmpleado.ToString().Contains(term) ||
                    (p.NombreEmpleado != null && p.NombreEmpleado.ToLowerInvariant().Contains(term)) ||
                    (p.AreaDefault != null && p.AreaDefault.ToLowerInvariant().Contains(term)) ||
                    (p.PuestoDefault != null && p.PuestoDefault.ToLowerInvariant().Contains(term)) ||
                    (p.UsuarioSupervisor != null && p.UsuarioSupervisor.ToLowerInvariant().Contains(term))
                );
            }

            return query.OrderBy(p => p.ClienteNombre).ThenBy(p => p.NombreEmpleado);
        }
    }

    // Filtro de supervisores agrupados
    private IEnumerable<IGrouping<string, SupervisorClienteDto>> SupervisoresAgrupadosFiltrados
    {
        get
        {
            var query = listaSupervisorClientes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroSupervisorTab))
            {
                var term = filtroSupervisorTab.Trim().ToLowerInvariant();
                query = query.Where(a =>
                    a.UsuarioSupervisor.ToLowerInvariant().Contains(term) ||
                    a.ClienteNombre.ToLowerInvariant().Contains(term) ||
                    supervisoresList.Any(u => u.username.Equals(a.UsuarioSupervisor, StringComparison.OrdinalIgnoreCase) && 
                        ($"{u.nombres} {u.apellidos}").ToLowerInvariant().Contains(term))
                );
            }

            return query.GroupBy(a => a.UsuarioSupervisor).OrderBy(g => g.Key);
        }
    }

    // Filtro de tabla detallada de supervisores
    private IEnumerable<SupervisorClienteDto> AsignacionesDetalladasFiltradas
    {
        get
        {
            var query = listaSupervisorClientes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroSupervisorTab))
            {
                var term = filtroSupervisorTab.Trim().ToLowerInvariant();
                query = query.Where(a =>
                    a.UsuarioSupervisor.ToLowerInvariant().Contains(term) ||
                    a.ClienteNombre.ToLowerInvariant().Contains(term) ||
                    supervisoresList.Any(u => u.username.Equals(a.UsuarioSupervisor, StringComparison.OrdinalIgnoreCase) && 
                        ($"{u.nombres} {u.apellidos}").ToLowerInvariant().Contains(term))
                );
            }

            return query.OrderBy(a => a.UsuarioSupervisor).ThenBy(a => a.ClienteNombre);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                currentUserName = auth.User?.Identity?.Name ?? "Admin";
            }
        }
        catch { }

        await CargarCatalogos();
        await Task.WhenAll(CargarPersonal(), CargarSupervisorClientes());
    }

    private async Task CargarCatalogos()
    {
        try
        {
            var respOp = await _odooService.GetAllCombosHost("Operaciones");
            if (respOp?.Model != null)
            {
                operacionesList = respOp.Model.OrderBy(o => o.nombre).ToList();
            }

            var respUsers = await _odooService.GetUsers();
            if (respUsers?.Model != null)
            {
                supervisoresList = respUsers.Model.OrderBy(u => u.nombres).ToList();
            }

            var respAreas = await _odooService.GetAllClienteAreas();
            if (respAreas?.Model != null)
            {
                areasPorCliente.Clear();
                foreach (var item in respAreas.Model.Where(x => x.Activo))
                {
                    var cName = item.ClienteNombre?.Trim();
                    var aName = item.AreaNombre?.Trim();
                    if (!string.IsNullOrWhiteSpace(cName) && !string.IsNullOrWhiteSpace(aName))
                    {
                        if (!areasPorCliente.ContainsKey(cName))
                            areasPorCliente[cName] = new List<string>();

                        if (!areasPorCliente[cName].Contains(aName, StringComparer.OrdinalIgnoreCase))
                            areasPorCliente[cName].Add(aName);
                    }
                }
            }

            try
            {
                var respOdoo = await _odooService.GetAllActiveEmployeesForRotation();
                if (respOdoo?.Model != null)
                {
                    catalogoOdooCompleto = respOdoo.Model.ToList();
                }
            }
            catch { }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando catálogos: {ex.Message}");
        }
    }

    private async Task CargarPersonal()
    {
        cargandoPersonal = true;
        try
        {
            var resp = await _odooService.GetPersonalCliente(cliente: "", usuario: "");
            if (resp?.Model != null)
            {
                listaPersonal = resp.Model.ToList();
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al cargar la grilla de personal: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargandoPersonal = false;
            StateHasChanged();
        }
    }

    private async Task CargarSupervisorClientes()
    {
        cargandoSupervisores = true;
        try
        {
            var resp = await _odooService.GetSupervisorClientes();
            if (resp?.Model != null)
            {
                listaSupervisorClientes = resp.Model.Where(x => x.Activo).ToList();
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al cargar asignaciones de supervisores: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargandoSupervisores = false;
            StateHasChanged();
        }
    }

    // =========================================================================
    // CARGA DIRECTA DE ARCHIVO EXCEL (SIN MODAL INTERMEDIO)
    // =========================================================================
    private async Task OnArchivoExcelSubidoDirecto(IBrowserFile file)
    {
        if (file == null) return;

        // Se requiere tener seleccionado el cliente en el filtro para asignar
        if (string.IsNullOrWhiteSpace(filtroCliente))
        {
            _snackbar.Add("Por favor, seleccione primero el Cliente / Operación en el filtro antes de cargar el archivo Excel.", Severity.Warning);
            return;
        }

        procesandoExcelDirecto = true;
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            IWorkbook workbook = WorkbookFactory.Create(ms);
            IFormulaEvaluator evaluator = workbook.GetCreationHelper().CreateFormulaEvaluator();

            ISheet? sheet = null;
            for (int s = 0; s < workbook.NumberOfSheets; s++)
            {
                var sName = workbook.GetSheetName(s).ToLowerInvariant();
                if (sName.Contains("ht") || sName.Contains("consolidado") || sName.Contains("plantilla") || sName.Contains("personal") || sName.Contains("horario"))
                {
                    sheet = workbook.GetSheetAt(s);
                    break;
                }
            }
            if (sheet == null) sheet = workbook.GetSheetAt(0);

            // Buscar fila de encabezados
            IRow? headerRow = null;
            int headerRowIndex = -1;
            for (int r = 0; r <= Math.Min(sheet.LastRowNum, 15); r++)
            {
                var row = sheet.GetRow(r);
                if (row == null) continue;

                for (int c = 0; c < row.LastCellNum; c++)
                {
                    var val = row.GetCell(c)?.ToString()?.Trim()?.ToLowerInvariant() ?? "";
                    if (val.Contains("rea") || val.Contains("puesto") || val.Contains("empleado") || val.Contains("carnet") || val.Contains("id"))
                    {
                        headerRow = row;
                        headerRowIndex = r;
                        break;
                    }
                }
                if (headerRow != null) break;
            }

            int colArea = -1, colPuesto = -1, colHoraInicio = -1, colHoraFin = -1, colBnc = -1, colVtcoTrasp = -1, colVtcoAlim = -1, colIds = -1, colNombre = -1;

            if (headerRow != null)
            {
                for (int c = 0; c < headerRow.LastCellNum; c++)
                {
                    var val = headerRow.GetCell(c)?.ToString()?.Trim()?.ToLowerInvariant() ?? "";
                    if (string.IsNullOrWhiteSpace(val)) continue;

                    if (val.Contains("rea") || val.Contains("area") || val.Contains("área"))
                        colArea = c;
                    else if (val.Contains("nombre") || (val.Contains("colaborador") && !val.Contains("id") && !val.Contains("código") && !val.Contains("carnet")))
                        colNombre = c;
                    else if (val.Contains("id") || val.Contains("carnet") || val.Contains("código") || val.Contains("codigo") || val.Contains("recurso") || (val.Contains("empleado") && !val.Contains("nombre")))
                        colIds = c;
                    else if (val.Contains("puesto") || val.Contains("cargo") || val.Contains("posici"))
                        colPuesto = c;
                    else if (val.Contains("entrada") || val.Contains("inicio") || (val.Contains("hora") && val.Contains("inici")))
                        colHoraInicio = c;
                    else if (val.Contains("salida") || val.Contains("fin") || (val.Contains("hora") && val.Contains("fin")))
                        colHoraFin = c;
                    else if (val.Contains("bnc") || val.Contains("bono"))
                        colBnc = c;
                    else if (val.Contains("trasp") || val.Contains("transp"))
                        colVtcoTrasp = c;
                    else if (val.Contains("alim"))
                        colVtcoAlim = c;
                }
            }

            // Fallbacks inteligentes de columnas
            if (colIds == -1)
            {
                if (colNombre >= 0)
                {
                    // Formato HT: Área (0), ID Empleado (1), Nombre Completo (2), Puesto (3), Entrada (4), Salida (5), Bnc (6), Trasp (7), Alim (8)
                    if (colArea == -1) colArea = 0;
                    colIds = 1;
                    if (colPuesto == -1) colPuesto = 3;
                    if (colHoraInicio == -1) colHoraInicio = 4;
                    if (colHoraFin == -1) colHoraFin = 5;
                    if (colBnc == -1) colBnc = 6;
                    if (colVtcoTrasp == -1) colVtcoTrasp = 7;
                    if (colVtcoAlim == -1) colVtcoAlim = 8;
                }
                else
                {
                    // Formato Google Sheets: Área (0), Puesto (1), Fecha (2), Inicio (3), Fin (4), Recursos/IDs (5)
                    if (colArea == -1) colArea = 0;
                    if (colPuesto == -1) colPuesto = 1;
                    if (colHoraInicio == -1) colHoraInicio = 3;
                    if (colHoraFin == -1) colHoraFin = 4;
                    colIds = 5;
                    if (colBnc == -1) colBnc = 6;
                    if (colVtcoTrasp == -1) colVtcoTrasp = 7;
                    if (colVtcoAlim == -1) colVtcoAlim = 8;
                }
            }
            else
            {
                if (colArea == -1) colArea = 0;
                if (colPuesto == -1) colPuesto = 1;
                if (colHoraInicio == -1) colHoraInicio = 3;
                if (colHoraFin == -1) colHoraFin = 4;
            }

            int startRow = headerRowIndex >= 0 ? headerRowIndex + 1 : 0;
            var nuevosColaboradores = new List<PersonalClienteItemDto>();
            int totalObviados = 0;

            int? opId = null;
            var matchOp = operacionesList.FirstOrDefault(o => o.nombre.Equals(filtroCliente, StringComparison.OrdinalIgnoreCase));
            if (matchOp != null) opId = matchOp.id;

            for (int r = startRow; r <= sheet.LastRowNum; r++)
            {
                var row = sheet.GetRow(r);
                if (row == null) continue;

                string area = colArea >= 0 ? ExtraerStringExcel(row.GetCell(colArea), evaluator) : "";
                string puesto = colPuesto >= 0 ? ExtraerStringExcel(row.GetCell(colPuesto), evaluator) : "";
                string horaInicio = colHoraInicio >= 0 ? ExtraerHoraExcel(row.GetCell(colHoraInicio), evaluator) : "";
                string horaFin = colHoraFin >= 0 ? ExtraerHoraExcel(row.GetCell(colHoraFin), evaluator) : "";
                string rawIds = colIds >= 0 ? ExtraerStringExcel(row.GetCell(colIds), evaluator) : "";
                string nombre = colNombre >= 0 ? ExtraerStringExcel(row.GetCell(colNombre), evaluator) : "";
                decimal bnc = colBnc >= 0 ? ExtraerDecimalExcel(row.GetCell(colBnc), evaluator) : 0;
                decimal vtcoTrasp = colVtcoTrasp >= 0 ? ExtraerDecimalExcel(row.GetCell(colVtcoTrasp), evaluator) : 0;
                decimal vtcoAlim = colVtcoAlim >= 0 ? ExtraerDecimalExcel(row.GetCell(colVtcoAlim), evaluator) : 0;

                if (string.IsNullOrWhiteSpace(area) && string.IsNullOrWhiteSpace(puesto) && string.IsNullOrWhiteSpace(rawIds))
                    continue;

                var idTokens = rawIds.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries);
                if (!idTokens.Any()) continue;

                foreach (var token in idTokens)
                {
                    if (!int.TryParse(token.Trim(), out int codigoEmpleado) || codigoEmpleado <= 0)
                        continue;

                    // REGLA: Si ya existe en este cliente, obviarlo
                    bool yaExiste = listaPersonal.Any(p =>
                        p.CodigoEmpleado == codigoEmpleado &&
                        p.ClienteNombre.Equals(filtroCliente, StringComparison.OrdinalIgnoreCase));

                    // REGLA: Si ya se agregó en este mismo archivo, obviarlo
                    bool yaEnLote = nuevosColaboradores.Any(p => p.CodigoEmpleado == codigoEmpleado);

                    if (yaExiste || yaEnLote)
                    {
                        totalObviados++;
                        continue;
                    }

                    // Buscar datos del colaborador en Odoo si no viene nombre en el archivo
                    var empOdoo = catalogoOdooCompleto.FirstOrDefault(e =>
                        e.CodigoEmpleado.HasValue && e.CodigoEmpleado.Value == codigoEmpleado ||
                        e.Id == codigoEmpleado);

                    string nombreFinal = !string.IsNullOrWhiteSpace(nombre)
                        ? nombre.Trim()
                        : (empOdoo != null ? empOdoo.Name : $"Colaborador #{codigoEmpleado}");

                    string cargoFinal = !string.IsNullOrWhiteSpace(puesto) ? puesto : (empOdoo?.JobTitle ?? "6-Operador de almacen");

                    nuevosColaboradores.Add(new PersonalClienteItemDto
                    {
                        Id = 0,
                        OperacionId = opId ?? 0,
                        ClienteNombre = filtroCliente.Trim(),
                        UsuarioSupervisor = string.Empty,
                        IdEmpleado = empOdoo?.Id ?? codigoEmpleado,
                        CodigoEmpleado = codigoEmpleado,
                        NombreEmpleado = nombreFinal,
                        AreaDefault = string.IsNullOrWhiteSpace(area) ? "Operaciones" : area,
                        PuestoDefault = cargoFinal,
                        TurnoDefault = "Diurno",
                        HoraEntradaDefault = string.IsNullOrWhiteSpace(horaInicio) ? "09:00" : horaInicio,
                        HoraSalidaDefault = string.IsNullOrWhiteSpace(horaFin) ? "17:00" : horaFin,
                        TiempoComidaDefault = "1.00",
                        VtcoTraspDefault = vtcoTrasp,
                        VtcoAlimDefault = vtcoAlim,
                        BonoBncDefault = bnc,
                        TipoEmpleado = "Permanente",
                        Activo = true
                    });
                }
            }

            if (nuevosColaboradores.Any())
            {
                var res = await _odooService.SavePersonalClienteMasivo(new GuardarPersonalClienteRequest
                {
                    ClienteNombre = filtroCliente.Trim(),
                    UsuarioSupervisor = currentUserName,
                    Items = nuevosColaboradores
                });

                if (res?.Respuesta?.ExisteError == false)
                {
                    _snackbar.Add($"¡Plantilla cargada con éxito! {nuevosColaboradores.Count} colaboradores agregados a '{filtroCliente}', {totalObviados} ya existían (obviados).", Severity.Success);
                    await CargarPersonal();
                }
                else
                {
                    _snackbar.Add(res?.Respuesta?.MensajeError ?? "Error al guardar colaboradores de la plantilla.", Severity.Error);
                }
            }
            else
            {
                _snackbar.Add($"Todos los colaboradores ({totalObviados}) detectados en el archivo ya estaban registrados para '{filtroCliente}'.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Error al procesar archivo Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            procesandoExcelDirecto = false;
            StateHasChanged();
        }
    }

    // =========================================================================
    // REGISTRO INDIVIDUAL Y EDICIÓN DE COLABORADORES
    // =========================================================================
    private async Task AbrirDialogNuevoColaborador()
    {
        var parameters = new DialogParameters
        {
            ["ItemOriginal"] = new PersonalClienteItemDto(),
            ["IsNuevo"] = true,
            ["OperacionesDisponibles"] = operacionesList,
            ["AreasPorCliente"] = areasPorCliente,
            ["CargosDisponibles"] = cargosDisponibles,
            ["SupervisoresDisponibles"] = supervisoresList,
            ["ClienteSeleccionadoInicial"] = filtroCliente ?? "",
            ["SupervisorSeleccionadoInicial"] = ""
        };

        var dialog = await _dialogService.ShowAsync<DialogEditarPersonalCliente>("Asignar Colaborador al Cliente", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PersonalClienteItemDto nuevoItem)
        {
            nuevoItem.UsuarioCreacion = currentUserName;
            var res = await _odooService.SavePersonalClienteItem(nuevoItem);
            if (res?.Respuesta?.ExisteError == false)
            {
                _snackbar.Add($"Colaborador '{nuevoItem.NombreEmpleado}' agregado a '{nuevoItem.ClienteNombre}'.", Severity.Success);
                await CargarPersonal();
            }
            else
            {
                _snackbar.Add(res?.Respuesta?.MensajeError ?? "Error al guardar colaborador.", Severity.Error);
            }
        }
    }

    private async Task AbrirDialogEditar(PersonalClienteItemDto item)
    {
        var parameters = new DialogParameters
        {
            ["ItemOriginal"] = item,
            ["IsNuevo"] = false,
            ["OperacionesDisponibles"] = operacionesList,
            ["AreasPorCliente"] = areasPorCliente,
            ["CargosDisponibles"] = cargosDisponibles,
            ["SupervisoresDisponibles"] = supervisoresList,
            ["ClienteSeleccionadoInicial"] = item.ClienteNombre,
            ["SupervisorSeleccionadoInicial"] = item.UsuarioSupervisor
        };

        var dialog = await _dialogService.ShowAsync<DialogEditarPersonalCliente>("Editar Colaborador del Cliente", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PersonalClienteItemDto modificado)
        {
            modificado.UsuarioCreacion = currentUserName;
            var res = await _odooService.SavePersonalClienteItem(modificado);
