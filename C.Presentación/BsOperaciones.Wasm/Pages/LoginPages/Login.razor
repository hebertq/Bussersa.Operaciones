@page "/"
@page "/login"
@layout LoginLayout

<MudPaper Elevation="0" Class="pa-10 shadow-lg" Style="border-radius: 24px; position: relative; overflow: hidden; background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.4);">
    @* Barra de progreso superior si está cargando *@
    @if (_isProcessing)
    {
        <MudProgressLinear Color="MudBlazor.Color.Secondary" Indeterminate="true" Style="position:absolute; top:0; left:0;" />
    }

    <div class="d-flex flex-column align-center">

        <div class="mb-6">
            <img src="/img/brand/logo.png?v=2" style="width: 200px;" alt="BUSSERSA" />
        </div>

        <MudText Typo="MudBlazor.Typo.h5" Style="font-weight: 900; color: var(--mud-palette-primary); letter-spacing: 1px;" Align="MudBlazor.Align.Center">
            OPERACIONES
        </MudText>
        <MudText Typo="MudBlazor.Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-8" Style="font-weight: 700; letter-spacing: 2px;">
            PORTAL DE ASISTENCIA
        </MudText>

        @if (!string.IsNullOrEmpty(LoginMesssage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Variant="MudBlazor.Variant.Filled" Class="mb-6 w-100 shadow-sm">
                @LoginMesssage
            </MudAlert>
        }

        <EditForm Model="@user" OnValidSubmit="ProcessLogin" Style="width: 100%;">
            <MudTextField T="string" @bind-Value="user.Email_Address"
                          Label="Correo Electrónico"
                          Variant="MudBlazor.Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4"
                          Adornment="MudBlazor.Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          AdornmentColor="MudBlazor.Color.Primary"
                          Disabled="_isProcessing" />

            <MudTextField T="string" @bind-Value="user.Password"
                          Label="Contraseña"
                          Variant="MudBlazor.Variant.Outlined"
                          FullWidth="true"
                          Class="mb-8"
                          InputType="@_passwordInput"
                          Adornment="MudBlazor.Adornment.End"
                          AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          AdornmentColor="MudBlazor.Color.Primary"
                          Disabled="_isProcessing" />

            <MudButton Variant="MudBlazor.Variant.Filled"
                       ButtonType="MudBlazor.ButtonType.Submit"
                       Class="btn-login-premium rounded-pill py-4 w-100"
                       Size="MudBlazor.Size.Large"
                       Disabled="_isProcessing">
                @if (_isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">AUTENTICANDO...</MudText>
                }
                else
                {
                    <MudText Style="font-weight: 800;">INICIAR SESIÓN</MudText>
                }
            </MudButton>
        </EditForm>

        <div class="mt-8 d-flex justify-center w-100">
            <MudText Typo="MudBlazor.Typo.caption" Style="color: #9e9e9e; text-transform: uppercase;">
                Software de Gestión © @DateTime.Now.Year
            </MudText>
        </div>
    </div>
</MudPaper>