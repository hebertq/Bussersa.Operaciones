@page "/nomina/configuracion-jornadas"
@using Modelo.Entidades.Nomina
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@inject IOdooService _OdooService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<style>
    .page-container {
        padding: 24px;
        background: #f8fafc;
        min-height: 100vh;
    }
    .panel-card {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(226, 232, 240, 0.8);
        background: white;
    }
    .edit-card {
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        border: 2px solid #3b82f6;
        background: #ffffff;
        margin-bottom: 24px;
    }
    .status-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 12px;
    }
    .badge-primary { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .badge-success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .badge-warning { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
</style>

<div class="page-container">
    @* Encabezado principal *@
    <div class="d-flex justify-between align-center flex-wrap mb-6">
        <div>
            <h3 class="font-bold d-flex align-center gap-2 mb-1" style="color: #0f172a; font-size: 24px;">
                <MudIcon Icon="@Icons.Material.Filled.SettingsSuggest" Color="Color.Primary" Size="Size.Large" />
                Configuración de Jornadas, Cortes de Nómina y Estructuras Salariales
            </h3>
            <MudText Typo="Typo.body2" Class="text-secondary">
                Administración y asignación directa de reglas de cálculo de horas laborales, facturables, cortes de nómina (8-23 / 13-28) y viáticos automáticos por cliente.
            </MudText>
        </div>
        <div>
            @if (!showForm)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateForm" Style="border-radius: 8px; font-weight: 700; height: 42px;">
                    + Nueva Regla / Asignación
                </MudButton>
            }
        </div>
    </div>

    @* Overlay de Carga *@
    <MudOverlay Visible="isLoading" DarkBackground="true" Absolute="true" ZIndex="9999">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large" />
    </MudOverlay>

    @* FORMULARIO DE EDICIÓN / CREACIÓN EN PANEL PRINCIPAL *@
    @if (showForm)
    {
        <div class="edit-card pa-6">
            <div class="d-flex align-center justify-between mb-4">
                <MudText Typo="Typo.h6" Style="font-weight: 800; color: #1e3a8a;">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                    @(selectedItem.Id > 0 ? $"Editar Regla #{selectedItem.Id}: {selectedItem.NombreConfiguracion}" : "Crear / Asignar Nueva Regla de Jornada")
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CloseForm" Size="Size.Small" />
            </div>

            <MudGrid>
                @* Nombre descriptivo *@
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="selectedItem.NombreConfiguracion" Label="Nombre Descriptivo de la Regla" Variant="Variant.Outlined" Required="true" HelperText="ej. Regla WalMart (Semanal 48h + Marca Única 8h)" />
                </MudItem>

                @* Selector de Cliente / Operación *@
                <MudItem xs="12" md="3">
                    <MudSelect T="int?" @bind-Value="selectedItem.OperacionId" Label="Cliente / Operación" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="int?" Value="null">-- GLOBAL (Todas las operaciones) --</MudSelectItem>
                        @foreach (var op in operacionesList)
                        {
                            <MudSelectItem T="int?" Value="@op.id">#@op.id - @op.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Selector de Estructura Salarial *@
                <MudItem xs="12" md="3">
                    <MudSelect T="int?" @bind-Value="selectedItem.EstructuraSalarialId" Label="Estructura Salarial" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="int?" Value="null">-- Todas las estructuras --</MudSelectItem>
                        @foreach (var st in estructurasList)
                        {
                            <MudSelectItem T="int?" Value="@st.id">@st.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Ciclo de Corte de Nómina *@
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="selectedItem.CorteNominaTipo" Label="Ciclo / Corte de Nómina" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("CORTE_8_23")">Corte 8 y 23 (Inicia día 9 y 24)</MudSelectItem>
                        <MudSelectItem Value="@("CORTE_13_28")">Corte 13 y 28 (Inicia día 14 y 29)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Motor de Cálculo Laboral *@
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="selectedItem.ModoCalculoLaboral" Label="Motor de Cálculo Laboral" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("SEMANAL_48H")">Semanal 48 Horas</MudSelectItem>
                        <MudSelectItem Value="@("QUINCENAL_96H")">Quincenal 96 Horas</MudSelectItem>
                        <MudSelectItem Value="@("JORNADA_4X12")">Turnos 4x12 (12h = 1.5 Días)</MudSelectItem>
                        <MudSelectItem Value="@("DIARIO_ESTANDAR")">Diario Estándar (8h/7h)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Factor Turno 12h si aplica *@
                <MudItem xs="12" md="4">
                    @if (selectedItem.ModoCalculoLaboral == "JORNADA_4X12")
                    {
                        <MudNumericField @bind-Value="selectedItem.FactorDiasTurno12h" Label="Factor Días por Turno 12h" Variant="Variant.Outlined" Format="F2" HelperText="ej. 1.50 días equivalentes por turno" />
                    }
                    else
                    {
                        <MudTextField Value="@("N/A")" Label="Factor Turno 12h" Variant="Variant.Outlined" Disabled="true" />
                    }
                </MudItem>

                @* Opciones Booleanas *@
                <MudItem xs="12" md="6">
                    <MudCheckBox T="bool" @bind-Value="selectedItem.DomingoEsDiaOrdinario" Label="Domingo es día hábil ordinario dentro de las 48h/96h" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox T="bool" @bind-Value="selectedItem.PermiteMarcaUnica8h" Label="Entrada sin salida (Marcación Única) asigna 1.00 Día (8 Horas)" Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Secondary">Configuración de Viático de Alimentos / Comida Automático</MudText>
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudCheckBox T="bool" @bind-Value="selectedItem.AplicaViaticoAlimentos" Label="Activar Viático de Comida Automático por Horario" Color="Color.Secondary" />
                </MudItem>

                @if (selectedItem.AplicaViaticoAlimentos)
                {
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="selectedItem.HoraEntradaMaxViatico" Label="Hora Máx. Entrada (HH:mm)" Variant="Variant.Outlined" Placeholder="06:00" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="selectedItem.HoraSalidaMinViatico" Label="Hora Mín. Salida (HH:mm)" Variant="Variant.Outlined" Placeholder="19:00" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudNumericField @bind-Value="selectedItem.MontoViaticoAlimentos" Label="Monto del Viático (C$)" Variant="Variant.Outlined" Format="F2" />
                    </MudItem>
                }

                @* Botones de Acción *@
                <MudItem xs="12" Class="d-flex justify-end gap-3 mt-4">
                    <MudButton OnClick="CloseForm" Variant="Variant.Outlined" Color="Color.Default" Style="border-radius: 8px;">Cancelar</MudButton>
                    <MudButton OnClick="SaveConfig" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Style="border-radius: 8px; font-weight: 700;">Guardar Regla</MudButton>
                </MudItem>
            </MudGrid>
        </div>
    }

    @* VISTA DE PESTAÑAS (TABLA DE REGLAS ASIGNADAS + CATÁLOGO) *@
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToInnerViews="true" PanelClass="pa-0">
        <MudTabPanel Text="Reglas Asignadas por Cliente / Operación" Icon="@Icons.Material.Filled.ListAlt">
            <div class="panel-card pa-4 mt-4">
                <MudTable Items="@configuraciones" Hover="true" Striped="true" Dense="true" Elevation="0" Filter="new Func<JornadaConfiguracion, bool>(FilterConfig)">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Class="font-bold">Asignaciones Activas (@configuraciones.Count)</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString" Placeholder="Buscar cliente, regla o corte..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Cliente / Operación</MudTh>
                        <MudTh>Nombre de Regla</MudTh>
                        <MudTh>Corte Nómina</MudTh>
                        <MudTh>Modo Cálculo</MudTh>
                        <MudTh>Domingo</MudTh>
                        <MudTh>Marca Única 8h</MudTh>
                        <MudTh>Viático Comida</MudTh>
                        <MudTh Style="text-align: right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Cliente">
                            @if (context.OperacionId.HasValue)
                            {
                                <span class="status-badge badge-primary">#@context.OperacionId @context.OperacionNombre</span>
                            }
                            else
                            {
                                <span class="status-badge badge-success">GLOBAL (Todas las operaciones)</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Nombre">
                            <span style="font-weight: 700; color: #0f172a;">@context.NombreConfiguracion</span>
                        </MudTd>
                        <MudTd DataLabel="Corte">
                            @if (context.CorteNominaTipo == "CORTE_8_23")
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">Corte 8 y 23</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Corte 13 y 28</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Modo">
                            @switch (context.ModoCalculoLaboral)
                            {
                                case "JORNADA_4X12":
                                    <MudChip T="string" Color="Color.Tertiary" Size="Size.Small">4x12 (1.5 días/turno)</MudChip>
                                    break;
                                case "QUINCENAL_96H":
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Quincenal 96h</MudChip>
                                    break;
                                case "DIARIO_ESTANDAR":
                                    <MudChip T="string" Color="Color.Dark" Size="Size.Small">Diario Estándar</MudChip>
                                    break;
                                default:
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">Semanal 48h</MudChip>
                                    break;
                            }
                        </MudTd>
                        <MudTd DataLabel="Domingo">
                            @if (context.DomingoEsDiaOrdinario)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Hábil</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Descanso</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Marca Única">
                            @if (context.PermiteMarcaUnica8h)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Activo (8h)</MudChip>
                            }
                            else
                            {
                                <span class="text-secondary">Inactivo</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Viático Comida">
                            @if (context.AplicaViaticoAlimentos)
                            {
                                <div>
                                    <span style="font-weight: 700; color: #15803d;">C$ @context.MontoViaticoAlimentos.ToString("N2")</span><br />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">In &le; @context.HoraEntradaMaxViatico | Out &ge; @context.HoraSalidaMinViatico</MudText>
                                </div>
                            }
                            else
                            {
                                <span class="text-secondary">No aplica</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: right;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditForm(context)" />
                            @if (context.OperacionId.HasValue || context.EstructuraSalarialId.HasValue)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteConfig(context.Id)" />
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager InfoText="Mostrando {first_item}-{last_item} de {all_items}" RowsPerPageString="Filas por página" />
                    </PagerContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Guía de Motores de Cálculo y Reglas Preconfiguradas" Icon="@Icons.Material.Filled.HelpOutline">
            <div class="panel-card pa-6 mt-4">
                <MudText Typo="Typo.h6" Class="font-bold mb-3" Color="Color.Primary">Motores de Cálculo Disponibles para Asignar</MudText>
                
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px;">
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-1" Color="Color.Primary">1. Semanal 48 Horas (Estándar)</MudText>
                            <MudText Typo="Typo.body2">
                                Las horas ordinarias de la semana laboral se acumulan hasta un tope de 48 horas. Las horas excedentes después de las 48h semanales cuentan como extras.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px;">
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-1" Color="Color.Success">2. Quincenal 96 Horas / Días Hábiles</MudText>
                            <MudText Typo="Typo.body2">
                                Acumula las horas trabajadas en el período del corte de nómina (ej. 8 al 23 o 13 al 28) hasta alcanzar el límite legal quincenal de 96 horas ordinarias.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px;">
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-1" Color="Color.Tertiary">3. Turnos 4x12 (12 Horas = 1.50 Días)</MudText>
                            <MudText Typo="Typo.body2">
                                Diseñado para contratos de 4 días de trabajo por 3 de descanso. Cada turno de 12h equivale a 1.50 días trabajados ordinarios ($12 / 8 = 1.50$), totalizando 48h semanales con 0 horas extras por turno.
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px;">
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-1" Color="Color.Warning">4. Marcación Única & Viáticos Automáticos</MudText>
                            <MudText Typo="Typo.body2">
                                Permite otorgar 1.00 día completo (8.0h) si el turno registra únicamente hora de entrada sin salida. Asigna bonos/viáticos automáticos si el trabajador ingresa y sale en rangos horarios configurables.
                            </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </div>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private bool isLoading = false;
    private bool showForm = false;
    private string searchString = "";

    private List<JornadaConfiguracion> configuraciones = new();
    private List<Combos> operacionesList = new();
    private List<Combos> estructurasList = new();
    private JornadaConfiguracion selectedItem = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        try
        {
            var resOp = await _OdooService.GetAllCombosHost("Operaciones");
            if (resOp?.Model != null) operacionesList = resOp.Model.ToList();

            var resEst = await _OdooService.GetAllEstructurasSalariales();
            if (resEst?.Model != null) estructurasList = resEst.Model.ToList();

            var resCfg = await _OdooService.GetAllJornadaConfiguraciones();
            if (resCfg?.Model != null) configuraciones = resCfg.Model.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar configuraciones: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool FilterConfig(JornadaConfiguracion element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if ((element.NombreConfiguracion ?? "").Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if ((element.OperacionNombre ?? "").Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if ((element.CorteNominaTipo ?? "").Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if ((element.ModoCalculoLaboral ?? "").Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private void OpenCreateForm()
    {
        selectedItem = new JornadaConfiguracion
        {
            NombreConfiguracion = "Nueva Regla de Jornada",
            CorteNominaTipo = "CORTE_8_23",
            ModoCalculoLaboral = "SEMANAL_48H",
            FactorDiasTurno12h = 1.50m,
            DomingoEsDiaOrdinario = true,
            PermiteMarcaUnica8h = false,
            AplicaViaticoAlimentos = false,
            HoraEntradaMaxViatico = "06:00",
            HoraSalidaMinViatico = "19:00",
            MontoViaticoAlimentos = 0.00m,
            HorasSemanalesLimite = 48.00m,
            HorasQuincenalesLimite = 96.00m,
            ModoCalculoFacturable = "SEMANAL_48H",
            Activo = true
        };
        showForm = true;
    }

    private void OpenEditForm(JornadaConfiguracion item)
    {
        selectedItem = new JornadaConfiguracion
        {
            Id = item.Id,
            OperacionId = item.OperacionId,
            OperacionNombre = item.OperacionNombre,
            EstructuraSalarialId = item.EstructuraSalarialId,
            EstructuraSalarialNombre = item.EstructuraSalarialNombre,
            NombreConfiguracion = item.NombreConfiguracion,
            CorteNominaTipo = item.CorteNominaTipo,
            ModoCalculoLaboral = item.ModoCalculoLaboral,
            FactorDiasTurno12h = item.FactorDiasTurno12h,
            DomingoEsDiaOrdinario = item.DomingoEsDiaOrdinario,
            PermiteMarcaUnica8h = item.PermiteMarcaUnica8h,
            AplicaViaticoAlimentos = item.AplicaViaticoAlimentos,
            HoraEntradaMaxViatico = item.HoraEntradaMaxViatico,
            HoraSalidaMinViatico = item.HoraSalidaMinViatico,
            MontoViaticoAlimentos = item.MontoViaticoAlimentos,
            HorasSemanalesLimite = item.HorasSemanalesLimite,
            HorasQuincenalesLimite = item.HorasQuincenalesLimite,
            ModoCalculoFacturable = item.ModoCalculoFacturable,
            Activo = item.Activo
        };
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task SaveConfig()
    {
        if (string.IsNullOrWhiteSpace(selectedItem.NombreConfiguracion))
        {
            Snackbar.Add("Por favor ingrese un nombre para la regla de configuración.", Severity.Warning);
            return;
        }

        isLoading = true;
        try
        {
            var res = await _OdooService.SaveJornadaConfiguracion(selectedItem);
            if (res?.Respuesta != null && !res.Respuesta.ExisteError)
            {
                Snackbar.Add("Configuración de jornada guardada y asignada correctamente.", Severity.Success);
                showForm = false;
                await CargarDatos();
            }
            else
            {
                Snackbar.Add(res?.Respuesta?.MensajeError ?? "Error al guardar la configuración.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteConfig(int id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirmar Eliminación",
            "¿Está seguro de eliminar esta regla de configuración asignada?",
            yesText: "Eliminar", cancelText: "Cancelar");

        if (confirm == true)
        {
            isLoading = true;
            try
            {
                var res = await _OdooService.DeleteJornadaConfiguracion(id);
                if (res?.Respuesta != null && !res.Respuesta.ExisteError)
                {
                    Snackbar.Add("Configuración eliminada correctamente.", Severity.Success);
                    await CargarDatos();
                }
                else
                {
                    Snackbar.Add(res?.Respuesta?.MensajeError ?? "Error al eliminar la configuración.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }
}
