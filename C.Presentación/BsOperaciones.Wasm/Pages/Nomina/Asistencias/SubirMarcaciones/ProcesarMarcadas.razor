@page "/importacion-marcaciones"
@using Modelo.Enum 
@using Modelo.Entidades.Entradas.Odoo

@* Loader Corporativo *@
<MudOverlay Visible="isloaddata" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Procesando información...</MudText>
    </div>
</MudOverlay>

<MudPaper Elevation="0" Class="pa-6 mb-4 glass-card card-lift">
    <MudText Typo="MudBlazor.Typo.h5" Color="MudBlazor.Color.Primary" Class="mb-6" Style="font-weight: 800;">
        <MudIcon Icon="@Icons.Material.Outlined.Assessment" Class="mr-2" />
        Marcaciones Diarias
    </MudText>

    <MudGrid Spacing="3">
        @* 1. Fecha de Carga *@
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="Fecha de Marcación" @bind-Date="FchaCargaWrapper"
                           Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Primary"
                           DateFormat="dd/MM/yyyy" />
        </MudItem>

        @* 2. Tipo de Reloj (Estrategia) *@
        <MudItem xs="12" sm="3">
            <MudSelect T="TipoReloj?" Label="Tipo de Marcación"
                       Value="operacion"
                       ValueChanged="OnChangeReloj"
                       Variant="MudBlazor.Variant.Outlined"
                       Placeholder="Seleccione de la lista"
                       AnchorOrigin="MudBlazor.Origin.BottomCenter"
                       Clearable="true">
                @foreach (TipoReloj item in Enum.GetValues(typeof(TipoReloj)))
                {
                    <MudSelectItem Value="@((TipoReloj?)item)">@item.ToString()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @* 3. Botón para subir archivo *@
        @if (operacion.HasValue)
        {
            <MudItem xs="12" sm="6" Class="d-flex align-end">
                <MudFileUpload T="IBrowserFile" OnFilesChanged="LoadFiles" Accept=".csv, .xls, .xlsx, .txt" Style="width: 100%">
                    <ActivatorContent>
                        <MudButton Variant="MudBlazor.Variant.Filled"
                                   Color="MudBlazor.Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.CloudUpload"
                                   Style="height: 56px;"
                                   FullWidth="true">
                            PASO 1: SUBIR DATOS DEL RELOJ
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            </MudItem>
        }

        @* 4. Operación Destino y Guardado *@
        @if (PayLoadList.Count > 0)
        {
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" Label="Operación Destino (Odoo)" @bind-Value="empresa"
                           Variant="MudBlazor.Variant.Outlined" 
                           Placeholder="Seleccione de la lista"
                           AnchorOrigin="MudBlazor.Origin.BottomCenter">
                    @foreach (var item in PayLoadOper)
                    {
                        <MudSelectItem Value="@((int?)item.id)">@item.nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4" Class="d-flex align-end">
                <MudButton Variant="MudBlazor.Variant.Filled"
                           Color="MudBlazor.Color.Info"
                           StartIcon="@Icons.Material.Outlined.DeleteSweep"
                           OnClick="LimpiarDuplicados"
                           Style="height: 56px;"
                           FullWidth="true">
                    LIMPIAR DUPLICADOS
                </MudButton>
            </MudItem>

            @if (empresa.HasValue && empresa > 0)
            {
                <MudItem xs="12" sm="4" Class="d-flex align-end">
                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Color="MudBlazor.Color.Success"
                               StartIcon="@Icons.Material.Outlined.Save"
                               OnClick="SendMarca"
                               Style="height: 56px;"
                               FullWidth="true"
                               Class="rounded-pill">
                        PASO 2: GUARDAR MARCACIONES
                    </MudButton>
                </MudItem>
            }
        }
    </MudGrid>
</MudPaper>

@* DataGrid con edición de celdas y máscaras *@
<MudDataGrid T="HoraEntrada" Items="@PayLoadList" Dense="true" ReadOnly="false"
             RowStyleFunc="@((item, index) => item.Estado != EstadoMarcacion.Completo ? "background-color:rgba(255, 0, 0, 0.05);" : "")"
             EditMode="MudBlazor.DataGridEditMode.Cell" CommittedItemChanges="@CommittedItemChanges"
             QuickFilter="QuickFilterMethod" RowsPerPage="15" Bordered="false" Striped="true" Elevation="1">
    <ToolBarContent>
        <MudIconButton Size="MudBlazor.Size.Small" Icon="@Icons.Material.Outlined.FileDownload" OnClick="@DownloadFile" Color="MudBlazor.Color.Primary" />
        <MudSpacer />
        <MudText Typo="MudBlazor.Typo.h6">Revisión de Marcaciones</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Buscar por nombre o ID..." Adornment="MudBlazor.Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mt-0" />
    </ToolBarContent>
    <Columns>
        <TemplateColumn Title="Estado" Editable="false">
            <CellTemplate>
                @switch (context.Item.Estado)
                {
                    case EstadoMarcacion.Completo:
                        <MudChip T="string" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.CheckCircle">OK</MudChip>
                        break;
                    case EstadoMarcacion.FaltaEntrada:
                        <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Login">FALTA ENTRADA</MudChip>
                        break;
                    case EstadoMarcacion.FaltaSalida:
                        <MudChip T="string" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Logout">FALTA SALIDA</MudChip>
                        break;
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.fecha" Title="Fecha" Editable="false" />
        <PropertyColumn Property="x => x.id" Title="No empleado" Editable="false" />
        <PropertyColumn Property="x => x.nombre" Title="Nombre" Editable="false" />
        
        <PropertyColumn Property="x => x.entrada" Title="Entrada">
            <CellTemplate><div class="visualizacion-celda">@context.Item.entrada</div></CellTemplate>
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.entrada" Label="HH:mm:ss" 
                              Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense"
                              Mask="@horaMask" Placeholder="00:00:00" />
            </EditTemplate>
        </PropertyColumn>
        
        <PropertyColumn Property="x => x.salida" Title="Salida">
            <CellTemplate><div class="visualizacion-celda">@context.Item.salida</div></CellTemplate>
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.salida" Label="HH:mm:ss" 
                              Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense"
                              Mask="@horaMask" Placeholder="00:00:00" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.bono" Title="Bono" />
        <PropertyColumn Property="x => x.almuerzocena" Title="Hora comida" />

        <TemplateColumn CellClass="d-flex justify-end" Editable="false" Sortable="false">
            <CellTemplate>
                <MudIconButton Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Delete" 
                               Color="MudBlazor.Color.Error" OnClick="@(() => EliminarFila(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="HoraEntrada" /></PagerContent>
</MudDataGrid>