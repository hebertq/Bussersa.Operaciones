@page "/dias-trabajados"

@* Loader Corporativo *@
<MudOverlay Visible="isloading" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Procesando información...</MudText>
    </div>
</MudOverlay>

<MudContainer MaxWidth="MudBlazor.MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="0" Class="pa-6 mb-6 glass-card card-lift">
        <MudText Typo="MudBlazor.Typo.h5" Color="MudBlazor.Color.Primary" Class="mb-6" Style="font-weight: 800;">
            <MudIcon Icon="@Icons.Material.Outlined.EventAvailable" Class="mr-2" />
            Control de Días Trabajados
        </MudText>

        <MudGrid Spacing="3" Class="align-end">
            @* Filtro Fecha Desde *@
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Desde" @bind-Date="_fchaDesdeWrapper"
                               Variant="MudBlazor.Variant.Outlined" 
                               Color="MudBlazor.Color.Primary"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>

            @* Filtro Fecha Hasta *@
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Hasta" @bind-Date="_fchaHastaWrapper"
                               Variant="MudBlazor.Variant.Outlined" 
                               Color="MudBlazor.Color.Primary"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>

            @* Selección de Operación (MudSelect en lugar de Radzen) *@
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Label="Operación" 
                           Value="operacion" 
                           ValueChanged="OnChangeCliente"
                           Variant="MudBlazor.Variant.Outlined"
                           AnchorOrigin="MudBlazor.Origin.BottomCenter">
                    <MudSelectItem Value="0">Seleccione una operación...</MudSelectItem>
                    @foreach (var item in PayLoadOper)
                    {
                        <MudSelectItem Value="@item.id">@item.nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>          
        </MudGrid>
    </MudPaper>

    @* Tabla de Resultados (Componente personalizado) *@
    <div class="mt-4">
        <TablaDiasTrabajados _PayLoadList="@PayLoadList" 
                             OnDelete="OnDelete" 
                             OnUpdate="OnUpdate" 
                             OnCreate="OnUpdate" 
                             OperacionName="@NombreOperacion"
                             BotonEnabled="@BotonEnabled" />
    </div>
</MudContainer>
