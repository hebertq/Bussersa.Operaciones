@page "/nomina/configuracion-jornadas"
@page "/nomina/asignacion-jornadas"
@inject IOdooService OdooService
@inject IJSRuntime JSRuntime
@using Modelo.Entidades.Nomina
@using Modelo.ClasesGenericas
@using HostService.Interfaces

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-building-gear text-primary me-2"></i>Asignación de Reglas de Jornada por Cliente (Ley 185)
            </h2>
            <p class="text-muted small mb-0">
                Seleccione un cliente y estructura salarial para activar las **reglas atómicas del Código del Trabajo (Ley 185)** y definir el **corte de nómina (8-23 / 13-28)**.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/nomina/reglas-jornadas" class="btn btn-outline-secondary btn-sm px-3 rounded-pill fw-semibold">
                <i class="bi bi-journal-check me-1"></i>Ver Catálogo de Reglas Ley 185
            </a>
            <button class="btn btn-primary btn-sm px-3 shadow-sm rounded-pill fw-semibold" @onclick="PrepareCreate">
                <i class="bi bi-plus-lg me-1"></i>+ NUEVA ASIGNACIÓN A CLIENTE
            </button>
        </div>
    </div>

    <!-- Stats summary badges -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white rounded-3 p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-white text-primary p-3 me-3 fs-4">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small fw-bold">ASIGNACIONES ACTIVAS</div>
                        <div class="fs-3 fw-bold">@asignacionesList.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-info text-white rounded-3 p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-white text-info p-3 me-3 fs-4">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small fw-bold">CORTE 8 Y 23 (DÍAS 9 - 24)</div>
                        <div class="fs-3 fw-bold">@asignacionesList.Count(a => a.CorteNominaTipo == "CORTE_8_23")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-secondary text-white rounded-3 p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-white text-secondary p-3 me-3 fs-4">
                        <i class="bi bi-calendar2-range"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small fw-bold">CORTE 13 Y 28 (DÍAS 14 - 29)</div>
                        <div class="fs-3 fw-bold">@asignacionesList.Count(a => a.CorteNominaTipo == "CORTE_13_28")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Assignments List Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-check me-2 text-primary"></i>Configuración de Reglas por Cliente y Estructura Salarial (@asignacionesList.Count)
            </h5>
            <div class="input-group input-group-sm" style="max-width: 320px;">
                <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control bg-light border-0" placeholder="Buscar cliente o regla..." @bind="searchText" @bind:event="oninput" />
            </div>
        </div>

        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Cargando asignaciones de clientes...</p>
                </div>
            }
            else if (!FilteredAsignaciones.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted display-4"></i>
                    <p class="text-muted mt-2">No se encontraron asignaciones registradas.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th style="width: 50px;" class="ps-3">ID</th>
                                <th>Cliente / Operación</th>
                                <th>Estructura Salarial</th>
                                <th>Corte de Nómina</th>
                                <th>Reglas Atómicas Activas Aplicadas</th>
                                <th>Observaciones</th>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in FilteredAsignaciones)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">#@a.Id</td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-bold fs-6">
                                            @a.OperacionNombre
                                        </span>
                                    </td>
                                    <td>
                                        <span class="small fw-semibold text-dark">@a.EstructuraSalarialNombre</span>
                                    </td>
                                    <td>
                                        @if (a.CorteNominaTipo == "CORTE_8_23")
                                        {
                                            <span class="badge bg-info text-white rounded-pill px-3 py-1 fw-bold">
                                                Corte 8 y 23
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white rounded-pill px-3 py-1 fw-bold">
                                                Corte 13 y 28
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1" style="max-width: 480px;">
                                            @if (a.ReglasActivas == null || !a.ReglasActivas.Any())
                                            {
                                                <span class="badge bg-light text-muted border">Sin reglas activas</span>
                                            }
                                            else
                                            {
                                                @foreach (var cod in a.ReglasActivas)
                                                {
                                                    var rule = atomicasList.FirstOrDefault(r => r.CodigoRegla == cod);
                                                    var label = rule != null ? rule.NombreRegla : cod;
                                                    var category = rule?.Categoria ?? "";

                                                    @if (category == "JORNADA")
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 small" title="@label">
                                                            <i class="bi bi-clock me-1"></i>@label
                                                        </span>
                                                    }
                                                    else if (category == "DESCANSO" || category == "FERIADO")
                                                    {
                                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 rounded-pill px-2 py-1 small" title="@label">
                                                            <i class="bi bi-calendar-event me-1"></i>@label
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2 py-1 small" title="@label">
                                                            <i class="bi bi-check2-circle me-1"></i>@label
                                                        </span>
                                                    }
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(string.IsNullOrWhiteSpace(a.Observaciones) ? "-" : a.Observaciones)</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-outline-primary btn-sm rounded-circle me-1" title="Editar Reglas Asignadas" @onclick="() => EditAsignacion(a)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm rounded-circle" title="Eliminar Asignación" @onclick="() => DeleteAsignacion(a.Id)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Form Asignación Modular -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-sliders me-2"></i>Configuración y Asignación de Reglas de Jornada por Cliente
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- General settings -->
                    <div class="row g-3 mb-4 pb-3 border-bottom">
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-secondary">Cliente / Operación</label>
                            <select class="form-select" @bind="activeAsignacion.OperacionId">
                                <option value="">🌐 GLOBAL (Todas las operaciones)</option>
                                @foreach (var op in operacionesList)
                                {
                                    <option value="@op.id">@op.nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Estructura Salarial</label>
                            <select class="form-select" @bind="activeAsignacion.EstructuraSalarialId">
                                <option value="">Todas las Estructuras Salariales</option>
                                @foreach (var est in estructurasList)
                                {
                                    <option value="@est.id">@est.nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-secondary">Corte de Nómina</label>
                            <select class="form-select" @bind="activeAsignacion.CorteNominaTipo">
                                <option value="CORTE_8_23">Corte 8 y 23 (Días 9 - 24)</option>
                                <option value="CORTE_13_28">Corte 13 y 28 (Días 14 - 29)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Multi-select atomic rules checkboxes -->
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-check2-square text-primary me-2"></i>Seleccione las Reglas Atómicas que Aplican a este Cliente:
                    </h6>

                    <div class="row g-3">
                        <!-- Group 1: Capacidad de Jornadas Ley 185 -->
                        <div class="col-12">
                            <div class="card border border-success border-opacity-25 bg-success bg-opacity-10 rounded-3 p-3">
                                <h6 class="fw-bold text-success mb-2">
                                    <i class="bi bi-clock me-1"></i>1. Capacidad de Jornadas y Conversión Nocturna (Art. 51 y 53 CT)
                                </h6>
                                <div class="row g-2">
                                    @foreach (var r in atomicasList.Where(x => x.Categoria == "JORNADA"))
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check form-switch bg-white p-2 px-3 rounded border">
                                                <input class="form-check-input me-2" type="checkbox" id="@r.CodigoRegla" 
                                                       checked="@selectedRuleCodes.Contains(r.CodigoRegla)" 
                                                       @onchange="(e) => ToggleRule(r.CodigoRegla, e.Value)" />
                                                <label class="form-check-label fw-bold text-dark" for="@r.CodigoRegla">
                                                    @r.NombreRegla
                                                </label>
                                                <div class="text-muted small ps-1">@r.Descripcion</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Group 2: Séptimo Día y Feriados -->
                        <div class="col-12">
                            <div class="card border border-warning border-opacity-25 bg-warning bg-opacity-10 rounded-3 p-3">
                                <h6 class="fw-bold text-dark mb-2">
                                    <i class="bi bi-calendar-event me-1"></i>2. Recargos por Séptimo Día y Feriados Ley 185 (Art. 64-67 CT)
                                </h6>
                                <div class="row g-2">
                                    @foreach (var r in atomicasList.Where(x => x.Categoria == "DESCANSO" || x.Categoria == "FERIADO"))
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check form-switch bg-white p-2 px-3 rounded border">
                                                <input class="form-check-input me-2" type="checkbox" id="@r.CodigoRegla" 
                                                       checked="@selectedRuleCodes.Contains(r.CodigoRegla)" 
                                                       @onchange="(e) => ToggleRule(r.CodigoRegla, e.Value)" />
                                                <label class="form-check-label fw-bold text-dark" for="@r.CodigoRegla">
                                                    @r.NombreRegla
                                                </label>
                                                <div class="text-muted small ps-1">@r.Descripcion</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Group 3: Turnos Operativos & Extras -->
                        <div class="col-12">
                            <div class="card border border-info border-opacity-25 bg-info bg-opacity-10 rounded-3 p-3">
                                <h6 class="fw-bold text-info mb-2">
                                    <i class="bi bi-gear-wide-connected me-1"></i>3. Turnos Operativos Específicos & Extras (Art. 54 CT & Convenios)
                                </h6>
                                <div class="row g-2">
                                    @foreach (var r in atomicasList.Where(x => x.Categoria == "TURNO_ESPECIAL" || x.Categoria == "MARCADAS" || x.Categoria == "EXTRAS" || x.Categoria == "BENEFICIOS"))
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check form-switch bg-white p-2 px-3 rounded border">
                                                <input class="form-check-input me-2" type="checkbox" id="@r.CodigoRegla" 
                                                       checked="@selectedRuleCodes.Contains(r.CodigoRegla)" 
                                                       @onchange="(e) => ToggleRule(r.CodigoRegla, e.Value)" />
                                                <label class="form-check-label fw-bold text-dark" for="@r.CodigoRegla">
                                                    @r.NombreRegla
                                                </label>
                                                <div class="text-muted small ps-1">@r.Descripcion</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-3">
                            <label class="form-label fw-bold small text-secondary">Observaciones / Notas de la Asignación</label>
                            <textarea class="form-control" rows="2" @bind="activeAsignacion.Observaciones" placeholder="Notas sobre esta asignación..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" @onclick="() => showModal = false">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4" @onclick="SaveAsignacion" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Guardar Configuración
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AsignacionJornadaCliente> asignacionesList = new();
    private List<ReglaAtomica> atomicasList = new();
    private List<Combos> operacionesList = new();
    private List<Combos> estructurasList = new();
    private HashSet<string> selectedRuleCodes = new();
    private bool loading = true;
    private bool saving = false;
    private bool showModal = false;
    private string searchText = "";
    private AsignacionJornadaCliente activeAsignacion = new();

    private IEnumerable<AsignacionJornadaCliente> FilteredAsignaciones => asignacionesList
        .Where(a => string.IsNullOrWhiteSpace(searchText) ||
                    (a.OperacionNombre != null && a.OperacionNombre.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (a.EstructuraSalarialNombre != null && a.EstructuraSalarialNombre.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var resAsig = await OdooService.GetAllAsignacionesJornada();
            if (resAsig?.Model != null) asignacionesList = resAsig.Model.ToList();

            var resAtomicas = await OdooService.GetAllReglasAtomicas();
            if (resAtomicas?.Model != null) atomicasList = resAtomicas.Model.ToList();

            var resOp = await OdooService.GetAllCombosHost("OPERACIONES");
            if (resOp?.Model != null) operacionesList = resOp.Model.ToList();

            var resEst = await OdooService.GetAllEstructurasSalariales();
            if (resEst?.Model != null) estructurasList = resEst.Model.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando datos: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void PrepareCreate()
    {
        activeAsignacion = new AsignacionJornadaCliente
        {
            CorteNominaTipo = "CORTE_8_23"
        };
        selectedRuleCodes = new HashSet<string>
        {
            "JORNADA_DIURNA_8H",
            "JORNADA_NOCTURNA_7H_X_8H",
            "JORNADA_MIXTA_NOCTURNA_CONVERSION",
            "DOMINGO_DESCANSO_RECARGO_100",
            "FERIADO_NACIONAL_RECARGO_100",
            "HORAS_EXTRAS_RECARGO_100"
        };
        showModal = true;
    }

    private void EditAsignacion(AsignacionJornadaCliente a)
    {
        activeAsignacion = new AsignacionJornadaCliente
        {
            Id = a.Id,
            OperacionId = a.OperacionId,
            EstructuraSalarialId = a.EstructuraSalarialId,
            CorteNominaTipo = a.CorteNominaTipo,
            ReglaId = a.ReglaId,
            Observaciones = a.Observaciones,
            Activo = a.Activo
        };
        selectedRuleCodes = new HashSet<string>(a.ReglasActivas ?? new List<string>());
        showModal = true;
    }

    private void ToggleRule(string codigo, object checkedVal)
    {
        bool isChecked = Convert.ToBoolean(checkedVal);
        if (isChecked) selectedRuleCodes.Add(codigo);
        else selectedRuleCodes.Remove(codigo);
    }

    private async Task SaveAsignacion()
    {
        activeAsignacion.ReglasActivas = selectedRuleCodes.ToList();
        saving = true;
        try
        {
            await OdooService.SaveAsignacionJornada(activeAsignacion);
            showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error guardando asignación: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsignacion(int id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar esta asignación?");
        if (!confirm) return;

        try
        {
            await OdooService.DeleteAsignacionJornada(id);
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error eliminando asignación: {ex.Message}");
        }
    }
}
