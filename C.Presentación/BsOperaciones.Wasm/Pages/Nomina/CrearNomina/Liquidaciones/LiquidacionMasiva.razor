@page "/nomina/liquidacion-masiva"
@using Modelo.Entidades.Nomina

<MudOverlay Visible="isProcessing" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Procesando...</MudText>
    </div>
</MudOverlay>

<MudText Typo="Typo.h5" Class="mb-4 fw-bold" Color="Color.Primary">GENERACIÓN DE LIQUIDACIONES</MudText>

@* --- CONFIGURACIÓN Y PROCESAMIENTO --- *@
<MudPaper Elevation="0" Class="pa-5 mb-4" Style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
    <MudGrid Spacing="2" Class="d-flex align-center">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="piv_nombre" Label="Descripción del Lote (Odoo)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="Ej: Liquidaciones Enero 2026" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Label" />
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudDatePicker Label="Inicio" @bind-Date="pidt_inicio" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudDatePicker Label="Fin" @bind-Date="pidt_fin" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ProcesarLote"
                       Disabled="@(isProcessing || !ListaPendientes.Any())"
                       StartIcon="@Icons.Material.Filled.PlayCircle" FullWidth="true" Style="height: 40px; font-weight: bold;">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                else
                {
                    <span>PROCESAR NÓMINA</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* --- LISTADO DE PENDIENTES --- *@
<MudDataGrid Items="@ListaPendientes" T="SeveranceDetail" ReadOnly="true"
             Bordered="true" Dense="true" Hover="true" Height="550px" FixedHeader="true"
             Style="background-color: white;">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Registros Pendientes</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Custom.FileFormats.FileExcel"
                   Size="Size.Small" OnClick="ExportarExcel" Class="mr-2">
            DESCARGAR PREVIA
        </MudButton>
        <MudChip Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.People">
            @ListaPendientes.Count Colaboradores
        </MudChip>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.nombre" Title="Colaborador" StickyLeft="true" />
        <PropertyColumn Property="x => x.diasvac" Title="Días Vac." />
        <PropertyColumn Property="x => x.diasagui" Title="Días Agui." />
        <PropertyColumn Property="x => x.diasinde" Title="Días Inde." />
        <PropertyColumn Property="x => x.prestamos" Title="Préstamos" CellStyle="color: #d32f2f;" />

        <TemplateColumn Title="Acciones" StickyRight="true" HeaderStyle="width: 100px;">
            <CellTemplate>
                <MudStack Row="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"
                                   OnClick="@(() => AbrirDialogoEdicion(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => QuitarDeLista(context.Item.id_severance))" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <div class="d-flex flex-column align-center justify-center pa-10">
            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h6">No hay liquidaciones pendientes</MudText>
        </div>
    </NoRecordsContent>
</MudDataGrid>