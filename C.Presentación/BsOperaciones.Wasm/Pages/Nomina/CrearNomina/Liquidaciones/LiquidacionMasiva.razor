@page "/nomina/liquidacion-masiva"
@using BsOperaciones.Application.Features.Odoo.Command
@using BsOperaciones.Application.Features.Odoo.Queries
@using Modelo.Entidades.Nomina
@using System.Text.Json
@using Utilidades.ClasesGenericas
@inject IMediator _mediator
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4 fw-bold" Color="Color.Primary">GENERACIÓN DE LIQUIDACIONES</MudText>

@* --- CONFIGURACIÓN Y PROCESAMIENTO --- *@
<MudPaper Elevation="0" Class="pa-5 mb-4" Style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
    <MudGrid Spacing="2" Class="d-flex align-center">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="piv_nombre" Label="Descripción del Lote (Odoo)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="Ej: Liquidaciones Enero 2026" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Label" />
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudDatePicker Label="Inicio" @bind-Date="pidt_inicio" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudDatePicker Label="Fin" @bind-Date="pidt_fin" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ProcesarLote"
                       Disabled="@(isProcessing || !ListaPendientes.Any())"
                       StartIcon="@Icons.Material.Filled.PlayCircle" FullWidth="true" Style="height: 40px; font-weight: bold;">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                else
                {
                    <span>PROCESAR NÓMINA</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* --- LISTADO DE PENDIENTES --- *@
<MudDataGrid Items="@ListaPendientes" T="SeveranceDetail" ReadOnly="true"
             Bordered="true" Dense="true" Hover="true" Height="550px" FixedHeader="true"
             Style="background-color: white;">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Registros Pendientes</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Custom.FileFormats.FileExcel"
                   Size="Size.Small" OnClick="ExportarExcel" Class="mr-2">
            DESCARGAR PREVIA
        </MudButton>
        <MudChip Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.People">
            @ListaPendientes.Count Colaboradores
        </MudChip>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.nombre" Title="Colaborador" StickyLeft="true" />
        <PropertyColumn Property="x => x.diasvac" Title="Días Vac." />
        <PropertyColumn Property="x => x.diasagui" Title="Días Agui." />
        <PropertyColumn Property="x => x.diasinde" Title="Días Inde." />
        <PropertyColumn Property="x => x.prestamos" Title="Préstamos" CellStyle="color: #d32f2f;" />

        <TemplateColumn Title="Acciones" StickyRight="true" HeaderStyle="width: 100px;">
            <CellTemplate>
                <MudStack Row="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"
                                   OnClick="@(() => AbrirDialogoEdicion(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => QuitarDeLista(context.Item.id_severance))" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <div class="d-flex flex-column align-center justify-center pa-10">
            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h6">No hay liquidaciones pendientes</MudText>
        </div>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<SeveranceDetail> ListaPendientes = new();
    private DateTime? pidt_inicio = DateTime.Now.Date.AddDays(-15), pidt_fin = DateTime.Now.Date;
    private string piv_nombre = "";
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync() => await CargarPendientes();

    private async Task CargarPendientes()
    {
        isProcessing = true;
        try
        {
            var result = await _mediator.Send(new GetPendingSeveranceQuery());
            ListaPendientes = result.Model?.ToList() ?? new();
        }
        finally { isProcessing = false; }
    }

    private async Task AbrirDialogoEdicion(SeveranceDetail item)
    {
        // Clonamos el objeto para evitar que cambios no guardados se vean en la grilla si cancela
        var itemClonado = System.Text.Json.JsonSerializer.Deserialize<SeveranceDetail>(System.Text.Json.JsonSerializer.Serialize(item));

        var parameters = new DialogParameters { ["Item"] = itemClonado };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false, // <-- En muchas versiones esta es la forma correcta
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<DialogEditarLiquidacion>("Editar Datos de Liquidación", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data != null)
        {
            var index = ListaPendientes.FindIndex(x => x.id_severance == item.id_severance);
            if (index != -1)
            {
                ListaPendientes[index] = (SeveranceDetail)result.Data;
                StateHasChanged();
                Snackbar.Add("Cambios aplicados localmente", Severity.Info);
            }
        }
    }

    private async Task ExportarExcel()
    {
        if (!ListaPendientes.Any()) return;
        try
        {
            var base64 = DataExcel.CreateExcel(ListaPendientes, "Previa_Liquidaciones");
            await JS.InvokeVoidAsync("downloadFile", "application/xlsx", base64, $"Revision_Liquidacion_{DateTime.Now:yyyyMMdd}.xlsx");
        }
        catch (Exception ex) { Snackbar.Add("Error al exportar: " + ex.Message, Severity.Error); }
    }

    private void QuitarDeLista(int id) => ListaPendientes.RemoveAll(x => x.id_severance == id);

    private async Task ProcesarLote()
    {
        if (string.IsNullOrWhiteSpace(piv_nombre)) { Snackbar.Add("Debe ingresar un nombre para el lote.", Severity.Warning); return; }

        isProcessing = true;
        try
        {
            var command = new CreateSettlementPayrollCommand
            {
                Inicio = pidt_inicio.Value,
                Fin = pidt_fin.Value,
                Nombre = piv_nombre,
                model = ListaPendientes
            };

            var response = await _mediator.Send(command);

            Snackbar.Add(response.Respuesta.MensajeError, Severity.Success);
            piv_nombre = "";
            await CargarPendientes();
        }
        finally { isProcessing = false; }
    }
}