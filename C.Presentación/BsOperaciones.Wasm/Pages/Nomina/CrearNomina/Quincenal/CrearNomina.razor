@page "/cargar-nomina"
@using Modelo.Entidades.Entradas.Odoo

@* Overlay de carga corporativo *@
<MudOverlay Visible="isloaddata" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">@loadingText</MudText>
    </div>
</MudOverlay>

<MudContainer MaxWidth="MudBlazor.MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="0" Class="pa-6 mb-6">
        <MudText Typo="MudBlazor.Typo.h5" Color="MudBlazor.Color.Primary" Class="mb-6" Style="font-weight: 800;">
            <MudIcon Icon="@Icons.Material.Outlined.FileUpload" Class="mr-2" />
            Cargar Archivo de Nómina
        </MudText>

        <MudGrid Spacing="3" Class="align-center">

            @* SOLUCIÓN INFALIBLE: InputFile oculto + Botón vinculado *@
            <MudItem xs="12" md="6">
                <div class="d-flex flex-column">
                    <InputFile id="fileInput" OnChange="LoadFiles" hidden accept=".xls,.xlsx" />

                    <MudButton HtmlTag="label"
                               Variant="MudBlazor.Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               for="fileInput"
                               FullWidth="true"
                               Size="MudBlazor.Size.Large"
                               Style="height: 60px; border-radius: 12px; font-weight: bold;">
                        @(fileLoaded ? "CAMBIAR ARCHIVO EXCEL" : "SUBIR EXCEL DE NÓMINA")
                    </MudButton>

                    @if (fileLoaded)
                    {
                        <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Success" Class="mt-2 ml-2">
                            <b>Archivo cargado correctamente</b>
                        </MudText>
                    }
                </div>
            </MudItem>

            @if (isLoading)
            {
                <MudItem xs="12" md="3">
                    <MudDatePicker Label="Desde" @bind-Date="_fchaDesdeWrapper" Variant="MudBlazor.Variant.Outlined" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker Label="Hasta" @bind-Date="_fchaHastaWrapper" Variant="MudBlazor.Variant.Outlined" DateFormat="dd/MM/yyyy" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudSelect T="int" Label="Operación / Cliente" Value="empresa" ValueChanged="OnChangeCliente" Variant="MudBlazor.Variant.Outlined">
                        <MudSelectItem Value="0">Seleccione la operación...</MudSelectItem>
                        @foreach (var item in PayLoadOper)
                        {
                            <MudSelectItem Value="@item.id">@item.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Color="MudBlazor.Color.Secondary"
                               FullWidth="true"
                               OnClick="AgregarNomina"
                               StartIcon="@Icons.Material.Filled.Save"
                               Style="height: 56px; border-radius: 12px; font-weight: 700;">
                        REGISTRAR NOMINA
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudDataGrid T="diasxpagarperiodo" Items="@PayLoadList" Dense="true" Striped="true" RowsPerPage="15" QuickFilter="_quickFilter">
        <ToolBarContent>
            <MudText Typo="MudBlazor.Typo.h6">Vista Previa de Nómina</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Buscar..." Adornment="MudBlazor.Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0" Immediate="true" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.id" Title="No empleado" />
            <PropertyColumn Property="x => x.nombre" Title="Nombre" />
            <PropertyColumn Property="x => x.tipoempleado" Title="Tipo" />
            <PropertyColumn Property="x => x.area" Title="Area" />
            <PropertyColumn Property="x => x.totaldias" Title="Dias" />
            <PropertyColumn Property="x => x.hexpagar" Title="Horas ext" />
            <PropertyColumn Property="x => x.bono" Title="Bono" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="diasxpagarperiodo" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>