@page "/nomina/conciliacion-inss"
@page "/nomina/conciliacion-factura-inss"
@using Modelo.Entidades.Nomina
@using Modelo.Entidades.Entradas.Odoo
@using HostService.Interfaces
@using MediatR
@using BsOperaciones.Application.Features.Odoo.Queries
@using Utilidades.ClasesGenericas
@using System.IO
@using System.Text
@inject IMediator Mediator
@inject IOdooService OdooService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="container-fluid p-4" style="background-color: #f8fafc; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif;">
    
    <!-- Encabezado Principal -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom bg-white p-3 rounded-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0f172a;">
                <i class="bi bi-file-earmark-diff-fill text-primary me-2"></i>Conciliación: Factura INSS vs. Reporte Mensual de Nómina
            </h2>
            <p class="text-secondary small mb-0 fw-semibold">
                Auditoría comparativa del archivo <strong>DetalleFactura.csv del INSS</strong> contra la <strong>Nómina Mensual Cerrada (/nomina/reportes/cierremensual)</strong>. Identifique cobros indebidos, bajas no tramitadas y diferencias en cotización laboral/patronal.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success btn-sm px-3 shadow-sm rounded-pill fw-bold" @onclick="ExportarExcel" disabled="@(!conciliacionList.Any())">
                <i class="bi bi-file-earmark-excel-fill me-1"></i>EXPORTAR EXCEL AUDITORÍA
            </button>
        </div>
    </div>

    <!-- Panel de Selección de Período Mensual y Carga de Archivo INSS -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3" style="color: #1e3a8a;">
                <i class="bi bi-cloud-upload me-2 text-primary"></i>1. Seleccionar Período de Nómina Mensual y Cargar Factura INSS
            </h5>
            
            <div class="row g-3 align-items-end">
                <!-- Selector Año -->
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-secondary">Año Nómina</label>
                    <select class="form-select fw-bold" @bind="anio">
                        <option value="2026">2026</option>
                        <option value="2025">2025</option>
                    </select>
                </div>

                <!-- Selector Mes -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-secondary">Mes de Nómina Mensual</label>
                    <select class="form-select fw-bold" @bind="mes">
                        <option value="1">ENERO (01)</option>
                        <option value="2">FEBRERO (02)</option>
                        <option value="3">MARZO (03)</option>
                        <option value="4">ABRIL (04)</option>
                        <option value="5">MAYO (05)</option>
                        <option value="6">JUNIO (06)</option>
                        <option value="7">JULIO (07)</option>
                        <option value="8">AGOSTO (08)</option>
                        <option value="9">SEPTIEMBRE (09)</option>
                        <option value="10">OCTUBRE (10)</option>
                        <option value="11">NOVIEMBRE (11)</option>
                        <option value="12">DICIEMBRE (12)</option>
                    </select>
                </div>

                <!-- Carga de Archivo DetalleFactura.csv / Excel INSS -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-secondary">Archivo DetalleFactura (.csv / .xlsx)</label>
                    <InputFile id="inssFileInput" OnChange="ProcessInssFile" hidden accept=".csv,.xlsx,.xls" />
                    <label for="inssFileInput" class="btn btn-outline-primary w-100 fw-bold d-flex align-items-center justify-content-center gap-2 py-2" style="border-style: dashed; border-width: 2px;">
                        <i class="bi bi-file-earmark-arrow-up fs-5"></i>
                        @(fileName.Length > 0 ? fileName : "Seleccionar DetalleFactura.csv")
                    </label>
                </div>

                <!-- Botón de Ejecutar Conciliación -->
                <div class="col-md-3">
                    <button class="btn btn-primary w-100 fw-bold py-2 shadow-sm" @onclick="EjecutarConciliacion" disabled="@(processing || string.IsNullOrEmpty(fileName))">
                        @if (processing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-lightning-charge-fill me-1"></i>
                        }
                        CONCILIAR CON NÓMINA MENSUAL
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Indicador de Carga -->
    @if (processing)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary display-4" role="status"></div>
            <p class="text-primary fw-bold mt-3">Obteniendo reporte de Cierre Mensual (@AnioMes()) y cruzando contra Factura INSS...</p>
        </div>
    }
    else if (resumen != null)
    {
        <!-- KPI Cards Summary -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-white rounded-3 p-3" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 me-3 fs-3 d-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.15); width: 50px; height: 50px;">
                            <i class="bi bi-receipt-cutoff text-white"></i>
                        </div>
                        <div>
                            <div class="text-white-50 small fw-bold">TOTAL FACTURA INSS</div>
                            <div class="fs-4 fw-bold text-white">C$ @resumen.TotalMontoFacturaInss.ToString("N2")</div>
                            <div class="small text-white-50">@resumen.TotalPersonasFacturaInss personas facturadas</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-white rounded-3 p-3" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 me-3 fs-3 d-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.15); width: 50px; height: 50px;">
                            <i class="bi bi-cash-stack text-white"></i>
                        </div>
                        <div>
                            <div class="text-white-50 small fw-bold">TOTAL NÓMINA MENSUAL</div>
                            <div class="fs-4 fw-bold text-white">C$ @resumen.TotalMontoNominaEmpresa.ToString("N2")</div>
                            <div class="small text-white-50">@resumen.TotalPersonasNomina personas en reporte</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-white rounded-3 p-3" style="background: @(resumen.DiferenciaNetaTotal > 0 ? "linear-gradient(135deg, #991b1b 0%, #ef4444 100%)" : "linear-gradient(135deg, #065f46 0%, #10b981 100%)");">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 me-3 fs-3 d-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.15); width: 50px; height: 50px;">
                            <i class="bi bi-calculator-fill text-white"></i>
                        </div>
                        <div>
                            <div class="text-white-50 small fw-bold">DIFERENCIA NETA (INSS - NÓMINA)</div>
                            <div class="fs-4 fw-bold text-white">C$ @resumen.DiferenciaNetaTotal.ToString("N2")</div>
                            <div class="small text-white-50">
                                @(resumen.DiferenciaNetaTotal > 0 ? "Cobro demás por el INSS" : "Cobro menor por el INSS")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-white rounded-3 p-3" style="background: linear-gradient(135deg, #b45309 0%, #f59e0b 100%);">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 me-3 fs-3 d-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.15); width: 50px; height: 50px;">
                            <i class="bi bi-exclamation-triangle-fill text-white"></i>
                        </div>
                        <div>
                            <div class="text-white-50 small fw-bold">NOVEDADES A RECLAMAR</div>
                            <div class="fs-4 fw-bold text-white">@resumen.TotalSoloFacturaInss en INSS / @resumen.TotalSoloNomina en Nómina</div>
                            <div class="small text-white-50">@resumen.TotalDiferenciasMonto personas con dif. monto</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pestañas de Filtrado y Vista Tabla -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <ul class="nav nav-pills card-header-pills gap-2">
                    <li class="nav-item">
                        <button class="nav-link btn-sm fw-bold @(activeTab == "TODOS" ? "active" : "")" @onclick='() => activeTab = "TODOS"'>
                            📊 Todos (@conciliacionList.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link btn-sm fw-bold btn-danger @(activeTab == "SOLO_INSS" ? "active" : "")" @onclick='() => activeTab = "SOLO_INSS"'>
                            ⚠️ Solo en INSS (Reclamo) (@resumen.TotalSoloFacturaInss)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link btn-sm fw-bold btn-warning @(activeTab == "SOLO_NOMINA" ? "active" : "")" @onclick='() => activeTab = "SOLO_NOMINA"'>
                            🔴 Solo en Nómina Mensual (@resumen.TotalSoloNomina)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link btn-sm fw-bold btn-info text-white @(activeTab == "DIFERENCIAS" ? "active" : "")" @onclick='() => activeTab = "DIFERENCIAS"'>
                            💵 Dif. Cotización (@resumen.TotalDiferenciasMonto)
                        </button>
                    </li>
                </ul>

                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-white border"><i class="bi bi-search text-dark"></i></span>
                    <input type="text" class="form-control border" style="color: #000; font-weight: 500;" placeholder="Buscar por nombre, cédula o NSS..." @bind="searchFilter" @bind:event="oninput" />
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: #0f172a; font-size: 13px;">
                        <thead style="background-color: #f1f5f9; color: #475569;" class="small fw-bold text-uppercase border-bottom">
                            <tr>
                                <th class="ps-3 py-2">Estado</th>
                                <th class="py-2">Contrato / Empleado</th>
                                <th class="py-2">No. Cédula / No. INSS</th>
                                <th class="py-2">Nombre Empleado</th>
                                <th class="py-2 text-end">Salario Fijo</th>
                                <th class="py-2 text-center">Días Lab.</th>
                                <th class="py-2 text-end">Salario Básico</th>
                                <th class="py-2 text-end">Reportado al INSS (Nómina)</th>
                                <th class="py-2 text-center">Semanas INSS (Archivo)</th>
                                <th class="py-2 text-end">Cobrado Real INSS (Archivo)</th>
                                <th class="py-2 text-end pe-3">Diferencia C$</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredItems)
                            {
                                <tr style="border-bottom: 1px solid #e2e8f0; background-color: @GetRowBgColor(row.Estado);">
                                    <td class="ps-3 py-2">
                                        <span class="badge @GetBadgeClass(row.Estado) px-2 py-1" style="font-size: 11px;">
                                            @row.EstadoBadge
                                        </span>
                                    </td>
                                    <td class="py-2 font-monospace fw-bold">
                                        <div>Contrato: @(row.Contrato > 0 ? row.Contrato.ToString() : "N/A")</div>
                                        <div class="text-secondary small">ID: @(row.EmpleadoId > 0 ? row.EmpleadoId.ToString() : "N/A")</div>
                                    </td>
                                    <td class="py-2 font-monospace">
                                        <div>@(string.IsNullOrEmpty(row.Cedula) ? "SIN CÉDULA" : row.Cedula)</div>
                                        <div class="text-secondary small">INSS: @(string.IsNullOrEmpty(row.Nss) ? "N/A" : row.Nss)</div>
                                    </td>
                                    <td class="py-2 fw-bold text-uppercase">
                                        @row.NombreEmpleado
                                        @if (!string.IsNullOrEmpty(row.ObservacionReclamo))
                                        {
                                            <div class="text-secondary small fw-normal text-muted">@row.ObservacionReclamo</div>
                                        }
                                    </td>
                                    <td class="py-2 text-end fw-semibold">C$ @row.SalarioFijoNomina.ToString("N2")</td>
                                    <td class="py-2 text-center font-monospace fw-bold">@row.DiasLaboradosNomina.ToString("N1")</td>
                                    <td class="py-2 text-end fw-semibold">C$ @row.SalarioBasicoNomina.ToString("N2")</td>
                                    <td class="py-2 text-end fw-bold text-primary">C$ @row.SalarioCotizableNomina.ToString("N2")</td>
                                    <td class="py-2 text-center font-monospace badge bg-light text-dark border align-self-center mt-2">@row.SemanasInssFactura</td>
                                    <td class="py-2 text-end fw-bold text-danger">C$ @row.TotalInss.ToString("N2")</td>
                                    <td class="py-2 text-end pe-3 fw-bold @(row.DiferenciaNetaTotal > 0 ? "text-danger" : (row.DiferenciaNetaTotal < 0 ? "text-success" : "text-dark"))">
                                        C$ @row.DiferenciaNetaTotal.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int anio = DateTime.Now.Year;
    private int mes = DateTime.Now.Month;
    private string fileName = "";
    private byte[] fileBytes = Array.Empty<byte>();
    private bool processing = false;

    private List<FacturaInssLinea> facturaInssLines = new();
    private List<ItemConciliacionInss> conciliacionList = new();
    private ResumenConciliacionInss resumen = null;

    private string activeTab = "TODOS";
    private string searchFilter = "";

    private int AnioMes() => int.Parse($"{anio}{mes:00}");

    private IEnumerable<ItemConciliacionInss> FilteredItems => conciliacionList
        .Where(x => activeTab switch
        {
            "SOLO_INSS" => x.Estado == EstadoConciliacionInss.SoloEnFacturaInss,
            "SOLO_NOMINA" => x.Estado == EstadoConciliacionInss.SoloEnNomina,
            "DIFERENCIAS" => x.Estado == EstadoConciliacionInss.DiferenciaCotizacion,
            _ => true
        })
        .Where(x => string.IsNullOrWhiteSpace(searchFilter) ||
                    x.NombreEmpleado.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
                    x.Cedula.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
                    x.Nss.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
                    x.EmpleadoId.ToString().Contains(searchFilter) ||
                    x.Contrato.ToString().Contains(searchFilter));

    private async Task ProcessInssFile(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            fileName = file.Name;
            using var ms = new MemoryStream();
            await file.OpenReadStream(1024 * 1024 * 15).CopyToAsync(ms);
            fileBytes = ms.ToArray();

            // Parse file lines with robust encoding detection
            facturaInssLines = ParseInssFile(fileBytes, fileName);
            Snackbar.Add($"Archivo '{fileName}' cargado con {facturaInssLines.Count} registros del INSS.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al leer el archivo: {ex.Message}", Severity.Error);
        }
    }

    private List<FacturaInssLinea> ParseInssFile(byte[] bytes, string name)
    {
        var list = new List<FacturaInssLinea>();
        string ext = Path.GetExtension(name).ToLower();

        if (ext == ".csv")
        {
            string content = DecodeFileBytes(bytes);
            string[] lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return list;

            for (int r = 1; r < lines.Length; r++)
            {
                var cols = ParseCsvLine(lines[r]);
                if (cols.Count < 4) continue;

                list.Add(new FacturaInssLinea
                {
                    Nss = cols.Count > 0 ? CleanNumericNss(cols[0]) : "",
                    Nombre = cols.Count > 1 ? cols[1].Trim() : "",
                    Cedula = cols.Count > 2 ? NormalizeCedula(cols[2]) : "",
                    Periodo = cols.Count > 3 ? cols[3].Trim('\'', ' ') : "",
                    Semanas = cols.Count > 4 ? cols[4].Trim('\'', ' ') : "",
                    SalarioCotizado = cols.Count > 5 ? ParseDecimal(cols[5]) : 0m,
                    SalarioReal = cols.Count > 6 ? ParseDecimal(cols[6]) : 0m,
                    AporteLaboral = cols.Count > 7 ? ParseDecimal(cols[7]) : 0m,
                    AportePatronal = cols.Count > 8 ? ParseDecimal(cols[8]) : 0m,
                    Interes = cols.Count > 9 ? ParseDecimal(cols[9]) : 0m,
                    Total = cols.Count > 10 ? ParseDecimal(cols[10]) : 0m
                });
            }
        }
        return list;
    }

    private static string DecodeFileBytes(byte[] bytes)
    {
        try { Encoding.RegisterProvider(CodePagesEncodingProvider.Instance); } catch {}
        
        string utf8Str = Encoding.UTF8.GetString(bytes);
        if (!utf8Str.Contains('\uFFFD'))
        {
            return utf8Str;
        }

        try
        {
            return Encoding.GetEncoding(1252).GetString(bytes);
        }
        catch
        {
            try
            {
                return Encoding.GetEncoding("iso-8859-1").GetString(bytes);
            }
            catch
            {
                return utf8Str;
            }
        }
    }

    private static List<string> ParseCsvLine(string line)
    {
        var fields = new List<string>();
        bool inQuotes = false;
        var currentField = new StringBuilder();

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '"')
            {
                inQuotes = !inQuotes;
            }
            else if ((c == ',' || c == ';') && !inQuotes)
            {
                fields.Add(currentField.ToString().Trim(' ', '"', '\''));
                currentField.Clear();
            }
            else
            {
                currentField.Append(c);
            }
        }
        fields.Add(currentField.ToString().Trim(' ', '"', '\''));
        return fields;
    }

    private static string NormalizeCedula(string ced)
    {
        if (string.IsNullOrWhiteSpace(ced)) return "";
        return ced.Replace("-", "").Replace(" ", "").Trim().ToUpper();
    }

    private static string CleanNumericNss(string ssn)
    {
        if (string.IsNullOrWhiteSpace(ssn)) return "";
        string clean = ssn.Split('.')[0].Split(',')[0].Trim();
        var sb = new StringBuilder();
        foreach (char c in clean)
        {
            if (char.IsDigit(c)) sb.Append(c);
        }
        return sb.ToString();
    }

    private static string NormalizeName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        string upper = name.Trim().ToUpper();
        upper = upper.Replace('Á', 'A').Replace('É', 'E').Replace('Í', 'I').Replace('Ó', 'O').Replace('Ú', 'U')
                     .Replace('Ñ', 'N').Replace('Ü', 'U');
        var sb = new StringBuilder();
        foreach (char c in upper)
        {
            if (char.IsLetterOrDigit(c) || c == ' ') sb.Append(c);
        }
        return string.Join(" ", sb.ToString().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries));
    }

    private static decimal ParseDecimal(string val)
    {
        if (string.IsNullOrWhiteSpace(val)) return 0m;
        val = val.Replace("$", "").Replace("C$", "").Replace(",", "").Trim();
        if (decimal.TryParse(val, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal res))
        {
            return res;
        }
        return 0m;
    }

    private async Task EjecutarConciliacion()
    {
        if (!facturaInssLines.Any())
        {
            Snackbar.Add("Cargue primero el archivo DetalleFactura de INSS.", Severity.Warning);
            return;
        }

        processing = true;
        StateHasChanged();
        await Task.Delay(100);

        try
        {
            // 1. Obtener la Nómina Mensual Cerrada para el período anioMes seleccionados
            var respNomina = await Mediator.Send(new GetAllNominaMensualCierreQuery(AnioMes()));
            var nominaList = respNomina.Model ?? new List<PayrollMonthRecord>();

            // 2. Obtener lista de Empleados para obtener cédulas oficiales
            var respEmp = await Mediator.Send(new GetAllEmpleadosQuery());
            var empList = respEmp.Model ?? new List<EmpleadosActivos>();

            var dictEmpById = empList.GroupBy(e => e.IdNomina).ToDictionary(g => g.Key, g => g.First());

            // Indexes for fast lookup
            var dictEmpByCed = empList.Where(e => !string.IsNullOrWhiteSpace(e.NoCedula))
                                      .GroupBy(e => NormalizeCedula(e.NoCedula))
                                      .ToDictionary(g => g.Key, g => g.First());

            var dictEmpByNss = empList.Where(e => e.NoInss > 0)
                                      .GroupBy(e => CleanNumericNss(e.NoInss.ToString("0")))
                                      .ToDictionary(g => g.Key, g => g.First());

            var dictNominaByNss = nominaList.Where(n => !string.IsNullOrWhiteSpace(n.noinss))
                                           .GroupBy(n => CleanNumericNss(n.noinss))
                                           .ToDictionary(g => g.Key, g => g.First());

            var dictNominaById = nominaList.GroupBy(n => n.id).ToDictionary(g => g.Key, g => g.First());

            conciliacionList = new List<ItemConciliacionInss>();
            var nominaIdsProcesadas = new HashSet<int>();

            // 3. Conciliar cada línea de la Factura INSS usando algoritmo multinivel (Cédula -> NSS numérico -> Nombre)
            foreach (var inss in facturaInssLines)
            {
                string normCedInss = NormalizeCedula(inss.Cedula);
                string cleanNssInss = CleanNumericNss(inss.Nss);
                string normNameInss = NormalizeName(inss.Nombre);

                PayrollMonthRecord nomMatch = null;
                EmpleadosActivos empInfoMatch = null;

                // Nivel 1: Búsqueda en EmpleadosActivos por Cédula o NSS limpia
                if (!string.IsNullOrEmpty(normCedInss) && dictEmpByCed.TryGetValue(normCedInss, out var matchCedEmp))
                {
                    empInfoMatch = matchCedEmp;
                }
                else if (!string.IsNullOrEmpty(cleanNssInss) && dictEmpByNss.TryGetValue(cleanNssInss, out var matchNssEmp))
                {
                    empInfoMatch = matchNssEmp;
                }
                else
                {
                    empInfoMatch = empList.FirstOrDefault(e => NormalizeName(e.NombreCompleto) == normNameInss);
                }

                // Nivel 2: Obtener registro de Nómina Mensual
                if (empInfoMatch != null && dictNominaById.TryGetValue(empInfoMatch.IdNomina, out var nomById))
                {
                    nomMatch = nomById;
                }
                else if (!string.IsNullOrEmpty(cleanNssInss) && dictNominaByNss.TryGetValue(cleanNssInss, out var nomByNss))
                {
                    nomMatch = nomByNss;
                }
                else
                {
                    nomMatch = nominaList.FirstOrDefault(n => NormalizeName(n.nombre) == normNameInss);
                }

                var item = new ItemConciliacionInss
                {
                    Cedula = inss.Cedula,
                    Nss = inss.Nss,
                    NombreEmpleado = inss.Nombre,
                    SemanasInssFactura = inss.Semanas,
                    SalarioCotizadoInss = inss.SalarioCotizado,
                    AporteLaboralInss = inss.AporteLaboral,
                    AportePatronalInss = inss.AportePatronal,
                    TotalInss = inss.Total
                };

                if (nomMatch != null)
                {
                    nominaIdsProcesadas.Add(nomMatch.id);
                    item.EmpleadoId = nomMatch.id;
                    item.Contrato = nomMatch.contrato;
                    item.SalarioFijoNomina = nomMatch.sal_fijo;
                    item.DiasLaboradosNomina = nomMatch.diaslab;
                    item.HorasExtrasNomina = nomMatch.no_hras_extra;
                    item.SemanasInssNomina = nomMatch.semanas_inss;

                    if (empInfoMatch != null && !string.IsNullOrEmpty(empInfoMatch.NoCedula))
                    {
                        item.Cedula = empInfoMatch.NoCedula;
                    }
                    else if (dictEmpById.TryGetValue(nomMatch.id, out var empByIdInfo) && !string.IsNullOrEmpty(empByIdInfo.NoCedula))
                    {
                        item.Cedula = empByIdInfo.NoCedula;
                    }

                    // Valores de la Nómina Mensual
                    item.SalarioBasicoNomina = nomMatch.sal_basico;
                    item.SalarioCotizableNomina = nomMatch.reporte_inss;
                    item.InssRetenidoNomina = nomMatch.reporte_inss_real > 0 ? nomMatch.reporte_inss_real : nomMatch.deduc_inss;
                    item.InssPatronalNomina = Math.Round(nomMatch.reporte_inss * 0.225m, 2);

                    decimal difSalario = Math.Abs(inss.SalarioCotizado - nomMatch.reporte_inss);
                    if (difSalario <= 2.00m)
                    {
                        item.Estado = EstadoConciliacionInss.CoincideCorrecto;
                        item.ObservacionReclamo = "Conforme";
                    }
                    else
                    {
                        item.Estado = EstadoConciliacionInss.DiferenciaCotizacion;
                        item.ObservacionReclamo = $"Diferencia en Salario Cotizable: INSS C$ {inss.SalarioCotizado:N2} vs Nómina C$ {nomMatch.reporte_inss:N2}";
                    }
                }
                else if (empInfoMatch != null)
                {
                    item.EmpleadoId = empInfoMatch.IdNomina;
                    item.Cedula = empInfoMatch.NoCedula;
                    item.Estado = EstadoConciliacionInss.SoloEnFacturaInss;
                    item.ObservacionReclamo = "Empleado registrado en la empresa pero no fue liquidado en este período de Cierre Mensual";
                }
                else
                {
                    item.Estado = EstadoConciliacionInss.SoloEnFacturaInss;
                    item.ObservacionReclamo = "Cobro indebido INSS / Empleado no figura en la nómina ni base de la empresa (Reclamar al INSS)";
                }

                conciliacionList.Add(item);
            }

            // 4. Identificar empleados en Nómina Mensual pero NO en Factura INSS
            foreach (var nom in nominaList)
            {
                if (!nominaIdsProcesadas.Contains(nom.id))
                {
                    string ced = "";
                    if (dictEmpById.TryGetValue(nom.id, out var empInfo))
                    {
                        ced = empInfo.NoCedula;
                    }

                    decimal inssLab = nom.reporte_inss_real > 0 ? nom.reporte_inss_real : nom.deduc_inss;
                    decimal inssPat = Math.Round(nom.reporte_inss * 0.225m, 2);

                    conciliacionList.Add(new ItemConciliacionInss
                    {
                        EmpleadoId = nom.id,
                        Contrato = nom.contrato,
                        Cedula = ced,
                        Nss = CleanNumericNss(nom.noinss),
                        NombreEmpleado = nom.nombre,
                        SalarioFijoNomina = nom.sal_fijo,
                        DiasLaboradosNomina = nom.diaslab,
                        HorasExtrasNomina = nom.no_hras_extra,
                        SemanasInssNomina = nom.semanas_inss,
                        Estado = EstadoConciliacionInss.SoloEnNomina,
                        SalarioBasicoNomina = nom.sal_basico,
                        SalarioCotizableNomina = nom.reporte_inss,
                        InssRetenidoNomina = inssLab,
                        InssPatronalNomina = inssPat,
                        ObservacionReclamo = "Empleado activo en Nómina Mensual pero no cobrado en Factura INSS"
                    });
                }
            }

            // 5. Calcular Resumen KPIs
            resumen = new ResumenConciliacionInss
            {
                TotalPersonasFacturaInss = facturaInssLines.Count,
                TotalPersonasNomina = nominaList.Count,
                TotalCoincidentesExactos = conciliacionList.Count(x => x.Estado == EstadoConciliacionInss.CoincideCorrecto),
                TotalDiferenciasMonto = conciliacionList.Count(x => x.Estado == EstadoConciliacionInss.DiferenciaCotizacion),
                TotalSoloFacturaInss = conciliacionList.Count(x => x.Estado == EstadoConciliacionInss.SoloEnFacturaInss),
                TotalSoloNomina = conciliacionList.Count(x => x.Estado == EstadoConciliacionInss.SoloEnNomina),
                TotalMontoFacturaInss = conciliacionList.Sum(x => x.TotalInss),
                TotalMontoNominaEmpresa = conciliacionList.Sum(x => x.TotalNomina)
            };

            Snackbar.Add($"Conciliación finalizada: {conciliacionList.Count} registros comparados contra Nómina {AnioMes()}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error durante la conciliación: {ex.Message}", Severity.Error);
        }
        finally
        {
            processing = false;
        }
    }

    private string GetRowBgColor(EstadoConciliacionInss est) => est switch
    {
        EstadoConciliacionInss.CoincideCorrecto => "#ffffff",
        EstadoConciliacionInss.DiferenciaCotizacion => "#eff6ff",
        EstadoConciliacionInss.SoloEnFacturaInss => "#fef2f2",
        EstadoConciliacionInss.SoloEnNomina => "#fffbeb",
        _ => "#ffffff"
    };

    private string GetBadgeClass(EstadoConciliacionInss est) => est switch
    {
        EstadoConciliacionInss.CoincideCorrecto => "bg-success text-white",
        EstadoConciliacionInss.DiferenciaCotizacion => "bg-primary text-white",
        EstadoConciliacionInss.SoloEnFacturaInss => "bg-danger text-white",
        EstadoConciliacionInss.SoloEnNomina => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };

    private async Task ExportarExcel()
    {
        if (!conciliacionList.Any()) return;
        try
        {
            var excelData = DataExcel.CreateExcel(conciliacionList, $"Conciliacion_INSS_{AnioMes()}");
            string base64 = Convert.ToBase64String(excelData.Data);
            await JSRuntime.InvokeVoidAsync("downloadFile", "application/xlsx", base64, $"Conciliacion_INSS_VS_Nomina_{AnioMes()}_{DateTime.Now:yyyyMMdd}.xlsx");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar Excel: {ex.Message}", Severity.Error);
        }
    }
}
