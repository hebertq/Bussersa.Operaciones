@using Modelo.Entidades.Entradas.Odoo

<MudContainer MaxWidth="MudBlazor.MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="0" Class="pa-6 mb-6 glass-card card-lift">
        <MudText Typo="MudBlazor.Typo.h5" Color="MudBlazor.Color.Primary" Class="mb-4" Style="font-weight: 800;">
            <MudIcon Icon="@Icons.Material.Outlined.LockClock" Class="mr-2" />
            Cierre de Nóminas Activas
        </MudText>

        <MudAlert Severity="MudBlazor.Severity.Info" Variant="MudBlazor.Variant.Outlined" Dense="false">
            El cierre de lotes de nómina y liquidaciones se realiza ahora directamente desde <b>Odoo (Nómina &rarr; Lotes)</b> para garantizar el cierre automático de las nóminas individuales y su contabilización automática en Contabilidad.
        </MudAlert>
    </MudPaper>
</MudContainer>