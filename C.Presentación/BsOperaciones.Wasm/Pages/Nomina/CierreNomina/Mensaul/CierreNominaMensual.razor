@using System.Text
@using System.IO
@using BsOperaciones.Application.Features.Odoo.Command
@using BsOperaciones.Application.Features.Odoo.Queries
@using BsOperaciones.Application.Features.Odoo.Commands
@using Modelo.Entidades.Entradas.Odoo
@using System.Data;
@using System.Linq;
@using Modelo.Report
@inject IDialogService DialogService
@inject IMediator _mediator
@inject IUtilidades _Util
@inject ISnackbar Snackbar

@* Bloqueo de pantalla para procesos asíncronos *@
<MudOverlay Visible="isloaddata" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Sincronizando con el servidor...</MudText>
    </div>
</MudOverlay>

@* Control de pasos mediante enlace bidireccional *@
<MudStepper @bind-ActiveIndex="_activeIndex" NonLinear="false" CenterLabels="true" Class="mud-width-full">
    <MudStep Title="Validar Empleados Activos">
        <TablaEmpleadosActivos _PayLoadList="@(_PayLoadListInss.Cast<EmpleadosActivos>().ToList())"
                               OnLoadFiles="LoadFiles"
                               OnUpdateEmpleados="UpdateEmpleados" 
                               BotonEnabled="BotonEnabledActivosInss" />
    </MudStep>

    <MudStep Title="Conciliación de Montos">
        @* Pasamos el estado global de la nómina, año y mes *@
        <ConciliacionMontos @bind-Anio="_anioGlobal"
                            @bind-Mes="_mesGlobal"
                            NominaFinalGlobal="_nominaFinalGlobal"
                            OnProcessing="@((bool loading) => isloaddata = loading)"
                            OnNominaGenerated="HandleNominaGenerated" />
    </MudStep>

    <MudStep Title="Auditoría de Integridad">
        <ValidacionFinalCierre ListaInss="@(_PayLoadListInss.Cast<EmpleadosActivos>().ToList())"
                               ListaNomina="_nominaFinalGlobal" />
    </MudStep>
</MudStepper>

@code {
    private long maxFileSize = 1024 * 1024 * 15;
    public bool BotonEnabledActivosInss { get; set; } = true;
    private int _activeIndex = 0;
    private bool isloaddata = false;
    private int _anioGlobal = DateTime.Now.Year;
    private int _mesGlobal = DateTime.Now.Month;
    private List<EmpleadosActivos?> _PayLoadListLocal = new();
    private List<EmpleadosActivos?> _PayLoadListInss = new();
    private List<NominaMensualReportar> _nominaFinalGlobal = new();

    protected override async Task OnInitializedAsync()
    {
         await LoadEmpleados();
        _PayLoadListInss = new(); // Aseguramos que empiece vacío visualmente
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        isloaddata = true;
        try
        {
            string sFileExtension = Path.GetExtension(e.File.Name).ToLower();
            DataTable dataActivos = new DataTable();

            using (MemoryStream fs = new MemoryStream())
            {
                await e.File.OpenReadStream(maxFileSize).CopyToAsync(fs);
                fs.Position = 0;
                dataActivos = _Util.Excel_To_DataTable(fs, "ActivosInss", sFileExtension, 0);
            }

            var result = ExtCierreMensual.GetEmpActivosInss(_PayLoadListLocal, dataActivos);
            _PayLoadListInss = result.Cast<EmpleadosActivos?>().ToList();

            BotonEnabledActivosInss = false;
            Snackbar.Add("Archivo procesado. Verifique los registros con ID 0.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al procesar: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            isloaddata = false;
        }
    }
    private void HandleNominaGenerated(List<NominaMensualReportar> nomina)
    {
        _nominaFinalGlobal = nomina;
        _activeIndex = 2; // SALTO AUTOMÁTICO AL PASO 3
        StateHasChanged(); // Permite que el paso 3 reciba los datos sin saltar automáticamente
    }

    private async Task LoadEmpleados()
    {
        var respemp = await _mediator.Send(new GetAllEmpleadosQuery());
        if (!respemp.Respuesta.ExisteError)
            _PayLoadListLocal = respemp.Model;
    }

    private async Task UpdateEmpleados()
    {
        // Filtramos vinculados y activos reales
        var vinculados = _PayLoadListInss.Where(x => x != null && x.IdNomina > 0 && x.ActivoInss == true).Cast<EmpleadosActivos>().ToList();

        if (!vinculados.Any())
        {
            Snackbar.Add("No hay empleados aptos para actualización masiva.", MudBlazor.Severity.Warning);
            return;
        }

        bool? result = await DialogService.ShowMessageBox(
            "Sincronización con Odoo",
            $"Se procederá a actualizar {vinculados.Count} registros. Los empleados no vinculados (ID 0) se mantendrán en la lista para su revisión.",
            yesText: "Aceptar", cancelText: "Cancelar");

        if (result == true)
        {
            isloaddata = true;
            try
            {
                var command = new ActualizarEstadosEmpleadosCommand(vinculados);
                var response = await _mediator.Send(command);

                if (response.Respuesta.ExisteError)
                {
                    Snackbar.Add(response.Respuesta.MensajeError, MudBlazor.Severity.Error);
                }
                else
                {
                    Snackbar.Add("Sincronización masiva exitosa.", MudBlazor.Severity.Success);

                    // Mantenemos _PayLoadList intacto para el Paso 2
                    BotonEnabledActivosInss = true;

                    // Avanzamos al Paso 2 automáticamente
                    _activeIndex = 1; // AVANCE AL PASO 2 TRAS SINCRONIZAR
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error de conexión: " + ex.Message, MudBlazor.Severity.Error);
            }
            finally
            {
                isloaddata = false;
            }
        }
    }
}