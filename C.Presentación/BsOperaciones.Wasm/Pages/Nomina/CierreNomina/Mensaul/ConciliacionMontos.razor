@using Modelo.Report
@using Utilidades.ClasesGenericas

<MudPaper Elevation="0" Class="pa-6" Style="background-color: #f8fafc; border-radius: 12px;">
    <MudGrid Spacing="3" Class="align-end">
        <MudItem xs="12" sm="4">
            <MudSelect T="int" Label="Año a Cerrar" @bind-Value="_anioSeleccionado"
                       Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense">
                <MudSelectItem Value="@(DateTime.Now.Year)">@(DateTime.Now.Year)</MudSelectItem>
                <MudSelectItem Value="@(DateTime.Now.Year - 1)">@(DateTime.Now.Year - 1)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="int" Label="Mes a Cerrar" @bind-Value="_mesSeleccionado"
                       Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense">
                <MudSelectItem Value="1">Enero</MudSelectItem>
                <MudSelectItem Value="2">Febrero</MudSelectItem>
                <MudSelectItem Value="3">Marzo</MudSelectItem>
                <MudSelectItem Value="4">Abril</MudSelectItem>
                <MudSelectItem Value="5">Mayo</MudSelectItem>
                <MudSelectItem Value="6">Junio</MudSelectItem>
                <MudSelectItem Value="7">Julio</MudSelectItem>
                <MudSelectItem Value="8">Agosto</MudSelectItem>
                <MudSelectItem Value="9">Septiembre</MudSelectItem>
                <MudSelectItem Value="10">Octubre</MudSelectItem>
                <MudSelectItem Value="11">Noviembre</MudSelectItem>
                <MudSelectItem Value="12">Diciembre</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.LockOpen"
                       OnClick="ConfirmarEjecucionCierre" FullWidth="true" Style="height: 40px;">
                EJECUTAR CIERRE MENSUAL
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_nominaFinal != null && _nominaFinal.Any())
    {
        <MudDivider Class="my-5" />

        @* Tarjetas KPIs de Nómina *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-4 d-flex align-center gap-3" Style="background-color: #f1f5f9; border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" />
                    <div>
                        <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">Total Colaboradores</MudText>
                        <MudText Typo="MudBlazor.Typo.h6"><b>@_nominaFinal.Count</b></MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-4 d-flex align-center gap-3" Style="background-color: #f0fdf4; border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Large" />
                    <div>
                        <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">Novedad 03 (&gt;28 días)</MudText>
                        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Success"><b>@_nominaFinal.Count(x => (x.emp_diaslab ?? 0) > 28)</b></MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-4 d-flex align-center gap-3" Style="background-color: #fffbeb; border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Large" />
                    <div>
                        <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">Novedad 04 (≤28 días)</MudText>
                        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Warning"><b>@_nominaFinal.Count(x => (x.emp_diaslab ?? 0) <= 28)</b></MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-4 d-flex align-center gap-3" Style="background-color: #eff6ff; border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Color="MudBlazor.Color.Info" Size="MudBlazor.Size.Large" />
                    <div>
                        <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">Total Disponible (A Recibir)</MudText>
                        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Info"><b>C$ @_nominaFinal.Sum(x => x.emp_pago_recibir ?? 0).ToString("N2")</b></MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudDataGrid T="NominaMensualReportar" Items="@_nominaFinal" Dense="true" Elevation="0"
                     ReadOnly="true" Bordered="true" Striped="true" Height="450px" FixedHeader="true"
                     QuickFilter="@_quickFilter">
            <ToolBarContent>
                <div>
                    <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Primary">
                        <b>Previsualización de Nómina Consolidada</b>
                    </MudText>
                    <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">
                        Nómina mensual calculada y conciliada para el período @_mesSeleccionado / @_anioSeleccionado
                    </MudText>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Buscar por Nombre o INSS..."
                              Adornment="MudBlazor.Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="MudBlazor.Size.Medium" Class="mt-0 mr-4" Immediate="true" Margin="MudBlazor.Margin.Dense" />
                <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Success"
                           StartIcon="@Icons.Custom.FileFormats.FileExcel"
                           OnClick="DescargarNominaInss" Size="MudBlazor.Size.Small">
                    DESCARGAR EXCEL NOMINA
                </MudButton>
            </ToolBarContent>
            <Columns>
                <TemplateColumn Title="No Inss">
                    <CellTemplate>
                        @(InssReporteHelper.CleanInss(context.Item.emp_noinss))
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.emp_nombre" Title="Colaborador" />
                <TemplateColumn Title="Novedad">
                    <CellTemplate>
                        <MudChip T="string" Color="@(context.Item.emp_tipo_novedad == "03" ? MudBlazor.Color.Success : MudBlazor.Color.Warning)"
                                 Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Filled">
                            @context.Item.emp_tipo_novedad
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Semanas">
                    <CellTemplate>
                        <span class="font-monospace">@(InssReporteHelper.CalcularSemanasInss(context.Item.fec_inicio, context.Item.fec_fin, context.Item.emp_diaslab ?? 0, _anioSeleccionado, _mesSeleccionado))</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.emp_diaslab" Title="Días Lab." />
                <PropertyColumn Property="x => x.emp_sal_basico" Title="Salario Básico" Format="N2" />
                <TemplateColumn Title="Prestaciones">
                    <CellTemplate>
                        @(context.Item.emp_prestaciones.HasValue && context.Item.emp_prestaciones > 0 
                            ? context.Item.emp_prestaciones.Value.ToString("N2") 
                            : "-")
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.emp_pago_recibir" Title="Disponible (A Recibir)" Format="N2" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="NominaMensualReportar" />
            </PagerContent>
        </MudDataGrid>
    }
    else
    {
        <MudDivider Class="my-6" />
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="MudBlazor.Variant.Outlined" Class="my-4">
            Seleccione el Año y Mes a cerrar y presione <b>EJECUTAR CIERRE MENSUAL</b> para consolidar la nómina del período.
        </MudAlert>
    }
</MudPaper>
