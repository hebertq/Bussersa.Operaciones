@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Report

<MudOverlay Visible="isloading" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Generando reporte Excel...</MudText>
    </div>
</MudOverlay>

<MudPaper Elevation="0" Class="pa-6" Style="background-color: #fff5f5; border: 1px solid #ffcdd2; border-radius: 12px;">
    <MudText Typo="MudBlazor.Typo.h5" Color="MudBlazor.Color.Error" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-2" /> Auditoría de Integridad y Cumplimiento INSS
    </MudText>

    @if (sinNomina.Any() || sinCobroInss.Any())
    {
        <MudGrid>
            @* Alerta 1: Personas sin Nómina *@
            @if (sinNomina.Any())
            {
                <MudItem xs="12">
                    <MudAlert Severity="MudBlazor.Severity.Error" Variant="MudBlazor.Variant.Filled" Class="mb-2">
                        <b>DISCREPANCIA DE ACTIVOS:</b> @sinNomina.Count personas aseguradas que NO aparecen en la nómina.
                    </MudAlert>
                </MudItem>
            }

            @* Alerta 2: Personas con INSS en Cero *@
            @if (sinCobroInss.Any())
            {
                <MudItem xs="12">
                    <MudAlert Severity="MudBlazor.Severity.Warning" Variant="MudBlazor.Variant.Filled" Class="mb-2" Style="background-color: #ff9800;">
                        <b>ALERTA DE REPORTE:</b> @sinCobroInss.Count personas activas con deducción de INSS en C$ 0.00.
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>

        <MudTable T="AuditoriaInssModel" Items="@ObtenerListaConsolidada()" Dense="true" Bordered="true" Striped="true" Class="mt-4">
            <ToolBarContent>
                <MudText Typo="MudBlazor.Typo.h6">Detalle de Anomalías Detectadas</MudText>
                <MudSpacer />
                <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Dark"
                           StartIcon="@Icons.Custom.FileFormats.FileExcel" OnClick="DescargarAuditoria">
                    EXPORTAR AUDITORÍA
                </MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>No. INSS</MudTh>
                <MudTh>Nombre del Colaborador</MudTh>
                <MudTh>Categoría de Error</MudTh>
                <MudTh>Estado en Nómina</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.NoInss</MudTd>
                <MudTd>@context.Nombre</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(context.ErrorTipo == "SIN PAGO" ? MudBlazor.Color.Error : MudBlazor.Color.Warning)" Size="MudBlazor.Size.Small">
                        @context.ErrorTipo
                    </MudChip>
                </MudTd>
                <MudTd>@context.EstadoNomina</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudAlert Severity="MudBlazor.Severity.Success" Variant="MudBlazor.Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">
            Integridad Verificada: Todos los activos tienen pago y deducción de ley correspondiente.
        </MudAlert>
    }
</MudPaper>