@using Modelo.Entidades.Entradas.Odoo
@using Modelo.Report
@using Utilidades.ClasesGenericas

<MudOverlay Visible="isloading" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center">
        <MudProgressCircular Color="MudBlazor.Color.Secondary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Surface" Class="mt-3">Generando reporte de auditoría...</MudText>
    </div>
</MudOverlay>

<MudPaper Elevation="0" Class="pa-6" Style="background-color: #f8fafc; border-radius: 12px;">
    @* Tarjetas de Resumen de Auditoría *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0" Class="pa-4 d-flex align-center gap-3" Style="background-color: #f1f5f9; border-radius: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" />
                <div>
                    <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">Activos Reportados INSS</MudText>
                    <MudText Typo="MudBlazor.Typo.h6"><b>@(ListaInss?.Count(x => x.ActivoInss == true) ?? 0)</b></MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0" Class="pa-4 d-flex align-center gap-3" Style="background-color: #f0fdf4; border-radius: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Large" />
                <div>
                    <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">En Nómina Consolidada</MudText>
                    <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Success"><b>@(ListaNomina?.Count ?? 0)</b></MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="4">
            @{
                int anomalías = ObtenerListaConsolidada().Count;
            }
            <MudPaper Elevation="0" Class="pa-4 d-flex align-center gap-3" 
                      Style="@(anomalías > 0 ? "background-color: #fff1f2; border-radius: 8px;" : "background-color: #f0fdf4; border-radius: 8px;")">
                <MudIcon Icon="@(anomalías > 0 ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)" 
                         Color="@(anomalías > 0 ? MudBlazor.Color.Error : MudBlazor.Color.Success)" Size="MudBlazor.Size.Large" />
                <div>
                    <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">Discrepancias Totales</MudText>
                    <MudText Typo="MudBlazor.Typo.h6" Color="@(anomalías > 0 ? MudBlazor.Color.Error : MudBlazor.Color.Success)">
                        <b>@(anomalías > 0 ? anomalías.ToString() : "0 (Conforme)")</b>
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (ListaNomina == null || !ListaNomina.Any())
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="MudBlazor.Variant.Outlined" Class="my-4" Icon="@Icons.Material.Filled.Info">
            <b>Esperando Consolidación de Nómina:</b> Ejecute el cierre de nómina en la pestaña <b>2. Conciliación & Cierre</b> para procesar la auditoría de integridad contra los colaboradores asegurados.
        </MudAlert>
    }
    else if (sinNomina.Any() || sinCobroInss.Any())
    {
        @* Alerta 1: Personas sin Nómina *@
        @if (sinNomina.Any())
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Variant="MudBlazor.Variant.Filled" Class="mb-3" Icon="@Icons.Material.Filled.ErrorOutline">
                <b>DISCREPANCIA DE ACTIVOS:</b> Se identificaron <b>@sinNomina.Count</b> personas aseguradas activas que <b>NO</b> aparecen en el cálculo de nómina.
            </MudAlert>
        }

        @* Alerta 2: Personas con INSS en Cero *@
        @if (sinCobroInss.Any())
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Variant="MudBlazor.Variant.Filled" Class="mb-3" Icon="@Icons.Material.Filled.WarningAmber">
                <b>ALERTA DE REPORTE:</b> Se identificaron <b>@sinCobroInss.Count</b> personas activas con deducción de INSS en C$ 0.00.
            </MudAlert>
        }

        <MudTable T="AuditoriaInssModel" Items="@ListaFiltrada" Dense="true" Bordered="true" Striped="true" Class="mt-2" Elevation="0">
            <ToolBarContent>
                <div>
                    <MudText Typo="MudBlazor.Typo.h6" Color="MudBlazor.Color.Primary">
                        <b>Detalle de Anomalías Detectadas</b>
                    </MudText>
                    <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">
                        Revise las inconsistencias antes de someter el lote al INSS
                    </MudText>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Buscar anomalía..."
                              Adornment="MudBlazor.Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="MudBlazor.Size.Medium" Class="mt-0 mr-4" Immediate="true" Margin="MudBlazor.Margin.Dense" />
                <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Dark"
                           StartIcon="@Icons.Custom.FileFormats.FileExcel" OnClick="DescargarAuditoria" Size="MudBlazor.Size.Small">
                    EXPORTAR AUDITORÍA
                </MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>No. INSS</MudTh>
                <MudTh>Cédula</MudTh>
                <MudTh>Nombre del Colaborador</MudTh>
                <MudTh>Categoría</MudTh>
                <MudTh>Estado Nómina</MudTh>
                <MudTh>Causa / Detalle</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.NoInss</MudTd>
                <MudTd>@context.Cedula</MudTd>
                <MudTd><b>@context.Nombre</b></MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(context.ErrorTipo == "SIN PAGO" ? MudBlazor.Color.Error : MudBlazor.Color.Warning)" 
                             Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Filled">
                        @context.ErrorTipo
                    </MudChip>
                </MudTd>
                <MudTd>@context.EstadoNomina</MudTd>
                <MudTd>
                    <MudText Typo="MudBlazor.Typo.body2" Color="MudBlazor.Color.Secondary">@context.Observacion</MudText>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Filas por página:" />
            </PagerContent>
        </MudTable>
    }
    else
    {
        <MudAlert Severity="MudBlazor.Severity.Success" Variant="MudBlazor.Variant.Outlined" Class="my-4" Icon="@Icons.Material.Filled.Verified">
            <b>Auditoría Conforme:</b> No se detectaron discrepancias entre los colaboradores activos y los registrados en la nómina. Todos los colaboradores asegurados cuentan con su cálculo correspondiente.
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="pa-4 mt-4 d-flex align-center justify-space-between flex-wrap gap-3" 
              Style="background-color: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 10px;">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="MudBlazor.Color.Info" />
            <MudText Typo="MudBlazor.Typo.body2">
                Una vez verificadas las anomalías, diríjase a la pestaña <b>4. Archivo Masivo INSS</b> para descargar los formatos oficiales para el portal.
            </MudText>
        </div>
    </MudPaper>
</MudPaper>
