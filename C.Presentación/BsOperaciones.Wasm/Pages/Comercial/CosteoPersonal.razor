@page "/comercial/costeo-personal"
@using Modelo.Comercial
@using HostService.Interfaces
@inject IOdooService _OdooService
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-6 font-bold" Style="background: linear-gradient(90deg, #1A237E, #0288D1); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Cotizador de Servicios de Personal (Cálculo por Horas)
    </MudText>

    <MudGrid>
        <!-- Formulario de Entrada (Izquierda) -->
        <MudItem XS="12" MD="7">
            <MudCard Elevation="4" Class="pa-6" Style="border-radius: 12px; border-top: 4px solid #1A237E;">
                <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Datos de Entrada</MudText>
                
                <MudTextField @bind-Value="cliente" Label="Nombre del Cliente / Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Required="true" />
                
                <MudGrid>
                    <MudItem XS="12" SM="6">
                        <MudNumericField T="decimal" @bind-Value="salarioBase" Label="Salario Base (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                    </MudItem>
                    <MudItem XS="12" SM="6">
                        <MudNumericField T="decimal" @bind-Value="utilidadPorcentaje" Label="Margen de Utilidad (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" Max="99.0m" Min="1.0m" />
                    </MudItem>
                </MudGrid>

                <MudGrid>
                    <MudItem XS="12" SM="6" MD="4">
                        <MudNumericField T="decimal" @bind-Value="supervision" Label="Supervisión mensual (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                    </MudItem>
                    <MudItem XS="12" SM="6" MD="4">
                        <MudNumericField T="decimal" @bind-Value="cargos" Label="Cargos Operativos (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                    </MudItem>
                    <MudItem XS="12" SM="12" MD="4">
                        <MudNumericField T="decimal" @bind-Value="seguros" Label="Seguros de Ley (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                    </MudItem>
                </MudGrid>                <MudNumericField T="decimal" @bind-Value="gastosOperativos" Label="Otros Gastos Administrativos (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Format="N2" />
                
                <MudText Typo="Typo.caption" Class="text-muted d-block mb-6">
                    * El costo de prestaciones sociales está fijado al 74.3% del salario base (cubre feriados, domingos, 22.5% de INSS patronal y 3.0% de subsidio/colchón).
                </MudText>

                <!-- Viáticos -->
                <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Viáticos y Beneficios Mensuales</MudText>
                <MudSimpleTable Style="overflow-x: auto;" Class="mb-6" Elevation="1" Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th style="width: 60px; text-align: center;">Elegir</th>
                            <th>Concepto</th>
                            <th style="width: 150px; text-align: right;">Costo Catálogo</th>
                            <th style="width: 180px; text-align: right;">Costo Cotización</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var viatico in viaticosList)
                        {
                            <tr>
                                <td style="text-align: center; vertical-align: middle;">
                                    <MudCheckBox T="bool" Checked="@IsViaticoSelected(viatico.Id)" CheckedChanged="@((bool val) => ToggleViatico(viatico.Id, val))" Color="Color.Primary" Dense="true" Style="margin: 0 auto; display: table;" />
                                </td>
                                <td style="vertical-align: middle;">@viatico.Nombre</td>
                                <td style="text-align: right; vertical-align: middle;">C$ @viatico.CostoMensual.ToString("N2")</td>
                                <td style="vertical-align: middle;">
                                    <MudNumericField T="decimal" Value="@GetViaticoCost(viatico.Id)" ValueChanged="@((decimal val) => SetViaticoCost(viatico.Id, val))" Disabled="@(!IsViaticoSelected(viatico.Id))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentText="C$" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <!-- EPPs -->
                <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Equipos de Protección Personal (EPP)</MudText>
                <MudSimpleTable Style="overflow-x: auto;" Class="mb-4" Elevation="1" Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th style="width: 60px; text-align: center;">Elegir</th>
                            <th>Artículo EPP</th>
                            <th style="width: 150px; text-align: right;">Costo Catálogo</th>
                            <th style="width: 180px; text-align: right;">Costo Cotización</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var epp in eppList)
                        {
                            <tr>
                                <td style="text-align: center; vertical-align: middle;">
                                    <MudCheckBox T="bool" Checked="@IsEppSelected(epp.Id)" CheckedChanged="@((bool val) => ToggleEpp(epp.Id, val))" Color="Color.Secondary" Dense="true" Style="margin: 0 auto; display: table;" />
                                </td>
                                <td style="vertical-align: middle;">@epp.Nombre</td>
                                <td style="text-align: right; vertical-align: middle;">C$ @epp.CostoMensual.ToString("N2")/mes</td>
                                <td style="vertical-align: middle;">
                                    <MudNumericField T="decimal" Value="@GetEppCost(epp.Id)" ValueChanged="@((decimal val) => SetEppCost(epp.Id, val))" Disabled="@(!IsEppSelected(epp.Id))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentText="C$" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudCard>
        </MudItem>

        <!-- Resultados e Indicadores (Derecha) -->
        <MudItem XS="12" MD="5">
            <MudCard Elevation="4" Class="pa-6 text-white" Style="background: linear-gradient(135deg, #1A237E, #0D47A1); border-radius: 12px; height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-6">Cálculo de Tarifas y Factores</MudText>

                <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                    <MudText Typo="Typo.body1" Class="opacity-75">Salario Base:</MudText>
                    <MudText Typo="Typo.body1" Class="font-bold">C$ @salarioBase.ToString("N2")</MudText>
                </div>

                <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                    <MudText Typo="Typo.body1" Class="opacity-75">Prestaciones (74.3%):</MudText>
                    <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedPrestaciones.ToString("N2")</MudText>
                </div>

                <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                    <MudText Typo="Typo.body1" Class="opacity-75">Viáticos Totales:</MudText>
                    <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedViaticos.ToString("N2")</MudText>
                </div>

                <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                    <MudText Typo="Typo.body1" Class="opacity-75">EPP Prorrateado (+5% rep):</MudText>
                    <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedEpp.ToString("N2")</MudText>
                </div>

                <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                    <MudText Typo="Typo.body1" Class="opacity-75">Cargos/Supervisión/Seguros:</MudText>
                    <MudText Typo="Typo.body1" Class="font-bold">C$ @((supervision + cargos + seguros + gastosOperativos).ToString("N2"))</MudText>
                </div>

                <div class="d-flex justify-space-between mb-5 border-b pb-2 font-bold" style="border-color: rgba(255,255,255,0.3) !important;">
                    <MudText Typo="Typo.body1">Costo Mensual Total (CMT):</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">C$ @CalculatedCmt.ToString("N2")</MudText>
                </div>

                <!-- Factores -->
                <MudPaper Class="pa-4 mb-6" Style="background: rgba(255, 255, 255, 0.08); border-radius: 8px;">
                    <MudGrid>
                        <MudItem XS="6" Class="text-center border-r" Style="border-color: rgba(255,255,255,0.15) !important;">
                            <MudText Typo="Typo.caption" Class="opacity-75 d-block">Factor Costo Real (FCR)</MudText>
                            <MudText Typo="Typo.h5" Class="font-bold">@CalculatedFcr.ToString("N2")</MudText>
                        </MudItem>
                        <MudItem XS="6" Class="text-center">
                            <MudText Typo="Typo.caption" Class="opacity-75 d-block">Factor Facturación (FFR)</MudText>
                            <MudText Typo="Typo.h5" Class="font-bold" Style="color: #00E676;">@CalculatedFfr.ToString("N2")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Margen -->
                <div class="d-flex justify-space-between mb-3 opacity-75">
                    <MudText Typo="Typo.body2">Utilidad de Operación (@utilidadPorcentaje%):</MudText>
                    <MudText Typo="Typo.body2">C$ @CalculatedUtility.ToString("N2")</MudText>
                </div>

                <!-- Tarifa Final -->
                <div class="text-center mb-6 pa-4" style="background: rgba(255, 255, 255, 0.12); border-radius: 8px; border-left: 5px solid #00E676;">
                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA MENSUAL SUGERIDA</MudText>
                    <MudText Typo="Typo.h4" Class="font-bold" Style="color: #00E676;">C$ @CalculatedTarifaSugerida.ToString("N2")</MudText>
                </div>

                <!-- Desglose por Horas -->
                <MudGrid Class="mb-6">
                    <MudItem XS="6" Class="text-center">
                        <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA DÍA (8h)</MudText>
                        <MudText Typo="Typo.h6" Class="font-bold">C$ @CalculatedTarifaDia.ToString("N2")</MudText>
                    </MudItem>
                    <MudItem XS="6" Class="text-center">
                        <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA HORA</MudText>
                        <MudText Typo="Typo.h6" Class="font-bold">C$ @CalculatedTarifaHora.ToString("N2")</MudText>
                    </MudItem>
                </MudGrid>

                <div class="text-center mb-6">
                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA HORA EXTRA</MudText>
                    <MudText Typo="Typo.h6" Class="font-bold" Color="Color.Secondary">C$ @CalculatedTarifaExtra.ToString("N2")</MudText>
                </div>

                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="SaveQuote" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 8px;">
                    Guardar Cotización
                </MudButton>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Sección de Cotizaciones Guardadas -->
    <MudDivider Class="my-8" />
    <MudText Typo="Typo.h5" Class="mb-4 font-bold" Color="Color.Primary">Historial de Cotizaciones Guardadas</MudText>
    
    <MudTable Items="savedQuotes" Hover="true" Elevation="2" Class="mb-6" Style="border-radius: 8px;">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Salario Base</MudTh>
            <MudTh>Costo Mensual</MudTh>
            <MudTh>Utilidad (%)</MudTh>
            <MudTh>Tarifa Sugerida</MudTh>
            <MudTh>F. Facturación</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh Style="width:100px;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Cliente">@context.ClienteNombre</MudTd>
            <MudTd DataLabel="Salario Base">C$ @(context.PersonalDetalle?.SalarioBase.ToString("N2") ?? "-")</MudTd>
            <MudTd DataLabel="Costo Mensual">C$ @context.CostoTotal.ToString("N2")</MudTd>
            <MudTd DataLabel="Utilidad (%)">@context.UtilidadPorcentaje.ToString("N1")%</MudTd>
            <MudTd DataLabel="Tarifa Sugerida">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
            <MudTd DataLabel="F. Facturación">
                @if (context.PersonalDetalle != null && context.PersonalDetalle.SalarioBase > 0)
                {
                    @((context.TarifaSugerida / context.PersonalDetalle.SalarioBase).ToString("N2"))
                }
                else
                {
                    <span>-</span>
                }
            </MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="GetStatusColor(context.Estado)" Size="Size.Small">@context.Estado</MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudTooltip Text="Cargar en el cotizador">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayForWork" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadQuoteToForm(context))" />
                </MudTooltip>
                <MudTooltip Text="Eliminar cotización">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteQuote(context.Id))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="pa-4 text-center text-muted">No hay cotizaciones de personal registradas.</div>
        </NoRecordsContent>
    </MudTable>

    <!-- Gestión de Catálogos Globales (EPP, Viáticos y Maquinaria) -->
    <MudExpansionPanels Class="mt-6 mb-6">
        <MudExpansionPanel Text="⚙️ Gestión de Catálogos Globales (EPP, Viáticos y Maquinaria)" Style="border-radius: 8px; border-top: 4px solid #0288D1;">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="Equipos de Protección (EPP)">
                    <MudGrid>
                        <MudItem XS="12" MD="8">
                            <MudTable Items="eppList" Hover="true" Dense="true" Elevation="1">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Nombre</MudTh>
                                    <MudTh>Cant.</MudTh>
                                    <MudTh>Meses Prorrateo</MudTh>
                                    <MudTh>Costo Unitario</MudTh>
                                    <MudTh>Costo Mensual</MudTh>
                                    <MudTh Style="width:100px;">Acciones</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Id</MudTd>
                                    <MudTd>@context.Nombre</MudTd>
                                    <MudTd>@context.Cantidad.ToString("N1")</MudTd>
                                    <MudTd>@context.MesesProrrateo.ToString("N0")</MudTd>
                                    <MudTd>C$ @context.CostoUnitario.ToString("N2")</MudTd>
                                    <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditEpp(context))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteEpp(context.Id))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                        <MudItem XS="12" MD="4">
                            <MudCard Outlined="true" Class="pa-4">
                                <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingEpp.Id > 0 ? "Editar EPP" : "Agregar EPP")</MudText>
                                <MudTextField @bind-Value="editingEpp.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                <MudNumericField T="decimal" @bind-Value="editingEpp.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N1" />
                                <MudNumericField T="decimal" @bind-Value="editingEpp.MesesProrrateo" Label="Meses Prorrateo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N0" />
                                <MudNumericField T="decimal" @bind-Value="editingEpp.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                <div class="d-flex gap-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEpp">Guardar</MudButton>
                                    @if (editingEpp.Id > 0 || !string.IsNullOrEmpty(editingEpp.Nombre))
                                    {
                                        <MudButton Variant="Variant.Outlined" OnClick="CancelEditEpp">Limpiar</MudButton>
                                    }
                                </div>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                
                <MudTabPanel Text="Viáticos y Beneficios">
                    <MudGrid>
                        <MudItem XS="12" MD="8">
                            <MudTable Items="viaticosList" Hover="true" Dense="true" Elevation="1">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Nombre</MudTh>
                                    <MudTh>Costo Mensual</MudTh>
                                    <MudTh Style="width:100px;">Acciones</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Id</MudTd>
                                    <MudTd>@context.Nombre</MudTd>
                                    <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditViatico(context))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteViatico(context.Id))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                        <MudItem XS="12" MD="4">
                            <MudCard Outlined="true" Class="pa-4">
                                <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingViatico.Id > 0 ? "Editar Viático" : "Agregar Viático")</MudText>
                                <MudTextField @bind-Value="editingViatico.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                <MudNumericField T="decimal" @bind-Value="editingViatico.CostoMensual" Label="Costo Mensual" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                <div class="d-flex gap-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveViatico">Guardar</MudButton>
                                    @if (editingViatico.Id > 0 || !string.IsNullOrEmpty(editingViatico.Nombre))
                                    {
                                        <MudButton Variant="Variant.Outlined" OnClick="CancelEditViatico">Limpiar</MudButton>
                                    }
                                </div>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Maquinaria y Equipos">
                    <MudGrid>
                        <MudItem XS="12" MD="8">
                            <MudTable Items="machineryList" Hover="true" Dense="true" Elevation="1">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Nombre</MudTh>
                                    <MudTh>Precio</MudTh>
                                    <MudTh>Cant.</MudTh>
                                    <MudTh>Meses Proyección</MudTh>
                                    <MudTh>Proyección Mensual</MudTh>
                                    <MudTh Style="width:100px;">Acciones</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Id</MudTd>
                                    <MudTd>@context.Nombre</MudTd>
                                    <MudTd>C$ @context.Precio.ToString("N2")</MudTd>
                                    <MudTd>@context.Cantidad</MudTd>
                                    <MudTd>@context.MesesProyeccion</MudTd>
                                    <MudTd>C$ @context.ProyeccionMensual.ToString("N2")</MudTd>
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditMachinery(context))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMachinery(context.Id))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                        <MudItem XS="12" MD="4">
                            <MudCard Outlined="true" Class="pa-4">
                                <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMachinery.Id > 0 ? "Editar Equipo" : "Agregar Equipo")</MudText>
                                <MudTextField @bind-Value="editingMachinery.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                <MudNumericField T="decimal" @bind-Value="editingMachinery.Precio" Label="Precio" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N2" />
                                <MudNumericField T="int" @bind-Value="editingMachinery.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                <MudNumericField T="int" @bind-Value="editingMachinery.MesesProyeccion" Label="Meses Proyección" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
                                <div class="d-flex gap-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMachinery">Guardar</MudButton>
                                    @if (editingMachinery.Id > 0 || !string.IsNullOrEmpty(editingMachinery.Nombre))
                                    {
                                        <MudButton Variant="Variant.Outlined" OnClick="CancelEditMachinery">Limpiar</MudButton>
                                    }
                                </div>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudContainer>

@code {
    private string cliente = "";
    private decimal salarioBase = 9000.00m;
    private decimal utilidadPorcentaje = 20.00m;
    private decimal supervision = 1000.00m;
    private decimal cargos = 500.00m;
    private decimal seguros = 300.00m;
    private decimal gastosOperativos = 0.00m;

    private List<CatalogoEpp> eppList = new List<CatalogoEpp>();
    private List<CatalogoViatico> viaticosList = new List<CatalogoViatico>();
    private List<CatalogoMaquinaria> machineryList = new List<CatalogoMaquinaria>();
    private List<Cotizacion> savedQuotes = new List<Cotizacion>();

    private HashSet<int> selectedEpps = new HashSet<int>();
    private HashSet<int> selectedViaticos = new HashSet<int>();

    // Diccionarios para guardar montos personalizados por cotización
    private Dictionary<int, decimal> customViaticosCosts = new Dictionary<int, decimal>();
    private Dictionary<int, decimal> customEppsCosts = new Dictionary<int, decimal>();

    // Campos de edición de catálogo
    private CatalogoEpp editingEpp = new CatalogoEpp();
    private CatalogoViatico editingViatico = new CatalogoViatico();
    private CatalogoMaquinaria editingMachinery = new CatalogoMaquinaria();

    // Fórmulas dinámicas
    private decimal CalculatedPrestaciones => salarioBase * 0.743m;
    
    private decimal CalculatedViaticos => viaticosList
        .Where(x => selectedViaticos.Contains(x.Id))
        .Sum(x => customViaticosCosts.TryGetValue(x.Id, out var cost) ? cost : x.CostoMensual);

    private decimal CalculatedEpp => eppList
        .Where(x => selectedEpps.Contains(x.Id))
        .Sum(x => (customEppsCosts.TryGetValue(x.Id, out var cost) ? cost : x.CostoMensual) * 1.05m); // 5% de reposición

    private decimal CalculatedCmt => salarioBase 
        + CalculatedPrestaciones 
        + CalculatedViaticos 
        + CalculatedEpp 
        + supervision 
        + cargos 
        + seguros 
        + gastosOperativos;

    private decimal CalculatedUtility => (salarioBase / (1.0m - (utilidadPorcentaje / 100.0m))) - salarioBase;

    private decimal CalculatedTarifaSugerida => CalculatedCmt + CalculatedUtility;

    private decimal CalculatedFcr => salarioBase > 0 ? (CalculatedCmt / salarioBase) : 0m;

    private decimal CalculatedFfr => salarioBase > 0 ? (CalculatedTarifaSugerida / salarioBase) : 0m;

    private decimal CalculatedTarifaDia => CalculatedTarifaSugerida / 30m;

    private decimal CalculatedTarifaHora => CalculatedTarifaDia / 8m;

    private decimal CalculatedTarifaExtra => ((salarioBase / 30m) / 8m) + CalculatedTarifaHora;

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogs();
        await LoadQuotes();
    }

    private async Task LoadCatalogs()
    {
        var res = await _OdooService.GetCatalogosComercial();
        if (res.Model != null && res.Model.Any())
        {
            var cats = res.Model.First();
            eppList = cats.Epp ?? new List<CatalogoEpp>();
            viaticosList = cats.Viaticos ?? new List<CatalogoViatico>();
            machineryList = cats.Maquinaria ?? new List<CatalogoMaquinaria>();

            // Seleccionar EPPs y viáticos por defecto basados en el excel si es primera inicialización
            if (!selectedViaticos.Any() && !selectedEpps.Any() && customViaticosCosts.Count == 0 && customEppsCosts.Count == 0)
            {
                foreach (var item in viaticosList.Where(x => x.Nombre == "Transporte" || x.Nombre == "Alimentación"))
                {
                    selectedViaticos.Add(item.Id);
                }
                foreach (var item in eppList.Where(x => x.Nombre == "Guantes" || x.Nombre == "Camisas" || x.Nombre == "Botas de seguridad" || x.Nombre == "Gafas" || x.Nombre == "Cinturón" || x.Nombre == "Protectores térmicos" || x.Nombre == "Arneses de seguridad"))
                {
                    selectedEpps.Add(item.Id);
                }
            }
        }
    }

    private async Task LoadQuotes()
    {
        var res = await _OdooService.GetCotizaciones();
        if (res.Model != null)
        {
            savedQuotes = res.Model.Where(x => x.TipoCosteo == "Personal").ToList();
        }
    }

    private decimal GetViaticoCost(int id)
    {
        if (customViaticosCosts.TryGetValue(id, out var cost))
            return cost;
        var item = viaticosList.FirstOrDefault(x => x.Id == id);
        return item?.CostoMensual ?? 0m;
    }

    private void SetViaticoCost(int id, decimal cost)
    {
        customViaticosCosts[id] = cost;
    }

    private decimal GetEppCost(int id)
    {
        if (customEppsCosts.TryGetValue(id, out var cost))
            return cost;
        var item = eppList.FirstOrDefault(x => x.Id == id);
        return item?.CostoMensual ?? 0m;
    }

    private void SetEppCost(int id, decimal cost)
    {
        customEppsCosts[id] = cost;
    }

    private bool IsEppSelected(int id) => selectedEpps.Contains(id);
    private void ToggleEpp(int id, bool val)
    {
        if (val) selectedEpps.Add(id);
        else selectedEpps.Remove(id);
    }

    private bool IsViaticoSelected(int id) => selectedViaticos.Contains(id);
    private void ToggleViatico(int id, bool val)
    {
        if (val) selectedViaticos.Add(id);
        else selectedViaticos.Remove(id);
    }

    private void LoadQuoteToForm(Cotizacion quote)
    {
        cliente = quote.ClienteNombre;
        utilidadPorcentaje = quote.UtilidadPorcentaje;
        
        if (quote.PersonalDetalle != null)
        {
            salarioBase = quote.PersonalDetalle.SalarioBase;
            supervision = quote.PersonalDetalle.Supervision;
            cargos = quote.PersonalDetalle.Cargos;
            seguros = quote.PersonalDetalle.Seguros;
            gastosOperativos = quote.PersonalDetalle.GastosOperativos;

            selectedEpps.Clear();
            customEppsCosts.Clear();
            if (quote.EppDetalles != null)
            {
                foreach (var epp in quote.EppDetalles)
                {
                    if (epp.EppId.HasValue)
                    {
                        selectedEpps.Add(epp.EppId.Value);
                        customEppsCosts[epp.EppId.Value] = epp.CostoMensual;
                    }
                }
            }

            selectedViaticos.Clear();
            customViaticosCosts.Clear();
            if (quote.ViaticoDetalles != null)
            {
                foreach (var viatico in quote.ViaticoDetalles)
                {
                    if (viatico.ViaticoId.HasValue)
                    {
                        selectedViaticos.Add(viatico.ViaticoId.Value);
                        customViaticosCosts[viatico.ViaticoId.Value] = viatico.CostoMensual;
                    }
                }
            }
        }
        Snackbar.Add($"Cotización de '{cliente}' cargada para verificación.", Severity.Info);
    }

    private async Task SaveQuote()
    {
        if (string.IsNullOrWhiteSpace(cliente))
        {
            Snackbar.Add("El nombre del cliente es obligatorio.", Severity.Warning);
            return;
        }

        var detail = new CotizacionPersonalDetalle
        {
            SalarioBase = salarioBase,
            PrestacionesFactor = 0.743m,
            ViaticosTotales = CalculatedViaticos,
            EppTotales = CalculatedEpp,
            Supervision = supervision,
            Cargos = cargos,
            Seguros = seguros,
            GastosOperativos = gastosOperativos
        };

        var quote = new Cotizacion
        {
            ClienteNombre = cliente,
            TipoCosteo = "Personal",
            UtilidadPorcentaje = utilidadPorcentaje,
            CostoTotal = CalculatedCmt,
            TarifaSugerida = CalculatedTarifaSugerida,
            TarifaAcordada = CalculatedTarifaSugerida, // por defecto igual a sugerida
            PersonalDetalle = detail,
            Estado = "Borrador"
        };

        // Rellenar listas de detalle histórico
        foreach (var id in selectedEpps)
        {
            var item = eppList.FirstOrDefault(x => x.Id == id);
            if (item != null)
            {
                var finalCost = customEppsCosts.TryGetValue(id, out var c) ? c : item.CostoMensual;
                quote.EppDetalles.Add(new CotizacionEppDetalle
                {
                    EppId = id,
                    Nombre = item.Nombre,
                    Cantidad = item.Cantidad,
                    MesesProrrateo = item.MesesProrrateo,
                    CostoUnitario = item.CostoUnitario,
                    CostoMensual = finalCost
                });
            }
        }

        foreach (var id in selectedViaticos)
        {
            var item = viaticosList.FirstOrDefault(x => x.Id == id);
            if (item != null)
            {
                var finalCost = customViaticosCosts.TryGetValue(id, out var c) ? c : item.CostoMensual;
                quote.ViaticoDetalles.Add(new CotizacionViaticoDetalle
                {
                    ViaticoId = id,
                    Nombre = item.Nombre,
                    CostoMensual = finalCost
                });
            }
        }

        var res = await _OdooService.SaveCotizacion(quote);
        if (!res.Respuesta.ExisteError)
        {
            Snackbar.Add("Cotización guardada exitosamente.", Severity.Success);
            cliente = "";
            customViaticosCosts.Clear();
            customEppsCosts.Clear();
            await LoadQuotes();
        }
        else
        {
            Snackbar.Add("Error al guardar la cotización: " + res.Respuesta.MensajeError, Severity.Error);
        }
    }

    private async Task DeleteQuote(Guid id)
    {
        var res = await _OdooService.DeleteCotizacion(id);
        if (!res.Respuesta.ExisteError)
        {
            Snackbar.Add("Cotización eliminada.", Severity.Info);
            await LoadQuotes();
        }
        else
        {
            Snackbar.Add("Error al eliminar: " + res.Respuesta.MensajeError, Severity.Error);
        }
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Aprobado" => Color.Success,
            "Rechazado" => Color.Error,
            _ => Color.Default
        };
    }

