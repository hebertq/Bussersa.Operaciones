@page "/comercial/costeo-personal"
@using Modelo.Comercial
@using HostService.Interfaces
@inject IOdooService _OdooService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-6 font-bold" Style="background: linear-gradient(90deg, #1A237E, #0288D1); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Cotizador de Servicios de Personal (Cálculo por Horas)
    </MudText>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary" Class="mb-6">
        <!-- Pestaña 1: Cotizador -->
        <MudTabPanel Text="🧮 Cotizador de Personal" Icon="@Icons.Material.Filled.Calculate">
            <div class="pa-4">
                <MudGrid>
                    <!-- Formulario de Entrada (Izquierda) -->
                    <MudItem XS="12" MD="7">
                        <MudCard Elevation="4" Class="pa-6" Style="border-radius: 12px; border-top: 4px solid #1A237E;">
                            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Datos de Entrada</MudText>
                            
                            <MudTextField @bind-Value="cliente" Label="Nombre del Cliente / Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Required="true" />
                            
                            <MudGrid>
                                <MudItem XS="12" SM="6">
                                    <MudTextField @bind-Value="turno" Label="Nombre del Turno" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Required="true" HelperText="Ej: Diurno, Nocturno, Mixto" />
                                </MudItem>
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="int" @bind-Value="horasTurno" Label="Horas del Turno" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Min="1" Max="24" />
                                </MudItem>
                            </MudGrid>
                            
                            <MudGrid>
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="decimal" @bind-Value="salarioBase" Label="Salario Base (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="decimal" @bind-Value="utilidadPorcentaje" Label="Margen de Utilidad (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" Max="99.0m" Min="1.0m" />
                                </MudItem>
                            </MudGrid>

                            <MudGrid>
                                <MudItem XS="12" SM="6" MD="4">
                                    <MudNumericField T="decimal" @bind-Value="supervision" Label="Supervisión mensual (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                                <MudItem XS="12" SM="6" MD="4">
                                    <MudNumericField T="decimal" @bind-Value="cargos" Label="Cargos Operativos (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                                <MudItem XS="12" SM="12" MD="4">
                                    <MudNumericField T="decimal" @bind-Value="seguros" Label="Seguros de Ley (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                            </MudGrid>
                            
                            <MudNumericField T="decimal" @bind-Value="gastosOperativos" Label="Otros Gastos Administrativos (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Format="N2" />
                            
                            <MudText Typo="Typo.caption" Class="text-muted d-block mb-6">
                                * El costo de prestaciones sociales está fijado al 74.3% del salario base (cubre feriados, domingos, 22.5% de INSS patronal y 3.0% de subsidio/colchón).
                            </MudText>

                            <!-- Viáticos -->
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Viáticos y Beneficios Mensuales</MudText>
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedViaticoToAdd" ValueChanged="AddViaticoRow" Label="Seleccionar y Agregar Viático del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                                    <MudSelectItem T="int?" Value="null">-- Seleccione un viático para agregar a la lista --</MudSelectItem>
                                    @foreach (var viatico in viaticosList.Where(x => !selectedViaticos.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)viatico.Id)">@viatico.Nombre (C$ @viatico.CostoMensual.ToString("N2"))</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedViaticos.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Class="mb-6" Elevation="1" Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Concepto</th>
                                            <th style="width: 150px; text-align: right;">Costo Catálogo</th>
                                            <th style="width: 180px; text-align: right;">Costo Cotización</th>
                                            <th style="width: 60px; text-align: center;">Quitar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedViaticos)
                                        {
                                            var viatico = viaticosList.FirstOrDefault(x => x.Id == id);
                                            if (viatico != null)
                                            {
                                                <tr>
                                                    <td style="vertical-align: middle;">@viatico.Nombre</td>
                                                    <td style="text-align: right; vertical-align: middle;">C$ @viatico.CostoMensual.ToString("N2")</td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@GetViaticoCost(id)" ValueChanged="@((decimal val) => SetViaticoCost(id, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentText="C$" />
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveViaticoRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-6">No se han agregado viáticos a esta cotización.</MudAlert>
                            }

                            <!-- EPPs -->
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Equipos de Protección Personal (EPP)</MudText>
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedEppToAdd" ValueChanged="AddEppRow" Label="Seleccionar y Agregar EPP del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                                    <MudSelectItem T="int?" Value="null">-- Seleccione un EPP para agregar a la lista --</MudSelectItem>
                                    @foreach (var epp in eppList.Where(x => !selectedEpps.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)epp.Id)">@epp.Nombre (C$ @epp.CostoMensual.ToString("N2")/mes)</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedEpps.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Class="mb-4" Elevation="1" Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Artículo EPP</th>
                                            <th style="width: 150px; text-align: right;">Prorrateo Catálogo</th>
                                            <th style="width: 180px; text-align: right;">Prorrateo Cotización</th>
                                            <th style="width: 60px; text-align: center;">Quitar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedEpps)
                                        {
                                            var epp = eppList.FirstOrDefault(x => x.Id == id);
                                            if (epp != null)
                                            {
                                                <tr>
                                                    <td style="vertical-align: middle;">@epp.Nombre</td>
                                                    <td style="text-align: right; vertical-align: middle;">C$ @epp.CostoMensual.ToString("N2")/mes</td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@GetEppCost(id)" ValueChanged="@((decimal val) => SetEppCost(id, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentText="C$" />
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveEppRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">No se han agregado equipos de protección (EPP) a esta cotización.</MudAlert>
                            }
                        </MudCard>
                    </MudItem>

                    <!-- Resultados e Indicadores (Derecha) -->
                    <MudItem XS="12" MD="5">
                        <MudCard Elevation="4" Class="pa-6 mb-6" Style="border-radius: 12px; border-top: 4px solid #0288D1;">
                            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Secondary">Desglose de Costos Mensuales</MudText>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Salario Base:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @salarioBase.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Prestaciones (74.3%):</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedPrestaciones.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Viáticos y Beneficios:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedViaticos.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">EPP y Uniformes (+5%):</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedEpp.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Supervisión Mensual:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @supervision.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Cargos Operativos:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @cargos.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Seguros de Ley:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @seguros.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-4 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Gastos Administrativos:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @gastosOperativos.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-6 pa-3 alert-info" style="border-radius: 8px; background-color: rgba(2,136,209,0.1); border-left: 4px solid #0288D1;">
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Info">COSTO MENSUAL TOTAL (CMT):</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Info">C$ @CalculatedCmt.ToString("N2")</MudText>
                            </div>

                            <MudDivider Class="my-4" />

                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-3" Color="Color.Primary">Tarifas Facturables (Sugeridas)</MudText>

                            <div class="d-flex justify-space-between mb-3 pb-1">
                                <MudText Typo="Typo.body2">Margen de Utilidad Aplicado:</MudText>
                                <MudText Typo="Typo.body2" Class="font-bold">C$ @CalculatedUtility.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 pb-1">
                                <MudText Typo="Typo.body2">Factor de Costo Real (FCR):</MudText>
                                <MudText Typo="Typo.body2" Class="font-bold">@CalculatedFcr.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 pb-1">
                                <MudText Typo="Typo.body2">Factor de Facturación Sugerido (FFR):</MudText>
                                <MudText Typo="Typo.body2" Class="font-bold">@CalculatedFfr.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-5 pa-3" style="border-radius: 8px; background-color: rgba(26,35,126,0.08); border-left: 4px solid #1A237E;">
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Primary">TARIFA MENSUAL SUGERIDA:</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Primary">C$ @CalculatedTarifaSugerida.ToString("N2")</MudText>
                            </div>

                            <MudGrid Class="mb-4">
                                <MudItem XS="6" Class="text-center border-r" style="border-color: rgba(0,0,0,0.1) !important;">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA POR DÍA</MudText>
                                    <MudText Typo="Typo.h6" Class="font-bold">C$ @CalculatedTarifaDia.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem XS="6" Class="text-center">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA POR HORA</MudText>
                                    <MudText Typo="Typo.h6" Class="font-bold">C$ @CalculatedTarifaHora.ToString("N2")</MudText>
                                </MudItem>
                            </MudGrid>

                            <MudGrid Class="mb-6 text-center">
                                <MudItem XS="4" Class="border-r" style="border-color: rgba(0,0,0,0.1) !important;">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">HORA EXTRA</MudText>
                                    <MudText Typo="Typo.body1" Class="font-bold" Color="Color.Secondary">C$ @CalculatedTarifaExtra.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem XS="4" Class="border-r" style="border-color: rgba(0,0,0,0.1) !important;">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">H. FERIADA</MudText>
                                    <MudText Typo="Typo.body1" Class="font-bold" Color="Color.Secondary">C$ @CalculatedTarifaFeriado.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem XS="4">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">H. DOMINGO</MudText>
                                    <MudText Typo="Typo.body1" Class="font-bold" Color="Color.Secondary">C$ @CalculatedTarifaDomingo.ToString("N2")</MudText>
                                </MudItem>
                            </MudGrid>

                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="AddTurnoToSession" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 8px;">
                                ➕ Agregar Turno a la Cotización
                            </MudButton>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <!-- Tabla de Turnos Agregados en esta Sesión (Pendientes de Guardar) -->
                @if (temporaryShifts.Any())
                {
                    <MudCard Elevation="4" Class="pa-6 mt-6" Style="border-radius: 12px; border-top: 4px solid #1a237e;">
                        <div class="d-flex align-center justify-space-between mb-4">
                            <div>
                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-bold">Turnos Agregados (Pendientes de Guardar)</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">Estos turnos aún no están en la base de datos. Agréguelos todos y presione Guardar Cotización Completa.</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAllTemporaryShifts" Class="font-bold py-3 px-6" Size="Size.Large">
                                Guardar Cotización Completa (@temporaryShifts.Count Turnos)
                            </MudButton>
                        </div>

                        <MudTable Items="temporaryShifts" Hover="true" Elevation="1" Dense="true">
                            <HeaderContent>
                                <MudTh>Turno</MudTh>
                                <MudTh Style="text-align: center;">Horas</MudTh>
                                <MudTh Style="text-align: right;">Salario Base</MudTh>
                                <MudTh Style="text-align: right;">Costo Total</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Sugerida</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Extra / Feriado / Domingo</MudTh>
                                <MudTh Style="text-align: center; width: 80px;">Quitar</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Turno">@(context.PersonalDetalle?.Turno ?? "Sin Turno")</MudTd>
                                <MudTd DataLabel="Horas" Style="text-align: center;">@(context.PersonalDetalle?.HorasTurno ?? 8) hrs</MudTd>
                                <MudTd DataLabel="Salario Base" Style="text-align: right;">C$ @(context.PersonalDetalle?.SalarioBase.ToString("N2") ?? "0.00")</MudTd>
                                <MudTd DataLabel="Costo Total" Style="text-align: right;">C$ @context.CostoTotal.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Sugerida" Style="text-align: right;">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Extra / Feriado / Domingo" Style="text-align: right;">C$ @(context.PersonalDetalle?.TarifaExtra.ToString("N2") ?? "0.00") / hora</MudTd>
                                <MudTd Style="text-align: center;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveTemporaryShift(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCard>
                }

                <!-- Grilla de Turnos de esta Empresa/Cliente (para impresión de Cotización) -->
                @if (!string.IsNullOrWhiteSpace(cliente))
                {
                    <MudCard Elevation="4" Class="pa-6 mt-6" Style="border-radius: 12px; border-top: 4px solid #107c41;">
                        <div class="d-flex align-center justify-space-between mb-4">
                            <div>
                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-bold">Turnos Cotizados para @cliente</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">Seleccione los turnos que desea consolidar en la cotización oficial para imprimir</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintConsolidatedCotizacion" Disabled="@(!selectedQuotesForPrint.Any())" Class="font-bold">
                                Imprimir Cotización (@selectedQuotesForPrint.Count Seleccionados)
                            </MudButton>
                        </div>

                        <MudTable Items="CurrentClientQuotes" MultiSelection="true" T="Cotizacion" @bind-SelectedItems="selectedQuotesForPrint" Hover="true" Elevation="1" Dense="true">
                            <HeaderContent>
                                <MudTh>Turno</MudTh>
                                <MudTh Style="text-align: center;">Horas</MudTh>
                                <MudTh Style="text-align: right;">Salario Base</MudTh>
                                <MudTh Style="text-align: right;">Costo Total</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Sugerida</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Acordada</MudTh>
                                <MudTh Style="text-align: right;">Hora Extra / Feriado / Domingo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Turno">@(context.PersonalDetalle?.Turno ?? "Sin Turno")</MudTd>
                                <MudTd DataLabel="Horas" Style="text-align: center;">@(context.PersonalDetalle?.HorasTurno ?? 8) hrs</MudTd>
                                <MudTd DataLabel="Salario Base" Style="text-align: right;">C$ @(context.PersonalDetalle?.SalarioBase.ToString("N2") ?? "0.00")</MudTd>
                                <MudTd DataLabel="Costo Total" Style="text-align: right;">C$ @context.CostoTotal.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Sugerida" Style="text-align: right;">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Acordada" Style="text-align: right;">
                                    <div class="d-flex align-center justify-end">
                                        <MudNumericField T="decimal" Value="context.TarifaAcordada" ValueChanged="@((decimal val) => UpdateTarifaAcordada(context, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 150px; text-align: right;" Adornment="Adornment.Start" AdornmentText="C$" />
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="H. Extra / Feriado / Domingo" Style="text-align: right;">C$ @(context.PersonalDetalle?.TarifaExtra.ToString("N2") ?? "0.00") / hora</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center text-muted">No se han guardado turnos para el cliente "@cliente". Agregue y guarde turnos arriba.</div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCard>
                }
            </div>
        </MudTabPanel>

        <!-- Pestaña 2: Historial -->
        <MudTabPanel Text="📋 Historial de Cotizaciones" Icon="@Icons.Material.Filled.History">
            <div class="pa-6">
                <MudText Typo="Typo.h5" Class="mb-4 font-bold" Color="Color.Primary">Historial de Cotizaciones Guardadas</MudText>
                
                <MudTable Items="savedQuotes" Hover="true" Elevation="2" Class="mb-6" Style="border-radius: 8px;">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Cliente</MudTh>
                        <MudTh>Salario Base</MudTh>
                        <MudTh>Costo Mensual</MudTh>
                        <MudTh>Utilidad (%)</MudTh>
