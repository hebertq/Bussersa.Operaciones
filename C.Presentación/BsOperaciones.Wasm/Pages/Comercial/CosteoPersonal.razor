@page "/comercial/costeo-personal"
@using Modelo.Comercial
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6" Style="position: relative;">
    @if (isPrinting)
    {
        <MudOverlay Visible="true" LightBackground="true" Absolute="false" ZIndex="9999">
            <div class="d-flex flex-column align-center justify-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4 font-bold" Color="Color.Primary">Generando PDF de Cotización... Por favor, espere.</MudText>
            </div>
        </MudOverlay>
    }

    <MudText Typo="Typo.h4" Class="mb-6 font-bold" Style="background: linear-gradient(90deg, #1A237E, #0288D1); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Cotizador de Servicios de Personal (Cálculo por Horas)
    </MudText>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary" Class="mb-6">
        <!-- Pestaña 1: Cotizador -->
        <MudTabPanel Text="🧮 Cotizador de Personal" Icon="@Icons.Material.Filled.Calculate">
            <div class="pa-4">
                <MudGrid>
                    <!-- Formulario de Entrada (Izquierda) -->
                    <MudItem XS="12" MD="7">
                        <MudCard Elevation="4" Class="pa-6" Style="border-radius: 12px; border-top: 4px solid #1A237E;">
                            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Datos de Entrada</MudText>
                            
                            <MudTextField @bind-Value="cliente" Label="Nombre del Cliente / Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Required="true" />
                            
                            <MudGrid>
                                <MudItem XS="12" SM="6">
                                    <MudTextField @bind-Value="turno" Label="Nombre del Turno" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Required="true" HelperText="Ej: Diurno, Nocturno, Mixto" />
                                </MudItem>
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="int" @bind-Value="horasTurno" Label="Horas del Turno" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Min="1" Max="24" />
                                </MudItem>
                            </MudGrid>
                            
                            <MudGrid>
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="decimal" @bind-Value="salarioBase" Label="Salario Base (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="decimal" @bind-Value="utilidadPorcentaje" Label="Margen de Utilidad (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" Max="99.0m" Min="1.0m" />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="int" @bind-Value="diasFeriados" Label="Días Feriados (Anual)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Min="0" Max="365" />
                                </MudItem>
                            </MudGrid>

                            <div class="d-flex align-center gap-4 mb-4 mt-n2 ml-1 flex-wrap">
                                <MudCheckBox T="bool" @bind-Value="recargoDoble" Label="Calcular recargos de horas extras, domingos y feriados al doble de la tarifa normal" Color="Color.Primary" Dense="true" />
                                @if (!recargoDoble)
                                {
                                    <div style="width: 260px; margin-top: -10px;">
                                        <MudNumericField T="decimal" @bind-Value="montoAdicionalHoraExtra" Label="Monto Adicional Hora Extra (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" Min="0.00m" />
                                    </div>
                                }
                            </div>

                            <MudGrid>
                                <MudItem XS="12" SM="6" MD="4">
                                    <MudNumericField T="decimal" @bind-Value="supervision" Label="Supervisión mensual (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                                <MudItem XS="12" SM="6" MD="4">
                                    <MudNumericField T="decimal" @bind-Value="cargos" Label="Cargos Operativos (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                                <MudItem XS="12" SM="12" MD="4">
                                    <MudNumericField T="decimal" @bind-Value="seguros" Label="Seguros de Ley (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                            </MudGrid>
                            
                            <MudNumericField T="decimal" @bind-Value="gastosOperativos" Label="Otros Gastos Administrativos (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Format="N2" />
                            
                            <MudText Typo="Typo.caption" Class="text-muted d-block mb-6">
                                * El costo de prestaciones sociales está fijado al @((CalculatedPrestacionesFactor * 100m).ToString("N1"))% del salario base (cálculo dinámico basado en la configuración de cargos sociales).
                            </MudText>

                            <!-- Viáticos -->
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Viáticos y Beneficios Mensuales</MudText>
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedViaticoToAdd" ValueChanged="AddViaticoRow" Label="Seleccionar y Agregar Viático del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                                    <MudSelectItem T="int?" Value="null">-- Seleccione un viático para agregar a la lista --</MudSelectItem>
                                    @foreach (var viatico in viaticosList.Where(x => !selectedViaticos.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)viatico.Id)">@viatico.Nombre (C$ @viatico.CostoMensual.ToString("N2"))</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedViaticos.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Class="mb-6" Elevation="1" Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Concepto</th>
                                            <th style="width: 150px; text-align: right;">Costo Catálogo</th>
                                            <th style="width: 180px; text-align: right;">Costo Cotización</th>
                                            <th style="width: 60px; text-align: center;">Quitar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedViaticos)
                                        {
                                            var viatico = viaticosList.FirstOrDefault(x => x.Id == id);
                                            if (viatico != null)
                                            {
                                                <tr>
                                                    <td style="vertical-align: middle;">@viatico.Nombre</td>
                                                    <td style="text-align: right; vertical-align: middle;">C$ @viatico.CostoMensual.ToString("N2")</td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@GetViaticoCost(id)" ValueChanged="@((decimal val) => SetViaticoCost(id, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentText="C$" />
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveViaticoRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-6">No se han agregado viáticos a esta cotización.</MudAlert>
                            }

                            <!-- EPPs -->
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Equipos de Protección Personal (EPP)</MudText>
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedEppToAdd" ValueChanged="AddEppRow" Label="Seleccionar y Agregar EPP del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                                    <MudSelectItem T="int?" Value="null">-- Seleccione un EPP para agregar a la lista --</MudSelectItem>
                                    @foreach (var epp in eppList.Where(x => !selectedEpps.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)epp.Id)">@epp.Nombre (C$ @epp.CostoMensual.ToString("N2")/mes)</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedEpps.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Class="mb-4" Elevation="1" Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Artículo EPP</th>
                                            <th style="width: 150px; text-align: right;">Prorrateo Catálogo</th>
                                            <th style="width: 180px; text-align: right;">Prorrateo Cotización</th>
                                            <th style="width: 60px; text-align: center;">Quitar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedEpps)
                                        {
                                            var epp = eppList.FirstOrDefault(x => x.Id == id);
                                            if (epp != null)
                                            {
                                                <tr>
                                                    <td style="vertical-align: middle;">@epp.Nombre</td>
                                                    <td style="text-align: right; vertical-align: middle;">C$ @epp.CostoMensual.ToString("N2")/mes</td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@GetEppCost(id)" ValueChanged="@((decimal val) => SetEppCost(id, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentText="C$" />
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveEppRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">No se han agregado equipos de protección (EPP) a esta cotización.</MudAlert>
                            }
                        </MudCard>
                    </MudItem>

                    <!-- Resultados e Indicadores (Derecha) -->
                    <MudItem XS="12" MD="5">
                        <MudCard Elevation="4" Class="pa-6 mb-6" Style="border-radius: 12px; border-top: 4px solid #0288D1;">
                            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Secondary">Desglose de Costos Mensuales</MudText>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Salario Base:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @salarioBase.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Prestaciones (@((CalculatedPrestacionesFactor * 100m).ToString("N1"))%):</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedPrestaciones.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Viáticos y Beneficios:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedViaticos.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">EPP y Uniformes (+5%):</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedEpp.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Supervisión Mensual:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @supervision.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Cargos Operativos:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @cargos.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Seguros de Ley:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @seguros.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-4 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Gastos Administrativos:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @gastosOperativos.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-6 pa-3 alert-info" style="border-radius: 8px; background-color: rgba(2,136,209,0.1); border-left: 4px solid #0288D1;">
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Info">COSTO MENSUAL TOTAL (CMT):</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Info">C$ @CalculatedCmt.ToString("N2")</MudText>
                            </div>

                            <MudDivider Class="my-4" />

                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-3" Color="Color.Primary">Tarifas Facturables (Sugeridas)</MudText>

                            <div class="d-flex justify-space-between mb-3 pb-1">
                                <MudText Typo="Typo.body2">Margen de Utilidad Aplicado:</MudText>
                                <MudText Typo="Typo.body2" Class="font-bold">C$ @CalculatedUtility.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 pb-1">
                                <MudText Typo="Typo.body2">Factor de Costo Real (FCR):</MudText>
                                <MudText Typo="Typo.body2" Class="font-bold">@CalculatedFcr.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 pb-1">
                                <MudText Typo="Typo.body2">Factor de Facturación Sugerido (FFR):</MudText>
                                <MudText Typo="Typo.body2" Class="font-bold">@CalculatedFfr.ToString("N2")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-5 pa-3" style="border-radius: 8px; background-color: rgba(26,35,126,0.08); border-left: 4px solid #1A237E;">
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Primary">TARIFA MENSUAL SUGERIDA:</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Primary">C$ @CalculatedTarifaSugerida.ToString("N2")</MudText>
                            </div>

                            <MudGrid Class="mb-4">
                                <MudItem XS="6" Class="text-center border-r" style="border-color: rgba(0,0,0,0.1) !important;">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA POR DÍA</MudText>
                                    <MudText Typo="Typo.h6" Class="font-bold">C$ @CalculatedTarifaDia.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem XS="6" Class="text-center">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA POR HORA</MudText>
                                    <MudText Typo="Typo.h6" Class="font-bold">C$ @CalculatedTarifaHora.ToString("N2")</MudText>
                                </MudItem>
                            </MudGrid>

                            <MudGrid Class="mb-6 text-center">
                                <MudItem XS="4" Class="border-r" style="border-color: rgba(0,0,0,0.1) !important;">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">HORA EXTRA</MudText>
                                    <MudText Typo="Typo.body1" Class="font-bold" Color="Color.Secondary">C$ @CalculatedTarifaExtra.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem XS="4" Class="border-r" style="border-color: rgba(0,0,0,0.1) !important;">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">H. FERIADA</MudText>
                                    <MudText Typo="Typo.body1" Class="font-bold" Color="Color.Secondary">C$ @CalculatedTarifaFeriado.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem XS="4">
                                    <MudText Typo="Typo.caption" Class="opacity-75 d-block">H. DOMINGO</MudText>
                                    <MudText Typo="Typo.body1" Class="font-bold" Color="Color.Secondary">C$ @CalculatedTarifaDomingo.ToString("N2")</MudText>
                                </MudItem>
                            </MudGrid>

                            @if (editingQuote != null)
                            {
                                <div class="d-flex gap-2 w-100">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="UpdateExistingQuote" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 8px;">
                                        💾 Guardar Cambios en Turno
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelEditing" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 8px;">
                                        Cancelar
                                    </MudButton>
                                </div>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="AddTurnoToSession" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 8px;">
                                    ➕ Agregar Turno a la Cotización
                                </MudButton>
                            }
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <!-- Tabla de Turnos Agregados en esta Sesión (Pendientes de Guardar) -->
                @if (temporaryShifts.Any())
                {
                    <MudCard Elevation="4" Class="pa-6 mt-6" Style="border-radius: 12px; border-top: 4px solid #1a237e;">
                        <div class="d-flex align-center justify-space-between mb-4">
                            <div>
                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-bold">Turnos Agregados (Pendientes de Guardar)</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">Estos turnos aún no están en la base de datos. Agréguelos todos y presione Guardar Cotización Completa.</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAllTemporaryShifts" Class="font-bold py-3 px-6" Size="Size.Large">
                                Guardar Cotización Completa (@temporaryShifts.Count Turnos)
                            </MudButton>
                        </div>

                        <MudTable Items="temporaryShifts" Hover="true" Elevation="1" Dense="true">
                            <HeaderContent>
                                <MudTh>Turno</MudTh>
                                <MudTh Style="text-align: center;">Horas</MudTh>
                                <MudTh Style="text-align: right;">Salario Base</MudTh>
                                <MudTh Style="text-align: right;">Costo Total</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Sugerida</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Extra / Feriado / Domingo</MudTh>
                                <MudTh Style="text-align: center; width: 80px;">Quitar</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Turno">@(context.PersonalDetalle?.Turno ?? "Sin Turno")</MudTd>
                                <MudTd DataLabel="Horas" Style="text-align: center;">@(context.PersonalDetalle?.HorasTurno ?? 8) hrs</MudTd>
                                <MudTd DataLabel="Salario Base" Style="text-align: right;">C$ @(context.PersonalDetalle?.SalarioBase.ToString("N2") ?? "0.00")</MudTd>
                                <MudTd DataLabel="Costo Total" Style="text-align: right;">C$ @context.CostoTotal.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Sugerida" Style="text-align: right;">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Extra / Feriado / Domingo" Style="text-align: right;">C$ @(context.PersonalDetalle?.TarifaExtra.ToString("N2") ?? "0.00") / hora</MudTd>
                                <MudTd Style="text-align: center;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveTemporaryShift(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCard>
                }

                <!-- Grilla de Turnos de esta Empresa/Cliente (para impresión de Cotización) -->
                @if (!string.IsNullOrWhiteSpace(cliente))
                {
                    <MudCard Elevation="4" Class="pa-6 mt-6" Style="border-radius: 12px; border-top: 4px solid #107c41;">
                        <div class="d-flex align-center justify-space-between mb-4">
                            <div>
                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-bold">Turnos Cotizados para @cliente</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">Seleccione los turnos que desea consolidar en la cotización oficial para imprimir</MudText>
                            </div>
                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintConsolidatedCotizacion" Disabled="@(!selectedQuotesForPrint.Any())" Class="font-bold">
                                    Imprimir Cotización (@selectedQuotesForPrint.Count Seleccionados)
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="PrintConsolidatedCotizacionDesglose" Disabled="@(!selectedQuotesForPrint.Any())" Class="font-bold">
                                    Imprimir Desglose (@selectedQuotesForPrint.Count Seleccionados)
                                </MudButton>
                            </div>
                        </div>

                        <MudTable Items="CurrentClientQuotes" MultiSelection="true" T="Cotizacion" @bind-SelectedItems="selectedQuotesForPrint" Hover="true" Elevation="1" Dense="true">
                            <HeaderContent>
                                <MudTh>Turno</MudTh>
                                <MudTh Style="text-align: center;">Horas</MudTh>
                                <MudTh Style="text-align: right;">Salario Base</MudTh>
                                <MudTh Style="text-align: right;">Costo Total</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Sugerida</MudTh>
                                <MudTh Style="text-align: right;">Tarifa Acordada</MudTh>
                                <MudTh Style="text-align: right;">Hora Extra / Feriado / Domingo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Turno">@(context.PersonalDetalle?.Turno ?? "Sin Turno")</MudTd>
                                <MudTd DataLabel="Horas" Style="text-align: center;">@(context.PersonalDetalle?.HorasTurno ?? 8) hrs</MudTd>
                                <MudTd DataLabel="Salario Base" Style="text-align: right;">C$ @(context.PersonalDetalle?.SalarioBase.ToString("N2") ?? "0.00")</MudTd>
                                <MudTd DataLabel="Costo Total" Style="text-align: right;">C$ @context.CostoTotal.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Sugerida" Style="text-align: right;">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
                                <MudTd DataLabel="Tarifa Acordada" Style="text-align: right;">
                                    <div class="d-flex align-center justify-end">
                                        <MudNumericField T="decimal" Value="context.TarifaAcordada" ValueChanged="@((decimal val) => UpdateTarifaAcordada(context, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 150px; text-align: right;" Adornment="Adornment.Start" AdornmentText="C$" />
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="H. Extra / Feriado / Domingo" Style="text-align: right;">C$ @(context.PersonalDetalle?.TarifaExtra.ToString("N2") ?? "0.00") / hora</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center text-muted">No se han guardado turnos para el cliente "@cliente". Agregue y guarde turnos arriba.</div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCard>
                }
            </div>
        </MudTabPanel>

        <!-- Pestaña 2: Historial -->
        <MudTabPanel Text="📋 Historial de Cotizaciones" Icon="@Icons.Material.Filled.History">
            <div class="pa-6">
                <MudText Typo="Typo.h5" Class="mb-4 font-bold" Color="Color.Primary">Historial de Cotizaciones Guardadas</MudText>
                
                <MudTable Items="groupedQuotes" Hover="true" Elevation="2" Class="mb-6" Style="border-radius: 8px;">
                    <HeaderContent>
                        <MudTh Style="width: 50px;"></MudTh>
                        <MudTh>Cotización No.</MudTh>
                        <MudTh>Año/Mes</MudTh>
                        <MudTh>Cliente</MudTh>
                        <MudTh>Cant. Turnos</MudTh>
                        <MudTh>Costo Total Mensual (CMT)</MudTh>
                        <MudTh>Tarifa Sugerida Total</MudTh>
                        <MudTh Style="width:120px; text-align: center;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudIconButton Icon="@(context.ShowDetails ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                           OnClick="@(() => context.ShowDetails = !context.ShowDetails)" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Cotización No." Class="font-bold" Style="color: var(--mud-palette-primary);">@(context.Quotes.FirstOrDefault()?.NumeroCotizacion ?? "N/A")</MudTd>
                        <MudTd DataLabel="Año/Mes" Class="font-bold">@context.Periodo</MudTd>
                        <MudTd DataLabel="Cliente">@context.ClienteNombre</MudTd>
                        <MudTd DataLabel="Cant. Turnos">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.Quotes.Count turnos</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Costo Total Mensual">C$ @context.CostoTotal.ToString("N2")</MudTd>
                        <MudTd DataLabel="Tarifa Sugerida Total" Class="font-bold text-primary">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
                        <MudTd Style="text-align: center;">
                            <div class="d-flex justify-center gap-1">
                                <MudTooltip Text="Re-Imprimir Cotización Consolidada">
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Primary" Size="Size.Small" OnClick="@(() => PrintGroup(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Imprimir Desglose Detallado">
                                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Info" Size="Size.Small" OnClick="@(() => PrintGroupDesglose(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar Grupo Completo">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteGroup(context))" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (context.ShowDetails)
                        {
                            <MudTr>
                                <td colspan="8" class="pa-4" style="background-color: rgba(0,0,0,0.02);">
                                    <MudCard Elevation="2" Outlined="true" Class="pa-4" Style="border-radius: 8px;">
                                        <MudText Typo="Typo.subtitle2" Class="mb-3 font-bold" Color="Color.Primary">
                                            Detalle de Turnos: @context.ClienteNombre (@context.Periodo)
                                        </MudText>
                                        <MudTable Items="context.Quotes" Context="detailContext" Hover="true" Dense="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>Turno</MudTh>
                                                <MudTh>Horas</MudTh>
                                                <MudTh>Salario Base</MudTh>
                                                <MudTh>Costo Mensual (CMT)</MudTh>
                                                <MudTh>Tarifa Sugerida</MudTh>
                                                <MudTh>Tarifa Acordada</MudTh>
                                                <MudTh>Estado</MudTh>
                                                <MudTh style="width: 80px; text-align: center;">Acciones</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Turno">@detailContext.PersonalDetalle?.Turno</MudTd>
                                                <MudTd DataLabel="Horas">@detailContext.PersonalDetalle?.HorasTurno hrs</MudTd>
                                                <MudTd DataLabel="Salario Base">C$ @(detailContext.PersonalDetalle?.SalarioBase.ToString("N2") ?? "-")</MudTd>
                                                <MudTd DataLabel="Costo Mensual">C$ @detailContext.CostoTotal.ToString("N2")</MudTd>
                                                <MudTd DataLabel="Tarifa Sugerida">C$ @detailContext.TarifaSugerida.ToString("N2")</MudTd>
                                                <MudTd DataLabel="Tarifa Acordada">
                                                    <MudNumericField T="decimal" Value="@detailContext.TarifaAcordada" ValueChanged="@((decimal val) => UpdateTarifaAcordada(detailContext, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 140px; background-color: white;" Adornment="Adornment.Start" AdornmentText="C$" />
                                                </MudTd>
                                                <MudTd DataLabel="Estado">
                                                    <MudChip T="string" Color="GetStatusColor(detailContext.Estado)" Size="Size.Small">@detailContext.Estado</MudChip>
                                                </MudTd>
                                                <MudTd Style="text-align: center;">
                                                    <div class="d-flex justify-center gap-1">
                                                        <MudTooltip Text="Cargar en el cotizador">
                                                            <MudIconButton Icon="@Icons.Material.Filled.PlayForWork" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadQuoteToForm(detailContext))" />
                                                        </MudTooltip>
                                                        <MudTooltip Text="Eliminar este turno">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteQuote(detailContext.Id))" />
                                                        </MudTooltip>
                                                    </div>
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </MudCard>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                    <NoRecordsContent>
                        <div class="pa-4 text-center text-muted">No hay cotizaciones de personal registradas.</div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <!-- Pestaña 3: Catálogos Globales -->
        <MudTabPanel Text="⚙️ Gestión de Catálogos" Icon="@Icons.Material.Filled.Settings">
            <div class="pa-6">
                <MudText Typo="Typo.h5" Class="mb-6 font-bold" Color="Color.Primary">Gestión de Catálogos Globales (EPP, Viáticos y Maquinaria)</MudText>
                
                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Secondary">
                    <MudTabPanel Text="Equipos de Protección (EPP)">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="eppList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>Meses Prorrateo</MudTh>
                                        <MudTh>Costo Unitario</MudTh>
                                        <MudTh>Costo Mensual (Prorrateado)</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>@context.Cantidad.ToString("N1")</MudTd>
                                        <MudTd>@context.MesesProrrateo.ToString("N0")</MudTd>
                                        <MudTd>C$ @context.CostoUnitario.ToString("N2")</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditEpp(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteEpp(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingEpp.Id > 0 ? "Editar EPP" : "Agregar EPP")</MudText>
                                    <MudTextField @bind-Value="editingEpp.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N1" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.MesesProrrateo" Label="Meses Prorrateo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N0" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEpp">Guardar</MudButton>
                                        @if (editingEpp.Id > 0 || !string.IsNullOrEmpty(editingEpp.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditEpp">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    
                    <MudTabPanel Text="Viáticos y Beneficios">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="viaticosList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Costo Mensual</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditViatico(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteViatico(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingViatico.Id > 0 ? "Editar Viático" : "Agregar Viático")</MudText>
                                    <MudTextField @bind-Value="editingViatico.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingViatico.CostoMensual" Label="Costo Mensual" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveViatico">Guardar</MudButton>
                                        @if (editingViatico.Id > 0 || !string.IsNullOrEmpty(editingViatico.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditViatico">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Maquinaria y Equipos">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="machineryList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Precio</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>Meses Proyección</MudTh>
                                        <MudTh>Proyección Mensual</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.Precio.ToString("N2")</MudTd>
                                        <MudTd>@context.Cantidad</MudTd>
                                        <MudTd>@context.MesesProyeccion</MudTd>
                                        <MudTd>C$ @context.ProyeccionMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditMachinery(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMachinery(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMachinery.Id > 0 ? "Editar Equipo" : "Agregar Equipo")</MudText>
                                    <MudTextField @bind-Value="editingMachinery.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingMachinery.Precio" Label="Precio" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N2" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.MesesProyeccion" Label="Meses Proyección" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMachinery">Guardar</MudButton>
                                        @if (editingMachinery.Id > 0 || !string.IsNullOrEmpty(editingMachinery.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditMachinery">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Cargos Sociales">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudCard Elevation="2" Class="pa-6" Style="border-radius: 12px; height: 100%;">
                                    <MudText Typo="Typo.h6" Class="mb-4 text-primary font-bold">Configuración de Cargos Sociales</MudText>
                                    
                                    <MudGrid>
                                        <MudItem XS="12" SM="6" MD="4">
                                            <MudNumericField T="decimal" @bind-Value="cargosConfig.InssPatronal" Label="INSS Patronal (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                                        </MudItem>
                                        <MudItem XS="12" SM="6" MD="4">
                                            <MudNumericField T="decimal" @bind-Value="cargosConfig.Inatec" Label="INATEC (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                                        </MudItem>
                                        <MudItem XS="12" SM="6" MD="4">
                                            <MudNumericField T="decimal" @bind-Value="cargosConfig.ColchonSubsidio" Label="Colchón/Subsidio (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                                        </MudItem>

                                        <MudItem XS="12" SM="6" MD="6">
                                            <MudNumericField T="decimal" @bind-Value="cargosConfig.DomingosDias" Label="Domingos al Año (días)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                                        </MudItem>
                                        <MudItem XS="12" SM="6" MD="6">
                                            <MudNumericField T="decimal" @bind-Value="cargosConfig.FeriadosDias" Label="Feriados al Año (días)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                                        </MudItem>

                                        <MudItem XS="12" SM="6" MD="4">
                                            <MudNumericField T="decimal" @bind-Value="vacasAlMes" Label="Vacaciones al Mes (días)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" />
                                        </MudItem>
                                        <MudItem XS="12" SM="6" MD="4">
                                            <MudNumericField T="decimal" @bind-Value="aguinaldoAlMes" Label="Aguinaldo al Mes (días)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" />
                                        </MudItem>
                                        <MudItem XS="12" SM="6" MD="4">
                                            <MudNumericField T="decimal" @bind-Value="indemnizacionAlMes" Label="Indemnización al Mes (días)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" />
                                        </MudItem>
                                    </MudGrid>

                                    <div class="mt-6 d-flex justify-end">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveCargosSociales" Class="px-6 py-2">
                                            Guardar Configuración
                                        </MudButton>
                                    </div>
                                </MudCard>
                            </MudItem>

                            <MudItem XS="12" MD="4">
                                <MudCard Elevation="4" Class="pa-6" Style="border-radius: 12px; background: linear-gradient(135deg, #1A237E, #0D47A1); color: white; height: 100%;">
                                    <MudText Typo="Typo.h6" Class="mb-4 font-bold" Color="Color.Inherit">Fórmula y Detalle del Cálculo</MudText>
                                    
                                    <MudText Typo="Typo.body2" Class="mb-4 opacity-90">
                                        El factor de cargos sociales se calcula dinámicamente utilizando la siguiente fórmula:
                                    </MudText>

                                    <div class="pa-3 mb-6 font-mono text-center rounded" style="background: rgba(0,0,0,0.25); border-left: 4px solid #00E676; font-size: 0.85rem;">
                                        Factor = (INSS% + INATEC% + Colchón%) + (Días Totales / 360)
                                    </div>

                                    <MudText Typo="Typo.subtitle2" Class="font-bold mb-2" Color="Color.Inherit">Desglose Actual:</MudText>
                                    
                                    <div class="d-flex justify-space-between mb-2 opacity-95">
                                        <span>Aporte INSS:</span>
                                        <span class="font-bold">@cargosConfig.InssPatronal.ToString("N2")%</span>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 opacity-95">
                                        <span>Aporte INATEC:</span>
                                        <span class="font-bold">@cargosConfig.Inatec.ToString("N2")%</span>
                                    </div>
                                    <div class="d-flex justify-space-between mb-4 opacity-95">
                                        <span>Colchón/Subsidio:</span>
                                        <span class="font-bold">@cargosConfig.ColchonSubsidio.ToString("N2")%</span>
                                    </div>

                                    <div class="border-t pt-3 mb-2" style="border-color: rgba(255,255,255,0.2) !important;">
                                        <MudText Typo="Typo.subtitle2" Class="font-bold mb-1" Color="Color.Inherit">Días anuales equivalentes:</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between mb-1 opacity-85" style="font-size: 0.85rem;">
                                        <span>Domingos (anuales):</span>
                                        <span>@cargosConfig.DomingosDias.ToString("N1")</span>
                                    </div>
                                    <div class="d-flex justify-space-between mb-1 opacity-85" style="font-size: 0.85rem;">
                                        <span>Feriados (anuales):</span>
                                        <span>@cargosConfig.FeriadosDias.ToString("N1")</span>
                                    </div>
                                    <div class="d-flex justify-space-between mb-1 opacity-85" style="font-size: 0.85rem;">
                                        <span>Vacaciones (@vacasAlMes.ToString("N2")/mes):</span>
                                        <span>@((vacasAlMes * 12m).ToString("N1"))</span>
                                    </div>
                                    <div class="d-flex justify-space-between mb-1 opacity-85" style="font-size: 0.85rem;">
                                        <span>Aguinaldo (@aguinaldoAlMes.ToString("N2")/mes):</span>
                                        <span>@((aguinaldoAlMes * 12m).ToString("N1"))</span>
                                    </div>
                                    <div class="d-flex justify-space-between mb-3 opacity-85" style="font-size: 0.85rem;">
                                        <span>Indemnización (@indemnizacionAlMes.ToString("N2")/mes):</span>
                                        <span>@((indemnizacionAlMes * 12m).ToString("N1"))</span>
                                    </div>

                                    <div class="d-flex justify-space-between mb-4 opacity-95">
                                        <span>Suma de días:</span>
                                        <span class="font-bold">@((cargosConfig.DomingosDias + cargosConfig.FeriadosDias + (vacasAlMes * 12m) + (aguinaldoAlMes * 12m) + (indemnizacionAlMes * 12m)).ToString("N1")) días</span>
                                    </div>

                                    <div class="d-flex justify-space-between border-t pt-3 mb-2" style="border-color: rgba(255,255,255,0.2) !important;">
                                        <span>Carga Directa %:</span>
                                        <span class="font-bold">@((cargosConfig.InssPatronal + cargosConfig.Inatec + cargosConfig.ColchonSubsidio).ToString("N2"))%</span>
                                    </div>
                                    <div class="d-flex justify-space-between mb-4">
                                        <span>Carga por Días %:</span>
                                        <span class="font-bold">@(((cargosConfig.DomingosDias + cargosConfig.FeriadosDias + (vacasAlMes * 12m) + (aguinaldoAlMes * 12m) + (indemnizacionAlMes * 12m)) / 360m * 100m).ToString("N2"))%</span>
                                    </div>

                                    <div class="d-flex justify-space-between border-t pt-3" style="border-color: rgba(255,255,255,0.2) !important; font-size: 1.1rem;">
                                        <span class="font-bold">FACTOR TOTAL:</span>
                                        <span class="font-bold text-success" style="color: #00E676 !important;">
                                            @((CalculatedPrestacionesFactor * 100m).ToString("N2"))%
                                        </span>
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

