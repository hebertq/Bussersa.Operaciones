@page "/comercial/costeo-produccion"
@using Modelo.Comercial
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8" Style="position: relative;">
    @if (isPrinting)
    {
        <MudOverlay Visible="true" LightBackground="true" Absolute="false" ZIndex="9999">
            <div class="d-flex flex-column align-center justify-center">
                <MudProgressCircular Color="Color.Success" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4 font-bold" Color="Color.Success">Generando PDF de Cotización... Por favor, espere.</MudText>
            </div>
        </MudOverlay>
    }

    <!-- Encabezado Ejecutivo -->
    <div class="prod-hero-header mb-4">
        <div>
            <MudText Typo="Typo.h5" Class="font-bold">Cotizador de Servicios de Producción y Maquila (Por Unidad / SKU)</MudText>
            <MudText Typo="Typo.body2" Style="opacity: 0.86;">
                Vincule su Costeo de Personal por turno, defina tamaño de cuadrilla, maquinaria y capacidad por turno para obtener el precio unitario exacto.
            </MudText>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Badge" OnClick="GoToCosteoPersonal" Size="Size.Small" Style="border-color: rgba(255,255,255,0.5);">
                Ir a Costeo Personal
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="@(() => showExcelPanel = !showExcelPanel)" Size="Size.Small" Style="background-color: #00C853; color: #052e16; font-weight: 700;">
                @(showExcelPanel ? "Ocultar Lote Excel" : "Importar SKUs Excel")
            </MudButton>
            @if (editingQuoteId.HasValue || currentItems.Any() || !string.IsNullOrEmpty(cliente))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ClearCurrentQuoteForm" Size="Size.Small" Style="border-color: rgba(255,255,255,0.5);">
                    Nueva Cotización
                </MudButton>
            }
        </div>
    </div>

    @* --- BARRA DE BOTONES DE PESTAÑAS ESTILO APP / TABLET --- *@
    <div class="app-tab-bar-card mb-3">
        <div class="app-tab-grid cols-3">
            <button type="button"
                    class="app-tab-item @(activeTabIndex == 0 ? "active" : "")"
                    @onclick="() => SetActiveTab(0)"
                    title="Cotizador de Producción">
                <div class="app-tab-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Calculate" />
                    @if (currentItems != null && currentItems.Any())
                    {
                        <span class="app-tab-badge badge-primary">@currentItems.Count</span>
                    }
                </div>
                <div class="app-tab-label-wrap">
                    <span class="app-tab-label">Cotizador Producción</span>
                </div>
            </button>

            <button type="button"
                    class="app-tab-item @(activeTabIndex == 1 ? "active" : "")"
                    @onclick="() => SetActiveTab(1)"
                    title="Historial de Cotizaciones">
                <div class="app-tab-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.History" />
                    @if (savedQuotes != null && savedQuotes.Any())
                    {
                        <span class="app-tab-badge badge-info">@savedQuotes.Count</span>
                    }
                </div>
                <div class="app-tab-label-wrap">
                    <span class="app-tab-label">Historial Cotizaciones</span>
                </div>
            </button>

            <button type="button"
                    class="app-tab-item @(activeTabIndex == 2 ? "active" : "")"
                    @onclick="() => SetActiveTab(2)"
                    title="Gestión de Catálogos Globales">
                <div class="app-tab-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" />
                </div>
                <div class="app-tab-label-wrap">
                    <span class="app-tab-label">Catálogos Globales</span>
                </div>
            </button>
        </div>
    </div>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
             Class="tablet-tabs mb-6" @bind-ActivePanelIndex="@activeTabIndex">

        <!-- ========================================================= -->
        <!-- PESTAÑA 1: COTIZADOR CONSOLIDADO                          -->
        <!-- ========================================================= -->
        <MudTabPanel Text="Cotizador de Producción">
            <div class="pa-2 pa-md-4">

                @if (editingQuoteId.HasValue)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4" Style="border-radius: 10px;">
                        Editando cotización existente: <strong>@(editingNumeroCotizacion ?? cliente)</strong>. Modifique o agregue SKUs y presione <strong>Guardar Cotización Consolidada</strong> al finalizar.
                    </MudAlert>
                }

                @if (showExcelPanel || importedProducts.Any())
                {
                    <MudCard Elevation="2" Class="pa-4 mb-4" Style="border-radius: 12px; background-color: rgba(220,237,200,0.22); border-left: 5px solid #2E7D32;">
                        <MudGrid AlignItems="AlignItems.Center">
                            <MudItem XS="12" MD="6">
                                <div class="d-flex align-center gap-3">
                                    <MudIcon Icon="@Icons.Material.Filled.TableView" Color="Color.Success" Size="Size.Large" />
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-bold">Carga en Serie de SKUs desde Excel</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">Suba un archivo .xlsx con los nombres de SKUs en la primera columna para cotizarlos uno tras otro conservando cuadrilla, turno y equipos.</MudText>
                                    </div>
                                </div>
                            </MudItem>
                            <MudItem XS="12" MD="6" Class="d-flex justify-end gap-2 align-center flex-wrap">
                                <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadExcelFile" Accept=".xlsx">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.AttachFile" Size="Size.Small">
                                            Seleccionar Excel (.xlsx)
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                @if (importedProducts.Any())
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">SKU @(currentProductIndex + 1) / @importedProducts.Count</MudChip>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToPreviousProduct" Disabled="@(currentProductIndex <= 0)">Anterior</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="GoToNextProduct" Disabled="@(currentProductIndex >= importedProducts.Count - 1)">Siguiente</MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="ClearImportedProducts" />
                                }
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                }

                <MudGrid Spacing="3">
                    <!-- COLUMNA IZQUIERDA: FLUJO GUIADO EN 3 PASOS -->
                    <MudItem XS="12" lg="7">

                        <!-- PASO 1: CLIENTE, COSTEO DE PERSONAL, TURNO Y CANTIDAD DE PERSONAS -->
                        <MudCard Elevation="2" Class="pa-5 mb-4 prod-step-card">
                            <div class="prod-step-header">
                                <div class="d-flex align-center gap-3">
                                    <span class="prod-step-badge">1</span>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-bold" Style="line-height: 1.2;">Cliente, Costeo de Personal y Turno</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">Seleccione el costeo de personal del turno (incluyendo variaciones de transporte) y la cantidad de personas en línea.</MudText>
                                    </div>
                                </div>
                                @if (selectedPersonnelQuote != null)
                                {
                                    <MudChip T="string" Color="@(IsNightShift(CurrentTurnoNombre) ? Color.Info : Color.Success)" Size="Size.Small" Variant="Variant.Filled">
                                        @(IsNightShift(CurrentTurnoNombre) ? "🌙 " : "☀️ ") Turno @CurrentTurnoNombre (@CurrentHorasTurno h)
                                    </MudChip>
                                }
                            </div>

                            <MudGrid Spacing="2">
                                <MudItem XS="12" SM="6">
                                    <MudTextField @bind-Value="cliente" Label="Nombre del Cliente / Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Placeholder="ej. Grupo AJE - Maquila Moderno" />
                                </MudItem>
                                <MudItem XS="12" SM="6">
                                    <MudSelect T="string" Value="selectedFilterEmpresa" ValueChanged="OnEmpresaFilterChanged" Label="Empresa en Costeo de Personal" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Seleccione cliente con costeo personal" Clearable="true">
                                        @foreach (var emp in personnelQuotes.Select(x => x.ClienteNombre).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
                                        {
                                            <MudSelectItem T="string" Value="@emp">@emp</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                            @if (!string.IsNullOrWhiteSpace(selectedFilterEmpresa))
                            {
                                var shiftsForClient = personnelQuotes.Where(x => x.ClienteNombre == selectedFilterEmpresa).OrderBy(x => x.PersonalDetalle?.Turno).ToList();
                                <MudText Typo="Typo.caption" Class="font-bold d-block mt-3 mb-2" Color="Color.Success">
                                    SELECCIONE EL TURNO A COSTEAR (@shiftsForClient.Count disponible@(shiftsForClient.Count == 1 ? "" : "s")):
                                </MudText>
                                <div class="shift-cards-grid mb-3">
                                    @foreach (var q in shiftsForClient)
                                    {
                                        bool isSel = selectedPersonnelQuoteId == q.Id;
                                        bool isNight = IsNightShift(q.PersonalDetalle?.Turno);
                                        decimal viat = q.PersonalDetalle?.ViaticosTotales ?? 0m;
                                        decimal costoDia = q.CostoTotal / EffectiveDiasMes;
                                        <button type="button"
                                                class="shift-option-card @(isSel ? (isNight ? "selected-night" : "selected") : "")"
                                                @onclick="@(() => OnPersonnelQuoteChanged(q.Id))">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <span style="font-weight: 800; font-size: 0.92rem; color: @(isNight ? "#0d47a1" : "#1b5e20");">
                                                    @(isNight ? "🌙" : "☀️") @(q.PersonalDetalle?.Turno ?? "Estándar") (@(q.PersonalDetalle?.HorasTurno ?? 8)h)
                                                </span>
                                                @if (isSel)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="@(isNight ? Color.Info : Color.Success)" Size="Size.Small" />
                                                }
                                            </div>
                                            <div style="font-size: 0.78rem; color: #455a64;">
                                                CMT / Persona: <strong>C$ @q.CostoTotal.ToString("N2")/mes</strong>
                                            </div>
                                            <div style="font-size: 0.78rem; color: @(viat > 0 ? "#e65100" : "#607d8b"); font-weight: @(viat > 0 ? "700" : "400");">
                                                Viáticos / Transp.: C$ @viat.ToString("N2")/mes
                                            </div>
                                            <div style="font-size: 0.80rem; margin-top: 4px; color: #1b5e20; font-weight: 700;">
                                                C$ @costoDia.ToString("N2") / persona / turno
                                            </div>
                                        </button>
                                    }
                                </div>
                            }

                            <MudGrid Spacing="2" Class="mt-1">
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="int" Value="cantidadTrabajadores" ValueChanged="OnCantidadTrabajadoresChanged" Label="Cantidad de Personas (Línea)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="200" Adornment="Adornment.End" AdornmentText="pers." />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="decimal" Value="diasOperativosMes" ValueChanged="OnDiasOperativosMesChanged" Label="Turnos Base / Mes" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1m" Max="31m" Format="N0" HelperText="Estándar: 26 turnos (8h)" />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    @if (selectedPersonnelQuoteId == null)
                                    {
                                        <MudTextField @bind-Value="manualTurno" Label="Turno (Modo Manual)" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Sin costeo personal vinculado" />
                                    }
                                    else
                                    {
                                        <MudNumericField T="decimal" Value="CalculatedCostoTurnoCuadrilla" Label="Costo Cuadrilla / Turno" Variant="Variant.Filled" Margin="Margin.Dense" Format="N2" ReadOnly="true" Adornment="Adornment.Start" AdornmentText="C$" />
                                    }
                                </MudItem>
                            </MudGrid>

                            @if (selectedPersonnelQuoteId == null)
                            {
                                <MudGrid Spacing="2" Class="mt-1">
                                    <MudItem XS="12" SM="6">
                                        <MudNumericField T="decimal" Value="manoObraUnitaria" ValueChanged="OnManoObraManualChanged" Label="Mano de Obra Unitaria Manual (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" Adornment="Adornment.Start" AdornmentText="C$" />
                                    </MudItem>
                                    <MudItem XS="12" SM="6" Class="d-flex align-center">
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            💡 Seleccione arriba una empresa de <strong>Costeo de Personal</strong> para calcular automáticamente desde salarios, ley, EPP y transporte del turno.
                                        </MudText>
                                    </MudItem>
                                </MudGrid>
                            }
                            else if (selectedPersonnelQuote != null)
                            {
                                var pd = selectedPersonnelQuote.PersonalDetalle;
                                decimal salLey = (pd?.SalarioBase ?? 0m) * (1m + (pd?.PrestacionesFactor ?? 0.545m));
                                decimal viatMes = pd?.ViaticosTotales ?? 0m;
                                decimal eppSup = (pd?.EppTotales ?? 0m) + (pd?.Supervision ?? 0m) + (pd?.Cargos ?? 0m) + (pd?.Seguros ?? 0m) + (pd?.GastosOperativos ?? 0m);
                                <div class="crew-kpi-strip mt-3">
                                    <div class="crew-kpi-box">
                                        <div style="font-size: 0.70rem; color: #607d8b; text-transform: uppercase;">Salario + Ley (Pers.)</div>
                                        <div style="font-weight: 800; font-size: 0.92rem;">C$ @salLey.ToString("N2")</div>
                                    </div>
                                    <div class="crew-kpi-box @(viatMes > 0 ? "viaticos-highlight" : "")">
                                        <div style="font-size: 0.70rem; color: #607d8b; text-transform: uppercase;">Transporte / Viáticos</div>
                                        <div style="font-weight: 800; font-size: 0.92rem; color: @(viatMes > 0 ? "#e65100" : "inherit");">C$ @viatMes.ToString("N2")</div>
                                    </div>
                                    <div class="crew-kpi-box">
                                        <div style="font-size: 0.70rem; color: #607d8b; text-transform: uppercase;">EPP + Supervisión</div>
                                        <div style="font-weight: 800; font-size: 0.92rem;">C$ @eppSup.ToString("N2")</div>
                                    </div>
                                    <div class="crew-kpi-box total-highlight">
                                        <div style="font-size: 0.70rem; color: #0d47a1; text-transform: uppercase;">Cuadrilla (@cantidadTrabajadores pers./mes)</div>
                                        <div style="font-weight: 800; font-size: 0.92rem; color: #0d47a1;">C$ @CalculatedCostoMensualCuadrilla.ToString("N2")</div>
                                    </div>
                                </div>
                            }
                        </MudCard>

                        <!-- PASO 2: EQUIPOS Y MAQUINARIA A UTILIZAR -->
                        <MudCard Elevation="2" Class="pa-5 mb-4 prod-step-card">
                            <div class="prod-step-header">
                                <div class="d-flex align-center gap-3">
                                    <span class="prod-step-badge">2</span>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-bold" Style="line-height: 1.2;">Maquinaria y Equipos a Utilizar</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">Elija los equipos de la línea y ajuste cantidad o meses de amortización. Si el cliente aporta los equipos, deje esta lista vacía.</MudText>
                                    </div>
                                </div>
                                @if (selectedMachinery.Any())
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearSelectedMachinery">
                                        Sin Equipos
                                    </MudButton>
                                }
                            </div>

                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedMachineryToAdd" ValueChanged="AddMachineryRow" Label="Agregar Maquinaria / Equipo del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Placeholder="Seleccione un equipo para incluir en la línea">
                                    @foreach (var maq in machineryList.Where(x => !selectedMachinery.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)maq.Id)">@maq.Nombre — Catálogo: @maq.Cantidad ud(s) × C$ @maq.Precio.ToString("N2") (@maq.MesesProyeccion meses)</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedMachinery.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Class="mb-2" Elevation="0" Dense="true" Hover="true" Bordered="true">
                                    <thead>
                                        <tr style="background-color: #f4f7f5;">
                                            <th>Equipo / Maquinaria</th>
                                            <th style="width: 90px; text-align: center;">Cant.</th>
                                            <th style="width: 145px; text-align: right;">Costo Unit. (C$)</th>
                                            <th style="width: 95px; text-align: center;">Meses</th>
                                            <th style="width: 125px; text-align: right;">Amortiz./Mes</th>
                                            <th style="width: 115px; text-align: right;">Costo/Turno</th>
                                            <th style="width: 50px; text-align: center;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedMachinery)
                                        {
                                            var maq = machineryList.FirstOrDefault(x => x.Id == id);
                                            if (maq != null)
                                            {
                                                decimal monthly = GetMachineryMonthly(id);
                                                decimal perShift = monthly / EffectiveDiasMes;
                                                <tr>
                                                    <td style="vertical-align: middle; font-weight: 600;">@maq.Nombre</td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="int" Value="@GetMachineryQuantity(id)" ValueChanged="@((int val) => SetMachineryQuantity(id, val))" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@GetMachineryPrice(id)" ValueChanged="@((decimal val) => SetMachineryPrice(id, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="int" Value="@GetMachineryMonths(id)" ValueChanged="@((int val) => SetMachineryMonths(id, val))" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                                                    </td>
                                                    <td style="text-align: right; vertical-align: middle; font-weight: 600;">C$ @monthly.ToString("N2")</td>
                                                    <td style="text-align: right; vertical-align: middle; color: #1b5e20; font-weight: 700;">C$ @perShift.ToString("N2")</td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMachineryRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                                <div class="d-flex justify-space-between flex-wrap gap-2 px-2 py-2" style="background: #f8faf9; border-radius: 8px; font-size: 0.84rem;">
                                    <span>Inversión CAPEX Total: <strong>C$ @CalculatedCapexTotal.ToString("N2")</strong></span>
                                    <span>Amortización Mensual: <strong>C$ @CalculatedAmortizacionMensual.ToString("N2")/mes</strong></span>
                                    <span style="color: #1b5e20;">Costo Equipos por Turno: <strong>C$ @CalculatedCostoTurnoMaquinaria.ToString("N2")/turno</strong></span>
                                </div>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined">
                                    Escenario sin amortización de equipos propios (C$ 0.00/unidad). Agregue equipos arriba si BUSSERSA suministra la maquinaria.
                                </MudAlert>
                            }
                        </MudCard>

                        <!-- PASO 3: PRODUCTO (SKU), CAPACIDAD POR TURNO, MÁRGENES Y MATERIALES -->
                        <MudCard Elevation="2" Class="pa-5 mb-4 prod-step-card">
                            <div class="prod-step-header">
                                <div class="d-flex align-center gap-3">
                                    <span class="prod-step-badge">3</span>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-bold" Style="line-height: 1.2;">Producto (SKU), Unidades por Turno e Insumos</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">Fije las unidades producidas por turno, merma operativa, margen comercial e insumos aportados por unidad.</MudText>
                                    </div>
                                </div>
                            </div>

                            <MudTextField @bind-Value="skuNombre" Label="Código y Descripción del SKU / Proceso de Maquila" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Required="true" Placeholder="ej. SAJECM0009 - SPORADE UVA PET NR 360 ML 8 MODERNO" />

                            <MudGrid Spacing="2" Class="mb-3">
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="int" Value="produccionDiaria" ValueChanged="OnProduccionDiariaChanged" Label="Unidades por Turno" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Adornment="Adornment.End" AdornmentText="uds" HelperText="@($"Jornada de {CurrentHorasTurno}h efectivas")" />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="decimal" Value="CalculatedUnidadesPorHora" ValueChanged="OnUnidadesPorHoraChanged" Label="Equiv. Unidades / Hora" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Format="N1" Adornment="Adornment.End" AdornmentText="uds/h" HelperText="Cálculo rápido × horas turno" />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="decimal" @bind-Value="turnosAsignadosMes" Label="Turnos Asignados / Mes" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Max="60m" Format="N1" HelperText="26 = mes completo | Mix ej. 3.5" />
                                </MudItem>
                            </MudGrid>

                            <MudGrid Spacing="2" Class="mb-4">
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="decimal" Value="mermaPorcentaje" ValueChanged="OnMermaChanged" Label="Margen de Merma Operativa (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" Min="0m" Max="50m" Adornment="Adornment.End" AdornmentText="%" />
                                </MudItem>
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="decimal" Value="utilidadPorcentaje" ValueChanged="OnUtilidadChanged" Label="Margen de Utilidad Comercial (% s/Venta)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" Min="0m" Max="95m" Adornment="Adornment.End" AdornmentText="%" HelperText="Tarifa = Costo / (1 - % Utilidad)" />
                                </MudItem>
                            </MudGrid>

                            <!-- Materiales e Insumos por Unidad (Opcional) -->
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="font-bold">Materiales e Insumos Aportados por Unidad (Opcional)</MudText>
                                @if (selectedMateriales.Any())
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ClearSelectedMateriales">Quitar Todos</MudButton>
                                }
                            </div>

                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedMaterialToAdd" ValueChanged="AddMaterialRow" Label="Seleccionar Insumo / Material del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Placeholder="Sin materiales adicionales (cliente suministra insumos)">
                                    @foreach (var mat in materialesList.Where(x => !selectedMateriales.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)mat.Id)">@mat.Nombre (C$ @mat.CostoUnitario.ToString("N4"))</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedMateriales.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Elevation="0" Dense="true" Hover="true" Bordered="true">
                                    <thead>
                                        <tr style="background-color: #f4f7f5;">
                                            <th>Insumo / Material</th>
                                            <th style="width: 110px; text-align: right;">Cantidad / Ud</th>
                                            <th style="width: 135px; text-align: right;">Costo Unit. (C$)</th>
                                            <th style="width: 120px; text-align: right;">Subtotal / Ud</th>
                                            <th style="width: 50px; text-align: center;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedMateriales)
                                        {
                                            var mat = materialesList.FirstOrDefault(x => x.Id == id);
                                            if (mat != null)
                                            {
                                                decimal q = GetMaterialQuantity(id);
                                                decimal c = GetMaterialCost(id);
                                                <tr>
                                                    <td style="vertical-align: middle;">@mat.Nombre</td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@q" ValueChanged="@((decimal val) => SetMaterialQuantity(id, val))" Format="N4" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.0001m" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@c" ValueChanged="@((decimal val) => SetMaterialCost(id, val))" Format="N4" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" />
                                                    </td>
                                                    <td style="text-align: right; vertical-align: middle; font-weight: 700;">C$ @((q * c).ToString("N4"))</td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMaterialRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </MudCard>
                    </MudItem>

                    <!-- COLUMNA DERECHA: CASCADA EJECUTIVA DE PRECIO UNITARIO Y EQUILIBRIO -->
                    <MudItem XS="12" lg="5">
                        <div class="summary-sticky-wrap">
                            <MudCard Elevation="6" Class="pa-5 waterfall-card">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <MudText Typo="Typo.h6" Class="font-bold">Estructura del Precio Unitario</MudText>
                                    <MudChip T="string" Size="Size.Small" Style="background: rgba(255,255,255,0.18); color: white; font-weight: 700;">
                                        @(IsNightShift(CurrentTurnoNombre) ? "🌙 " : "☀️ ") @CurrentTurnoNombre • @cantidadTrabajadores pers.
                                    </MudChip>
                                </div>

                                <div class="waterfall-row">
                                    <span style="opacity: 0.85;">1. Mano de Obra Unitaria (@produccionDiaria.ToString("N0") uds/turno):</span>
                                    <strong>C$ @CalculatedManoObraUnitaria.ToString("N4")</strong>
                                </div>
                                <div class="waterfall-row">
                                    <span style="opacity: 0.85;">2. Maquinaria y Equipos Unit.:</span>
                                    <strong>C$ @CalculatedAmortizacionUnitaria.ToString("N4")</strong>
                                </div>
                                <div class="waterfall-row">
                                    <span style="opacity: 0.85;">3. Materiales e Insumos Unit.:</span>
                                    <strong>C$ @CalculatedMateriales.ToString("N4")</strong>
                                </div>
                                <div class="waterfall-row">
                                    <span style="opacity: 0.85;">4. Merma Operativa (@mermaPorcentaje.ToString("N2")%):</span>
                                    <strong>C$ @CalculatedMermaCosto.ToString("N4")</strong>
                                </div>

                                <div class="waterfall-subtotal">
                                    <span>COSTO OPERATIVO UNITARIO:</span>
                                    <span style="color: #a5d6a7; font-size: 1.02rem;">C$ @CalculatedCostoOperativoUnitario.ToString("N4")</span>
                                </div>

                                <div class="waterfall-row" style="border-bottom: none;">
                                    <span style="opacity: 0.88;">+ Utilidad Comercial (@utilidadPorcentaje.ToString("N1")% s/venta):</span>
                                    <strong style="color: #69f0ae;">C$ @CalculatedUtilidadUnitaria.ToString("N4")</strong>
                                </div>

                                <!-- Precio Unitario Sugerido -->
                                <div class="price-hero-box">
                                    <MudText Typo="Typo.caption" Style="letter-spacing: 0.08em; opacity: 0.88;">PRECIO / TARIFA UNITARIA SUGERIDA</MudText>
                                    <MudText Typo="Typo.h3" Class="font-bold my-1" Style="color: #00E676;">C$ @CalculatedTarifaUnitaria.ToString("N2")</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.78;">Exacto a 4 decimales: C$ @CalculatedTarifaUnitaria.ToString("N4") / unidad</MudText>
                                </div>

                                <!-- Tarifa Acordada Editable -->
                                <div class="d-flex align-center gap-2 mb-4 pa-2" style="background: rgba(255,255,255,0.12); border-radius: 10px;">
                                    <MudNumericField T="decimal" Value="tarifaAcordada" ValueChanged="OnTarifaAcordadaManualChanged" Label="Tarifa Comercial Acordada (C$ / Unidad)" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 mud-theme-success" Style="color: white; font-weight: 800;" />
                                    @if (isTarifaManualOverride)
                                    {
                                        <MudTooltip Text="Restaurar a tarifa sugerida">
                                            <MudIconButton Icon="@Icons.Material.Filled.Sync" Color="Color.Inherit" Size="Size.Small" OnClick="ResetTarifaToSuggested" />
                                        </MudTooltip>
                                    }
                                </div>

                                <!-- Proyecciones Financieras por Turno y Mensual -->
                                <div class="projection-grid-light mb-4">
                                    <MudGrid Spacing="1">
                                        <MudItem XS="6" Class="border-r pr-2" Style="border-color: rgba(0,0,0,0.08) !important;">
                                            <MudText Typo="Typo.caption" Style="color: #546e7a; font-weight: 700;">POR TURNO (@produccionDiaria.ToString("N0") uds)</MudText>
                                            <div class="d-flex justify-space-between text-caption mt-1">
                                                <span>Facturación:</span>
                                                <strong>C$ @CalculatedFacturacionDiaria.ToString("N2")</strong>
                                            </div>
                                            <div class="d-flex justify-space-between text-caption">
                                                <span>Costo Op.:</span>
                                                <span>C$ @CalculatedCostoPorTurno.ToString("N2")</span>
                                            </div>
                                            <div class="d-flex justify-space-between text-caption" style="color: #1b5e20; font-weight: 700;">
                                                <span>Utilidad/Turno:</span>
                                                <span>C$ @CalculatedUtilidadPorTurno.ToString("N2")</span>
                                            </div>
                                        </MudItem>
                                        <MudItem XS="6" Class="pl-2">
                                            <MudText Typo="Typo.caption" Style="color: #0d47a1; font-weight: 700;">MENSUAL (@EffectiveTurnosAsignadosMes.ToString("N1") turnos)</MudText>
                                            <div class="d-flex justify-space-between text-caption mt-1">
                                                <span>Facturación:</span>
                                                <strong style="color: #0d47a1;">C$ @CalculatedFacturacionMensual.ToString("N2")</strong>
                                            </div>
                                            <div class="d-flex justify-space-between text-caption">
                                                <span>Utilidad Mes:</span>
                                                <strong style="color: #1b5e20;">C$ @CalculatedUtilidadMensualSku.ToString("N2")</strong>
                                            </div>
                                            <div class="d-flex justify-space-between text-caption">
                                                <span>Margen Real:</span>
                                                <strong>@CalculatedMargenRealPorcentaje.ToString("N1")%</strong>
                                            </div>
                                        </MudItem>
                                    </MudGrid>
                                </div>

                                <!-- Punto de Equilibrio del Turno -->
                                @if (CalculatedCostoFijoTurnoConMerma > 0m)
                                {
                                    <div class="breakeven-box mb-4">
                                        <div class="d-flex justify-space-between align-center mb-1">
                                            <span style="font-size: 0.78rem; font-weight: 700; color: #69f0ae;">📊 PUNTO DE EQUILIBRIO DEL TURNO</span>
                                            <span style="font-size: 0.76rem; opacity: 0.85;">Costo Fijo/Turno: C$ @CalculatedCostoFijoTurnoConMerma.ToString("N2")</span>
                                        </div>
                                        @if (CalculatedMargenContribucionUnitario <= 0m)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Warning">⚠️ La tarifa acordada no cubre los materiales variables.</MudText>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-space-between align-center mt-1">
                                                <span style="font-size: 0.82rem;">Mínimo para cubrir @cantidadTrabajadores pers. + equipos:</span>
                                                <strong style="font-size: 1.05rem; color: #00E676;">@CalculatedUnidadesBreakeven.ToString("N0") uds/turno</strong>
                                            </div>
                                            <MudText Typo="Typo.caption" Style="opacity: 0.82; display: block; margin-top: 2px;">
                                                @(CalculatedUnidadesBreakeven <= produccionDiaria
                                                    ? $"✅ Rentable: Equilibrio al {(CalculatedUnidadesBreakeven / produccionDiaria * 100m):N1}% de la capacidad del turno."
                                                    : "⚠️ Alerta: El equilibrio supera las unidades estimadas por turno.")
                                            </MudText>
                                        }
                                    </div>
                                }

                                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.AddShoppingCart" FullWidth="true" OnClick="AddProductToQuote" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 10px; background-color: #00E676; color: #042f1a;">
                                    Agregar SKU (@CurrentTurnoNombre) a la Cotización
                                </MudButton>
                            </MudCard>
                        </div>
                    </MudItem>
                </MudGrid>

                <!-- TABLA DE PRODUCTOS AGREGADOS EN LA COTIZACIÓN ACTUAL -->
                @if (currentItems.Any())
                {
                    <div class="mt-6">
                        <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                            <MudText Typo="Typo.h6" Class="font-bold" Style="color: #0D47A1;">
                                📦 Portafolio de SKUs en la Cotización Actual (@currentItems.Count)
                            </MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">
                                Puede agregar SKUs de un mismo turno o duplicarlos al turno alterno con el botón <MudIcon Icon="@Icons.Material.Filled.NightlightRound" Size="Size.Small" />.
                            </MudText>
                        </div>

                        <MudGrid Spacing="3">
                            <MudItem XS="12" lg="9">
                                <MudTable Items="currentItems" Hover="true" Elevation="3" Dense="true" Style="border-radius: 12px; border-top: 4px solid #1976D2;">
                                    <HeaderContent>
                                        <MudTh>Producto / SKU</MudTh>
                                        <MudTh>Turno</MudTh>
                                        <MudTh Style="text-align: center;">Pers.</MudTh>
                                        <MudTh Style="text-align: right;">Uds/Turno</MudTh>
                                        <MudTh Style="text-align: right;">Turnos/Mes</MudTh>
                                        <MudTh Style="text-align: right;">Costo Unit.</MudTh>
                                        <MudTh Style="text-align: right;">Sugerida</MudTh>
                                        <MudTh Style="text-align: right;">Acordada</MudTh>
                                        <MudTh Style="text-align: right;">Fact. Mensual</MudTh>
                                        <MudTh Style="width: 120px; text-align: center;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        @{
                                            decimal costoOp = GetItemCostoOperativoUnit(context);
                                            decimal turnosM = GetItemTurnosMes(context);
                                            bool night = IsNightShift(context.Turno);
                                        }
                                        <MudTd DataLabel="SKU" Style="font-weight: 600;">@context.SkuNombre</MudTd>
                                        <MudTd DataLabel="Turno">
                                            <MudChip T="string" Size="Size.Small" Color="@(night ? Color.Info : Color.Success)" Variant="Variant.Outlined">
                                                @(night ? "🌙 " : "☀️ ") @(context.Turno ?? "Diurno")
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Pers." Style="text-align: center;">@context.CantidadTrabajadores</MudTd>
                                        <MudTd DataLabel="Uds/Turno" Style="text-align: right;">@context.ProduccionDiaria.ToString("N0")</MudTd>
                                        <MudTd DataLabel="Turnos/Mes" Style="text-align: right;">@turnosM.ToString("N1")</MudTd>
                                        <MudTd DataLabel="Costo Unit." Style="text-align: right;">C$ @costoOp.ToString("N2")</MudTd>
                                        <MudTd DataLabel="Sugerida" Style="text-align: right;">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
                                        <MudTd DataLabel="Acordada" Style="text-align: right;" Class="font-bold text-success">C$ @context.TarifaAcordada.ToString("N2")</MudTd>
                                        <MudTd DataLabel="Fact. Mensual" Style="text-align: right; font-weight: 600;">C$ @((context.TarifaAcordada * context.ProduccionDiaria * turnosM).ToString("N2"))</MudTd>
                                        <MudTd DataLabel="Acciones" Style="text-align: center;">
                                            <MudTooltip Text="Cotizar este mismo SKU en otro turno">
                                                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Info" Size="Size.Small" OnClick="@(() => DuplicateSkuForAlternateShift(context))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Editar SKU">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditProductInQuote(context))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Quitar SKU">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveProductFromQuote(context))" />
                                            </MudTooltip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>

                            <MudItem XS="12" lg="3">
                                <MudCard Elevation="4" Class="pa-5 text-white" Style="background: linear-gradient(145deg, #0D47A1, #1565C0); border-radius: 14px;">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-3">Consolidado del Portafolio</MudText>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">Cliente:</span>
                                        <strong>@(string.IsNullOrWhiteSpace(cliente) ? "Sin definir" : cliente)</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">SKUs / Turnos Mes:</span>
                                        <strong>@currentItems.Count SKUs (@ConsolidatedTurnosTotalesMes.ToString("N1") turnos)</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">Unidades / Mes:</span>
                                        <strong>@ConsolidatedUnidadesMensuales.ToString("N0") uds</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">Costo Op. Mensual:</span>
                                        <strong>C$ @ConsolidatedCostoMensual.ToString("N2")</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">Facturación Mensual:</span>
                                        <strong style="color: #69f0ae;">C$ @ConsolidatedFacturacionMensual.ToString("N2")</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-4 pb-2 border-b text-body2" style="border-color: rgba(255,255,255,0.2) !important;">
                                        <span style="opacity: 0.8;">Utilidad Bruta:</span>
                                        <strong style="color: #00E676;">C$ @ConsolidatedUtilidadMensual.ToString("N2") (@ConsolidatedMargenPorcentaje.ToString("N1")%)</strong>
                                    </div>

                                    <MudButton Variant="Variant.Filled" FullWidth="true" OnClick="SaveQuote" StartIcon="@Icons.Material.Filled.Save" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 10px; background-color: #00E676; color: #042f1a;">
                                        @(editingQuoteId.HasValue ? "Actualizar Cotización" : "Guardar Cotización")
                                    </MudButton>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </div>
                }
            </div>
        </MudTabPanel>

        <!-- ========================================================= -->
        <!-- PESTAÑA 2: HISTORIAL DE COTIZACIONES DE PRODUCCIÓN        -->
        <!-- ========================================================= -->
        <MudTabPanel Text="Historial de Cotizaciones">
            <div class="pa-4 pa-md-6">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-4">
                    <MudText Typo="Typo.h5" Class="font-bold" Color="Color.Success">Historial de Cotizaciones de Producción y Maquila</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">Expanda cualquier cotización para ajustar tarifas acordadas o seleccionar SKUs específicos para PDF.</MudText>
                </div>

                <MudTable Items="savedQuotes" Hover="true" Elevation="2" Class="mb-6" Style="border-radius: 12px;">
                    <HeaderContent>
                        <MudTh Style="width: 48px;"></MudTh>
                        <MudTh>Cotización No.</MudTh>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Cliente / Proyecto</MudTh>
                        <MudTh>Turnos / Cuadrilla</MudTh>
                        <MudTh>SKUs</MudTh>
                        <MudTh Style="text-align: right;">Costo Op. Mensual</MudTh>
                        <MudTh Style="text-align: right;">Facturación Mensual</MudTh>
                        <MudTh Style="width: 170px; text-align: center;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var details = GetQuoteDetailsList(context);
                            var distinctTurnos = details.Select(d => d.Turno ?? "Diurno").Distinct().ToList();
                            int maxPers = details.Any() ? details.Max(d => d.CantidadTrabajadores) : 1;
                            decimal factMes = details.Any()
                                ? details.Sum(d => d.TarifaAcordada * d.ProduccionDiaria * GetItemTurnosMes(d))
                                : context.TarifaAcordada;
                            decimal costoMes = details.Any()
                                ? details.Sum(d => GetItemCostoOperativoUnit(d) * d.ProduccionDiaria * GetItemTurnosMes(d))
                                : context.CostoTotal;
                        }
                        <MudTd>
                            <MudIconButton Icon="@(expandedQuotes.Contains(context) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                           OnClick="@(() => ToggleRow(context))" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Cotización No." Class="font-bold" Style="color: #1b5e20;">@(context.NumeroCotizacion ?? "N/A")</MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaCreacion.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Cliente" Style="font-weight: 600;">@context.ClienteNombre</MudTd>
                        <MudTd DataLabel="Turnos">
                            @foreach (var t in distinctTurnos)
                            {
                                bool night = IsNightShift(t);
                                <MudChip T="string" Size="Size.Small" Color="@(night ? Color.Info : Color.Success)" Variant="Variant.Outlined" Class="mr-1">
                                    @(night ? "🌙 " : "☀️ ") @t (@maxPers pers.)
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="SKUs">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@details.Count SKUs</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Costo Op. Mensual" Style="text-align: right;">C$ @costoMes.ToString("N2")</MudTd>
                        <MudTd DataLabel="Facturación Mensual" Style="text-align: right;" Class="font-bold text-success">C$ @factMes.ToString("N2")</MudTd>
                        <MudTd Style="text-align: center;">
                            <div class="d-flex justify-center gap-1">
                                <MudTooltip Text="Abrir y editar en el Cotizador">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadQuoteToForm(context))" />
                                </MudTooltip>
                                <MudTooltip Text="@($"Imprimir Propuesta PDF ({GetSelectedSkusForPrint(context).Count} SKUs)")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Success" Size="Size.Small" OnClick="@(() => PrintConsolidatedCotizacion(context))" />
                                </MudTooltip>
                                <MudTooltip Text="@($"Imprimir Desglose de Costos ({GetSelectedSkusForPrint(context).Count} SKUs)")">
                                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Info" Size="Size.Small" OnClick="@(() => PrintConsolidatedCotizacionDesglose(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar Cotización">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteQuote(context.Id))" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (expandedQuotes.Contains(context))
                        {
                            <MudTr>
                                <td colspan="9" class="pa-4" style="background-color: #f8faf9;">
                                    <MudCard Elevation="1" Outlined="true" Class="pa-4" Style="border-radius: 10px; border-left: 5px solid #2E7D32;">
                                        <div class="d-flex justify-space-between align-center flex-wrap mb-3">
                                            <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Success">
                                                Detalle Tarifario por SKU — @context.ClienteNombre
                                            </MudText>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayForWork" OnClick="@(() => LoadQuoteToForm(context))">
                                                Cargar en Cotizador
                                            </MudButton>
                                        </div>
                                        <MudTable Items="GetQuoteDetailsList(context)" MultiSelection="true" T="CotizacionProduccionDetalle" SelectedItems="GetSelectedSkusForPrint(context)" SelectedItemsChanged="((val) => OnSelectedSkusChanged(context, val))" Context="detailContext" Hover="true" Dense="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>Producto / SKU</MudTh>
                                                <MudTh>Turno</MudTh>
                                                <MudTh Style="text-align: center;">Pers.</MudTh>
                                                <MudTh Style="text-align: right;">Uds/Turno</MudTh>
                                                <MudTh Style="text-align: right;">M.O. Unit.</MudTh>
                                                <MudTh Style="text-align: right;">Equipos Unit.</MudTh>
                                                <MudTh Style="text-align: right;">Costo Op. (+Merma)</MudTh>
                                                <MudTh Style="text-align: right;">Precio Sugerido</MudTh>
                                                <MudTh Style="text-align: right;">Tarifa Acordada (C$)</MudTh>
                                                <MudTh Style="text-align: right;">Turnos/Mes</MudTh>
                                                <MudTh Style="text-align: right;">Facturación Mes</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                @{
                                                    decimal costoOpDet = GetItemCostoOperativoUnit(detailContext);
                                                    decimal tMesDet = GetItemTurnosMes(detailContext);
                                                    bool isNightDet = IsNightShift(detailContext.Turno);
                                                }
                                                <MudTd DataLabel="SKU" Style="font-weight: 600;">@detailContext.SkuNombre</MudTd>
                                                <MudTd DataLabel="Turno">
                                                    <MudChip T="string" Size="Size.Small" Color="@(isNightDet ? Color.Info : Color.Success)" Variant="Variant.Text">
                                                        @(isNightDet ? "🌙 " : "☀️ ") @(detailContext.Turno ?? "Diurno")
                                                    </MudChip>
                                                </MudTd>
                                                <MudTd DataLabel="Pers." Style="text-align: center;">@detailContext.CantidadTrabajadores</MudTd>
                                                <MudTd DataLabel="Uds/Turno" Style="text-align: right;">@detailContext.ProduccionDiaria.ToString("N0")</MudTd>
                                                <MudTd DataLabel="M.O. Unit." Style="text-align: right;">C$ @detailContext.ManoObraUnitaria.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Equipos Unit." Style="text-align: right;">C$ @detailContext.AmortizacionUnitaria.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Costo Op." Style="text-align: right;">C$ @costoOpDet.ToString("N2")</MudTd>
                                                <MudTd DataLabel="Sugerida" Style="text-align: right;" Class="font-bold">C$ @detailContext.TarifaSugerida.ToString("N2")</MudTd>
                                                <MudTd DataLabel="Tarifa Acordada" Style="text-align: right;">
                                                    <MudNumericField T="decimal" Value="@detailContext.TarifaAcordada" ValueChanged="@((decimal val) => UpdateTarifaAcordada(context, detailContext, val))" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 130px; background-color: white;" Adornment="Adornment.Start" AdornmentText="C$" />
                                                </MudTd>
                                                <MudTd DataLabel="Turnos/Mes" Style="text-align: right;">@tMesDet.ToString("N1")</MudTd>
                                                <MudTd DataLabel="Fact. Mes" Style="text-align: right; font-weight: 700; color: #1b5e20;">
                                                    C$ @((detailContext.TarifaAcordada * detailContext.ProduccionDiaria * tMesDet).ToString("N2"))
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </MudCard>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                    <NoRecordsContent>
                        <div class="pa-6 text-center text-muted">No hay cotizaciones de producción registradas.</div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <!-- ========================================================= -->
        <!-- PESTAÑA 3: CATÁLOGOS GLOBALES                             -->
        <!-- ========================================================= -->
        <MudTabPanel Text="Gestión de Catálogos">
            <div class="pa-6">
                <MudText Typo="Typo.h5" Class="mb-6 font-bold" Color="Color.Success">Gestión de Catálogos Globales (Materiales, Maquinaria, EPP y Viáticos)</MudText>

                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Secondary">
                    <MudTabPanel Text="Materiales e Insumos">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="materialesList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Costo Unitario</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.CostoUnitario.ToString("N4")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditMaterial(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMaterial(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMaterial.Id > 0 ? "Editar Material" : "Agregar Material")</MudText>
                                    <MudTextField @bind-Value="editingMaterial.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingMaterial.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N4" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveMaterial">Guardar</MudButton>
                                        @if (editingMaterial.Id > 0 || !string.IsNullOrEmpty(editingMaterial.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditMaterial">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Maquinaria y Equipos">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="machineryList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Precio</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>Meses Proyección</MudTh>
                                        <MudTh>Personas</MudTh>
                                        <MudTh>Proyección Mensual</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.Precio.ToString("N2")</MudTd>
                                        <MudTd>@context.Cantidad</MudTd>
                                        <MudTd>@context.MesesProyeccion</MudTd>
                                        <MudTd>@context.Personas</MudTd>
                                        <MudTd>C$ @context.ProyeccionMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditMachinery(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMachinery(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMachinery.Id > 0 ? "Editar Equipo" : "Agregar Equipo")</MudText>
                                    <MudTextField @bind-Value="editingMachinery.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingMachinery.Precio" Label="Precio" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N2" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.MesesProyeccion" Label="Meses Proyección" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.Personas" Label="Personas (Nº Trabajadores)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Min="1" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveMachinery">Guardar</MudButton>
                                        @if (editingMachinery.Id > 0 || !string.IsNullOrEmpty(editingMachinery.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditMachinery">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Equipos de Protección (EPP)">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="eppList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>Meses Prorrateo</MudTh>
                                        <MudTh>Costo Unitario</MudTh>
                                        <MudTh>Costo Mensual (Prorrateado)</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>@context.Cantidad.ToString("N1")</MudTd>
                                        <MudTd>@context.MesesProrrateo.ToString("N0")</MudTd>
                                        <MudTd>C$ @context.CostoUnitario.ToString("N2")</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditEpp(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteEpp(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingEpp.Id > 0 ? "Editar EPP" : "Agregar EPP")</MudText>
                                    <MudTextField @bind-Value="editingEpp.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N1" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.MesesProrrateo" Label="Meses Prorrateo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N0" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveEpp">Guardar</MudButton>
                                        @if (editingEpp.Id > 0 || !string.IsNullOrEmpty(editingEpp.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditEpp">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Viáticos y Beneficios">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="viaticosList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Costo Mensual</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditViatico(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteViatico(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingViatico.Id > 0 ? "Editar Viático" : "Agregar Viático")</MudText>
                                    <MudTextField @bind-Value="editingViatico.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingViatico.CostoMensual" Label="Costo Mensual" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveViatico">Guardar</MudButton>
                                        @if (editingViatico.Id > 0 || !string.IsNullOrEmpty(editingViatico.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditViatico">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </MudTabPanel>
    </MudTabs>
</MudContainer>
