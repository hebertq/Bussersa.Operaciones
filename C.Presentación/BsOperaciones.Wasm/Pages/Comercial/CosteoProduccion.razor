@page "/comercial/costeo-produccion"
@using Modelo.Comercial
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8" Style="position: relative;">
    @if (isPrinting)
    {
        <MudOverlay Visible="true" LightBackground="true" Absolute="false" ZIndex="9999">
            <div class="d-flex flex-column align-center justify-center">
                <MudProgressCircular Color="Color.Success" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4 font-bold" Color="Color.Success">Generando PDF de Cotización... Por favor, espere.</MudText>
            </div>
        </MudOverlay>
    }

    <!-- Encabezado Ejecutivo -->
    <div class="prod-hero-header mb-4">
        <div>
            <MudText Typo="Typo.h5" Class="font-bold">Cotizador de Servicios de Producción y Maquila (Por Unidad / SKU)</MudText>
            <MudText Typo="Typo.body2" Style="opacity: 0.86;">
                Defina el turno y cuadrilla a la izquierda y configure cada SKU con su maquinaria efectiva y costo calculado en el panel derecho.
            </MudText>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Badge" OnClick="GoToCosteoPersonal" Size="Size.Small" Style="border-color: rgba(255,255,255,0.5);">
                Ir a Costeo Personal
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="@(() => showExcelPanel = !showExcelPanel)" Size="Size.Small" Style="background-color: #00C853; color: #052e16; font-weight: 700;">
                @(showExcelPanel ? "Ocultar Lote Excel" : "Importar SKUs Excel")
            </MudButton>
            @if (editingQuoteId.HasValue || currentItems.Any() || !string.IsNullOrEmpty(cliente))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ClearCurrentQuoteForm" Size="Size.Small" Style="border-color: rgba(255,255,255,0.5);">
                    Nueva Cotización
                </MudButton>
            }
        </div>
    </div>

    @* --- BARRA DE BOTONES DE PESTAÑAS ESTILO APP / TABLET --- *@
    <div class="app-tab-bar-card mb-3">
        <div class="app-tab-grid cols-3">
            <button type="button"
                    class="app-tab-item @(activeTabIndex == 0 ? "active" : "")"
                    @onclick="() => SetActiveTab(0)"
                    title="Cotizador de Producción">
                <div class="app-tab-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Calculate" />
                    @if (currentItems != null && currentItems.Any())
                    {
                        <span class="app-tab-badge badge-primary">@currentItems.Count</span>
                    }
                </div>
                <div class="app-tab-label-wrap">
                    <span class="app-tab-label">Cotizador Producción</span>
                </div>
            </button>

            <button type="button"
                    class="app-tab-item @(activeTabIndex == 1 ? "active" : "")"
                    @onclick="() => SetActiveTab(1)"
                    title="Historial de Cotizaciones">
                <div class="app-tab-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.History" />
                    @if (savedQuotes != null && savedQuotes.Any())
                    {
                        <span class="app-tab-badge badge-info">@savedQuotes.Count</span>
                    }
                </div>
                <div class="app-tab-label-wrap">
                    <span class="app-tab-label">Historial Cotizaciones</span>
                </div>
            </button>

            <button type="button"
                    class="app-tab-item @(activeTabIndex == 2 ? "active" : "")"
                    @onclick="() => SetActiveTab(2)"
                    title="Gestión de Catálogos Globales">
                <div class="app-tab-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" />
                </div>
                <div class="app-tab-label-wrap">
                    <span class="app-tab-label">Catálogos Globales</span>
                </div>
            </button>
        </div>
    </div>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
             Class="tablet-tabs mb-6" @bind-ActivePanelIndex="@activeTabIndex">

        <!-- ========================================================= -->
        <!-- PESTAÑA 1: COTIZADOR CONSOLIDADO                          -->
        <!-- ========================================================= -->
        <MudTabPanel Text="Cotizador de Producción">
            <div class="pa-2 pa-md-3">

                @if (editingQuoteId.HasValue)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3" Style="border-radius: 10px;">
                        Editando cotización existente: <strong>@(editingNumeroCotizacion ?? cliente)</strong>. Seleccione cualquier SKU abajo con el botón <strong>Editar</strong> para cargarlo en el panel derecho, y al finalizar presione <strong>Actualizar Cotización</strong>.
                    </MudAlert>
                }

                @if (showExcelPanel || importedProducts.Any())
                {
                    <MudCard Elevation="2" Class="pa-3 mb-3" Style="border-radius: 12px; background-color: rgba(220,237,200,0.22); border-left: 5px solid #2E7D32;">
                        <MudGrid AlignItems="AlignItems.Center">
                            <MudItem XS="12" MD="6">
                                <div class="d-flex align-center gap-3">
                                    <MudIcon Icon="@Icons.Material.Filled.TableView" Color="Color.Success" Size="Size.Medium" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="font-bold">Carga en Serie de SKUs desde Excel</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">Suba un archivo .xlsx con la lista de SKUs en la primera columna para cotizarlos en serie.</MudText>
                                    </div>
                                </div>
                            </MudItem>
                            <MudItem XS="12" MD="6" Class="d-flex justify-end gap-2 align-center flex-wrap">
                                <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadExcelFile" Accept=".xlsx">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.AttachFile" Size="Size.Small">
                                            Seleccionar Excel (.xlsx)
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                @if (importedProducts.Any())
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">SKU @(currentProductIndex + 1) / @importedProducts.Count</MudChip>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToPreviousProduct" Disabled="@(currentProductIndex <= 0)">Anterior</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="GoToNextProduct" Disabled="@(currentProductIndex >= importedProducts.Count - 1)">Siguiente</MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="ClearImportedProducts" />
                                }
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                }

                <MudGrid Spacing="3">
                    <!-- =============================================================== -->
                    <!-- PANEL IZQUIERDO: CLIENTE, PERSONAL, TURNO, PERSONAS Y MÁRGENES -->
                    <!-- =============================================================== -->
                    <MudItem XS="12" lg="5">
                        <MudCard Elevation="2" Class="pa-4 prod-step-card h-100">
                            <div class="prod-step-header">
                                <div class="d-flex align-center gap-3">
                                    <span class="prod-step-badge">1</span>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-bold" Style="line-height: 1.2;">Cliente, Personal y Turno</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">Parámetros generales de cuadrilla, turno y márgenes.</MudText>
                                    </div>
                                </div>
                                @if (selectedPersonnelQuote != null)
                                {
                                    <MudChip T="string" Color="@(IsNightShift(CurrentTurnoNombre) ? Color.Info : Color.Success)" Size="Size.Small" Variant="Variant.Filled">
                                        @(IsNightShift(CurrentTurnoNombre) ? "🌙 " : "☀️ ") @CurrentTurnoNombre (@CurrentHorasTurno h) • @cantidadTrabajadores pers.
                                    </MudChip>
                                }
                            </div>

                            <MudGrid Spacing="2">
                                <MudItem XS="12" SM="6">
                                    <MudTextField @bind-Value="cliente" Label="Nombre del Cliente / Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Placeholder="ej. Grupo AJE - Maquila Moderno" />
                                </MudItem>
                                <MudItem XS="12" SM="6">
                                    <MudSelect T="string" Value="selectedFilterEmpresa" ValueChanged="OnEmpresaFilterChanged" Label="Costeo de Personal (Empresa)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Seleccione costeo personal" Clearable="true">
                                        @foreach (var emp in personnelQuotes.Select(x => x.ClienteNombre).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
                                        {
                                            <MudSelectItem T="string" Value="@emp">@emp</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                            @if (!string.IsNullOrWhiteSpace(selectedFilterEmpresa))
                            {
                                var shiftsForClient = personnelQuotes.Where(x => x.ClienteNombre == selectedFilterEmpresa).OrderBy(x => x.PersonalDetalle?.Turno).ToList();
                                <MudText Typo="Typo.caption" Class="font-bold d-block mt-3 mb-2" Color="Color.Success">
                                    TURNO SELECCIONADO (@shiftsForClient.Count disponible@(shiftsForClient.Count == 1 ? "" : "s")):
                                </MudText>
                                <div class="shift-cards-stack mb-3">
                                    @foreach (var q in shiftsForClient)
                                    {
                                        bool isSel = selectedPersonnelQuoteId == q.Id;
                                        bool isNight = IsNightShift(q.PersonalDetalle?.Turno);
                                        decimal viat = q.PersonalDetalle?.ViaticosTotales ?? 0m;
                                        decimal costoDia = q.CostoTotal / EffectiveDiasMes;
                                        <div role="button"
                                             tabindex="0"
                                             class="shift-option-card @(isSel ? (isNight ? "selected-night" : "selected") : "")"
                                             @onclick="@(() => OnPersonnelQuoteChanged(q.Id))">
                                            <!-- Sección 1: Nombre del Turno y Costo Diario por Persona -->
                                            <div class="shift-card-sec-top">
                                                <div class="shift-card-title">
                                                    <span>@(isNight ? "🌙" : "☀️")</span>
                                                    <span>@(q.PersonalDetalle?.Turno ?? "Estándar") (@(q.PersonalDetalle?.HorasTurno ?? 8)h)</span>
                                                    @if (isSel)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="@(isNight ? Color.Info : Color.Success)" Size="Size.Small" />
                                                    }
                                                </div>
                                                <div class="shift-card-day-pill">
                                                    C$ @costoDia.ToString("N2") / pers. / turno
                                                </div>
                                            </div>
                                            <!-- Sección 2: Costo Mensual Total y Transporte / Viáticos -->
                                            <div class="shift-card-sec-bottom">
                                                <div class="shift-card-metric">
                                                    <span class="shift-metric-lbl">CMT Mensual / Pers.</span>
                                                    <strong class="shift-metric-val">C$ @q.CostoTotal.ToString("N2")</strong>
                                                </div>
                                                <div class="shift-card-metric">
                                                    <span class="shift-metric-lbl">Viáticos / Transp.</span>
                                                    <strong class="shift-metric-val @(viat > 0 ? "viat-accent" : "")">C$ @viat.ToString("N2")/mes</strong>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <MudGrid Spacing="2" Class="mt-1">
                                <MudItem XS="6" SM="4">
                                    <MudNumericField T="int" Value="cantidadTrabajadores" ValueChanged="OnCantidadTrabajadoresChanged" Label="Personas" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="200" Adornment="Adornment.End" AdornmentText="pers." />
                                </MudItem>
                                <MudItem XS="6" SM="4">
                                    <MudNumericField T="decimal" Value="diasOperativosMes" ValueChanged="OnDiasOperativosMesChanged" Label="Turnos / Mes" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1m" Max="31m" Format="N0" />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    @if (selectedPersonnelQuoteId == null)
                                    {
                                        <MudTextField @bind-Value="manualTurno" Label="Turno Manual" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    }
                                    else
                                    {
                                        <MudNumericField T="decimal" Value="CalculatedCostoTurnoCuadrilla" Label="Cuadrilla / Turno" Variant="Variant.Filled" Margin="Margin.Dense" Format="N2" ReadOnly="true" Adornment="Adornment.Start" AdornmentText="C$" />
                                    }
                                </MudItem>
                            </MudGrid>

                            <MudGrid Spacing="2" Class="mt-1">
                                <MudItem XS="6">
                                    <MudNumericField T="decimal" Value="mermaPorcentaje" ValueChanged="OnMermaChanged" Label="Merma Operativa (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" Min="0m" Max="50m" Adornment="Adornment.End" AdornmentText="%" />
                                </MudItem>
                                <MudItem XS="6">
                                    <MudNumericField T="decimal" Value="utilidadPorcentaje" ValueChanged="OnUtilidadChanged" Label="Utilidad Comercial (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" Min="0m" Max="95m" Adornment="Adornment.End" AdornmentText="%" />
                                </MudItem>
                            </MudGrid>

                            @if (selectedPersonnelQuoteId == null)
                            {
                                <MudGrid Spacing="2" Class="mt-1">
                                    <MudItem XS="12">
                                        <MudNumericField T="decimal" Value="manoObraUnitaria" ValueChanged="OnManoObraManualChanged" Label="Mano de Obra Unitaria Manual (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" Adornment="Adornment.Start" AdornmentText="C$" HelperText="Seleccione arriba un Costeo de Personal para cálculo automático por turno." />
                                    </MudItem>
                                </MudGrid>
                            }
                            else if (selectedPersonnelQuote != null)
                            {
                                var pd = selectedPersonnelQuote.PersonalDetalle;
                                decimal salLey = (pd?.SalarioBase ?? 0m) * (1m + (pd?.PrestacionesFactor ?? 0.545m));
                                decimal viatMes = pd?.ViaticosTotales ?? 0m;
                                decimal eppSup = (pd?.EppTotales ?? 0m) + (pd?.Supervision ?? 0m) + (pd?.Cargos ?? 0m) + (pd?.Seguros ?? 0m) + (pd?.GastosOperativos ?? 0m);
                                <div class="crew-kpi-strip mt-3">
                                    <div class="crew-kpi-box">
                                        <div style="font-size: 0.68rem; color: #607d8b; text-transform: uppercase;">Salario + Ley</div>
                                        <div style="font-weight: 800; font-size: 0.88rem;">C$ @salLey.ToString("N2")</div>
                                    </div>
                                    <div class="crew-kpi-box @(viatMes > 0 ? "viaticos-highlight" : "")">
                                        <div style="font-size: 0.68rem; color: #607d8b; text-transform: uppercase;">Transporte / Viáticos</div>
                                        <div style="font-weight: 800; font-size: 0.88rem; color: @(viatMes > 0 ? "#e65100" : "inherit");">C$ @viatMes.ToString("N2")</div>
                                    </div>
                                    <div class="crew-kpi-box">
                                        <div style="font-size: 0.68rem; color: #607d8b; text-transform: uppercase;">EPP + Supervisión</div>
                                        <div style="font-weight: 800; font-size: 0.88rem;">C$ @eppSup.ToString("N2")</div>
                                    </div>
                                    <div class="crew-kpi-box total-highlight">
                                        <div style="font-size: 0.68rem; color: #0d47a1; text-transform: uppercase;">Cuadrilla (@cantidadTrabajadores pers./mes)</div>
                                        <div style="font-weight: 800; font-size: 0.88rem; color: #0d47a1;">C$ @CalculatedCostoMensualCuadrilla.ToString("N2")</div>
                                    </div>
                                </div>
                            }
                        </MudCard>
                    </MudItem>

                    <!-- =============================================================== -->
                    <!-- PANEL DERECHO UNIFICADO: SKU + MAQUINARIA EFECTIVA + COSTO      -->
                    <!-- =============================================================== -->
                    <MudItem XS="12" lg="7">
                        <MudCard Elevation="3" Class="@($"pa-4 prod-step-card {(editingSkuItem != null ? "sku-editing-card" : "")}")">
                            <div class="prod-step-header">
                                <div class="d-flex align-center gap-3">
                                    <span class="prod-step-badge" style="@(editingSkuItem != null ? "background: linear-gradient(135deg, #ef6c00, #fb8c00);" : "")">2</span>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-bold" Style="line-height: 1.2;">
                                            @(editingSkuItem != null ? "Editando SKU y su Maquinaria Efectiva" : "Configuración de SKU y Maquinaria Efectiva")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            Configure el SKU, asigne los equipos efectivos que utiliza (costo prorrateado del catálogo) y agréguelo a la cotización.
                                        </MudText>
                                    </div>
                                </div>
                                @if (editingSkuItem != null)
                                {
                                    <div class="d-flex align-center gap-2">
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Editando SKU</MudChip>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelSkuEdit">
                                            Cancelar
                                        </MudButton>
                                    </div>
                                }
                            </div>

                            <!-- Datos del SKU -->
                            <MudGrid Spacing="2" Class="mb-3">
                                <MudItem XS="12">
                                    <MudTextField @bind-Value="skuNombre" Label="Código y Descripción del SKU / Proceso de Maquila" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Placeholder="ej. SAJECM0001 - AJE CIELO AGUA PET NR 250 ML 24 MODERNO" />
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    <MudNumericField T="int" Value="produccionDiaria" ValueChanged="OnProduccionDiariaChanged" Label="Unidades por Turno" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Adornment="Adornment.End" AdornmentText="uds" />
                                </MudItem>
                                <MudItem XS="6" SM="4">
                                    <MudNumericField T="decimal" Value="CalculatedUnidadesPorHora" ValueChanged="OnUnidadesPorHoraChanged" Label="Equiv. Uds / Hora" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Format="N1" Adornment="Adornment.End" AdornmentText="uds/h" />
                                </MudItem>
                                <MudItem XS="6" SM="4">
                                    <MudNumericField T="decimal" @bind-Value="turnosAsignadosMes" Label="Turnos Asignados / Mes" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Max="60m" Format="N1" />
                                </MudItem>
                            </MudGrid>

                            <!-- Maquinaria Efectiva del SKU (SOLO Nombre y Costo Prorrateado del Catálogo) -->
                            <div class="sku-machinery-section mb-3">
                                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="Size.Small" Color="Color.Success" />
                                        <MudText Typo="Typo.subtitle2" Class="font-bold">Maquinaria Efectiva del SKU</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@selectedMachinery.Count equipo@(selectedMachinery.Count == 1 ? "" : "s")</MudChip>
                                    </div>
                                    <div class="d-flex align-center gap-1 flex-wrap">
                                        @if (selectedMachinery.Count < machineryList.Count && machineryList.Any())
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Success" Size="Size.Small" OnClick="SelectAllMachineryForSku">
                                                + Todos
                                            </MudButton>
                                        }
                                        @if (machineryList.Any(x => string.Equals(x.TipoConcepto, "Mantenimiento", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" OnClick="SelectOnlyMaintenanceForSku" Title="Asignar únicamente mantenimiento y reserva de repuestos (escenario sin maquinaria propia)">
                                                🔧 Solo Mantto. Horno
                                            </MudButton>
                                        }
                                        @if (selectedMachinery.Any())
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearSelectedMachinery">
                                                Sin Equipos
                                            </MudButton>
                                        }
                                    </div>
                                </div>

                                <MudSelect T="int?" Value="selectedMachineryToAdd" ValueChanged="AddMachineryRow" Label="Seleccionar y Agregar Maquinaria / Mantenimiento del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Placeholder="Elija maquinaria o mantenimiento del catálogo global">
                                    @foreach (var maq in machineryList.Where(x => !selectedMachinery.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)maq.Id)">@(string.Equals(maq.TipoConcepto, "Mantenimiento", StringComparison.OrdinalIgnoreCase) ? "🔧 " : "⚙️ ")@maq.Nombre — C$ @maq.ProyeccionMensual.ToString("N2")</MudSelectItem>
                                    }
                                </MudSelect>

                                @if (selectedMachinery.Any())
                                {
                                    <MudSimpleTable Style="overflow-x: auto; border-radius: 8px;" Elevation="0" Dense="true" Hover="true" Bordered="true">
                                        <thead>
                                            <tr style="background-color: #eef5f0;">
                                                <th>Nombre</th>
                                                <th style="width: 165px; text-align: right;">Costo Prorrateado</th>
                                                <th style="width: 48px; text-align: center;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var id in selectedMachinery)
                                            {
                                                var maq = machineryList.FirstOrDefault(x => x.Id == id);
                                                if (maq != null)
                                                {
                                                    <tr>
                                                        <td style="vertical-align: middle; font-weight: 600;">@maq.Nombre</td>
                                                        <td style="text-align: right; vertical-align: middle; font-weight: 700; color: #1b5e20;">C$ @maq.ProyeccionMensual.ToString("N2")</td>
                                                        <td style="text-align: center; vertical-align: middle;">
                                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMachineryRow(id))" />
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                    <div class="d-flex justify-space-between flex-wrap gap-2 px-3 py-1 mt-1" style="background: #f1f8e9; border-radius: 6px; font-size: 0.80rem; color: #1b5e20;">
                                        <span>Total Prorrateado / Mes: <strong>C$ @CalculatedAmortizacionMensual.ToString("N2")</strong></span>
                                        <span>Por Turno: <strong>C$ @CalculatedCostoTurnoMaquinaria.ToString("N2")</strong></span>
                                        <span>Por Unidad: <strong>C$ @CalculatedAmortizacionUnitaria.ToString("N4")</strong></span>
                                    </div>
                                }
                                else
                                {
                                    <div class="px-3 py-2 text-caption text-muted" style="background: #f8faf9; border: 1px dashed #cfd8dc; border-radius: 8px;">
                                        Sin maquinaria asignada a este SKU (Costo equipos: C$ 0.00/unidad).
                                    </div>
                                }
                            </div>

                            <!-- Materiales e Insumos por Unidad (Compacto / Opcional) -->
                            <div class="mb-3">
                                <MudSelect T="int?" Value="selectedMaterialToAdd" ValueChanged="AddMaterialRow" Label="Insumos / Materiales por Unidad (Opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Sin insumos adicionales (cliente suministra materiales)">
                                    @foreach (var mat in materialesList.Where(x => !selectedMateriales.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)mat.Id)">@mat.Nombre (C$ @mat.CostoUnitario.ToString("N4"))</MudSelectItem>
                                    }
                                </MudSelect>

                                @if (selectedMateriales.Any())
                                {
                                    <MudSimpleTable Style="overflow-x: auto;" Class="mt-2" Elevation="0" Dense="true" Hover="true" Bordered="true">
                                        <thead>
                                            <tr style="background-color: #f4f7f5;">
                                                <th>Insumo / Material</th>
                                                <th style="width: 105px; text-align: right;">Cant. / Ud</th>
                                                <th style="width: 125px; text-align: right;">Costo Unit.</th>
                                                <th style="width: 110px; text-align: right;">Subtotal</th>
                                                <th style="width: 44px; text-align: center;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var id in selectedMateriales)
                                            {
                                                var mat = materialesList.FirstOrDefault(x => x.Id == id);
                                                if (mat != null)
                                                {
                                                    decimal q = GetMaterialQuantity(id);
                                                    decimal c = GetMaterialCost(id);
                                                    <tr>
                                                        <td style="vertical-align: middle;">@mat.Nombre</td>
                                                        <td style="vertical-align: middle;">
                                                            <MudNumericField T="decimal" Value="@q" ValueChanged="@((decimal val) => SetMaterialQuantity(id, val))" Format="N4" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.0001m" />
                                                        </td>
                                                        <td style="vertical-align: middle;">
                                                            <MudNumericField T="decimal" Value="@c" ValueChanged="@((decimal val) => SetMaterialCost(id, val))" Format="N4" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" />
                                                        </td>
                                                        <td style="text-align: right; vertical-align: middle; font-weight: 700;">C$ @((q * c).ToString("N4"))</td>
                                                        <td style="text-align: center; vertical-align: middle;">
                                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMaterialRow(id))" />
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            </div>

                            <!-- Barra Ejecutiva de Costo Calculado y Botón Agregar / Actualizar SKU -->
                            <div class="sku-summary-action-bar">
                                <div class="sku-cost-pills mb-3">
                                    <div class="sku-cost-pill">
                                        <span>M.O. Unitaria</span>
                                        <strong>C$ @CalculatedManoObraUnitaria.ToString("N4")</strong>
                                    </div>
                                    <div class="sku-cost-pill">
                                        <span>Maquinaria Unit.</span>
                                        <strong>C$ @CalculatedAmortizacionUnitaria.ToString("N4")</strong>
                                    </div>
                                    @if (CalculatedMateriales > 0m)
                                    {
                                        <div class="sku-cost-pill">
                                            <span>Materiales Unit.</span>
                                            <strong>C$ @CalculatedMateriales.ToString("N4")</strong>
                                        </div>
                                    }
                                    <div class="sku-cost-pill">
                                        <span>Costo Op. (+@mermaPorcentaje.ToString("N1")% Merma)</span>
                                        <strong style="color: #a5d6a7;">C$ @CalculatedCostoOperativoUnitario.ToString("N4")</strong>
                                    </div>
                                    <div class="sku-cost-pill">
                                        <span>Equilibrio / Turno</span>
                                        <strong style="color: #69f0ae;">@CalculatedUnidadesBreakeven.ToString("N0") uds</strong>
                                    </div>
                                </div>

                                <MudGrid Spacing="2" AlignItems="AlignItems.End">
                                    <MudItem XS="12" SM="5">
                                        <div class="agreed-price-box">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <span class="agreed-price-label">COSTO ACORDADO (C$ / UD)</span>
                                                @if (isTarifaManualOverride)
                                                {
                                                    <span class="agreed-reset-link" @onclick="ResetTarifaToSuggested" title="Restaurar al costo calculado automático">
                                                        ↻ Auto
                                                    </span>
                                                }
                                            </div>
                                            <div class="agreed-price-input-shell">
                                                <span class="agreed-currency-tag">C$</span>
                                                <MudNumericField T="decimal"
                                                                 Value="tarifaAcordada"
                                                                 ValueChanged="OnTarifaAcordadaManualChanged"
                                                                 Format="N2"
                                                                 HideSpinButtons="true"
                                                                 Variant="Variant.Text"
                                                                 DisableUnderLine="true"
                                                                 Margin="Margin.Dense"
                                                                 Class="agreed-mud-field" />
                                            </div>
                                        </div>
                                    </MudItem>
                                    <MudItem XS="12" SM="7">
                                        <div class="d-flex gap-2">
                                            <MudButton Variant="Variant.Filled"
                                                       StartIcon="@(editingSkuItem != null ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.AddShoppingCart)"
                                                       FullWidth="true"
                                                       OnClick="SaveOrAddSkuToQuote"
                                                       Size="Size.Large"
                                                       Class="font-bold py-3"
                                                       Style="@(editingSkuItem != null ? "border-radius: 10px; background-color: #FFB300; color: #1f1300; font-size: 0.86rem;" : "border-radius: 10px; background-color: #00E676; color: #042f1a; font-size: 0.86rem;")">
                                                @(editingSkuItem != null ? "Actualizar SKU en Cotización" : "Agregar SKU a la Cotización")
                                            </MudButton>
                                            @if (editingSkuItem != null)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="CancelSkuEdit" Style="border-radius: 10px; border-color: rgba(255,255,255,0.55); color: white; font-size: 0.80rem;">
                                                    Cancelar
                                                </MudButton>
                                            }
                                        </div>
                                    </MudItem>
                                </MudGrid>
                            </div>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <!-- ========================================================= -->
                <!-- GRILLA INFERIOR: PORTAFOLIO DE SKUs EN LA COTIZACIÓN      -->
                <!-- ========================================================= -->
                @if (currentItems.Any())
                {
                    <div class="mt-5">
                        <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudText Typo="Typo.h6" Class="font-bold" Style="color: #0D47A1;">
                                    📦 Portafolio de SKUs en la Cotización Actual (@currentItems.Count)
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(IsNightShift(CurrentTurnoNombre) ? Color.Info : Color.Success)" Variant="Variant.Outlined">
                                    @(IsNightShift(CurrentTurnoNombre) ? "🌙 " : "☀️ ") Turno @CurrentTurnoNombre • @cantidadTrabajadores personas
                                </MudChip>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Autorenew" OnClick="@(() => RecalculatePortfolioItems(true))">
                                Recalcular Costos con Catálogo / Personal Actual
                            </MudButton>
                        </div>

                        <MudGrid Spacing="3">
                            <MudItem XS="12" lg="9">
                                <MudTable Items="currentItems" Hover="true" Elevation="3" Dense="true" Class="portfolio-sku-table" Style="border-radius: 12px; border-top: 4px solid #1976D2;">
                                    <HeaderContent>
                                        <MudTh>Producto / SKU</MudTh>
                                        <MudTh Style="text-align: right; width: 90px;">Uds/Turno</MudTh>
                                        <MudTh Style="text-align: right; width: 82px;">Turnos/Mes</MudTh>
                                        <MudTh Style="text-align: right; width: 98px;">Costo Op.</MudTh>
                                        <MudTh Style="text-align: right; width: 148px;">Costo Acordado</MudTh>
                                        <MudTh Style="text-align: right; width: 122px;">Fact. Mensual</MudTh>
                                        <MudTh Style="width: 82px; text-align: center;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        @{
                                            decimal costoOp = GetItemCostoOperativoUnit(context);
                                            decimal turnosM = GetItemTurnosMes(context);
                                            int eqCount = GetSkuMachineryCount(context.SkuNombre);
                                            bool isBeingEdited = ReferenceEquals(editingSkuItem, context);
                                            string rowBg = isBeingEdited ? "background-color: #fff8e1;" : "";
                                        }
                                        <MudTd DataLabel="SKU" Style="@rowBg">
                                            <div class="sku-cell-title">@context.SkuNombre</div>
                                            <MudTooltip Text="@GetSkuMachinerySummary(context.SkuNombre)">
                                                <span class="sku-cell-sub">
                                                    ⚙️ @(eqCount > 0 ? $"{eqCount} equipo{(eqCount == 1 ? "" : "s")} efectivo{(eqCount == 1 ? "" : "s")}" : "Sin maquinaria propia")
                                                    @if (isBeingEdited)
                                                    {
                                                        <strong style="color: #ef6c00; margin-left: 4px;">(Editando...)</strong>
                                                    }
                                                </span>
                                            </MudTooltip>
                                        </MudTd>
                                        <MudTd DataLabel="Uds/Turno" Style="@($"text-align: right; white-space: nowrap; {rowBg}")">
                                            <span class="sku-cell-num">@context.ProduccionDiaria.ToString("N0")</span>
                                        </MudTd>
                                        <MudTd DataLabel="Turnos/Mes" Style="@($"text-align: right; white-space: nowrap; {rowBg}")">
                                            <span class="sku-cell-num">@turnosM.ToString("N1")</span>
                                        </MudTd>
                                        <MudTd DataLabel="Costo Op." Style="@($"text-align: right; white-space: nowrap; {rowBg}")">
                                            <span class="sku-cell-num">C$ @costoOp.ToString("N2")</span>
                                        </MudTd>
                                        <MudTd DataLabel="Costo Acordado" Style="@($"text-align: right; {rowBg}")">
                                            <div class="inline-cost-editor">
                                                <span class="inline-cost-prefix">C$</span>
                                                <MudNumericField T="decimal"
                                                                 Value="@context.TarifaAcordada"
                                                                 ValueChanged="@((decimal val) => OnInlinePortfolioTarifaChanged(context, val))"
                                                                 Format="N2"
                                                                 HideSpinButtons="true"
                                                                 Variant="Variant.Text"
                                                                 DisableUnderLine="true"
                                                                 Margin="Margin.Dense"
                                                                 Class="inline-cost-mud" />
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="Fact. Mensual" Style="@($"text-align: right; white-space: nowrap; font-weight: 700; color: #1b5e20; {rowBg}")">
                                            <span class="sku-cell-num">C$ @((context.TarifaAcordada * context.ProduccionDiaria * turnosM).ToString("N2"))</span>
                                        </MudTd>
                                        <MudTd DataLabel="Acciones" Style="@($"text-align: center; white-space: nowrap; {rowBg}")">
                                            <MudTooltip Text="Editar SKU y su maquinaria en el panel derecho">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditProductInQuote(context))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Quitar SKU">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveProductFromQuote(context))" />
                                            </MudTooltip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>

                            <MudItem XS="12" lg="3">
                                <MudCard Elevation="4" Class="pa-4 text-white" Style="background: linear-gradient(145deg, #0D47A1, #1565C0); border-radius: 14px;">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-3">Consolidado del Portafolio</MudText>
                                    <div class="d-flex justify-space-between mb-2 text-body2" style="gap: 8px;">
                                        <span style="opacity: 0.8;">Cliente:</span>
                                        <strong style="text-align: right;">@(string.IsNullOrWhiteSpace(cliente) ? "Sin definir" : cliente)</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">SKUs / Turnos Mes:</span>
                                        <strong>@currentItems.Count SKUs (@ConsolidatedTurnosTotalesMes.ToString("N1") turnos)</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">Unidades / Mes:</span>
                                        <strong>@ConsolidatedUnidadesMensuales.ToString("N0") uds</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">Costo Op. Mensual:</span>
                                        <strong>C$ @ConsolidatedCostoMensual.ToString("N2")</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2 text-body2">
                                        <span style="opacity: 0.8;">Facturación Mensual:</span>
                                        <strong style="color: #69f0ae;">C$ @ConsolidatedFacturacionMensual.ToString("N2")</strong>
                                    </div>
                                    <div class="d-flex justify-space-between mb-4 pb-2 border-b text-body2" style="border-color: rgba(255,255,255,0.2) !important;">
                                        <span style="opacity: 0.8;">Utilidad Bruta:</span>
                                        <strong style="color: #00E676;">C$ @ConsolidatedUtilidadMensual.ToString("N2") (@ConsolidatedMargenPorcentaje.ToString("N1")%)</strong>
                                    </div>

                                    <MudButton Variant="Variant.Filled" FullWidth="true" OnClick="SaveQuote" StartIcon="@Icons.Material.Filled.Save" Size="Size.Large" Class="font-bold py-3" Style="border-radius: 10px; background-color: #00E676; color: #042f1a;">
                                        @(editingQuoteId.HasValue ? "Actualizar Cotización" : "Guardar Cotización")
                                    </MudButton>
                                    @if (editingQuoteId.HasValue)
                                    {
                                        <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="SaveQuoteAsNew" StartIcon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="mt-2" Style="border-radius: 8px; color: white; border-color: rgba(255,255,255,0.45);">
                                            Guardar como Nueva Cotización
                                        </MudButton>
                                    }
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </div>
                }
            </div>
        </MudTabPanel>

        <!-- ========================================================= -->
        <!-- PESTAÑA 2: HISTORIAL DE COTIZACIONES DE PRODUCCIÓN        -->
        <!-- ========================================================= -->
        <MudTabPanel Text="Historial de Cotizaciones">
            <div class="pa-4 pa-md-6">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-4">
                    <MudText Typo="Typo.h5" Class="font-bold" Color="Color.Success">Historial de Cotizaciones de Producción y Maquila</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">Expanda cualquier cotización para ajustar el costo acordado o seleccionar SKUs específicos para PDF.</MudText>
                </div>

                <MudTable Items="savedQuotes" Hover="true" Elevation="2" Class="mb-6" Style="border-radius: 12px;">
                    <HeaderContent>
                        <MudTh Style="width: 48px;"></MudTh>
                        <MudTh>Cotización No.</MudTh>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Cliente / Proyecto</MudTh>
                        <MudTh>Turno / Cuadrilla</MudTh>
                        <MudTh>SKUs</MudTh>
                        <MudTh Style="text-align: right;">Costo Op. Mensual</MudTh>
                        <MudTh Style="text-align: right;">Facturación Mensual</MudTh>
                        <MudTh Style="width: 170px; text-align: center;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var details = GetQuoteDetailsList(context);
                            var distinctTurnos = details.Select(d => d.Turno ?? "Diurno").Distinct().ToList();
                            int maxPers = details.Any() ? details.Max(d => d.CantidadTrabajadores) : 1;
                            decimal factMes = details.Any()
                                ? details.Sum(d => d.TarifaAcordada * d.ProduccionDiaria * GetItemTurnosMes(d))
                                : context.TarifaAcordada;
                            decimal costoMes = details.Any()
                                ? details.Sum(d => GetItemCostoOperativoUnit(d) * d.ProduccionDiaria * GetItemTurnosMes(d))
                                : context.CostoTotal;
                        }
                        <MudTd>
                            <MudIconButton Icon="@(expandedQuotes.Contains(context) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                           OnClick="@(() => ToggleRow(context))" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Cotización No." Class="font-bold" Style="color: #1b5e20;">@(context.NumeroCotizacion ?? "N/A")</MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaCreacion.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Cliente" Style="font-weight: 600;">@context.ClienteNombre</MudTd>
                        <MudTd DataLabel="Turnos">
                            @foreach (var t in distinctTurnos)
                            {
                                bool night = IsNightShift(t);
                                <MudChip T="string" Size="Size.Small" Color="@(night ? Color.Info : Color.Success)" Variant="Variant.Outlined" Class="mr-1">
                                    @(night ? "🌙 " : "☀️ ") @t (@maxPers pers.)
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="SKUs">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@details.Count SKUs</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Costo Op. Mensual" Style="text-align: right;">C$ @costoMes.ToString("N2")</MudTd>
                        <MudTd DataLabel="Facturación Mensual" Style="text-align: right;" Class="font-bold text-success">C$ @factMes.ToString("N2")</MudTd>
                        <MudTd Style="text-align: center;">
                            <div class="d-flex justify-center gap-1">
                                <MudTooltip Text="Abrir y editar en el Cotizador">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" Size="Size.Small" OnClick="@(() => LoadQuoteToForm(context))" />
                                </MudTooltip>
                                <MudTooltip Text="@($"Imprimir Propuesta PDF ({GetSelectedSkusForPrint(context).Count} SKUs)")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Success" Size="Size.Small" OnClick="@(() => PrintConsolidatedCotizacion(context))" />
                                </MudTooltip>
                                <MudTooltip Text="@($"Imprimir Desglose de Costos ({GetSelectedSkusForPrint(context).Count} SKUs)")">
                                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Info" Size="Size.Small" OnClick="@(() => PrintConsolidatedCotizacionDesglose(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar Cotización">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteQuote(context.Id))" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (expandedQuotes.Contains(context))
                        {
                            <MudTr>
                                <td colspan="9" class="pa-4" style="background-color: #f8faf9;">
                                    <MudCard Elevation="1" Outlined="true" Class="pa-4" Style="border-radius: 10px; border-left: 5px solid #2E7D32;">
                                        <div class="d-flex justify-space-between align-center flex-wrap mb-3">
                                            <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Success">
                                                Detalle Tarifario por SKU — @context.ClienteNombre
                                            </MudText>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayForWork" OnClick="@(() => LoadQuoteToForm(context))">
                                                Cargar en Cotizador
                                            </MudButton>
                                        </div>
                                        <MudTable Items="GetQuoteDetailsList(context)" MultiSelection="true" T="CotizacionProduccionDetalle" SelectedItems="GetSelectedSkusForPrint(context)" SelectedItemsChanged="((val) => OnSelectedSkusChanged(context, val))" Context="detailContext" Hover="true" Dense="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>Producto / SKU</MudTh>
                                                <MudTh Style="text-align: right;">Uds / Turno</MudTh>
                                                <MudTh Style="text-align: right;">Turnos / Mes</MudTh>
                                                <MudTh Style="text-align: right;">M.O. Unit.</MudTh>
                                                <MudTh Style="text-align: right;">Maquinaria Unit.</MudTh>
                                                <MudTh Style="text-align: right;">Costo Op. (+Merma)</MudTh>
                                                <MudTh Style="text-align: right;">Costo Acordado (C$)</MudTh>
                                                <MudTh Style="text-align: right;">Facturación Mes</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                @{
                                                    decimal costoOpDet = GetItemCostoOperativoUnit(detailContext);
                                                    decimal tMesDet = GetItemTurnosMes(detailContext);
                                                }
                                                <MudTd DataLabel="SKU" Style="font-weight: 600;">@detailContext.SkuNombre</MudTd>
                                                <MudTd DataLabel="Uds/Turno" Style="text-align: right;">@detailContext.ProduccionDiaria.ToString("N0")</MudTd>
                                                <MudTd DataLabel="Turnos/Mes" Style="text-align: right;">@tMesDet.ToString("N1")</MudTd>
                                                <MudTd DataLabel="M.O. Unit." Style="text-align: right;">C$ @detailContext.ManoObraUnitaria.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Maquinaria Unit." Style="text-align: right;">C$ @detailContext.AmortizacionUnitaria.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Costo Op." Style="text-align: right;">C$ @costoOpDet.ToString("N2")</MudTd>
                                                <MudTd DataLabel="Costo Acordado" Style="text-align: right;">
                                                    <div class="inline-cost-editor">
                                                        <span class="inline-cost-prefix">C$</span>
                                                        <MudNumericField T="decimal"
                                                                         Value="@detailContext.TarifaAcordada"
                                                                         ValueChanged="@((decimal val) => UpdateTarifaAcordada(context, detailContext, val))"
                                                                         Format="N2"
                                                                         HideSpinButtons="true"
                                                                         Variant="Variant.Text"
                                                                         DisableUnderLine="true"
                                                                         Margin="Margin.Dense"
                                                                         Class="inline-cost-mud" />
                                                    </div>
                                                </MudTd>
                                                <MudTd DataLabel="Fact. Mes" Style="text-align: right; font-weight: 700; color: #1b5e20;">
                                                    C$ @((detailContext.TarifaAcordada * detailContext.ProduccionDiaria * tMesDet).ToString("N2"))
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </MudCard>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                    <NoRecordsContent>
                        <div class="pa-6 text-center text-muted">No hay cotizaciones de producción registradas.</div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <!-- ========================================================= -->
        <!-- PESTAÑA 3: CATÁLOGOS GLOBALES                             -->
        <!-- ========================================================= -->
        <MudTabPanel Text="Gestión de Catálogos">
            <div class="pa-6">
                <MudText Typo="Typo.h5" Class="mb-6 font-bold" Color="Color.Success">Gestión de Catálogos Globales (Materiales, Maquinaria, EPP y Viáticos)</MudText>

                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Secondary">
                    <MudTabPanel Text="Materiales e Insumos">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="materialesList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Costo Unitario</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.CostoUnitario.ToString("N4")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditMaterial(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMaterial(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMaterial.Id > 0 ? "Editar Material" : "Agregar Material")</MudText>
                                    <MudTextField @bind-Value="editingMaterial.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingMaterial.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N4" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveMaterial">Guardar</MudButton>
                                        @if (editingMaterial.Id > 0 || !string.IsNullOrEmpty(editingMaterial.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditMaterial">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Maquinaria y Equipos">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="machineryList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Tipo</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Precio Base</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>% Repuestos</MudTh>
                                        <MudTh>Meses</MudTh>
                                        <MudTh>Divisor Turnos</MudTh>
                                        <MudTh>Proyección Mes</MudTh>
                                        <MudTh Style="width:90px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>
                                            <MudChip T="string" Size="Size.Small" Color="@(string.Equals(context.TipoConcepto, "Mantenimiento", StringComparison.OrdinalIgnoreCase) ? Color.Warning : Color.Success)" Variant="Variant.Outlined">
                                                @(string.IsNullOrWhiteSpace(context.TipoConcepto) ? "Maquinaria" : context.TipoConcepto)
                                            </MudChip>
                                        </MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.Precio.ToString("N2")</MudTd>
                                        <MudTd>@context.Cantidad</MudTd>
                                        <MudTd>@(context.PorcentajeRepuestos > 0 ? $"+{context.PorcentajeRepuestos:N1}%" : "0%")</MudTd>
                                        <MudTd>@context.MesesProyeccion</MudTd>
                                        <MudTd>@context.Personas</MudTd>
                                        <MudTd Style="font-weight:700; color:#1b5e20;">C$ @context.ProyeccionMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditMachinery(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMachinery(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMachinery.Id > 0 ? "Editar Equipo / Mantenimiento" : "Agregar Equipo / Mantenimiento")</MudText>
                                    <MudSelect T="string" @bind-Value="editingMachinery.TipoConcepto" Label="Tipo de Escenario / Concepto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                                        <MudSelectItem T="string" Value="@("Maquinaria")">Maquinaria / Equipo (CAPEX)</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Mantenimiento")">Mantenimiento / Póliza / Horno</MudSelectItem>
                                    </MudSelect>
                                    <MudTextField @bind-Value="editingMachinery.Nombre" Label="Nombre del Equipo o Mantenimiento" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingMachinery.Precio" Label="Precio o Costo Base (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N2" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Min="1" />
                                    <MudNumericField T="decimal" @bind-Value="editingMachinery.PorcentajeRepuestos" Label="% Reserva por Daños / Repuestos" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N2" Min="0m" Max="200m" Adornment="Adornment.End" AdornmentText="%" HelperText="Presupuesto adicional sobre el costo base para compra de repuestos o daños" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.MesesProyeccion" Label="Meses Proyección / Prorrateo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Min="1" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.Personas" Label="Turnos / Divisor de Prorrateo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Min="1" HelperText="Nº de turnos que comparten el equipo/mantenimiento (ej. 1 o 2 turnos)" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveMachinery">Guardar</MudButton>
                                        @if (editingMachinery.Id > 0 || !string.IsNullOrEmpty(editingMachinery.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditMachinery">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Equipos de Protección (EPP)">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="eppList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>Meses Prorrateo</MudTh>
                                        <MudTh>Costo Unitario</MudTh>
                                        <MudTh>Costo Mensual (Prorrateado)</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>@context.Cantidad.ToString("N1")</MudTd>
                                        <MudTd>@context.MesesProrrateo.ToString("N0")</MudTd>
                                        <MudTd>C$ @context.CostoUnitario.ToString("N2")</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditEpp(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteEpp(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingEpp.Id > 0 ? "Editar EPP" : "Agregar EPP")</MudText>
                                    <MudTextField @bind-Value="editingEpp.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N1" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.MesesProrrateo" Label="Meses Prorrateo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N0" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveEpp">Guardar</MudButton>
                                        @if (editingEpp.Id > 0 || !string.IsNullOrEmpty(editingEpp.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditEpp">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Viáticos y Beneficios">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="viaticosList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Costo Mensual</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditViatico(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteViatico(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingViatico.Id > 0 ? "Editar Viático" : "Agregar Viático")</MudText>
                                    <MudTextField @bind-Value="editingViatico.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingViatico.CostoMensual" Label="Costo Mensual" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveViatico">Guardar</MudButton>
                                        @if (editingViatico.Id > 0 || !string.IsNullOrEmpty(editingViatico.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditViatico">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </MudTabPanel>
    </MudTabs>
</MudContainer>
