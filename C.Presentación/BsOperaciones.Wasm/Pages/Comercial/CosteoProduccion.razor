@page "/comercial/costeo-produccion"
@using Modelo.Comercial
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-6 font-bold" Style="background: linear-gradient(90deg, #2E7D32, #00C853); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Cotizador de Servicios de Producción (Cálculo por Unidad / SKU)
    </MudText>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Success" Class="mb-6">
        <!-- Pestaña 1: Cotizador -->
        <MudTabPanel Text="🧮 Cotizador de Producción" Icon="@Icons.Material.Filled.Calculate">
            <div class="pa-4">
                <!-- Sección de Carga de Productos desde Excel y Navegación -->
                <MudCard Elevation="4" Class="pa-4 mb-6" Style="border-radius: 12px; background-color: rgba(220,237,200,0.2); border-left: 6px solid #2E7D32;">
                    <MudGrid AlignItems="AlignItems.Center">
                        <MudItem XS="12" MD="6">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Success" Size="Size.Large" />
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="font-bold">Cargar Lote de Productos desde Excel</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">Importe una lista de productos en la primera columna de un Excel para cotizarlos en serie.</MudText>
                                </div>
                            </div>
                        </MudItem>
                        <MudItem XS="12" MD="6" Class="d-flex justify-end gap-3 align-center">
                            <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadExcelFile" Accept=".xlsx">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.AttachFile">
                                        Seleccionar Excel
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            @if (importedProducts.Any())
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearImportedProducts">
                                    Limpiar
                                </MudButton>
                            }
                        </MudItem>
                    </MudGrid>
                </MudCard>

                @if (importedProducts.Any())
                {
                    <MudCard Elevation="4" Class="pa-4 mb-6" Style="border-radius: 12px; border-left: 6px solid #FF9800; background-color: rgba(255,243,224,0.3);">
                        <MudGrid AlignItems="AlignItems.Center">
                            <MudItem XS="12" SM="6" MD="8">
                                <div class="d-flex align-center gap-3">
                                    <MudIcon Icon="@Icons.Material.Filled.NavigateNext" Color="Color.Warning" Size="Size.Large" />
                                    <div>
                                        <MudText Typo="Typo.h6" Class="font-bold" Color="Color.Warning">
                                            Producto @(currentProductIndex + 1) de @importedProducts.Count
                                        </MudText>
                                        <MudText Typo="Typo.body1" Class="font-bold">
                                            SKU Actual: @skuNombre
                                        </MudText>
                                    </div>
                                </div>
                            </MudItem>
                            <MudItem XS="12" SM="6" MD="4" Class="d-flex justify-end gap-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToPreviousProduct" Disabled="@(currentProductIndex <= 0)">
                                    Anterior
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="GoToNextProduct" Disabled="@(currentProductIndex >= importedProducts.Count - 1)">
                                    Siguiente
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                }

                <MudGrid>
                    <!-- Formulario de Entrada (Izquierda) -->
                    <MudItem XS="12" MD="7">
                        <MudCard Elevation="4" Class="pa-6 mb-6" Style="border-radius: 12px; border-top: 4px solid #2E7D32;">
                            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Success">Datos de Entrada de Producción</MudText>
                            
                            <MudTextField @bind-Value="cliente" Label="Nombre del Cliente / Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Required="true" />
                            <MudTextField @bind-Value="skuNombre" Label="Descripción del SKU / Producto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Required="true" Placeholder="ej. CSD Pepsi + Roja 3 Litros" />
                            
                            <MudGrid>
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="int" Value="produccionDiaria" ValueChanged="OnProduccionDiariaChanged" Label="Producción Diaria Estimada (Unidades)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Min="1" />
                                </MudItem>
                                <MudItem XS="12" SM="6">
                                    <MudNumericField T="decimal" @bind-Value="mermaPorcentaje" Label="Margen de Merma (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                </MudItem>
                            </MudGrid>

                            <!-- Referencia de Personal -->
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Referencia de Costo de Personal</MudText>
                            <MudGrid>
                                <MudItem XS="12" SM="4">
                                    <MudSelect T="string" Value="selectedFilterEmpresa" ValueChanged="OnEmpresaFilterChanged" Label="Filtrar por Empresa" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Placeholder="Seleccione Empresa" Clearable="true">
                                        @foreach (var emp in personnelQuotes.Select(x => x.ClienteNombre).Distinct().OrderBy(x => x))
                                        {
                                            <MudSelectItem T="string" Value="@emp">@emp</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    <MudSelect T="Guid?" Value="selectedPersonnelQuoteId" ValueChanged="OnPersonnelQuoteChanged" Label="Seleccionar Turno" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Disabled="@(string.IsNullOrEmpty(selectedFilterEmpresa))" Placeholder="Ingreso Manual (M.O.)" Clearable="true">
                                        @foreach (var q in personnelQuotes.Where(x => x.ClienteNombre == selectedFilterEmpresa))
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)q.Id)">@(q.PersonalDetalle?.Turno ?? "Sin Turno") (C$ @q.CostoTotal.ToString("N2"))</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem XS="12" SM="4">
                                    @if (selectedPersonnelQuoteId == null)
                                    {
                                        <MudNumericField T="decimal" @bind-Value="manoObraUnitaria" Label="Mano de Obra Unitaria (C$)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N4" />
                                    }
                                    else
                                    {
                                        <MudNumericField T="decimal" Value="CalculatedManoObraUnitaria" Label="M.O. Unitaria (Calculada)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N4" ReadOnly="true" Disabled="true" />
                                    }
                                </MudItem>
                            </MudGrid>

                            @if (selectedPersonnelQuote != null)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-6" Style="border-radius: 8px;">
                                    <strong>Personal vinculado:</strong> @selectedPersonnelQuote.ClienteNombre <br />
                                    Costo mensual total: <strong>C$ @selectedPersonnelQuote.CostoTotal.ToString("N2")</strong> | Costo diario: <strong>C$ @CalculatedCostoDiarioPersona.ToString("N2")</strong>
                                </MudAlert>
                            }

                            <!-- Selector de Materiales -->
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Materiales e Insumos Utilizados por Unidad</MudText>
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedMaterialToAdd" ValueChanged="AddMaterialRow" Label="Seleccionar y Agregar Material del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Placeholder="Seleccione un material para agregar">
                                    @foreach (var mat in materialesList.Where(x => !selectedMateriales.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)mat.Id)">@mat.Nombre (C$ @mat.CostoUnitario.ToString("N4"))</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedMateriales.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Class="mb-6" Elevation="1" Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Concepto</th>
                                            <th style="width: 130px; text-align: right;">Costo Catálogo</th>
                                            <th style="width: 120px; text-align: right;">Cantidad</th>
                                            <th style="width: 150px; text-align: right;">Costo Cotización</th>
                                            <th style="width: 60px; text-align: center;">Quitar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedMateriales)
                                        {
                                            var mat = materialesList.FirstOrDefault(x => x.Id == id);
                                            if (mat != null)
                                            {
                                                <tr>
                                                    <td style="vertical-align: middle;">@mat.Nombre</td>
                                                    <td style="text-align: right; vertical-align: middle;">C$ @mat.CostoUnitario.ToString("N4")</td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@(customMaterialesQuantities.TryGetValue(id, out var q) ? q : 1m)" ValueChanged="@((decimal val) => SetMaterialQuantity(id, val))" Format="N4" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.0001m" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <MudNumericField T="decimal" Value="@GetMaterialCost(id)" ValueChanged="@((decimal val) => SetMaterialCost(id, val))" Format="N4" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentText="C$" />
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMaterialRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-6">No se han seleccionado materiales para esta cotización.</MudAlert>
                            }

                            <!-- Selector de Maquinaria -->
                            <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">Equipos y Maquinaria a Prorratear</MudText>
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudSelect T="int?" Value="selectedMachineryToAdd" ValueChanged="AddMachineryRow" Label="Seleccionar y Agregar Equipo del Catálogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Placeholder="Seleccione un equipo para agregar">
                                    @foreach (var maq in machineryList.Where(x => !selectedMachinery.Contains(x.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)maq.Id)">@maq.Nombre (C$ @maq.ProyeccionMensual.ToString("N2")/mes)</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (selectedMachinery.Any())
                            {
                                <MudSimpleTable Style="overflow-x: auto;" Class="mb-4" Elevation="1" Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Equipo / Maquinaria</th>
                                            <th style="width: 120px; text-align: right;">Precio</th>
                                            <th style="width: 80px; text-align: right;">Cant.</th>
                                            <th style="width: 80px; text-align: right;">Personas</th>
                                            <th style="width: 150px; text-align: right;">Amortiz. Mensual</th>
                                            <th style="width: 60px; text-align: center;">Quitar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var id in selectedMachinery)
                                        {
                                            var maq = machineryList.FirstOrDefault(x => x.Id == id);
                                            if (maq != null)
                                            {
                                                <tr>
                                                    <td style="vertical-align: middle;">@maq.Nombre</td>
                                                    <td style="text-align: right; vertical-align: middle;">C$ @maq.Precio.ToString("N2")</td>
                                                    <td style="text-align: right; vertical-align: middle;">@maq.Cantidad</td>
                                                    <td style="text-align: right; vertical-align: middle;">@maq.Personas</td>
                                                    <td style="text-align: right; vertical-align: middle;">C$ @maq.ProyeccionMensual.ToString("N2")</td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMachineryRow(id))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">No se han seleccionado equipos a prorratear.</MudAlert>
                            }
                        </MudCard>
                    </MudItem>

                    <!-- Resultados e Indicadores (Derecha) -->
                    <MudItem XS="12" MD="5">
                        <MudCard Elevation="4" Class="pa-6 text-white mb-6" Style="background: linear-gradient(135deg, #1B5E20, #2E7D32); border-radius: 12px;">
                            <MudText Typo="Typo.h6" Class="mb-6">Resumen de Costos de Producción</MudText>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Mano de Obra Unitaria:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedManoObraUnitaria.ToString("N4")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Costo Materiales / Insumos:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedMateriales.ToString("N4")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                <MudText Typo="Typo.body1" Class="opacity-75">Amortización Maquinaria Unit.:</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold">C$ @CalculatedAmortizacionUnitaria.ToString("N4")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-4 border-b pb-2 font-bold" style="border-color: rgba(255,255,255,0.3) !important;">
                                <MudText Typo="Typo.body1">Costo Total Unitario Base:</MudText>
                                <MudText Typo="Typo.body1">C$ @CalculatedCostoUnitarioBase.ToString("N4")</MudText>
                            </div>

                            <div class="d-flex justify-space-between mb-6 opacity-75">
                                <MudText Typo="Typo.body2">Margen por Merma (@mermaPorcentaje%):</MudText>
                                <MudText Typo="Typo.body2">C$ @CalculatedMermaCosto.ToString("N4")</MudText>
                            </div>

                            <!-- Tarifa Sugerida por Unidad -->
                            <div class="text-center mb-6 pa-4" style="background: rgba(255, 255, 255, 0.12); border-radius: 8px; border-left: 5px solid #00E676;">
                                <MudText Typo="Typo.caption" Class="opacity-75 d-block">TARIFA UNITARIA SUGERIDA</MudText>
                                <MudText Typo="Typo.h4" Class="font-bold" Style="color: #00E676;">C$ @CalculatedTarifaUnitaria.ToString("N4")</MudText>
                            </div>

                            <!-- Tarifa Acordada (Entrada de usuario) -->
                            <div class="mb-6 font-bold" style="background: rgba(255, 255, 255, 0.1); padding: 8px; border-radius: 8px;">
                                <MudNumericField T="decimal" @bind-Value="tarifaAcordada" Label="Tarifa Acordada por Unidad (C$)" Format="N4" Variant="Variant.Outlined" Class="mud-theme-success" Style="color: white; font-weight: bold;" />
                            </div>

                            <!-- Proyecciones de Venta -->
                            <MudPaper Class="pa-4 mb-6 text-dark" Style="background: rgba(255, 255, 255, 0.95); border-radius: 8px; color: #1B5E20;">
                                <MudGrid>
                                    <MudItem XS="12" Class="text-center mb-2">
                                        <MudText Typo="Typo.caption" Class="opacity-75 d-block">VOLUMEN DIARIO ESTIMADO</MudText>
                                        <MudText Typo="Typo.subtitle1" Class="font-bold">@produccionDiaria.ToString("N0") Unidades</MudText>
                                    </MudItem>
                                    <MudItem XS="6" Class="text-center border-r" Style="border-color: rgba(0,0,0,0.1) !important;">
                                        <MudText Typo="Typo.caption" Class="opacity-75 d-block">FACTURACIÓN DIARIA</MudText>
                                        <MudText Typo="Typo.h6" Class="font-bold">C$ @CalculatedFacturacionDiaria.ToString("N2")</MudText>
                                    </MudItem>
                                    <MudItem XS="6" Class="text-center">
                                        <MudText Typo="Typo.caption" Class="opacity-75 d-block">FACTURACIÓN MENSUAL</MudText>
                                        <MudText Typo="Typo.h6" Class="font-bold" Style="color: #2E7D32;">C$ @CalculatedFacturacionMensual.ToString("N2")</MudText>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>

                            <!-- Dashboard de Punto de Equilibrio (Breakeven) -->
                            @if (selectedPersonnelQuote != null)
                            {
                                <MudPaper Class="pa-4 mb-6" Style="background: rgba(0, 0, 0, 0.2); border-radius: 8px; border: 1px dashed rgba(255,255,255,0.3);">
                                    <MudText Typo="Typo.subtitle2" Class="font-bold mb-2 text-center" Style="color: #00E676;">📊 ANÁLISIS DE PUNTO DE EQUILIBRIO</MudText>
                                    <div class="d-flex justify-space-between mb-2">
                                        <MudText Typo="Typo.body2" Class="opacity-75">Margen de Contribución Unitario:</MudText>
                                        <MudText Typo="Typo.body2" Class="font-bold">C$ @CalculatedUtilidadUnitariaAntesDeLabor.ToString("N4")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between mb-2">
                                        <MudText Typo="Typo.body2" Class="opacity-75">Costo Diario de la Persona:</MudText>
                                        <MudText Typo="Typo.body2" Class="font-bold">C$ @CalculatedCostoDiarioPersona.ToString("N2")</MudText>
                                    </div>
                                    <MudDivider Class="my-2" Style="background-color: rgba(255,255,255,0.2);" />
                                    <div class="text-center">
                                        <MudText Typo="Typo.caption" Class="opacity-75 d-block">PRODUCCIÓN MÍNIMA REQUERIDA AL DÍA</MudText>
                                        @if (CalculatedUtilidadUnitariaAntesDeLabor <= 0)
                                        {
                                            <MudText Typo="Typo.body2" Class="font-bold text-danger">Tarifa muy baja para cubrir costos variables</MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.h5" Class="font-bold" Style="color: #00E676;">@CalculatedUnidadesBreakeven.ToString("N0") Unidades/día</MudText>
                                            <MudText Typo="Typo.caption" Class="opacity-75">
                                                @(CalculatedUnidadesBreakeven <= (decimal)produccionDiaria ? "✅ Viable: La producción estimada cubre el costo." : "⚠️ Alerta: Requiere producir más de lo estimado para dar ganancia.")
                                            </MudText>
                                        }
                                    </div>
                                </MudPaper>
                            }

                            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" FullWidth="true" OnClick="AddProductToQuote" Size="Size.Large" Class="font-bold py-3 mb-3" Style="border-radius: 8px;">
                                Agregar Producto a Cotización
                            </MudButton>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                @if (currentItems.Any())
                {
                    <div class="mt-8">
                        <MudText Typo="Typo.h5" Class="mb-4 font-bold" Style="color: #1976D2;">📦 Productos en la Cotización Actual</MudText>
                        <MudGrid>
                            <!-- Tabla de productos agregados -->
                            <MudItem XS="12" MD="8">
                                <MudTable Items="currentItems" Hover="true" Elevation="4" Dense="true" Style="border-radius: 12px; border-top: 4px solid #1976D2;">
                                    <HeaderContent>
                                        <MudTh>Producto/SKU</MudTh>
                                        <MudTh Style="text-align: right;">Volumen</MudTh>
                                        <MudTh Style="text-align: right;">M.O. Unit.</MudTh>
                                        <MudTh Style="text-align: right;">Mat. Unit.</MudTh>
                                        <MudTh Style="text-align: right;">Amortiz. Unit.</MudTh>
                                        <MudTh Style="text-align: right;">Tarifa Sugerida</MudTh>
                                        <MudTh Style="text-align: right;">Tarifa Acordada</MudTh>
                                        <MudTh Style="text-align: right;">Fact. Mensual</MudTh>
                                        <MudTh Style="width: 100px; text-align: center;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Producto/SKU">@context.SkuNombre</MudTd>
                                        <MudTd DataLabel="Volumen" Style="text-align: right;">@context.ProduccionDiaria.ToString("N0") uds</MudTd>
                                        <MudTd DataLabel="M.O. Unit." Style="text-align: right;">C$ @context.ManoObraUnitaria.ToString("N4")</MudTd>
                                        <MudTd DataLabel="Mat. Unit." Style="text-align: right;">C$ @context.MaterialesTotales.ToString("N4")</MudTd>
                                        <MudTd DataLabel="Amortiz. Unit." Style="text-align: right;">C$ @context.AmortizacionUnitaria.ToString("N4")</MudTd>
                                        <MudTd DataLabel="Tarifa Sugerida" Style="text-align: right;" Class="font-bold">C$ @context.TarifaSugerida.ToString("N4")</MudTd>
                                        <MudTd DataLabel="Tarifa Acordada" Style="text-align: right;" Class="font-bold text-success">C$ @context.TarifaAcordada.ToString("N4")</MudTd>
                                        <MudTd DataLabel="Fact. Mensual" Style="text-align: right;">C$ @((context.TarifaAcordada * context.ProduccionDiaria * 30m).ToString("N2"))</MudTd>
                                        <MudTd DataLabel="Acciones" Style="text-align: center;">
                                            <MudTooltip Text="Editar producto">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditProductInQuote(context))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Remover producto">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveProductFromQuote(context))" />
                                            </MudTooltip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>

                            <!-- Resumen Consolidado -->
                            <MudItem XS="12" MD="4">
                                <MudCard Elevation="4" Class="pa-6 text-white" Style="background: linear-gradient(135deg, #0D47A1, #1976D2); border-radius: 12px; border-top: 4px solid #1976D2;">
                                    <MudText Typo="Typo.h6" Class="mb-4">Resumen Consolidado</MudText>
                                    <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                        <MudText Typo="Typo.body1" Class="opacity-75">Cliente/Proyecto:</MudText>
                                        <MudText Typo="Typo.body1" Class="font-bold">@cliente</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                        <MudText Typo="Typo.body1" Class="opacity-75">Total de Productos:</MudText>
                                        <MudText Typo="Typo.body1" Class="font-bold">@currentItems.Count</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between mb-3 border-b pb-2" style="border-color: rgba(255,255,255,0.15) !important;">
                                        <MudText Typo="Typo.body1" Class="opacity-75">Costo Mensual:</MudText>
                                        <MudText Typo="Typo.body1" Class="font-bold">C$ @ConsolidatedCostoMensual.ToString("N2")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between mb-4 border-b pb-2 font-bold" style="border-color: rgba(255,255,255,0.3) !important;">
                                        <MudText Typo="Typo.body1">Facturación Mensual Total:</MudText>
                                        <MudText Typo="Typo.body1">C$ @ConsolidatedFacturacionMensual.ToString("N2")</MudText>
                                    </div>
                                    
                                    <MudButton Variant="Variant.Filled" FullWidth="true" OnClick="SaveQuote" Size="Size.Large" Class="font-bold py-3 mt-4" Style="border-radius: 8px; background-color: #00E676; color: #003300;">
                                        Guardar Cotización Consolidada
                                    </MudButton>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </div>
                }
            </div>
        </MudTabPanel>

        <!-- Pestaña 2: Historial -->
        <MudTabPanel Text="📋 Historial de Cotizaciones" Icon="@Icons.Material.Filled.History">
            <div class="pa-6">
                <MudText Typo="Typo.h5" Class="mb-4 font-bold" Color="Color.Success">Historial de Cotizaciones de Producción</MudText>
                
                <MudTable Items="savedQuotes" Hover="true" Elevation="2" Class="mb-6" Style="border-radius: 8px;">
                    <HeaderContent>
                        <MudTh Style="width: 50px;"></MudTh>
                        <MudTh>Cotización No.</MudTh>
                        <MudTh>Año/Mes</MudTh>
                        <MudTh>Cliente</MudTh>
                        <MudTh>Cant. SKUs</MudTh>
                        <MudTh>Costo Total Mensual (CMT)</MudTh>
                        <MudTh>Tarifa Sugerida Total</MudTh>
                        <MudTh Style="width:120px; text-align: center;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudIconButton Icon="@(expandedQuotes.Contains(context) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                           OnClick="@(() => ToggleRow(context))" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Cotización No." Class="font-bold" Style="color: var(--mud-palette-success);">@(context.NumeroCotizacion ?? "N/A")</MudTd>
                        <MudTd DataLabel="Año/Mes" Class="font-bold">@context.FechaCreacion.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-NI"))</MudTd>
                        <MudTd DataLabel="Cliente">@context.ClienteNombre</MudTd>
                        <MudTd DataLabel="Cant. SKUs">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">@(context.ProduccionDetalles?.Count ?? (context.ProduccionDetalle != null ? 1 : 0)) SKUs</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Costo Total Mensual">C$ @context.CostoTotal.ToString("N2")</MudTd>
                        <MudTd DataLabel="Tarifa Sugerida Total" Class="font-bold text-success">C$ @context.TarifaSugerida.ToString("N2")</MudTd>
                        <MudTd Style="text-align: center;">
                            <div class="d-flex justify-center gap-1">
                                <MudTooltip Text="Re-Imprimir Cotización Consolidada">
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Success" Size="Size.Small" OnClick="@(() => PrintConsolidatedCotizacion(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Imprimir Desglose Detallado">
                                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Info" Size="Size.Small" OnClick="@(() => PrintConsolidatedCotizacionDesglose(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar Grupo Completo">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteQuote(context.Id))" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (expandedQuotes.Contains(context))
                        {
                            <MudTr>
                                <td colspan="8" class="pa-4" style="background-color: rgba(0,0,0,0.02);">
                                    <MudCard Elevation="2" Outlined="true" Class="pa-4" Style="border-radius: 8px; border-left: 5px solid #2E7D32;">
                                        <MudText Typo="Typo.subtitle2" Class="mb-3 font-bold" Color="Color.Success">
                                            Detalle de Productos / SKUs Cotizados: @context.ClienteNombre (@context.FechaCreacion.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-NI")))
                                        </MudText>
                                        <MudTable Items="@((context.ProduccionDetalles != null && context.ProduccionDetalles.Any()) ? context.ProduccionDetalles : new List<CotizacionProduccionDetalle> { context.ProduccionDetalle })" Context="detailContext" Hover="true" Dense="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>Producto / SKU</MudTh>
                                                <MudTh>Volumen Diario</MudTh>
                                                <MudTh>Mano Obra Unit.</MudTh>
                                                <MudTh>Materiales Unit.</MudTh>
                                                <MudTh>Amortiz. Unit.</MudTh>
                                                <MudTh>Tarifa Sugerida</MudTh>
                                                <MudTh>Tarifa Acordada</MudTh>
                                                <MudTh>Estado</MudTh>
                                                <MudTh style="width: 80px; text-align: center;">Acciones</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Producto / SKU">@detailContext.SkuNombre</MudTd>
                                                <MudTd DataLabel="Volumen Diario">@detailContext.ProduccionDiaria.ToString("N0") uds</MudTd>
                                                <MudTd DataLabel="Mano Obra Unit.">C$ @detailContext.ManoObraUnitaria.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Materiales Unit.">C$ @detailContext.MaterialesTotales.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Amortiz. Unit.">C$ @detailContext.AmortizacionUnitaria.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Tarifa Sugerida">C$ @detailContext.TarifaSugerida.ToString("N4")</MudTd>
                                                <MudTd DataLabel="Tarifa Acordada">
                                                    <MudNumericField T="decimal" Value="@detailContext.TarifaAcordada" ValueChanged="@((decimal val) => UpdateTarifaAcordada(context, detailContext, val))" Format="N4" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 140px; background-color: white;" Adornment="Adornment.Start" AdornmentText="C$" />
                                                </MudTd>
                                                <MudTd DataLabel="Estado">
                                                    <MudChip T="string" Color="GetStatusColor(context.Estado)" Size="Size.Small">@context.Estado</MudChip>
                                                </MudTd>
                                                <MudTd Style="text-align: center;">
                                                    <div class="d-flex justify-center gap-1">
                                                        <MudTooltip Text="Cargar en el cotizador">
                                                            <MudIconButton Icon="@Icons.Material.Filled.PlayForWork" Color="Color.Success" Size="Size.Small" OnClick="@(() => LoadQuoteToForm(context))" />
                                                        </MudTooltip>
                                                        <MudTooltip Text="Eliminar esta cotización completa">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteQuote(context.Id))" />
                                                        </MudTooltip>
                                                    </div>
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </MudCard>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                    <NoRecordsContent>
                        <div class="pa-4 text-center text-muted">No hay cotizaciones de producción registradas.</div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <!-- Pestaña 3: Catálogos Globales -->
        <MudTabPanel Text="⚙️ Gestión de Catálogos" Icon="@Icons.Material.Filled.Settings">
            <div class="pa-6">
                <MudText Typo="Typo.h5" Class="mb-6 font-bold" Color="Color.Success">Gestión de Catálogos Globales (Materiales, Maquinaria, EPP y Viáticos)</MudText>
                
                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Secondary">
                    <MudTabPanel Text="Materiales e Insumos">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="materialesList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Costo Unitario</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.CostoUnitario.ToString("N4")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditMaterial(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMaterial(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMaterial.Id > 0 ? "Editar Material" : "Agregar Material")</MudText>
                                    <MudTextField @bind-Value="editingMaterial.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingMaterial.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N4" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveMaterial">Guardar</MudButton>
                                        @if (editingMaterial.Id > 0 || !string.IsNullOrEmpty(editingMaterial.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditMaterial">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Maquinaria y Equipos">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="machineryList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Precio</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>Meses Proyección</MudTh>
                                        <MudTh>Personas</MudTh>
                                        <MudTh>Proyección Mensual</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.Precio.ToString("N2")</MudTd>
                                        <MudTd>@context.Cantidad</MudTd>
                                        <MudTd>@context.MesesProyeccion</MudTd>
                                        <MudTd>@context.Personas</MudTd>
                                        <MudTd>C$ @context.ProyeccionMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditMachinery(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMachinery(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingMachinery.Id > 0 ? "Editar Equipo" : "Agregar Equipo")</MudText>
                                    <MudTextField @bind-Value="editingMachinery.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingMachinery.Precio" Label="Precio" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N2" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.MesesProyeccion" Label="Meses Proyección" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="int" @bind-Value="editingMachinery.Personas" Label="Personas (Nº Trabajadores)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Min="1" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveMachinery">Guardar</MudButton>
                                        @if (editingMachinery.Id > 0 || !string.IsNullOrEmpty(editingMachinery.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditMachinery">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Equipos de Protección (EPP)">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="eppList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Cant.</MudTh>
                                        <MudTh>Meses Prorrateo</MudTh>
                                        <MudTh>Costo Unitario</MudTh>
                                        <MudTh>Costo Mensual (Prorrateado)</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>@context.Cantidad.ToString("N1")</MudTd>
                                        <MudTd>@context.MesesProrrateo.ToString("N0")</MudTd>
                                        <MudTd>C$ @context.CostoUnitario.ToString("N2")</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditEpp(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteEpp(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingEpp.Id > 0 ? "Editar EPP" : "Agregar EPP")</MudText>
                                    <MudTextField @bind-Value="editingEpp.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N1" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.MesesProrrateo" Label="Meses Prorrateo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Format="N0" />
                                    <MudNumericField T="decimal" @bind-Value="editingEpp.CostoUnitario" Label="Costo Unitario" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveEpp">Guardar</MudButton>
                                        @if (editingEpp.Id > 0 || !string.IsNullOrEmpty(editingEpp.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditEpp">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    
                    <MudTabPanel Text="Viáticos y Beneficios">
                        <MudGrid>
                            <MudItem XS="12" MD="8">
                                <MudTable Items="viaticosList" Hover="true" Dense="true" Elevation="1">
                                    <HeaderContent>
                                        <MudTh>ID</MudTh>
                                        <MudTh>Nombre</MudTh>
                                        <MudTh>Costo Mensual</MudTh>
                                        <MudTh Style="width:100px;">Acciones</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.Nombre</MudTd>
                                        <MudTd>C$ @context.CostoMensual.ToString("N2")</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Success" OnClick="@(() => EditViatico(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteViatico(context.Id))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem XS="12" MD="4">
                                <MudCard Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-2">@(editingViatico.Id > 0 ? "Editar Viático" : "Agregar Viático")</MudText>
                                    <MudTextField @bind-Value="editingViatico.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                    <MudNumericField T="decimal" @bind-Value="editingViatico.CostoMensual" Label="Costo Mensual" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Format="N2" />
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveViatico">Guardar</MudButton>
                                        @if (editingViatico.Id > 0 || !string.IsNullOrEmpty(editingViatico.Nombre))
                                        {
                                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditViatico">Limpiar</MudButton>
                                        }
                                    </div>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

