</div>

@code {
    private int anioSeleccionado = 2026;
    private int mesSeleccionado = 8; // Agosto por defecto
    private List<int> aniosDisponibles = new List<int> { DateTime.Now.Year, DateTime.Now.Year - 1, DateTime.Now.Year - 2 };
    private int? filtroOperacionId = null;
    private bool isLoading = false;

    private List<Combos> operacionesList = new List<Combos>();
    private RentabilidadPrecisionConsolidadoDto consolidado = new RentabilidadPrecisionConsolidadoDto();

    // Filtros de tabla
    private string? filtroEstado = null;
    private string busquedaServicio = string.Empty;
    private string busquedaPrestamo = string.Empty;
    private bool isExportingPrestamos = false;

    private string busquedaColaborador = string.Empty;
    private string? filtroRolColaborador = null;
    private bool isExportingColaboradores = false;

    private void SetFiltroRolColaborador(string? rol)
    {
        filtroRolColaborador = rol;
    }

    private IEnumerable<ColaboradorActivoMesDto> ColaboradoresFiltrados
    {
        get
        {
            if (consolidado?.Colaboradores == null) return Enumerable.Empty<ColaboradorActivoMesDto>();

            var q = consolidado.Colaboradores.AsEnumerable();

            if (filtroRolColaborador == "SUPERVISION")
            {
                q = q.Where(c => c.es_supervisor);
            }
            else if (filtroRolColaborador == "CUADRILLA")
            {
                q = q.Where(c => !c.es_supervisor);
            }

            if (!string.IsNullOrWhiteSpace(busquedaColaborador))
            {
                var term = busquedaColaborador.Trim().ToLower();
                q = q.Where(c => (c.nombre_empleado?.ToLower().Contains(term) ?? false) ||
                                 (c.cargo?.ToLower().Contains(term) ?? false) ||
                                 (c.nomina_origen?.ToLower().Contains(term) ?? false));
            }

            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarCombosOperaciones();
        await CargarIndicadores();
    }

    private async Task CargarCombosOperaciones()
    {
        try
        {
            var res = await _OdooService.GetAllCombosHost("Operaciones");
            if (res.Model != null)
            {
                operacionesList = res.Model.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar operaciones: " + ex.Message, Severity.Warning);
        }
    }

    private async Task CargarIndicadores()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            int periodo = anioSeleccionado * 100 + mesSeleccionado;

            var res = await _OdooService.GetRentabilidadPrecision(periodo, filtroOperacionId, 0.20m);
            if (res.Model != null && res.Respuesta?.ExisteError != true)
            {
                consolidado = res.Model;
            }
            else
            {
                consolidado = new RentabilidadPrecisionConsolidadoDto();
                if (res.Respuesta != null && res.Respuesta.ExisteError)
                {
                    Snackbar.Add($"Error en el servidor: {res.Respuesta.MensajeError}", Severity.Error);
                }
                else
                {
                    Snackbar.Add("No se obtuvieron datos para el período.", Severity.Info);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar indicadores de precisión: " + ex.Message, Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetFiltroEstado(string? estado)
    {
        filtroEstado = estado;
    }

    private IEnumerable<RentabilidadServicioPrecisionDto> ServiciosFiltrados
    {
        get
        {
            if (consolidado?.Servicios == null) return Enumerable.Empty<RentabilidadServicioPrecisionDto>();

            var q = consolidado.Servicios.AsEnumerable();

            if (filtroEstado == "PERDIDA")
            {
                q = q.Where(s => !s.es_supervision && s.margen_porcentaje < 0);
            }
            else if (filtroEstado == "RENTABLE")
            {
                q = q.Where(s => !s.es_supervision && s.margen_porcentaje >= 0);
            }
            else if (filtroEstado == "SUPERVISION")
            {
                q = q.Where(s => s.es_supervision);
            }

            if (!string.IsNullOrWhiteSpace(busquedaServicio))
            {
                var term = busquedaServicio.Trim().ToLower();
                q = q.Where(s => (s.cliente_nombre?.ToLower().Contains(term) ?? false) ||
                                 (s.cargo?.ToLower().Contains(term) ?? false));
            }

            return q;
        }
    }

    private IEnumerable<ConciliacionPrestamoPersonalDto> PrestamosFiltrados
    {
        get
        {
            if (consolidado?.Prestamos == null) return Enumerable.Empty<ConciliacionPrestamoPersonalDto>();

            var q = consolidado.Prestamos.AsEnumerable();

            // Si hay un cliente seleccionado, asegurar que SOLO se muestren los cargados a la nómina de este cliente que trabajaron en otro cliente
            if (filtroOperacionId.HasValue && filtroOperacionId.Value > 0)
            {
                q = q.Where(p => p.op_nomina_id == filtroOperacionId.Value && p.op_trabajo_id != filtroOperacionId.Value);
            }

            if (!string.IsNullOrWhiteSpace(busquedaPrestamo))
            {
                var term = busquedaPrestamo.Trim().ToLower();
                q = q.Where(p => (p.nombre_empleado?.ToLower().Contains(term) ?? false) ||
                                 (p.op_nomina_nombre?.ToLower().Contains(term) ?? false) ||
                                 (p.op_trabajo_nombre?.ToLower().Contains(term) ?? false) ||
                                 (p.cargo?.ToLower().Contains(term) ?? false));
            }

            return q;
        }
    }

    private async Task ExportarPrestamosExcel()
    {
        var data = PrestamosFiltrados.ToList();
        if (!data.Any())
        {
            Snackbar.Add("No hay datos de préstamos para exportar.", Severity.Warning);
            return;
        }

        isExportingPrestamos = true;
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            string nombreCliente = filtroOperacionId.HasValue && filtroOperacionId.Value > 0
                ? (operacionesList.FirstOrDefault(o => o.id == filtroOperacionId.Value)?.nombre ?? $"Op_{filtroOperacionId.Value}")
                : "Todas_las_Operaciones";

            string nombreLimpio = string.Concat(nombreCliente.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            string fileName = $"Prestamos_Personal_{nombreLimpio}_{ObtenerNombreMes(mesSeleccionado)}_{anioSeleccionado}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            var workbook = new NPOI.XSSF.UserModel.XSSFWorkbook();
            var sheet = workbook.CreateSheet("Prestamos_Personal");

            // Estilos
            var titleFont = workbook.CreateFont();
            titleFont.IsBold = true;
            titleFont.FontHeightInPoints = 14;
            var titleStyle = workbook.CreateCellStyle();
            titleStyle.SetFont(titleFont);

            var subtitleFont = workbook.CreateFont();
            subtitleFont.IsItalic = true;
            subtitleFont.FontHeightInPoints = 10;
            var subtitleStyle = workbook.CreateCellStyle();
            subtitleStyle.SetFont(subtitleFont);

            var headerFont = workbook.CreateFont();
            headerFont.IsBold = true;
            headerFont.FontHeightInPoints = 11;
            headerFont.Color = NPOI.HSSF.Util.HSSFColor.White.Index;

            var headerStyle = workbook.CreateCellStyle();
            headerStyle.SetFont(headerFont);
            headerStyle.FillForegroundColor = NPOI.HSSF.Util.HSSFColor.RoyalBlue.Index;
            headerStyle.FillPattern = NPOI.SS.UserModel.FillPattern.SolidForeground;
            headerStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Center;
            headerStyle.VerticalAlignment = NPOI.SS.UserModel.VerticalAlignment.Center;

            var dataFormat = workbook.CreateDataFormat();

            var moneyStyle = workbook.CreateCellStyle();
            moneyStyle.DataFormat = dataFormat.GetFormat("C$ #,##0.00");
            moneyStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            var hoursStyle = workbook.CreateCellStyle();
            hoursStyle.DataFormat = dataFormat.GetFormat("#,##0.00");
            hoursStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            var totalStyle = workbook.CreateCellStyle();
            var totalFont = workbook.CreateFont();
            totalFont.IsBold = true;
            totalStyle.SetFont(totalFont);
            totalStyle.DataFormat = dataFormat.GetFormat("C$ #,##0.00");
            totalStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            var totalHoursStyle = workbook.CreateCellStyle();
            totalHoursStyle.SetFont(totalFont);
            totalHoursStyle.DataFormat = dataFormat.GetFormat("#,##0.00");
            totalHoursStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            // Fila 0: Título
            var rTitle = sheet.CreateRow(0);
            rTitle.CreateCell(0).SetCellValue("BUSSERSA - CONCILIACIÓN DE PRÉSTAMOS DE PERSONAL");
            rTitle.GetCell(0).CellStyle = titleStyle;

            // Fila 1: Subtítulo Período y Cliente
            var rSub = sheet.CreateRow(1);
            rSub.CreateCell(0).SetCellValue($"Período: {ObtenerNombreMes(mesSeleccionado)} {anioSeleccionado} | Cliente Nómina: {nombreCliente.Replace("_", " ")} | Generado: {DateTime.Now:dd/MM/yyyy HH:mm}");
            rSub.GetCell(0).CellStyle = subtitleStyle;

            // Fila 3: Encabezados
            var rHeader = sheet.CreateRow(3);
            string[] headers = new[] {
                "No.", "Colaborador", "Cargo", "Nómina Contratada (Paga Salario)",
                "Cliente Donde Trabajó (Facturó)", "Horas Prestadas", "Costo / Hr Empleado (C$)", "Costo C$ Transferido"
            };

            for (int i = 0; i < headers.Length; i++)
            {
                var cell = rHeader.CreateCell(i);
                cell.SetCellValue(headers[i]);
                cell.CellStyle = headerStyle;
            }

            // Filas de datos
            int rowIdx = 4;
            int counter = 1;
            foreach (var item in data)
            {
                var row = sheet.CreateRow(rowIdx++);
                row.CreateCell(0).SetCellValue(counter++);
                row.CreateCell(1).SetCellValue(item.nombre_empleado ?? "");
                row.CreateCell(2).SetCellValue(item.cargo ?? "");
                row.CreateCell(3).SetCellValue(item.op_nomina_nombre ?? "");
                row.CreateCell(4).SetCellValue(item.op_trabajo_nombre ?? "");

                var cHours = row.CreateCell(5);
                cHours.SetCellValue((double)item.horas_trabajadas);
                cHours.CellStyle = hoursStyle;

                var cCostHr = row.CreateCell(6);
                cCostHr.SetCellValue((double)item.costo_hora_empleado);
                cCostHr.CellStyle = moneyStyle;

                var cTotal = row.CreateCell(7);
                cTotal.SetCellValue((double)item.costo_transferido);
                cTotal.CellStyle = moneyStyle;
            }

            // Fila de Totales
            var rTotal = sheet.CreateRow(rowIdx);
            var cTotalLabel = rTotal.CreateCell(4);
            cTotalLabel.SetCellValue("TOTALES:");
            cTotalLabel.CellStyle = totalStyle;

            var cSumHours = rTotal.CreateCell(5);
            cSumHours.SetCellValue((double)data.Sum(p => p.horas_trabajadas));
            cSumHours.CellStyle = totalHoursStyle;

            var cSumCost = rTotal.CreateCell(7);
            cSumCost.SetCellValue((double)data.Sum(p => p.costo_transferido));
            cSumCost.CellStyle = totalStyle;

            // Ancho de columnas fijas para evitar excepciones de GDI en WASM
            sheet.SetColumnWidth(0, 8 * 256);
            sheet.SetColumnWidth(1, 35 * 256);
            sheet.SetColumnWidth(2, 28 * 256);
            sheet.SetColumnWidth(3, 25 * 256);
            sheet.SetColumnWidth(4, 25 * 256);
            sheet.SetColumnWidth(5, 18 * 256);
            sheet.SetColumnWidth(6, 22 * 256);
            sheet.SetColumnWidth(7, 24 * 256);

            using var ms = new System.IO.MemoryStream();
            workbook.Write(ms);
            workbook.Close();
            byte[] bytes = ms.ToArray();
            string base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync("downloadFile", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64, fileName);
            Snackbar.Add("Reporte de Préstamos descargado con éxito.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar a Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            isExportingPrestamos = false;
            StateHasChanged();
        }
    }

    private async Task ExportarColaboradoresExcel()
    {
        var data = ColaboradoresFiltrados.ToList();
        if (!data.Any())
        {
            Snackbar.Add("No hay datos de colaboradores para exportar.", Severity.Warning);
            return;
        }

        isExportingColaboradores = true;
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            string nombreCliente = filtroOperacionId.HasValue && filtroOperacionId.Value > 0
                ? (operacionesList.FirstOrDefault(o => o.id == filtroOperacionId.Value)?.nombre ?? $"Op_{filtroOperacionId.Value}")
                : "Todas_las_Operaciones";

            string nombreLimpio = string.Concat(nombreCliente.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            string fileName = $"Personal_Activo_{nombreLimpio}_{ObtenerNombreMes(mesSeleccionado)}_{anioSeleccionado}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            var workbook = new NPOI.XSSF.UserModel.XSSFWorkbook();
            var sheet = workbook.CreateSheet("Personal_Activo");

            var titleFont = workbook.CreateFont();
            titleFont.IsBold = true;
            titleFont.FontHeightInPoints = 14;
            var titleStyle = workbook.CreateCellStyle();
            titleStyle.SetFont(titleFont);

            var subtitleFont = workbook.CreateFont();
            subtitleFont.IsItalic = true;
            subtitleFont.FontHeightInPoints = 10;
            var subtitleStyle = workbook.CreateCellStyle();
            subtitleStyle.SetFont(subtitleFont);

            var headerFont = workbook.CreateFont();
            headerFont.IsBold = true;
            headerFont.FontHeightInPoints = 11;
            headerFont.Color = NPOI.HSSF.Util.HSSFColor.White.Index;

            var headerStyle = workbook.CreateCellStyle();
            headerStyle.SetFont(headerFont);
            headerStyle.FillForegroundColor = NPOI.HSSF.Util.HSSFColor.RoyalBlue.Index;
            headerStyle.FillPattern = NPOI.SS.UserModel.FillPattern.SolidForeground;
            headerStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Center;
            headerStyle.VerticalAlignment = NPOI.SS.UserModel.VerticalAlignment.Center;

            var dataFormat = workbook.CreateDataFormat();

            var moneyStyle = workbook.CreateCellStyle();
            moneyStyle.DataFormat = dataFormat.GetFormat("C$ #,##0.00");
            moneyStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            var hoursStyle = workbook.CreateCellStyle();
            hoursStyle.DataFormat = dataFormat.GetFormat("#,##0.00");
            hoursStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            var totalStyle = workbook.CreateCellStyle();
            var totalFont = workbook.CreateFont();
            totalFont.IsBold = true;
            totalStyle.SetFont(totalFont);
            totalStyle.DataFormat = dataFormat.GetFormat("C$ #,##0.00");
            totalStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            var totalHoursStyle = workbook.CreateCellStyle();
            totalHoursStyle.SetFont(totalFont);
            totalHoursStyle.DataFormat = dataFormat.GetFormat("#,##0.00");
            totalHoursStyle.Alignment = NPOI.SS.UserModel.HorizontalAlignment.Right;

            var rTitle = sheet.CreateRow(0);
            rTitle.CreateCell(0).SetCellValue("BUSSERSA - COLABORADORES QUE LABORARON EN EL MES (HEADCOUNT)");
            rTitle.GetCell(0).CellStyle = titleStyle;

            var rSub = sheet.CreateRow(1);
            rSub.CreateCell(0).SetCellValue($"Período: {ObtenerNombreMes(mesSeleccionado)} {anioSeleccionado} | Cliente: {nombreCliente.Replace("_", " ")} | Total Colaboradores: {data.Count} | Generado: {DateTime.Now:dd/MM/yyyy HH:mm}");
            rSub.GetCell(0).CellStyle = subtitleStyle;

            var rHeader = sheet.CreateRow(3);
            string[] headers = new[] {
                "No.", "Colaborador", "Cargo", "Nómina de Procedencia",
                "Rol", "Horas Trabajadas", "Costo / Hr (C$)", "Costo Total Imputable (C$)"
            };

            for (int i = 0; i < headers.Length; i++)
