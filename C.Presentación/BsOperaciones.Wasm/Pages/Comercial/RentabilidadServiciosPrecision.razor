@page "/comercial/indicadores-servicios"
@using Modelo.Comercial
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@inject IOdooService _OdooService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<style>
    .precision-container {
        padding: 24px;
        background: #f8fafc;
        min-height: 100vh;
    }
    .panel-card {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(226, 232, 240, 0.8);
        background: white;
    }
    .status-badge-perdida {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 11px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .status-badge-rentable {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 11px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .effect-badge-subsidia {
        background: #faf5ff;
        color: #6b21a8;
        border: 1px solid #e9d5ff;
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 11px;
    }
    .effect-badge-absorbe {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 11px;
    }
    .status-badge-supervision {
        background: #faf5ff;
        color: #7e22ce;
        border: 1px solid #e9d5ff;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 11px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
</style>

<div class="precision-container">
    <!-- Encabezado Principal -->
    <div class="d-flex justify-between align-center flex-wrap mb-6">
        <div>
            <h3 class="font-bold d-flex align-center gap-2 mb-1" style="color: #0f172a; font-size: 24px;">
                <MudIcon Icon="@Icons.Material.Filled.QueryStats" Color="Color.Primary" Size="Size.Large" />
                Rentabilidad Real por Servicio y Conciliación de Préstamos
            </h3>
            <MudText Typo="Typo.body2" Class="text-secondary">
                Indicadores reales de costos, facturación, márgenes y redistribución de horas trabajadas entre clientes.
            </MudText>
        </div>
        
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Autorenew" OnClick="CargarIndicadores" Class="font-bold">
                Actualizar Indicadores
            </MudButton>
        </div>
    </div>

    <!-- Barra de Filtros (Año, Mes, Operación) -->
    <MudPaper Class="pa-4 mb-6 panel-card" Elevation="2">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem XS="12" SM="3" MD="2">
                <MudSelect T="int" Label="Año" @bind-Value="anioSeleccionado" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var a in aniosDisponibles)
                    {
                        <MudSelectItem T="int" Value="@a">@a</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="4" MD="3">
                <MudSelect T="int" Label="Mes de Cierre" @bind-Value="mesSeleccionado" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="int" Value="1">Enero</MudSelectItem>
                    <MudSelectItem T="int" Value="2">Febrero</MudSelectItem>
                    <MudSelectItem T="int" Value="3">Marzo</MudSelectItem>
                    <MudSelectItem T="int" Value="4">Abril</MudSelectItem>
                    <MudSelectItem T="int" Value="5">Mayo</MudSelectItem>
                    <MudSelectItem T="int" Value="6">Junio</MudSelectItem>
                    <MudSelectItem T="int" Value="7">Julio</MudSelectItem>
                    <MudSelectItem T="int" Value="8">Agosto</MudSelectItem>
                    <MudSelectItem T="int" Value="9">Septiembre</MudSelectItem>
                    <MudSelectItem T="int" Value="10">Octubre</MudSelectItem>
                    <MudSelectItem T="int" Value="11">Noviembre</MudSelectItem>
                    <MudSelectItem T="int" Value="12">Diciembre</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="5" MD="5">
                <MudSelect T="int?" Label="Operación / Cliente" @bind-Value="filtroOperacionId" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="int?" Value="@((int?)null)">Todas las Operaciones</MudSelectItem>
                    @if (operacionesList != null)
                    {
                        @foreach (var op in operacionesList)
                        {
                            <MudSelectItem T="int?" Value="@((int?)op.id)">@op.nombre</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="12" MD="2" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="CargarIndicadores" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" Class="py-2 font-bold">
                    Consultar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (consolidado == null || !consolidado.Servicios.Any())
    {
        <MudPaper Class="pa-12 text-center my-6 panel-card" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Large" Color="Color.Info" Class="mb-3" Style="font-size: 48px;" />
            <MudText Typo="Typo.h6" Class="font-bold">No se encontraron registros para @ObtenerNombreMes(mesSeleccionado) @anioSeleccionado</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mt-1">Verifica que existan registros de asistencia y cierre de nómina para el período seleccionado.</MudText>
        </MudPaper>
    }
    else
    {
        <!-- KPI Cards con Datos Reales, Headcount y Desglose de Supervisión -->
        <MudGrid Class="mb-6">
            <MudItem XS="12" SM="6" MD="4" LG="2">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #2563eb;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">FACTURACIÓN TOTAL</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #2563eb;">C$ @consolidado.TotalIngresos.ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">@consolidado.TotalHorasTrabajadas.ToString("N1") hrs (Tarifa C$ @consolidado.TarifaPromedioActual.ToString("N2")/hr)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="4" LG="2">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #0284c7;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">PERSONAL ACTIVO EN EL MES</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #0284c7;">@consolidado.TotalEmpleados colaboradores</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">@consolidado.PromedioHorasColaborador.ToString("N1") hrs / pers. (laboraron)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="4" LG="2">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #d97706;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">COSTO OPERATIVO DIRECTO</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #d97706;">C$ @consolidado.TotalCostoOperativo.ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">Margen Cuadrilla: @consolidado.MargenOperativoPct.ToString("N1")%</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="4" LG="2">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #7c3aed;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">SUPERVISIÓN / MANDO</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #7c3aed;">C$ @consolidado.TotalCostoSupervision.ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">@consolidado.TotalSupervisores supervisor@(consolidado.TotalSupervisores == 1 ? "" : "es") asignado@(consolidado.TotalSupervisores == 1 ? "" : "s")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="4" LG="2">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #0891b2;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">PRÉSTAMOS INTER-CLIENTE</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #0891b2;">C$ @consolidado.TotalCostoTransferido.ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">@consolidado.TotalHorasPrestadas.ToString("N1") hrs cedidas</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="4" LG="2">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="@(consolidado.TotalUtilidadReal >= 0 ? "border-left: 5px solid #16a34a;" : "border-left: 5px solid #dc2626;")" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">UTILIDAD NETA REAL</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="@(consolidado.TotalUtilidadReal >= 0 ? "color: #16a34a;" : "color: #dc2626;")">
                        C$ @consolidado.TotalUtilidadReal.ToString("N2")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">Margen Neto: @consolidado.MargenGlobalPct.ToString("N1")%</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (filtroOperacionId.HasValue && filtroOperacionId.Value > 0)
        {
            var opSup = consolidado.Supervisores.Where(s => s.operacion_id == filtroOperacionId.Value).ToList();
            var clienteActual = consolidado.Clientes.FirstOrDefault(c => c.operacion_id == filtroOperacionId.Value);
            decimal pctSupDePerdida = (consolidado.TotalUtilidadReal < 0 && consolidado.TotalCostoSupervision > 0)
                ? Math.Min(100m, Math.Round((consolidado.TotalCostoSupervision / Math.Abs(consolidado.TotalUtilidadReal)) * 100m, 1))
                : 0m;

            <MudPaper Class="pa-4 mb-6 panel-card" Elevation="2" Style="border-left: 6px solid #f59e0b; background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);">
                <div class="d-flex align-center justify-between flex-wrap gap-2 mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Color="Color.Warning" Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle1" Class="font-bold" Style="color: #92400e;">
                            DIAGNÓSTICO FINANCIERO EJECUTIVO: @(clienteActual?.cliente_nombre ?? "OPERACIÓN SELECCIONADA")
                        </MudText>
                    </div>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.PeopleAlt">
                        Headcount: @consolidado.TotalEmpleados colaboradores activos
                    </MudChip>
                </div>
                
                <MudGrid>
                    <!-- Factor 1: Supervisión -->
                    <MudItem XS="12" MD="6" LG="3">
                        <MudPaper Elevation="0" Class="pa-3 rounded h-100" Style="background: white; border: 1px solid #fde68a;">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Color="Color.Secondary" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-bold" Style="color: #78350f;">1. SUPERVISIÓN NO FACTURADA</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #451a03; line-height: 1.4;">
                                @if (opSup.Any())
                                {
                                    <span><strong>En nómina:</strong> @string.Join(", ", opSup.Select(s => $"{s.supervisor_nombre} (C$ {s.costo_supervision:N2})"))<br /></span>
                                }
                                else
                                {
                                    <span>No tiene supervisores asignados en nómina directa.<br /></span>
                                }
                                Costo no cobrado en facturas.
                                @if (pctSupDePerdida > 0)
                                {
                                    <span> Explica el <strong>@pctSupDePerdida%</strong> del déficit total de la operación.</span>
                                }
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <!-- Factor 2: Margen Operativo Directo de Cuadrilla -->
                    <MudItem XS="12" MD="6" LG="3">
                        <MudPaper Elevation="0" Class="pa-3 rounded h-100" Style="background: white; border: 1px solid #fde68a;">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-bold" Style="color: #78350f;">2. CUADRILLA OPERATIVA DIRECTA</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #451a03; line-height: 1.4;">
                                <strong>Costo Cuadrilla:</strong> C$ @consolidado.TotalCostoOperativo.ToString("N2")<br />
                                <strong>Costo/Hr Cuadrilla:</strong> C$ @consolidado.TarifaEquilibrioOperativa.ToString("N2") / hr<br />
                                <strong>Margen Operativo Puro:</strong> 
                                <span style="@(consolidado.MargenOperativoPct >= 0 ? "color: #16a34a; font-weight: 700;" : "color: #dc2626; font-weight: 700;")">
                                    @consolidado.MargenOperativoPct.ToString("N1")%
                                </span> (aislando supervisión).
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <!-- Factor 3: Personal que colaboró en los movimientos -->
                    <MudItem XS="12" MD="6" LG="3">
                        <MudPaper Elevation="0" Class="pa-3 rounded h-100" Style="background: white; border: 1px solid #fde68a;">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Info" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-bold" Style="color: #78350f;">3. PERSONAL EFECTIVO EN MOVIMIENTOS</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #451a03; line-height: 1.4;">
                                <strong>@consolidado.TotalEmpleados colaboradores</strong> registraron asistencia en el mes (@consolidado.TotalHorasTrabajadas.ToString("N1") hrs totales, prom. @consolidado.PromedioHorasColaborador.ToString("N1") hrs/persona).<br />
                                <span style="font-size: 11px; color: #78350f;">
                                    * Se excluyen colaboradores en nómina que no laboraron en este cliente.
                                </span>
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <!-- Factor 4: Punto de Equilibrio y Ajuste de Tarifa (para quedar en 0) -->
                    <MudItem XS="12" MD="6" LG="3">
                        <MudPaper Elevation="0" Class="pa-3 rounded h-100" Style="background: #f0fdf4; border: 1px solid #86efac;">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Balance" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-bold" Style="color: #14532d;">4. AJUSTE DE TARIFA (EQUILIBRIO = C$ 0)</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #14532d; line-height: 1.35; font-size: 12px;">
                                <strong>Tarifa Actual:</strong> C$ @consolidado.TarifaPromedioActual.ToString("N2") / hr<br />
                                <strong>Equilibrio Cuadrilla (0%):</strong> 
                                <span class="font-bold" style="color: #15803d;">C$ @consolidado.TarifaEquilibrioOperativa.ToString("N2")/hr</span>
                                <span> (@(consolidado.AjusteTarifaOperativa >= 0 ? "+" : "")C$ @consolidado.AjusteTarifaOperativa.ToString("N2"))</span><br />
                                <strong>Equilibrio Integral (con Sup):</strong> 
                                <span class="font-bold" style="color: #047857;">C$ @consolidado.TarifaEquilibrioIntegral.ToString("N2")/hr</span>
                                <span> (@(consolidado.AjusteTarifaIntegral >= 0 ? "+" : "")C$ @consolidado.AjusteTarifaIntegral.ToString("N2"))</span>
                            </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <!-- Pestañas Principales -->
        <MudCard Elevation="2" Class="panel-card mb-6">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Color="Color.Surface">
                
                <!-- TAB 1: Matriz de Rentabilidad Real por Servicio / Cargo -->
                <MudTabPanel Text="Rentabilidad por Servicio y Cargo" Icon="@Icons.Material.Filled.WorkOutline">
                    <div class="d-flex justify-between align-center flex-wrap mb-4 gap-3">
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudButton Variant="@(filtroEstado == null ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Default" OnClick="@(() => SetFiltroEstado(null))">
                                Todos (@consolidado.Servicios.Count)
                            </MudButton>
                            <MudButton Variant="@(filtroEstado == "PERDIDA" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Error" OnClick="@(() => SetFiltroEstado("PERDIDA"))">
                                🔴 En Pérdida (@consolidado.ServiciosEnPerdida)
                            </MudButton>
                            <MudButton Variant="@(filtroEstado == "RENTABLE" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Success" OnClick="@(() => SetFiltroEstado("RENTABLE"))">
                                🟢 Con Utilidad (@consolidado.ServiciosRentables)
                            </MudButton>
                            <MudButton Variant="@(filtroEstado == "SUPERVISION" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => SetFiltroEstado("SUPERVISION"))">
                                🛡️ Supervisión (@consolidado.TotalSupervisores)
                            </MudButton>
                        </div>
                        
                        <div style="min-width: 280px;">
                            <MudTextField @bind-Value="busquedaServicio" Placeholder="Buscar por cliente o cargo..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" />
                        </div>
                    </div>

                    <MudTable Items="@ServiciosFiltrados" Hover="true" Striped="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Cliente / Operación</MudTh>
                            <MudTh>Cargo / Servicio</MudTh>
                            <MudTh Style="text-align: right;">Horas Trabajadas</MudTh>
                            <MudTh Style="text-align: right;">Ingreso Facturado</MudTh>
                            <MudTh Style="text-align: right; background: #eff6ff;">Tarifa / Hr</MudTh>
                            <MudTh Style="text-align: right;">Costo Laboral Real</MudTh>
                            <MudTh Style="text-align: right; background: #fef2f2;">Costo / Hr</MudTh>
                            <MudTh Style="text-align: right;">Margen / Hr</MudTh>
                            <MudTh Style="text-align: right;">Utilidad Neta</MudTh>
                            <MudTh Style="text-align: center;">Margen Real %</MudTh>
                            <MudTh Style="text-align: center;">Estado</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Operación"><strong>@context.cliente_nombre</strong></MudTd>
                            <MudTd DataLabel="Cargo">
                                @if (context.es_supervision)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" Class="font-bold">
                                        🛡️ @context.cargo
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @context.cargo
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Horas" Style="text-align: right;">
                                @if (context.es_supervision)
                                {
                                    <span class="text-secondary">-</span>
                                }
                                else
                                {
                                    <span>@context.horas_trabajadas.ToString("N2")</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Facturado" Style="text-align: right; font-weight: 600;">
                                @if (context.es_supervision)
                                {
                                    <span class="text-secondary">C$ 0.00</span>
                                }
                                else
                                {
                                    <span>C$ @context.ingreso_total.ToString("N2")</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Tarifa/Hr" Style="text-align: right; font-weight: 700; color: #1e40af; background: #eff6ff;">
                                @if (context.es_supervision)
                                {
                                    <span class="text-secondary">-</span>
                                }
                                else
                                {
                                    <span>C$ @context.tarifa_promedio_hora.ToString("N2")</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Costo Laboral" Style="text-align: right; font-weight: 700;">
                                <span style="@(context.es_supervision ? "color: #7c3aed;" : "")">
                                    C$ @context.costo_real_total.ToString("N2")
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Costo/Hr" Style="text-align: right; font-weight: 700; color: #991b1b; background: #fef2f2;">
                                @if (context.es_supervision)
                                {
                                    <span class="text-secondary">-</span>
                                }
                                else
                                {
                                    <span>C$ @context.costo_real_hora.ToString("N2")</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Margen/Hr" Style="text-align: right; font-weight: 700;">
                                @if (context.es_supervision)
                                {
                                    <span class="text-secondary">-</span>
                                }
                                else
                                {
                                    <span style="@(context.margen_hora >= 0 ? "color: #16a34a;" : "color: #dc2626;")">
                                        @(context.margen_hora >= 0 ? "+" : "")C$ @context.margen_hora.ToString("N2")
