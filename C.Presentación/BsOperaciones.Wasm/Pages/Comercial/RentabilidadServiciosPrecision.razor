@page "/comercial/indicadores-servicios"
@using Modelo.Comercial
@using Modelo.Entidades.Entradas.Odoo
@using Modelo.ClasesGenericas
@using HostService.Interfaces
@inject IOdooService _OdooService
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<style>
    .precision-container {
        padding: 24px;
        background: #f8fafc;
        min-height: 100vh;
    }
    .panel-card {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(226, 232, 240, 0.8);
        background: white;
    }
    .status-badge-perdida {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 11px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .status-badge-rentable {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 11px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .effect-badge-subsidia {
        background: #faf5ff;
        color: #6b21a8;
        border: 1px solid #e9d5ff;
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 11px;
    }
    .effect-badge-absorbe {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 11px;
    }
</style>

<div class="precision-container">
    <!-- Encabezado Principal -->
    <div class="d-flex justify-between align-center flex-wrap mb-6">
        <div>
            <h3 class="font-bold d-flex align-center gap-2 mb-1" style="color: #0f172a; font-size: 24px;">
                <MudIcon Icon="@Icons.Material.Filled.QueryStats" Color="Color.Primary" Size="Size.Large" />
                Rentabilidad Real por Servicio y Conciliación de Préstamos
            </h3>
            <MudText Typo="Typo.body2" Class="text-secondary">
                Indicadores reales de costos, facturación, márgenes y redistribución de horas trabajadas entre clientes.
            </MudText>
        </div>
        
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Autorenew" OnClick="CargarIndicadores" Class="font-bold">
                Actualizar Indicadores
            </MudButton>
        </div>
    </div>

    <!-- Barra de Filtros (Año, Mes, Operación) -->
    <MudPaper Class="pa-4 mb-6 panel-card" Elevation="2">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem XS="12" SM="3" MD="2">
                <MudSelect T="int" Label="Año" @bind-Value="anioSeleccionado" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var a in aniosDisponibles)
                    {
                        <MudSelectItem T="int" Value="@a">@a</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="4" MD="3">
                <MudSelect T="int" Label="Mes de Cierre" @bind-Value="mesSeleccionado" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="int" Value="1">Enero</MudSelectItem>
                    <MudSelectItem T="int" Value="2">Febrero</MudSelectItem>
                    <MudSelectItem T="int" Value="3">Marzo</MudSelectItem>
                    <MudSelectItem T="int" Value="4">Abril</MudSelectItem>
                    <MudSelectItem T="int" Value="5">Mayo</MudSelectItem>
                    <MudSelectItem T="int" Value="6">Junio</MudSelectItem>
                    <MudSelectItem T="int" Value="7">Julio</MudSelectItem>
                    <MudSelectItem T="int" Value="8">Agosto</MudSelectItem>
                    <MudSelectItem T="int" Value="9">Septiembre</MudSelectItem>
                    <MudSelectItem T="int" Value="10">Octubre</MudSelectItem>
                    <MudSelectItem T="int" Value="11">Noviembre</MudSelectItem>
                    <MudSelectItem T="int" Value="12">Diciembre</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="5" MD="5">
                <MudSelect T="int?" Label="Operación / Cliente" @bind-Value="filtroOperacionId" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="int?" Value="@((int?)null)">Todas las Operaciones</MudSelectItem>
                    @if (operacionesList != null)
                    {
                        @foreach (var op in operacionesList)
                        {
                            <MudSelectItem T="int?" Value="@((int?)op.id)">@op.nombre</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="12" MD="2" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="CargarIndicadores" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" Class="py-2 font-bold">
                    Consultar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (consolidado == null || !consolidado.Servicios.Any())
    {
        <MudPaper Class="pa-12 text-center my-6 panel-card" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Large" Color="Color.Info" Class="mb-3" Style="font-size: 48px;" />
            <MudText Typo="Typo.h6" Class="font-bold">No se encontraron registros para @ObtenerNombreMes(mesSeleccionado) @anioSeleccionado</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mt-1">Verifica que existan registros de asistencia y cierre de nómina para el período seleccionado.</MudText>
        </MudPaper>
    }
    else
    {
        <!-- KPI Cards con Datos Reales -->
        <MudGrid Class="mb-6">
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #2563eb;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">FACTURACIÓN TOTAL</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #2563eb;">C$ @consolidado.TotalIngresos.ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">@consolidado.TotalHorasTrabajadas.ToString("N1") hrs facturables</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #dc2626;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">COSTO LABORAL REAL</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #dc2626;">C$ @consolidado.TotalCostoReal.ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">Costo real redistribuido</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #16a34a;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">UTILIDAD BRUTA REAL</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="@(consolidado.TotalUtilidadReal >= 0 ? "color: #16a34a;" : "color: #dc2626;")">
                        C$ @consolidado.TotalUtilidadReal.ToString("N2")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">Margen Real: @consolidado.MargenGlobalPct.ToString("N1")%</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4 panel-card" Style="border-left: 5px solid #7c3aed;" Elevation="2">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">PRÉSTAMOS INTER-CLIENTE</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-1" Style="color: #7c3aed;">C$ @consolidado.TotalCostoTransferido.ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">@consolidado.TotalHorasPrestadas.ToString("N1") hrs prestadas</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Pestañas Principales -->
        <MudCard Elevation="2" Class="panel-card mb-6">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Color="Color.Surface">
                
                <!-- TAB 1: Matriz de Rentabilidad Real por Servicio / Cargo -->
                <MudTabPanel Text="Rentabilidad por Servicio y Cargo" Icon="@Icons.Material.Filled.WorkOutline">
                    <div class="d-flex justify-between align-center flex-wrap mb-4 gap-3">
                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="@(filtroEstado == null ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Default" OnClick="@(() => SetFiltroEstado(null))">
                                Todos (@consolidado.Servicios.Count)
                            </MudButton>
                            <MudButton Variant="@(filtroEstado == "PERDIDA" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Error" OnClick="@(() => SetFiltroEstado("PERDIDA"))">
                                🔴 En Pérdida (@consolidado.ServiciosEnPerdida)
                            </MudButton>
                            <MudButton Variant="@(filtroEstado == "RENTABLE" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Success" OnClick="@(() => SetFiltroEstado("RENTABLE"))">
                                🟢 Con Utilidad (@consolidado.ServiciosRentables)
                            </MudButton>
                        </div>
                        
                        <div style="min-width: 280px;">
                            <MudTextField @bind-Value="busquedaServicio" Placeholder="Buscar por cliente o cargo..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" />
                        </div>
                    </div>

                    <MudTable Items="@ServiciosFiltrados" Hover="true" Striped="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Cliente / Operación</MudTh>
                            <MudTh>Cargo / Servicio</MudTh>
                            <MudTh Style="text-align: right;">Horas Trabajadas</MudTh>
                            <MudTh Style="text-align: right;">Ingreso Facturado</MudTh>
                            <MudTh Style="text-align: right; background: #eff6ff;">Tarifa / Hr</MudTh>
                            <MudTh Style="text-align: right;">Costo Laboral Real</MudTh>
                            <MudTh Style="text-align: right; background: #fef2f2;">Costo / Hr</MudTh>
                            <MudTh Style="text-align: right;">Margen / Hr</MudTh>
                            <MudTh Style="text-align: right;">Utilidad Neta</MudTh>
                            <MudTh Style="text-align: center;">Margen Real %</MudTh>
                            <MudTh Style="text-align: center;">Estado</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Operación"><strong>@context.cliente_nombre</strong></MudTd>
                            <MudTd DataLabel="Cargo">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@context.cargo</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Horas" Style="text-align: right;">@context.horas_trabajadas.ToString("N2")</MudTd>
                            <MudTd DataLabel="Facturado" Style="text-align: right; font-weight: 600;">C$ @context.ingreso_total.ToString("N2")</MudTd>
                            <MudTd DataLabel="Tarifa/Hr" Style="text-align: right; font-weight: 700; color: #1e40af; background: #eff6ff;">
                                C$ @context.tarifa_promedio_hora.ToString("N2")
                            </MudTd>
                            <MudTd DataLabel="Costo Laboral" Style="text-align: right;">C$ @context.costo_real_total.ToString("N2")</MudTd>
                            <MudTd DataLabel="Costo/Hr" Style="text-align: right; font-weight: 700; color: #991b1b; background: #fef2f2;">
                                C$ @context.costo_real_hora.ToString("N2")
                            </MudTd>
                            <MudTd DataLabel="Margen/Hr" Style="text-align: right; font-weight: 700;">
                                <span style="@(context.margen_hora >= 0 ? "color: #16a34a;" : "color: #dc2626;")">
                                    @(context.margen_hora >= 0 ? "+" : "")C$ @context.margen_hora.ToString("N2")
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Utilidad" Style="text-align: right; font-weight: 600;">
                                <span style="@(context.utilidad_neta >= 0 ? "color: #16a34a;" : "color: #dc2626;")">
                                    C$ @context.utilidad_neta.ToString("N2")
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Margen %" Style="text-align: center; font-weight: 700;">
                                <span style="@(context.margen_porcentaje < 0 ? "color: #dc2626;" : "color: #16a34a;")">
                                    @context.margen_porcentaje.ToString("N1")%
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Estado" Style="text-align: center;">
                                @if (context.margen_porcentaje < 0)
                                {
                                    <span class="status-badge-perdida">🔴 PÉRDIDA</span>
                                }
                                else
                                {
                                    <span class="status-badge-rentable">🟢 CON UTILIDAD</span>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>

                <!-- TAB 2: Conciliación de Préstamos / Transferencias de Personal Inter-Cliente -->
                <MudTabPanel Text="Conciliación de Préstamos de Personal" Icon="@Icons.Material.Filled.SwapHoriz">
                    <div class="d-flex justify-between align-center flex-wrap mb-4 gap-3">
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Primary">
                                Préstamos de Personal entre Clientes
                            </MudText>
                            <MudText Typo="Typo.body2" Class="text-secondary">
                                Empleados con contrato en una nómina pero que trabajaron jornadas efectivas en otro cliente.
                            </MudText>
                        </div>
                        <div style="min-width: 280px;">
                            <MudTextField @bind-Value="busquedaPrestamo" Placeholder="Buscar por colaborador o cliente..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" />
                        </div>
                    </div>

                    <MudTable Items="@PrestamosFiltrados" Hover="true" Striped="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Colaborador</MudTh>
                            <MudTh>Cargo</MudTh>
                            <MudTh>Nómina Contratada</MudTh>
                            <MudTh>Cliente Donde Trabajó</MudTh>
                            <MudTh Style="text-align: right;">Horas Prestadas</MudTh>
                            <MudTh Style="text-align: right;">Costo / Hr Empleado</MudTh>
                            <MudTh Style="text-align: right; background: #faf5ff;">Costo C$ Transferido</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Colaborador"><strong>@context.nombre_empleado</strong></MudTd>
                            <MudTd DataLabel="Cargo">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.cargo</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Nómina Origen">
                                <span class="effect-badge-subsidia">@context.op_nomina_nombre</span>
                            </MudTd>
                            <MudTd DataLabel="Destino">
                                <span class="effect-badge-absorbe">@context.op_trabajo_nombre</span>
                            </MudTd>
                            <MudTd DataLabel="Horas Prestadas" Style="text-align: right; font-weight: 600;">@context.horas_trabajadas.ToString("N2") hrs</MudTd>
                            <MudTd DataLabel="Costo/Hr" Style="text-align: right;">C$ @context.costo_hora_empleado.ToString("N2")</MudTd>
                            <MudTd DataLabel="Costo Transferido" Style="text-align: right; font-weight: 700; color: #6b21a8; background: #faf5ff;">
                                C$ @context.costo_transferido.ToString("N2")
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>

                <!-- TAB 3: Comparativo de Clientes (Distorsión Nómina vs Real) -->
                <MudTabPanel Text="Comparativo de Clientes (Nómina vs Real)" Icon="@Icons.Material.Filled.CompareArrows">
                    <div class="mb-4">
                        <MudText Typo="Typo.subtitle1" Class="font-bold" Color="Color.Primary">
                            Impacto Real por Cliente (Nómina Anterior vs Nómina Efectiva)
                        </MudText>
                        <MudText Typo="Typo.body2" Class="text-secondary">
                            Refleja el margen nominal anterior frente al margen real que efectivamente produjo cada cliente tras redistribuir las horas trabajadas.
                        </MudText>
                    </div>

                    <MudTable Items="@consolidado.Clientes" Hover="true" Striped="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Operación / Cliente</MudTh>
                            <MudTh Style="text-align: right;">Personal Efectivo</MudTh>
                            <MudTh Style="text-align: right;">Horas Reales</MudTh>
                            <MudTh Style="text-align: right;">Facturación</MudTh>
                            <MudTh Style="text-align: right;">Costo Nómina Anterior</MudTh>
                            <MudTh Style="text-align: right; background: #eff6ff;">Costo Nómina Real</MudTh>
                            <MudTh Style="text-align: right;">Ajuste Préstamos</MudTh>
                            <MudTh Style="text-align: center;">Margen Anterior</MudTh>
                            <MudTh Style="text-align: center; background: #f0fdf4;">Margen Real Efectivo</MudTh>
                            <MudTh Style="text-align: right;">Utilidad Real</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Cliente"><strong>@context.cliente_nombre</strong></MudTd>
                            <MudTd DataLabel="Personal" Style="text-align: right;">@context.total_empleados_reales</MudTd>
                            <MudTd DataLabel="Horas" Style="text-align: right;">@context.total_horas_reales.ToString("N2")</MudTd>
                            <MudTd DataLabel="Facturación" Style="text-align: right; font-weight: 600;">C$ @context.ingresos_totales.ToString("N2")</MudTd>
                            <MudTd DataLabel="Costo Anterior" Style="text-align: right; color: #64748b;">C$ @context.costo_nomina_anterior.ToString("N2")</MudTd>
                            <MudTd DataLabel="Costo Real" Style="text-align: right; font-weight: 700; color: #1e40af; background: #eff6ff;">
                                C$ @context.costo_nomina_real.ToString("N2")
                            </MudTd>
                            <MudTd DataLabel="Ajuste" Style="text-align: right; font-weight: 600;">
                                <span style="@(context.ajuste_prestamos < 0 ? "color: #16a34a;" : context.ajuste_prestamos > 0 ? "color: #dc2626;" : "color: #64748b;")">
                                    @(context.ajuste_prestamos > 0 ? "+" : "")C$ @context.ajuste_prestamos.ToString("N2")
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Margen Anterior" Style="text-align: center; color: #64748b;">
                                @context.margen_anterior.ToString("N1")%
                            </MudTd>
                            <MudTd DataLabel="Margen Real" Style="text-align: center; font-weight: 700; background: #f0fdf4;">
                                <span style="@(context.margen_real < 0 ? "color: #dc2626;" : "color: #16a34a;")">
                                    @context.margen_real.ToString("N1")%
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Utilidad Real" Style="text-align: right; font-weight: 700;">
                                <span style="@(context.utilidad_real >= 0 ? "color: #16a34a;" : "color: #dc2626;")">
                                    C$ @context.utilidad_real.ToString("N2")
                                </span>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>

            </MudTabs>
        </MudCard>
    }
</div>

@code {
    private int anioSeleccionado = 2026;
    private int mesSeleccionado = 8; // Agosto por defecto
    private List<int> aniosDisponibles = new List<int> { DateTime.Now.Year, DateTime.Now.Year - 1, DateTime.Now.Year - 2 };
    private int? filtroOperacionId = null;
    private bool isLoading = false;

    private List<Combos> operacionesList = new List<Combos>();
    private RentabilidadPrecisionConsolidadoDto consolidado = new RentabilidadPrecisionConsolidadoDto();

    // Filtros de tabla
    private string? filtroEstado = null;
    private string busquedaServicio = string.Empty;
    private string busquedaPrestamo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarCombosOperaciones();
        await CargarIndicadores();
    }

    private async Task CargarCombosOperaciones()
    {
        try
        {
            var res = await _OdooService.GetAllCombosHost("Operaciones");
            if (res.Model != null)
            {
                operacionesList = res.Model.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar operaciones: " + ex.Message, Severity.Warning);
        }
    }

    private async Task CargarIndicadores()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            int periodo = anioSeleccionado * 100 + mesSeleccionado;

            var res = await _OdooService.GetRentabilidadPrecision(periodo, filtroOperacionId, 0.20m);
            if (res.Model != null)
            {
                consolidado = res.Model;
            }
            else
            {
                consolidado = new RentabilidadPrecisionConsolidadoDto();
                Snackbar.Add("No se obtuvieron datos para el período.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar indicadores de precisión: " + ex.Message, Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetFiltroEstado(string? estado)
    {
        filtroEstado = estado;
    }

    private IEnumerable<RentabilidadServicioPrecisionDto> ServiciosFiltrados
    {
        get
        {
            if (consolidado?.Servicios == null) return Enumerable.Empty<RentabilidadServicioPrecisionDto>();

            var q = consolidado.Servicios.AsEnumerable();

            if (filtroEstado == "PERDIDA")
            {
                q = q.Where(s => s.margen_porcentaje < 0);
            }
            else if (filtroEstado == "RENTABLE")
            {
                q = q.Where(s => s.margen_porcentaje >= 0);
            }

            if (!string.IsNullOrWhiteSpace(busquedaServicio))
            {
                var term = busquedaServicio.Trim().ToLower();
                q = q.Where(s => (s.cliente_nombre?.ToLower().Contains(term) ?? false) ||
                                 (s.cargo?.ToLower().Contains(term) ?? false));
            }

            return q;
        }
    }

    private IEnumerable<ConciliacionPrestamoPersonalDto> PrestamosFiltrados
    {
        get
        {
            if (consolidado?.Prestamos == null) return Enumerable.Empty<ConciliacionPrestamoPersonalDto>();

            var q = consolidado.Prestamos.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(busquedaPrestamo))
            {
                var term = busquedaPrestamo.Trim().ToLower();
                q = q.Where(p => (p.nombre_empleado?.ToLower().Contains(term) ?? false) ||
                                 (p.op_nomina_nombre?.ToLower().Contains(term) ?? false) ||
                                 (p.op_trabajo_nombre?.ToLower().Contains(term) ?? false) ||
                                 (p.cargo?.ToLower().Contains(term) ?? false));
            }

            return q;
        }
    }

    private string ObtenerNombreMes(int mes)
    {
        return mes switch
        {
            1 => "Enero", 2 => "Febrero", 3 => "Marzo", 4 => "Abril",
            5 => "Mayo", 6 => "Junio", 7 => "Julio", 8 => "Agosto",
            9 => "Septiembre", 10 => "Octubre", 11 => "Noviembre", 12 => "Diciembre",
            _ => ""
        };
    }
}
