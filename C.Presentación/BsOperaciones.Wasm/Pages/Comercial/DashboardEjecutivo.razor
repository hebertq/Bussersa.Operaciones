@page "/comercial/dashboard"
@using Modelo.Comercial
@using Modelo.Entidades.Entradas.Odoo
@using HostService.Interfaces
@inject IOdooService _OdooService
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<style>
    .page-container {
        padding: 24px;
        background: #f8fafc;
        min-height: 100vh;
    }
    .panel-card {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(226, 232, 240, 0.8);
        background: white;
    }
    .status-badge-error {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 12px;
    }
    .status-badge-warning {
        background: #fefce8;
        color: #854d0e;
        border: 1px solid #fef08a;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 12px;
    }
    .status-badge-success {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 12px;
    }
</style>

<div class="page-container">
    <div class="d-flex justify-between align-center flex-wrap mb-6">
        <div>
            <h3 class="font-bold d-flex align-center gap-2 mb-1" style="color: #0f172a; font-size: 24px;">
                <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Color="Color.Primary" Size="Size.Large" />
                Dashboard Ejecutivo de Rentabilidad por Empresa
            </h3>
            <MudText Typo="Typo.body2" Class="text-secondary">
                Análisis automático de ingresos, costos operativos y margen de rentabilidad por cliente (calculado directamente desde la Producción Diaria).
            </MudText>
        </div>
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Autorenew" OnClick="CargarRentabilidadReal" Class="font-bold">
            Actualizar Datos
        </MudButton>
    </div>

    <!-- Filtros de Rango de Fechas y Empresa -->
    <MudPaper Class="pa-4 mb-6" Elevation="2" Style="border-radius: 12px; background: white;">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem XS="12" SM="5">
                <MudDateRangePicker Label="Rango de Fechas de Producción" @bind-DateRange="dateRangeReal" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem XS="12" SM="4">
                <MudSelect T="string" Label="Empresa / Cliente" @bind-Value="selectedClienteReal" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="string" Value="@((string)null)">Todas las Empresas</MudSelectItem>
                    @foreach (var emp in empresasDisponibles)
                    {
                        <MudSelectItem Value="@emp">@emp</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="3" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="CargarRentabilidadReal" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" Class="py-2">
                    Consultar Rentabilidad
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoadingReal)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (rentabilidadEmpresas == null || !rentabilidadEmpresas.Any())
    {
        <MudPaper Class="pa-12 text-center my-6" Elevation="2" Style="border-radius: 12px; background: white;">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Large" Color="Color.Info" Class="mb-3" Style="font-size: 48px;" />
            <MudText Typo="Typo.h6" Class="font-bold">No se encontraron registros de producción</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mt-1">Asegúrate de haber registrado producción diaria en la tabla para el período de fechas seleccionado.</MudText>
        </MudPaper>
    }
    else
    {
        <!-- Tarjetas KPI Generales -->
        <MudGrid Class="mb-6">
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left: 5px solid #1E88E5; border-radius: 10px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">INGRESOS TOTALES FACTURABLES</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-2" Color="Color.Primary">C$ @totalIngresosReal.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left: 5px solid #E53935; border-radius: 10px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">COSTO OPERATIVO ESTIMADO</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-2" Color="Color.Error">C$ @totalCostoReal.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left: 5px solid #43A047; border-radius: 10px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">UTILIDAD BRUTA TOTAL</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-2" Color="Color.Success">C$ @totalUtilidadReal.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left: 5px solid #8E24AA; border-radius: 10px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">% RENTABILIDAD PROMEDIO</MudText>
                    <MudText Typo="Typo.h5" Class="font-bold mt-2" Style="color: #8E24AA;">@promedioMargenReal.ToString("N2")%</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Tabla de Rentabilidad por Empresa -->
        <MudCard Elevation="3" Class="pa-4 mb-6" Style="border-radius: 12px;">
            <div class="d-flex justify-between align-center mb-4">
                <MudText Typo="Typo.h6" Class="font-bold d-flex align-center gap-2" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" />
                    Desglose de Rentabilidad y Estimación de Precios por Empresa
                </MudText>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                    @rentabilidadEmpresas.Count Empresas Analizadas
                </MudChip>
            </div>

            <MudTable Items="rentabilidadEmpresas" Hover="true" Striped="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Empresa / Cliente</MudTh>
                    <MudTh Style="text-align:center;">Servicios Registrados</MudTh>
                    <MudTh Style="text-align:center;">Proformas</MudTh>
                    <MudTh Style="text-align:center;">Facturas</MudTh>
                    <MudTh Style="text-align:right;">Ingreso Total (C$)</MudTh>
                    <MudTh Style="text-align:right;">Costo Operativo (C$)</MudTh>
                    <MudTh Style="text-align:right;">Utilidad Bruta (C$)</MudTh>
                    <MudTh Style="text-align:center;">Margen %</MudTh>
                    <MudTh Style="text-align:center;">Recomendación Tarifaria</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="font-bold text-dark" Style="font-size: 14px;">@context.Cliente</MudTd>
                    <MudTd Style="text-align:center;">@context.CantidadServicios</MudTd>
                    <MudTd Style="text-align:center;">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.TotalProformas</MudChip>
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.TotalFacturas</MudChip>
                    </MudTd>
                    <MudTd Style="text-align:right; font-weight:600;">C$ @context.IngresosTotales.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right; color:#d32f2f;">C$ @context.CostoOperativoEstimado.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right; font-weight:bold;" Class="@(context.UtilidadEstimada < 0 ? "text-error" : "text-success")">
                        C$ @context.UtilidadEstimada.ToString("N2")
                    </MudTd>
                    <MudTd Style="text-align:center; font-weight:bold;">
                        <span style="color: @(context.MargenPercent < 20m ? "#d32f2f" : (context.MargenPercent <= 35m ? "#d97706" : "#166534")); font-size: 14px;">
                            @context.MargenPercent.ToString("N2")%
                        </span>
                    </MudTd>
                    <MudTd Style="text-align:center;">
                        @if (context.MargenPercent < 20m)
                        {
                            <span class="status-badge-error">🔴 Reajustar Tarifa (+Precio)</span>
                        }
                        else if (context.MargenPercent <= 35m)
                        {
                            <span class="status-badge-warning">🟡 Rentabilidad Aceptable</span>
                        }
                        else
                        {
                            <span class="status-badge-success">🟢 Rentabilidad Óptima</span>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudCard>
    }
</div>

@code {
    private DateRange dateRangeReal = new DateRange(DateTime.Now.AddMonths(-1), DateTime.Now);
    private string selectedClienteReal = null;
    private bool isLoadingReal = false;
    private List<string> empresasDisponibles = new List<string>();
    private List<RentabilidadEmpresaItem> rentabilidadEmpresas = new List<RentabilidadEmpresaItem>();

    private decimal totalIngresosReal = 0;
    private decimal totalCostoReal = 0;
    private decimal totalUtilidadReal = 0;
    private decimal promedioMargenReal = 0;

    public class RentabilidadEmpresaItem
    {
        public string Cliente { get; set; } = string.Empty;
        public int CantidadServicios { get; set; }
        public int TotalProformas { get; set; }
        public int TotalFacturas { get; set; }
        public decimal IngresosTotales { get; set; }
        public decimal CostoOperativoEstimado { get; set; }
        public decimal UtilidadEstimada => IngresosTotales - CostoOperativoEstimado;
        public decimal MargenPercent => IngresosTotales > 0 ? (UtilidadEstimada / IngresosTotales) * 100m : 0m;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarRentabilidadReal();
    }

    private async Task CargarRentabilidadReal()
    {
        isLoadingReal = true;
        StateHasChanged();

        try
        {
            DateTime? inicio = dateRangeReal?.Start;
            DateTime? fin = dateRangeReal?.End;

            var res = await _OdooService.GetProduccionDiaria(inicio, fin, null, null);
            if (res.Model != null && res.Model.Any())
            {
                var produccion = res.Model.ToList();

                // Cargar lista de empresas únicas
                empresasDisponibles = produccion.Where(x => !string.IsNullOrEmpty(x.cliente))
                                               .Select(x => x.cliente!)
                                               .Distinct()
                                               .OrderBy(x => x)
                                               .ToList();

                // Filtrar por cliente si se seleccionó
                if (!string.IsNullOrEmpty(selectedClienteReal))
                {
                    produccion = produccion.Where(x => x.cliente == selectedClienteReal).ToList();
                }

                // Agrupar por empresa directamente desde admon.produccion_diaria
                rentabilidadEmpresas = produccion
                    .GroupBy(x => string.IsNullOrEmpty(x.cliente) ? "Sin Especificar" : x.cliente)
                    .Select(g => {
                        decimal ingresos = g.Sum(x => x.cantidad_producto * x.costo_producto);
                        // Estimado de costo operativo laboral (~60% de ingresos)
                        decimal costoEst = ingresos * 0.60m;
                        return new RentabilidadEmpresaItem
                        {
                            Cliente = g.Key,
                            CantidadServicios = g.Count(),
                            TotalProformas = g.Where(x => !string.IsNullOrEmpty(x.no_proforma)).Select(x => x.no_proforma).Distinct().Count(),
                            TotalFacturas = g.Where(x => !string.IsNullOrEmpty(x.no_factura)).Select(x => x.no_factura).Distinct().Count(),
                            IngresosTotales = ingresos,
                            CostoOperativoEstimado = costoEst
                        };
                    })
                    .OrderByDescending(x => x.IngresosTotales)
                    .ToList();

                // Calcular totales generales del dashboard
                totalIngresosReal = rentabilidadEmpresas.Sum(x => x.IngresosTotales);
                totalCostoReal = rentabilidadEmpresas.Sum(x => x.CostoOperativoEstimado);
                totalUtilidadReal = totalIngresosReal - totalCostoReal;
                promedioMargenReal = totalIngresosReal > 0 ? (totalUtilidadReal / totalIngresosReal) * 100m : 0m;
            }
            else
            {
                rentabilidadEmpresas = new List<RentabilidadEmpresaItem>();
                totalIngresosReal = 0;
                totalCostoReal = 0;
                totalUtilidadReal = 0;
                promedioMargenReal = 0;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar la rentabilidad por empresa: " + ex.Message, Severity.Error);
        }
        finally
        {
            isLoadingReal = false;
            StateHasChanged();
        }
    }
}
