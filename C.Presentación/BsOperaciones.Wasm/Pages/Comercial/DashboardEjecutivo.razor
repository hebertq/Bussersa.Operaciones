@page "/comercial/dashboard"
@using Modelo.Comercial
@using HostService.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IOdooService _OdooService
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-12">
    <div class="d-flex justify-space-between align-center flex-wrap mb-6">
        <MudText Typo="Typo.h4" Class="font-bold" Style="background: linear-gradient(90deg, #1A237E, #0D47A1); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            Dashboard Ejecutivo de Rentabilidad (CBC)
        </MudText>
        
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="OpenUploadDialog" Class="font-bold">
            Importar Datos de Excel
        </MudButton>
    </div>

    <!-- Barra de Filtros -->
    <MudPaper Class="pa-4 mb-6" Elevation="2" Style="border-radius: 8px;">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem XS="12" SM="4">
                <MudSelect T="string" Label="Seleccionar Período (Mes)" @bind-Value="selectedMonth" SelectedValuesChanged="OnFiltersChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @if (availableMonths.Count == 0)
                    {
                        <MudSelectItem Value="@("")">Ninguno (Sube un Excel)</MudSelectItem>
                    }
                    @foreach (var m in availableMonths)
                    {
                        <MudSelectItem Value="@m">@m</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="4">
                <MudSelect T="string" Label="Turno" @bind-Value="selectedTurn" SelectedValuesChanged="OnFiltersChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("TODOS")">TODOS los Turnos</MudSelectItem>
                    <MudSelectItem Value="@("DIA")">Turno DÍA</MudSelectItem>
                    <MudSelectItem Value="@("NOCHE")">Turno NOCHE</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem XS="12" SM="4" Class="text-right">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadDashboard" StartIcon="@Icons.Material.Filled.Refresh">
                    Actualizar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (dashboardData == null)
    {
        <!-- Estado Vacío y Formulario de Carga Directa -->
        <MudPaper Class="pa-12 text-center my-6" Elevation="2" Style="border-radius: 12px; border: 2px dashed #BDBDBD; background: #FAFAFA;">
            <MudIcon Icon="@Icons.Material.Filled.InsertChartOutlined" Size="Size.Large" Color="Color.Default" Class="mb-4" Style="font-size: 64px;" />
            <MudText Typo="Typo.h5" Class="mb-2 font-bold">No hay datos para mostrar</MudText>
            <MudText Typo="Typo.body1" Class="text-muted mb-6">Por favor, selecciona un mes disponible o sube el reporte consolidado de rentabilidad Excel para comenzar.</MudText>
            
            <div style="max-width: 500px; margin: 0 auto;">
                <MudPaper Class="pa-6 text-left" Elevation="3" Style="border-radius: 8px;">
                    <MudText Typo="Typo.subtitle1" Class="font-bold mb-4">Cargar Nuevo Archivo Excel</MudText>
                    
                    <MudTextField @bind-Value="uploadMonth" Label="Mes del Reporte (ej. 2026-06)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" HelperText="Formato: AAAA-MM" />
                    
                    <InputFile id="fileInput" OnChange="UploadFile" hidden accept=".xlsx" />
                    <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload" For="fileInput" FullWidth="true" Class="py-3">
                        Seleccionar Archivo y Procesar
                    </MudButton>
                    @if (isUploading)
                    {
                        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mt-3" />
                    }
                </MudPaper>
            </div>
        </MudPaper>
    }
    else
    {
        <!-- Contenedor del Dashboard Cargado -->
        <!-- Tarjetas de KPIs Financieros -->
        <MudText Typo="Typo.h5" Class="font-bold mb-4" Color="Color.Primary">Indicadores Clave de Rentabilidad</MudText>
        <MudGrid Class="mb-6">
            <MudItem XS="12" SM="4" MD="2">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left-color: #1E88E5; border-radius: 6px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">INGRESOS TOTALES</MudText>
                    <MudText Typo="Typo.h6" Class="font-bold mt-2" Color="Color.Primary">C$ @dashboardData.Kpis.IngresosTotales.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="4" MD="2">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left-color: #D32F2F; border-radius: 6px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">COSTO OPERATIVO</MudText>
                    <MudText Typo="Typo.h6" Class="font-bold mt-2" Color="Color.Error">C$ @dashboardData.Kpis.CostoTotalOperativo.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="4" MD="2">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left-color: #388E3C; border-radius: 6px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">UTILIDAD PRODUCIDA</MudText>
                    <MudText Typo="Typo.h6" Class="font-bold mt-2" Color="Color.Success">C$ @dashboardData.Kpis.UtilidadProducida.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="4" MD="2">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left-color: #4CAF50; border-radius: 6px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">MARGEN PROD. %</MudText>
                    <MudText Typo="Typo.h6" Class="font-bold mt-2" Style="color: #4CAF50;">@dashboardData.Kpis.MargenProduccionPercent.ToString("N2")%</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="4" MD="2">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left-color: #2E7D32; border-radius: 6px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">UTILIDAD NETA</MudText>
                    <MudText Typo="Typo.h6" Class="font-bold mt-2" Style="color: #2E7D32;">C$ @dashboardData.Kpis.UtilidadNeta.ToString("N2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="4" MD="2">
                <MudPaper Class="pa-4 text-center border-l-4" Style="border-left-color: #00E676; border-radius: 6px;" Elevation="3">
                    <MudText Typo="Typo.caption" Class="text-muted d-block font-bold">MARGEN NETO %</MudText>
                    <MudText Typo="Typo.h6" Class="font-bold mt-2" Style="color: #00C853;">@dashboardData.Kpis.MargenNetoPercent.ToString("N2")%</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Tarjetas de KPIs Físicos -->
        <MudGrid Class="mb-6">
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Style="border-radius: 8px;" Elevation="3">
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold">UNIDADES PACK</MudText>
                        <MudText Typo="Typo.h5" Class="font-bold">@dashboardData.Kpis.UnidadesProducidas.ToString("N0")</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Primary" Size="Size.Large" />
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Style="border-radius: 8px;" Elevation="3">
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold">ETIQUETAS PROCESADAS</MudText>
                        <MudText Typo="Typo.h5" Class="font-bold">@dashboardData.Kpis.EtiquetasProcesadas.ToString("N0")</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.QrCode" Color="Color.Secondary" Size="Size.Large" />
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Style="border-radius: 8px;" Elevation="3">
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold">REPOSICIÓN PALETIZANTE</MudText>
                        <MudText Typo="Typo.h5" Class="font-bold">C$ @dashboardData.Kpis.ReposicionPaletizante.ToString("N2")</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Warning" Size="Size.Large" />
                </MudPaper>
            </MudItem>
            <MudItem XS="12" SM="6" MD="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Style="border-radius: 8px;" Elevation="3">
                    <div>
                        <MudText Typo="Typo.caption" Class="text-muted font-bold">INGRESOS HORAS EXTRAS</MudText>
                        <MudText Typo="Typo.h5" Class="font-bold" Style="color: #2E7D32;">C$ @dashboardData.Kpis.IngresosHExtras.ToString("N2")</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.MoreTime" Color="Color.Success" Size="Size.Large" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Sección Detecciones Automáticas del Mix -->
        <MudText Typo="Typo.h5" Class="font-bold mb-4" Color="Color.Primary">Análisis del Período (Detecciones del Mix)</MudText>
        <MudGrid Class="mb-6">
            <MudItem XS="12" MD="4">
                <MudPaper Class="pa-4 border-t-4" Style="border-top-color: #1E88E5; border-radius: 6px;" Elevation="3">
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Class="mr-2" />
                        <MudText Typo="Typo.subtitle1" Class="font-bold">Mayor Volumen de Venta</MudText>
                    </div>
                    <MudText Typo="Typo.body1" Class="font-semibold text-muted">@dashboardData.Kpis.ProductoMayorVolumen</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" MD="4">
                <MudPaper Class="pa-4 border-t-4" Style="border-top-color: #FFB300; border-radius: 6px;" Elevation="3">
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Warning" Class="mr-2" />
                        <MudText Typo="Typo.subtitle1" Class="font-bold">Menor Volumen de Venta</MudText>
                    </div>
                    <MudText Typo="Typo.body1" Class="font-semibold text-muted">@dashboardData.Kpis.ProductoMenorVolumen</MudText>
                </MudPaper>
            </MudItem>
            <MudItem XS="12" MD="4">
                <MudPaper Class="pa-4 border-t-4" Style="border-top-color: #D32F2F; border-radius: 6px;" Elevation="3">
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-2" />
                        <MudText Typo="Typo.subtitle1" Class="font-bold">Menor Margen de Ganancia (Fuga)</MudText>
                    </div>
                    <MudText Typo="Typo.body1" Class="font-semibold text-error">@dashboardData.Kpis.ProductoMenorMargen</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Fila de Mapa de Calor y Análisis de Turnos -->
        <MudGrid Class="mb-6">
            <!-- Mapa de Calor -->
            <MudItem XS="12" LG="8">
                <MudCard Elevation="3" Class="pa-4" Style="border-radius: 8px; height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4 font-bold" Color="Color.Primary">Mapa de Calor: Rentabilidad Diaria por Turno</MudText>
                    
                    <div class="table-responsive">
                        <table class="table table-bordered text-center" style="width: 100%; border-collapse: collapse; border: 1px solid #E0E0E0;">
                            <thead>
                                <tr style="background-color: #F5F5F5;">
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Semana</th>
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Lunes</th>
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Martes</th>
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Miércoles</th>
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Jueves</th>
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Viernes</th>
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Sábado</th>
                                    <th style="padding: 10px; border: 1px solid #E0E0E0;">Domingo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var weeks = dashboardData.Heatmap.Select(x => x.Semana).Distinct().OrderBy(x => x).ToList();
                                }
                                @foreach (var w in weeks)
                                {
                                    <tr>
                                        <td style="padding: 10px; border: 1px solid #E0E0E0; font-weight: bold; background-color: #FAFAFA;">@w</td>
                                        @foreach (var d in new[] { "Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado", "Domingo" })
                                        {
                                            var cell = dashboardData.Heatmap.FirstOrDefault(x => x.Semana == w && x.DiaSemana == d);
                                            <td style="padding: 10px; border: 1px solid #E0E0E0; font-weight: 500; @GetHeatmapStyle(cell?.MargenPercent)">
                                                @(cell != null && cell.MargenPercent != 0 ? $"{cell.MargenPercent.ToString("N2")}%" : "-")
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Leyenda del mapa de calor -->
                    <div class="d-flex flex-wrap gap-4 justify-center mt-4">
                        <div class="d-flex align-center"><span style="display:inline-block; width:15px; height:15px; background:#1B5E20; margin-right:5px; border-radius:3px;"></span> Excelente (&gt;50%)</div>
                        <div class="d-flex align-center"><span style="display:inline-block; width:15px; height:15px; background:#4CAF50; margin-right:5px; border-radius:3px;"></span> Bueno (25-50%)</div>
                        <div class="d-flex align-center"><span style="display:inline-block; width:15px; height:15px; background:#FFF176; margin-right:5px; border-radius:3px; border:1px solid #ccc;"></span> Regular (0-25%)</div>
                        <div class="d-flex align-center"><span style="display:inline-block; width:15px; height:15px; background:#FFCDD2; margin-right:5px; border-radius:3px;"></span> Pérdida (&lt;0%)</div>
                    </div>
                </MudCard>
            </MudItem>

            <!-- Análisis de Turnos -->
            <MudItem XS="12" LG="4">
                <MudCard Elevation="3" Class="pa-4" Style="border-radius: 8px; height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4 font-bold" Color="Color.Primary">Comparativa Turno DÍA vs NOCHE</MudText>
                    
                    <MudTable Items="dashboardData.TurnComparisonList" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Métrica</MudTh>
                            <MudTh>Día</MudTh>
                            <MudTh>Noche</MudTh>
                            <MudTh>Mejor</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="font-size:13px; font-weight:bold;">@context.Metrica</MudTd>
                            <MudTd Style="font-size:13px;">@context.TurnoDia</MudTd>
                            <MudTd Style="font-size:13px;">@context.TurnoNoche</MudTd>
                            <MudTd Style="font-size:13px;">
                                <MudChip T="string" Color="@(context.MejorTurno.Contains("DIA") ? Color.Primary : Color.Secondary)" Size="Size.Small">
                                    @(context.MejorTurno.Split(' ').FirstOrDefault())
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Tabla Detallada SKU -->
        <MudCard Elevation="3" Class="pa-4" Style="border-radius: 8px;">
            <MudText Typo="Typo.h6" Class="mb-4 font-bold" Color="Color.Primary">Desempeño y Margen Neto por SKU / Producto</MudText>
            <MudTable Items="dashboardData.SkuPerformanceList" Hover="true" Class="mb-2">
                <HeaderContent>
                    <MudTh>SKU / Producto</MudTh>
                    <MudTh>Unidades (Packs)</MudTh>
                    <MudTh>Ingreso Total (C$)</MudTh>
                    <MudTh>Costo Asignado (C$)</MudTh>
                    <MudTh>Utilidad Neta (C$)</MudTh>
                    <MudTh>Margen Neto (%)</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Producto</MudTd>
                    <MudTd>@context.UnidadesProducidas.ToString("N0")</MudTd>
                    <MudTd>C$ @context.IngresoTotal.ToString("N2")</MudTd>
                    <MudTd>C$ @context.CostoTotalAsignado.ToString("N2")</MudTd>
                    <MudTd Class="@(context.UtilidadNetaReal < 0 ? "text-error font-bold" : "text-success font-bold")">
                        C$ @context.UtilidadNetaReal.ToString("N2")
                    </MudTd>
                    <MudTd Style="@(context.MargenNetoPercent < 0 ? "color:#D32F2F; font-weight:bold;" : "color:#2E7D32; font-weight:bold;")">
                        @context.MargenNetoPercent.ToString("N2")%
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudCard>
    }

    <!-- Dialogo para Importar Excel -->
    <MudDialog @bind-IsVisible="isUploadDialogOpen" Options="dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6" Class="font-bold">Importar Datos de Excel ( CBC Consolidated )</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="uploadMonth" Label="Mes del Reporte" Placeholder="ej. 2026-06" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" HelperText="Escribe el período en formato Año-Mes (AAAA-MM)" />
            
            <InputFile id="dialogFileInput" OnChange="UploadFile" hidden accept=".xlsx" />
            <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" For="dialogFileInput" FullWidth="true" Class="py-4">
                Subir Reporte Consolidado
            </MudButton>
            
            @if (isUploading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
                <MudText Typo="Typo.caption" Class="d-block text-center mt-2">Analizando y guardando en base de datos. Por favor espera...</MudText>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Error" OnClick="@(() => isUploadDialogOpen = false)">Cerrar</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

@code {
    private string selectedMonth = "";
    private string selectedTurn = "TODOS";
    private bool isLoading = false;
    private bool isUploadDialogOpen = false;
    private string uploadMonth = DateTime.Now.ToString("yyyy-MM");
    private bool isUploading = false;

    private List<string> availableMonths = new List<string>();
    private DashboardResponse dashboardData = null;

    private DialogOptions dialogOptions = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadMonths();
        if (availableMonths.Count > 0)
        {
            selectedMonth = availableMonths.First();
            await LoadDashboard();
        }
    }

    private async Task LoadMonths()
    {
        var res = await _OdooService.GetDashboardMonths();
        if (res.Model != null)
        {
            availableMonths = res.Model.ToList();
        }
    }

    private async Task OnFiltersChanged()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        if (string.IsNullOrEmpty(selectedMonth))
        {
            dashboardData = null;
            return;
        }

        isLoading = true;
        StateHasChanged();
        
        var res = await _OdooService.GetDashboardData(selectedMonth, selectedTurn);
        if (res.Model != null && res.Model.Any())
        {
            dashboardData = res.Model.First();
        }
        else
        {
            dashboardData = null;
            Snackbar.Add("No se encontraron datos de rentabilidad para los filtros seleccionados.", Severity.Warning);
        }
        
        isLoading = false;
        StateHasChanged();
    }

    private void OpenUploadDialog()
    {
        isUploadDialogOpen = true;
    }

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(uploadMonth) || uploadMonth.Length != 7 || !uploadMonth.Contains("-"))
        {
            Snackbar.Add("El mes es obligatorio y debe tener formato AAAA-MM (ej. 2026-06).", Severity.Warning);
            return;
        }

        var file = e.File;
        if (file == null) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            using (var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)) // max 10MB
            {
                using (var ms = new MemoryStream())
                {
                    await stream.CopyToAsync(ms);
                    var bytes = ms.ToArray();
                    
                    var res = await _OdooService.UploadDashboardExcel(bytes, file.Name, uploadMonth);
                    if (!res.Respuesta.ExisteError)
                    {
                        Snackbar.Add("Reporte consolidado importado y procesado exitosamente.", Severity.Success);
                        isUploadDialogOpen = false;
                        await LoadMonths();
                        selectedMonth = uploadMonth;
                        await LoadDashboard();
                    }
                    else
                    {
                        Snackbar.Add("Error al importar el archivo: " + res.Respuesta.MensajeError, Severity.Error);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al leer el archivo: " + ex.Message, Severity.Error);
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private string GetHeatmapStyle(decimal? margin)
    {
        if (!margin.HasValue || margin.Value == 0)
            return "background-color: #F5F5F5; color: #9E9E9E;";
            
        decimal val = margin.Value;
        if (val > 50m)
            return "background-color: #1B5E20; color: white;"; // excelente
        if (val >= 25m)
            return "background-color: #4CAF50; color: white;"; // bueno
        if (val >= 0m)
            return "background-color: #FFF9C4; color: #5D4037; border: 1px solid #FFE082;"; // regular
            
        return "background-color: #FFCDD2; color: #B71C1C;"; // pérdida
    }
}
