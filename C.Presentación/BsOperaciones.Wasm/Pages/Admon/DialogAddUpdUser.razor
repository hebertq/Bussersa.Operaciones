@using Modelo.Admin
@using HostService.Interfaces
@inject ISnackbar Snackbar
@inject IOdooService OdooService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-3 mb-n1" />
            @Title
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isloading)
        {
            <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-2" />
        }
        <MudContainer Style="max-height: 450px; overflow-y: auto" Class="pt-4">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="payload.username" Label="Usuario (Username)" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="payload.email" Label="Correo Electrónico" Variant="Variant.Outlined" Required="true" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="payload.nombres" Label="Nombres" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="payload.apellidos" Label="Apellidos" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="payload.password" Label="Contraseña" Variant="Variant.Outlined" InputType="InputType.Password" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="payload.grupoid" Label="Grupo de Permisos" Variant="Variant.Outlined" Required="true">
                        @foreach (var g in Groups)
                        {
                            <MudSelectItem Value="@g.id">@g.nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Cancelar</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="isloading">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; } = "Registro de Usuario";
    [Parameter] public User payload { get; set; } = new User();
    [Parameter] public List<AdmonGroup> Groups { get; set; } = new List<AdmonGroup>();
    [Parameter] public bool IsEdit { get; set; }

    private bool isloading;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(payload.username) || string.IsNullOrWhiteSpace(payload.email) || string.IsNullOrWhiteSpace(payload.password))
        {
            Snackbar.Add("Por favor complete los campos obligatorios.", Severity.Warning);
            return;
        }

        try
        {
            isloading = true;
            IResponse response;
            if (IsEdit)
            {
                response = await OdooService.UpdateUser(payload);
            }
            else
            {
                response = await OdooService.AddUser(payload);
            }

            isloading = false;
            if (response.Respuesta.ExisteError)
            {
                Snackbar.Add("Error al guardar: " + response.Respuesta.MensajeError, Severity.Error);
            }
            else
            {
                Snackbar.Add("Usuario guardado con éxito.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            isloading = false;
            Snackbar.Add("Error inesperado: " + ex.Message, Severity.Error);
        }
    }
}
