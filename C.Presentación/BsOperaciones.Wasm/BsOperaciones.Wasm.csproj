<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BsOperaciones</AssemblyName>
    <RootNamespace>BsOperaciones</RootNamespace>
    <GenerateMvcApplicationPartsAssemblyAttributes>false</GenerateMvcApplicationPartsAssemblyAttributes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="ColorCode.HTML" Version="2.0.15" />
    <PackageReference Include="EmbeddedBlazorContent" Version="1.10.0" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="MudBlazor" Version="8.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NPOI.Extensions" Version="1.0.2" />
    <PackageReference Include="VDT.Core.Blazor.Wizard" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\B.Dominio\BsOperaciones.Application\BsOperaciones.Application.csproj" />
    <ProjectReference Include="..\..\B.Dominio\Modelo\Modelo.csproj" />
    <ProjectReference Include="..\..\B.Dominio\Reportes\Reportes.csproj" />
    <ProjectReference Include="..\..\B.Dominio\Utilidades\Utilidades.csproj" />
  </ItemGroup>

</Project>
