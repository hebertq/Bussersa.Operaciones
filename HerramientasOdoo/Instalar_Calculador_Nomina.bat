@echo off
chcp 65001 >nul
title Instalador Autónomo - Calculador de Nómina Odoo Bussersa
color 0B

echo ========================================================================
echo    BUSSERSA IT - INSTALADOR AUTÓNOMO DEL CALCULADOR DE NÓMINA ODOO
echo ========================================================================
echo.
echo Este instalador configura automáticamente la herramienta en esta computadora.
echo No requiere descargar nada extra, todo viene incluido en este archivo.
echo.

set INSTALL_DIR=%LOCALAPPDATA%\Bussersa\HerramientasOdoo
if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%"

echo  [1/4] Instalando archivos de la extensión en:
echo        %INSTALL_DIR%
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$mB64 = ''; " ^
  "$mTxt = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($mB64)); " ^
  "[System.IO.File]::WriteAllText('$env:LOCALAPPDATA\Bussersa\HerramientasOdoo\manifest.json', $mTxt, [System.Text.Encoding]::UTF8); " ^
  "$cB64 = ''; " ^
  "$cTxt = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($cB64)); " ^
  "[System.IO.File]::WriteAllText('$env:LOCALAPPDATA\Bussersa\HerramientasOdoo\content.js', $cTxt, [System.Text.Encoding]::UTF8); " ^
  "$bB64 = ''; " ^
  "$bTxt = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($bB64)); " ^
  "[System.IO.File]::WriteAllText('$env:LOCALAPPDATA\Bussersa\HerramientasOdoo\bookmarklet.txt', $bTxt, [System.Text.Encoding]::UTF8);"

if exist "%INSTALL_DIR%\content.js" (
    echo  [OK] Archivos extraídos correctamente.
) else (
    echo  [!] Error al extraer los archivos de la extensión.
    pause
    exit /b 1
)

echo.
echo  [2/4] Buscando Google Chrome en el sistema...
set CHROME_EXE=
if exist "C:\Program Files\Google\Chrome\Application\chrome.exe" set "CHROME_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe"
if not defined CHROME_EXE if exist "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe" set "CHROME_EXE=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe"
if not defined CHROME_EXE if exist "%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe" set "CHROME_EXE=%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe"

if defined CHROME_EXE (
    echo  [OK] Chrome detectado en: "%CHROME_EXE%"
) else (
    echo  [!] No se encontró Chrome en las rutas estándar.
    set "CHROME_EXE=chrome.exe"
)

echo.
echo  [3/4] Creando Acceso Directo en el Escritorio...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$WshShell = New-Object -ComObject WScript.Shell; " ^
  "$Desktop = [System.Environment]::GetFolderPath('Desktop'); " ^
  "$Shortcut = $WshShell.CreateShortcut("$Desktop\Odoo - Con Calculador de Nomina.lnk"); " ^
  "$Shortcut.TargetPath = '%CHROME_EXE%'; " ^
  "$Shortcut.Arguments = '--load-extension="%INSTALL_DIR%" "https://admin.bussersa.com/odoo/action-540"'; " ^
  "$Shortcut.Description = 'Odoo Bussersa con Extensión de Cálculo de Nómina'; " ^
  "$Shortcut.IconLocation = '%CHROME_EXE%,0'; " ^
  "$Shortcut.Save();"

if exist "%USERPROFILE%\Desktop\Odoo - Con Calculador de Nomina.lnk" (
    echo  [OK] Acceso directo 'Odoo - Con Calculador de Nomina' creado en el Escritorio.
) else (
    echo  [!] No se pudo crear el acceso directo en el escritorio.
)

echo.
echo  [4/4] Inyectando Marcador directo en Google Chrome...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$bPath = "$env:LOCALAPPDATA\Google\Chrome\User Data\Default\Bookmarks"; " ^
  "$bmkFile = "$env:LOCALAPPDATA\Bussersa\HerramientasOdoo\bookmarklet.txt"; " ^
  "if ((Test-Path $bPath) -and (Test-Path $bmkFile)) { " ^
  "  try { " ^
  "    $bCode = [System.IO.File]::ReadAllText($bmkFile); " ^
  "    $raw = [System.IO.File]::ReadAllText($bPath); " ^
  "    [System.IO.File]::WriteAllText("$bPath.bak", $raw); " ^
  "    $json = $raw | ConvertFrom-Json; " ^
  "    $kids = [System.Collections.ArrayList]@($json.roots.bookmark_bar.children); " ^
  "    $idx = -1; for ($i=0; $i -lt $kids.Count; $i++) { if ($kids[$i].name -like '*Calcular N*mina*') { $idx = $i; break; } } " ^
  "    $item = [PSCustomObject]@{ date_added="$([DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds())000"; date_last_used="0"; id="$([DateTimeOffset]::UtcNow.ToUnixTimeSeconds())"; name="⚡ Calcular Nómina (Odoo)"; type="url"; url=$bCode }; " ^
  "    if ($idx -ge 0) { $kids[$idx] = $item; } else { $kids.Insert(0, $item); } " ^
  "    $json.roots.bookmark_bar.children = $kids; " ^
  "    [System.IO.File]::WriteAllText($bPath, ($json | ConvertTo-Json -Depth 32)); " ^
  "    Write-Host '  [OK] Marcador inyectado en Chrome exitosamente.' -ForegroundColor Green; " ^
  "  } catch { Write-Host '  [!] No se pudo inyectar el marcador: ' $_.Exception.Message -ForegroundColor Yellow; } " ^
  "} else { Write-Host '  [!] Perfil por defecto de Chrome no encontrado aún.' -ForegroundColor Yellow; }"

echo.
echo ------------------------------------------------------------------------
<nul set /p="%INSTALL_DIR%" | clip
echo  [OK] Ruta de la extensión copiada al Portapapeles:
echo       %INSTALL_DIR%
echo ------------------------------------------------------------------------

echo.
echo ========================================================================
echo                         INSTALACIÓN COMPLETADA
echo ========================================================================
echo.
echo Para dejar la extensión instalada fijamente en Chrome:
echo  1. Se abrirá la página chrome://extensions
echo  2. Activa "Modo de desarrollador" (arriba a la derecha).
echo  3. Haz clic en "Cargar descomprimida" (arriba a la izquierda).
echo  4. En la ventana que aparece, presiona Ctrl + V y da Enter.
echo.
echo O también puedes usar directamente el nuevo icono en el Escritorio:
echo  "Odoo - Con Calculador de Nomina"
echo.
echo Presiona cualquier tecla para abrir Chrome y finalizar...
pause >nul

start "" "%CHROME_EXE%" "chrome://extensions"
exit /b 0
